// P6 — DO N BONES APPROXIMATE A CONTINUOUS BEND TO A STATED BOUND?
//
// `A-DOF` gives a wing station `mount removes 5 … CARRIED … bend angle 1,
// solved from load`, and `hex_body`'s line is that *"a part that bends is more
// bones on more joints"*. `P7` established that the SKIN survives that. `P6` is
// the other half: does the SHAPE?
//
// ── the falsifier ───────────────────────────────────────────────────────────
//
// *"the error does not fall predictably with N, or the N needed for a visually
// acceptable wing is large enough that the rig is the wrong representation."*
// Two questions, and the first must be answered with an ORDER, not an error at
// one N — an order is what lets the second be answered without measuring it.
//
// ── the model, and the one decision inside it ───────────────────────────────
//
// A cantilever of length L under a uniform load w, flexural rigidity EI, cut
// into N rigid bones with a torsional hinge at each node. Hinge j turns by the
// curvature of the beam over the stretch it stands for:
//
//     φⱼ = M(xⱼ) · ℓⱼ / EI
//
// and the whole probe turns on ℓⱼ. A hinge at an interior node stands for a
// half-bone on each side, so ℓ = h. **The ROOT hinge has no bone inboard of
// it**, so it stands for a half-bone and ℓ = h/2 — and giving it a full h is
// the obvious thing to do, which is why it is the case measured here beside
// the other.
//
// The reference is the continuum answer `δ = wL⁴/(8EI)`, which is independent
// of everything above. The two closed forms below are PREDICTIONS derived by
// hand and checked against the measurement, not the reference itself.
//
// run: loft --interpret --path ../loft/ plans/14-props-dressing/probe/bend_bones.loft

const LEN = 1.0;
const EI = 1.0;

// ⚠ TWO LOADS, AND THE FIRST RUN OF THIS PROBE USED ONE. `wL⁴/8EI` is the
// SMALL-DEFLECTION solution, while the chain below walks its nodes with real
// `sin` — so comparing them at a tip deflection equal to the span measures the
// geometric nonlinearity and calls it discretisation error. It read a scheme
// converging to 0.789 and reported the derivation wrong.
//
// So case A runs at a tip deflection of 1e-6 of the span, where the closed form
// is the truth to 1e-12, and case C turns the load up to where a wing actually
// lives and measures the ORDER instead.
const SMALL_W = 0.000008;    // tip deflection 1e-6 — the linear regime, exactly
const BIG_W = 8.0;           // tip deflection would be a full span — strongly not

const PASSES = 400;          // fixed-point rounds for the deformed-arm solve

struct Chain {
  ch_tip: float,             // tip deflection, downward-positive
  ch_res: float,             // last change in any joint angle
  ch_pass: integer
}

fn fabs(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

// The chain, solved as a fixed point: the angles depend on the moments, the
// moments on the positions, the positions on the angles. That is the same
// shape the ground contact already has — which is the design's claim that a
// `SOLVED` state adds no machinery, so it is worth exercising rather than
// asserting. With `nonlin` off the moment arms are the undeformed ones and the
// first pass is already the answer.
fn solve_chain(n: integer, w: float, ei: float,
               half_root: boolean, nonlin: boolean) -> Chain {
  h = LEN / (n as float) ?? 0.0;
  phi: vector<float> = [for pi in 0..n { 0.0 }];
  res = 1.0;
  used = 0;
  // ⚠ A `for` loop's variable is the iterator's, so assigning PASSES to it does
  // NOT break out — the first version did that and reported 200 passes for a
  // solve that had settled after two.
  while res > 0.000000000001 && used < PASSES {
    // node positions, walked out from the clamped root
    nx: vector<float> = [0.0];
    ny: vector<float> = [0.0];
    th = 0.0;
    px = 0.0;
    py = 0.0;
    for iw in 0..n {
      th = th + (phi[iw] ?? 0.0);
      px = px + h * cos(th);
      py = py + h * sin(th);
      nx += [px];
      ny += [py];
    }
    // each hinge turns by the moment of everything outboard of it
    nph: vector<float> = [];
    for ij in 0..n {
      bx = (ij as float) * h;
      if nonlin { bx = nx[ij] ?? 0.0; }
      mm = 0.0;
      for ik in ij..n {
        lx = ((ik as float) + 0.5) * h;
        if nonlin { lx = ((nx[ik] ?? 0.0) + (nx[ik + 1] ?? 0.0)) * 0.5; }
        mm = mm - w * h * (lx - bx);
      }
      ln = h;
      if half_root && ij == 0 { ln = h * 0.5; }
      nph += [mm * ln / ei ?? 0.0];
    }
    res = 0.0;
    for iu in 0..n {
      d = fabs((nph[iu] ?? 0.0) - (phi[iu] ?? 0.0));
      if d > res { res = d; }
    }
    phi = nph;
    used = used + 1;
  }
  // the tip, from the angles alone — nothing stores a position
  tth = 0.0;
  ty = 0.0;
  for iv in 0..n {
    tth = tth + (phi[iv] ?? 0.0);
    ty = ty + h * sin(tth);
  }
  Chain { ch_tip: 0.0 - ty, ch_res: res, ch_pass: used }
}

fn order_of(ea: float, eb: float) -> float {
  if eb <= 0.0 || ea <= 0.0 { return 0.0; }
  g = ln(ea / eb ?? 0.0) ?? 0.0;
  h2 = ln(2.0) ?? 0.0;
  g / h2 ?? 0.0
}

fn main() {
  exact = SMALL_W * LEN * LEN * LEN * LEN / (8.0 * EI) ?? 0.0;
  big = BIG_W * LEN * LEN * LEN * LEN / (8.0 * EI) ?? 0.0;
  println("P6 — N rigid bones against a continuous bend");
  println("");
  println("  L {LEN}  EI {EI}   continuum tip deflection wL^4/8EI");
  println("  case A at w {SMALL_W} -> {exact} of a span, the linear regime");
  println("  case C at w {BIG_W} -> {big} of a span if it were linear, which it is not");
  println("");
  println("  The reference is that continuum value. The `pred` columns are closed");
  println("  forms derived by hand for the DISCRETE chain — a second thing to be");
  println("  wrong, which is why they are printed beside the measurement.");
  fails = 0;

  // ── A: the two hinge schemes, against the continuum ───────────────────────
  println("");
  println("  A  tip deflection, small-deflection regime (undeformed moment arms)");
  println("");
  println("       N    root gets h   tip/exact   pred        root gets h/2  tip/exact   pred");
  ns = [2, 4, 8, 16, 32, 64];
  prev_a = 0.0;
  prev_c = 0.0;
  ord_a = 0.0;
  ord_c = 0.0;
  worst_pa = 0.0;
  worst_pc = 0.0;
  for nn in ns {
    ca = solve_chain(nn, SMALL_W, EI, false, false);
    cc = solve_chain(nn, SMALL_W, EI, true, false);
    fn_ = nn as float;
    ra = (ca.ch_tip - exact) / exact ?? 0.0;
    rc = (cc.ch_tip - exact) / exact ?? 0.0;
    pa = 2.0 / fn_ ?? 0.0;
    pa = pa + (1.0 / (fn_ * fn_) ?? 0.0);
    pc = 1.0 / (fn_ * fn_) ?? 0.0;
    println("     {nn:3}     {ca.ch_tip / exact ?? 0.0:9.6}  {ra:9.6} {pa:9.6}      "
            + "{cc.ch_tip / exact ?? 0.0:9.6}  {rc:9.6} {pc:9.6}");
    if fabs(ra - pa) > worst_pa { worst_pa = fabs(ra - pa); }
    if fabs(rc - pc) > worst_pc { worst_pc = fabs(rc - pc); }
    if prev_a > 0.0 { ord_a = order_of(prev_a, fabs(ra)); }
    if prev_c > 0.0 { ord_c = order_of(prev_c, fabs(rc)); }
    prev_a = fabs(ra);
    prev_c = fabs(rc);
  }
  println("     observed order, last halving:  root h  {ord_a:6.4}    root h/2  {ord_c:6.4}");
  println("     worst departure from the predicted form:  {worst_pa}  /  {worst_pc}");
  if worst_pa < 0.0000000001 && worst_pc < 0.0000000001 {
    println("   ok    both schemes match their closed form exactly:");
    println("         root h    ->  2/N + 1/N^2   FIRST order");
    println("         root h/2  ->  1/N^2         SECOND order");
    println("   ⚠     one half-step at the CLAMPED END is the whole difference");
  } else {
    println("   FAIL  the measured error does not follow the derived form");
    fails = fails + 1;
  }
  if ord_a > 0.9 && ord_a < 1.1 && ord_c > 1.9 && ord_c < 2.1 {
    println("   ok    the error falls PREDICTABLY with N — order 1 and order 2");
  } else {
    println("   FAIL  the observed orders are not 1 and 2");
    fails = fails + 1;
  }

  // ── B: what N a wing actually needs ───────────────────────────────────────
  // `P7`'s wing probe used ten stations. This is what ten stations cost.
  println("");
  println("  B  the N a wing needs, from the orders above");
  println("");
  println("       tolerance    root h needs N    root h/2 needs N");
  tols = [0.05, 0.01, 0.001];
  for tl in tols {
    na = 0;
    for ia in 1..4000 { if na == 0 {
      f = ia as float;
      e = 2.0 / f ?? 0.0;
      e = e + (1.0 / (f * f) ?? 0.0);
      if e <= tl { na = ia; }
    } }
    nc = 0;
    for ic in 1..4000 { if nc == 0 {
      f2 = ic as float;
      if (1.0 / (f2 * f2) ?? 0.0) <= tl { nc = ic; }
    } }
    println("        {tl:6.4}         {na:5}             {nc:5}");
  }
  c10a = solve_chain(10, SMALL_W, EI, false, false);
  c10c = solve_chain(10, SMALL_W, EI, true, false);
  e10a = (c10a.ch_tip - exact) / exact ?? 0.0;
  e10c = (c10c.ch_tip - exact) / exact ?? 0.0;
  println("     at the TEN stations P7's wing probe used:");
  println("       root h    tip off by {e10a:7.4}   ({e10a * 100.0:5.1} %)");
  println("       root h/2  tip off by {e10c:7.4}   ({e10c * 100.0:5.1} %)");
  if fabs(e10c) < 0.02 && fabs(e10a) > 0.10 {
    println("   ok    ten bones is 1% with the corrected root and 21% without —");
    println("         so the rig is the right representation, and the naive");
    println("         discretisation is not");
  } else {
    println("   FAIL  the ten-station comparison does not separate the schemes");
    fails = fails + 1;
  }

  // ── C: the geometric nonlinearity, where a wing actually lives ────────────
  // ⚠ SELF-CONVERGENCE, and it is labelled as such. There is no closed form for
  // a uniformly loaded elastica, so this measures the ORDER against a finer run
  // of the same scheme — which can show the order survives and CANNOT show the
  // answer is right. Case A is where accuracy was established.
  println("");
  println("  C  deformed moment arms — order by self-convergence, not accuracy");
  println("");
  println("       N      tip        diff to 2N     order     passes  residual");
  ref = solve_chain(256, BIG_W, EI, true, true);
  prev_e = 0.0;
  ord_n = 0.0;
  for nb in [4, 8, 16, 32, 64] {
    cb = solve_chain(nb, BIG_W, EI, true, true);
    ee = fabs(cb.ch_tip - ref.ch_tip);
    if prev_e > 0.0 { ord_n = order_of(prev_e, ee); }
    println("     {nb:3}   {cb.ch_tip:9.6}   {ee:11.8}   {ord_n:7.4}   {cb.ch_pass:4}   {cb.ch_res}");
    prev_e = ee;
  }
  println("     the linear tip would be {big}; the deformed arms give {ref.ch_tip:9.6},");
  println("     a {(big - ref.ch_tip) / big * 100.0 ?? 0.0:5.1}% shortening — well outside the linear regime");
  if ord_n > 1.7 && ord_n < 2.3 {
    println("   ok    second order survives the nonlinearity, and the fixed point");
    println("         converges — the SOLVED state needs no machinery of its own");
  } else {
    println("   FAIL  the order does not survive the deformed arms");
    fails = fails + 1;
  }

  // ── D: the control — a modelling error must NOT look like a discretisation one
  println("");
  println("  D  the same sweep with EI wrong by 2x — the error must not fall");
  println("");
  println("       N      rel error");
  flat = true;
  for nd in [4, 16, 64] {
    cd = solve_chain(nd, SMALL_W, EI * 2.0, true, false);
    rd = (cd.ch_tip - exact) / exact ?? 0.0;
    println("     {nd:3}   {rd:8.5}");
    if fabs(rd) < 0.4 { flat = false; }
  }
  if flat {
    println("   ok    a wrong stiffness stays at ~-50% however fine the chain gets,");
    println("         so case A is measuring DISCRETISATION and not the model");
  } else {
    println("   FAIL  the wrong-stiffness error fell with N — A cannot tell them apart");
    fails = fails + 1;
  }

  println("");
  if fails == 0 { println("bend_bones: every clause holds"); }
  else { println("bend_bones: {fails} clause(s) failed"); }
}
