// SPDX-License-Identifier: LGPL-3.0-or-later
//
// `GROUND` support: solving where a body rests on the terrain.
// Step `A6` of plans/14-props-dressing/CONNECTOR.md, proving `A-GROUND` and
// `A-FIT`.
//
// ── the solve: a CHORD LENGTH, on the horizontal half-span ──────────────────
//
// For one axle — half-length `w`, wheel radius `R`, axle direction `u` in the
// ground plane, body centre `c`, terrain `g(·)` — put the two contacts at
// horizontal offset `±t` and ask what `t` makes the axle fit between them:
//
//     g_L(t) = g(c − u·t)     g_R(t) = g(c + u·t)     d(t) = g_L − g_R
//
//     H(t) = (2t)² + d(t)² − (2w)² = 0        the chord IS the axle
//
//     β = atan2(d, 2t)        y = (g_L + g_R)/2 + R
//
// ⚠ **THE POINT OF SOLVING FOR `t` RATHER THAN FOR `β` IS THAT THE BRACKET IS
// FREE**, and with it the guarantee:
//
//     H(0)  = −(2w)² < 0      both contacts coincide, so the chord is zero
//     H(w)  = d(w)²   ≥ 0     at full span the chord is at least the axle
//
// so a root exists on `[0, w]` for **any** continuous terrain, at any slope, and
// a bracketed method cannot fail to find it.
//
// ⚠ **THE ITERATION RUNS ON `u = t²`, WHICH MAKES A PLANE EXACT IN ONE STEP.**
// For `g = s·z` the contacts give `d = −2st`, so
//
//     H = 4t² + 4s²t² − 4w² = 4(1+s²)·u − 4w²
//
// — LINEAR in `u`. One false-position step lands on the root, and a heightfield
// is planar between its samples. Illinois keeps it superlinear on curved ground
// without ever losing the bracket.
//
// ⚠ **WHAT THIS REPLACED, AND WHY IT HAD TO GO.** The solve was a fixed point on
// `β` with the contacts at `±w·cos β`, seeded at `β₀ = 0`. Two failures, both
// measured (`probe/cart/converge.loft`):
//
//   · `Φ′(β*) ≈ s²` in the terrain slope — quadratic only near level. At `s = 0.6`
//     three rounds left the wheels **8.9 mm** off the ground and forty left `10⁻⁸`;
//     at `s = 0.9` forty rounds still left `7.3e−5`. The editor asked for the
//     DEFAULT THREE, on terrain of unknown slope.
//   · Past `s = 1` it did not converge at all — it REFUSED, on round one. The
//     `A-FIT` doorstep asks whether the ground drops further than the axle is long
//     across the span at the CURRENT iterate, and the seed is the widest span the
//     axle ever has. A plane of slope 2.0 rests perfectly well at `β = −1.107`;
//     it came back `ok false` with the wheels **1.1 wu** off the ground.
//
// The doorstep is a real rule and it is kept — a drop longer than the axle is
// unrideable however the cart is turned. It is asked at the CONVERGED span now,
// which is the only span at which it means anything.
//
// ⚠ **The formula above is correct in the STANDARD rotation sense**, which is
// what `A3`'s `rot_axis` uses. The editor applied it through mesh3d's
// `mat4_rotate_x`, which turns about **−x** — so it banked the cart the wrong
// way, and one wheel floated `0.0914 wu` while the other sank the same on a 4.8°
// slope. See `A-GROUND` below for why that stayed invisible.
//
// ── the terrain arrives as an argument ──────────────────────────────────────
//
// `sample` is a function, not a world. That keeps every clause here a pure
// function of its arguments — the tests hand it analytic terrains whose answers
// are known in closed form — and it keeps this file free of `moros_map`.
use self::assembly;
use self::frames;
use graphics;

pub struct Rest {
  rt_ok: boolean,
  rt_frame: Xform,        // the solved base frame; the pose, not a description of it
  rt_bank: float,         // radians
  rt_rounds: integer,     // rounds actually taken
  rt_resid: float,        // the last change in β — how far from settled
  rt_reason: text,        // `K-FIT`: named, and empty when applied exactly
  rt_offer: float,        // `K-FIT`: the nearest admissible drop across the axle
  rt_over: float          // `K-FIT`: the residual, |d| − 2w
}

fn fabs(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

// The base frame for a given height and bank. ONE expression, used by the solve
// and by the gap measurement alike — which is the whole point of `A6`.
pub fn ground_frame(cx: float, cy: float, cz: float,
                    yaw: float, bank: float) -> Xform {
  xform_mul(xform_mul(xform_trans(cx, cy, cz),
                      xform_rot(rot_axis(0.0, 1.0, 0.0, yaw / TURN ?? 0.0))),
            xform_rot(rot_axis(1.0, 0.0, 0.0, bank / TURN ?? 0.0)))
}

// ── `A-GROUND` ───────────────────────────────────────────────────────────────
//
//     for every contact:  lowest(part) − g(contact) = 0
//
// ⚠ **MEASURED FROM THE FRAME, and that is not a stylistic choice.** The editor
// reported both of its cart's gaps as zero for an entire rung while one wheel
// floated `0.0914 wu` and the other sank the same, because the report computed
// `y ± w·sin(bank)` — the solve's own arithmetic — while the wheels were placed
// by a transposed rotation. Two homes for one quantity, and the check sat in the
// wrong one. Here the hub comes out of `xform_apply`, so a wrong pose cannot
// report a right gap.
pub fn ground_gap(f: Xform, half: float, radius: float, side: float,
                  sample: fn(float, float) -> float) -> float {
  hub = xform_apply(f, vec3(0.0, 0.0, side * half));
  hub.y - radius - sample(hub.x, hub.z)
}

// ── the bracketed solve ─────────────────────────────────────────────────────
//
// `rounds` is a CAP, not a count: the iteration stops when the bracket can no
// longer be halved in `u`, so `rt_rounds` says what it actually cost. Twelve is
// generous — a plane takes one, and the whole point of the `u = t²` variable is
// that a heightfield is a plane between its samples.
pub fn ground_axle(sample: fn(float, float) -> float,
                   cx: float, cz: float, yaw: float,
                   half: float, radius: float, rounds: integer = 12) -> Rest {
  // the axle runs ACROSS the travel direction
  ux = sin(yaw);
  uz = cos(yaw);
  axle2 = 4.0 * half * half;                    // (2w)²

  // The bracket, in `u = t²` over `[0, w²]`. `H(0) = −(2w)²` needs no sample:
  // both contacts coincide there, so `d = 0` by construction.
  ua = 0.0;
  ha = 0.0 - axle2;
  ub = half * half;
  gl = sample(cx - ux * half, cz - uz * half);
  gr = sample(cx + ux * half, cz + uz * half);
  hb = (gl - gr) * (gl - gr);

  ut = ub;
  glt = gl;
  grt = gr;
  bank = atan2(gl - gr, 2.0 * half);
  resid = fabs(bank);
  used = 0;
  // `hb == 0` is flat across the axle: full span already fits, nothing to solve.
  if hb > 0.0 {
    // Illinois: when the same endpoint is kept twice its stored value is halved,
    // which is what stops false position stagnating on curved ground.
    held = 0;
    for it in 0..rounds {
      wide = ub - ua;
      den = hb - ha;
      un = (ua + ub) * 0.5;
      if den != 0.0 { un = (ua * hb - ub * ha) / den ?? un; }
      // Kept strictly inside the bracket: a stagnant endpoint otherwise parks the
      // step on the edge and the iteration stops moving without converging.
      lo = ua + wide * 0.001;
      hi = ub - wide * 0.001;
      if un < lo { un = lo; }
      if un > hi { un = hi; }
      tn = sqrt(un) ?? 0.0;
      nl = sample(cx - ux * tn, cz - uz * tn);
      nr = sample(cx + ux * tn, cz + uz * tn);
      dn = nl - nr;
      hn = 4.0 * un + dn * dn - axle2;
      nb = atan2(dn, 2.0 * tn);
      resid = fabs(nb - bank);
      bank = nb;
      ut = un;
      glt = nl;
      grt = nr;
      used = it + 1;
      if hn == 0.0 { break; }
      if hn > 0.0 {
        ub = un;
        hb = hn;
        if held == 1 { ha = ha * 0.5; }
        held = 1;
      } else {
        ua = un;
        ha = hn;
        if held == 0 - 1 { hb = hb * 0.5; }
        held = 0 - 1;
      }
      // The bracket is down to the last representable step in `u`; another round
      // would sample the same two points and change nothing.
      if ub - ua >= wide { break; }
    }
  }

  t = sqrt(ut) ?? 0.0;
  d = glt - grt;
  cy = (glt + grt) * 0.5 + radius;
  // ⚠ `A-FIT`, ASKED AT THE CONVERGED SPAN. A drop longer than the axle admits no
  // bank whatever — the raise brush's own documentation records flanks of 74–83°
  // against an axle of 1.1 wu — so it is a named refusal with an OFFER and a
  // RESIDUAL, not a clamp, and it keeps a real bank rather than emitting a NaN,
  // because the GROUND is what has to give here, not the cart.
  //
  // ⚠ AND ASKING IT AT THE SEED IS WHAT MADE IT WRONG. `t` shrinks as the axle
  // tilts, so the span at `β = 0` is the widest the question is ever asked about:
  // every plane steeper than 45° failed it and was refused a rest it has.
  if fabs(d) > 2.0 * half {
    off = 2.0 * half;
    if d < 0.0 { off = 0.0 - off; }
    return Rest { rt_ok: false,
                    rt_frame: ground_frame(cx, cy, cz, yaw, bank),
                    rt_bank: bank, rt_rounds: used, rt_resid: resid,
                    rt_reason: "ground drops {fabs(d)} across an axle of {2.0 * half}",
                    rt_offer: off, rt_over: fabs(d) - 2.0 * half };
  }
  Rest { rt_ok: true, rt_frame: ground_frame(cx, cy, cz, yaw, bank),
           rt_bank: bank, rt_rounds: used, rt_resid: resid,
           rt_reason: "", rt_offer: 0.0, rt_over: 0.0 }
}

// The worse of the two contacts, which is the number `A-GROUND` is about.
pub fn ground_worst_gap(g: Rest, half: float, radius: float,
                        sample: fn(float, float) -> float) -> float {
  l = fabs(ground_gap(g.rt_frame, half, radius, 0.0 - 1.0, sample));
  r = fabs(ground_gap(g.rt_frame, half, radius, 1.0, sample));
  if l > r { l } else { r }
}

// ── `A7` — a second body behind the first ────────────────────────────────────
//
// A `MOUNT` child's frame is its parent's, turned. **A `HITCH` child's is not**,
// and that is the correction the design's first draft needed: a towed cart has
// its own ground contacts, so the drawbar COUPLES TWO FRAMES rather than
// parenting one to the other.
//
// The ledger says how: `hitch removes 3 (position) · contacts give 2 · yaw 1`.
// So the child's POSITION is fully determined by the pin, the drawbar and its
// yaw — and its two remaining rotations, pitch and roll, are what its contacts
// supply. Pivoting about a fixed pin, two wheel contacts pin down exactly two
// rotations, which is why the count closes at six.
//
// Each round has two closed forms rather than one:
//
//     sin θ = (P_y − h) / L          h = (g_L + g_R)/2 + R      pitch, about the pin
//     sin φ = (g_L − g_R) / 2w                                  roll, across the axle
//
// ⚠ The axle used here is DERIVED from the body's own mounted children — the
// half-axle from the mount offset, the radius from the wheel rig's bone length.
// That is the re-assertion-site table paying out: neither number is written twice.

pub struct Axle {
  ax_half: float,
  ax_radius: float,
  ax_n: integer          // how many wheels were found; 0 means "no axle here"
}

pub fn body_axle(a: Assembly, i: integer) -> Axle {
  n = asm_count(a);
  half = 0.0;
  radius = 0.0;
  found = 0;
  for k in 0..n {
    if (a.am_parent[k] ?? 0 - 1) == i {
      l = a.am_link[k] ?? link_none();
      if l.lk_kind is Mount {
        off = l.lk_oz;
        if off < 0.0 { off = 0.0 - off; }
        if off > half { half = off; }
        ri = a.am_bodyrig[k] ?? 0 - 1;
        if ri >= 0 {
          rg = a.am_rig[ri] ?? rig_new();
          bl = rg.rg_len[0] ?? 0.0;
          if bl > radius { radius = bl; }
        }
        found = found + 1;
      }
    }
  }
  Axle { ax_half: half, ax_radius: radius, ax_n: found }
}

// A hitched body's frame: origin AT THE PIN, so the coupling holds by
// construction and `A-HITCH` is unbreakable rather than merely checked.
pub fn hitched_frame(px: float, py: float, pz: float,
                     yaw: float, pitch: float, roll: float) -> Xform {
  xform_mul(xform_mul(xform_mul(xform_trans(px, py, pz),
                                xform_rot(rot_axis(0.0, 1.0, 0.0, yaw / TURN ?? 0.0))),
                      xform_rot(rot_axis(0.0, 0.0, 1.0, pitch / TURN ?? 0.0))),
            xform_rot(rot_axis(1.0, 0.0, 0.0, roll / TURN ?? 0.0)))
}

// Where a hitched body's wheel sits, in the world: back along the drawbar, out
// along the axle. Read from the FRAME, for the reason `A6` records.
pub fn hitched_wheel(f: Xform, drawbar: float, half: float, side: float) -> Vec3 {
  xform_apply(f, vec3(0.0 - drawbar, 0.0, side * half))
}

pub fn hitched_gap(f: Xform, drawbar: float, half: float, radius: float,
                   side: float, sample: fn(float, float) -> float) -> float {
  w = hitched_wheel(f, drawbar, half, side);
  w.y - radius - sample(w.x, w.z)
}

// ── the hitched solve: TWO nested brackets ──────────────────────────────────
//
// ⚠ **IT USED TO ALTERNATE TWO CLOSED FORMS, AND INHERITED EVERY FAILURE `A6`
// HAD.** Measured on planes, where the answer is closed form: it refused a slope
// of **0.9** outright — *"ground drops 0.946 across an axle of 0.903"* — and left
// `3e−4` at 0.6. Both doorsteps were asked at the CURRENT iterate, so the seed
// (level, `θ = φ = 0`) decided admissibility for a body that had not yet been
// allowed to tilt.
//
// The unknowns really are two, and they do not separate: a wheel centre sits at
//
//     y = P_y − L·sin θ − side·w·sin φ·cos θ
//
// so summing the two contacts gives the PITCH and differencing them the ROLL:
//
//     sin θ = (P_y − R − m) / L        m = (g_L + g_R)/2      … the sum
//     2·w·sin φ·cos θ = g_L − g_R = d                         … the difference
//
// ⚠ **The `cos θ` is not decoration** — dropping it gave a solve that converged on
// terrain sloping along ONE axis and failed on terrain sloping along two, and the
// single-axis clauses passed, which is how the omission nearly survived.
//
// Alternating those two is block Gauss–Seidel and diverges exactly as `A6`'s did.
// What replaces it is a bracket on each, nested — the outer on the pitch, the
// inner on the roll — because each has an interval whose endpoints are known:
//
//   PITCH, on `sin θ ∈ [−1, +1]`, where `F(sin θ) = (P_y − L·sin θ − R) − m`
//     is decreasing: at `−1` the axle is a full drawbar ABOVE the pin, at `+1` a
//     full drawbar below. A sign change is exactly *the ground is within the
//     drawbar's reach*, which is the second refusal, asked once instead of per
//     round.
//
//   ROLL, on `k = w·sin φ ∈ [−w, +w]`, where `Q(k) = 2k·cos θ − d(k)` is the same
//     chord question `ground_axle` answers, one pitch down. `Q(−w) = −2w·cos θ −
//     d` and `Q(+w) = +2w·cos θ − d`, so on any terrain gentle enough to bracket
//     it, it brackets.
//
// The `A-FIT` doorstep is kept and asked where it means something: at the
// converged pose, against the reach the axle actually has there.

struct RollFit {
  rf_k: float,             // w·sin φ — the roll, as a height offset
  rf_gl: float,
  rf_gr: float
}

// The two ground samples under a hitched body at a given pitch and roll.
//
// ⚠ THE WHEELS MOVE ALONG THE TRAVEL DIRECTION AS THEY ROLL, by `∓k·sin θ`, and
// that term is what makes this a genuinely two-dimensional problem rather than
// two independent ones. It vanishes at `θ = 0`, which is why a single-axis
// fixture cannot see it.
fn hitched_pair(sample: fn(float, float) -> float,
                px: float, pz: float, yaw: float,
                drawbar: float, half: float,
                theta: float, k: float) -> (float, float) {
  ct = cos(theta);
  st = sin(theta);
  cw = cos(yaw);
  sw = sin(yaw);
  c2 = half * half - k * k;
  if c2 < 0.0 { c2 = 0.0; }
  c = sqrt(c2) ?? 0.0;                      // the across half-offset, w·cos φ
  blx = 0.0 - drawbar * ct - k * st;
  brx = 0.0 - drawbar * ct + k * st;
  lx = px + blx * cw - c * sw;
  lz = pz - blx * sw - c * cw;
  rx = px + brx * cw + c * sw;
  rz = pz - brx * sw + c * cw;
  (sample(lx, lz), sample(rx, rz))
}

// The roll that puts both wheels down at a GIVEN pitch.
fn hitched_roll(sample: fn(float, float) -> float,
                px: float, pz: float, yaw: float,
                drawbar: float, half: float,
                theta: float, rounds: integer) -> RollFit {
  ct = cos(theta);
  ka = 0.0 - half;
  kb = half;
  (al, ar) = hitched_pair(sample, px, pz, yaw, drawbar, half, theta, ka);
  (bl, br) = hitched_pair(sample, px, pz, yaw, drawbar, half, theta, kb);
  qa = 2.0 * ka * ct - (al - ar);
  qb = 2.0 * kb * ct - (bl - br);
  // No sign change: no roll closes it. Hand back the level axle and let the
  // caller's `A-FIT` clause name it — a refusal is the CALLER's to report, so it
  // is reported once, against the converged pose.
  if qa > 0.0 || qb < 0.0 {
    (ll, rr) = hitched_pair(sample, px, pz, yaw, drawbar, half, theta, 0.0);
    return RollFit { rf_k: 0.0, rf_gl: ll, rf_gr: rr };
  }
  kt = 0.0;
  gl = al;
  gr = ar;
  held = 0;
  for it in 0..rounds {
    wide = kb - ka;
    den = qb - qa;
    kn = (ka + kb) * 0.5;
    if den != 0.0 { kn = (ka * qb - kb * qa) / den ?? kn; }
    lo = ka + wide * 0.001;
    hi = kb - wide * 0.001;
    if kn < lo { kn = lo; }
    if kn > hi { kn = hi; }
    (nl, nr) = hitched_pair(sample, px, pz, yaw, drawbar, half, theta, kn);
    qn = 2.0 * kn * ct - (nl - nr);
    kt = kn;
    gl = nl;
    gr = nr;
    if qn == 0.0 { break; }
    if qn > 0.0 {
      kb = kn;
      qb = qn;
      if held == 1 { qa = qa * 0.5; }
      held = 1;
    } else {
      ka = kn;
      qa = qn;
      if held == 0 - 1 { qb = qb * 0.5; }
      held = 0 - 1;
    }
    if kb - ka >= wide { break; }
  }
  RollFit { rf_k: kt, rf_gl: gl, rf_gr: gr }
}

pub fn hitched_rest(sample: fn(float, float) -> float,
                    px: float, py: float, pz: float, yaw: float,
                    drawbar: float, half: float, radius: float,
                    rounds: integer = 20) -> Rest {
  // ── the outer bracket: is the ground within the drawbar's reach at all ─────
  sa = 0.0 - 1.0;                              // sin θ = −1: axle a drawbar UP
  sb = 1.0;                                    // sin θ = +1: axle a drawbar DOWN
  ta = asin(sa) ?? 0.0;
  tb = asin(sb) ?? 0.0;
  ra = hitched_roll(sample, px, pz, yaw, drawbar, half, ta, rounds);
  rb = hitched_roll(sample, px, pz, yaw, drawbar, half, tb, rounds);
  fa = (py - drawbar * sa - radius) - (ra.rf_gl + ra.rf_gr) * 0.5;
  fb = (py - drawbar * sb - radius) - (rb.rf_gl + rb.rf_gr) * 0.5;

  // ⚠ ASKED ONCE, ON THE INTERVAL, INSTEAD OF EVERY ROUND ON A GUESS. `F` falls
  // as the axle swings down, so a sign change IS reachability. Without one the
  // pin is out of range in the direction the sign says, and the offer is the
  // pitch that came closest.
  if fb > 0.0 {
    h = (rb.rf_gl + rb.rf_gr) * 0.5 + radius;
    return Rest { rt_ok: false,
                  rt_frame: hitched_frame(px, py, pz, yaw, tb, 0.0),
                  rt_bank: 0.0, rt_rounds: 0, rt_resid: 0.0,
                  rt_reason: "the pin is {fabs(py - h)} above the axle, past a drawbar of {drawbar}",
                  rt_offer: tb, rt_over: fabs(py - h) - drawbar };
  }
  if fa < 0.0 {
    h = (ra.rf_gl + ra.rf_gr) * 0.5 + radius;
    return Rest { rt_ok: false,
                  rt_frame: hitched_frame(px, py, pz, yaw, ta, 0.0),
                  rt_bank: 0.0, rt_rounds: 0, rt_resid: 0.0,
                  rt_reason: "the pin is {fabs(py - h)} below the axle, past a drawbar of {drawbar}",
                  rt_offer: ta, rt_over: fabs(py - h) - drawbar };
  }

  // ── the pitch, by Illinois on sin θ ────────────────────────────────────────
  sp = sb;
  fit = rb;
  theta = tb;
  resid = 0.0;
  used = 0;
  held = 0;
  for it in 0..rounds {
    wide = sb - sa;
    den = fb - fa;
    sn = (sa + sb) * 0.5;
    if den != 0.0 { sn = (sa * fb - sb * fa) / den ?? sn; }
    lo = sa + wide * 0.001;
    hi = sb - wide * 0.001;
    if sn < lo { sn = lo; }
    if sn > hi { sn = hi; }
    tn = asin(sn) ?? 0.0;
    rn = hitched_roll(sample, px, pz, yaw, drawbar, half, tn, rounds);
    fn2 = (py - drawbar * sn - radius) - (rn.rf_gl + rn.rf_gr) * 0.5;
    resid = fabs(sn - sp);
    sp = sn;
    theta = tn;
    fit = rn;
    used = it + 1;
    if fn2 == 0.0 { break; }
    // `F` DECREASES with sin θ, so the signs go the other way round from `Q`.
    if fn2 < 0.0 {
      sb = sn;
      fb = fn2;
      if held == 1 { fa = fa * 0.5; }
      held = 1;
    } else {
      sa = sn;
      fa = fn2;
      if held == 0 - 1 { fb = fb * 0.5; }
      held = 0 - 1;
    }
    if sb - sa >= wide { break; }
  }

  reach = 2.0 * half * cos(theta);
  roll = asin(fit.rf_k / half ?? 0.0) ?? 0.0;
  rf = hitched_frame(px, py, pz, yaw, theta, roll);
  // ⚠ THE DROP IS READ OFF THE FRAME, NOT OFF THE SOLVE'S OWN SAMPLES, and that
  // is the same rule `A-GROUND` states at the top of this file — *a wrong pose
  // cannot report a right gap*. It is load-bearing HERE and not merely tidy.
  //
  // A cliff makes `Q` discontinuous, so the bracket collapses ONTO the jump, and
  // the jump sits at `|k| = w` where the axle is vertical and the solve's own two
  // contacts coincide: it reads `d = 0` and reports a rest. Measured on the test
  // cliff — roll `−π/2`, both sampled contacts at `z = 0`, `d = 0`, `ok true` —
  // while the frame puts the wheels at `z = ∓3.4e−17`, either side of the edge,
  // with a 3.0 drop between them and gaps of −0.55 and −2.45.
  //
  // ⚠ `ground_axle` does NOT need this and is left alone: its bracket runs on
  // `[0, w²]`, so the inside-the-bracket step stays strictly positive and its
  // contacts can never coincide. Here the bracket is `[−w, +w]` and the low end
  // IS the degenerate pose.
  wl = hitched_wheel(rf, drawbar, half, 0.0 - 1.0);
  wr = hitched_wheel(rf, drawbar, half, 1.0);
  d = sample(wl.x, wl.z) - sample(wr.x, wr.z);
  // ⚠ `A-FIT`, AT THE CONVERGED POSE. A drop the axle cannot straddle is a drop
  // the axle cannot straddle whoever is towing — but the reach it is measured
  // against is `2w·cos θ` at the pitch the body actually settled to, not at the
  // level seed the old solve asked from.
  if fabs(d) > reach {
    off = reach;
    if d < 0.0 { off = 0.0 - off; }
    return Rest { rt_ok: false,
                  rt_frame: hitched_frame(px, py, pz, yaw, theta, roll),
                  rt_bank: roll, rt_rounds: used, rt_resid: resid,
                  rt_reason: "ground drops {fabs(d)} across an axle of {reach}",
                  rt_offer: off, rt_over: fabs(d) - reach };
  }
  Rest { rt_ok: true,
         rt_frame: hitched_frame(px, py, pz, yaw, theta, roll),
         rt_bank: roll, rt_rounds: used, rt_resid: resid,
         rt_reason: "", rt_offer: 0.0, rt_over: 0.0 }
}

// ── `A-HITCH` — the pin, from both sides ────────────────────────────────────
//
// The coupling's con-rod. A `HITCH` removes three degrees of POSITION, so the
// pin computed from the parent and the pin computed from the child must be the
// same point — and a composition that merely *looks* right still moves
// convincingly, which is why this is measured and not assumed.
pub fn hitch_slack(parent: Xform, child: Xform, l: Link) -> float {
  from_parent = xform_apply(parent, vec3(l.lk_ox, l.lk_oy, l.lk_oz));
  v3_dist(from_parent, xform_origin(child))
}
