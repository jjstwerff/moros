// SPDX-License-Identifier: LGPL-3.0-or-later
//
// An ASSEMBLY: bodies, the links between them, and what holds each one up.
// Step `A1` of plans/14-props-dressing/CONNECTOR.md, which proves `A-TOPO` and
// `A-EXACT` and nothing else — no frames, no geometry, no solving.
//
// ── why this shape ──────────────────────────────────────────────────────────
//
// `hex_body::Rig` already solved the same problem one level down: a tree of
// bones with a canonical labelling, a strict parser and a byte-exact round
// trip. This mirrors it deliberately, down to the refusal contract — a
// malformed text reads back as an EMPTY assembly, which `asm_admissible` then
// rejects. A lenient reader would void the byte diff, so there is none.
//
// **The tree is over BODIES and the link is the edge.** Body `i` carries the
// link from `parent(i)` to itself, so there is exactly one link per non-root
// body and `A-TOPO`'s `p(0) = −1, 0 ≤ p(i) < i` is the whole of the topology.
// The root has no link, which is why `NoLink` exists and why `Carried` — *the
// link IS the support* — is inadmissible on it.
//
// ── what is DECLARED here and used later ────────────────────────────────────
//
// A body's `DRIVEN` and `SOLVED` state counts live on the body, because `A-DOF`
// says a state's kind is *declared, never inferred from the link*. `A2`'s
// ledger is then a pure function of an assembly and needs nothing new.
//
// ⚠ **Joint limits are in TURNS**, matching `hex_body`'s `rg_lo`/`rg_hi` — so a
// link's limits and a rig's are the same unit and `wheel_value`'s output drops
// straight in. Two units for one quantity is how a conversion goes missing.

// SELECTIVE, so nothing of `hex_body`'s beyond what an assembly stores lands in
// this package's bare surface. A rig is written and parsed by `hex_body` itself —
// one home for a rig's text, and `A-EXACT` inherits its byte-exactness.
use hex_body::(Rig, rig_new, rig_bone, rig_admissible, rig_write, rig_read, rig_eq);

// The families differ in which degrees of freedom they remove; flattening them
// into "a rigid mount with one revolute axis" is what the design's first draft
// got wrong, so they are named apart.
pub enum LinkKind { NoLink, Mount, Hitch, Shaft, Spring, Tether }

// Attachment is not support. A wheel is attached to the chassis and supported by
// the ground; a towed cart is attached to the horse and supported by its own
// wheels; a crate is supported by the attachment itself.
pub enum SupportKind { Unsupported, Ground, Carried, Buoyant }

// ⚠ ADDED BY `A9`, and `P4` is why it exists. The design hoped a wheel's proxy
// would fall out of `hex_body::bone_obb` — but that bounds a bone's CAPSULE, and
// a wheel's disc reaches `R` in every in-plane direction, so `disc ⊄ bone_obb`
// whenever the half-width is under `R`, which is always. A proxy that misses an
// overlap is the one thing `I4` forbids. So a body carries its shape KIND and
// derives its proxy from that: inherited was wrong, derived is not.
pub enum ShapeKind { Box, Disc, Capsule }

pub struct Link {
  lk_kind: LinkKind,
  lk_ox: float, lk_oy: float, lk_oz: float,   // offset in the parent's frame
  lk_ax: float, lk_ay: float, lk_az: float,   // the revolute axis, or a leg
  lk_lo: float, lk_hi: float,                 // joint limits, in TURNS
  lk_len: float                               // a tether's or spring's length
}

pub struct Body {
  bd_support: SupportKind,
  bd_driven: integer,                         // advanced from outside
  bd_solved: integer,                         // determined by equilibrium
  // ⚠ ADDED BY `A2`, not foreseen by `A1`. `A-DOF` says GROUND support *"removes
  // height, and bank/pitch per contact count"* — so the count is what decides
  // the support term, and without it the ledger cannot be a pure function of the
  // description. Nothing had been written to disk yet, so the format grew for
  // free; after `A5` it would have been a version bump.
  bd_contacts: integer,
  // The shape's kind, and its GIRTH — a half-thickness for a disc, a radius for a
  // capsule, a half-width for a box. ⚠ A girth of 0 means **no shape declared**,
  // which is a real case (a marker, a trigger) and not a defaulted one. The
  // EXTENT is never stored: it is derived from the rig, or from the body's own
  // attachment points. See `shape.loft`.
  bd_shape: ShapeKind = ShapeKind.Box,
  bd_girth: float
}

// A revolute joint with no authored limits. `hex_body` measures joint limits in
// TURNS, so this is "a thousand revolutions either way" — free in practice, and
// still a number a doorstep can report a residual against, which an unbounded
// sentinel could not.
pub const FREE_HI = 1000.0;
pub const FREE_LO = 0.0 - 1000.0;

pub struct Assembly {
  am_name: text,
  am_parent: vector<integer>,                 // parent body; −1 for the root
  am_link: vector<Link>,                      // the link from parent to body i
  am_body: vector<Body>,
  // ⚠ ADDED BY `A5`. A rig is MULTI-LINE text (`rig_write`), so it cannot ride on
  // a body's line and the format needs a SECTION — the same call the world file
  // already made (*tagged sections, not a flags word*). `A4` predicted this.
  //
  // Rigs are a LIBRARY and bodies index into it, so the cart's two wheels share
  // one spoke description instead of carrying a copy each. `−1` is no rig.
  am_rig: vector<Rig>,
  am_bodyrig: vector<integer>
}

pub fn asm_new(name: text) -> Assembly {
  Assembly { am_name: name, am_parent: [], am_link: [], am_body: [],
             am_rig: [], am_bodyrig: [] }
}

// Append a rig to the library and return its index, for a body to point at.
pub fn asm_rig(a: Assembly, r: Rig) -> integer {
  a.am_rig += [r];
  len(a.am_rig) - 1
}

// The root's link. Named rather than left to a default, because "the body with
// no link" is a real case the topology depends on.
pub fn link_none() -> Link {
  Link { lk_kind: LinkKind.NoLink,
         lk_ox: 0.0, lk_oy: 0.0, lk_oz: 0.0,
         lk_ax: 0.0, lk_ay: 0.0, lk_az: 0.0,
         lk_lo: 0.0, lk_hi: 0.0, lk_len: 0.0 }
}

// A rigid mount with one revolute axis — a hub, a kingpin, a hinge. `P3`
// measured that three of these with ZERO offset in series is a 3-DOF joint, and
// that a non-zero offset makes it a linkage instead, so the offset is not a
// convenience: it is what distinguishes the two.
pub fn link_mount(ox: float, oy: float, oz: float,
                  ax: float, ay: float, az: float,
                  lo: float = FREE_LO, hi: float = FREE_HI) -> Link {
  Link { lk_kind: LinkKind.Mount,
         lk_ox: ox, lk_oy: oy, lk_oz: oz,
         lk_ax: ax, lk_ay: ay, lk_az: az,
         lk_lo: lo, lk_hi: hi, lk_len: 0.0 }
}

pub fn link_hitch(ox: float, oy: float, oz: float) -> Link {
  Link { lk_kind: LinkKind.Hitch,
         lk_ox: ox, lk_oy: oy, lk_oz: oz,
         lk_ax: 0.0, lk_ay: 0.0, lk_az: 0.0,
         lk_lo: 0.0, lk_hi: 0.0, lk_len: 0.0 }
}

// A rope. ⚠ `A-TAUT` makes this the one link that is an INEQUALITY, so `lk_len`
// is a bound and not a distance — taut and slack have different DOF counts.
pub fn link_tether(ox: float, oy: float, oz: float, length: float) -> Link {
  Link { lk_kind: LinkKind.Tether,
         lk_ox: ox, lk_oy: oy, lk_oz: oz,
         lk_ax: 0.0, lk_ay: 0.0, lk_az: 0.0,
         lk_lo: 0.0, lk_hi: 0.0, lk_len: length }
}

pub fn body_of(sup: SupportKind, driven: integer, solved: integer,
               contacts: integer = 0, shape: ShapeKind = ShapeKind.Box,
               girth: float = 0.0) -> Body {
  Body { bd_support: sup, bd_driven: driven, bd_solved: solved,
         bd_contacts: contacts, bd_shape: shape, bd_girth: girth }
}

// Append one body with the link that reaches it. Index order IS the canonical
// labelling, so appending in topological order is the only way to build an
// admissible assembly — the same rule `rig_bone` follows.
pub fn asm_add(a: Assembly, parent: integer, l: Link, b: Body,
               rig: integer = 0 - 1) -> Assembly {
  a.am_parent += [parent];
  a.am_link += [l];
  a.am_body += [b];
  a.am_bodyrig += [rig];
  a
}

pub fn asm_count(a: Assembly) -> integer { len(a.am_parent) }

fn has_axis(l: Link) -> boolean {
  l.lk_ax != 0.0 || l.lk_ay != 0.0 || l.lk_az != 0.0
}

// ── `A-TOPO`, plus the clauses that make a kind mean something ───────────────

// One body's clauses, lifted out so the topology loop below stays readable and
// each family's requirement sits on its own line.
fn body_admissible(i: integer, p: integer, l: Link, b: Body) -> boolean {
  if i == 0 {
    if p != 0 - 1 { return false; }
    // the root is reached by nothing, so it must carry no link…
    if !(l.lk_kind is NoLink) { return false; }
    // …and `Carried` means "the link IS the support", which names nothing here
    if b.bd_support is Carried { return false; }
  } else {
    if p < 0 || p >= i { return false; }
    if l.lk_kind is NoLink { return false; }
  }
  if l.lk_lo > l.lk_hi { return false; }
  if b.bd_driven < 0 || b.bd_solved < 0 || b.bd_contacts < 0 { return false; }
  if b.bd_girth < 0.0 { return false; }
  // A body "supported by the ground" with no contacts is supported by nothing,
  // and contacts on a body the ground never touches are a number with no reader.
  if b.bd_support is Ground { if b.bd_contacts < 1 { return false; } }
  else { if b.bd_contacts != 0 { return false; } }
  // A revolute axis of length zero names no axis, and `P3` showed the axis is
  // what decides whether a chain of mounts spans SO(3) at all.
  if l.lk_kind is Mount { return has_axis(l); }
  if l.lk_kind is Spring { return has_axis(l) && l.lk_len > 0.0; }
  if l.lk_kind is Tether { return l.lk_len > 0.0; }
  true
}

// Topological order is the canonical labelling: the root is body 0 and every
// body's parent is an EARLIER body. That refuses a forward parent and every
// relabelling that breaks the order, which is what makes the byte round trip
// below a statement about ONE text per assembly.
pub fn asm_admissible(a: Assembly) -> boolean {
  n = len(a.am_parent);
  if n == 0 { return false; }
  // The name goes in the header as one word, so a space in it would produce a
  // text this reader could not take back — refused rather than quoted.
  if a.am_name == "" { return false; }
  if len(a.am_name.split(' ')) != 1 { return false; }
  if len(a.am_bodyrig) != n { return false; }
  // Every rig in the library must be one — an empty rig is how `rig_read`
  // refuses, so an inadmissible rig here means a text that did not parse.
  nr = len(a.am_rig);
  for k in 0..nr {
    if !rig_admissible(a.am_rig[k] ?? rig_new()) { return false; }
  }
  for i in 0..n {
    if !body_admissible(i, a.am_parent[i] ?? 0,
                        a.am_link[i] ?? link_none(),
                        a.am_body[i] ?? body_of(SupportKind.Unsupported, 0, 0)) {
      return false;
    }
    br = a.am_bodyrig[i] ?? 0;
    if br < 0 - 1 || br >= nr { return false; }
  }
  true
}

fn lk_name(k: LinkKind) -> text {
  match k {
    NoLink => "none", Mount => "mount", Hitch => "hitch",
    Shaft => "shaft", Spring => "spring", Tether => "tether",
  }
}

// −1 for a word that is not a link kind, so the parser can refuse it rather
// than fall back to a variant that happens to be first in the declaration.
fn lk_code(t: text) -> integer {
  if t == "none" { return 0; }
  if t == "mount" { return 1; }
  if t == "hitch" { return 2; }
  if t == "shaft" { return 3; }
  if t == "spring" { return 4; }
  if t == "tether" { return 5; }
  0 - 1
}

fn lk_from(c: integer) -> LinkKind {
  if c == 1 { return LinkKind.Mount; }
  if c == 2 { return LinkKind.Hitch; }
  if c == 3 { return LinkKind.Shaft; }
  if c == 4 { return LinkKind.Spring; }
  if c == 5 { return LinkKind.Tether; }
  LinkKind.NoLink
}

fn sh_name(k: ShapeKind) -> text {
  match k { Box => "box", Disc => "disc", Capsule => "capsule" }
}

fn sh_code(t: text) -> integer {
  if t == "box" { return 0; }
  if t == "disc" { return 1; }
  if t == "capsule" { return 2; }
  0 - 1
}

fn sh_from(c: integer) -> ShapeKind {
  if c == 1 { return ShapeKind.Disc; }
  if c == 2 { return ShapeKind.Capsule; }
  ShapeKind.Box
}

fn sp_name(k: SupportKind) -> text {
  match k {
    Unsupported => "none", Ground => "ground",
    Carried => "carried", Buoyant => "buoyant",
  }
}

fn sp_code(t: text) -> integer {
  if t == "none" { return 0; }
  if t == "ground" { return 1; }
  if t == "carried" { return 2; }
  if t == "buoyant" { return 3; }
  0 - 1
}

fn sp_from(c: integer) -> SupportKind {
  if c == 1 { return SupportKind.Ground; }
  if c == 2 { return SupportKind.Carried; }
  if c == 3 { return SupportKind.Buoyant; }
  SupportKind.Unsupported
}

// ── `A-EXACT` ───────────────────────────────────────────────────────────────
//
// An assembly is a DESCRIPTION, so `write(read(A)) = A` byte-for-byte with no
// tolerance: loft's float↔text round trip is exact, so nothing here rounds.
pub fn asm_write(a: Assembly) -> text {
  n = len(a.am_parent);
  nr = len(a.am_rig);
  s = "assembly {a.am_name} bodies {n} rigs {nr}";
  for i in 0..n {
    l = a.am_link[i] ?? link_none();
    b = a.am_body[i] ?? body_of(SupportKind.Unsupported, 0, 0);
    s = s + "\nbody {i} parent {a.am_parent[i] ?? 0} link {lk_name(l.lk_kind)}"
        + " at {l.lk_ox} {l.lk_oy} {l.lk_oz}"
        + " axis {l.lk_ax} {l.lk_ay} {l.lk_az}"
        + " lim {l.lk_lo} {l.lk_hi} len {l.lk_len}"
        + " support {sp_name(b.bd_support)}"
        + " driven {b.bd_driven} solved {b.bd_solved}"
        + " contacts {b.bd_contacts}"
        + " rig {a.am_bodyrig[i] ?? 0 - 1}"
        + " shape {sh_name(b.bd_shape)} girth {b.bd_girth}";
  }
  // Each rig is written by `hex_body` itself — one home for a rig's text — and
  // named by its INDEX, so the name carries no information a reader must trust.
  for k in 0..nr {
    s = s + "\n" + rig_write(a.am_rig[k] ?? rig_new(), "r{k}");
  }
  s
}

fn word(line: text, i: integer) -> text {
  parts = line.split(' ');
  parts[i] ?? ""
}
fn word_int(line: text, i: integer) -> integer { word(line, i) as integer ?? 0 }
fn word_float(line: text, i: integer) -> float { word(line, i) as float ?? 0.0 }

// ⚠ THE PARSERS ARE PURE, AND THAT IS NOT A STYLE CHOICE. The first version had
// them take the `Assembly` and append to it, relying on heap aliasing to carry the
// mutation back through two by-value parameters into `asm_read`'s local. The
// interpreter SIGSEGV'd on it. Returning the parsed pieces and appending in ONE
// place is both the safe shape and the clearer one.
struct ParsedBody {
  pb_ok: boolean, pb_parent: integer,
  pb_link: Link, pb_body: Body, pb_rig: integer
}

struct ParsedRig { pr_taken: integer, pr_rig: Rig }

fn parse_fail() -> ParsedBody {
  ParsedBody { pb_ok: false, pb_parent: 0, pb_link: link_none(),
               pb_body: body_of(SupportKind.Unsupported, 0, 0), pb_rig: 0 - 1 }
}

// One body line. Every keyword is checked in place and the index must equal its
// line, so a relabelled text is refused before any field is trusted.
fn read_body_line(ln: text, ri: integer) -> ParsedBody {
  if word(ln, 0) != "body" { return parse_fail(); }
  if word_int(ln, 1) != ri - 1 { return parse_fail(); }
  if word(ln, 2) != "parent" { return parse_fail(); }
  if word(ln, 4) != "link" { return parse_fail(); }
  if word(ln, 6) != "at" { return parse_fail(); }
  if word(ln, 10) != "axis" { return parse_fail(); }
  if word(ln, 14) != "lim" { return parse_fail(); }
  if word(ln, 17) != "len" { return parse_fail(); }
  if word(ln, 19) != "support" { return parse_fail(); }
  if word(ln, 21) != "driven" { return parse_fail(); }
  if word(ln, 23) != "solved" { return parse_fail(); }
  if word(ln, 25) != "contacts" { return parse_fail(); }
  if word(ln, 27) != "rig" { return parse_fail(); }
  if word(ln, 29) != "shape" { return parse_fail(); }
  if word(ln, 31) != "girth" { return parse_fail(); }
  lc = lk_code(word(ln, 5));
  sc = sp_code(word(ln, 20));
  hc = sh_code(word(ln, 30));
  if lc < 0 || sc < 0 || hc < 0 { return parse_fail(); }
  // A line missing its last field would otherwise read as 0, so the field itself
  // — not just the keyword before it — has to be there.
  if word(ln, 32) == "" { return parse_fail(); }
  ParsedBody { pb_ok: true, pb_parent: word_int(ln, 3),
    pb_link: Link { lk_kind: lk_from(lc),
           lk_ox: word_float(ln, 7), lk_oy: word_float(ln, 8),
           lk_oz: word_float(ln, 9),
           lk_ax: word_float(ln, 11), lk_ay: word_float(ln, 12),
           lk_az: word_float(ln, 13),
           lk_lo: word_float(ln, 15), lk_hi: word_float(ln, 16),
           lk_len: word_float(ln, 18) },
    pb_body: Body { bd_support: sp_from(sc),
           bd_driven: word_int(ln, 22), bd_solved: word_int(ln, 24),
           bd_contacts: word_int(ln, 26),
           bd_shape: sh_from(hc), bd_girth: word_float(ln, 32) },
    pb_rig: word_int(ln, 28) }
}

// One rig block, appended to `out`'s library. Returns how many lines it consumed,
// or 0 to refuse — which keeps the reader's own control flow flat.
fn read_rig_block(lines: vector<text>, pos: integer, k: integer) -> ParsedRig {
  bad = ParsedRig { pr_taken: 0, pr_rig: rig_new() };
  nl = len(lines);
  if pos >= nl { return bad; }
  rh = lines[pos] ?? "";
  if word(rh, 0) != "rig" { return bad; }
  if word(rh, 1) != "r{k}" { return bad; }
  if word(rh, 2) != "bones" { return bad; }
  nbones = word_int(rh, 3);
  if nbones < 1 { return bad; }
  if pos + nbones >= nl { return bad; }
  blk = rh;
  for bi in 1..=nbones { blk = blk + "\n" + (lines[pos + bi] ?? ""); }
  rr = rig_read(blk);
  if !rig_admissible(rr) { return bad; }
  // ⚠ AND THE BLOCK MUST WRITE BACK TO ITSELF. `hex_body`'s `rig_read` says it
  // *"accepts exactly what `rig_write` emits, refuses anything else"* — but a bone
  // line missing its trailing `hi` parses, reading the absent field as 0, so a
  // REPAIRED rig can come back looking valid. Rather than change a library two
  // consumers read, `A-EXACT` is enforced AT THE SEAM: whatever leniency the
  // sub-parser has, a text that does not round-trip is refused here.
  if rig_write(rr, "r{k}") != blk { return bad; }
  ParsedRig { pr_taken: nbones + 1, pr_rig: rr }
}

// STRICT — accepts exactly what `asm_write` emits and refuses everything else by
// returning an empty assembly, which `asm_admissible` rejects. Every keyword is
// checked in place, the body index must equal its line, and the header's count
// must equal the number of lines: a truncated text fails on that count before
// any field is read.
pub fn asm_read(t: text) -> Assembly {
  lines = t.split('\n');
  nl = len(lines);
  if nl < 1 { return asm_new(""); }
  head = lines[0] ?? "";
  if word(head, 0) != "assembly" { return asm_new(""); }
  if word(head, 2) != "bodies" { return asm_new(""); }
  if word(head, 4) != "rigs" { return asm_new(""); }
  nb = word_int(head, 3);
  nr = word_int(head, 5);
  if nb < 1 || nr < 0 { return asm_new(""); }
  // A truncated text fails HERE, before any field is read.
  if nl < nb + 1 { return asm_new(""); }
  out = asm_new(word(head, 1));
  for ri in 1..(nb + 1) {
    pb = read_body_line(lines[ri] ?? "", ri);
    if !pb.pb_ok { return asm_new(""); }
    out = asm_add(out, pb.pb_parent, pb.pb_link, pb.pb_body, pb.pb_rig);
  }
  // ── the rig section ────────────────────────────────────────────────────────
  // Each block is handed to `hex_body`'s own reader, so a rig's text has one
  // parser, and the whole text must be consumed EXACTLY — a trailing line is a
  // text no writer emits.
  pos = nb + 1;
  for k in 0..nr {
    pr = read_rig_block(lines, pos, k);
    if pr.pr_taken <= 0 { return asm_new(""); }
    out.am_rig += [pr.pr_rig];
    pos = pos + pr.pr_taken;
  }
  if pos != nl { return asm_new(""); }
  out
}

// Byte-exact equality: floats with `==`, no tolerance.
pub fn asm_eq(a: Assembly, b: Assembly) -> boolean {
  n = len(a.am_parent);
  if len(b.am_parent) != n { return false; }
  if a.am_name != b.am_name { return false; }
  nr = len(a.am_rig);
  if len(b.am_rig) != nr { return false; }
  for k in 0..nr {
    if !rig_eq(a.am_rig[k] ?? rig_new(), b.am_rig[k] ?? rig_new()) { return false; }
  }
  for i in 0..n {
    if (a.am_parent[i] ?? 0) != (b.am_parent[i] ?? 0) { return false; }
    la = a.am_link[i] ?? link_none();
    lb = b.am_link[i] ?? link_none();
    if lk_name(la.lk_kind) != lk_name(lb.lk_kind) { return false; }
    if la.lk_ox != lb.lk_ox || la.lk_oy != lb.lk_oy || la.lk_oz != lb.lk_oz { return false; }
    if la.lk_ax != lb.lk_ax || la.lk_ay != lb.lk_ay || la.lk_az != lb.lk_az { return false; }
    if la.lk_lo != lb.lk_lo || la.lk_hi != lb.lk_hi { return false; }
    if la.lk_len != lb.lk_len { return false; }
    ba = a.am_body[i] ?? body_of(SupportKind.Unsupported, 0, 0);
    bb = b.am_body[i] ?? body_of(SupportKind.Unsupported, 0, 0);
    if sp_name(ba.bd_support) != sp_name(bb.bd_support) { return false; }
    if ba.bd_driven != bb.bd_driven || ba.bd_solved != bb.bd_solved { return false; }
    if ba.bd_contacts != bb.bd_contacts { return false; }
    if sh_name(ba.bd_shape) != sh_name(bb.bd_shape) { return false; }
    if ba.bd_girth != bb.bd_girth { return false; }
    if (a.am_bodyrig[i] ?? 0) != (b.am_bodyrig[i] ?? 0) { return false; }
  }
  true
}

// ── the cart, as data ───────────────────────────────────────────────────────
//
// The assembly the editor already draws: a chassis on the ground, two wheels
// mounted at ±`half` on the axle, each spinning about it. `A5` is where the
// editor's transforms are measured against this; here it is the fixture that
// keeps every clause above about a real assembly rather than a made-up one.
//
// The ledger it declares, which `A2` will check: the chassis carries `x, z,
// yaw` DRIVEN and is supported by two ground contacts; each wheel is `Carried`
// by its mount with its spin DRIVEN from travel.
// ⚠ THE RADIUS ARRIVES HERE, AND AS A RIG. `A1` left it out because it had no
// reader; `A4` gave it one. A wheel is a SPOKE of length `radius` — that is how
// `hex_body` models one, and it is why `P1` found the spin in the segment. So the
// radius is `rg_len[0]` and has exactly one home, from which `A9`'s shape and
// proxy will be DERIVED rather than told.
//
// Both wheels share one rig: the library is indexed, so a description used twice
// is stored once.
pub fn asm_cart(half: float, radius: float) -> Assembly {
  a = asm_new("cart");
  spoke = asm_rig(a, rig_bone(rig_new(), 0 - 1, 0.0, 0.0, radius,
                              FREE_LO, FREE_HI));
  a = asm_add(a, 0 - 1, link_none(),
              body_of(SupportKind.Ground, 3, 0, 2, ShapeKind.Box, radius * 0.5));
  a = asm_add(a, 0, link_mount(0.0, 0.0, 0.0 - half, 0.0, 0.0, 1.0),
              body_of(SupportKind.Carried, 1, 0, 0, ShapeKind.Disc, radius * 0.15),
              spoke);
  a = asm_add(a, 0, link_mount(0.0, 0.0, half, 0.0, 0.0, 1.0),
              body_of(SupportKind.Carried, 1, 0, 0, ShapeKind.Disc, radius * 0.15),
              spoke);
  a
}

// ── the towed cart, which is the case the design's first draft got wrong ─────
//
// A horse, and a cart on a `HITCH` behind it. ⚠ The cart's support is `Ground`,
// NOT `Carried`: it has its own wheels, so the hitch couples two frames rather
// than parenting one to the other. That distinction is why `SupportKind` is a
// separate axis from `LinkKind` at all, and it is the fixture that keeps
// `link_hitch` from being a name nothing exercises.
pub fn asm_towed(half: float, drawbar: float) -> Assembly {
  a = asm_new("towed");
  a = asm_add(a, 0 - 1, link_none(), body_of(SupportKind.Ground, 3, 0, 4));
  a = asm_add(a, 0, link_hitch(0.0 - drawbar, 0.0, 0.0),
              body_of(SupportKind.Ground, 1, 0, 2));
  a = asm_add(a, 1, link_mount(0.0, 0.0, 0.0 - half, 0.0, 0.0, 1.0),
              body_of(SupportKind.Carried, 1, 0));
  a = asm_add(a, 1, link_mount(0.0, 0.0, half, 0.0, 0.0, 1.0),
              body_of(SupportKind.Carried, 1, 0));
  a
}

// A TEAM: two horses abreast on one cart — and it IS a tree.
//
// ⚠ `CONNECTOR.md` recorded the opposite, that *"a team is two links into one body,
// which `A-TOPO` forbids"*, with a yoke body as the likely repair. Probed
// (`probe/team.loft`), **both halves were wrong**:
//
//   · The two-parents problem is an artifact of choosing the HORSES as the roots.
//     The root is a LABELLING choice, not a physical fact — re-root at the cart and
//     every body has exactly one parent again. `asm_towed` roots at the horse
//     because there is only one puller; with two, that convention simply does not
//     generalise, and nothing but the convention was ever in the way.
//   · A yoke on two ball hitches is **DOF-NEUTRAL** — it adds a body worth six and
//     two hitches worth three each, so mobility is unchanged at 4. It does not hold
//     the horses abreast, and it is the only thing here that would make the graph
//     non-tree. The proposed repair was a cost with no benefit.
//
// What a team would need to break the tree is a pole with joints STIFFER than
// hitches — a real coupling. That is a closed chain and genuinely outside this
// representation; it is not what two hitched horses are.
pub fn asm_team(reach: float, half: float) -> Assembly {
  a = asm_new("team");
  // the cart is the root: on the ground, on two wheels
  a = asm_add(a, 0 - 1, link_none(), body_of(SupportKind.Ground, 4, 0, 2));
  // one horse each side of the pole line, each hitched, each on its own four feet
  a = asm_add(a, 0, link_hitch(reach, 0.0, 0.0 - half),
              body_of(SupportKind.Ground, 0, 0, 4));
  a = asm_add(a, 0, link_hitch(reach, 0.0, half),
              body_of(SupportKind.Ground, 0, 0, 4));
  a
}

// ── `A-DOF` — the ledger ─────────────────────────────────────────────────────
//
// > Every body's six degrees of freedom are accounted for exactly once: removed
// > by a link, removed by a support, or carried as a named state.
//
//     dof(links) + dof(support) + dof(driven) + dof(solved) = 6      per body
//
// Under-count and something is pinned by accident — a value nobody chose and no
// test names. Over-count and the body is over-constrained, which is a real
// physical situation that must be **refused or sprung**, never silently averaged
// away. It is a COUNTING argument, so it can be checked rather than argued, and
// that is the whole of this section.
//
// ⚠ **It reproduces every row of the design's own table**, including the two the
// prose calls out: a towed 4-wheel trailer comes out over-constrained by exactly
// one — *"the 4th wheel"* — and today's unhitched cart comes out at **5**.
//
// ⚠ **It counts NOMINAL degrees.** `P3` measured a mechanism that satisfies the
// count and still loses a direction at a gimbal pose, so a closed ledger is
// necessary and not sufficient. Rank is geometry, and geometry is `A3` onward.
pub const DOF_PER_BODY = 6;

// Contacts constrain height and two rotations, and no more: on a rigid body a
// fourth contact is redundant with the first three. That bound is what turns a
// four-wheeled trailer's extra wheel into a stated over-constraint instead of a
// silent average.
pub const GROUND_MAX = 3;

pub struct Ledger {
  dg_links: integer,
  dg_support: integer,
  dg_driven: integer,
  dg_solved: integer,
  dg_total: integer,
  // 6 − total. Positive is UNDER-determined, negative is OVER-constrained, and
  // the sign is what tells a caller whether to refuse or to look for what is
  // being pinned by nothing.
  dg_residual: integer
}

fn min_i(a: integer, b: integer) -> integer { if a < b { a } else { b } }

// What each family removes. The design's first draft had only `MOUNT`, and
// flattening the rest into it is what made a towed cart and a dangling crate
// look like the same problem.
pub fn dof_link(k: LinkKind) -> integer {
  match k {
    NoLink => 0,
    Mount => 5,                 // rigid but for one revolute axis
    Shaft => 5,                 // a pair of rigid shafts: yaw only
    Spring => 5,                // five, one of them compliantly
    Hitch => 3,                 // a ball or pin: position only
    Tether => 1,                // radial, and only when TAUT — see below
  }
}

pub fn dof_support(k: SupportKind, contacts: integer) -> integer {
  match k {
    Unsupported => 0,
    Carried => 0,               // the link IS the support; it already did this
    Buoyant => 1,               // an equilibrium altitude, and nothing else
    Ground => min_i(contacts, GROUND_MAX),
  }
}

pub fn body_ledger(a: Assembly, i: integer) -> Ledger {
  l = a.am_link[i] ?? link_none();
  b = a.am_body[i] ?? body_of(SupportKind.Unsupported, 0, 0);
  dl = dof_link(l.lk_kind);
  ds = dof_support(b.bd_support, b.bd_contacts);
  t = dl + ds + b.bd_driven + b.bd_solved;
  Ledger { dg_links: dl, dg_support: ds,
           dg_driven: b.bd_driven, dg_solved: b.bd_solved,
           dg_total: t, dg_residual: DOF_PER_BODY - t }
}

// A tether is an INEQUALITY, so it has TWO ledgers. Taut it removes one degree;
// slack it removes nothing and that degree becomes a state — which is why the
// slack ledger closes exactly when the taut one does, and why one declaration
// suffices for both. The transition is a reported doorstep (`A-TAUT`), not a
// branch hidden inside a solver.
pub fn body_ledger_slack(a: Assembly, i: integer) -> Ledger {
  l = a.am_link[i] ?? link_none();
  g = body_ledger(a, i);
  if !(l.lk_kind is Tether) { return g; }
  Ledger { dg_links: 0, dg_support: g.dg_support,
           dg_driven: g.dg_driven + g.dg_links, dg_solved: g.dg_solved,
           dg_total: g.dg_total, dg_residual: g.dg_residual }
}

pub fn ledger_closed(g: Ledger) -> boolean { g.dg_residual == 0 }

pub fn asm_closes(a: Assembly) -> boolean {
  n = len(a.am_parent);
  if n == 0 { return false; }
  for i in 0..n { if !ledger_closed(body_ledger(a, i)) { return false; } }
  true
}

// `K-FIT`'s shape: a reason, and a RESIDUAL. A ledger that failed silently would
// be no better than the pitch nobody was supplying.
pub fn ledger_verdict(g: Ledger) -> text {
  if g.dg_residual == 0 { return "closes"; }
  if g.dg_residual > 0 {
    return "UNDER-DETERMINED by {g.dg_residual} — that many degrees are supplied by nothing";
  }
  "OVER-CONSTRAINED by {0 - g.dg_residual} — refuse with this residual, or absorb it in a SPRING"
}

pub fn asm_ledger_report(a: Assembly) -> text {
  n = len(a.am_parent);
  s = "ledger {a.am_name} bodies {n}";
  for i in 0..n {
    g = body_ledger(a, i);
    s = s + "\nbody {i} links {g.dg_links} support {g.dg_support}"
        + " driven {g.dg_driven} solved {g.dg_solved} total {g.dg_total}"
        + " {ledger_verdict(g)}";
  }
  s
}

// ── the fixtures the table names, so the count is checked and not argued ─────

// A cart in RIGID SHAFTS, on the ground. The shafts leave yaw only, the wheels
// still touch — and the ledger says over-constrained by two, which is true: a
// real cart in rigid shafts on uneven ground has compliance somewhere.
pub fn asm_shafted(half: float) -> Assembly {
  a = asm_new("shafted");
  a = asm_add(a, 0 - 1, link_none(), body_of(SupportKind.Ground, 3, 0, 4));
  a = asm_add(a, 0, Link { lk_kind: LinkKind.Shaft,
                           lk_ox: 0.0 - 1.6, lk_oy: 0.0, lk_oz: 0.0,
                           lk_ax: 0.0, lk_ay: 0.0, lk_az: 0.0,
                           lk_lo: 0.0, lk_hi: 0.0, lk_len: 0.0 },
              body_of(SupportKind.Ground, 1, 0, 2));
  a = asm_add(a, 1, link_mount(0.0, 0.0, 0.0 - half, 0.0, 0.0, 1.0),
              body_of(SupportKind.Carried, 1, 0));
  a
}

// The four-wheel trailer, which the design's prose says is over-constrained by
// its fourth wheel. The count agrees, and says exactly one.
pub fn asm_trailer4() -> Assembly {
  a = asm_new("trailer4");
  a = asm_add(a, 0 - 1, link_none(), body_of(SupportKind.Ground, 3, 0, 4));
  a = asm_add(a, 0, link_hitch(0.0 - 1.6, 0.0, 0.0),
              body_of(SupportKind.Ground, 1, 0, 4));
  a
}

// A crate under a balloon: the case that broke the design's first draft, because
// nothing about "solved from the ground contacts" applies to it. The balloon's
// pitch and roll are SOLVED — it hangs to rest — while the crate's five are
// DRIVEN, which is the declaration that lets it swing.
pub fn asm_balloon(rope: float) -> Assembly {
  a = asm_new("balloon");
  a = asm_add(a, 0 - 1, link_none(), body_of(SupportKind.Buoyant, 3, 2));
  a = asm_add(a, 0, link_tether(0.0, 0.0 - 0.2, 0.0, rope),
              body_of(SupportKind.Carried, 5, 0));
  a
}

// A wing as `n` stations off a parked fuselage, each `CARRIED` by its mount with
// its bend SOLVED from the load. `P6` measured what `n` costs in shape error;
// this is what it costs in the ledger, which is nothing — every station closes.
pub fn asm_wing(n: integer, seg: float) -> Assembly {
  a = asm_new("wing");
  a = asm_add(a, 0 - 1, link_none(), body_of(SupportKind.Ground, 3, 0, 3));
  for i in 0..n {
    a = asm_add(a, i, link_mount(0.0, 0.0 - seg, 0.0, 0.0, 0.0, 1.0),
                body_of(SupportKind.Carried, 0, 1));
  }
  a
}
