// Plan 17 `A3.3` — `expand == bake`, and the two paths that share only the part.
use hex_part;
use hex_world;

fn no_palette() -> vector<integer> { [] }
fn no_kids() -> vector<PartInst> { [] }
fn root() -> text { "{temp_dir()}/hexpart_bake_lib" }

fn at(part: text, q: integer, r: integer, h: integer) -> PartInst {
  PartInst { pi_q: q, pi_r: r, pi_h: h, pi_facing: 0, pi_part: part }
}

fn one_cell(mat: integer) -> World {
  w = world_new(0.25, 0, 8, 3).wn_world;
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
    co_cells: [Hex { h_height: 40 as u16? ?? 0,
                     h_material: mat as u8? ?? 0 }] }).cw_code == CW_OK, "fixture");
  w
}

fn put(name: text, mat: integer, kids: vector<PartInst>) {
  assert(mkdir_all("{root()}/{name.dir()}").ok(), "mkdir for {name}");
  w = one_cell(mat);
  if len(kids) > 0 {
    assert(part_set_instances(w, kids) == PI_OK, "instances of {name} refused");
  }
  assert(world_save(w, "{root()}/{name}.hxw", no_palette()) == WS_OK, "save {name}");
}

fn wipe() {
  for d in list_dir(root()) ?? [] {
    for e in list_dir("{root()}/{d}") ?? [] { delete("{root()}/{d}/{e}"); }
    delete("{root()}/{d}");
  }
  delete(root());
}

fn target() -> World {
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in (0 - 4)..14 {
    for r in (0 - 4)..14 {
      // ⚠ `world_set_cell`, not a one-cell column write — 25 us against 415, and
      // this loop runs per test. See `probe/perf/place_phases.loft` `G1`.
      assert(world_set_cell(w, q, r, 0,
        Hex { h_height: 5 as u16? ?? 0,
              h_material: 1 as u8? ?? 0 }).cw_code == CW_OK, "ground");
    }
  }
  w
}

// ── The equivalence ──────────────────────────────────────────────────────────
//
// ⚠ THE TWO PATHS SHARE THE PART FILES AND `un_origin`, AND NOTHING ELSE.
// `expand` stamps each part of the nest into a target that already has terrain,
// merging bands at composed WORLD coordinates. `bake` composes the same nest
// into PART-LOCAL coordinates in a table, writes each column once into an empty
// part, and is then placed by a single stamp. If they agree cell for cell, the
// composition is right; if one function did both, the test would prove nothing.

// ⚠ THREE LEVELS, AND TWO IS NOT ENOUGH — measured, not assumed. The root is
// placed at `(0,0)`, and `un_origin(0, 0, dq, dr)` IS the naive sum there, so a
// one-level nest exercises the frame composition only at the identity. Breaking
// `bake` to use `cq + dq` deliberately left all 95 tests GREEN. The grandchild
// composes from `(2,1)`, where `un_origin` gives `(6,2)` and the naive sum gives
// `(5,2)` — that is the first place the two disagree, so that is where the
// fixture has to reach. ⚠ An odd row and a non-zero lift at every level too: an
// even row hides every parity bug and a zero lift hides the height accumulation.
fn nest() {
  wipe();
  put("h/leaf", 7, no_kids());
  put("h/mid",  5, [at("h/leaf", 3, 1, 4)]);
  put("h/nest", 3, [at("h/mid",  2, 1, 6)]);
}

fn expanded() -> World {
  w = target();
  ex = part_expand(w, root(), at("h/nest", 0, 0, 0), 10);
  assert(ex.ex_code == EX_OK, "expand refused: {ex.ex_why}");
  w
}

fn baked() -> World {
  bk = part_bake(root(), "h/nest");
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  w = target();
  st = part_stamp(w, bk.bk_world, 0, 0, 0, 10);
  assert(st.ps_code == PS_OK, "the baked stamp was refused: {st.ps_why}");
  w
}

fn test_expand_and_bake_agree_cell_for_cell() {
  nest();
  d = part_diff(expanded(), baked(), 10);
  assert(d.pd_same, "expand and bake disagree: {d.pd_why}");
}

// ⚠ THE CONTROL, AND THE EQUIVALENCE IS VACUOUS WITHOUT IT. `part_diff` walking
// two worlds that are mostly seeded ground will report `same` for a great many
// wrong answers, so it has to be shown reporting a difference on this subject
// before its agreement means anything.
fn test_the_control_the_comparison_reports_a_difference_when_there_is_one() {
  nest();
  bk = part_bake(root(), "h/leaf");        // the LEAF, not the nest
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  w = target();
  assert(part_stamp(w, bk.bk_world, 0, 0, 0, 10).ps_code == PS_OK, "stamp");
  d = part_diff(expanded(), w, 10);
  assert(!d.pd_same,
         "the comparison called a one-part bake equal to a two-part expansion");
}

// ── The table, and the case it exists for ────────────────────────────────────

fn test_two_parts_in_one_column_both_survive_the_flattening() {
  wipe();
  put("h/leaf", 7, no_kids());
  put("h/stack", 3, [at("h/leaf", 0, 0, 60)]);   // the SAME column, lifted clear
  bk = part_bake(root(), "h/stack");
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  n = len(column_cells(world_column(bk.bk_world, 0, 0)));
  assert(n == 2, "the shared column holds {n} cells, not 2 — one part overwrote "
               + "the other, which is what the table exists to stop");
}

fn test_a_flattened_column_keeps_height_order() {
  wipe();
  put("h/leaf", 7, no_kids());
  put("h/stack", 3, [at("h/leaf", 0, 0, 60)]);
  bk = part_bake(root(), "h/stack");
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  cs = column_cells(world_column(bk.bk_world, 0, 0));
  a = (cs[0] ?? Hex {}).h_height as integer ?? 0;
  b = (cs[1] ?? Hex {}).h_height as integer ?? 0;
  assert(a < b, "the column came out {a} then {b} — out of height order");
}

// ── A bake is INST-free, which is the whole point of it ──────────────────────

fn test_a_baked_part_carries_no_instances() {
  nest();
  bk = part_bake(root(), "h/nest");
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  got = part_instances(bk.bk_world);
  assert(len(got.ir_items) == 0,
         "the flattened part still names {len(got.ir_items)} instances");
}

fn test_a_bake_keeps_the_roots_constants() {
  nest();
  bk = part_bake(root(), "h/nest");
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  assert(bk.bk_world.w_eps == 8 && bk.bk_world.w_theta == 3,
         "the flattening invented its own constants");
}

fn test_a_bake_counts_every_part_it_flattened() {
  nest();
  bk = part_bake(root(), "h/nest");
  assert(bk.bk_code == BK_OK, "bake refused: {bk.bk_why}");
  assert(bk.bk_parts == 3, "{bk.bk_parts} parts flattened, not 3");
}

// ── The same three answers `expand` gives ────────────────────────────────────

fn test_a_missing_part_is_missing() {
  wipe();
  put("h/nest", 3, [at("h/absent", 2, 0, 0)]);
  bk = part_bake(root(), "h/nest");
  assert(bk.bk_code == BK_MISSING, "a typo baked with code {bk.bk_code}");
}

fn test_a_facing_is_refused() {
  wipe();
  put("h/leaf", 7, no_kids());
  put("h/turned", 3, [PartInst { pi_q: 2, pi_r: 0, pi_h: 0, pi_facing: 6,
                                 pi_part: "h/leaf" }]);
  bk = part_bake(root(), "h/turned");
  assert(bk.bk_code == BK_FACING, "a turned child baked with code {bk.bk_code}");
}

// ── §P8, both rules, at the flattening ───────────────────────────────────────
//
// ⚠ `A3.2` BOUNDED `expand` AND LEFT `bake` UNTESTED, which is the gap `A3.4`
// found: the constant was shared, the coverage was not.

fn chain(n: integer) {
  wipe();
  put("h/c{n}", 3, no_kids());
  i = n - 1;
  while i >= 1 {
    put("h/c{i}", 3, [at("h/c{i + 1}", 1, 0, 0)]);
    i = i - 1;
  }
}

fn test_a_nest_nine_deep_is_refused_by_the_bake_too() {
  chain(9);
  bk = part_bake(root(), "h/c1");
  assert(bk.bk_code == BK_DEPTH, "nine deep baked with code {bk.bk_code}: {bk.bk_why}");
}

// ⚠ THE CONTROL. A bound that refuses everything passes the test above.
fn test_the_control_a_nest_eight_deep_bakes() {
  chain(8);
  bk = part_bake(root(), "h/c1");
  assert(bk.bk_code == BK_OK, "eight deep was refused: {bk.bk_why}");
  assert(bk.bk_parts == 8, "{bk.bk_parts} parts flattened for an eight-deep nest");
}

// ── A cycle is a cycle, not a depth overflow ─────────────────────────────────
//
// ⚠ MEASURED WRONG FIRST. `h/a → h/b → h/a` reported *"nested 9 deep; the bound
// is 8"* from both paths, which is true and useless: the library's deepest nest
// is two, so the author is sent looking for something that is not there. §P8's
// two rules meet here and the diagnosis has to tell them apart.

fn loop_lib() {
  wipe();
  put("h/a", 3, [at("h/b", 1, 0, 0)]);
  put("h/b", 5, [at("h/a", 1, 0, 0)]);
}

fn test_a_cycle_bakes_as_a_cycle_and_names_its_chain() {
  loop_lib();
  bk = part_bake(root(), "h/a");
  assert(bk.bk_code == BK_CYCLE, "a loop baked with code {bk.bk_code}: {bk.bk_why}");
  assert(bk.bk_why.find("h/a → h/b → h/a") != null,
         "the refusal does not carry the chain: '{bk.bk_why}'");
}

fn test_a_cycle_expands_as_a_cycle_too() {
  loop_lib();
  w = target();
  ex = part_expand(w, root(), at("h/a", 2, 2, 0), 10);
  assert(ex.ex_code == EX_CYCLE, "a loop expanded with code {ex.ex_code}: {ex.ex_why}");
  assert(ex.ex_why.find("h/a → h/b → h/a") != null,
         "the refusal does not carry the chain: '{ex.ex_why}'");
}

// ⚠ THE CONTROL THAT KEEPS THE TWO RULES APART. A nest that is genuinely too
// deep and has NO cycle must still report depth — otherwise the upgrade above
// would have turned every overflow into a cycle and lost the other answer.
fn test_the_control_a_deep_nest_with_no_cycle_still_reports_depth() {
  chain(9);
  bk = part_bake(root(), "h/c1");
  assert(bk.bk_code == BK_DEPTH,
         "a cycle-free nine-deep nest reported {bk.bk_code} — the two rules "
         + "have been collapsed into one");
}

// ── `BK_WALL` — a wall profile cannot survive a flattening — `A8.8`, §P9.13 ──
//
// ⚠ A REFUSAL WITH NO TEST IS THE TRAP THIS TREE HAS A NAME FOR. `A6.3` found a
// test about an ABSENCE that started out unable to fail, so each claim below is
// paired with the composition that must go the OTHER way.

fn wall_lib(rootwall: PartWall, kidwall: PartWall, kidhas: boolean) {
  assert(mkdir_all("{root()}/pair").ok(), "mkdir");
  kid = one_cell(4);
  if kidhas {
    assert(part_set_wall(kid, kidwall) == WA_OK, "the child's profile was refused");
  }
  assert(world_save(kid, "{root()}/pair/kid.hxw", no_palette()) == WS_OK, "save kid");
  top = one_cell(4);
  assert(part_set_instances(top, [at("pair/kid", 1, 0, 0)]) == PI_OK, "instances");
  assert(part_set_wall(top, rootwall) == WA_OK, "the root's profile was refused");
  assert(world_save(top, "{root()}/pair/top.hxw", no_palette()) == WS_OK, "save top");
}

fn test_a_child_with_its_own_wall_profile_is_refused_by_bake() {
  wipe();
  // The real composition: a timber leaf inside a stone frame. Flattened, the
  // leaf comes out stone — every column present, every count agreeing.
  wall_lib(PartWall { wa_up: 12, wa_surface: "wall" },
           PartWall { wa_up: 10, wa_surface: "floor" }, true);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_WALL,
         "a differing wall profile baked with code {bk.bk_code}: {bk.bk_why}");
  assert(bk.bk_why.find("floor") != null && bk.bk_why.find("wall") != null,
         "the reason names neither profile: {bk.bk_why}");
  wipe();
}

fn test_an_unstated_child_inside_a_stated_root_is_refused_too() {
  wipe();
  // ⚠ UNSTATED IS A VALUE, NOT A WILDCARD. The child would be redrawn at the
  // root's height and colour, which is the same silent loss one field along.
  wall_lib(PartWall { wa_up: 9, wa_surface: "frame" }, PartWall {}, false);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_WALL,
         "an unstated child under a stated root baked with code {bk.bk_code}");
  wipe();
}

fn test_the_same_profile_on_both_bakes_fine() {
  wipe();
  // ⚠ THE CONTROL, and without it the two above are satisfied by a `bake` that
  // refuses everything. Identical profiles lose nothing, so they must pass.
  wall_lib(PartWall { wa_up: 10, wa_surface: "floor" },
           PartWall { wa_up: 10, wa_surface: "floor" }, true);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_OK, "matching profiles were refused: {bk.bk_why}");
  wipe();
}

fn test_a_library_with_no_profiles_at_all_still_bakes() {
  wipe();
  // Every part in `data/parts/` today. The section is new, so *absent on both*
  // is the overwhelmingly common case and it must be untouched by any of this.
  put("pair/kid", 4, no_kids());
  put("pair/top", 4, [at("pair/kid", 1, 0, 0)]);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_OK, "a profile-free nest was refused: {bk.bk_why}");
  wipe();
}

// ── `BK_OPEN` — a head profile cannot survive a flattening — `A8.9`, §P9.14 ──

fn open_lib(rootopen: PartOpen, kidopen: PartOpen, kidhas: boolean) {
  assert(mkdir_all("{root()}/pair").ok(), "mkdir");
  kid = one_cell(4);
  if kidhas {
    assert(part_set_open(kid, kidopen) == PO_OK, "the child's head was refused");
  }
  assert(world_save(kid, "{root()}/pair/kid.hxw", no_palette()) == WS_OK, "save kid");
  top = one_cell(4);
  assert(part_set_instances(top, [at("pair/kid", 1, 0, 0)]) == PI_OK, "instances");
  assert(part_set_open(top, rootopen) == PO_OK, "the root's head was refused");
  assert(world_save(top, "{root()}/pair/top.hxw", no_palette()) == WS_OK, "save top");
}

fn test_a_round_headed_child_in_a_flat_headed_root_is_refused() {
  wipe();
  // The real composition, and the one the display path draws FLAT without saying
  // so: an arched frame inside a square-headed house. Flattened, the arch is gone
  // with every cell present.
  open_lib(PartOpen { po_head: 10, po_sill: 0, po_kind: "flat" },
           PartOpen { po_head: 11, po_sill: 0, po_kind: "round", po_spring: 7 }, true);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_OPEN,
         "a differing head profile baked with code {bk.bk_code}: {bk.bk_why}");
  assert(bk.bk_why.find("round") != null && bk.bk_why.find("flat") != null,
         "the reason names neither profile: {bk.bk_why}");
  wipe();
}

fn test_a_head_that_differs_only_in_its_height_is_refused() {
  wipe();
  // ⚠ THE KIND ALONE IS NOT THE PROFILE. Two flat heads at different heights are
  // two different doorways, and a check that compared only `kind` would pass this.
  open_lib(PartOpen { po_head: 10, po_kind: "flat" },
           PartOpen { po_head: 8, po_kind: "flat" }, true);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_OPEN, "two flat heads at 10 and 8 baked as one");
  wipe();
}

fn test_an_unstated_child_under_a_stated_root_is_refused_too() {
  wipe();
  open_lib(PartOpen { po_head: 10, po_kind: "flat" }, PartOpen {}, false);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_OPEN, "an unstated child under a stated root baked");
  wipe();
}

fn test_the_same_head_on_both_bakes_fine() {
  wipe();
  // ⚠ THE CONTROL. Without it the three above are satisfied by a `bake` that
  // refuses every composition.
  open_lib(PartOpen { po_head: 10, po_sill: 0, po_kind: "flat" },
           PartOpen { po_head: 10, po_sill: 0, po_kind: "flat" }, true);
  bk = part_bake(root(), "pair/top");
  assert(bk.bk_code == BK_OK, "matching heads were refused: {bk.bk_why}");
  wipe();
}
