// `PART` and `ANCH` — what a part is called, and where it stands.
//
// Plan 17 `A1.4`, over the section mechanism `A1.3` put in the store. ⚠ The split
// is the point: `hex_voxel` owns the FRAMING — tag, length, and carrying a tag it
// has never heard of — and knows nothing about kinds or anchors. This file owns
// the CONTENT and knows nothing about where the bytes end up. A store that knew
// what `PART` meant would be a store with an opinion about its consumers.
use hex_voxel;
use codec;

// ⚠ LITERALS, held equal to `section_tag(…)` by a test rather than derived from
// it. That began as a workaround for loft#744 — `const X = some_fn()` aborted —
// and it survives the fix for a better reason the fix itself pointed out: **a
// file-scope constant is an inlined expression, re-evaluated at every reference**,
// so a derived tag would re-run the packing loop at each of these tags' uses.
pub const TAG_PART = 1414676816;    // 'PART', low byte first
pub const TAG_ANCH = 1212370497;    // 'ANCH'

pub const PK_HOUSE   = 1;
pub const PK_FRAME   = 2;
pub const PK_LEAF    = 3;
pub const PK_PROP    = 4;
pub const PK_FITTING = 5;

// The 24 headings the editor already uses (§P3). A facing is an index into them,
// never an angle.
//
// ⚠ THE FORMAT HOLDS 24 AND A PART CAN TAKE SIX, and `A4.4` is why the two
// numbers differ rather than one of them being wrong. The 24 is `hex_shape`'s
// `d24` — the space wall RUNS are drawn in, and worth sharing so the tree has one
// heading space. But a run is a one-dimensional path and may staircase; a part is
// a BODY, and rotating a body is a map from the lattice onto itself, which only
// the six multiples of 60° are. Measured on a 37-cell disk: the other eighteen
// tear 12 to 22 of its 90 adjacencies, and the 30° family puts six cells exactly
// on a boundary where *the nearest cell* is a tie-break rather than a fact
// (`moros_map/tests/headings.loft` prints the table every run).
//
// So this stays 24 — the record is the heading an author ASKED for — and
// `expand`/`bake` refuse the eighteen, naming the measurement. ⚠ A facing outside
// 0..23 is still refused here, because that is not a heading at all.
pub const FACINGS = 24;

pub struct PartMeta {
  pm_kind: integer,
  pm_name: text,
  pm_desc: text = "",
}

pub struct PartAnchor {
  pa_q:      integer,
  pa_r:      integer,
  pa_h:      integer,
  pa_facing: integer,
}

pub const PM_OK      = 0;
pub const PM_KIND    = 1;   // not one of the five kinds
pub const PM_NEWLINE = 2;   // a newline in a name or a description
pub const PM_FACING  = 3;   // not one of the 24 headings

// ── The payload is `key=value` lines, and that is a decision ─────────────────
//
// Not packed integers. Three reasons — and ⚠ **the first one was wrong**, which
// is left standing rather than quietly replaced because it decided the shape:
//
//   1. *"A name has to survive, and loft cannot rebuild a text from bytes"* —
//      loft#748, and it was never true: `text_from_bytes` and `byte_at` had
//      shipped two releases before the report and were merely absent from the
//      generated reference. A packed-integer payload with a length-prefixed UTF-8
//      name was always expressible. This design does not depend on the mistake,
//      but it was chosen under it.
//   2. It reads in a hex dump, which is the same argument the four-character tag
//      is made of. `kind=3` next to `PART` says what the file holds. ⚠ This is
//      the reason that actually carries the choice now.
//   3. An integer written as text round-trips exactly and refuses cleanly:
//      `"12x" as i32?` is null, not 12.
//
// ⚠ It costs a refusal the packed form would not need: a NEWLINE in a name would
// forge a line, so it is refused rather than stripped. Stripping would hand back
// a different name than the one given, which is the `WS_PALETTE` rule.
fn has_newline(t: text) -> boolean {
  t.find("\n") != null
}

// The value of `key`, or null when no line has it. ⚠ Split at the FIRST `=`, so a
// description may contain one; splitting on every `=` would silently truncate
// "a door, 2 = wide" at the equals.
//
// ⚠ THE SPELLINGS ARE THE ONES WITH NO UNIT IN THEM, and that outlived the bug
// they were written for. `len()` counts CHARACTERS while a slice bound and `find`
// are BYTE offsets — by design, and loft#749 declined to change it because
// flipping either breaks every program that reads them correctly. So
// `line[(i+1)..line.len()]` is a unit error whatever it does; `size()` is the byte
// length a slice end wants, and `line[(i+1)..]` names no unit at all.
//
// ⚠ Until loft 2026.8.0 (`092f4109`) both of the obvious spellings ABORTED on a
// name with `é` in it — `split_text("\n")` misindexed its trailing segment and
// `s[i..s.len()]` read past the buffer, each a Rust backtrace with no loft
// location. That is fixed and the naive form is correct again; these stay because
// they were never only a workaround. An ASCII test subject could see none of it.
// ⚠ PUBLIC BECAUSE `FITS` IS A ONE-THING SECTION TOO. `sock.loft` reads its two
// keys with this rather than a second copy, and a second copy is exactly how the
// *split at the FIRST `=`* rule gets re-decided by whoever writes it next.
pub fn meta_field(t: text, key: text) -> text? {
  for line in t.split('\n') {
    i = line.find("=");
    if i == null { continue; }
    if line[0..i] == key { return line[(i + 1)..]; }
  }
  null
}

pub fn part_set_meta(w: VoxelWorld, m: PartMeta) -> integer {
  if m.pm_kind < PK_HOUSE || m.pm_kind > PK_FITTING { return PM_KIND; }
  if has_newline(m.pm_name) || has_newline(m.pm_desc) { return PM_NEWLINE; }
  set_section_text(w, TAG_PART,
    "kind={m.pm_kind}\nname={m.pm_name}\ndesc={m.pm_desc}");
  PM_OK
}

pub fn part_set_anchor(w: VoxelWorld, a: PartAnchor) -> integer {
  if a.pa_facing < 0 || a.pa_facing >= FACINGS { return PM_FACING; }
  set_section_text(w, TAG_ANCH,
    "q={a.pa_q}\nr={a.pa_r}\nh={a.pa_h}\nfacing={a.pa_facing}");
  PM_OK
}

pub const MR_OK        = 0;
pub const MR_ABSENT    = 1;   // the part carries no such section
pub const MR_MALFORMED = 2;   // it carries one and it does not parse

// ⚠ ABSENT AND MALFORMED ARE DIFFERENT ANSWERS. A part written by an older editor
// has no `ANCH` and is fine; a part whose `ANCH` says `facing=north` is damaged.
// Collapsing them makes the second look like the first, and the symptom is a part
// that quietly stands the wrong way round.
pub struct MetaRead { mr_code: integer, mr_meta: PartMeta, mr_why: text }
pub struct AnchorRead { ar_code: integer, ar_anchor: PartAnchor, ar_why: text }

pub fn part_meta(w: VoxelWorld) -> MetaRead {
  if world_section_at(w, TAG_PART) < 0 {
    return MetaRead { mr_code: MR_ABSENT, mr_meta: PartMeta {}, mr_why: "no PART section" };
  }
  t = section_text(w, TAG_PART);
  k = meta_field(t, "kind");
  if k == null {
    return MetaRead { mr_code: MR_MALFORMED, mr_meta: PartMeta {}, mr_why: "no kind" };
  }
  kind = k as i32?;
  if kind == null {
    return MetaRead { mr_code: MR_MALFORMED, mr_meta: PartMeta {},
                      mr_why: "kind '{k}' is not a number" };
  }
  if kind < PK_HOUSE || kind > PK_FITTING {
    return MetaRead { mr_code: MR_MALFORMED, mr_meta: PartMeta {},
                      mr_why: "kind {kind} is not one of the five" };
  }
  MetaRead { mr_code: MR_OK,
             mr_meta: PartMeta { pm_kind: kind, pm_name: meta_field(t, "name") ?? "",
                                 pm_desc: meta_field(t, "desc") ?? "" },
             mr_why: "" }
}

pub fn part_anchor(w: VoxelWorld) -> AnchorRead {
  if world_section_at(w, TAG_ANCH) < 0 {
    return AnchorRead { ar_code: MR_ABSENT, ar_anchor: PartAnchor {},
                        ar_why: "no ANCH section" };
  }
  t = section_text(w, TAG_ANCH);
  q = (meta_field(t, "q") ?? "") as i32?;
  r = (meta_field(t, "r") ?? "") as i32?;
  h = (meta_field(t, "h") ?? "") as i32?;
  fc = (meta_field(t, "facing") ?? "") as i32?;
  if q == null || r == null || h == null || fc == null {
    return AnchorRead { ar_code: MR_MALFORMED, ar_anchor: PartAnchor {},
                        ar_why: "an anchor field is missing or is not a number" };
  }
  if fc < 0 || fc >= FACINGS {
    return AnchorRead { ar_code: MR_MALFORMED, ar_anchor: PartAnchor {},
                        ar_why: "facing {fc} is not one of the {FACINGS} headings" };
  }
  // ⚠ The `?? 0` is unreachable — the four are checked against null two lines up
  // — and it is written anyway because loft does not narrow a nullable through a
  // check, and the warning it raises otherwise says *it becomes null there*.
  // A reader who trusts that warning and a reader who trusts the check disagree,
  // and the cheapest way to stop that is to leave nothing to disagree about.
  AnchorRead { ar_code: MR_OK,
               ar_anchor: PartAnchor { pa_q: q ?? 0, pa_r: r ?? 0, pa_h: h ?? 0,
                                       pa_facing: fc ?? 0 },
               ar_why: "" }
}
