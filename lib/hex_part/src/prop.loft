// `MESH` — the other thing a part can be made of.
//
// Plan 17 `A6.1`, §P5: **two kinds of part, one mechanism**. A cell part is
// stored as cells in its own `hex_world`; a prop part is stored as a `.glb`. The
// mechanism that makes them one is that **sockets do not care which it is**,
// which is the argument for putting the socket on the part rather than on the
// cells — a statue goes in a niche by exactly the machinery a door goes in a
// frame.
//
// ⚠ A PART MAY BE BOTH, which is why this is a section and not a part KIND. §P5's
// example is a pillar that is a `.glb` for the eye and a one-cell column for the
// walker; the two bodies answer different questions (*what does it look like*,
// *can you walk through it*) and a part that answers only one is the common case
// rather than the rule.
//
// > **Why a statue is not just an import.** `21:` already imports a `.glb`. What
// > it cannot do is *be placed in a niche*, *be listed in a library*, *be swapped
// > for another statue that fits the same plinth*, or *carry a name an author
// > chose*. Those are all `PART` and `SOCK` — §P5's own words, and the reason
// > this record holds a reference rather than the geometry.
use hex_world;
use codec;
use meta;
use catalogue;
use glb_read;

// ⚠ A LITERAL, held equal to `section_tag(…)` by a test — `meta.loft`'s reason: a
// file-scope constant is an inlined expression re-evaluated at every reference.
pub const TAG_MESH = 1213416781;    // 'MESH', low byte first

pub const PR_OK      = 0;
pub const PR_EMPTY   = 1;   // a mesh reference naming nothing
pub const PR_NEWLINE = 2;   // a newline — it would forge a line
pub const PR_ESCAPE  = 3;   // a name that climbs out of the library

pub struct PropWrite { pw_code: integer, pw_why: text }

// ── The reference is a NAME, and it may not leave the library ────────────────
//
// ⚠ `..` IS REFUSED RATHER THAN NORMALISED, which is the wire's existing rule for
// a part name and is the same rule here for the same reason: a document that can
// name `../../../etc/passwd` is a document that reads a file its author never
// chose, and normalising it hands back a different reference than the one given
// (`meta.loft`'s rule about a name). An absolute name is refused for the same
// reason — it is not a name at all, it is a path, and §P5's whole point is that a
// prop is addressed like a part.
//
// ⚠ A COMMA IS **NOT** REFUSED, and that is a decision rather than an oversight.
// A mesh name is a FILE PATH fragment, the same kind of thing as `pi_part`, so
// the filesystem decides what may be in one and we do not. `A4.3` learned that a
// field's freedom depends on whether anything ever REFERS to it — the answer to
// that is not to restrict every field pre-emptively, it is to know the rule: if
// some later record names a mesh among other fields, the name takes the TAIL, as
// `inst=` and `bind=` already do for their handles.
fn check_mesh(name: text) -> PropWrite {
  if name == "" {
    return PropWrite { pw_code: PR_EMPTY, pw_why: "the part names no mesh" };
  }
  if name.find("\n") != null {
    return PropWrite { pw_code: PR_NEWLINE,
                       pw_why: "the mesh name '{name}' has a newline in it" };
  }
  if name.find("..") != null {
    return PropWrite { pw_code: PR_ESCAPE,
      pw_why: "the mesh name '{name}' contains '..'; a part names a mesh inside "
            + "the library and never a path out of it" };
  }
  if name[0..1] == "/" {
    return PropWrite { pw_code: PR_ESCAPE,
      pw_why: "the mesh name '{name}' is absolute; a part names a mesh, not a path" };
  }
  PropWrite { pw_code: PR_OK, pw_why: "" }
}

pub fn part_set_mesh(w: World, name: text) -> PropWrite {
  got = check_mesh(name);
  if got.pw_code != PR_OK { return got; }
  set_section_text(w, TAG_MESH, "mesh={name}");
  PropWrite { pw_code: PR_OK, pw_why: "" }
}

pub struct MeshRead { pr_code: integer, pr_name: text, pr_why: text }

// ⚠ ONE VALIDATOR, BOTH DIRECTIONS — `sock.loft`'s rule, and here it is what
// stops a hand-edited `mesh=../../secrets` being opened by the loader below.
pub fn part_mesh(w: World) -> MeshRead {
  if world_section_at(w, TAG_MESH) < 0 {
    return MeshRead { pr_code: MR_ABSENT, pr_name: "", pr_why: "no MESH section" };
  }
  v = meta_field(section_text(w, TAG_MESH), "mesh");
  if v == null {
    return MeshRead { pr_code: MR_MALFORMED, pr_name: "",
                      pr_why: "a MESH section with no mesh" };
  }
  name = v ?? "";
  bad = check_mesh(name);
  if bad.pw_code != PR_OK {
    return MeshRead { pr_code: MR_MALFORMED, pr_name: "", pr_why: bad.pw_why };
  }
  MeshRead { pr_code: MR_OK, pr_name: name, pr_why: "" }
}

// ── Where a mesh body LANDS ──────────────────────────────────────────────────
//
// Plan 17 `A6.2`. A cell part is derived into a world by writing columns; a mesh
// part cannot be, because a mesh is not on the lattice. So the derivation of a
// prop is a **record handed back**, and this is the record.
//
// ⚠ IT IS DERIVED AND HOLDS NO IDENTITY, which is `A3.2`'s rule for cells applied
// to the other body. §P4 makes the `INST`/`BIND` records the authority and
// everything downstream re-derivable, so a placement carries no label and no part
// handle: re-deriving regenerates the whole list, and there is nothing to keep in
// step. `ma_mesh` is what a consumer needs and is what tells one statue from
// another — which is `A6.3`'s entire proof.
//
// ⚠ `ma_facing` IS A TURN AND NOT AN AIM, and the two are different quantities
// this step had to separate. A socket says which way a thing in it should LOOK;
// `ANCH` says which way the part looks in its own frame; what a renderer needs is
// the difference — how far to turn the `.glb` about the vertical. Handing back the
// aim would be right only for a statue modelled facing heading 0, and nothing
// enforces that or could.
// ⚠ AND `ma_part` IS THE OTHER BODY REFERENCE, NOT AN IDENTITY — plan 17 `A8.1`.
// The paragraph above says a placement carries no part handle, and §P9 is what
// changed that: a LIMB's body is cells in its own file, so the handle is the only
// way a consumer can reach the thing it has to draw. That is exactly the role
// `ma_mesh` plays for a `.glb`, and it is still not identity — re-deriving
// regenerates the whole list and there is nothing to keep in step.
//
// ⚠ **THE `.hxw` IS THE CONTRACT AND THE `.glb` IS THE SKIN** (§P9.4). Both may be
// set: `ma_mesh` is what to DRAW when there is one, `ma_part` is where the part
// came from and its cells are the body when there is not. A placement from an
// `INST` carries no handle, because that part's cells are stamped in the world
// beside it and there is nothing left to fetch.
pub struct MeshAt {
  ma_mesh:   text,        // the name the part's `MESH` gave, unresolved
  ma_part:   text,        // the part handle, for a LIMB whose body is its own cells
  ma_q:      integer,
  ma_r:      integer,
  ma_h:      integer,
  ma_facing: integer,     // 0..23, the turn to apply
  // ── THE SWING, AND WHY IT COULD NOT RIDE IN `ma_facing` — plan 17 `A5.2` ──
  //
  // ⚠ `ma_facing` IS A TURN ABOUT THE PART'S ORIGIN, ABOUT THE VERTICAL. A hinge
  // is neither: it carries its own POINT and its own AXIS, and a trapdoor turns
  // about a horizontal one. Composing a swing into `ma_facing` would swing every
  // door about its centre and every trapdoor the wrong way round — which is the
  // precise reason `A5.2` sat ◐ after `A6.2` supplied the mesh leaf it was
  // waiting for. It was never blocked on a number; it was blocked on a field.
  //
  // ⚠ THE HINGE IS THE PART'S AND THE ANGLE IS THE BINDING'S, and keeping them
  // apart is what makes both derivable. A part's hinge is stamped here by the
  // expansion that opened it — free, because the world is already in hand — and
  // the angle is written by whatever put it in a socket. A free-standing leaf
  // therefore carries its hinge with a swing of 0: shut, and able to say so.
  //
  // ⚠ IN THE LEAF'S OWN FRAME, NOT COMPOSED. The consumer places the mesh at
  // `(ma_q, ma_r, ma_h)`, turns it by `ma_facing`, and turns it again by
  // `ma_swing` about this point and axis — in that order, the hinge being fixed
  // to the leaf. Composing the point into world coordinates here would bake a
  // lattice convention into a record that is otherwise pure part-local, and
  // `A3.2`'s rule is that the record is the authority and the consumer re-derives.
  //
  // ⚠ AND A ZERO AXIS IS *NOT HINGED*, which is the library's own rule rather
  // than a new sentinel: `hinge.loft` refuses an axis of zero length as
  // `HG_AXIS` — *a revolute joint with nothing to turn about* — so it can never
  // be a real hinge, and the default costs no extra field to say so.
  ma_ox: float = 0.0, ma_oy: float = 0.0, ma_oz: float = 0.0,
  ma_ax: float = 0.0, ma_ay: float = 0.0, ma_az: float = 0.0,
  ma_swing: float = 0.0,   // in TURNS, the unit `A5.1` chose for the limits
  // ── THE SCALE, DERIVED FROM TWO FILES AND AUTHORED IN NEITHER — `A8.2b`, §P9.1
  //
  // ⚠ A LIMB IS AUTHORED AT ITS OWN SCALE. A door at the parent's hex size is one
  // column wide with no room for detail, so a leaf is authored on a FINER lattice
  // — many small hexes — and shrunk to fit the opening. That is possible only for
  // a limb: a limb is never written to a lattice, so the parent's hex size is
  // simply not a fact about it, exactly as `A8.1` found for the rotation limit.
  //
  // ⚠ IT IS A RATIO AND NEVER AN ABSOLUTE, which is what makes it correct against
  // a renderer that does not read `w_unit` at all. `hex_proj::HEIGHT_SCALE` is a
  // CONSTANT 0.25 — one height step, in world units — and the store carries the
  // same quantity per world as `w_unit`, which is 0.25 for everything in this
  // tree. **Two authorities on one quantity, agreeing today by coincidence.** So
  // a mesh built from a part's cells comes out on the drawing's fixed lattice
  // whatever unit the file states, and `child.w_unit / parent.w_unit` is what
  // converts one part's drawing into another's. An absolute would have to pick
  // one of the two authorities and would be wrong the day they diverge.
  //
  // ⚠ AND IT IS DERIVED AT THE PLACEMENT RATHER THAN AUTHORED ON THE RECORD
  // (§P9.1): both files already state their unit, so a field the author sets
  // would be a second authority on a fact the pair already fixes — and the first
  // thing to go stale when a leaf is re-authored finer.
  //
  // ⚠ 1.0 IS THE `INST` ANSWER, NOT A DEFAULT NOBODY MEANS. A composed part's
  // cells are written into the parent's world, and a cell is a cell: a fine
  // lattice cannot be written into a coarse one at all, so that path REFUSES a
  // unit mismatch (`EX_UNIT`) rather than carrying a ratio. Every placement that
  // is not a limb is therefore at 1.0 because the units are equal, which the
  // refusal is what guarantees.
  ma_scale: float = 1.0,
}

// ── Does the mesh it names actually load? ────────────────────────────────────

pub const MC_OK      = 0;
pub const MC_NONE    = 1;   // the part names no mesh, which is not a fault
pub const MC_BAD     = 2;   // the `MESH` section is damaged
pub const MC_MISSING = 3;   // it names a mesh that is not in the library
pub const MC_BROKEN  = 4;   // it names one that is not a readable `.glb`

// ⚠ FIVE ANSWERS, AND `MC_NONE` IS NOT A FAULT. Most parts are cell parts and name
// no mesh at all; collapsing *there is no mesh* into *the mesh is missing* would
// make every house in the library report a broken reference.
//
// ⚠ AND `MC_MISSING` IS NOT `MC_BROKEN`, which is the whole reason this package
// took a dependency on a `.glb` reader. `part_cycle` already tells a dangling PART
// reference from a damaged one — *"a mistyped name and a part that contains itself
// want completely different fixes"* — and a mesh deserves the same pair. Saying
// only *missing* for a `.glb` that is present and corrupt sends the author looking
// for a file that is right there.
pub struct MeshCheck {
  mc_code:  integer,
  mc_why:   text,
  mc_verts: integer = 0,    // what actually came out of the file
}

// ⚠ `mc_verts` IS A READ-BACK AND NOT A TALLY. *The mesh loads* is a claim about a
// file, and the cheapest way to write a check that cannot see an empty one is to
// report `GR_OK` and stop. `glb_read` answers `GR_SHAPE` for JSON that is not a
// mesh it can read, but a well-formed glb holding zero vertices is a legal file
// and a prop that draws nothing — so the count is carried out to where a caller
// can judge it, rather than being folded into a boolean here.
pub fn part_mesh_loads(root: text, w: World) -> MeshCheck {
  got = part_mesh(w);
  if got.pr_code == MR_ABSENT {
    return MeshCheck { mc_code: MC_NONE, mc_why: "the part names no mesh" };
  }
  if got.pr_code != MR_OK {
    return MeshCheck { mc_code: MC_BAD, mc_why: got.pr_why };
  }
  onto = mesh_file(root, got.pr_name);
  if !exists(onto) {
    return MeshCheck { mc_code: MC_MISSING,
                       mc_why: "'{got.pr_name}' is not in {root}" };
  }
  gr = load_glb(onto);
  if gr.gr_code != GR_OK {
    return MeshCheck { mc_code: MC_BROKEN,
      mc_why: "'{got.pr_name}' is not a readable glb ({gr.gr_code}) {gr.gr_detail}" };
  }
  MeshCheck { mc_code: MC_OK, mc_why: "", mc_verts: len(gr.gr_mesh.vertices) }
}

// ── THE SWING, APPLIED — plan 17 `A5.2`, the renderer's half ─────────────────
//
// `MeshAt` carries the hinge and the angle; this turns them into geometry. It is
// the PART's half of the pose and stops there: the hinge is in the leaf's own
// frame, so no lattice and no world position appear here at all. The consumer
// applies `ma_facing` and puts the result where `(ma_q, ma_r, ma_h)` says, because
// where a hex lands in world units is the consumer's convention and never this
// package's — the same line `part_stamp` draws for cells.
//
// ⚠ A ZERO AXIS RETURNS THE MESH UNTOUCHED, which is `hinge.loft`'s `HG_AXIS`
// rule doing its second job: a part with no hinge is one whose axis is zero, and
// *not hinged* and *hinged but shut* then produce identical geometry by the same
// code path rather than by two.
//
// ⚠ RODRIGUES, AND THE AXIS IS NORMALISED HERE. `A5.1` stores the axis AS GIVEN
// and says so — *"the length of the axis carries no meaning; a consumer that needs
// a unit vector normalises where it needs one"*. This is that consumer. An axis
// written `(0, 2, 0)` and one written `(0, 1, 0)` are the same hinge, and a leaf
// that swung twice as far for a longer arrow would be the format's units leaking
// into the picture.
pub fn mesh_swing(m: Mesh, at: MeshAt) -> Mesh {
  ax = at.ma_ax; ay = at.ma_ay; az = at.ma_az;
  len2 = ax * ax + ay * ay + az * az;
  if len2 == 0.0 || at.ma_swing == 0.0 { return m; }
  inv = 1.0 / sqrt(len2);
  ux = ax * inv; uy = ay * inv; uz = az * inv;
  // TURNS to radians — `A5.1` chose turns for the limits, so this is the one
  // place the two units meet, and it meets them once.
  ang = at.ma_swing * 6.283185307179586;
  cs = cos(ang); sn = sin(ang);
  out = mesh(m.name);
  for v in m.vertices {
    px = v.pos.x - at.ma_ox; py = v.pos.y - at.ma_oy; pz = v.pos.z - at.ma_oz;
    dt = ux * px + uy * py + uz * pz;
    cx = uy * pz - uz * py; cy = uz * px - ux * pz; cz = ux * py - uy * px;
    rx = px * cs + cx * sn + ux * dt * (1.0 - cs);
    ry = py * cs + cy * sn + uy * dt * (1.0 - cs);
    rz = pz * cs + cz * sn + uz * dt * (1.0 - cs);
    // ⚠ THE NORMAL TURNS TOO, AND WITHOUT THE OFFSET. A normal is a DIRECTION, so
    // subtracting the hinge point from it would bend the lighting round the door
    // — the shading would say the leaf is somewhere it is not, which is the one
    // thing a picture gate cannot see and a person immediately can.
    ndt = ux * v.normal.x + uy * v.normal.y + uz * v.normal.z;
    ncx = uy * v.normal.z - uz * v.normal.y;
    ncy = uz * v.normal.x - ux * v.normal.z;
    ncz = ux * v.normal.y - uy * v.normal.x;
    add_vertex(out, vertex(
      math::vec3(rx + at.ma_ox, ry + at.ma_oy, rz + at.ma_oz),
      math::vec3(v.normal.x * cs + ncx * sn + ux * ndt * (1.0 - cs),
                 v.normal.y * cs + ncy * sn + uy * ndt * (1.0 - cs),
                 v.normal.z * cs + ncz * sn + uz * ndt * (1.0 - cs)),
      math::vec2(v.uv.x, v.uv.y)));
  }
  for t in m.triangles { add_triangle(out, t.a, t.b, t.c); }
  out
}

// A uniform scale about the leaf's OWN origin.
//
// ⚠ THE NORMALS ARE NOT TOUCHED, and that is a property of a UNIFORM scale rather
// than an omission. A non-uniform one would need the inverse transpose, and a
// normal scaled by `s` and re-normalised is the normal it already was — but a
// reader who sees positions change and directions not is owed the reason, because
// `mesh_swing` above turns both and the asymmetry looks like the bug this file
// already records once ("the normal turns too, and without the offset").
//
// ⚠ AND THE ORIGIN IS THE PART'S, NOT THE HINGE'S. A part's origin is what lands
// where it is placed — `part_stamp`'s rule, kept by `A6.2` for a mesh body — so
// the scale has to leave that point fixed and carry everything else, the hinge
// included. Scaling about the hinge instead would move a leaf's origin away from
// the cell that placed it, by an amount that depends on how the author drew the
// hinge, which is a coupling no file states.
fn mesh_scaled(m: Mesh, s: float) -> Mesh {
  if s == 1.0 { return m; }
  out = mesh(m.name);
  for v in m.vertices {
    add_vertex(out, vertex(
      math::vec3(v.pos.x * s, v.pos.y * s, v.pos.z * s),
      math::vec3(v.normal.x, v.normal.y, v.normal.z),
      math::vec2(v.uv.x, v.uv.y)));
  }
  for t in m.triangles { add_triangle(out, t.a, t.b, t.c); }
  out
}

// ── A LIMB'S GEOMETRY, IN THE FRAME IT HANGS IN — plan 17 `A8.2b`, §P9.1 ─────
//
// The leaf's own drawing, converted to its parent's frame: scaled by the ratio the
// two files state, then swung on its hinge. What the consumer still owes is the
// aim and the lattice — `ma_facing` about the vertical and `(ma_q, ma_r, ma_h)` in
// world units — because both of those are conventions this package does not hold.
//
// ⚠ THE ORDER IS FORCED AND THE HINGE MOVES WITH THE GEOMETRY. A hinge is a POINT
// in the leaf's frame, so shrinking the leaf shrinks where its hinge is; swinging
// first and scaling afterwards would swing about a point the scaled leaf does not
// have, and the leaf would open away from its own jamb by an offset that grows
// with the ratio. Scaling the hinge and then swinging is the same transform in the
// right order, and it is why this is ONE function rather than two calls a consumer
// composes — the composition is the claim.
//
// ⚠ AND A SHUT LEAF IS STILL SCALED. `mesh_swing` returns the mesh untouched when
// there is no angle, which is correct for a swing and would be a silent full-size
// leaf here: every door in the library is drawn shut at rest, so the failure would
// be the ordinary case and the ajar one would be the only thing that looked right.
pub fn mesh_hung(m: Mesh, at: MeshAt) -> Mesh {
  s = at.ma_scale;
  if s == 1.0 { return mesh_swing(m, at); }
  mesh_swing(mesh_scaled(m, s), MeshAt {
    ma_mesh: at.ma_mesh, ma_part: at.ma_part,
    ma_ox: at.ma_ox * s, ma_oy: at.ma_oy * s, ma_oz: at.ma_oz * s,
    ma_ax: at.ma_ax, ma_ay: at.ma_ay, ma_az: at.ma_az,
    ma_swing: at.ma_swing })
}
