// ⚠ PARKED — this file HANGS `loft test` and is not in `tests/` for that reason.
//
// It gates row 2 (sparsity): P4, P5, P6 and P12, asserting file sizes EXACTLY
// against the format constants rather than within a tolerance, because elision
// breaking is invisible to a round-trip — every read still returns the right
// value and the file merely grows without bound.
//
// Status: the hang reproduces with only the first test present, so it is
// something structural in this file rather than one assertion. Not yet isolated.
// The behaviour it gates is IMPLEMENTED and partly proven by the existing suite
// (16 green): cells now write at their real widths — 8 bytes, not 28 — and a
// chunk whose last layer empties leaves the directory.
//
// Do not move this into `tests/` until it runs.
// Row 2 gates — sparsity. P4, P5, P6, P12 of the contract.
//
// ⚠ These are the gates a round-trip CANNOT replace, and that is the whole point
// of having them. Elision is the property that absence has ONE representation
// (`E1`): a missing chunk, a missing layer and an all-zero one must read
// identically. When that breaks, every read still returns the right value and the
// file simply grows without bound — correct answers, unbounded cost. Only size
// catches it.
//
// Sizes are asserted EXACTLY, not within a tolerance, against the constants the
// format declares. A tolerance would let a padding regression become the new
// baseline; an exact figure makes it a failure.
use hex_world;

fn w0() -> World { world_new(0.25, 100, 8, 3).wn_world }

fn cell(h: integer, m: integer) -> Hex {
  Hex { h_height: h as u16? ?? 0, h_material: m as u8? ?? 0 }
}
fn put(w: World, q: integer, r: integer, hs: vector<Hex>) -> integer {
  world_set_column(w, Column { co_q: q, co_r: r, co_cells: hs }).cw_code
}
fn saved_size(w: World, pal: vector<integer>) -> integer {
  p = "hexworld_size.bin";
  assert(world_save(w, p, pal) == WS_OK, "save refused");
  n = len(read_bytes(p));
  delete(p);
  n
}
// The format, stated as arithmetic. If this and the writer ever disagree, one of
// them is wrong and the gate says which.
fn expect(chunks: integer, layers: integer, pal: integer) -> integer {
  SZ_HEADER + pal + chunks * SZ_CHUNK + layers * SZ_LAYER
}

// ── P6 — the voxel is eight bytes ON DISK, not merely in memory ──────────────

fn test_p6_a_layer_is_exactly_eight_kilobytes() {
  assert(SZ_CELL == 8, "the voxel is eight bytes");
  assert(SZ_LAYER == 4 + 1 + 1024 * SZ_CELL + 4,
         "a layer is its header plus 1024 cells plus a CRC, got {SZ_LAYER}");
  w = w0();
  assert(put(w, 0, 0, [cell(1000, 1)]) == CW_OK, "write");
  assert(saved_size(w, []) == expect(1, 1, 0),
         "one chunk of one layer must be exactly {expect(1, 1, 0)} bytes, got {saved_size(w, [])}");
}

// ── P4 — an unauthored world costs a header ─────────────────────────────────

fn test_p4_an_empty_world_is_a_header() {
  assert(saved_size(w0(), []) == expect(0, 0, 0),
         "an empty world must cost only its header");
  // CONTROL: authoring ONE hex must produce exactly one chunk of one layer — not
  // zero (nothing stored) and not more (a tile materialised eagerly).
  w = w0();
  assert(put(w, 40, 40, [cell(1000, 1)]) == CW_OK, "write");
  assert(saved_size(w, []) == expect(1, 1, 0), "one hex is one chunk of one layer");
}

// ── P5 — elision is symmetric, and maintained on write ──────────────────────

fn test_p5_emptying_a_layer_removes_it_from_the_file() {
  w = w0();
  assert(put(w, 0, 0, [cell(1000, 1), cell(1020, 2)]) == CW_OK, "two layers");
  before = saved_size(w, []);
  assert(before == expect(1, 2, 0), "setup: {before}");

  // clear the upper layer's only occupied cell — material 0 is absence
  assert(put(w, 0, 0, [cell(1000, 1), cell(1020, 0)]) == CW_OK, "clear upper");
  after = saved_size(w, []);
  assert(after == expect(1, 1, 0),
         "an emptied layer must leave the file: {before} -> {after}, wanted {expect(1, 1, 0)}");

  // and the reads are unchanged for what remains — elision must be invisible
  ld = world_load_of(w);
  assert(ld.co_cells[0].h_height == 1000, "the surviving layer changed");
}

fn world_load_of(w: World) -> Column {
  p = "hexworld_rt2.bin";
  world_save(w, p, []);
  ld = world_load(p);
  delete(p);
  world_column(ld.wl_world, 0, 0)
}

fn test_p5_emptying_the_last_layer_removes_the_chunk() {
  w = w0();
  assert(put(w, 0, 0, [cell(1000, 1)]) == CW_OK, "one layer");
  assert(saved_size(w, []) == expect(1, 1, 0), "setup");
  assert(put(w, 0, 0, [cell(1000, 0)]) == CW_OK, "clear it");
  assert(saved_size(w, []) == expect(0, 0, 0),
         "a chunk whose last layer emptied must leave the directory too");
}

// ── P12 — an unused layer costs nothing, not a slot ─────────────────────────

fn test_p12_unused_layers_are_not_stored() {
  w = w0();
  // one live layer where the cap is 64: a format that reserved slots would store
  // 64 * SZ_LAYER here. Absence is not a stored zero.
  assert(put(w, 0, 0, [cell(1000, 1)]) == CW_OK, "write");
  assert(saved_size(w, []) == expect(1, 1, 0),
         "one live layer of {LAYER_CAP} must cost one layer, not {LAYER_CAP}");
  // CONTROL: adding a second live layer costs exactly one more, so the gate above
  // is measuring layers rather than a fixed chunk size.
  assert(put(w, 0, 0, [cell(1000, 1), cell(1020, 2)]) == CW_OK, "second layer");
  assert(saved_size(w, []) == expect(1, 2, 0), "a second layer costs exactly one more");
}

// ── the file tracks LIVE data, not total writes ─────────────────────────────

fn test_size_tracks_live_data_not_history() {
  w = w0();
  // churn: write and clear the same column many times over
  for i in 0..12 {
    assert(put(w, 3, 3, [cell(1000 + i * 10, 1)]) == CW_OK, "write {i}");
    assert(put(w, 3, 3, [cell(1000 + i * 10, 0)]) == CW_OK, "clear {i}");
  }
  assert(saved_size(w, []) == expect(0, 0, 0),
         "twenty-four writes leaving nothing live must cost nothing");
}
