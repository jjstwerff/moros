// Row 2 gates — sparsity. P4, P5, P6, P12 of the contract.
//
// ⚠ These are the gates a round-trip CANNOT replace, which is why they exist.
// Elision is the property that absence has ONE representation (`E1`): a missing
// chunk, a missing layer and an all-zero one read identically. When that breaks,
// every read still returns the right value and the file merely grows without
// bound — correct answers, unbounded cost. Only size catches it.
//
// Sizes are asserted EXACTLY against the format's own constants, never within a
// tolerance: a tolerance lets a padding regression become the new baseline, where
// an exact figure makes it a failure. `size(v)` gives the in-memory truth and the
// file gives the on-disk one; both are checked, because the defect this row fixed
// was precisely those two disagreeing — 8 bytes in memory, 28 on disk.
//
// ⚠ THE SAVE-AND-MEASURE IS INLINED IN EVERY TEST, deliberately and at the cost of
// repetition. Factoring it into a helper that takes a path made the whole suite
// HANG rather than fail: no parameterised helper anywhere in this tree does file
// I/O, and the harness appears to invoke top-level functions itself, so one taking
// `p: text` is called without a path and blocks. Repetition is the cheaper bug.
use hex_world;

// This helper is where loft H9 bit: an implicit tail returning a projected field of
// an inline call handed back a reference into a store the call had already freed,
// and a World returned that way took the whole test runner down with a SIGSEGV.
// Fixed upstream (loft a1a07dcf) and verified here, so the plain form is back.
fn sp_world() -> World { world_new(0.25, 100, 8, 3).wn_world }

fn sp_cell(h: integer, m: integer) -> Hex {
  Hex { h_height: h as u16? ?? 0, h_material: m as u8? ?? 0 }
}

// The format as arithmetic. If this and the writer ever disagree, one is wrong.
fn sp_want(chunks: integer, layers: integer) -> integer {
  // A layer costs its DIRECTORY entry plus its DATA. The two live in separate
  // regions of the file so a version scan can stop after the directory.
  SZ_HEADER + chunks * SZ_CHUNK + layers * (SZ_LAYER_DIR + SZ_LAYER)
}

// ── P6 — the voxel is eight bytes, in memory AND on disk ────────────────────

fn test_p6_the_voxel_is_eight_bytes_in_memory() {
  assert(size(StoredHex {}) == SZ_CELL, "stored voxel is {size(StoredHex {})}, want {SZ_CELL}");
  assert(size(Hex {}) == SZ_CELL, "memory voxel is {size(Hex {})}, want {SZ_CELL}");
  cells: vector<StoredHex> = [for i in 0..CHUNK_CELLS { StoredHex {} }];
  assert(size(cells) == CHUNK_CELLS * SZ_CELL,
         "a layer's cells are {size(cells)} bytes, want {CHUNK_CELLS * SZ_CELL}");
  assert(SZ_LAYER == CHUNK_CELLS * SZ_CELL + 4, "SZ_LAYER is {SZ_LAYER}");
  assert(SZ_LAYER_DIR == 4 + 1 + SZ_VER, "SZ_LAYER_DIR is {SZ_LAYER_DIR}");
}

fn test_p6_a_layer_is_exactly_eight_kilobytes_on_disk() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "write");
  p = "sp_p6.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  got = len(read_bytes(p) ?? []);
  delete(p);
  assert(got == sp_want(1, 1), "one chunk of one layer is {got} on disk, want {sp_want(1, 1)}");
}

// ── P4 — an unauthored world costs a header ─────────────────────────────────

fn test_p4_an_empty_world_is_only_a_header() {
  p = "sp_p4a.bin";
  assert(world_save(sp_world(), p, []) == WS_OK, "save");
  got = len(read_bytes(p) ?? []);
  delete(p);
  assert(got == sp_want(0, 0), "an empty world costs {got}, want {sp_want(0, 0)}");
}

fn test_p4_one_hex_makes_exactly_one_chunk_of_one_layer() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 40, co_r: 40,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "write");
  p = "sp_p4b.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  got = len(read_bytes(p) ?? []);
  delete(p);
  assert(got == sp_want(1, 1),
         "one hex costs {got}, want {sp_want(1, 1)} — not zero, and not a whole tile");
}

// ── P5 — elision is symmetric and maintained on write ──────────────────────

fn test_p5_emptying_a_layer_removes_it_and_leaves_reads_alone() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1), sp_cell(1020, 2)] }).cw_code == CW_OK, "two layers");
  p = "sp_p5a.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  before = len(read_bytes(p) ?? []);
  delete(p);
  assert(before == sp_want(1, 2), "setup: {before} want {sp_want(1, 2)}");

  // material 0 is absence, so this clears the upper layer's only occupied cell
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1), sp_cell(1020, 0)] }).cw_code == CW_OK, "clear upper");
  assert(world_save(w, p, []) == WS_OK, "save 2");
  after = len(read_bytes(p) ?? []);
  delete(p);
  assert(after == sp_want(1, 1),
         "an emptied layer must leave the file: {before} -> {after}, want {sp_want(1, 1)}");

  // and elision must be INVISIBLE to what remains
  col = world_column(w, 0, 0);
  assert(len(col.co_cells) == 1, "one layer should remain, got {len(col.co_cells)}");
  assert(col.co_cells[0].h_height == 1000, "the surviving layer changed");
}

fn test_p5_emptying_the_last_layer_removes_the_chunk() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "one layer");
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 0)] }).cw_code == CW_OK, "clear it");
  p = "sp_p5b.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  got = len(read_bytes(p) ?? []);
  delete(p);
  assert(got == sp_want(0, 0),
         "a chunk whose last layer emptied must leave the directory: {got} want {sp_want(0, 0)}");
  // CONTROL: reading it back is legal and empty, not a refusal
  assert(len(world_column(w, 0, 0).co_cells) == 0, "the cleared column must read empty");
}

// ── P12 — an unused layer costs nothing, not a reserved slot ────────────────

fn test_p12_unused_layers_are_not_stored() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "one");
  p = "sp_p12.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  one = len(read_bytes(p) ?? []);
  delete(p);
  assert(one == sp_want(1, 1),
         "one live layer of {LAYER_CAP} costs {one}, want {sp_want(1, 1)}");
  // CONTROL: a second live layer costs exactly one more, so the assertion above
  // measures layers rather than a fixed per-chunk size.
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1), sp_cell(1020, 2)] }).cw_code == CW_OK, "two");
  assert(world_save(w, p, []) == WS_OK, "save 2");
  two = len(read_bytes(p) ?? []);
  delete(p);
  assert(two - one == SZ_LAYER_DIR + SZ_LAYER, "a second layer costs {two - one}, want {SZ_LAYER_DIR + SZ_LAYER}");
}

// ── the file tracks LIVE data, not the history of writes ───────────────────

fn test_size_tracks_live_data_not_write_history() {
  w = sp_world();
  for i in 0..8 {
    assert(world_set_column(w, Column { co_q: 3, co_r: 3,
           co_cells: [sp_cell(1000 + i * 10, 1)] }).cw_code == CW_OK, "write {i}");
    assert(world_set_column(w, Column { co_q: 3, co_r: 3,
           co_cells: [sp_cell(1000 + i * 10, 0)] }).cw_code == CW_OK, "clear {i}");
  }
  p = "sp_hist.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  got = len(read_bytes(p) ?? []);
  delete(p);
  assert(got == sp_want(0, 0),
         "sixteen writes leaving nothing live cost {got}, want {sp_want(0, 0)}");
}

// ── Row 3 — the edit clock and per-layer versions (`T1`, `T2`) ──────────────

fn test_t1_a_write_advances_the_clock_and_stamps_the_layer() {
  w = sp_world();
  t0 = w.w_tau;
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "write");
  assert(w.w_tau > t0, "the clock did not advance: {t0} -> {w.w_tau}");
  assert(world_layer_version(w, 0, 0, 0) == w.w_tau,
         "the layer was not stamped with the current clock");
  assert(world_is_stale(w, 0, 0, t0), "a cache built before the write must be stale");
  assert(!world_is_stale(w, 0, 0, w.w_tau), "a cache built after it must be valid");
}

// ⚠ The control that matters: a write that changes NOTHING must not tick. Without
// it, re-authoring the same value would invalidate every cache over the region —
// and re-authoring identical values is exactly what a levelling brush does.
fn test_t1_a_write_that_changes_nothing_does_not_tick() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "write");
  t1 = w.w_tau;
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "identical rewrite");
  assert(w.w_tau == t1, "an identical rewrite ticked the clock: {t1} -> {w.w_tau}");
}

// `T2` — a write to one layer stales no other. Without this every cache in a
// chunk shares one fate and the layer separation buys nothing.
fn test_t2_versions_are_independent() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1), sp_cell(1020, 2)] }).cw_code == CW_OK, "two layers");
  v_low = world_layer_version(w, 0, 0, 0);
  v_high = world_layer_version(w, 0, 0, 1);

  // change ONLY the upper layer
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1), sp_cell(1030, 2)] }).cw_code == CW_OK, "raise upper");
  assert(world_layer_version(w, 0, 0, 0) == v_low,
         "writing the upper layer staled the lower one — T2 is what stops a prop "
         + "change invalidating a terrain cache");
  assert(world_layer_version(w, 0, 0, 1) > v_high, "the upper layer was not stamped");
}

// The clock and every version survive a round trip — a cache outlives a session,
// which is the whole reason for persisting them.
fn test_t1_the_clock_and_versions_persist() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 1, co_r: 2,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "write");
  tau = w.w_tau;
  ver = world_layer_version(w, 1, 2, 0);
  p = "sp_t1.bin";
  assert(world_save(w, p, []) == WS_OK, "save");
  ld = world_load(p);
  delete(p);
  assert(ld.wl_code == WL_OK, "load {ld.wl_code}");
  assert(ld.wl_world.w_tau == tau, "clock came back {ld.wl_world.w_tau}, want {tau}");
  assert(world_layer_version(ld.wl_world, 1, 2, 0) == ver, "version lost in the round trip");
}

// ⚠ THE STRUCTURAL ONE. Validating a cache must cost a DIRECTORY read and never
// the payload. The proof is to corrupt the cells and scan anyway: the scan
// succeeds where a full load refuses on CRC, which is only possible if it never
// read a voxel.
fn test_versions_are_readable_without_the_payload() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1), sp_cell(1020, 2)] }).cw_code == CW_OK, "write");
  p = "sp_scan.bin";
  assert(world_save(w, p, []) == WS_OK, "save");

  clean = world_scan_versions(p);
  assert(clean.vs_code == WL_OK, "scan refused {clean.vs_code}");
  assert(clean.vs_tau == w.w_tau, "scan read tau {clean.vs_tau}, want {w.w_tau}");
  assert(clean.vs_layers == 2, "scan saw {clean.vs_layers} layers, want 2");
  assert(clean.vs_max == w.w_tau, "scan max version {clean.vs_max}, want {w.w_tau}");

  // corrupt the LAST byte — deep in the data region, far past the directory
  bs = read_bytes(p) ?? [];
  at = len(bs) - 1;
  bs[at] = (bs[at] + 1) % 256;
  write_bytes(p, bs);

  torn = world_scan_versions(p);
  assert(torn.vs_code == WL_OK,
         "the scan touched the payload — it must not, or validating a cache costs "
         + "more than the rebuild it avoids");
  assert(torn.vs_max == clean.vs_max, "the scan disagreed with itself after corruption");
  // CONTROL: a FULL load of the same file must refuse, proving the corruption was
  // real and inside data the scan deliberately skipped.
  assert(world_load(p).wl_code == WL_CRC,
         "the corruption was not in the payload, so the scan proves nothing");
  delete(p);
}

// ── Row 6 — many authors (`M1`, `X2`) ──────────────────────────────────────

// `M1` — writes touching disjoint columns produce the same WORLD in either order.
// This is what lets a merger reorder and batch freely: two players building in
// different rooms never interact, and only edits sharing a column need their
// relative order kept.
//
// ⚠ Compared on the WORLD, not on the bytes. A rebase triggered by one column
// re-encodes its whole chunk, so two orders can yield identical absolute heights
// and different stored ones. Comparing files here would fail on correct code.
fn test_m1_disjoint_column_writes_commute() {
  a = sp_world();
  assert(world_set_column(a, Column { co_q: 1, co_r: 1,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "a1");
  assert(world_set_column(a, Column { co_q: 9, co_r: 9,
         co_cells: [sp_cell(2000, 2)] }).cw_code == CW_OK, "a2");

  b = sp_world();                                   // the same two, reversed
  assert(world_set_column(b, Column { co_q: 9, co_r: 9,
         co_cells: [sp_cell(2000, 2)] }).cw_code == CW_OK, "b1");
  assert(world_set_column(b, Column { co_q: 1, co_r: 1,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "b2");

  for q in 0..12 {
    for r in 0..12 {
      ca = world_column(a, q, r);
      cb = world_column(b, q, r);
      assert(len(ca.co_cells) == len(cb.co_cells),
             "layer count differs at ({q},{r}) — the order changed the world");
      for i in 0..len(ca.co_cells) {
        assert(ca.co_cells[i].h_height == cb.co_cells[i].h_height,
               "height differs at ({q},{r}) layer {i} — disjoint writes did not commute");
        assert(ca.co_cells[i].h_material == cb.co_cells[i].h_material,
               "material differs at ({q},{r}) layer {i}");
      }
    }
  }
  // CONTROL: writes SHARING a column must NOT be expected to commute — the same
  // two applied in both orders leave different heights, which is why `M1` is
  // stated on disjoint columns rather than on writes in general.
  c = sp_world();
  world_set_column(c, Column { co_q: 3, co_r: 3, co_cells: [sp_cell(1000, 1)] });
  world_set_column(c, Column { co_q: 3, co_r: 3, co_cells: [sp_cell(1500, 1)] });
  d = sp_world();
  world_set_column(d, Column { co_q: 3, co_r: 3, co_cells: [sp_cell(1500, 1)] });
  world_set_column(d, Column { co_q: 3, co_r: 3, co_cells: [sp_cell(1000, 1)] });
  assert(world_column(c, 3, 3).co_cells[0].h_height
         != world_column(d, 3, 3).co_cells[0].h_height,
         "shared-column writes commuted, so this test cannot tell order from disorder");
}

// `X2` — a second writer to one store is detected, not assumed away.
fn test_x2_a_second_writer_is_refused() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 0, co_r: 0,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "write");
  p = "sp_x2.bin";
  // ⚠ Cleared FIRST. This test deliberately leaves a world owned by 9999 if it
  // fails, and a stale one would make the next run refuse at its first line —
  // failing for the previous run's reason rather than its own.
  if exists(p) { delete(p); }
  assert(world_save_as(w, p, [], 4242) == WS_OK, "first owner must be accepted");
  assert(world_save_as(w, p, [], 9999) == WS_CONCURRENT,
         "a different owner wrote over a world it does not hold — undetected, two "
         + "processes on one file corrupt it rather than erroring");
  // CONTROL: the SAME owner writes again freely, or this refuses everything.
  assert(world_save_as(w, p, [], 4242) == WS_OK, "the holder must be able to write again");
  // and OWNER_ANY opts a single-writer tool out entirely
  assert(world_save(w, p, []) == WS_OK, "OWNER_ANY must not be refused");
  delete(p);
}

// ── `M2` — a snapshot is consistent and does not move ───────────────────────

fn test_m2_a_snapshot_does_not_see_later_writes() {
  w = sp_world();
  assert(world_set_column(w, Column { co_q: 2, co_r: 2,
         co_cells: [sp_cell(1000, 1)] }).cw_code == CW_OK, "setup");
  snap = world_snapshot(w);
  taken_at = snap.sn_tau;

  // write AFTER the snapshot — a height, a second layer, and a whole new chunk
  assert(world_set_column(w, Column { co_q: 2, co_r: 2,
         co_cells: [sp_cell(1400, 1), sp_cell(1600, 2)] }).cw_code == CW_OK, "later write");
  assert(world_set_column(w, Column { co_q: 70, co_r: 70,
         co_cells: [sp_cell(900, 1)] }).cw_code == CW_OK, "new chunk");

  sv = snap_world(snap);
  assert(world_column(sv, 2, 2).co_cells[0].h_height == 1000,
         "the snapshot moved: it reads {world_column(sv, 2, 2).co_cells[0].h_height}, want 1000");
  assert(len(world_column(sv, 2, 2).co_cells) == 1,
         "the snapshot gained a layer written after it was taken");
  assert(len(world_column(sv, 70, 70).co_cells) == 0,
         "the snapshot gained a CHUNK written after it was taken");
  assert(snap.sn_tau == taken_at, "the snapshot's clock moved");

  // CONTROL: the live world DID change — otherwise this passes on a world where
  // nothing was written at all, and proves nothing about isolation.
  assert(world_column(w, 2, 2).co_cells[0].h_height == 1400, "the live world did not change");
  assert(len(world_column(w, 70, 70).co_cells) == 1, "the new chunk is missing live");
  assert(w.w_tau > taken_at, "the clock did not advance past the snapshot");
}

// A snapshot answers as of ONE clock — every cell in it, not just the one written.
fn test_m2_a_snapshot_is_one_consistent_instant() {
  w = sp_world();
  for i in 0..4 {
    assert(world_set_column(w, Column { co_q: i, co_r: 0,
           co_cells: [sp_cell(1000 + i * 20, 1)] }).cw_code == CW_OK, "seed {i}");
  }
  snap = world_snapshot(w);
  for i in 0..4 {
    world_set_column(w, Column { co_q: i, co_r: 0, co_cells: [sp_cell(5000, 2)] });
  }
  sv = snap_world(snap);
  for i in 0..4 {
    assert(world_column(sv, i, 0).co_cells[0].h_height == 1000 + i * 20,
           "cell {i} of the snapshot moved — a snapshot must be ONE instant, not a mix");
  }
}
