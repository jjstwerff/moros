// The metrics seam — plan 18, `B1.2`, re-homed by `B1.2b`.
//
// `font.loft` used to claim `text_width(s) = len(s) * 8`. `probe/b1` measured
// what the bridge actually gives and the 8 was wrong on BOTH targets: 19.27 on
// the desktop, 26.66 in the browser, and the browser's font was not even fixed
// pitch. A panel laid out on a made-up advance mis-lays every row and nothing
// reports it, because the text still draws.
//
// So the library does arithmetic on numbers the CONSUMER measured, and these
// tests pin the arithmetic. They run with no window and no GL context, which is
// the constraint that forced the seam in the first place.
use lavition_ui;

fn mono(advance: integer) -> Metrics {
  run = (advance * 10) as float;
  metrics_measured(run, run, 10, advance)
}

// ── the fixed-pitch instrument ───────────────────────────────────

// ⚠ THE CLAIM `len * advance` IS EXACT RESTS ENTIRELY ON THIS. Two runs of the
// SAME LENGTH and OPPOSITE WIDTH is the whole instrument; one width cannot
// answer it, because ten M's are ten M's in any font.
fn test_two_equal_runs_are_fixed_pitch() {
  m = metrics_measured(192.65625, 192.65625, 10, 38);
  assert(m.m_mono, "equal M-run and i-run must read as fixed pitch");
  assert(metrics_advance(m) == 19, "advance from the wide run: {metrics_advance(m)}, want 19");
  // and the fine unit it is actually kept in: 19.265625 * 64 = 1233
  assert(m.m_adv64 == 1233, "adv64 is {m.m_adv64}, want 1233 (19.265625 px)");
}

// ⚠ THE CONTROL, AND IT IS A REAL MEASUREMENT — these are the numbers
// `probe/b1` read out of headless Chrome when the browser resolved
// `DejaVuSansMono.ttf` to a proportional fallback. If this test ever passes as
// mono, the check that protects every layout below has stopped working.
fn test_the_browser_fallback_is_caught_as_proportional() {
  m = metrics_measured(266.5625, 71.09375, 10, 36);
  assert(!m.m_mono,
         "266.56 vs 71.09 is proportional and must not read as fixed pitch");
}

fn test_a_zero_length_run_is_not_fixed_pitch() {
  // A consumer that measured nothing must not get a confident answer.
  m = metrics_measured(0.0, 0.0, 0, 12);
  assert(!m.m_mono, "n=0 cannot establish fixed pitch");
  assert(metrics_advance(m) == 0, "advance from no measurement is 0");
}

// ── width and fit ────────────────────────────────────────────────

fn test_width_is_length_times_advance() {
  m = mono(8);
  assert(text_width("", m) == 0, "empty is 0");
  assert(text_width("Stencil", m) == 56, "7 chars at 8 = 56, got {text_width(\"Stencil\", m)}");
}

fn test_fit_leaves_a_string_that_already_fits() {
  m = mono(8);
  s = fit_text("Stencil", 100, m);
  assert(s == "Stencil", "a fitting label must come back untouched, got '{s}'");
}

fn test_fit_truncates_with_a_marker() {
  m = mono(8);
  s = fit_text("thick_curved", 48, m);          // 6 chars of room
  assert(s == "thic..", "want 'thic..', got '{s}'");
  assert(text_width(s, m) <= 48, "the truncation must itself fit");
}

// ⚠ THE SAME BOX, THE SAME CHARACTER COUNT, A LABEL THAT IS NOT ASCII.
//
// `fit_text` computes its cut in CHARACTERS — `px / advance` — and loft's slice
// bounds are BYTE offsets, so a two-byte character spends two of them. The cut
// then lands early and the label comes back SHORTER than it had room for: not
// corrupt (loft snaps a byte cut outward to a character boundary), just quietly
// wrong, and invisible to a suite whose every fixture is ASCII.
//
// 'thíck_cürved' is 12 characters and 14 bytes. At advance 8 a 48px box has
// room for 6, so 4 survive the marker: 'thíc..'. Byte-cutting at 4 yields 'thí'
// — three characters — and a panel that had room for a fourth never shows it.
fn test_fit_counts_characters_not_bytes() {
  m = mono(8);
  s = fit_text("thíck_cürved", 48, m);
  assert(s == "thíc..", "want 'thíc..', got '{s}'");
  assert(len(s) == 6, "6 characters of room were paid for, {len(s)} came back");
  assert(text_width(s, m) <= 48, "the truncation must itself fit");
}

// ⚠ THE MARKER ONLY APPEARS WHEN SOMETHING WAS REMOVED. Otherwise a caller
// cannot tell "this fitted" from "this was never measured", and a panel full of
// ".." would read as a rendering bug rather than as narrow boxes.
fn test_the_marker_means_something_was_cut() {
  m = mono(8);
  assert(fit_text("Item", 200, m) == "Item", "no marker on a label that fits");
  cut = fit_text("thick_curved", 48, m);
  assert(cut != "thick_curved", "the long one must actually be cut");
}

fn test_a_box_too_small_for_the_marker_still_fits() {
  m = mono(8);
  s = fit_text("Stencil", 16, m);               // 2 chars of room, marker needs 2
  assert(text_width(s, m) <= 16, "'{s}' overflows a 16px box");
  s0 = fit_text("Stencil", 0, m);
  assert(s0 == "", "no room means no text, got '{s0}'");
}

// ⚠ `fits` AND `fit_text` ARE ONE QUESTION ASKED TWO WAYS, and the test is that
// they agree rather than that each is right on its own. A boolean twin that drifts
// from the function it predicts is worse than no twin: a caller asks `fits` and
// then draws the untruncated string, and the overflow is somewhere else entirely.
//
// ⚠ SWEPT ACROSS THE BOUNDARY, not sampled near it. The interesting pixel is the
// one where the answer changes, and a fixture that happens to sit either side of it
// tests nothing about the edge.
fn test_fits_is_true_exactly_when_nothing_would_be_cut() {
  m = mono(8);
  seen_yes = 0;
  seen_no = 0;
  for px in 0..120 {
    y = fits("Stencil", px, m);
    same = fit_text("Stencil", px, m) == "Stencil";
    assert(y == same, "at {px}px `fits` says {y} and `fit_text` "
                    + "{if same { \"changes nothing\" } else { \"cuts\" }}");
    if y { seen_yes += 1; } else { seen_no += 1; }
  }
  assert(seen_yes > 0 && seen_no > 0,
         "the sweep never crossed the boundary — {seen_yes} fit, {seen_no} did not");
}

fn test_unmeasured_metrics_do_not_mangle_text() {
  // advance 0 means nobody measured; truncating everything to nothing would be
  // worse than passing it through, and the fixed-pitch check is what catches it.
  m = metrics_measured(0.0, 0.0, 0, 12);
  assert(fit_text("Stencil", 10, m) == "Stencil", "advance 0 must pass text through");
}

// ── the perturbation: the advance is not baked in ────────────────
//
// ⚠ THE GATE FOR B1.2. Every layout assertion in this package would pass with
// `8` hard-coded, because `8` is what the tests happen to use. Running the SAME
// panel at a different advance is what proves the number travels: at 8 px
// "Stencil" fits a button and at 24 px it cannot.

fn wall_spec(status: text) -> PanelSpec {
  PanelSpec {
    ps_buttons: [
      spec_button("None", "1"), spec_button("Raise", "2"), spec_button("Lower", "3"),
      spec_button("Stencil", "4"), spec_button("Item", "5"), spec_button("Wall", "6"),
    ],
    ps_selected_button: 3,
    ps_items: [entry("none"), entry("solid"), entry("half"), entry("thick_flat"), entry("thick_curved")],
    ps_selected_item: 0,
    ps_status: status,
  }
}

fn panel_at(advance: integer) -> Panel {
  panel_build(wall_spec("q=0 r=0 cy=0"), 1280, 720, mono(advance))
}

fn test_a_wider_font_truncates_what_a_narrow_one_fits() {
  narrow = panel_at(8);
  wide   = panel_at(32);
  n3 = narrow.p_toolbar[3] ?? Button {};
  w3 = wide.p_toolbar[3] ?? Button {};
  assert(n3.btn_label == "Stencil", "at advance 8 the label fits whole, got '{n3.btn_label}'");
  // 192px of label room: 7 chars fit at advance 8 (56px) and cannot at 32 (224px).
  assert(w3.btn_label != "Stencil",
         "at advance 32 'Stencil' needs 224px of 192px, got '{w3.btn_label}'");
  assert(text_width(w3.btn_label, mono(32)) <= w3.btn_rect.r_w - LABEL_PAD - HOTKEY_COL,
         "the wide label still overflows its button: '{w3.btn_label}'");
}

fn test_the_status_line_is_fitted_to_its_bar() {
  // The bar spans the WINDOW — it was 240px against 648px of text until B1.2
  // measured it, which is what moved the rectangle.
  // The 81-character line the panel was actually being handed — the one that
  // overflowed a 240px strip by 2.7x before anything measured it.
  long = "q=1 r=2 cy=4  facing 3 o'clock ([/] turns the dial, 12 positions)  y= 0.0  FPS 60";
  for adv in [8, 16, 24] {
    p = panel_build(wall_spec(long), 1280, 720, mono(adv));
    got  = text_width(p.p_status.ss_text, mono(adv));
    room = p.p_status.ss_rect.r_w - LABEL_PAD;
    assert(got <= room, "status overflows its bar at advance {adv}: {got} > {room}");
  }
}

fn test_every_list_item_is_fitted_to_the_list() {
  for adv in [8, 16, 24] {
    p = panel_build(wall_spec("ready"), 1280, 720, mono(adv));
    for it in p.p_list.lb_items {
      assert(text_width(it.en_label, mono(adv)) <= p.p_list.lb_rect.r_w - LABEL_PAD,
             "list item '{it.en_label}' overflows at advance {adv}");
    }
  }
}

// And the negative control for the sweep above: at a big enough advance the
// long names MUST actually be cut, or the loop is passing on labels that were
// never in danger.
fn test_the_list_sweep_is_not_vacuous() {
  wide = panel_build(wall_spec("ready"), 1280, 720, mono(24));
  cut = 0;
  for it in wide.p_list.lb_items {
    lb = it.en_label;
    // ⚠ `ends_with`, NOT a slice. `len` counts characters and a slice bound is a
    // byte offset, so `lb[len(lb) - 2..]` asks the wrong question of any label
    // that is not ASCII — the same confusion `fit_text` shipped with.
    if lb.ends_with("..") { cut += 1; }
  }
  assert(cut > 0, "no wall name was truncated at advance 24 — the sweep proves nothing");
}
