// WATER, AND WHY A ROAD NEEDS A BRIDGE — plan 20, `A9`'s mirror.
//
// > *"Waterways should be the most resistant to hill creation from anything else, it
// > can break into a waterfall but will normally just create chasms. So a road needs a
// > bridge to cross it because it cannot place the road there. And the water will
// > never flow upwards."* … *"even on this scale we have to model the direction of flow
// > probably as separate ground materials."* … *"water has a depth so it should define
// > a layer under it."*
//
// Four claims, and each is a row below: the direction is the MATERIAL, the depth is a
// LAYER, a raise does not move it, and a road is carried over it rather than laid on
// it. ⚠ The last one is what makes the mirror reachable at all — plan 20 recorded that
// *span* could not be designed because nothing could detect a waterway.
use hex_editor;
use hex_world;

const U = 0.25;
const G = 200;                 // the bank
const BED = 8;                 // how far the water's surface sits below its banks

// Flat ground with a river running EAST along `r = 0` — `hex_grid` direction 0, so
// each cell's downstream neighbour is `(q + 1, r)`.
fn river(fall: integer) -> World {
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 14)..15 {
    for r in (0 - 14)..15 { ground_set(w, q, r, G, SURFACE_MAT); }
  }
  why = "";
  for q2 in (0 - 12)..13 {
    // ⚠ THE VERDICT IS ASSERTED, IN THE FIXTURE. The first version of this helper
    // threw it away and a later row failed saying a waterfall had a step of 0 — the
    // water had simply not been written, and the test was measuring an unbuilt
    // fixture. A refused write swallowed is this tree's oldest scar and a test
    // helper is not exempt from it.
    code = water_set(w, q2, 0, G - BED - fall * q2, 0, why);
    assert(code == 0, "the fixture could not write water at ({q2},0): ({code}) {why}");
  }
  w
}

fn columns(w: World, q: integer, r: integer) -> integer {
  n = 0;
  for e in world_column(w, q, r).co_cells {
    if hex_world::hex_occupied(e) { n = n + 1; }
  }
  n
}

// ── the direction is the material ───────────────────────────────────────────

fn test_every_flow_direction_is_its_own_material_and_round_trips() {
  for d in 0..WATER_DIRS {
    m = water_of(d);
    assert(is_water(m), "the material for direction {d} is not water");
    assert(water_dir(m) == d,
           "direction {d} came back as {water_dir(m)} — the material and the direction "
           + "have parted company");
    assert(ground_kind_of(m).tr_fixed,
           "water flowing {d} is not fixed, so a raise would carry the river uphill");
  }
  // ⚠ STILL WATER IS WATER AND HAS NO DIRECTION, and the two answers must not be one:
  // a pool that read as *a river that had stopped* would be asked whether it flows
  // uphill and there is no downstream cell to ask about.
  assert(is_water(WATER_MAT), "still water is not water");
  assert(water_dir(WATER_MAT) < 0, "still water was given a direction");
  // and the control: nothing that is not water reads as water
  for k in ground_kinds() {
    if k.tr_name == "grass" || k.tr_name == "road" || k.tr_name == "field"
       || k.tr_name == "floor" || k.tr_name == "roof" {
      assert(!is_water(k.tr_mat), "{k.tr_name} reads as water");
      assert(!k.tr_fixed, "{k.tr_name} is fixed, so a raise no longer moves it");
    }
  }
}

// ── the depth is a layer ────────────────────────────────────────────────────

fn test_water_has_a_depth_and_defines_a_layer_under_it() {
  w = river(0);
  assert(WATER_DEPTH >= w.w_eps,
         "WATER_DEPTH {WATER_DEPTH} is under the store's own fold separation "
         + "{w.w_eps}, so a river could not be written at all");
  assert(columns(w, 0, 0) == 2,
         "a river column holds {columns(w, 0, 0)} occupied layers, not the bed and the "
         + "surface");
  assert(water_bed(w, 0, 0) == ground_h(w, 0, 0) - WATER_DEPTH,
         "the bed is at {water_bed(w, 0, 0)} where the surface is at "
         + "{ground_h(w, 0, 0)} and the depth is {WATER_DEPTH}");
  assert(is_water(world_ground_cell(w, 0, 0).h_material as integer ?? 0),
         "the surface of the river is not water");
  // ⚠ THE BED IS THE GROUND THE RIVER CUT, not a substance of its own — a river runs
  // over what was there.
  bl = off_layer(w, 0, 0, SURFACE_MAT);
  assert(bl >= 0, "the bed is not made of the ground the river was cut into");
  // and the bank beside it is untouched, one layer, at the bank height
  assert(columns(w, 0, 2) == 1, "the bank grew a layer it was never given");
  assert(ground_h(w, 0, 2) == G, "the bank moved when the river was written");
}

// ── the water never flows upwards ───────────────────────────────────────────

fn test_a_river_laid_downhill_never_flows_up() {
  w = river(1);
  seen = 0;
  for q in (0 - 10)..11 {
    f = water_falls(w, q, 0);
    if f == WATER_STILL { continue; }
    seen = seen + 1;
    assert(f >= 0, "the water at ({q},0) climbs {0 - f} to the cell it flows into");
    assert(!water_uphill(w, q, 0), "({q},0) reads as flowing uphill");
  }
  assert(seen > 0, "no cell of the fixture flows anywhere, so nothing was measured");
}

// ⚠ AND THE INSTRUMENT IS CHECKED AGAINST SOMETHING IT SHOULD FIND. A rule that only
// ever answers *fine* is not a rule, and this tree has the scar: a probe that samples
// its own output reports a green answer to a question never asked.
fn test_a_river_laid_the_wrong_way_is_caught() {
  w = river(0 - 1);              // the bed RISES downstream
  bad = 0;
  for q in (0 - 10)..11 {
    if water_uphill(w, q, 0) { bad = bad + 1; }
  }
  assert(bad > 0,
         "a river written climbing one unit a hex reported nothing wrong — the rule "
         + "cannot see the only state it exists to forbid");
}

// ⚠ THE MOUTH IS NOT A VIOLATION, AND NO ROW COVERED IT UNTIL A SABOTAGE SAID SO.
// Removing *the next cell must be water too* left every test green: a river's last
// cell flows into whatever is there, and measuring the drop to a dry bank would make
// the end of every river either a waterfall or — where the bank is higher — water
// running uphill. The run has ENDED there; that is a different answer from *it is
// flat here*, which is why `WATER_STILL` is its own value.
fn test_the_last_cell_of_a_river_is_its_mouth_and_not_a_fall() {
  w = river(0);
  // one cell past the fixture's easternmost water, and the bank there stands ABOVE
  // the river — the shape that would read as flowing uphill
  assert(!is_water(world_ground_cell(w, 13, 0).h_material as integer ?? 0),
         "the fixture's river runs past its own end, so this row tests nothing");
  assert(ground_h(w, 13, 0) > ground_h(w, 12, 0),
         "the bank at the mouth is not above the water, so a bad rule would pass here");
  assert(water_falls(w, 12, 0) == WATER_STILL,
         "the river's mouth reports a drop of {water_falls(w, 12, 0)} into dry ground");
  assert(!water_uphill(w, 12, 0),
         "the last cell of a river was called water flowing uphill");
}

// ⚠ A WATERFALL IS A BIG FALL, NOT A DIFFERENT THING. It is worth a row because the
// author named it: *it can break into a waterfall.* What separates it from a river is
// the size of one drop, and the rule that forbids climbing has to leave it alone.
fn test_a_waterfall_is_a_legal_drop_and_not_a_violation() {
  w = river(0);
  why = "";
  for q in 1..13 {
    c2 = water_set(w, q, 0, G - BED - 40, 0, why);
    assert(c2 == 0, "the lip could not be cut at ({q},0): ({c2}) {why}");
  }
  assert(water_falls(w, 0, 0) == 40,
         "the step at the lip is {water_falls(w, 0, 0)}, not the 40 the fixture built");
  assert(!water_uphill(w, 0, 0), "a waterfall was called water flowing uphill");
}

// ── a raise does not move it: the chasm ─────────────────────────────────────

fn test_a_raise_leaves_the_river_and_lifts_its_banks() {
  w = river(0);
  was = ground_h(w, 0, 0);
  bank0 = ground_h(w, 0, 3);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 40, 7, cl, rs);
  assert(ground_h(w, 0, 0) == was,
         "the raise carried the river from {was} to {ground_h(w, 0, 0)} — water is the "
         + "most resistant thing there is to hill creation");
  assert(water_bed(w, 0, 0) == was - WATER_DEPTH,
         "the raise moved the river BED, so the water is a different depth than it was");
  assert(ground_h(w, 0, 3) > bank0,
         "the bank did not rise at all, so the fixture raised nothing and this row "
         + "controls nothing");
  // ⚠ THE CHASM IS THE POINT, and it is a DIFFERENCE rather than a height: what the
  // author asked for is that the ground goes up around the water, which is exactly a
  // gorge deepening.
  assert(ground_h(w, 0, 3) - ground_h(w, 0, 0) > bank0 - was,
         "the gorge did not deepen: bank to water was {bank0 - was} and is now "
         + "{ground_h(w, 0, 3) - ground_h(w, 0, 0)}");
}

// ── and the road: carried over, never laid on ───────────────────────────────

// Walk a road SOUTH to NORTH across the river at `q = 0`, reading the grade from the
// bank — which is what a road builder has: the ground they are standing on.
//
// ⚠ IT COUNTS THROUGH AN OUT-PARAMETER AND NOT A RETURN, and that is loft#772 rather
// than a style: a `&` parameter reassigned from a CALL is a hard error, and a helper
// that both takes the two counters and returns a total would have to do exactly that.
fn cross_river(w: World, clamped: &integer, residual: &integer, off: &integer) {
  for r in (0 - 5)..6 {
    k = road_lay(w, 0, r, G, ROAD_HALF, (G as float) * U, 0.0, 0.0, clamped, residual);
    off = off + k;
  }
}

fn test_a_road_is_never_laid_on_water() {
  w = river(0);
  cl = 0;
  rs = 0;
  nn = 0;
  cross_river(w, cl, rs, nn);
  wet = 0;
  paved = 0;
  for q in (0 - 3)..4 {
    m = world_ground_cell(w, q, 0).h_material as integer ?? 0;
    if is_water(m) { wet = wet + 1; }
    if m == ROAD_MAT { paved = paved + 1; }
  }
  assert(wet > 0, "the crossing never reached the river, so this row tests nothing");
  assert(paved == 0,
         "{paved} cells of the waterway were paved — a road cannot be placed there");
}

fn test_and_it_is_carried_over_instead() {
  w = river(0);
  cl = 0;
  rs = 0;
  n = 0;
  cross_river(w, cl, rs, n);
  assert(n > 0, "the crossing spanned nothing at all");
  seen = 0;
  for q in (0 - 2)..3 {
    d = spanned_h(w, q, 0);
    if d < 0 { continue; }
    seen = seen + 1;
    // ⚠ THE COLUMN IS THREE: the bed, the water, and the deck over it. That is `A9`'s
    // shelf and its mirror in one place, and asserting the COUNT is what would catch a
    // deck that replaced the water instead of standing over it.
    assert(columns(w, q, 0) == 3,
           "a bridged river column holds {columns(w, q, 0)} occupied layers, not three");
    assert(is_water(world_ground_cell(w, q, 0).h_material as integer ?? 0),
           "the river stopped being water where the road crossed it");
    assert(d - ground_h(w, q, 0) >= BRIDGE_CLEAR,
           "the deck at {d} stands {d - ground_h(w, q, 0)} over water at "
           + "{ground_h(w, q, 0)}, under the {BRIDGE_CLEAR} a bridge is built to");
  }
  assert(seen > 0, "no cell of the river carries a deck");
  // ⚠ AND THE LIFT IS SAID OUT LOUD. A bridge that had to come up to clear the water
  // is an offer, and this tree's scar is a refused write that was swallowed.
  assert(cl > 0 && rs > 0,
         "the deck was lifted clear of the water silently — clamped {cl}, residual {rs}");
}

// ⚠ THE DECK IS PART OF THE ROAD'S RUN, and without this the settle would walk off the
// road at the riverbank exactly as it walked off at a shelf — measured once already,
// and it left a 27-unit step in a road whose limit is 1.
fn test_the_bridge_is_part_of_the_run() {
  w = river(0);
  cl = 0;
  rs = 0;
  n2 = 0;
  cross_river(w, cl, rs, n2);
  assert(run_h(w, 0, 0, ROAD_MAT) == spanned_h(w, 0, 0),
         "the run reader cannot see the deck: it answers {run_h(w, 0, 0, ROAD_MAT)} "
         + "where the deck is at {spanned_h(w, 0, 0)}");
  assert(ground_h(w, 0, 0) != run_h(w, 0, 0, ROAD_MAT),
         "the ground and the road answer the same height, so this row cannot tell a "
         + "deck from a paved river");
}

// ⚠ THE NEGATIVE CONTROL: dry ground is never bridged. Without it a build that spanned
// everything would pass every row above.
fn test_a_road_on_dry_ground_spans_nothing() {
  w = river(0);
  cl = 0;
  rs = 0;
  // the same walk, five hexes clear of the water
  n = 0;
  for r in 6..12 {
    k = road_lay(w, 0, r, G, ROAD_HALF, (G as float) * U, 0.0, 0.0, cl, rs);
    n = n + k;
  }
  assert(n == 0, "a road on dry ground left the ground {n} times");
  for r2 in 7..11 {
    assert(spanned_h(w, 0, r2) < 0, "dry ground at (0,{r2}) was bridged");
    assert(columns(w, 0, r2) == 1,
           "(0,{r2}) holds {columns(w, 0, r2)} occupied layers on dry ground");
  }
  assert(cl == 0 && rs == 0,
         "dry ground reported a lift: clamped {cl}, residual {rs}");
}

// ── THE ROUTE IS THE GROUND'S, AND THE WALK ONLY BREAKS TIES ────────────────
//
// > *"Water is different because when there are hills already it takes the lowest path,
// > but without them we still have to draw them like a road."*

// A ramp falling along `r`, so the fall line runs south and every contour is a line of
// constant `r`. Nothing is authored on it, so a river laid here has only the ground.
fn slope(k: integer) -> World {
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 20)..21 {
    for r in (0 - 20)..21 { ground_set(w, q, r, G - k * r, SURFACE_MAT); }
  }
  w
}

// Where the water actually went — the cells it wrote, in order, as a text.
fn route(w: World, q0: integer, r0: integer, hint: integer, steps: integer) -> text {
  cl = 0;
  rs = 0;
  why = "";
  water_lay(w, q0, r0, hint, steps, 0, cl, rs, why);
  out = "";
  for r in 0..12 {
    for q in (0 - 6)..7 {
      if is_water(world_ground_cell(w, q, r).h_material as integer ?? 0) {
        out += "({q},{r}) ";
      }
    }
  }
  out
}

fn test_on_a_slope_the_water_ignores_the_walk_and_takes_the_fall_line() {
  w = slope(6);
  cl = 0;
  rs = 0;
  why = "";
  // ⚠ THE HINT POINTS THE WRONG WAY ON PURPOSE — east, along the contour, where the
  // ground says south. If the walk could steer the river this row would find it going
  // east, which is the whole claim inverted.
  n = water_lay(w, 0, 0, 0, 8, 0, cl, rs, why);
  assert(n >= 6, "the river ran {n} cells and gave up");
  assert(!is_water(world_ground_cell(w, 4, 0).h_material as integer ?? 0),
         "the river went EAST along the contour — the author's walk steered it");
  // ⚠ THE FALL LINE ZIGZAGS, AND ASSUMING IT DID NOT IS WHAT THIS ROW FAILED ON FIRST.
  // `hex_grid`'s six are E, SE, SW, W, NW, NE — there is no straight SOUTH neighbour in
  // odd-r offset, so a river running down `r` alternates between `q` and `q − 1` and a
  // count taken at `q = 0` finds **one** cell of the run.
  rows = 0;
  for r in 0..8 {
    here = 0;
    for q in (0 - 4)..5 {
      if is_water(world_ground_cell(w, q, r).h_material as integer ?? 0) { here = here + 1; }
    }
    if here > 0 { rows = rows + 1; }
  }
  assert(rows >= 6, "the run touched {rows} rows of the fall line, not 6");
  // and every cell points DOWNHILL, which is the direction it actually stepped
  for q2 in (0 - 4)..5 {
    for r2 in 0..8 {
      m = world_ground_cell(w, q2, r2).h_material as integer ?? 0;
      if !is_water(m) { continue; }
      d = water_dir(m);
      if d < 0 { continue; }
      // ⚠ ASKED ONLY WHERE THE NEXT CELL IS WATER, and the widening is what taught
      // this row the difference. A FLANK cell carries the centre's direction, and at
      // the edge of the widening the cell downstream of it is a BANK — higher, and not
      // part of the river. `water_falls` answers `WATER_STILL` there, which is the run
      // ending rather than water climbing; asserting on the ground alone made this row
      // stronger than the rule it exists to check.
      (aq, ar) = hex_grid::hex_neighbor(q2, r2, d);
      if !is_water(world_ground_cell(w, aq, ar).h_material as integer ?? 0) { continue; }
      assert(ground_h(w, aq, ar) <= ground_h(w, q2, r2),
             "the water at ({q2},{r2}) points at a cell above it");
    }
  }
}

fn test_on_flat_ground_it_follows_the_walk_exactly() {
  w = slope(0);
  cl = 0;
  rs = 0;
  why = "";
  n = water_lay(w, 0, 0, 0, 6, 0, cl, rs, why);      // hint EAST
  assert(n == 6, "a canal on the flat ran {n} cells, not the 6 it was asked for");
  for q in 0..6 {
    assert(is_water(world_ground_cell(w, q, 0).h_material as integer ?? 0),
           "({q},0) is dry, so the walk did not decide the route on flat ground");
  }
  // ⚠ AND THE CONTROL IS THE OTHER HINT. Without it, "it went east" is equally well
  // explained by east being the first direction the loop happens to try.
  w2 = slope(0);
  cl2 = 0;
  rs2 = 0;
  why2 = "";
  water_lay(w2, 0, 0, 3, 6, 0, cl2, rs2, why2);      // hint WEST
  assert(is_water(world_ground_cell(w2, 0 - 3, 0).h_material as integer ?? 0),
         "a westward walk still laid the canal eastward");
  assert(!is_water(world_ground_cell(w2, 3, 0).h_material as integer ?? 0),
         "a westward walk laid water to the EAST as well");
}

// ⚠ THE INVARIANT IS NOW TRUE BY CONSTRUCTION, AND THAT IS WORTH ASSERTING ANYWAY. The
// walk only steps to a cell no higher than the one it is on, so a river it lays cannot
// climb — but the rule stays for water authored by hand or with the ground moved under
// it, and a row here is what would catch the walk losing the property.
fn test_a_river_the_gesture_laid_never_climbs() {
  w = slope(6);
  cl = 0;
  rs = 0;
  why = "";
  water_lay(w, 0, 0, 0, 10, 0, cl, rs, why);
  bad = 0;
  seen = 0;
  for q in (0 - 6)..7 {
    for r in (0 - 2)..12 {
      if !is_water(world_ground_cell(w, q, r).h_material as integer ?? 0) { continue; }
      seen = seen + 1;
      if water_uphill(w, q, r) { bad = bad + 1; }
    }
  }
  assert(seen > 0, "no water was laid, so nothing was measured");
  assert(bad == 0, "{bad} of {seen} cells the gesture laid run uphill");
}

fn test_it_ends_in_a_pool_where_nothing_is_lower() {
  // a bowl: one cell lower than everything around it
  w = slope(0);
  ground_set(w, 3, 0, G - 20, SURFACE_MAT);
  cl = 0;
  rs = 0;
  why = "";
  n = water_lay(w, 0, 0, 0, 12, 0, cl, rs, why);
  assert(is_water(world_ground_cell(w, 3, 0).h_material as integer ?? 0),
         "the run never reached the bowl");
  assert(water_dir(world_ground_cell(w, 3, 0).h_material as integer ?? 0) < 0,
         "the last cell of the run still claims to flow somewhere");
  assert(n <= 4, "the run carried on {n} cells past a basin it should have stopped in");
}

fn test_a_river_does_not_cross_itself() {
  w = slope(0);
  cl = 0;
  rs = 0;
  why = "";
  // ⚠ WITHOUT THE GUARD THIS IS AN INFINITE SHUFFLE, not a wrong route: the cell just
  // written sits a freeboard below its banks, so it is the lowest thing around and the
  // walk turns straight back into it.
  n = water_lay(w, 0, 0, 0, 12, 0, cl, rs, why);
  wet = 0;
  for q in (0 - 16)..17 {
    for r in (0 - 4)..5 {
      if is_water(world_ground_cell(w, q, r).h_material as integer ?? 0) { wet = wet + 1; }
    }
  }
  // ⚠ THE RUN REPORTS A LENGTH AND THE WORLD HOLDS AN AREA, which is what the widening
  // separated: this row asserted them EQUAL when a river was one cell wide, and a wider
  // one made the identity false without anything being wrong.
  assert(wet >= n, "the run reports {n} cells and the world holds only {wet}");
  assert(n == 12, "the guard cut the run short at {n} cells");
}

// ── AND IT WIDENS AS IT FLOWS DOWN ──────────────────────────────────────────

// How many cells across the river is at this point along a flat easterly canal — the
// column of cells at `q`, counted across `r`.
fn across(w: World, q: integer) -> integer {
  n = 0;
  for r in (0 - 6)..7 {
    if is_water(world_ground_cell(w, q, r).h_material as integer ?? 0) { n = n + 1; }
  }
  n
}

fn test_the_width_is_a_function_of_how_far_it_has_run() {
  assert(water_half(0) == 0, "a river starts wider than one cell");
  assert(water_half(WATER_WIDEN - 1) == 0, "it widened before its first {WATER_WIDEN} cells");
  assert(water_half(WATER_WIDEN) == 1, "it did not widen at {WATER_WIDEN} cells");
  assert(water_half(WATER_WIDEN * 40) == WATER_WIDE_MAX,
         "it kept widening past its cap: {water_half(WATER_WIDEN * 40)}");
  prev = 0;
  for k in 0..(WATER_WIDEN * 6) {
    assert(water_half(k) >= prev, "the width fell at {k}");
    prev = water_half(k);
  }
}

fn test_a_long_canal_is_wider_at_its_foot_than_at_its_head() {
  w = slope(0);
  cl = 0;
  rs = 0;
  why = "";
  n = water_lay(w, 0 - 8, 0, 0, 20, 0, cl, rs, why);
  assert(n >= 18, "the canal ran {n} cells, too short to widen at all");
  head = across(w, 0 - 7);
  foot = across(w, 8);
  assert(head == 1, "the head is {head} cells across, not one");
  assert(foot > head, "the foot is {foot} across and the head {head} — it never widened");
  assert(foot <= 2 * WATER_WIDE_MAX + 1,
         "the foot is {foot} across, past the {2 * WATER_WIDE_MAX + 1} cap");
}

// ⚠ THE COUNT OUTLIVES THE STROKE, which is the half a single call cannot show. An
// author walks a river over many placements, and a width taken from the index within
// one of them resets to a trickle at every footfall.
fn test_the_widening_survives_a_stroke_boundary() {
  w = slope(0);
  cl = 0;
  rs = 0;
  why = "";
  // four strokes of five, exactly as the gesture drives it
  done = 0;
  for k in 0..4 {
    q0 = 0 - 8 + done;
    got = water_lay(w, q0, 0, 0, 5, done, cl, rs, why);
    done = done + got;
  }
  assert(done >= 18, "the four strokes laid {done} cells");
  assert(across(w, 8) > across(w, 0 - 7),
         "the river is the same width at its foot as at its head, so the run count "
         + "did not survive the stroke");
}

// ⚠ AND IT WIDENS INTO GROUND, NEVER INTO A CLIFF. A river widens by wearing its banks
// away and a gorge wall is not a bank — which is the chasm rule read from the other
// side.
fn test_it_stays_narrow_in_a_gorge() {
  w = slope(0);
  // walls either side of the line the canal will take
  for q in (0 - 10)..12 {
    ground_set(w, q, 0 - 1, G + 60, SURFACE_MAT);
    ground_set(w, q, 1, G + 60, SURFACE_MAT);
  }
  cl = 0;
  rs = 0;
  why = "";
  n = water_lay(w, 0 - 8, 0, 0, 20, 0, cl, rs, why);
  assert(n >= 18, "the canal ran {n} cells");
  assert(across(w, 8) == 1,
         "the river widened to {across(w, 8)} cells inside a gorge whose walls stand "
         + "60 units over it");
}

// ⚠ AND THE EDGES ARE THE SHALLOW PART, WHICH IS THE ONLY WAY THE RAMP CAN SHOW ONE.
// `WATER_DEPTH` is the store's floor — `F1` keeps occupied layers `ε` apart, so nothing
// thinner is representable — which means a river cut to the minimum everywhere has one
// depth and one colour. A shallow edge is therefore a claim about the MIDDLE.
fn test_a_wide_river_is_deeper_in_the_middle_than_at_its_banks() {
  w = slope(0);
  cl = 0;
  rs = 0;
  why = "";
  n = water_lay(w, 0 - 8, 0, 0, 20, 0, cl, rs, why);
  assert(n >= 18, "the canal ran {n} cells, too short to widen at all");
  // the widest point, and its two edges
  mid = water_depth_at(w, 8, 0);
  assert(mid > 0, "there is no water at the middle of the widest point");
  seen = 0;
  for r in (0 - 4)..5 {
    if r == 0 { continue; }
    d = water_depth_at(w, 8, r);
    if d < 0 { continue; }
    seen = seen + 1;
    assert(d < mid,
           "the bank at (8,{r}) is {d} deep against {mid} in the middle — the channel "
           + "is flat-bottomed, so every cell of it draws the same colour");
    assert(d >= WATER_DEPTH,
           "the bank at (8,{r}) is {d} deep, under the {WATER_DEPTH} floor `F1` forces");
  }
  assert(seen > 0, "the river never widened, so it has no banks to be shallow");
  // ⚠ AND THE BED STEPS RATHER THAN DROPPING IN ONE GO, which the row above cannot
  // see: with the flanks all cut to the floor the middle is still deeper, so *deeper in
  // the middle* passed a build where the cross-section was a trench with a lip. Three
  // distinct depths across the widest point is the profile — bank, shoulder, channel —
  // and a sabotage that flattens the flanks leaves two.
  ds: vector<integer> = [];
  for r2 in (0 - 4)..5 {
    d2 = water_depth_at(w, 8, r2);
    if d2 < 0 { continue; }
    have = false;
    for e in ds { if e == d2 { have = true; } }
    if !have { ds += [d2]; }
  }
  assert(len(ds) >= 3,
         "the widest point has {len(ds)} distinct depths ({ds}), so its bed is a step "
         + "and not a slope");
}

// ⚠ THE SOURCE HAS NO WIDTH TO CARRY A GRADIENT, SO IT CARRIES ONE ALONG ITSELF. A
// river is one cell wide until it has run `WATER_WIDEN` cells, and one cell of one
// depth draws one colour — so while the depth was tied to `water_half` the head of
// every river was a flat light band whatever the ramp did. A step function is constant
// between its steps.
fn test_a_river_deepens_from_its_source_before_it_is_wide_enough_to_show_it() {
  // the head, where the width is still one cell
  assert(water_half(0) == 0 && water_half(WATER_WIDEN - 1) == 0,
         "the fixture's head is already wide, so this row tests nothing");
  a = water_deep_at(0);
  b = water_deep_at(WATER_WIDEN - 1);
  assert(a == WATER_DEPTH, "a spring is {a} deep, not the {WATER_DEPTH} floor");
  assert(b > a,
         "the head runs {WATER_WIDEN} cells at one depth ({a} to {b}) — one cell of one "
         + "depth is one colour, so the source shows no gradient at all");
  // and it still stops where the widening does
  cap = WATER_DEPTH + WATER_WIDE_MAX * WATER_STEP;
  assert(water_deep_at(WATER_WIDEN * WATER_WIDE_MAX) == cap,
         "the channel is {water_deep_at(WATER_WIDEN * WATER_WIDE_MAX)} at full width, "
         + "not the {cap} the ramp's deep end is derived from");
  assert(water_deep_at(WATER_WIDEN * 40) == cap, "it kept deepening past its cap");
  prev = 0;
  for k in 0..(WATER_WIDEN * 6) {
    assert(water_deep_at(k) >= prev, "the channel got shallower at {k}");
    prev = water_deep_at(k);
  }
}

fn test_the_source_of_a_laid_river_really_does_deepen() {
  w = slope(0);
  cl = 0;
  rs = 0;
  why = "";
  n = water_lay(w, 0 - 8, 0, 0, 20, 0, cl, rs, why);
  assert(n >= 18, "the canal ran {n} cells");
  head = water_depth_at(w, 0 - 8, 0);
  next = water_depth_at(w, 0 - 8 + WATER_WIDEN - 1, 0);
  assert(head == WATER_DEPTH, "the spring is {head} deep, not the floor");
  assert(next > head,
         "the first {WATER_WIDEN} cells are all {head} deep, so the source is a flat "
         + "band of one colour");
}
