// A HOUSE'S DESCRIPTION — plan 26 `B4n`, BLUEPRINT §0.
//
// ⛔ **A HOUSE HAS DRAWN NO DESCRIPTION SINCE `B1`, AND IT IS THE THING A BLUEPRINT IS
// FOR.** Its marks are four runs plus a closed loop, which `wall_read_run` refuses
// whole; the round readers ask about round things. ⚠ **And splitting the marks by
// structure does not help** — `house.keys`'s 42 marks are ONE vertex-connected
// component, because each of `B0`'s four stray corner edges shares a vertex with the
// loop.
//
// ✅ **THE FLOOR IS WHERE THE ANSWER IS.** `place_house` fills its footprint with
// `hex_shape::box_fill`, so the cells carrying `FLOOR_MAT` are a `Box`'s rasterisation
// and the rectangle recovers by generate-and-compare. The MARKS never enter the
// recovery — they are what the recovered rectangle is then measured against, which is
// what lets this file answer `B0`'s question about the four stray edges.
use hex_editor;
use hex_voxel;
use hex_shape;
use hex_form;
use hex_grid;

// 90°, facing +z — the pose `house_walls.loft` and `probe/d2` both use.
const YAW = 1.5707963267948966;

// ⛔ **`B0`'s FOUR STRAY EDGES, MEASURED AND NAMED — one per corner, on a house nobody
// cut an opening into.** `B0` found four wall edges bounding none of `house.keys`'s 27
// cells and could not say whether they were authored: *"a stamp that over-runs the fill
// at each corner may be drawing a wall that genuinely exists in the description"*. The
// rectangle settles it — its boundary is COMPLETE (`missing 0`) and four marks lie
// outside it. They are the four mitred runs over-running their corners.
//
// ⚠ **AND `house.keys` READS 3 AND 1, WHICH IS THE SAME HOUSE PLUS ITS OPENINGS.** Its
// profile 2 sits on one of these four strays and clears it to material 0, so that stray
// stops being a wall and the count drops to three; profile 1 sits ON the rectangle's
// boundary and clears an edge the description wants, which is the `1 missing`. That is
// `@HB-X70`'s defect from a third direction — *an opening is never "no wall"* — and
// plan 24 `A8` already records `builtin_house_door` leaving the edge at 0.
const STRAY_EXPECT = 4;
const MISSING_EXPECT = 0;

const U = 0.25;

fn flat_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - 30, 0 - 30, 61, 61, 8, SURFACE_MAT);
  w
}

// ── THE MEMBERSHIP, PINNED AGAINST THE LIBRARY ─────────────────────────────
//
// ⚠ `box_holds` is `box_fill`'s own test with the allocation taken out, so it has to
// agree with it cell for cell — `disc_holds`'s rule at a third shape. A second
// membership that drifted would make every row below a claim about the wrong rectangle.
fn test_box_membership_agrees_with_the_library() {
  for rot in 0..12 {
    for wid in [2, 4, 5] {
      b = hex_shape::box_new(1, 0 - 2, wid, 5, rot, false);
      cells = hexset_chunk(0 - 14, 0 - 14, 29, 29);
      hex_shape::box_fill(b, cells);
      seen = 0;
      for r in 0 - 14..15 {
        for q in 0 - 14..15 {
          assert(box_holds(b, q, r) == hexset_get(cells, q, r),
                 "rot {rot} wid {wid}: `box_holds` and `box_fill` disagree at {q},{r}");
          if hexset_get(cells, q, r) { seen = seen + 1; }
        }
      }
      assert(seen > 0,
             "rot {rot} wid {wid} filled nothing — the agreement above is vacuous");
    }
  }
}

// ⚠ **AN INVERSE IS PINNED BY SENDING ITS ANSWER BACK.** `box_px_x`/`box_px_z` undo
// `box_to_local`, and the only honest check is the round trip: every corner must come
// back as `(±hw, ±hd)`.
fn test_the_drawn_corners_round_trip_through_the_library() {
  w = flat_world();
  for rot in 0..12 {
    b = hex_shape::box_new(2, 1, 4, 6, rot, false);
    xs = box_px_x(b, w);
    zs = box_px_z(b, w);
    assert(len(xs) == 4 && len(zs) == 4,
           "rot {rot} gave {len(xs)}/{len(zs)} corners, not four");
    hw = hex_shape::box_hw(b);
    hd = hex_shape::box_hd(b);
    for i in 0..4 {
      (lu, lv) = hex_shape::box_to_local(b, xs[i] ?? 0.0, zs[i] ?? 0.0);
      du = lu - hw; if du < 0.0 { du = 0.0 - du; }
      dv = lv - hd; if dv < 0.0 { dv = 0.0 - dv; }
      if du > 0.000001 { du = lu + hw; if du < 0.0 { du = 0.0 - du; } }
      if dv > 0.000001 { dv = lv + hd; if dv < 0.0 { dv = 0.0 - dv; } }
      assert(du < 0.000001 && dv < 0.000001,
             "rot {rot} corner {i} maps to ({lu},{lv}), not to (±{hw}, ±{hd})");
    }
  }
}

// ── THE RECOVERY ───────────────────────────────────────────────────────────

fn house_world() -> VoxelWorld {
  w = flat_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, YAW);
  ack = press_verb(s, w, s.es_author, VB_PLACE, "");
  assert(ack.ak_ok, "the house was refused: {ack.ak_why}");
  w
}

fn test_a_placed_house_recovers_to_a_rectangle() {
  w = house_world();
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "a placed house recovered no rectangle: {h.hs_why}");
  assert(h.hs_cells > 0, "the recovery accounts for no floor cells");
  assert(h.hs_wid > 0 && h.hs_dep > 0, "the rectangle has no extent");
  // …and the rectangle it names really does reproduce the floor, through the door the
  // search does not use.
  assert(house_fits_at(w, 0 - 16, 0 - 16, 33, 33, h.hs_cq, h.hs_cr,
                       h.hs_wid, h.hs_dep, h.hs_rot, 0.0),
         "the rectangle the search returned does not reproduce the floor it came from");
}

// ⛔ **THE ANCHOR IS EXACT, AND THAT IS THE HALF THAT IS NOT QUANTISED** — measured
// over 432 rectangles, every one has exactly one anchor cell that works. A recovery
// answering the wrong cell would draw the description beside its house.
fn test_the_anchor_is_the_house_s_own_cell() {
  w = house_world();
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  li = edge_layer(w, h.hs_cq, h.hs_cr, 0.0);
  assert(li >= 0, "the anchor cell holds nothing at all");
  assert((hex_voxel::world_cell(w, h.hs_cq, h.hs_cr, li).h_material as integer ?? 0)
         == FLOOR_MAT,
         "the anchor {h.hs_cq},{h.hs_cr} is not one of the house's own floor cells");
  // ⚠ AND IT IS NOT THE ORIGIN, where a reader that answered a constant would pass.
  assert(h.hs_cq != 0 || h.hs_cr != 0,
         "the house sits on the origin, where this row cannot see a constant answer");
}

// ⛔ **THE SIZE IS QUANTISED AND THE ANSWER SAYS SO.** Raising one extent by a hex step
// can admit no new row of cell centres, so several rectangles fill identical fields —
// `@HB-X49`'s sentence a third time. The reader answers the SMALLEST and reports how
// many were in the class.
fn test_two_rectangles_can_fill_one_field() {
  a = hexset_chunk(0 - 14, 0 - 14, 29, 29);
  b = hexset_chunk(0 - 14, 0 - 14, 29, 29);
  hex_shape::box_fill(hex_shape::box_new(0, 0, 2, 2, 0, false), a);
  hex_shape::box_fill(hex_shape::box_new(0, 0, 2, 3, 0, false), b);
  same = true;
  for r in 0 - 14..15 {
    for q in 0 - 14..15 { if hexset_get(a, q, r) != hexset_get(b, q, r) { same = false; } }
  }
  assert(same,
         "2x2 and 2x3 no longer fill the same cells — the quantisation this reader "
       + "reports has changed, and the class count means something else now");
  // …and the control: two rectangles a step apart in the OTHER axis do differ, or the
  // row above would pass for a `box_fill` that ignored its arguments.
  c = hexset_chunk(0 - 14, 0 - 14, 29, 29);
  hex_shape::box_fill(hex_shape::box_new(0, 0, 4, 2, 0, false), c);
  diff = false;
  for r in 0 - 14..15 {
    for q in 0 - 14..15 { if hexset_get(a, q, r) != hexset_get(c, q, r) { diff = true; } }
  }
  assert(diff, "2x2 and 4x2 fill the same cells — `box_fill` is reading no argument");
}

// ⛔ **THE ROW A SABOTAGE SWEEP HAD TO WRITE.** Its first version asked only whether a
// rectangle one step narrower AT THE SAME ROTATION fits — which is true of the largest
// member of the class as well as the smallest, so the row went **green** against a
// reader answering the LARGEST. The claim is *the smallest*, and the only thing that
// tests it is naming both ends of the class.
fn test_the_reader_answers_the_smallest_of_the_class_it_reports() {
  w = house_world();
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  assert(h.hs_class == 8,
         "the house's field admits {h.hs_class} rectangles, not the 8 measured — two "
       + "shapes, 4x5 and 5x5, each described four ways by the rectangle's own symmetry");
  assert(h.hs_wid + h.hs_dep == 9,
         "the reader answers {h.hs_wid}x{h.hs_dep} — a perimeter of {h.hs_wid + h.hs_dep} "
       + "against the 9 of the smallest rectangle in the class");
  // ⚠ **AND A LARGER ONE REALLY IS IN THE CLASS**, or the row above would pass for a
  // field that admits exactly one rectangle and no choice is being made at all.
  assert(house_fits_at(w, 0 - 16, 0 - 16, 33, 33, h.hs_cq, h.hs_cr, 5, 5, h.hs_rot, 0.0),
         "5x5 does not fit this floor — the class has no larger member and this row "
       + "cannot see which end of it the reader picked");
}

// ── THE REFUSALS ───────────────────────────────────────────────────────────

fn test_a_window_with_no_floor_says_so_differently() {
  h = house_recover(flat_world(), 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(!h.hs_ok, "bare ground recovered a house");
  assert(h.hs_cells == 0, "bare ground reports {h.hs_cells} floor cells");
  assert(h.hs_why.contains("no floor"),
         "an empty window and a refused one read alike: {h.hs_why}");
}

// ⚠ **A FLOOR THAT IS NOT A RECTANGLE IS REFUSED**, which is what keeps this a
// description and not a fit: a generate-and-compare reader must answer *no* to a field
// that is nearly its shape.
fn test_a_floor_with_a_bite_out_of_it_is_refused() {
  w = house_world();
  assert(house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0).hs_ok,
         "the fixture's house did not recover to begin with");
  h0 = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  // take one floor cell away
  bit = false;
  for r in 0 - 16..17 {
    for q in 0 - 16..17 {
      if bit { continue; }
      li = edge_layer(w, q, r, 0.0);
      if li < 0 { continue; }
      if (hex_voxel::world_cell(w, q, r, li).h_material as integer ?? 0) == FLOOR_MAT {
        ground_set(w, q, r, terrain_h(q, r, w), SURFACE_MAT);
        bit = true;
      }
    }
  }
  assert(bit, "the fixture had no floor cell to remove");
  g = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(!g.hs_ok,
         "a floor with a cell missing still described the rectangle {g.hs_wid}x{g.hs_dep}");
  assert(g.hs_cells == h0.hs_cells - 1,
         "the refusal reports {g.hs_cells} cells against the {h0.hs_cells - 1} that "
       + "are left — *nothing here* and *a shape I could not explain* are different");
}

// ── `B0`'s QUESTION, ANSWERED ──────────────────────────────────────────────
//
// ⛔ **`B0` FOUND FOUR WALL EDGES BOUNDING NONE OF THE HOUSE'S CELLS AND COULD NOT SAY
// WHETHER THEY WERE AUTHORED.** *"A stamp that over-runs the fill at each corner may be
// drawing a wall that genuinely exists in the description"* — the field half alone can
// say *this edge bounds no room* and not *and no wall was authored there*. With the
// rectangle recovered, it can: the description is a rectangle, and its boundary is a
// definite set of edges.
fn test_the_rectangle_names_the_marks_it_does_not_explain() {
  w = house_world();
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  assert(h.hs_stray == STRAY_EXPECT,
         "the rectangle leaves {h.hs_stray} marks unexplained, not {STRAY_EXPECT} — "
       + "`place_house`'s corner over-run has changed");
  assert(h.hs_missing == MISSING_EXPECT,
         "the rectangle wants {h.hs_missing} edges the store does not hold, not "
       + "{MISSING_EXPECT}");
}


// ── `B4o` — WHICH STRUCTURE DOES A MARK BELONG TO? ─────────────────────────
//
// ⛔ **`B4n` COUNTED EVERY MARK IN THE WINDOW THE RECTANGLE DID NOT WANT.** In a window
// holding only a house that is its mitre, which is what it was measured on. In a window
// holding a house AND anything else it is the other thing — a caption confidently naming
// the wrong structure. ⚠ **And it is `B1`'s finding pointing the other way**: there a
// house cost an unrelated wall its description; here the house claims it.

// One house, and a straight wall well clear of it.
//
// ⚠ **"CLEAR" IS NINE ROWS, AND THE FIRST FIXTURE WAS NOT.** A wall laid beside the
// house had three of its own marks inside the house's neighbourhood, so the mitre count
// read 7 and the recovered run came back TRUNCATED — `-13.86..-6.93` for a wall laid
// from -14 to -4. Both are the ownership rule working: a mark that close genuinely is
// ambiguous. `B1`'s own case put the house eight hexes away, and so does this.
fn housed_and_walled() -> VoxelWorld {
  w = house_world();
  d = run_between(0.0 - 12.0, 0.0 - 12.0, 0.0 - 2.0, 0.0 - 12.0, WALL_MAT);
  assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
  rs = WallRuns { items: [] };
  m = 0;
  wall_stamp(w, d.rd_run, WALL_MAT, 8, rs, m);
  assert(m > 0, "the fixture's wall stamped nothing");
  w
}

// ⚠ **THE HOUSE ACCOUNTS FOR EVERY ONE OF ITS OWN MARKS AND NOTHING ELSE**, which is
// what makes the split a statement rather than a guess: on a house alone there is
// nothing left over at all.
fn test_a_house_accounts_for_its_own_marks_and_no_others() {
  h = house_recover(house_world(), 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  assert(h.hs_stray == STRAY_EXPECT,
         "the mitre explains {h.hs_stray} marks, not {STRAY_EXPECT}");
  assert(h.hs_other == 0,
         "a house standing alone leaves {h.hs_other} marks unaccounted for — the "
       + "ownership rule does not reach its own mitre");
}

// ⛔ **THE ROW `B4n` COULD NOT HAVE PASSED.** With a wall in the window its `hs_stray`
// counted the wall's marks as the house's over-run; the count is the mitre's alone now,
// and the wall's marks are reported as somebody else's.
fn test_a_wall_in_the_window_is_not_the_house_s_over_run() {
  h = house_recover(housed_and_walled(), 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  assert(h.hs_stray == STRAY_EXPECT,
         "with a wall in the window the mitre explains {h.hs_stray} marks, not "
       + "{STRAY_EXPECT} — the wall is being counted as the house's");
  assert(h.hs_other > 0,
         "the wall's marks are not reported as anybody else's");
}

// ⛔ **`B1`'s CASE, THE OTHER WAY UP.** *"The same wall reads `run d0 p5` alone and is
// refused when a house stands eight hexes away"* — one mitre stub meets the wall's chain
// at a vertex and `wall_read_run` will not answer for a marking that is not a path.
// ⚠ **The reader was right and the QUESTION was wrong**: those marks are not one path,
// because they are not one structure.
fn test_the_wall_recovers_once_the_house_s_marks_are_taken_out() {
  w = housed_and_walled();
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  bx = hex_shape::box_new(h.hs_cq, h.hs_cr, h.hs_wid, h.hs_dep, h.hs_rot, false);

  // asked of the whole window, the run reader refuses — as it should
  assert(!wall_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0).rr_ok,
         "the run reader described a window holding a house and a wall — it has "
       + "stopped refusing a marking that is not a path, and this pair proves nothing");
  // …and with the house's marks attributed, the wall is a run again
  ro = wall_recover_outside(w, 0 - 16, 0 - 16, 33, 33, 0.0, bx);
  assert(ro.rr_ok,
         "the wall is still unreadable with the house taken out — the ownership rule "
       + "is not reaching every mark the house stamped");
  // …and it is the wall that was laid, not some other run: both ends within a cell.
  lo = ro.rr_x0; hi = ro.rr_x1;
  if hi < lo { lo = ro.rr_x1; hi = ro.rr_x0; }
  assert(lo < 0.0 - 10.0 && hi > 0.0 - 4.0,
         "the recovered run spans {lo}..{hi} in x, which is not the wall laid from "
       + "-12 to -2");
}

// ⚠ **AND THE CONTROL: A WALL ALONE IS UNMOVED BY ANY OF THIS.** A window with no house
// in it must read exactly as it did before, or the split has changed what a run is.
fn test_a_wall_alone_reads_the_same_through_both_doors() {
  w = flat_world();
  d = run_between(0.0 - 12.0, 0.0 - 12.0, 0.0 - 2.0, 0.0 - 12.0, WALL_MAT);
  assert(d.rd_ok, "the wall was refused");
  rs = WallRuns { items: [] };
  m = 0;
  wall_stamp(w, d.rd_run, WALL_MAT, 8, rs, m);
  a = wall_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
  // a box far away owns none of it, so the two doors must agree exactly
  far = hex_shape::box_new(20, 20, 4, 5, 0, false);
  b = wall_recover_outside(w, 0 - 20, 0 - 20, 41, 41, 0.0, far);
  assert(a.rr_ok && b.rr_ok, "the wall alone was refused by one of the two doors");
  assert(a.rr_d == b.rr_d && a.rr_p == b.rr_p && a.rr_x0 == b.rr_x0
         && a.rr_z0 == b.rr_z0 && a.rr_x1 == b.rr_x1 && a.rr_z1 == b.rr_z1,
         "the two doors describe the same wall differently: d{a.rr_d} p{a.rr_p} "
       + "against d{b.rr_d} p{b.rr_p}");
}
