//
// S6 — A ROOF IS A RIDGE, NOT A CONE.
//
// ⚠ The editor's roof was `anchor + eave + (rad - dist) * PITCH` — a linear cone
// about a disc's centre, which is the shape a DISC gives you and not the shape a
// building has. `hex_draw::draw_roof` runs `hex_roof`'s ridge profile along the
// plan's own u axis, so a rectangle gets a GABLE: two slopes meeting on a line.
//
// The claims below are what makes it a gable rather than a mound, and every one of
// them is a height read back from the store — the roof is a height field, which is
// exactly what a column can hold.
use hex_editor;
use hex_voxel;
use hex_grid;
use hex_field;

const W = 5;
const D = 4;
const FLOOR = 40;

fn world() -> VoxelWorld {
  w = world_new(0.25, 0, 8, 3).wn_world;
  hex_editor::ground_fill(w, 0 - 24, 0 - 24, 25, 25, FLOOR, hex_editor::SURFACE_MAT);
  w
}

fn placed() -> Footprint {
  hex_editor::pose_footprint(0.0, 0.0, PI / 6.0 ?? 0.0, W, D)
}

fn footprint_cells(f: Footprint) -> HexSet {
  pad = W + D + 4;
  cells = hexset_chunk(f.fp_cq - pad, f.fp_cr - pad, 2 * pad + 1, 2 * pad + 1);
  hex_editor::footprint_fill(f, cells);
  cells
}

// The roof height stored at a cell — the second occupied cell of its column.
fn roof_at(w: VoxelWorld, q: integer, r: integer) -> integer {
  h = 0 - 1;
  for c in world_column(w, q, r).co_cells {
    if hex_voxel::hex_occupied(c)
       && (c.h_material as integer ?? 0) == hex_editor::ROOF_MAT {
      h = c.h_height as integer ?? 0;
    }
  }
  h
}

// ⚠ **THE PLAN IS AN ARGUMENT NOW — plan 22 `D2a.1`.** `roof_over` used to take an
// eave step and a pitch and hand them to `hex_draw::draw_roof`; it takes the filed
// `RoofPlan` and writes the cells from `roof_plan_y`, so the store and the picture
// are one surface rather than two bodies computing one formula. This builds the
// plan a test means, at the eave every fixture here already used.
fn plan_at(f: Footprint, pitch: float) -> RoofPlan {
  hex_editor::roof_plan_of(f, hex_editor::roof_eave_y(FLOOR, hex_editor::ROOF_EAVE_UP,
                                                      0.25), pitch)
}

fn roofed() -> VoxelWorld {
  w = world();
  f = placed();
  cells = footprint_cells(f);
  hex_editor::roof_over(w, f, cells,
                        plan_at(f, hex_editor::ROOF_PITCH_DEFAULT), 0);
  w
}

fn test_a_roof_covers_every_cell_of_the_footprint() {
  w = world();
  f = placed();
  cells = footprint_cells(f);
  ack = hex_editor::roof_over(w, f, cells,
                              plan_at(f, hex_editor::ROOF_PITCH_DEFAULT), 0);
  assert(ack.ak_ok, "the roof went on: {ack.ak_why}");
  assert(ack.ak_n == 27, "a 5x4 footprint is 27 cells, got {ack.ak_n}");
}

fn test_the_roof_starts_where_the_wall_ends() {
  // The eave is the wall's own height: a roof that started lower would cut into
  // the wall, and one that started higher would leave a band of daylight.
  w = roofed();
  f = placed();
  lowest = 100000;
  cells = footprint_cells(f);
  for r in f.fp_cr - 12..f.fp_cr + 13 {
    for q in f.fp_cq - 12..f.fp_cq + 13 {
      if hexset_get(cells, q, r) {
        h = roof_at(w, q, r);
        if h >= 0 && h < lowest { lowest = h; }
      }
    }
  }
  assert(lowest >= FLOOR + hex_editor::ROOF_EAVE_UP - 2,
         "the lowest roof cell is at the eave, got {lowest} against {FLOOR + hex_editor::ROOF_EAVE_UP}");
}

fn test_the_ridge_stands_above_the_eave() {
  // ⚠ THE CLAIM THAT MAKES IT A ROOF. A flat field of cells at the eave is a lid;
  // a roof RISES, and the rise is the pitch times half the depth.
  w = roofed();
  f = placed();
  cells = footprint_cells(f);
  hi = 0;
  lo = 100000;
  for r in f.fp_cr - 12..f.fp_cr + 13 {
    for q in f.fp_cq - 12..f.fp_cq + 13 {
      if hexset_get(cells, q, r) {
        h = roof_at(w, q, r);
        if h >= 0 {
          if h > hi { hi = h; }
          if h < lo { lo = h; }
        }
      }
    }
  }
  assert(hi > lo, "the roof rises: {lo} at the eave, {hi} at the ridge");
  assert(hi - lo >= 3, "and by more than a rounding: {hi - lo} units");
}

fn test_a_steeper_pitch_makes_a_taller_ridge() {
  // The pitch is DERIVED, not a constant: doubling it must move the ridge. A
  // version that ignored its argument would pass every test above.
  a = world();
  b = world();
  f = placed();
  ra = hex_editor::roof_over(a, f, footprint_cells(f), plan_at(f, 0.30), 0);
  rb = hex_editor::roof_over(b, f, footprint_cells(f), plan_at(f, 0.90), 0);
  assert(rb.ak_residual > ra.ak_residual,
         "a steeper pitch rides higher: ridge {ra.ak_residual} at 0.30, {rb.ak_residual} at 0.90");
}

fn test_the_ridge_is_a_line_and_not_a_point() {
  // ⚠ GABLE, NOT CONE — the difference this step exists to make. A cone has ONE
  // highest cell; a ridge has several, in a row. The old `roof_height` was radial
  // about a disc's centre and could only ever produce the first.
  w = roofed();
  f = placed();
  cells = footprint_cells(f);
  hi = 0;
  for r in f.fp_cr - 12..f.fp_cr + 13 {
    for q in f.fp_cq - 12..f.fp_cq + 13 {
      if hexset_get(cells, q, r) { h = roof_at(w, q, r); if h > hi { hi = h; } }
    }
  }
  top = 0;
  for r in f.fp_cr - 12..f.fp_cr + 13 {
    for q in f.fp_cq - 12..f.fp_cq + 13 {
      if hexset_get(cells, q, r) && roof_at(w, q, r) == hi { top = top + 1; }
    }
  }
  assert(top >= 3, "the ridge is a line of cells, got {top} at the top");
}

fn test_a_roof_at_an_unplaceable_facing_is_refused() {
  // The same lattice limit the house has: no `Plan`, no ridge to run along.
  w = world();
  east = hex_editor::pose_footprint(0.0, 0.0, 0.0, W, D);
  before = w.w_tau;
  ack = hex_editor::roof_over(w, east, footprint_cells(east),
                              plan_at(east, hex_editor::ROOF_PITCH_DEFAULT), 0);
  assert(!ack.ak_ok, "no plan, no roof");
  assert(w.w_tau == before, "and nothing written: τ {before} -> {w.w_tau}");
}

// ── S6b: the drawn roof, which is the plan's and not the cells' ─────────────

fn rp() -> RoofPlan {
  hex_editor::roof_plan_of(placed(), (FLOOR + hex_editor::ROOF_EAVE_UP) as float * 0.25,
                           hex_editor::ROOF_PITCH_DEFAULT)
}

fn test_the_eave_is_a_straight_line_at_any_rotation() {
  // ⚠ THE WHOLE OF S6b. The cells give a hex staircase — the S6 picture showed a
  // sawtooth — and the plan gives a line. Checked as a CROSS PRODUCT against the
  // ridge direction, which is zero only if the two eave points and the two ridge
  // ends are all parallel: a sawtooth cannot pass this at any tolerance.
  r = rp();
  ex = hex_editor::roof_point_x(r, 1) - hex_editor::roof_point_x(r, 0);
  ez = hex_editor::roof_point_z(r, 1) - hex_editor::roof_point_z(r, 0);
  rx = hex_editor::roof_point_x(r, 5) - hex_editor::roof_point_x(r, 4);
  rz = hex_editor::roof_point_z(r, 5) - hex_editor::roof_point_z(r, 4);
  cr = ex * rz - ez * rx;
  if cr < 0.0 { cr = 0.0 - cr; }
  assert(cr < 0.000000001, "the eave runs parallel to the ridge, cross {cr}");
  fx = hex_editor::roof_point_x(r, 3) - hex_editor::roof_point_x(r, 2);
  fz = hex_editor::roof_point_z(r, 3) - hex_editor::roof_point_z(r, 2);
  cr2 = fx * rz - fz * rx;
  if cr2 < 0.0 { cr2 = 0.0 - cr2; }
  assert(cr2 < 0.000000001, "and so does the far eave, cross {cr2}");
}

fn test_both_eaves_sit_at_the_eave_height_and_the_ridge_above_them() {
  r = rp();
  for i in 0..4 {
    assert(hex_editor::roof_point_y(r, i) == r.rp_eave,
           "point {i} is on the eave, got {hex_editor::roof_point_y(r, i)}");
  }
  assert(hex_editor::roof_point_y(r, 4) > r.rp_eave, "the ridge stands above it");
  assert(hex_editor::roof_point_y(r, 4) == hex_editor::roof_point_y(r, 5),
         "and it is level end to end");
}

fn test_the_ridge_sits_over_the_middle_of_the_span() {
  // A ridge off-centre is a lean-to, not a gable: each ridge end must be exactly
  // halfway between the two eaves it spans.
  r = rp();
  mx = (hex_editor::roof_point_x(r, 0) + hex_editor::roof_point_x(r, 2)) * 0.5;
  mz = (hex_editor::roof_point_z(r, 0) + hex_editor::roof_point_z(r, 2)) * 0.5;
  dx = hex_editor::roof_point_x(r, 4) - mx;
  dz = hex_editor::roof_point_z(r, 4) - mz;
  d = dx * dx + dz * dz;
  assert(d < 0.000000001, "the ridge end is centred between the eaves, off by {d}");
}

fn test_the_drawn_ridge_and_the_stored_ridge_are_the_same_height() {
  // ⚠ TWO DERIVATIONS OF ONE SHAPE IS THE FAILURE THIS TREE KEEPS FINDING. The
  // cells carry the heights the walk and the camera read; the plan carries the
  // surface the eye sees. If they disagree the character walks through its own
  // roof, so they take the rise from the same `pitch * hd`.
  w = world();
  f = placed();
  ack = hex_editor::roof_over(w, f, footprint_cells(f),
                              plan_at(f, hex_editor::ROOF_PITCH_DEFAULT), 0);
  stored = ack.ak_residual;                       // the ridge, in height units
  drawn = (hex_editor::roof_ridge_y(rp()) / 0.25 ?? 0.0) as integer;
  d = stored - drawn;
  if d < 0 { d = 0 - d; }
  assert(d <= 1, "stored ridge {stored}, drawn ridge {drawn} — one unit of rounding at most");
}
