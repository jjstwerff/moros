// A STROKE LAYS A PLANE, NOT A PLATE — plan 20, open question 5.
//
// `road_lay` writes every cell of its disc at `h + round((w - p) . g)`, with `p` the
// author's cell, `w` the cell's own world position and `g` the run's gradient in height
// units per world unit. These pin the two claims that buys, and the one it must not
// break.
//
// ⚠ WHY IT EXISTS. A disc of ONE grade laid over ground that varies flattens it, and a
// cell keeps whichever stroke covered it LAST — a neighbour's height, not its own. That
// displaced **75 units** of fill over a 43-cell run with nothing settled and nothing
// balanced (`probe/house/conserve.loft`), and it is the fall-line canyon's actual cause,
// reached only after the envelope and the per-stroke balance had each been built and
// refuted.
//
// ⚠ AND EVERY ROW HERE HAS ITS CONTROL IN THE SAME FUNCTION, laid on the same ground
// with `g = 0`. Without that, a row asserting *the road is on the ground* would pass on
// any fixture whose ground happens not to move, and this whole file would be measuring
// a flat world.
use hex_editor;
use hex_voxel;
const U   = 0.25;
const G   = 400;
const EPS = 10;

// `n` cells of ground falling `k` a hex along +q. ⚠ `k` of 1 is exactly a road's own
// limit and `stroke_over_limit` asks `> lim`, so nothing settles on these fixtures and
// what they measure is the STAMP alone.
fn ramp(k: integer) -> VoxelWorld {
  w = world_new(U, 0, EPS, 4).wn_world;
  for q in (0 - 6)..20 {
    for r in (0 - 6)..7 { ground_set(w, q, r, G - k * q, SURFACE_MAT); }
  }
  w
}

// The gradient of that ramp, in height units per WORLD unit: one hex of +q is one
// `HEX_LEN` of +x, so the fall per world unit is `-k / HEX_LEN`.
fn ramp_grad(k: integer) -> float {
  0.0 - ((k as float) / hex_grid::HEX_LEN)
}

fn test_a_flat_gradient_is_the_plate_it_always_was() {
  rl_grades = Grades { gr_by: [] };
  // ⚠ THE COMPATIBILITY CLAIM, AND IT IS WHAT LETS EVERY OTHER CALLER PASS ZERO. With
  // no gradient the disc is written at one height, exactly as it was before a plane
  // existed — so a caller with no run to speak of loses nothing.
  w = ramp(1);
  cl = 0;
  rs = 0;
  road_lay(w, 4, 0, 300, 1, 75.0, 0.0, 0.0, cl, rs, rl_grades);
  for d in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(4, 0, d);
    assert(run_h(w, nq, nr, ROAD_MAT) == 300,
           "a flat gradient must write one height, got {run_h(w, nq, nr, ROAD_MAT)} "
           + "at ({nq},{nr})");
  }
  assert(run_h(w, 4, 0, ROAD_MAT) == 300, "and the centre with it");
}

fn test_a_later_stroke_writes_the_height_its_neighbour_already_wrote() {
  rl_grades = Grades { gr_by: [] };
  // ⚠ THE THEOREM, AND IT IS WHAT KILLS THE DISPLACEMENT. When consecutive strokes lie
  // on the run's own gradient, `h_i + (w - p_i).g` does not mention `i` — so the four
  // discs that overlap at `ROAD_HALF` 2 all write the SAME height and a later stroke
  // has nothing left to displace.
  k = 1;
  g = ramp_grad(k);
  a = ramp(k);
  b = ramp(k);
  cl = 0;
  rs = 0;
  road_lay(a, 0, 0, G, 1, 0.0, g, 0.0, cl, rs, rl_grades);
  road_lay(b, 0, 0, G, 1, 0.0, g, 0.0, cl, rs, rl_grades);
  road_lay(b, 1, 0, G - k, 1, 0.0, g, 0.0, cl, rs, rl_grades);
  for j in 0..2 {
    assert(run_h(a, j, 0, ROAD_MAT) == run_h(b, j, 0, ROAD_MAT),
           "cell ({j},0) was written {run_h(a, j, 0, ROAD_MAT)} by its own stroke and "
           + "{run_h(b, j, 0, ROAD_MAT)} once the next one covered it");
  }

  // and the control: the same two strokes with NO gradient must disagree, or the row
  // above is a fixture in which nothing could have moved anyway
  fa = ramp(k);
  fb = ramp(k);
  road_lay(fa, 0, 0, G, 1, 0.0, 0.0, 0.0, cl, rs, rl_grades);
  road_lay(fb, 0, 0, G, 1, 0.0, 0.0, 0.0, cl, rs, rl_grades);
  road_lay(fb, 1, 0, G - k, 1, 0.0, 0.0, 0.0, cl, rs, rl_grades);
  moved = 0;
  for j2 in 0..2 {
    if run_h(fa, j2, 0, ROAD_MAT) != run_h(fb, j2, 0, ROAD_MAT) { moved = moved + 1; }
  }
  assert(moved > 0,
         "the flat control displaced nothing, so this fixture cannot tell a plane "
         + "from a plate and the row above is vacuous");
}

fn test_a_walked_road_sits_on_the_ground_it_was_walked_over() {
  rl_grades = Grades { gr_by: [] };
  // ⚠ THE SINK, AND IT IS FIVE CELLS DEEP RATHER THAN ONE. The grade is read past the
  // strip, and the disc that finally owns a cell TRAILS the author by `rad` — so a
  // cell's effective lookahead is `2 * rad + 1`, and on a ramp the road sank that many
  // cells' worth of grade into ground it could have followed exactly.
  k = 1;
  g = ramp_grad(k);
  w = ramp(k);
  f = ramp(k);
  cl = 0;
  rs = 0;
  for i in 0..12 {
    road_lay(w, i, 0, G - k * i, 1, 0.0, g, 0.0, cl, rs, rl_grades);
    road_lay(f, i, 0, G - k * i, 1, 0.0, 0.0, 0.0, cl, rs, rl_grades);
  }
  // the interior of the run, away from the two ends where the walk simply stopped
  worst = 0;
  fworst = 0;
  for j in 2..10 {
    d = run_h(w, j, 0, ROAD_MAT) - (G - k * j);
    if d < 0 { d = 0 - d; }
    if d > worst { worst = d; }
    fd = run_h(f, j, 0, ROAD_MAT) - (G - k * j);
    if fd < 0 { fd = 0 - fd; }
    if fd > fworst { fworst = fd; }
  }
  assert(worst == 0,
         "a road walked over ground it can follow must end ON it, off by {worst}");
  assert(fworst > 0,
         "the flat control sat exactly on the ground too, so this ramp cannot show a "
         + "sink and the row above proves nothing");
}
