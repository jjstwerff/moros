// AN OCTAGONAL TOWER, AND THE PALETTE IS WHAT SAYS SO — plan 26 `B4l`,
// BLUEPRINT §2.3 and §2.5.
//
// ⛔ **THE ROW THIS FILE RESTS ON IS `the_octagon_and_the_circle_are_different_worlds`,
// AND ITS TWIN IS THE REFUSAL.** A regular octagon sits inside its own circumcircle by
// `1 - cos 22.5° = 7.6%`; on a lattice of roughly unit cells a small enough octagon
// cannot express that and quantises back onto the disk. At seven shells it does, and at
// those shells `body=THICK_OCT` and `body=THICK_CURVED` build the SAME WORLD — with
// every other claim here still true: still centred, still the shell the session holds,
// still eight-sided by construction. That is `B4i`'s row 1 one shape over, and it is
// why the gesture refuses rather than reporting success.
use hex_editor;
use hex_voxel;
use hex_shape;
use hex_form;

const U = 0.25;

fn flat_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - 30, 0 - 30, 61, 61, 8, SURFACE_MAT);
  w
}

// A world with ground AND an edge palette — the two fixtures this step needs at once.
fn typed_world(items: vector<hex_voxel::PalEntry>) -> VoxelWorld {
  w = flat_world();
  code = hex_voxel::world_set_palette(w, hex_voxel::PAL_EDGE, 0, items);
  assert(code == hex_voxel::PAL_OK, "the fixture's palette was refused: code {code}");
  w
}

fn rim_bytes(w: VoxelWorld, mat: integer) -> integer {
  n = 0;
  for r in 0 - 20..21 {
    for q in 0 - 20..21 {
      // The three LATTICE DIRECTIONS a cell owns — `edge_owner`'s table: 4 is NW,
      // 5 is NE, 0 is E. Counting all six would count every edge twice.
      for d in [4, 5, 0] { if wall_of(w, q, r, d, 0.0) == mat { n = n + 1; } }
    }
  }
  n
}

// How many owned edges the two worlds disagree about.
//
// ⛔ **THE COUNT CANNOT SEE THE SHAPE, AND THIS FILE MEASURED THAT BEFORE IT TRUSTED
// IT.** At shell 156 the octagon is **51 cells with a 54-edge rim** and the disk is
// **55 cells with a 54-edge rim** — the same number for two different shapes. A row
// asserting the two counts differ went RED against a gesture that was working, which
// is the good direction for that mistake; asserting they AGREE is how a body that
// never reached the world would have passed. So every comparison here is byte for
// byte over the field, and the count is only ever used to say *something was built*.
fn rim_diff(a: VoxelWorld, b: VoxelWorld) -> integer {
  n = 0;
  for r in 0 - 20..21 {
    for q in 0 - 20..21 {
      for d in [4, 5, 0] {
        if wall_of(a, q, r, d, 0.0) != wall_of(b, q, r, d, 0.0) { n = n + 1; }
      }
    }
  }
  n
}

fn oct_set(shell: integer) -> HexSet {
  pad = tower_pad(shell);
  cells = hexset_chunk(0 - pad, 0 - pad, 2 * pad + 1, 2 * pad + 1);
  oct_fill(0, 0, shell, cells);
  cells
}

fn set_count(s: HexSet) -> integer {
  n = 0;
  for r in hexset_r0(s)..hexset_r0(s) + hexset_h(s) {
    for q in hexset_q0(s)..hexset_q0(s) + hexset_w(s) {
      if hexset_get(s, q, r) { n = n + 1; }
    }
  }
  n
}

// ── THE POLYGON ────────────────────────────────────────────────────────────

fn test_the_polygon_is_eight_distinct_corners_and_strictly_convex() {
  for sh in [156, 324, 468, 1008] {
    vk = oct_poly_k(sh);
    vm = oct_poly_m(sh);
    assert(len(vk) == 8 && len(vm) == 8,
           "shell {sh} gave {len(vk)}/{len(vm)} corners, not eight");
    for i in 0..8 {
      for j in i + 1..8 {
        assert(!((vk[i] ?? 0) == (vk[j] ?? 0) && (vm[i] ?? 0) == (vm[j] ?? 0)),
               "shell {sh} corners {i} and {j} are the same lattice point "
             + "({vk[i] ?? 0},{vm[i] ?? 0}) — a side has vanished and this is a "
             + "septagon wearing eight vertices");
      }
    }
    // ⚠ **STRICT, SO A COLLINEAR TRIPLE IS A FAILURE.** Three corners on one line is
    // a side that quantised away, and `poly_holds` would still answer confidently
    // about the seven-sided shape that remains.
    for c in 0..8 {
      ak = vk[c] ?? 0;         am = vm[c] ?? 0;
      bk = vk[(c + 1) % 8] ?? 0;  bm = vm[(c + 1) % 8] ?? 0;
      ck = vk[(c + 2) % 8] ?? 0;  cm = vm[(c + 2) % 8] ?? 0;
      crs = (bk - ak) * (cm - am) - (bm - am) * (ck - ak);
      assert(crs > 0,
             "shell {sh} turns the wrong way or not at all at corner {c} "
           + "(cross {crs}) — the polygon is not a convex anticlockwise octagon");
    }
  }
}

// ⚠ **THE MIRRORS ARE THE LATTICE'S OWN, AND ROUNDING EIGHT CORNERS SEPARATELY WOULD
// LEAVE THEM TO LUCK.** A tower lopsided by one lattice step in one quadrant is
// exactly what a picture cannot show and what no other row here would name.
fn test_the_corners_are_mirrored_in_both_axes() {
  for sh in [156, 468, 876] {
    vk = oct_poly_k(sh);
    vm = oct_poly_m(sh);
    for i in 0..4 {
      assert((vk[7 - i] ?? 0) == (vk[i] ?? 0) && (vm[7 - i] ?? 0) == 0 - (vm[i] ?? 0),
             "shell {sh} corner {i} has no mirror in the k axis");
      assert((vk[3 - i] ?? 0) == 0 - (vk[i] ?? 0) && (vm[3 - i] ?? 0) == (vm[i] ?? 0),
             "shell {sh} corner {i} has no mirror in the m axis");
    }
  }
}

// The octagon is SMALLER than the disk it is named after, at every shell.
//
// ⚠ Both halves matter: *fewer cells* alone is true of the empty set, so the rim has
// to be inside the window `tower_pad` sized for the disk as well — which is the same
// guarantee `tower_ring` leans on when it asks `tower_clipped`.
fn test_the_octagon_is_smaller_than_its_own_shell_s_disc() {
  for sh in [156, 324, 468, 876] {
    o = oct_set(sh);
    pad = tower_pad(sh);
    d = hexset_chunk(0 - pad, 0 - pad, 2 * pad + 1, 2 * pad + 1);
    hex_shape::arc_fill(0, 0, sh, d);
    assert(set_count(o) > 0, "shell {sh} built an empty octagon");
    assert(set_count(o) < set_count(d),
           "shell {sh}: the octagon has {set_count(o)} cells and the disk "
         + "{set_count(d)} — an octagon that is not smaller is the disk");
    assert(!tower_clipped(o),
           "shell {sh}: the octagon reaches the border of the window `tower_pad` "
         + "sized for the disk, so a clipped rim would read back as a whole one");
  }
}

// ⚠ **"INSCRIBED" IS APPROXIMATE, AND THE APPROXIMATION ROUNDS OUTWARD.** A corner
// goes to the NEAREST lattice point, which can be further from the centre than the
// circumcircle it came from: measured over every shell to 1008, **324 and 576 each
// put four cells outside the disk of their own shell**, and at both the octagon's
// outermost shell is the next one up (336, 588). Everywhere else it is inside.
//
// ⚠ **THE ROW EXISTS BECAUSE THE OBVIOUS ASSERTION IS FALSE.** The first version of
// this file claimed every octagon cell is one of the disk's, and shell 324 refuted
// it — so the number that bounds the shape is the NEXT shell, never its own.
fn test_a_rounded_corner_can_reach_past_the_circumcircle() {
  outside = 0;
  for sh in [324, 576] {
    o = oct_set(sh);
    for r in hexset_r0(o)..hexset_r0(o) + hexset_h(o) {
      for q in hexset_q0(o)..hexset_q0(o) + hexset_w(o) {
        if hexset_get(o, q, r)
           && vec_n2_4(lattice_k(q, r), lattice_m(q, r)) > sh { outside = outside + 1; }
      }
    }
  }
  assert(outside == 8,
         "{outside} cells lie outside the circumcircle at shells 324 and 576, not the "
       + "eight measured — the corner quantisation has moved");

  // …and the bound that is exact: the octagon never reaches past the NEXT shell up.
  for sh in hex_shape::arc_shells_upto(TOWER_SHELL_MAX) {
    if sh < 12 { continue; }
    nxt = sh;
    for c in hex_shape::arc_shells_upto(TOWER_SHELL_MAX) {
      if c > sh && (nxt == sh || c < nxt) { nxt = c; }
    }
    reach = hex_shape::arc_shell_max(oct_set(sh), 0, 0);
    assert(reach <= nxt,
           "shell {sh}: the octagon reaches shell {reach}, past the next shell up "
         + "({nxt}) — `tower_pad` is sized for the disk and would clip it");
  }
}

// ⚠ **AN OCTAGON'S SIZE IS QUANTISED MORE COARSELY THAN THE SHELL GRID IT IS CHOSEN
// FROM**, which is `@HB-X49`'s answer for a radius one shape over — *"161 radii
// collapse to four fields, so only the SHELL comes back."* Measured here: 324 and 336
// are ONE octagon, and so are 432/444, 576/588 and 768/804.
fn test_two_shells_can_name_one_octagon() {
  for pair in [[324, 336], [576, 588], [768, 804]] {
    a = pair[0] ?? 0;
    b = pair[1] ?? 0;
    assert(a != b, "the fixture pairs a shell with itself");
    assert(set_count(oct_set(a)) == set_count(oct_set(b)),
           "shells {a} and {b} give {set_count(oct_set(a))} and "
         + "{set_count(oct_set(b))} cells — this pair no longer collapses, so the "
         + "corner quantisation has changed and the finding above is stale");
  }
  // …and the control: two shells far enough apart do NOT collapse, or the row above
  // would pass for a construction that ignored its argument.
  assert(set_count(oct_set(156)) != set_count(oct_set(468)),
         "shells 156 and 468 give the same octagon — `oct_fill` is not reading the "
       + "shell at all");
}

// ── THE REFUSAL ────────────────────────────────────────────────────────────

// ⛔ **THE SEVEN, ENUMERATED.** Nothing in the construction predicts this list — it is
// measured, and it is NOT MONOTONIC: 108 separates while 144 above it collapses, which
// is `B0p`'s own finding about octagons at a different instrument. So a threshold would
// be a guess where the library's own `arc_is_disk` is an answer.
fn test_exactly_seven_shells_quantise_back_onto_the_disk() {
  bad: vector<integer> = [];
  for sh in hex_shape::arc_shells_upto(TOWER_SHELL_MAX) {
    if sh >= 12 && oct_is_disc(sh, tower_pad(sh)) { bad += [sh]; }
  }
  want = [12, 48, 144, 192, 300, 432, 444];
  assert(len(bad) == len(want),
         "{len(bad)} shells collapse onto the disk, not {len(want)}: {bad}");
  for i in 0..len(want) {
    assert((bad[i] ?? 0) == (want[i] ?? 0),
           "the collapsing shells are {bad} against the measured {want}");
  }
}

fn test_a_collapsing_shell_is_refused_with_the_next_one_up() {
  f = fit_oct_shell(192);
  assert(!f.ft_ok, "shell 192's octagon was accepted — it IS the disk of some shell");
  assert(f.ft_offer == 228,
         "the offer is {f.ft_offer}, not the next shell up whose octagon separates");
  assert(f.ft_reason.contains("192"),
         "the refusal does not name the shell asked for: {f.ft_reason}");

  g = fit_oct_shell(444);
  assert(!g.ft_ok && g.ft_offer == 468,
         "shell 444 offers {g.ft_offer}: {g.ft_reason}");
}

// The control the row above needs: a shell that separates is ACCEPTED, or the refusal
// would be a function that says no to everything.
fn test_a_separating_shell_is_accepted() {
  for sh in [36, 156, 468, 876] {
    assert(fit_oct_shell(sh).ft_ok, "shell {sh} was refused for an octagon");
  }
}

// ⚠ **THE SHELL CHECK COMES FIRST**, because *this is no shell at all* and *this shell
// cannot hold an octagon* are two different things to be told.
fn test_a_number_naming_no_shell_is_refused_as_a_non_shell() {
  f = fit_oct_shell(40);
  assert(!f.ft_ok, "40 was accepted as an octagon's shell");
  assert(f.ft_reason.contains("is not a shell"),
         "40 was refused as an octagon rather than as a non-shell: {f.ft_reason}");
}

// ── THE GESTURE ────────────────────────────────────────────────────────────

fn oct_world() -> VoxelWorld {
  typed_world([hex_voxel::PalEntry { pl_slot: 5, pl_name: "octtower body={WALL_BODY_OCT}" }])
}

fn build_tower(w: VoxelWorld, slot: integer, shell: integer) -> Ack {
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  assert(session_select_wall(s, slot).ak_ok, "slot {slot} was refused");
  assert(session_select_shell(s, shell).ak_ok, "shell {shell} was refused");
  press_verb(s, w, s.es_author, VB_TOWER, "")
}

// ⛔ **THE ROW THE STEP RESTS ON.** If the octagon ever quantised onto the disk at this
// shell, every other row in this file would still pass — it would still be centred,
// still the chosen shell, still carrying the chosen type. Only a comparison of the two
// worlds can see it.
fn test_the_octagon_and_the_circle_are_different_worlds_at_one_shell() {
  ow = oct_world();
  assert(build_tower(ow, 5, TOWER_SHELL_DEFAULT).ak_ok, "the octagon was refused");

  // The same slot, the same shell, in a world that declares the CURVED body instead.
  cw = typed_world([hex_voxel::PalEntry { pl_slot: 5, pl_name: "roundtower body=THICK_CURVED" }]);
  assert(build_tower(cw, 5, TOWER_SHELL_DEFAULT).ak_ok, "the circle was refused");

  assert(rim_bytes(ow, 5) > 0 && rim_bytes(cw, 5) > 0,
         "one of the two towers stamped nothing");
  assert(rim_diff(ow, cw) > 0,
         "the octagon and the circle key the same world at shell "
       + "{TOWER_SHELL_DEFAULT} — the body reached the sentence and not the world, or "
       + "this shell is one of the seven the fit is supposed to refuse");

  // ⛔ **AND THE COUNT IS BLIND TO IT, WHICH IS WHY THIS ROW READS THE FIELD.** The
  // two rims are **{rim_bytes(ow, 5)} and {rim_bytes(cw, 5)} edges** at this shell —
  // equal, over 51 cells against 55. A row comparing counts would have called a
  // working gesture broken here, and would have called a body that never reached the
  // world correct at some other shell.
  assert(rim_bytes(ow, 5) == rim_bytes(cw, 5),
         "the two rims are {rim_bytes(ow, 5)} and {rim_bytes(cw, 5)} edges — they no "
       + "longer coincide at shell {TOWER_SHELL_DEFAULT}, so the note above about a "
       + "count being blind here is stale and should be re-measured, not deleted");
}

// ⚠ **AND IT IS NOT A DISK**, which is the half a count cannot show: two different
// counts could still both be circles.
fn test_what_the_octagon_verb_builds_is_refused_as_a_disc() {
  w = oct_world();
  assert(build_tower(w, 5, TOWER_SHELL_DEFAULT).ak_ok, "the octagon was refused");
  d = disc_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(!d.dc_ok,
         "the octagon reads back as the disc of shell {d.dc_shell} — the author asked "
       + "for eight sides and the store holds a circle");
}

// ⚠ **THE OPEN VOCABULARY, TWICE.** `@HB-X69` calls the palette the designed extension
// point and `walltype.loft` carries `wt_body` as text for exactly that reason, so a
// body this tree does not know must be CARRIED and must not change the shape.
fn test_a_body_this_tree_does_not_know_still_builds_the_circle() {
  uw = typed_world([hex_voxel::PalEntry { pl_slot: 5, pl_name: "future body=THICK_MYSTERY" }]);
  ak = build_tower(uw, 5, TOWER_SHELL_DEFAULT);
  assert(ak.ak_ok, "an unknown body was refused outright: {ak.ak_why}");

  // …and it is the same world an undeclared slot builds, which is what makes it the
  // CIRCLE rather than merely *not the octagon*.
  pw = flat_world();
  assert(build_tower(pw, 5, TOWER_SHELL_DEFAULT).ak_ok, "the plain tower was refused");
  assert(rim_diff(uw, pw) == 0,
         "an unknown body keys a world {rim_diff(uw, pw)} edges away from the plain "
       + "one — a body nobody declared changed the shape");
}

// ⚠ **A DAMAGED DECLARATION BUILDS THE CIRCLE RATHER THAN NOTHING**, which is
// `wall_half`'s rule at a second geometry site: a gesture that refused would leave the
// author with no tower and a palette to debug, and the loud instrument is the plan
// view, which paints an unreadable type magenta and counts it.
fn test_a_damaged_declaration_builds_the_circle() {
  dw = typed_world([hex_voxel::PalEntry { pl_slot: 5,
                                          pl_name: "broken body={WALL_BODY_OCT} thick=fat" }]);
  assert(!wall_type(dw, 0, 5).wt_ok, "the fixture is not damaged after all");
  assert(build_tower(dw, 5, TOWER_SHELL_DEFAULT).ak_ok, "a damaged type built nothing");

  pw = flat_world();
  assert(build_tower(pw, 5, TOWER_SHELL_DEFAULT).ak_ok, "the plain tower was refused");
  assert(rim_diff(dw, pw) == 0,
         "a damaged octagon declaration keys a world {rim_diff(dw, pw)} edges away "
       + "from the circle's");
}

// ⚠ **REFUSED WITHOUT MOVING THE CHOICE**, and with nothing written — `B4i`'s rule for
// a selection that cannot be honoured.
fn test_a_collapsing_shell_refuses_the_gesture_and_writes_nothing() {
  w = oct_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  assert(session_select_wall(s, 5).ak_ok, "slot 5 refused");
  assert(session_select_shell(s, 192).ak_ok, "shell 192 refused as a shell");
  ak = press_verb(s, w, s.es_author, VB_TOWER, "");
  assert(!ak.ak_ok, "shell 192's octagon was built — it is the disk of some shell");
  assert(ak.ak_why.contains("228"),
         "the refusal carries no offer: {ak.ak_why}");
  assert(rim_bytes(w, 5) == 0,
         "a refused octagon still stamped {rim_bytes(w, 5)} edges");
  assert(session_shell(s) == 192,
         "the refusal moved the standing choice to {session_shell(s)}");
}

// ⚠ **AND THE ROUND TOWER IS UNMOVED BY ALL OF IT.** Both shapes now share one
// boundary walk; a world with no palette at all must key exactly what it always did,
// which is the upper bound of this step.
fn test_a_world_with_no_palette_still_builds_the_round_tower() {
  w = flat_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the tower was refused");
  d = disc_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(d.dc_ok && d.dc_shell == TOWER_SHELL_DEFAULT,
         "the default tower reads {d.dc_shell}: {d.dc_why}");
}

// ── `B4m` — THE DESCRIPTION, AND WHICH READER THE PALETTE ASKS ──────────────
//
// ⛔ **§2.5: *an octagon tower is never deduced; it is stored*.** The rows below are
// that sentence made testable from both ends — the field fixes the centre and the
// shell, and nothing in the field is allowed to decide the SHAPE.

fn oct_only_world(shell: integer) -> VoxelWorld {
  w = oct_world();
  assert(build_tower(w, 5, shell).ak_ok, "the octagon at shell {shell} was refused");
  w
}

fn test_the_octagon_recovers_to_its_own_centre_and_shell() {
  for sh in [156, 468] {
    w = oct_only_world(sh);
    o = oct_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
    assert(o.ot_ok, "the octagon at shell {sh} was not recovered: {o.ot_why}");
    assert(o.ot_cq == 0 && o.ot_cr == 0,
           "shell {sh} recovered its centre as {o.ot_cq},{o.ot_cr}");
    assert(o.ot_shell == sh,
           "shell {sh} recovered as {o.ot_shell} — the field fixes the parameter and "
         + "this one came back wrong");
    assert(o.ot_marks > 0, "the recovery accounts for no marks");
  }
}

// …and off the origin, or the row above would pass for a reader that answers `0,0`.
fn test_the_centre_is_recovered_and_not_assumed() {
  w = oct_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  assert(session_select_wall(s, 5).ak_ok, "slot 5 refused");
  assert(session_select_shell(s, 156).ak_ok, "shell 156 refused");
  // three cells east and two rows down, in world units.
  // ⚠ `session_at` is `(x, z, yaw)` — NOT `(x, y, z)`. The first version of this row
  // passed a `y` and the tower landed at 3,0 with a yaw of 3.0 radians; the recovery
  // reported 3,0, which was the truth about a fixture that had moved the wrong axis.
  (ax, az) = hex_to_px(3, 2);
  session_at(s, w, ax, az, 0.0);
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the octagon was refused");
  o = oct_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
  assert(o.ot_ok && o.ot_cq == 3 && o.ot_cr == 2,
         "an octagon centred at 3,2 recovered as {o.ot_cq},{o.ot_cr}: {o.ot_why}");
}

// ⛔ **THE ROW THE PALETTE EXISTS FOR.** A disc is not an octagon and an octagon is not
// a disc — at every shell the gesture admits, because `fit_oct_shell` refuses the seven
// where the two fields coincide. So asking the WRONG reader gives a refusal rather than
// a confident wrong shape, and that is measured here rather than relied on.
fn test_each_reader_refuses_the_other_shape() {
  ow = oct_only_world(156);
  assert(!disc_recover(ow, 0 - 20, 0 - 20, 41, 41, 0.0).dc_ok,
         "the disc reader described an octagon — this is `rebuild_construct`'s "
       + "confident hexagon at our own instrument");

  cw = flat_world();
  cs = EditSession {};
  session_at(cs, cw, 0.0, 0.0, 0.0);
  assert(session_select_shell(cs, 156).ak_ok, "shell 156 refused");
  assert(press_verb(cs, cw, cs.es_author, VB_TOWER, "").ak_ok, "the circle was refused");
  assert(disc_recover(cw, 0 - 20, 0 - 20, 41, 41, 0.0).dc_ok,
         "the fixture's circle is not a disc — nothing below can be trusted");
  assert(!oct_recover(cw, 0 - 20, 0 - 20, 41, 41, 0.0).ot_ok,
         "the octagon reader described a circle");
}

// ⚠ **A GAPPED RIM IS REFUSED**, which is `B4h`'s control one shape over: a generate-
// and-compare reader must answer *no* to a field that is nearly its shape, or it is a
// fit wearing an exact answer's clothes.
fn test_a_rim_with_one_edge_missing_is_refused() {
  w = oct_only_world(156);
  o = oct_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
  assert(o.ot_ok, "the fixture's octagon was not recovered to begin with");
  // rub out exactly one marked edge
  rubbed = false;
  for r in 0 - 20..21 {
    for q in 0 - 20..21 {
      for d in [4, 5, 0] {
        if rubbed { continue; }
        if edge_is_wall(wall_of(w, q, r, d, 0.0)) {
          wall_set(w, q, r, d, 0, terrain_h(q, r, w), 0.0);
          rubbed = true;
        }
      }
    }
  }
  assert(rubbed, "the fixture had no edge to rub out");
  g = oct_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
  assert(!g.ot_ok, "an octagon with one edge missing was described anyway");
  assert(g.ot_marks > 0,
         "the refusal reports {g.ot_marks} marks — *nothing here* and *marks I could "
       + "not explain* are different facts");
}

// ── WHICH READER GETS ASKED ────────────────────────────────────────────────

fn test_the_body_of_the_marks_is_what_the_picture_reads() {
  ow = oct_only_world(156);
  assert(marks_body(ow, 0 - 20, 0 - 20, 41, 41, 0.0) == WALL_BODY_OCT,
         "an octagon world's marks read body "
       + "'{marks_body(ow, 0 - 20, 0 - 20, 41, 41, 0.0)}'");

  pw = flat_world();
  ps = EditSession {};
  session_at(ps, pw, 0.0, 0.0, 0.0);
  assert(press_verb(ps, pw, ps.es_author, VB_TOWER, "").ak_ok, "the circle was refused");
  assert(marks_body(pw, 0 - 20, 0 - 20, 41, 41, 0.0) == "",
         "an undeclared world's marks claim a body");
}

// ⚠ **A WINDOW WHOSE MARKS DISAGREE HAS NO BODY, AND THAT IS NOT A SHAPE CLAIM** — it
// is the honest report that the window is not one structure, which is the same silence
// `wall_read_run` gives a window holding two walls.
fn test_two_bodies_in_one_window_answer_neither() {
  w = typed_world([hex_voxel::PalEntry { pl_slot: 5, pl_name: "octtower body={WALL_BODY_OCT}" },
                   hex_voxel::PalEntry { pl_slot: 6, pl_name: "roundtower body=THICK_CURVED" }]);
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  assert(session_select_shell(s, 156).ak_ok, "shell 156 refused");
  assert(session_select_wall(s, 5).ak_ok, "slot 5 refused");
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the octagon was refused");
  (bx, bz) = hex_to_px(16, 0);
  session_at(s, w, bx, 0.0, bz);
  assert(session_select_wall(s, 6).ak_ok, "slot 6 refused");
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the circle was refused");

  assert(marks_body(w, 0 - 20, 0 - 20, 41, 41, 0.0) == "",
         "two bodies in one window answered "
       + "'{marks_body(w, 0 - 20, 0 - 20, 41, 41, 0.0)}'");
  // …and the control: either one ALONE still names its own body, so the row above is
  // about disagreement and not about the reader having stopped working.
  assert(marks_body(w, 0 - 20, 0 - 20, 21, 41, 0.0) == WALL_BODY_OCT,
         "the octagon's own half of the window reads "
       + "'{marks_body(w, 0 - 20, 0 - 20, 21, 41, 0.0)}'");
}

// ── THE CORNERS THE PICTURE DRAWS ──────────────────────────────────────────
//
// ⚠ **THE OUTLINE MUST LIE ON THE FIELD IT CAME FROM**, which is `B4h`'s band check one
// shape over: a description drawn beside its marks rather than over them is the failure
// this pairing exists to show, and no count would name it.
fn test_the_drawn_corners_sit_within_the_rim_they_describe() {
  w = oct_only_world(468);
  o = oct_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
  assert(o.ot_ok, "the fixture was not recovered: {o.ot_why}");
  xs = oct_px_x(o.ot_cq, o.ot_cr, o.ot_shell);
  zs = oct_px_z(o.ot_cq, o.ot_cr, o.ot_shell);
  assert(len(xs) == 8 && len(zs) == 8,
         "the picture is handed {len(xs)}/{len(zs)} corners, not eight");
  // the octagon's circumradius is `√N / 2`; every corner must sit within one lattice
  // step of it, which is all the quantisation can move a corner.
  rad = (sqrt(o.ot_shell as float) ?? 0.0) * 0.5;
  for i in 0..8 {
    dx = (xs[i] ?? 0.0) - o.ot_x;
    dz = (zs[i] ?? 0.0) - o.ot_z;
    d = sqrt(dx * dx + dz * dz) ?? 0.0;
    off = d - rad;
    if off < 0.0 { off = 0.0 - off; }
    assert(off < 0.5,
           "corner {i} sits {off} from the circumradius {rad} — further than a lattice "
         + "step, so the drawn outline is not the shape the field holds");
  }
}

// ⚠ **A CANDIDATE TOO BIG FOR ITS MARKS MUST BE REFUSED**, which is what the two-cell
// margin round the comparison box is for: such a shape has no boundary inside the box
// at all, so `want` is false where a mark is true. Without the margin the claim would
// rest on the window happening to be generous.
fn test_an_octagon_larger_than_its_marks_is_refused() {
  w = oct_only_world(156);
  o = oct_recover(w, 0 - 20, 0 - 20, 41, 41, 0.0);
  assert(o.ot_ok && o.ot_shell == 156, "the fixture was not recovered: {o.ot_why}");
  assert(!oct_fits_at(w, 0 - 20, 0 - 20, 41, 41, 0, 0, 468, 0.0),
         "shell 468's octagon was accepted for shell 156's marks");
  // …and the control: the shell that DID answer still does through the same door.
  assert(oct_fits_at(w, 0 - 20, 0 - 20, 41, 41, 0, 0, 156, 0.0),
         "shell 156's own octagon is refused by the direct check — the instrument is "
       + "broken and the row above says nothing");
}

// ⛔ **THE ROW THIS WHOLE STEP RESTS ON: A DISK AND AN OCTAGON ARE THE SAME FIELD AT
// FOUR SIZES**, so the field cannot tell them apart and the palette is the only thing
// that can. Measured over every shell to 1008:
//
//     disc 108 == octagon 144      disc 252 == octagon 300
//     disc 156 == octagon 192      disc 372 == octagon 432
//
// …plus 12 and 48, where the two coincide outright. The right-hand column is exactly
// the shells `fit_oct_shell` refuses — the same fact from the other side — which is
// why restricting the READER to the gesture's admitted set is what separates them.
fn test_a_disc_and_an_octagon_are_one_field_at_four_sizes() {
  for pair in [[108, 144], [156, 192], [252, 300], [372, 432]] {
    dn = pair[0] ?? 0;
    on = pair[1] ?? 0;
    w = flat_world();
    s = EditSession {};
    session_at(s, w, 0.0, 0.0, 0.0);
    assert(session_select_shell(s, dn).ak_ok, "shell {dn} refused");
    assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the circle was refused");

    // the GEOMETRY agrees, exactly…
    assert(oct_fits_at(w, 0 - 24, 0 - 24, 49, 49, 0, 0, on, 0.0),
           "the octagon of shell {on} does not reproduce the disk of {dn} — the "
         + "coincidence this step is built around no longer holds");
    // …and the ADMITTED SET is what separates them: `on` is a shell the gesture
    // refuses, so no octagon was ever authored there and the reader will not offer it.
    assert(!fit_oct_shell(on).ft_ok,
           "shell {on} is admissible for an octagon after all");
    assert(!oct_recover(w, 0 - 24, 0 - 24, 49, 49, 0.0).ot_ok,
           "the octagon reader described the disk of shell {dn} as the octagon of "
         + "{on} — a shape no gesture in this editor can build");
  }
}
