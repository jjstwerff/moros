// W4 — WHAT A KEY MEANS, IN ONE PLACE.
//
// plan 22 `W4`. Before this, four sites decided what a key does and omitting one
// was silent. These tests pin the two claims that make `press` worth having: the
// same key does the same thing wherever it is pressed, and a key that is NOT a
// gesture is answered as such rather than as a refusal.
use hex_editor;
use hex_voxel;
use hex_grid;

fn ground(gw: VoxelWorld, half: integer) {
  for gq in 0 - half..half + 1 {
    for gr in 0 - half..half + 1 {
      ground_set(gw, gq, gr, 0, SURFACE_MAT);
    }
  }
}

fn flat() -> VoxelWorld {
  fw = world_new(0.25, W_RESERVE, 8, 3).wn_world;
  ground(fw, 20);
  fw
}

// ⚠ THE DIVERGENCE THIS STEP EXISTS TO CLOSE, AS A TEST.
//
// `src/editor_run.loft` took the house's grade from `ground_h(w, 0, 0)` — the
// ORIGIN — while `src/editor_server.loft` took it from under the author's feet.
// On flat ground at the origin the two agree, which is every fixture anybody had
// looked at; the moment the author stands on a slope away from the origin they do
// not, and the same script builds a house at a different height depending on which
// program ran it.
//
// So the claim is about `grade_under`, and it is asserted where it can FAIL: on a
// raised patch, away from the origin.
fn test_the_grade_is_taken_under_the_author_not_at_the_origin() {
  w = flat();
  // A shelf, well away from (0,0).
  for sq in 8..14 {
    for sr in 8..14 {
      ground_set(w, sq, sr, 9, SURFACE_MAT);
    }
  }
  origin_h = ground_h(w, 0, 0);
  shelf_h  = ground_h(w, 11, 11);
  assert(origin_h != shelf_h,
         "the fixture is flat under both — this test cannot see the difference "
         + "it exists for (origin {origin_h}, shelf {shelf_h})");

  (ax, az) = hex_to_px(11, 11);
  a = author_on(w, ax, az, 0.0);
  assert(grade_under(w, a) == shelf_h,
         "grade_under answered {grade_under(w, a)} for an author standing on a "
         + "shelf at {shelf_h} — it is not reading the ground under the author");
  assert(grade_under(w, a) != origin_h,
         "grade_under answered the ORIGIN's height — this is editor_run's bug, "
         + "moved into the library rather than fixed");
}

// A key nobody mapped is not a refusal. `ak_ok == false` is how a gesture says
// "too steep" or "no wall there"; a caller that cannot tell that from "this is a
// walk key" reports one as the other, which is how a runner came to print
// "no gesture for key W" for every step of a walk.
fn test_an_unmapped_key_is_named_rather_than_refused() {
  w = flat();
  sess = EditSession {};
  a = author_on(w, 0.0, 0.0, 0.0);
  for k in ["W", "A", "S", "D", "", "ArrowLeft", "zzz"] {
    ack = press(sess, w, a, k);
    assert(ack.ak_why == PR_NONE,
           "key '{k}' is not a gesture but press answered '{ack.ak_why}'");
  }
}

// …and a real gesture must NOT answer PR_NONE, or the discriminator above passes
// by refusing everything.
//
// ⚠ `O` AND `P` STAY ON THIS LIST AFTER `R3`, and that is the point of the third
// answer. They are gestures the editor HAS and has not bound yet, so they answer
// `PR_SELECT` — a refusal with a reason — rather than *not a gesture*. Moving them
// to the list above would have said the editor cannot cut an opening at all, which
// is false: the wire cuts one on every `36:`.
fn test_every_mapped_key_is_reachable() {
  w = flat();
  sess = EditSession {};
  a = author_on(w, 0.0, 0.0, 0.0);
  for k in ["ArrowUp", "ArrowDown", "H", "O", "P", "F", "G"] {
    ack = press(sess, w, a, k);
    assert(ack.ak_why != PR_NONE,
           "key '{k}' is meant to be a gesture and press did not recognise it");
  }
}

// ⚠ THE POINT OF THE WHOLE STEP, STATED AS AN EQUALITY: pressing the key and
// calling the gesture by hand must produce the same world. If they ever diverge,
// `press` has become a fifth site rather than the only one.
fn test_pressing_the_house_key_is_calling_place_house() {
  by_key = flat();
  by_hand = flat();
  ks = EditSession {};
  hs = EditSession {};
  // ⚠ 30° IS NOT DECORATION — only 6 of the lattice's 12 facings have mitred
  // corners, and yaw 0 here lands on an odd one: the gesture refuses with
  // "rot 9 of 12, offer 8". `tools/scripts/house.keys` stands at 30° for exactly
  // this reason, and a test that did not would be measuring the doorstep.
  (ax, az) = hex_to_px(6, 6);
  // ⚠ ONE POSE PER WORLD, and they must agree: `author_on` reads the ground, so a
  // pose taken from one world and used on the other would be comparing two setups
  // rather than two paths. Both fixtures are `flat()`, so these are equal by
  // construction — and the assertion below would catch it if they ever were not.
  ka_pose = author_on(by_key, ax, az, 30.0 * PI / 180.0 ?? 0.0);
  ha_pose = author_on(by_hand, ax, az, 30.0 * PI / 180.0 ?? 0.0);
  assert(ka_pose.au_y == ha_pose.au_y, "the two fixtures do not share a ground height");

  ka = press(ks, by_key, ka_pose, "H");
  ha = place_house(by_hand, ha_pose, HOUSE_W, HOUSE_D, grade_under(by_hand, ha_pose), hs.es_runs);

  assert(ka.ak_ok == ha.ak_ok, "one placed a house and the other did not");
  assert(ka.ak_ok, "the fixture refused the house: {ka.ak_why}");
  // ⚠ THE EDIT CLOCK IS THE INSTRUMENT, not a cell count. It is exact, it is the
  // same on any box, and it counts writes that CHANGED something — so two worlds
  // agreeing on tau agree about how much work was done, which a cell total does
  // not (a house rewritten in place has the same cells and a different tau).
  assert(by_key.w_tau == by_hand.w_tau,
         "pressing H did {by_key.w_tau} writes, calling place_house did "
         + "{by_hand.w_tau} — the key means something else now");
  assert(ka.ak_n == ha.ak_n, "the two disagree on how many cells were placed");
}

// ── `R1a` — the pose carries the ground under the feet ──────────────────────
//
// ⚠ WITHOUT THESE, `R1a` WOULD BE A FIELD NOBODY READS — the lower bound of
// plans/README § What makes a step SAFE, and this tree's commonest defect. Nothing
// consumes `au_y` until `R1b`, so the claim it can be surprised by is that the pose
// AGREES WITH THE WORLD it was taken from.
fn test_the_pose_carries_the_ground_under_it() {
  w = flat();
  // A shelf away from the origin, so a pose that answered a constant would be wrong.
  for sq in 8..14 {
    for sr in 8..14 { ground_set(w, sq, sr, 9, SURFACE_MAT); }
  }
  (fx, fz) = hex_to_px(0, 0);
  (sx, sz) = hex_to_px(11, 11);
  low  = author_on(w, fx, fz, 0.0);
  high = author_on(w, sx, sz, 0.0);
  assert(low.au_y != high.au_y,
         "both poses read {low.au_y} — author_on is answering a constant, not the ground");
  // The exact value, in the WORLD's own units rather than a global constant.
  assert(high.au_y == (ground_h(w, 11, 11) as float) * w.w_unit,
         "the shelf pose says {high.au_y}, the store says "
         + "{(ground_h(w, 11, 11) as float) * w.w_unit}");
  assert(low.au_y == 0.0, "the flat pose says {low.au_y}");
}

// ── `R3` — the opening keys, and the material only they could write ─────────

// Every edge of material `mat` this cell and its neighbours OWN, at `ref`.
fn owned_edges(w: VoxelWorld, cq: integer, cr: integer, mat: integer, ref: float) -> integer {
  oe = 0;
  for oq in cq - 3..cq + 4 {
    for orr in cr - 3..cr + 4 {
      for od in 0..6 {
        (ooq, oor, _oslot) = edge_owner(oq, orr, od);
        if ooq == oq && oor == orr && wall_of(w, oq, orr, od, ref) == mat { oe = oe + 1; }
      }
    }
  }
  oe
}

// A cell with one wall edge on it, which is what `open_ahead` looks for.
fn against_a_wall(w: VoxelWorld, a: Author) {
  edge_set(w, a, 0, WALL_MAT, a.au_y, 0);
}

// ⚠ `WINDOW_MAT` HAS EXACTLY ONE WRITER IN THIS TREE, and it is the diverged key.
// The wire's `36:<kind>` always cuts with `DOOR_MAT` — the profile is what varies,
// and it is recorded beside the store rather than in it — so a window material on
// an edge is a world the server cannot produce and no gate can reach. `press`'s `P`
// was the only thing that made one, which is `R2`'s *there is no correct flat
// answer* stated as a byte: the server's axis is a PROFILE and this one is a
// MATERIAL.
fn test_no_key_writes_a_material_the_wire_cannot() {
  (ax, az) = hex_to_px(0, 0);

  // ⚠ THE INSTRUMENT FIRST, AGAINST SOMETHING IT SHOULD FIND. An absence is the
  // easiest thing in the world to report by accident — a counter looking at the
  // wrong layer, the wrong cell or the wrong slot answers 0 for a wall covered in
  // windows. So the same fixture is opened with `WINDOW_MAT` by hand and the count
  // must be 1 before a zero anywhere below is worth anything.
  ctl = flat();
  ctla = author_on(ctl, ax, az, 0.0);
  against_a_wall(ctl, ctla);
  cack = open_ahead(ctl, ctla, WINDOW_MAT, 1);
  assert(cack.ak_ok, "the control could not open its own wall: {cack.ak_why}");
  assert(owned_edges(ctl, 0, 0, WINDOW_MAT, ctla.au_y) == 1,
         "the control cut a window and the counter finds "
         + "{owned_edges(ctl, 0, 0, WINDOW_MAT, ctla.au_y)} — it is blind, so its "
         + "zero below would mean nothing");

  // ⚠ ONE FRESH WORLD PER KEY, AND THAT IS THE INSTRUMENT AGAIN. Pressing them all
  // into one world passed with the defect intact: `ArrowUp` and `H` move the ground,
  // `open_ahead` takes its own reference from the ground it finds, and the counter
  // was then reading a layer the write had left. The control above shares this
  // fixture EXACTLY — same world, same wall, nothing else pressed — so its 1 and
  // this 0 are the same question asked twice.
  for k in ["ArrowUp", "ArrowDown", "H", "F", "G", "O", "P"] {
    kw = flat();
    ks = EditSession {};
    ka = author_on(kw, ax, az, 0.0);
    against_a_wall(kw, ka);
    press(ks, kw, ka, k);
    assert(owned_edges(kw, 0, 0, WINDOW_MAT, ka.au_y) == 0,
           "key '{k}' left {owned_edges(kw, 0, 0, WINDOW_MAT, ka.au_y)} edges "
           + "carrying WINDOW_MAT — a material no `36:` message can produce, so the "
           + "same key builds a different world depending on which driver ran it");
  }
}

// ⚠ AND THE REFUSAL SAYS WHICH KIND OF NO IT IS. `PR_NONE` means *this key is not a
// gesture* — a walk key, a camera key — and answering it for `O` would tell a reader
// the editor has no opening at all. It has one; nothing has chosen a profile for it.
fn test_an_opening_key_says_it_is_waiting_rather_than_unknown() {
  w = flat();
  sess = EditSession {};
  a = author_on(w, 0.0, 0.0, 0.0);
  against_a_wall(w, a);
  for k in ["O", "P"] {
    ack = press(sess, w, a, k);
    assert(!ack.ak_ok, "key '{k}' cut an opening: {ack.ak_why}");
    assert(ack.ak_why != PR_NONE,
           "key '{k}' answered PR_NONE — that says it is a walk key, and it is not");
    assert(ack.ak_why == PR_SELECT, "key '{k}' said '{ack.ak_why}'");
  }
}

// ── `R1b` — the ring, at the feet, and remembered as a trunk ────────────────
//
// A world with somewhere to stand ABOVE the ground: a storey over a disc wide
// enough to hold a radius-`FENCE_R` ring AND the cells outside it that store half
// of the ring's edges. Without the second radius the outer owners have nothing at
// the author's level, `edge_layer` falls back to the ground, and the fixture would
// answer the same at both references for a reason that has nothing to do with the
// claim.
fn upstairs() -> VoxelWorld {
  uw = flat();
  uwhy = "";
  storey_add(uw, 6, 6, 1, FENCE_R + 2, uwhy);
  uw
}

// The edges of material `mat` stored on the layer that `ref` names, counted the way
// `fence.loft` counts them: a cell owns an edge exactly when `edge_owner` names it,
// so asking all six directions of every cell would count every edge twice.
fn ring_bytes(w: VoxelWorld, cq: integer, cr: integer, mat: integer, ref: float) -> integer {
  rb = 0;
  for rq in cq - FENCE_R - 2..cq + FENCE_R + 3 {
    for rr in cr - FENCE_R - 2..cr + FENCE_R + 3 {
      for rd in 0..6 {
        (roq, ror, _rslot) = edge_owner(rq, rr, rd);
        if roq == rq && ror == rr && wall_of(w, rq, rr, rd, ref) == mat {
          rb = rb + 1;
        }
      }
    }
  }
  rb
}

// ⚠ THE DIVERGENCE `R1b` CLOSES: `press` passed `0.0` as the ring's reference where
// the server passes the author's own ground height. The reference is not decoration
// — `fence_ring` → `fence_disc` → `wall_set` → `edge_layer(wld, oq, orr, ref)` — so
// it picks WHICH LAYER the edge is stored on, and an author on a deck at 12 with the
// ground at 0 fenced the yard below.
fn test_pressing_the_fence_key_rings_at_the_authors_feet_and_not_on_the_ground() {
  by_key  = upstairs();
  by_hand = upstairs();
  ks = EditSession {};
  (ax, az) = hex_to_px(6, 6);
  // ⚠ `author_at`, NOT `author_on`. The pose is a DECK's, and `author_on` reads the
  // ground cell — which is the yard. This is precisely the case where the driver
  // knows better than the store, and why the height is the pose's to carry.
  up = author_at(ax, az, 0.0, (STOREY_H as float) * by_key.w_unit);
  assert(edge_layer(by_key, 6, 6, up.au_y) != edge_layer(by_key, 6, 6, 0.0),
         "the fixture puts both references on layer {edge_layer(by_key, 6, 6, 0.0)} "
         + "— this test cannot see the difference it exists for");

  ka = press(ks, by_key, up, "F");
  ha = fence_ring(by_hand, up, FENCE_MAT, FENCE_R, up.au_y);
  assert(ka.ak_ok && ha.ak_ok, "the fixture refused the ring: {ka.ak_why} / {ha.ak_why}");
  assert(ka.ak_n == ha.ak_n, "{ka.ak_n} edges by key, {ha.ak_n} by hand");
  assert(by_key.w_tau == by_hand.w_tau,
         "pressing F did {by_key.w_tau} writes, calling fence_ring did "
         + "{by_hand.w_tau} — the key means something else now");

  // ⚠ AND NEITHER OF THOSE CAN SEE THE DEFECT, which is why the layer is asked
  // directly. `ak_n` comes from `fence_count`, which reads back at the SAME
  // reference it wrote at — so a ring laid entirely on the wrong layer counts 42
  // and agrees with itself. The edit clock is blind for the same reason: the same
  // number of writes each changed something, whichever layer they landed on.
  want = 6 * (2 * FENCE_R + 1);
  assert(ring_bytes(by_key, 6, 6, FENCE_MAT, up.au_y) == want,
         "the ring is not on the author's own layer: {ring_bytes(by_key, 6, 6, FENCE_MAT, up.au_y)} "
         + "of {want} edges there");
  assert(ring_bytes(by_key, 6, 6, FENCE_MAT, 0.0) == 0,
         "{ring_bytes(by_key, 6, 6, FENCE_MAT, 0.0)} fence edges are in the yard "
         + "below — this is the `0.0` reference `press` used to pass");
}

// ⚠ THE SERVER FORCES THE YAW TO ZERO (`author_at(px, pz, 0.0, py)`) AND `press`
// DOES NOT — so the two agree only if a ring cannot read a yaw. Measured rather
// than assumed, because the alternative is copying a zero whose meaning nobody can
// check: `fence_ring` takes `px_to_hex(au_x, au_z)` and hands a CELL to
// `fence_disc`, and `trunk_of` does the same.
fn test_the_ring_does_not_read_the_authors_yaw() {
  facing = upstairs();
  turned = upstairs();
  fs = EditSession {};
  ts = EditSession {};
  (ax, az) = hex_to_px(6, 6);
  up = (STOREY_H as float) * facing.w_unit;
  fa = press(fs, facing, author_at(ax, az, 0.0, up), "G");
  ta = press(ts, turned, author_at(ax, az, 2.1, up), "G");
  assert(fa.ak_ok && ta.ak_ok, "the fixture refused a ring");
  assert(facing.w_tau == turned.w_tau,
         "the same ring at two yaws did {facing.w_tau} and {turned.w_tau} writes");
  // ⚠ AND THE COUNT IS PINNED TO THE GEOMETRY, not just to the other world. Two
  // rings that both landed nowhere would agree at zero, which is a settle on an
  // empty block wearing an equality's clothes.
  assert(ring_bytes(facing, 6, 6, WALL_MAT, up) == 6 * (2 * FENCE_R + 1),
         "the facing ring left {ring_bytes(facing, 6, 6, WALL_MAT, up)} of "
         + "{6 * (2 * FENCE_R + 1)} edges — there is nothing here to compare");
  assert(ring_bytes(facing, 6, 6, WALL_MAT, up) == ring_bytes(turned, 6, 6, WALL_MAT, up),
         "and left different edges: {ring_bytes(facing, 6, 6, WALL_MAT, up)} against "
         + "{ring_bytes(turned, 6, 6, WALL_MAT, up)}");
  assert(fs.es_trunk.tk_x == ts.es_trunk.tk_x && fs.es_trunk.tk_z == ts.es_trunk.tk_z
         && fs.es_trunk.tk_r == ts.es_trunk.tk_r,
         "the trunk moved with the yaw: ({fs.es_trunk.tk_x},{fs.es_trunk.tk_z}) r "
         + "{fs.es_trunk.tk_r} against ({ts.es_trunk.tk_x},{ts.es_trunk.tk_z}) r "
         + "{ts.es_trunk.tk_r}");
}

// ⚠ A RING OF WALL IS A CYLINDER AND A CYLINDER IS A HOST, but it is stored as
// EDGES — it has no ends, so nothing `annex_host` looks for would find it. The
// server remembered the ring beside its socket; `press` remembered nothing at all,
// so a page that rang a tree could never hang a balcony on it and there was no
// symptom short of a screenshot.
fn test_a_ring_records_the_trunk_a_balcony_hangs_on() {
  w = upstairs();
  sess = EditSession {};
  (cx, cz) = hex_to_px(6, 6);
  // ⚠ OFF THE CELL'S CENTRE ON PURPOSE. `fence_ring` rings the DISC the author
  // stands in, so the cylinder is the cell's, not the author's — and standing
  // exactly on the centre is the fixture that cannot tell those two apart. Half a
  // hex is 0.87 world units, so (0.4, 0.3) is inside it and the precondition below
  // says so rather than trusting the arithmetic.
  ax = cx + 0.4;
  az = cz + 0.3;
  (pq, pr) = px_to_hex(ax, az);
  assert(pq == 6 && pr == 6,
         "the offset pose left the cell — it stands in ({pq},{pr}), not (6,6)");
  up = author_at(ax, az, 0.0, (STOREY_H as float) * w.w_unit);
  assert(!sess.es_trunk.tk_live, "the fixture starts with a trunk already standing");

  ack = press(sess, w, up, "G");
  assert(ack.ak_ok, "the fixture refused the ring: {ack.ak_why}");
  assert(sess.es_trunk.tk_live,
         "pressing G left no trunk — `K` has nothing to attach to, silently");

  // The server's own arithmetic, spelled out: the ring is centred on the CELL the
  // author stands in, and its radius is in world units.
  (wx, wz) = hex_to_px(pq, pr);
  assert(wx != ax,
         "the cell's centre and the author's own x are the same number ({wx}) — a "
         + "trunk taken from the pose would pass this test");
  assert(sess.es_trunk.tk_x == wx && sess.es_trunk.tk_z == wz,
         "the trunk is at ({sess.es_trunk.tk_x},{sess.es_trunk.tk_z}) and the cell "
         + "the author rang is at ({wx},{wz})");
  assert(sess.es_trunk.tk_r == (FENCE_R as float) * hex_grid::HEX_LEN,
         "the trunk's radius is {sess.es_trunk.tk_r} and {FENCE_R} hexes is "
         + "{(FENCE_R as float) * hex_grid::HEX_LEN} world units");

  // ⚠ AND THE CONSUMER, because a recorded field nobody reads is this tree's
  // commonest defect. Standing just outside the ring with no wall anywhere, `K`
  // must find a ROUND host — which is the whole of "a balcony on a tree".
  host = annex_host(sess.es_runs, ax + sess.es_trunk.tk_r + 1.0, az, 0.0, sess.es_trunk);
  assert(host.ah_ok && host.ah_round,
         "annex_host did not read the ring as a host (ok {host.ah_ok}, round "
         + "{host.ah_round}) — this is the balcony refused for being wider than a "
         + "cottage across the field");
}

// ⚠ A REFUSED RING LEAVES NO CYLINDER, and this is a decision rather than a
// transcription of what the server did. `editor_server` recorded the trunk from the
// PAYLOAD in its message loop, after `do_fence` had already returned early on the
// refusal — so `23:9,2` left a phantom trunk of radius 2 where no edge was written.
fn test_a_refused_ring_records_no_trunk() {
  w = upstairs();
  sess = EditSession {};
  session_at(sess, w, 0.0, 0.0, 0.0);
  ack = session_fence(sess, w, 9, 2, 0.0);          // 9 is not a wall material
  assert(!ack.ak_ok, "material 9 was accepted");
  assert(!sess.es_trunk.tk_live,
         "a refused ring left a trunk of radius {sess.es_trunk.tk_r} standing at "
         + "({sess.es_trunk.tk_x},{sess.es_trunk.tk_z})");
}

// ⚠ THE WORLD'S OWN UNIT, NOT A GLOBAL 0.25. A part world may be authored at
// another unit entirely — `door/slat` is 0.125 — so a pose that reached for
// `hex_proj::HEIGHT_SCALE` would be right on the landscape and wrong on every part.
fn test_the_height_is_in_the_worlds_own_unit() {
  fine = world_new(0.125, W_RESERVE, 8, 3).wn_world;
  for fq in 0 - 3..4 {
    for fr in 0 - 3..4 { ground_set(fine, fq, fr, 8, SURFACE_MAT); }
  }
  (px, pz) = hex_to_px(0, 0);
  a = author_on(fine, px, pz, 0.0);
  assert(a.au_y == 1.0,
         "8 steps at 0.125 is 1.0 world units, the pose says {a.au_y} — a global "
         + "0.25 would have answered 2.0");
}
