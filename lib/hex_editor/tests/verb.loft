// V1 — A KEY NAMES A VERB, AND THE VERB IS WHAT TRAVELS.
//
// plan 22 `V1`, and ⚠ **`V3` HAS SINCE DELETED ONE OF THE TWO BODIES.** For the
// length of `V1`–`V2b` this file was the comparison that made the move safe: the old
// path and the new one both running, every one of the eleven keys driven through
// both, the two worlds compared as BYTES. `press(key)` is gone, so those two rows
// are retired — see below, where what they proved and what replaces it is written
// out rather than left to a git log. What remains is the DEFINITION (`verb_of`) and
// the behaviour of the layer under it (`press_verb`), including the byte instrument
// itself and the blindness that justified building it.
//
// ⚠ **BYTES, NOT `w_tau`, AND THE DIFFERENCE IS MEASURED BELOW RATHER THAN
// ASSERTED.** The edit clock counts writes that changed something, so a fence ring
// and a wall ring — the same edges, the same count, a different material — leave
// **equal `w_tau`**. `test_the_edit_clock_cannot_tell_a_fence_from_a_wall` is that
// blindness on the record, and it is the row that says why this file encodes a whole
// world to answer a question a counter looks able to answer.
//
// ⚠ **AND THE DUPLICATION WAS WHAT MADE THOSE ROWS ABLE TO FAIL.** Had `press(key)`
// been written as `press_verb(verb_of(key))` on day one, every equality here would
// have been a tautology and the move would have been unverifiable. The two tables
// were independent for exactly the length of `V2`, which is what a transitional
// instrument is: built to be deleted, and worthless if it is built to survive.
use hex_editor;
use hex_voxel;
use hex_grid;

fn ground(gw: VoxelWorld, half: integer) {
  for gq in 0 - half..half + 1 {
    for gr in 0 - half..half + 1 { ground_set(gw, gq, gr, 8, SURFACE_MAT); }
  }
}

fn flat() -> VoxelWorld {
  fw = world_new(0.25, W_RESERVE, 8, 3).wn_world;
  ground(fw, 20);
  fw
}

// A world with a ring of wall in it, so the opening family has something to cut —
// `press.loft`'s fixture, restated here because a test file is its own scope.
fn walled() -> VoxelWorld {
  ww = walled_ground();
  fence_disc(ww, 0, 0, 2, WALL_MAT, 2.0);
  ww
}

fn walled_ground() -> VoxelWorld {
  wg = world_new(0.25, W_RESERVE, 8, 3).wn_world;
  ground(wg, 12);
  wg
}

// ── THE INSTRUMENT ──────────────────────────────────────────────────────────
//
// The index of the first byte on which two worlds differ, `-1` if they are the same
// world and `-2` if they are not even the same length.
//
// ⚠ **THE LENGTH IS A SEPARATE ANSWER** for `bytes.loft`'s reason: a length mismatch
// and a content mismatch want different diagnoses, and comparing over the shorter of
// the two reports the interesting case as "byte 0" or as nothing at all.
fn first_difference(x: VoxelWorld, y: VoxelWorld) -> integer {
  bx = world_to_bytes(x, []);
  by = world_to_bytes(y, []);
  if len(bx) != len(by) { return 0 - 2; }
  for bi in 0..len(bx) {
    if (bx[bi] as integer? ?? 0) != (by[bi] as integer? ?? 0) { return bi; }
  }
  0 - 1
}

fn same_world(x: VoxelWorld, y: VoxelWorld) -> boolean { first_difference(x, y) == 0 - 1 }

// The pose each key wants, and it is not the same one.
//
// ⚠ **30° FOR THE HOUSE IS NOT DECORATION** — only 6 of the lattice's 12 facings have
// mitred corners and yaw 0 lands on an odd one, so a house pressed at 0 is refused
// with `rot 9 of 12, offer 8`. ⚠ **AND THE OPENING FAMILY STANDS ON THE WALL**: an
// author inside the footprint has no wall in front of them, which is the live defect
// `house.keys` has carried since it was written.
fn pose_for(key: text, w: VoxelWorld) -> Author {
  if key == "H" {
    (hx, hz) = hex_to_px(6, 6);
    return author_on(w, hx, hz, 30.0 * PI / 180.0 ?? 0.0);
  }
  if key == "O" || key == "P" || key == "I" || key == "U" || key == "N" || key == "M" {
    (ox, oz) = hex_to_px(2, 0);
    return author_on(w, ox, oz, 0.0);
  }
  author_on(w, 0.0, 0.0, 0.0)
}

fn world_for(key: text) -> VoxelWorld {
  if key == "O" || key == "P" || key == "I" || key == "U" || key == "N" || key == "M" {
    return walled();
  }
  flat()
}

// ── THE DEFINITION, AND WHAT STOPS IT BEING A SELF-TEST ─────────────────────
//
// ⚠ **TWO EQUALITIES LIVED HERE AND `V3` RETIRED THEM, because their left-hand side
// is deleted.** `test_every_direct_key_resolves_through_the_verb_layer_to_the_same_
// world` drove all eleven keys through `press(key)` AND `press_verb(verb_of(key))`
// and compared the worlds as BYTES; `test_the_opening_family_is_the_verb_plus_the_
// selection` did the same for the six opening kinds against `select` + cut. They
// were the instrument that made the move safe — the old path and the new one running
// at once, compared exactly — and with `press(key)` gone there is one path, so both
// would now be tautologies.
//
// **What they proved is spent, not lost.** They were seen green across `V1`, `V2a`
// and `V2b`; what has to survive them is the DEFINITION, and that is below. The byte
// comparison itself is still exercised — `test_two_worlds_built_the_same_way_are_the_
// same_bytes` and `test_the_edit_clock_cannot_tell_a_fence_from_a_wall` both use it.

// The key → verb table, written out by hand against the one the library declares.
//
// ⚠ **THIS ROW CANNOT BE SURPRISED AND IT IS KEPT ANYWAY, WITH ITS LIMIT NAMED.** It
// is a declaration checked against a second declaration: if both were edited the same
// way it would stay green, which is exactly what `plans/README` means by a self-test.
// What makes the pair honest is the two rows underneath it —
// `test_the_five_direct_verbs_do_five_different_things` (the five verbs BUILD five
// different worlds, compared as bytes) and `test_every_verb_the_definition_produces_
// is_bound` (nothing the table can name is unbound). Those can be surprised; this one
// says which name goes with which key, which nothing else states in words.
//
// ⚠ **AND IT IS WRITTEN OUT RATHER THAN DERIVED.** Deriving both sides from one list
// is a table checked against itself, and `W4`'s whole finding is that four tables
// disagreed.
fn test_the_definition_names_the_verb_each_direct_key_is_written_to_name() {
  keys  = ["ArrowUp", "ArrowDown", "H", "F", "G"];
  verbs = [VB_RAISE, VB_LOWER, VB_PLACE, VB_FENCE, VB_WALL];
  for vi in 0..5 {
    k = keys[vi] ?? "";
    want = verbs[vi] ?? "";
    assert(verb_of(k) == want,
           "key '{k}' names verb '{verb_of(k)}' and the definition says '{want}'");
  }
  // …and the six that collapse. ⚠ THE POINT OF THE FAMILY: `verb_of` is deliberately
  // NOT injective, so the key is not recoverable from the verb and a driver that
  // wanted a profile has to ask the selection.
  for ok in ["O", "P", "I", "U", "N", "M"] {
    assert(verb_of(ok) == VB_OPENING,
           "key '{ok}' names '{verb_of(ok)}' and the six are one verb");
  }
}

// ── THE CONTROLS ────────────────────────────────────────────────────────────
//
// ⚠ **THE INSTRUMENT IS CHECKED AGAINST SOMETHING IT SHOULD FIND, AND `w_tau` FAILS
// THAT CHECK HERE.** A fence ring and a wall ring write the same edges of the same
// disc with a different material: the same number of writes, each changing
// something, so the edit clock reports **the same number** for two different worlds.
// Every equality above would still pass with `verb_of("G")` returning `VB_FENCE` if
// this file counted instead of encoding.
fn test_the_edit_clock_cannot_tell_a_fence_from_a_wall() {
  wf = flat();
  wg = flat();
  sf = EditSession {};
  sg = EditSession {};
  af = press_verb(sf, wf, pose_for("F", wf), verb_of("F"));
  ag = press_verb(sg, wg, pose_for("G", wg), verb_of("G"));
  assert(af.ak_ok && ag.ak_ok, "the fixture refused a ring: {af.ak_why} / {ag.ak_why}");
  assert(wf.w_tau == wg.w_tau,
         "a fence did {wf.w_tau} writes and a wall did {wg.w_tau} — if these ever "
       + "differ the counter is no longer blind and this control has stopped "
       + "justifying the byte comparison");
  assert(!same_world(wf, wg),
         "a fence ring and a wall ring encode to identical bytes — the instrument "
       + "this file rests on cannot see a material either");
}

// …and the byte comparison must not be blind in the other direction: two worlds
// built the same way must come out EQUAL, or every assertion above passes by
// reporting a difference that is always there.
fn test_two_worlds_built_the_same_way_are_the_same_bytes() {
  a1 = flat();
  a2 = flat();
  s1 = EditSession {};
  s2 = EditSession {};
  press_verb(s1, a1, pose_for("H", a1), verb_of("H"));
  press_verb(s2, a2, pose_for("H", a2), verb_of("H"));
  assert(same_world(a1, a2),
         "two identical presses differ at byte {first_difference(a1, a2)} — the "
       + "encoder carries something that is not the world");
  assert(len(world_to_bytes(a1, [])) > 8192,
         "the fixture encodes to {len(world_to_bytes(a1, []))} bytes, which is too "
       + "small to hold a layer — the comparison is not reaching the payload");
}

// ⚠ **AND THE FIVE MUST NOT ALL BE THE SAME GESTURE**, or `press_verb` wired to a
// constant satisfies every equality above. `verb_of` is deliberately not injective
// over the opening keys; over these five it must be.
fn test_the_five_direct_verbs_do_five_different_things() {
  keys = ["ArrowUp", "ArrowDown", "H", "F", "G"];
  seen: vector<text> = [];
  for dk in keys {
    v = verb_of(dk);
    for prev in seen {
      assert(prev != v, "two of the five direct keys both name '{v}'");
    }
    seen += [v];
  }
  // …and the verbs must build five different worlds, which the names alone do not
  // promise. Compared against the FIRST, so a table that answered one gesture for
  // everything is caught wherever it sits in the list.
  base = flat();
  bs = EditSession {};
  press_verb(bs, base, pose_for("ArrowUp", base), VB_RAISE);
  for ov in ["lower", "place", "fence", "wall"] {
    other = flat();
    os = EditSession {};
    okey = "F";
    if ov == "place" { okey = "H"; }
    oa = press_verb(os, other, pose_for(okey, other), ov);
    assert(oa.ak_ok, "verb '{ov}' was refused by the fixture: {oa.ak_why}");
    assert(!same_world(base, other),
           "verb '{ov}' and verb 'raise' build the same world — one table answers "
         + "one gesture");
  }
}

// ── `R` — THE ONE VERB WHOSE FIRST PRESS BUILDS NOTHING — plan 22 `K3` ──────
//
// ⚠ **WHICH IS WHY IT IS NOT IN THE FIVE ABOVE.** That test presses each verb once
// and demands a world different from `raise`'s; a run's first press records the near
// end and writes nothing at all, so it would go red for behaving correctly. The
// discriminator it needs is two presses, and it is worth having: `press_verb` wired
// to `ring_set` — the verb `run` is easiest to confuse with — would build a ring here
// on the FIRST press and pass anything that only looked at the second.
fn test_the_run_verb_takes_two_presses_and_the_first_writes_nothing() {
  w = flat();
  s = EditSession {};
  quiet = w.w_tau;
  first = press_verb(s, w, author_on(w, 0.0, 0.0, 0.0), verb_of("R"));
  assert(first.ak_ok, "the first press of a run was refused: {first.ak_why}");
  assert(first.ak_n == 0, "the first press of a run reported {first.ak_n} written");
  assert(w.w_tau == quiet,
         "the first press of a run did {w.w_tau - quiet} writes — it is building "
       + "something, and a run has no far end yet");
  second = press_verb(s, w, author_on(w, 4.0, 0.0, 0.0), verb_of("R"));
  assert(second.ak_ok, "the closing press of a run was refused: {second.ak_why}");
  assert(second.ak_n > 0, "the closing press laid {second.ak_n}");
  assert(w.w_tau > quiet, "the closing press of a run wrote nothing");
}

// ⚠ AND IT IS NOT THE RING. `run` and `wall` share a material and nothing else — one
// walks a line between two presses, the other closes a cylinder around the author.
//
// ⚠ **THE SAME POSES ON BOTH SIDES, AND THAT IS THE WHOLE TEST.** The first version
// pressed `R` twice against `G` once, and it stayed GREEN with `press_verb`'s `run`
// branch wired to `ring_set` — because two rings differ from one ring for a reason
// that has nothing to do with the verb. Measured: the sabotage was caught by
// `…_the_first_writes_nothing` and not by the test whose comment claimed it. Two
// presses against two presses is what makes a ring-wired `run` build the byte-
// identical world this compares against.
fn test_the_run_verb_is_not_the_ring_verb() {
  rw = flat();
  rs = EditSession {};
  press_verb(rs, rw, author_on(rw, 0.0, 0.0, 0.0), verb_of("R"));
  press_verb(rs, rw, author_on(rw, 4.0, 0.0, 0.0), verb_of("R"));

  gw = flat();
  gs = EditSession {};
  press_verb(gs, gw, author_on(gw, 0.0, 0.0, 0.0), verb_of("G"));
  press_verb(gs, gw, author_on(gw, 4.0, 0.0, 0.0), verb_of("G"));

  assert(!same_world(rw, gw), "verb 'run' and verb 'wall' build the same world");
  assert(verb_of("R") != verb_of("G"), "the run key and the ring key name one verb");
}

// A key that is not a gesture names no verb — the `PR_NONE` question one level up.
// ⚠ A walk key answering a verb would be worse than answering nothing: `press_verb`
// would run a gesture on every step of a walk.
fn test_a_key_that_is_not_a_gesture_names_no_verb() {
  for nk in ["W", "A", "S", "D", "", "ArrowLeft", "K", "zzz"] {
    assert(verb_of(nk) == VB_NONE,
           "key '{nk}' is not a gesture and the definition gives it verb "
         + "'{verb_of(nk)}'");
  }
}

// …and the same for the layer under it: a verb nobody bound is `PR_NONE`, not a
// refusal, because a caller that cannot tell *no such verb* from *the gesture said
// no* reports one as the other.
fn test_an_unbound_verb_is_named_rather_than_refused() {
  w = flat();
  s = EditSession {};
  a = pose_for("F", w);
  // ⚠ THE BASELINE IS THE FIXTURE'S, NOT ZERO. `flat()` lays 41×41 cells of ground,
  // so `w_tau == 0` would have been an assertion about the fixture — it went red at
  // 1682 first, which is exactly the ground and nothing an unbound verb did.
  before = w.w_tau;
  for uv in ["", "ring", "roof", "Place", "PLACE", "opening ", "verb"] {
    ack = press_verb(s, w, a, uv);
    assert(ack.ak_why == PR_NONE,
           "verb '{uv}' is bound to nothing and press_verb answered '{ack.ak_why}'");
    assert(!ack.ak_ok, "verb '{uv}' is bound to nothing and it reported success");
  }
  assert(w.w_tau == before,
         "seven unbound verbs did {w.w_tau - before} writes between them");
}

// …and the discriminator above must not pass by refusing everything: every verb the
// definition can produce has to be bound.
fn test_every_verb_the_definition_produces_is_bound() {
  w = flat();
  s = EditSession {};
  for bk in ["ArrowUp", "ArrowDown", "H", "O", "P", "I", "U", "N", "M", "F", "G",
             "R"] {
    v = verb_of(bk);
    assert(v != VB_NONE, "key '{bk}' is a gesture and names no verb");
    ack = press_verb(s, w, pose_for(bk, w), v);
    assert(ack.ak_why != PR_NONE,
           "key '{bk}' names verb '{v}' and nothing is bound to it");
  }
}
