// WHAT A BYTE MEANS IS THE WORLD'S ANSWER, NOT THIS FILE'S — plan 21 `R5`.
//
// ⛔ **`R1` AND `R2` BUILT THE RESOLVER AND 22 SITES STILL BYPASS IT.**
// `ground_kind_at` asks the cell's own region what its byte is called and has been
// shipped since `R1`; meanwhile `house_recover_claimed`, `region_recover_claimed`,
// `house_fits_at`, `touched_cells` and the room's re-fill each ask `== FLOOR_MAT`
// — a compile-time integer out of this package. So a world that numbers its own
// floor differently is read correctly by the slope rules and **not seen at all** by
// the readers a blueprint is made of. That is the *check that what you built is
// called* defect at the one place plan 21 exists to fix.
//
// ⚠ **THE FIXTURE RENUMBERS A REAL HOUSE RATHER THAN BUILDING A FAKE ONE.** The
// house is placed by the gesture, so its floor is whatever `place_house` writes;
// only the BYTE is moved afterwards. A recovery that came back different would be
// a statement about the numbering and nothing else, which is the whole claim.
//
// ⚠ **BYTE 20 IS UNUSED BY THE BUILT-IN TABLE ON PURPOSE.** An unnamed byte falls
// back to `grass` (`ground_kind_default`), so the control is sharp: without the
// palette the house's floor reads as ordinary ground and no rectangle is found.
use hex_editor;
use hex_voxel;
use hex_shape;
use hex_edge;
use hex_grid;

const YAW = 1.5707963267948966;
const U = 0.25;

// The byte this world will call `floor`. Not in `GROUND_KINDS`, so the built-in
// reading of it is `grass` and the control below can fail for a real reason.
const ALIEN = 20;

fn flat_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - 30, 0 - 30, 61, 61, 8, SURFACE_MAT);
  w
}

fn house_world() -> VoxelWorld {
  w = flat_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, YAW);
  ack = press_verb(s, w, s.es_author, VB_PLACE, "");
  assert(ack.ak_ok, "the house was refused: {ack.ak_why}");
  w
}

// Move every cell carrying `from` onto `to`, keeping height, item and all three
// edges — the cell edited, never the cell replaced.
fn renumber(w: VoxelWorld, from: integer, to: integer) -> integer {
  n = 0;
  for r in (0 - 16)..17 {
    for q in (0 - 16)..17 {
      col = hex_voxel::world_column(w, q, r);
      for li in 0..len(col.co_cells) {
        c = col.co_cells[li] ?? hex_voxel::Hex {};
        if (c.h_material as integer ?? 0) != from { continue; }
        layer_write(w, q, r, li,
          hex_voxel::Hex { h_height: c.h_height,
                           h_material: to as u8? ?? 0,
                           h_item: c.h_item,
                           h_item_rotation: c.h_item_rotation,
                           h_wall_nw: c.h_wall_nw,
                           h_wall_ne: c.h_wall_ne,
                           h_wall_e: c.h_wall_e });
        n = n + 1;
      }
    }
  }
  n
}

fn name_it(w: VoxelWorld, slot: integer, name: text) {
  assert(hex_voxel::world_palette_put(w, hex_voxel::PAL_MATERIAL, 0, slot, name)
         == hex_voxel::PAL_OK,
         "the palette refused {slot}={name}");
}

// ── THE CONTROL COMES FIRST, because it is what makes the claim mean anything ─

// ⚠ **A RENUMBERED HOUSE WITH NO PALETTE MUST NOT BE FOUND.** If this passes, the
// fixture is not moving the thing the claim is about and every row below is green
// for free.
fn test_a_renumbered_floor_with_no_palette_is_not_a_house() {
  w = house_world();
  moved = renumber(w, FLOOR_MAT, ALIEN);
  assert(moved > 0, "the fixture moved no floor cells — there is no house here");
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(!h.hs_ok,
         "byte {ALIEN} is named by nothing and a house was still recovered — the "
       + "fixture is not testing the numbering");
}

// ── AND THE CLAIM ──────────────────────────────────────────────────────────

// ⛔ **THE SAME HOUSE, NUMBERED DIFFERENTLY, IS THE SAME HOUSE.** Every field of
// the recovery is compared, not just `hs_ok`: a reader that found *a* rectangle
// somewhere else would pass a bare success check.
fn test_a_world_that_numbers_its_floor_differently_still_has_its_house() {
  base = house_recover(house_world(), 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(base.hs_ok, "the built-in numbering recovered no house: {base.hs_why}");

  w = house_world();
  renumber(w, FLOOR_MAT, ALIEN);
  name_it(w, ALIEN, "floor");

  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "the world calls byte {ALIEN} 'floor' and no house was "
                + "recovered: {h.hs_why}");
  assert(h.hs_cq == base.hs_cq && h.hs_cr == base.hs_cr,
         "the anchor moved with the numbering: {h.hs_cq},{h.hs_cr} against "
       + "{base.hs_cq},{base.hs_cr}");
  assert(h.hs_wid == base.hs_wid && h.hs_dep == base.hs_dep
         && h.hs_rot == base.hs_rot,
         "the rectangle changed with the numbering: {h.hs_wid}x{h.hs_dep} rot "
       + "{h.hs_rot} against {base.hs_wid}x{base.hs_dep} rot {base.hs_rot}");
  assert(h.hs_cells == base.hs_cells,
         "{h.hs_cells} floor cells against {base.hs_cells}");
  assert(h.hs_stray == base.hs_stray && h.hs_missing == base.hs_missing,
         "the residuals moved: {h.hs_stray}/{h.hs_missing} against "
       + "{base.hs_stray}/{base.hs_missing}");
}

// ⚠ **AND THE OTHER DIRECTION, which is the half a fallback cannot fake.** Byte 4
// is `FLOOR_MAT` in this package; a world that calls it `grass` must stop having a
// house there, or the palette is being read and then ignored.
fn test_the_built_in_floor_byte_named_grass_is_no_longer_a_house() {
  w = house_world();
  before = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(before.hs_ok, "no house to un-name: {before.hs_why}");
  name_it(w, FLOOR_MAT, "grass");
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(!h.hs_ok,
         "byte {FLOOR_MAT} was named 'grass' and a {h.hs_wid}x{h.hs_dep} house was "
       + "still recovered from it");
}

// ⚠ **THE REGION READER TAKES THE SAME FLOOR AND MUST MOVE WITH IT.** It is the
// second of the two readers a blueprint's descriptions come out of, so a fix that
// reached only the house reader would leave the plan view half decoupled.
fn test_the_region_reader_reads_a_renumbered_floor_too() {
  w = house_world();
  base = region_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(base.rg_ok, "the built-in numbering recovered no region: {base.rg_why}");

  w2 = house_world();
  renumber(w2, FLOOR_MAT, ALIEN);
  name_it(w2, ALIEN, "floor");
  rg = region_recover(w2, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(rg.rg_ok, "the world calls byte {ALIEN} 'floor' and the region reader "
                 + "found nothing: {rg.rg_why}");
  assert(rg.rg_cells == base.rg_cells && rg.rg_sides == base.rg_sides,
         "{rg.rg_cells} cells / {rg.rg_sides} sides against {base.rg_cells} / "
       + "{base.rg_sides}");
}

// ── ⛔ THE TWO DOORS ARE ONE RULE, AND THAT IS A TEST — plan 21 `R5a` ───────
//
// `ground_role_at` exists because `ground_kind_at` costs 180× the comparison it
// replaced (`probe/roles/cost.loft`), and it is a SECOND statement of the same
// resolution: the palette first, the table by byte second, `grass` last. Folding them
// into one is not available — the struct path's final fallback returns a row wearing
// the CALLER's byte, and a name cannot carry *and it came from the fallback*.
//
// ⚠ So the equality is asserted rather than asserted-in-a-comment, over every byte a
// `u8` can hold and in both palette states. A drift between them would make a rule and
// a reader disagree about the same cell, silently.
fn test_the_name_door_and_the_row_door_agree_on_every_byte() {
  w = flat_world();
  for m in 0..256 {
    assert(ground_role_at(w, 0, 0, m) == ground_kind_at(w, 0, 0, m).tr_name,
           "byte {m}: the name door says '{ground_role_at(w, 0, 0, m)}' and the row "
         + "door says '{ground_kind_at(w, 0, 0, m).tr_name}'");
  }
}

fn test_they_agree_when_the_world_has_renamed_bytes_too() {
  w = flat_world();
  name_it(w, ALIEN, "floor");
  name_it(w, FLOOR_MAT, "grass");
  name_it(w, 21, "a name no row of the table has");
  for m in 0..256 {
    assert(ground_role_at(w, 0, 0, m) == ground_kind_at(w, 0, 0, m).tr_name,
           "byte {m} under a palette: '{ground_role_at(w, 0, 0, m)}' against "
         + "'{ground_kind_at(w, 0, 0, m).tr_name}'");
  }
  // ⚠ AND THE CONTROL: the palette is actually being read, or the loop above compares
  // two fallbacks and proves nothing.
  assert(ground_role_at(w, 0, 0, ALIEN) == "floor", "byte {ALIEN} did not resolve");
  assert(ground_role_at(w, 0, 0, FLOOR_MAT) == "grass", "byte 4 did not resolve");
}

// ══ THE EDGE AXIS — plan 21 `R5b` ═══════════════════════════════════════════
//
// ⛔ **`PAL_EDGE` HAS BEEN IN THE WORLD FILE SINCE `R1` AND NOTHING READ IT.**
// `world_palette_check` refuses an edge byte the palette does not name, at load —
// so the store validated a mapping that no gesture, no walk and no reader ever
// consulted. `edge_kind_of` took a bare byte and had no `_at` sibling at all.
//
// ⛔ **AND THE DEFECT THAT ABSENCE PRODUCES IS NOT A MISSING FEATURE, IT IS A WALL
// THAT IS NOT THERE.** `edge_is_wall` answers *wall* for every byte past
// `EDGE_MAT_LAST`, which is the right default for a wall TYPE nobody named and the
// wrong one for a slot the world calls `door`: the walker is refused by masonry the
// palette says is a doorway, `open_span` cuts a hole in a hole, and nothing goes red
// because no world in this corpus carries an edge palette.
//
// ⚠ **BYTE 7 IS A LEGAL WALL-TYPE SLOT ON PURPOSE** — `session_select_wall` accepts
// it, `wall_stamp` writes it, and the built-in reading of it is *wall*. So the
// control below can fail for a real reason.

const ALIEN_EDGE = 7;
const REACH = 6;
const NW = 2 * REACH + 1;
const REF = 2.0;              // world units — the ground below is 8 * 0.25

fn edge_world(mat: integer) -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - REACH, 0 - REACH, NW, NW, 8, SURFACE_MAT);
  wall_set(w, 0, 0, 0, mat, 8, REF);
  w
}

fn name_edge(w: VoxelWorld, slot: integer, name: text) {
  assert(hex_voxel::world_palette_put(w, hex_voxel::PAL_EDGE, 0, slot, name)
         == hex_voxel::PAL_OK,
         "the edge palette refused {slot}={name}");
}

// Is the edge east of the origin a barrier, as the WALK's own reader answers it?
// ⚠ Through `edges_around` rather than through the predicate, because the predicate
// is what changed and a test that called it directly could not see the loop still
// asking the byte version.
fn walk_blocked(w: VoxelWorld) -> boolean {
  e = edges_around(w, 0, 0, REACH, false, WallRuns { items: [] },
                   hex_edge::surfaces_new(), REF);
  (nq, nr) = hex_grid::hex_neighbor(0, 0, 0);
  hex_edge::edge_blocked(e, 0, 0, nq, nr)
}

fn view_blocked(w: VoxelWorld) -> boolean {
  e = edges_around(w, 0, 0, REACH, true, WallRuns { items: [] },
                   hex_edge::surfaces_new(), REF);
  (nq, nr) = hex_grid::hex_neighbor(0, 0, 0);
  hex_edge::edge_blocked(e, 0, 0, nq, nr)
}

// ── THE CONTROLS COME FIRST ────────────────────────────────────────────────

// ⚠ **THE FIXTURE HAS TO BLOCK BEFORE ITS NOT-BLOCKING MEANS ANYTHING.** An
// undeclared slot 7 is a wall type whose name is missing, and it must stop a walker
// — that is `edge_is_wall`'s documented answer and `R5b` does not change it.
fn test_an_undeclared_edge_slot_still_walls_a_walker_in() {
  assert(walk_blocked(edge_world(ALIEN_EDGE)),
         "slot {ALIEN_EDGE} is named by nothing and did not block — the fixture is "
       + "not carrying a boundary, so every row below would pass for free");
  assert(walk_blocked(edge_world(WALL_MAT)), "plain masonry did not block");
  assert(!walk_blocked(edge_world(DOOR_MAT)), "the built-in door blocked a walker");
}

// ⛔ **AND THE BYTE PAIR AND THE RESOLVED PAIR MUST AGREE ON EVERY BYTE WHEN THERE IS
// NO PALETTE** — the whole corpus is such a world, so this is what says the change
// moved nothing. Both paths run; they are compared exactly.
fn test_with_no_palette_the_resolved_walk_is_the_byte_walk_on_every_byte() {
  w = edge_world(WALL_MAT);
  for m in 0..256 {
    assert(wall_stops_walk_at(w, 0, 0, m) == wall_stops_walk(m),
           "byte {m}: resolved walk says {wall_stops_walk_at(w, 0, 0, m)} and the "
         + "byte walk says {wall_stops_walk(m)}");
    assert(wall_stops_view_at(w, 0, 0, m) == wall_stops_view(m),
           "byte {m}: resolved view says {wall_stops_view_at(w, 0, 0, m)} and the "
         + "byte view says {wall_stops_view(m)}");
    assert(is_opening_at(w, 0, 0, m) == is_opening(m),
           "byte {m}: resolved opening says {is_opening_at(w, 0, 0, m)} and the byte "
         + "opening says {is_opening(m)}");
  }
}

// ── AND THE CLAIM: CUT, AND WALKED THROUGH ─────────────────────────────────

// ⛔ **A WORLD THAT NUMBERS ITS OWN DOOR IS WALKED THROUGH.** The same store, the
// same byte, the same walk — only the palette differs, and the control above says
// the version without it blocks.
fn test_a_world_that_calls_slot_seven_a_door_is_walked_through() {
  w = edge_world(ALIEN_EDGE);
  name_edge(w, ALIEN_EDGE, "door");
  assert(!walk_blocked(w),
         "the world calls edge slot {ALIEN_EDGE} 'door' and the walker was still "
       + "refused by it");
  assert(!view_blocked(w),
         "the world's own door blocked the camera's view too");
}

// ⚠ **AND THE OTHER DIRECTION, which is the half a fallback cannot fake.** Byte 2 is
// `DOOR_MAT` in this package; a world that calls it `wall` must stop a walker there,
// or the palette is being read and then ignored.
fn test_the_built_in_door_byte_named_wall_stops_a_walker() {
  w = edge_world(DOOR_MAT);
  assert(!walk_blocked(w), "the built-in door blocked before it was renamed");
  name_edge(w, DOOR_MAT, "wall");
  assert(walk_blocked(w),
         "edge byte {DOOR_MAT} was named 'wall' and a walker still went through it");
}

// ⚠ **A FENCE STOPS A WALKER AND NOT A CAMERA, AND A WORLD MAY DECLARE ONE.** The
// two sets are different (`wall_stops_walk` against `wall_stops_view`), so a resolver
// that collapsed them would pass every row above and fail here.
fn test_a_world_that_declares_its_own_fence_gets_a_fences_two_answers() {
  w = edge_world(ALIEN_EDGE);
  name_edge(w, ALIEN_EDGE, "fence");
  assert(walk_blocked(w), "the world's own fence let a walker through");
  assert(!view_blocked(w), "the world's own fence blocked the camera's view");
}

// ⛔ **AND THE CUT HALF.** `open_ahead` refuses a kind that is not an opening, and it
// asked this package's numbering — so an author whose world declares its door at slot
// 7 could not cut one at all.
fn test_a_world_that_numbers_its_own_door_can_cut_one() {
  w = edge_world(WALL_MAT);
  a = author_at(0.0, 0.0, 0.0, REF);

  // The control: the same call, same world, no palette — refused, and by name.
  no = open_ahead(w, a, ALIEN_EDGE, 1);
  assert(!no.ak_ok,
         "slot {ALIEN_EDGE} is named by nothing and was accepted as an opening — the "
       + "row below would pass for free");

  w2 = edge_world(WALL_MAT);
  name_edge(w2, ALIEN_EDGE, "door");
  ok = open_ahead(w2, a, ALIEN_EDGE, 1);
  assert(ok.ak_ok,
         "the world calls edge slot {ALIEN_EDGE} 'door' and cutting one was refused: "
       + "{ok.ak_why}");
  // …and it landed in the store, or `ak_ok` is a statement about the doorstep only.
  (nq, nr) = hex_grid::hex_neighbor(0, 0, 0);
  assert(wall_of(w2, 0, 0, 0, REF) == ALIEN_EDGE,
         "the cut reported ok and the edge holds {wall_of(w2, 0, 0, 0, REF)}");
  assert(!walk_blocked(w2),
         "the door was cut and the walker is still refused by it");
}

// ⛔ **AND A DOOR IS NOT CUTTABLE, WHICH IS THE SAME RULE READ THE OTHER WAY.**
// `span_mark` and `open_ahead` mark a `wall` or a `fence`; a slot the world calls
// `door` is already a hole, so there is nothing there to mark.
fn test_a_world_that_calls_slot_seven_a_door_has_nothing_left_to_cut() {
  w = edge_world(ALIEN_EDGE);
  name_edge(w, ALIEN_EDGE, "door");
  a = author_at(0.0, 0.0, 0.0, REF);
  ack = open_ahead(w, a, DOOR_MAT, 1);
  assert(!ack.ak_ok,
         "the only boundary here is already this world's own door and a cut still "
       + "reported {ack.ak_n}");
}

// ── THE TWO DOORS ON THIS AXIS, for `ground_role_at`'s reason ───────────────

fn test_the_edge_name_door_and_the_edge_row_door_agree_on_every_byte() {
  w = edge_world(WALL_MAT);
  for m in 0..256 {
    assert(edge_role_at(w, 0, 0, m) == edge_kind_at(w, 0, 0, m).ek_name,
           "byte {m}: the name door says '{edge_role_at(w, 0, 0, m)}' and the row "
         + "door says '{edge_kind_at(w, 0, 0, m).ek_name}'");
  }
}

fn test_they_agree_when_the_world_has_renamed_edge_bytes_too() {
  w = edge_world(WALL_MAT);
  name_edge(w, ALIEN_EDGE, "door");
  name_edge(w, DOOR_MAT, "wall");
  name_edge(w, 8, "octtower body={WALL_BODY_OCT}");
  for m in 1..256 {
    assert(edge_role_at(w, 0, 0, m) == edge_kind_at(w, 0, 0, m).ek_name,
           "byte {m} under a palette: '{edge_role_at(w, 0, 0, m)}' against "
         + "'{edge_kind_at(w, 0, 0, m).ek_name}'");
  }
  // ⚠ AND THE CONTROL: the palette is actually being read, or the loop above compares
  // two fallbacks and proves nothing.
  assert(edge_role_at(w, 0, 0, ALIEN_EDGE) == ROLE_DOOR, "slot {ALIEN_EDGE} did not resolve");
  assert(edge_role_at(w, 0, 0, DOOR_MAT) == ROLE_WALL, "slot {DOOR_MAT} did not resolve");
}

// ⛔ **THE EDGE PALETTE HAS TWO NAMESPACES, AND `R5b` CONFLATED THEM — the suite caught
// it, which is worth a test of its own so it cannot come back.**
//
// A slot's first word is a ROLE when it is one of the reserved words and a wall TYPE's
// own NAME otherwise: `wall_type` reads `"octtower body=THICK_OCT"` and `pal_word` takes
// `octtower` off the front (`B4d`). Returning the raw string as a role made a **declared
// wall type stop being a wall** — `hex_editor/house_box`, `hex_editor/octagon` and
// `hex_mesh/planview_shape` all went red, and those are the only three files in this
// tree whose fixtures carry an edge palette at all.
//
// ⚠ **A TYPE IS A WALL**, which is `edge_is_wall`'s own doctrine restated: an undeclared
// high byte is *a wall whose type is missing*, so a declared one is a wall whose type is
// known.
fn test_a_declared_wall_type_is_a_wall_and_not_a_role_of_its_own() {
  w = flat_world();
  name_edge(w, 5, "octtower body={WALL_BODY_OCT}");
  assert(edge_role_at(w, 0, 0, 5) == ROLE_WALL,
         "a declared wall type reads as role '{edge_role_at(w, 0, 0, 5)}'");
  assert(edge_is_wall_at(w, 0, 0, 5), "and it must be masonry to every reader");
  assert(edge_kind_at(w, 0, 0, 5).ek_slope == edge_kind_of(WALL_MAT).ek_slope,
         "and it must climb like masonry");
  // ⚠ **AND THE TYPE ITSELF IS STILL READABLE** — the role reading must not have eaten
  // the declaration `B4d` puts there.
  wt = wall_type(w, 0, 5);
  assert(wt.wt_ok && wt.wt_name == "octtower" && wt.wt_body == WALL_BODY_OCT,
         "the wall type no longer reads: ok={wt.wt_ok} name='{wt.wt_name}' "
       + "body='{wt.wt_body}'");
  // …and the reserved words still win, or a world could not override a role at all.
  name_edge(w, 6, "door");
  assert(edge_role_at(w, 0, 0, 6) == ROLE_DOOR, "a slot named 'door' is not a door");
  assert(!edge_is_wall_at(w, 0, 0, 6), "and it is not masonry");
}

// ⚠ **A NAMED-BUT-UNKNOWN EDGE ROLE IS A WALL'S SLOPE AND KEEPS ITS OWN NAME** —
// `ground_kind_at`'s rule one axis over. `world_palette_check` is where an unmapped
// BYTE is refused; an unmapped NAME must not be fatal to a gesture.
fn test_a_name_this_table_has_never_heard_of_slopes_like_masonry() {
  w = edge_world(WALL_MAT);
  name_edge(w, ALIEN_EDGE, "battlement");
  assert(edge_kind_at(w, 0, 0, ALIEN_EDGE).ek_slope
         == edge_kind_of(WALL_MAT).ek_slope,
         "a battlement slopes {edge_kind_at(w, 0, 0, ALIEN_EDGE).ek_slope}, masonry "
       + "{edge_kind_of(WALL_MAT).ek_slope}");
  assert(walk_blocked(edge_world(ALIEN_EDGE)),
         "and it must still be a boundary");
}

// ⛔ **AND `run_slope` IS `edge_kind_at`'s ONE PRODUCTION CALLER, so the world's own
// fence has to reach it.** A resolver nothing calls is this tree's commonest defect,
// and a test that only asked the resolver could not see it.
fn test_the_run_limit_takes_the_worlds_own_fence_at_a_fences_slope() {
  masonry = edge_world(ALIEN_EDGE);
  base = run_slope(masonry, 0, 0);
  assert(base == edge_kind_of(WALL_MAT).ek_slope,
         "an undeclared slot limits a run at {base}, not masonry's "
       + "{edge_kind_of(WALL_MAT).ek_slope}");

  w = edge_world(ALIEN_EDGE);
  name_edge(w, ALIEN_EDGE, "fence");
  assert(run_slope(w, 0, 0) == edge_kind_of(FENCE_MAT).ek_slope,
         "the world calls slot {ALIEN_EDGE} 'fence' and the run is still held to "
       + "{run_slope(w, 0, 0)} rather than {edge_kind_of(FENCE_MAT).ek_slope}");
  assert(edge_kind_of(FENCE_MAT).ek_slope != edge_kind_of(WALL_MAT).ek_slope,
         "a fence and a wall have the same limit, so the row above cannot fail");
}

// ⛔ **AND WHAT PINNING THE TWO DOORS TOGETHER FOUND — `R5b`.** `edge_kind_of(0)` fell
// through its table and answered `wall`, slope 1: *no edge here*, reported as masonry
// that constrains a run. It was computed by nobody, because every reader skips byte 0
// before asking — `run_slope` has `if m == 0 { continue; }` on the line above its own
// call — so it could only ever be found by asking the function directly, which is what
// the equality above does on every byte a `u8` can hold.
fn test_an_unwritten_edge_is_absence_and_not_masonry() {
  assert(edge_kind_of(0).ek_name == hex_voxel::PAL_ABSENT,
         "an unwritten edge is a '{edge_kind_of(0).ek_name}'");
  assert(edge_kind_of(0).ek_slope == SLOPE_FREE,
         "an unwritten edge limits a run to {edge_kind_of(0).ek_slope}");
  // …and it did not change what the one reader answers, because that reader never
  // asks. A world of open ground has no wall to limit its runs.
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - REACH, 0 - REACH, NW, NW, 8, SURFACE_MAT);
  assert(run_slope(w, 0, 0) == SLOPE_FREE,
         "open ground limits a run to {run_slope(w, 0, 0)}");
}

// ══ THE READERS — plan 21 `R5b.2` ═══════════════════════════════════════════
//
// ⛔ **`R5b` LET A WALKER THROUGH A WORLD'S OWN DOOR AND LEFT TEN READERS COUNTING IT
// AS MASONRY.** `edge_is_wall` is a definition and stays one; its consumers each hold a
// world and a cell and each asked this package's numbering — `mark_left`, `face_at`'s
// extent, the house and region acceptance readers, `corner_write`, `corner_pool`, the
// room-add union and the run gesture's own material.
//
// ⚠ **THE FALLBACK IS WHY THE OBVIOUS FIXTURE PROVES NOTHING.** A world that declares
// its masonry at slot 7 was ALREADY read correctly, because `edge_is_wall` answers
// *wall* to every byte past the vocabulary. So the discriminating direction is the
// other one: **byte 1 named something else must stop being a wall.**

fn walled_house() -> VoxelWorld {
  w = flat_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, YAW);
  ack = press_verb(s, w, s.es_author, VB_PLACE, "");
  assert(ack.ak_ok, "the house was refused: {ack.ak_why}");
  w
}

fn name_edge_of(w: VoxelWorld, slot: integer, name: text) {
  assert(hex_voxel::world_palette_put(w, hex_voxel::PAL_EDGE, 0, slot, name)
         == hex_voxel::PAL_OK, "the edge palette refused {slot}={name}");
}

// ⚠ **THE CONTROL FIRST**: with no palette the readers must find the house's walls, or
// every row below is green for free.
fn test_the_house_readers_find_a_plain_walled_house() {
  h = house_recover(walled_house(), 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_ok, "no house recovered at all: {h.hs_why}");
  assert(h.hs_missing == 0,
         "the plain house is already {h.hs_missing} walls short — the fixture is not "
       + "a clean baseline");
}

// ⛔ **AND THE CLAIM.** A world that calls edge byte 1 `door` has no masonry anywhere,
// so the house's boundary is a boundary of openings and the reader must SAY so. Before
// `R5b.2` the reader asked the byte and answered *masonry* on every one of them.
fn test_a_world_that_calls_the_wall_byte_a_door_has_no_walls_to_recover() {
  w = walled_house();
  base = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(base.hs_ok && base.hs_missing == 0, "no clean house to un-name");

  name_edge_of(w, WALL_MAT, "door");
  h = house_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(h.hs_missing > 0,
         "edge byte {WALL_MAT} was named 'door' and the reader still found every wall "
       + "of the house ({h.hs_missing} missing)");
  // …and the FLOOR is untouched, so this is the edge axis moving and not the house
  // disappearing for some other reason.
  assert(h.hs_cells == base.hs_cells,
         "the floor moved too — {h.hs_cells} cells against {base.hs_cells}, so the "
       + "edge palette is not what changed the answer");
}

// ⚠ **AND THE REGION READER TAKES THE SAME EDGES**, for `R5a`'s reason one axis over:
// a fix that reached only the house reader would leave the plan view half decoupled.
fn test_the_region_reader_reads_a_renamed_wall_byte_too() {
  w = walled_house();
  base = region_recover(w, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(base.rg_ok, "no region recovered: {base.rg_why}");

  w2 = walled_house();
  name_edge_of(w2, WALL_MAT, "door");
  rg = region_recover(w2, 0 - 16, 0 - 16, 33, 33, 0.0);
  assert(rg.rg_missing > base.rg_missing,
         "byte {WALL_MAT} named 'door' and the region reader still sees "
       + "{rg.rg_missing} missing against {base.rg_missing}");
}

// ⛔ **AND THE UPPER BOUND OF THE STEP: with no palette the two predicates agree on
// every byte a `u8` can hold.** Every world in this corpus is such a world, so this is
// what says the eight rewired sites moved nothing.
fn test_with_no_palette_edge_is_wall_at_is_edge_is_wall_on_every_byte() {
  w = flat_world();
  for m in 0..256 {
    assert(edge_is_wall_at(w, 0, 0, m) == edge_is_wall(m),
           "byte {m}: resolved says {edge_is_wall_at(w, 0, 0, m)} and the byte says "
         + "{edge_is_wall(m)}");
  }
}

// ⚠ **AND A DECLARED WALL TYPE IS STILL A WALL** — the direction the fallback already
// got right, asserted so a future narrowing of `edge_role_at` cannot break it quietly.
fn test_a_world_that_declares_its_masonry_at_slot_seven_still_has_walls() {
  w = flat_world();
  name_edge_of(w, ALIEN_EDGE, "wall");
  assert(edge_is_wall_at(w, 0, 0, ALIEN_EDGE), "a declared wall type is not a wall");
  assert(edge_is_wall_at(w, 0, 0, WALL_MAT), "plain masonry is not a wall");
  assert(!edge_is_wall_at(w, 0, 0, 0), "absence is a wall");
  assert(!edge_is_wall_at(w, 0, 0, FENCE_MAT), "a fence is masonry");
}

// ── ⛔ AND THE SIX SITES THE SWEEP FOUND NOTHING COULD SEE — `R5b.2` ────────
//
// The first sweep of this step rewired eight readers and **only two of them went red**:
// `house_recover_claimed` and `region_recover_claimed`. The other six were green, which
// does not mean they are right — it means nothing in the tree can tell. ⚠ **No world in
// this corpus carries an edge palette**, so that is guaranteed rather than accidental,
// and a row left green is a wiring nobody has to keep.

// ⛔ **`session_run`'s material — the one an AUTHOR sees.** A wall is the line you
// walked; a fence is a road and two offsets. The gesture asked this package's numbering,
// so a world that declares its own fence at slot 7 got the WALL's shape for it.
fn test_a_world_that_declares_its_fence_at_slot_seven_lays_a_fence() {
  base = flat_world();
  s0 = session_new();
  session_at(s0, base, 2.0, 0.0, 0.0);
  session_run(s0, base, s0.es_author, ALIEN_EDGE);
  session_at(s0, base, 6.0, 0.0, 0.0);
  plain = session_run(s0, base, s0.es_author, ALIEN_EDGE);
  assert(plain.rl_code == RL_LAID, "the control run was not laid: {plain.rl_say}");
  assert(plain.rl_wall,
         "an UNDECLARED slot {ALIEN_EDGE} did not lay a wall — the row below would "
       + "pass for free");

  w = flat_world();
  name_edge_of(w, ALIEN_EDGE, "fence");
  s = session_new();
  session_at(s, w, 2.0, 0.0, 0.0);
  session_run(s, w, s.es_author, ALIEN_EDGE);
  session_at(s, w, 6.0, 0.0, 0.0);
  got = session_run(s, w, s.es_author, ALIEN_EDGE);
  assert(got.rl_code == RL_LAID, "the declared-fence run was not laid: {got.rl_say}");
  assert(!got.rl_wall,
         "the world calls slot {ALIEN_EDGE} 'fence' and the gesture still gave it the "
       + "wall's shape");
}

// ⛔ **`wall_corner_close` and `corner_write` — `B4y`'s rule, which scans for MASONRY.**
// A world whose byte-1 edges are `door` has no wall corner to close, and the join must
// stop firing. The fixture is `probe/b4y`'s pure-gap `8 × 3`, two of whose walls are
// enough: the second run reports one edge MORE than its own field when the rule fires.
fn corner_marks(w: VoxelWorld) -> integer {
  n = 0;
  for r in (0 - 18)..19 {
    for q in (0 - 18)..19 {
      for d in [4, 5, 0] {
        if wall_of(w, q, r, d, 0.0) != 0 { n = n + 1; }
      }
    }
  }
  n
}

fn stamp_wall(w: VoxelWorld, x0: float, z0: float, x1: float, z1: float) -> integer {
  d = run_between(x0, z0, x1, z1, WALL_MAT);
  assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
  rs = WallRuns { items: [] };
  m = 0;
  wall_stamp(w, d.rd_run, WALL_MAT, 8, rs, m);
  m
}

fn test_a_world_with_no_masonry_has_no_corner_to_close() {
  // The control: with no palette the corner closes, and the join shows as the second
  // wall accounting for one edge more than its own run laid down.
  a = flat_world();
  stamp_wall(a, 0.0 - 8.0, 0.0 - 3.0, 8.0, 0.0 - 3.0);
  a_before = corner_marks(a);
  stamp_wall(a, 8.0, 0.0 - 3.0, 8.0, 3.0);
  a_gain = corner_marks(a) - a_before;

  b = flat_world();
  name_edge_of(b, WALL_MAT, "door");
  stamp_wall(b, 0.0 - 8.0, 0.0 - 3.0, 8.0, 0.0 - 3.0);
  b_before = corner_marks(b);
  stamp_wall(b, 8.0, 0.0 - 3.0, 8.0, 3.0);
  b_gain = corner_marks(b) - b_before;

  assert(a_before == b_before,
         "the two fixtures' first walls differ ({a_before} against {b_before}) — the "
       + "palette is changing what is STAMPED, not what is joined");
  assert(a_gain > b_gain,
         "byte {WALL_MAT} named 'door' and the corner still closed: the second wall "
       + "gained {b_gain} edges against the plain world's {a_gain}");
}

// ⛔ **THE OCTAGON READER AS A WHOLE — and its extent scan is UNOBSERVABLE, which the
// sweep found and this comment records rather than papering over.**
//
// `oct_fits_at` scans the window for masonry to size a box, then hands that box to
// `disc_marks`, which scans it again for the same thing. So the extent scan's answer
// cannot show through the return: when it is right the marks decide, and when it is
// wrong the marks are empty and the answer is `false` either way. **Sweep row 11 cuts
// it alone and stays green**, and no fixture can change that while the two agree.
//
// ⚠ **WHICH IS EXACTLY WHY IT WAS WIRED.** The failure mode of an extent scan that
// disagrees with the marks it sizes a window for is a window NARROWER than the field —
// [`probe/tw`](../../../probe/tw/README.md)'s cliff, where clipping a structure does
// not draw a smaller picture, it stops answering. Leaving the two asking different
// questions is that defect waiting for a world with an edge palette.
//
// What this test does cover is the reader end-to-end, through `disc_marks` →
// `mark_left`: a world whose masonry is called `door` has no octagon rim at all.
fn test_the_octagon_reader_reads_a_renamed_wall_byte_too() {
  w = flat_world();
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  assert(session_select_shell(s, 12).ak_ok, "shell 12 was refused");
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the tower was refused");
  base = oct_fits_at(w, 0 - 16, 0 - 16, 33, 33, 0, 0, 12, 0.0);
  assert(base, "the plain tower does not read as an octagon, so the row below would "
             + "pass for free");

  w2 = flat_world();
  s2 = EditSession {};
  session_at(s2, w2, 0.0, 0.0, 0.0);
  assert(session_select_shell(s2, 12).ak_ok, "shell 12 was refused");
  assert(press_verb(s2, w2, s2.es_author, VB_TOWER, "").ak_ok, "the tower was refused");
  name_edge_of(w2, WALL_MAT, "door");
  after = oct_fits_at(w2, 0 - 16, 0 - 16, 33, 33, 0, 0, 12, 0.0);
  assert(base != after,
         "the same tower reads {base} plain and {after} with byte {WALL_MAT} named "
       + "'door' — the extent scan is not asking the world");
}

// ⛔ **`mark_left` — the claims machinery every peel round walks.** `marks_unclaimed`
// is its shortest public door: how many marks in this window nobody has claimed.
fn test_the_claims_scan_reads_a_renamed_wall_byte_too() {
  w = flat_world();
  stamp_wall(w, 0.0 - 8.0, 0.0 - 3.0, 8.0, 0.0 - 3.0);
  cl = claims_new(0 - 18, 0 - 18, 37, 37);
  plain = marks_unclaimed(w, 0 - 18, 0 - 18, 37, 37, 0.0, cl);
  assert(plain > 0, "the fixture left no marks to claim");

  w2 = flat_world();
  stamp_wall(w2, 0.0 - 8.0, 0.0 - 3.0, 8.0, 0.0 - 3.0);
  name_edge_of(w2, WALL_MAT, "door");
  cl2 = claims_new(0 - 18, 0 - 18, 37, 37);
  named = marks_unclaimed(w2, 0 - 18, 0 - 18, 37, 37, 0.0, cl2);
  assert(named == 0,
         "byte {WALL_MAT} is named 'door' in this world and the claims scan still "
       + "counts {named} masonry marks against the plain world's {plain}");
}

// ⛔ **`room_add`'s union — the one site that WRITES from this predicate.** It clears an
// edge the union makes interior, so reading the wrong set there rubs out a boundary.
fn test_the_room_add_union_reads_a_renamed_wall_byte_too() {
  w = walled_house();
  a = author_at(0.0, 0.0, YAW, 2.0);
  plain = room_add(w, a, 4, 4);

  w2 = walled_house();
  name_edge_of(w2, WALL_MAT, "door");
  a2 = author_at(0.0, 0.0, YAW, 2.0);
  named = room_add(w2, a2, 4, 4);
  assert(plain.ak_ok != named.ak_ok || plain.ak_n != named.ak_n,
         "the same room-add answers {plain.ak_ok}/{plain.ak_n} either side of naming "
       + "byte {WALL_MAT} 'door' — the union is not asking the world");
}
