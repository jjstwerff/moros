// M1 — THE DEFINITION LAYER AS DATA, and the equality that made it safe to move to.
//
// plan 22 `M1`, and ⚠ **`M4` HAS SINCE DELETED THE OTHER BODY.** For the length of
// `M1`–`M3` `verb_of`'s `if` chain and `keymap_default()` were two independent
// declarations, and the rows that compared them were the same shape `V1` used one
// layer down: **drive the whole key universe through both.** The chain is gone, so
// those rows are retired — see below, where what each proved and what replaces it is
// written out rather than left to a git log.
//
// ⚠ **THE UNIVERSE, NOT A LIST OF THE KEYS I EXPECT TO MATTER.** That principle
// outlived the comparison and the rows below still obey it: every letter `A`–`Z`,
// every digit, every named key and a handful of things that are not keys at all go
// through the name↔code round trip and the scan, so a key the editor can read that
// nothing asks for is caught without anybody remembering to list it.
use hex_editor;

// ⚠ EVERY KEY THIS EDITOR CAN READ, built rather than listed, so that adding a name to
// `key_code_of` and forgetting it here is not possible for the letters and digits.
fn key_universe() -> vector<text> {
  ks: vector<text> = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight",
                      "Tab", "Space", "Escape"];
  for i in 0..26 { ks += ["ABCDEFGHIJKLMNOPQRSTUVWXYZ"[i..i + 1]]; }
  for d in 0..10 { ks += ["0123456789"[d..d + 1]]; }
  // …and things that are NOT keys, which is the half a universe of real keys cannot
  // test: both resolvers must answer *nothing* rather than guessing.
  ks += ["", "zzz", "Arrow", "ctrl-b", " ", "ArrowUpp"];
  ks
}

// ── THE EQUALITY, AND WHAT OUTLIVED IT ──────────────────────────────────────
//
// ⚠ **RETIRED AT `M4`: `test_the_table_and_the_if_chain_agree_on_every_key_but_the_
// freed_aliases`.** It drove the whole key universe — 43 real keys and six things that
// are not keys — through `verb_of` and through `verb_in(keymap_default(), …)` and
// demanded the same answer everywhere but the eight aliases. **It had two declarations
// to compare and now there is one**, so it could only be rewritten as
// `verb_in(m, k) == verb_in(m, k)`. It was seen green across `M1`, `M2` and `M3`, and
// its control (*the universe reaches 23 bound keys*) is what stopped it from passing
// over keys that do nothing.
//
// What it was really protecting is that the table says what the editor's author meant
// it to say, key by key, and that survives in two places: `verb.loft`'s
// `test_the_definition_names_the_verb_each_direct_key_is_written_to_name` writes the
// pairs out in words, and `the_vocabulary()` in the same file closes the set from the
// verb end. **Moved before removed.**

// ⚠ **THE EIGHT KEYS THE TABLE DELIBERATELY DOES NOT CARRY, WITH THE VERB EACH USED TO
// REACH.** `verb_of` was not injective: `O P I U N M` all answered `opening`, `Y T`
// both `seat`, `J K V` all `annex`. Those were never eight bindings — they are `S3`'s
// collapse leaving the old keys in place, and every one of them did exactly what its
// primary does, because the profile they used to carry comes from the selection now.
//
// A definition with six `opening` rows would draw six identical slots in a bar and
// six identical rows in a rebinding list, which is the shape a person cannot use. So
// the table is **one row per verb** and these eight are free.
//
// ⚠ **THE VERB IS PAIRED WITH THE KEY SINCE `M4`, BECAUSE THE CHAIN WAS WHERE IT USED
// TO COME FROM.** `verb_of(f)` answered it; with the chain gone the pairing is history
// and has to be written down, which is also what makes the row still able to fail —
// re-binding `P` to anything, or dropping `opening` from the definition, is red.
//
// ⛔ **AND THE FREEING WAS A BEHAVIOUR CHANGE, MEASURED RATHER THAN ASSUMED SAFE.**
// Nothing in production resolves them: `tools/scripts/*.keys` says `verb <name>` for
// every gesture since `K3`, and the client's `o`/`p` send `36:1`/`36:2` straight to
// the wire and never reached the definition at all.
//
// ⚠ **`probe/k2/run.sh` KEPT THE GREP THAT HELD THE FIRST HALF, AND IT IS GONE — plan
// 22 `K3b`.** What replaced it is stronger rather than weaker: a script cannot press
// one of these keys at all now, because `key <K>` is not vocabulary in either reader
// and an unknown word FAILS the run (`K3a`, `K3b.1`). The grep policed a spelling
// that no longer parses.
// ⚠ **`T` LEFT THIS LIST WHEN `aim` TOOK IT, AND THAT IS WHAT THE LIST IS FOR.** It
// was `seat`'s alias until `Y` took that verb alone. Every other letter of the
// universe is a primary already or is `W A S D`, so these are the editor's ONLY spare
// capacity — a new verb costs one of them, and the count below is what makes the cost
// visible instead of letting a key be quietly re-used.
fn freed_aliases() -> vector<text> { ["P", "I", "U", "N", "M", "K", "V"] }

fn the_verb_each_alias_reached() -> vector<text> {
  [VB_OPENING, VB_OPENING, VB_OPENING, VB_OPENING, VB_OPENING,
   VB_ANNEX, VB_ANNEX]
}

fn test_the_keys_the_collapse_freed_are_free_and_the_verbs_they_named_survived() {
  m = keymap_default();
  fa = freed_aliases();
  fv = the_verb_each_alias_reached();
  assert(len(fa) == len(fv),
         "{len(fa)} freed keys and {len(fv)} verbs beside them — the pairing has a "
       + "hole in it and every row below reads past the end of one list");
  for i in 0..len(fa) {
    f = fa[i] ?? "";
    v = fv[i] ?? "";
    // It is free in the table…
    assert(verb_in(m, f) == VB_NONE,
           "'{f}' is listed as freed and the table binds it to '{verb_in(m, f)}'");
    // …and NO VERB WENT WITH IT, which is the whole claim: the verb it used to name is
    // still reachable, from a different key.
    assert(key_for(m, v) != "",
           "'{f}' reached verb '{v}' and the table gives that verb no key at all — "
         + "this is a lost gesture, not a freed duplicate");
    assert(key_for(m, v) != f,
           "'{f}' is listed as freed and is still the primary for '{v}'");
  }
  // ⚠ **AND THE EIGHT ARE THE ONLY ONES**, which is the half that stops the list from
  // being an escape hatch. It used to be closed by the chain's count (23 keys, 15
  // verbs, 8 freed); with the chain gone it is closed against the key universe — every
  // letter the editor can read is either a primary in the table or one of these eight
  // or genuinely nothing, and a ninth key quietly freed by dropping its row is caught
  // by `the_vocabulary()` in `verb.loft` losing a key.
  loose = 0;
  for k in key_universe() {
    if verb_in(m, k) == VB_NONE && is_freed(k) { loose = loose + 1; }
  }
  assert(loose == len(fa),
         "{loose} of the eight freed aliases are free in the table — the rest are "
       + "bound again, and the collapse has been half undone");
}

fn is_freed(k: text) -> boolean {
  for f in freed_aliases() { if f == k { return true; } }
  false
}

// ⚠ **AND THE SAME ANSWER FROM A HARDWARE CODE**, which is the half the client needs
// and the half no script can exercise. A GL driver never sees the name.
fn test_a_code_resolves_to_what_its_name_resolves_to() {
  m = keymap_default();
  hit = 0;
  for k in key_universe() {
    c = key_code_of(k);
    if c != KEY_NONE {
      assert(verb_at_code(m, c) == verb_in(m, k),
             "key '{k}' is code {c}: by name '{verb_in(m, k)}', by code "
           + "'{verb_at_code(m, c)}'");
      if verb_at_code(m, c) != VB_NONE { hit = hit + 1; }
    }
  }
  assert(hit == 17, "{hit} codes reached a verb where the definition has 17");
}

// ⚠ **THE UNBOUND VERB IS `""`, AND `keymap.loft` CANNOT SAY SO.** It is the mechanism
// and knows no verb names; the root module owns `VB_NONE`. This file sees both, so the
// equality is a test rather than a comment claiming it — `SLAB_PAD`'s shape exactly.
fn test_the_mechanisms_unbound_verb_is_the_vocabularys_none() {
  assert(VB_NONE == "",
         "`keymap.loft` answers '' for unbound and the vocabulary's VB_NONE is "
       + "'{VB_NONE}' — the two have drifted apart");
}

// ── NAMES AND CODES ─────────────────────────────────────────────────────────

fn test_a_name_and_its_code_round_trip_for_every_key_there_is() {
  named = 0;
  for k in key_universe() {
    c = key_code_of(k);
    if c == KEY_NONE {
      // Not a key: it must not round-trip INTO one, which is the direction that
      // silently invents a binding.
      assert(key_name_of(c) == "",
             "'{k}' is not a key and code {c} names '{key_name_of(c)}'");
    } else {
      named = named + 1;
      // ⚠ THE LETTERS ROUND-TRIP TO UPPER CASE, which is the definition's spelling —
      // `tools/scripts/*.keys` writes `key B`. A lower-case name is accepted going in
      // and normalised coming out, so a UI shows one spelling.
      assert(key_code_of(key_name_of(c)) == c,
             "'{k}' is code {c}, which names '{key_name_of(c)}', which is code "
           + "{key_code_of(key_name_of(c))}");
    }
  }
  assert(named == 43,
         "{named} of the universe are keys — 26 letters, 10 digits and 7 named");
}

// ⛔ **THE ROW THAT CAUGHT A REAL BUG BEFORE IT SHIPPED.** Without the length test in
// `key_code_of`, `"ArrowUp"` falls through to the letter loop on its first character
// and answers 97 — the code for `A`. That is a binding that WORKS, points at the
// wrong key, and never says so.
fn test_a_long_name_is_not_read_as_its_first_letter() {
  assert(key_code_of("ArrowUp") != key_code_of("A"),
         "'ArrowUp' and 'A' are both code {key_code_of(\"A\")}");
  assert(key_code_of("ArrowUp") == 128, "'ArrowUp' is code {key_code_of(\"ArrowUp\")}");
  for bad in ["Arrow", "ArrowUpp", "zzz", "ctrl-b", "Ban"] {
    assert(key_code_of(bad) == KEY_NONE,
           "'{bad}' is not a key and answers code {key_code_of(bad)}");
  }
}

// ── THE QUERY ───────────────────────────────────────────────────────────────

// ⚠ **THE VERB SET IS A QUERY, AND THIS IS THE ROW THAT SAYS IT ANSWERS THE TRUTH.**
// Every verb the definition lists has to be bound, or the bar draws a slot that does
// nothing.
//
// ⛔ **AND ITS SECOND HALF WAS RETIRED AT `M4` BECAUSE IT NEVER DID WHAT IT SAID.** It
// walked the key universe through `verb_of` and asserted each verb the chain named had
// a key in the table, under a comment claiming it *"catches a verb added to `press_verb`
// with no way to reach it"*. It could not: a verb `press_verb` binds and the chain never
// named was invisible to it, and that is the case the comment describes. **Measured
// before it was believed** — an arm added to `press_verb` for a verb bound nowhere else
// left the suite at **522 passed**, which is the *built and never called* defect passing
// the row written to catch it. What it actually caught was a verb in the CHAIN missing
// from the TABLE, which is the retired equality's job and went with it.
//
// The claim it was aiming at lives in `verb.loft` now, as `the_vocabulary()` — every
// verb this editor has, listed once, checked against the definition in both directions
// and against `press_verb`. ⚠ Read its note: one case is still invisible and it is
// named there rather than covered by a comment.
fn test_every_verb_the_definition_lists_is_bound() {
  m = keymap_default();
  vs = keymap_verbs(m);
  w = flat_world();
  s = EditSession {};
  a = author_on(w, 0.0, 0.0, 0.0);
  // The control: an empty definition would satisfy the loop below by having nothing
  // in it, which is the shape a query that lost its rows returns.
  assert(len(vs) == 17,
         "the definition lists {len(vs)} verbs — this row is walking a set that is "
       + "not the editor's vocabulary");
  for v in vs {
    ack = press_verb(s, w, a, v);
    assert(ack.ak_why != PR_NONE,
           "the definition lists verb '{v}' and nothing is bound to it");
  }
}

fn test_a_key_can_be_asked_for_a_verb_and_a_verb_for_its_key() {
  m = keymap_default();
  for v in keymap_verbs(m) {
    k = key_for(m, v);
    assert(k != "", "verb '{v}' is in the definition and has no key");
    assert(verb_in(m, k) == v,
           "verb '{v}' says key '{k}' and key '{k}' says verb '{verb_in(m, k)}'");
  }
  assert(key_for(m, "no-such-verb") == "",
         "an unknown verb answered key '{key_for(m, \"no-such-verb\")}'");
}

// ── REBINDING ───────────────────────────────────────────────────────────────

// ⚠ **THE FREE-KEY CASE FIRST, AND IT IS THE RARE ONE.** Every letter is taken, so a
// rebind onto a genuinely unused key needs a digit.
fn test_binding_a_verb_to_a_free_key_moves_it_and_frees_the_old_one() {
  m = keymap_default();
  before = key_for(m, VB_CELLAR);
  assert(before == "C", "the cellar starts on '{before}'");
  r = keymap_bind(m, "5", VB_CELLAR);
  assert(r.bm_ok, "binding the cellar to a free key was refused: {r.bm_say}");
  assert(r.bm_took == "", "'5' displaced verb '{r.bm_took}'");
  assert(r.bm_freed == "C", "the cellar reports leaving '{r.bm_freed}'");
  assert(key_for(m, VB_CELLAR) == "5", "the cellar is on '{key_for(m, VB_CELLAR)}'");
  assert(verb_in(m, "5") == VB_CELLAR, "'5' names '{verb_in(m, \"5\")}'");
  // ⚠ **AND THE OLD KEY IS FREE, WHICH IS THE HALF A NAIVE REBIND LEAVES BEHIND.** A
  // map that added a row instead of moving one answers the cellar to BOTH keys, and
  // `key_for` — which returns the first — would keep saying `C` for ever.
  assert(verb_in(m, "C") == VB_NONE,
         "'C' still names '{verb_in(m, \"C\")}' after the cellar moved off it");
  assert(verb_at_code(m, key_code_of("C")) == VB_NONE,
         "the code for 'C' still reaches '{verb_at_code(m, key_code_of(\"C\"))}'");
}

// ⚠ **A COLLISION IS THE NORMAL CASE**, because all 26 letters are taken. It replaces
// and says what it displaced, and the displaced verb keeps its row with no key.
fn test_binding_over_a_taken_key_displaces_the_verb_that_had_it_and_says_so() {
  m = keymap_default();
  r = keymap_bind(m, "C", VB_STOREY);
  assert(r.bm_ok, "a collision was refused: {r.bm_say}");
  assert(r.bm_took == VB_CELLAR, "'C' displaced '{r.bm_took}'");
  assert(r.bm_freed == "B", "the storey reports leaving '{r.bm_freed}'");
  assert(r.bm_say.contains(VB_CELLAR),
         "the sentence does not name what lost its key: '{r.bm_say}'");
  assert(key_for(m, VB_STOREY) == "C", "the storey is on '{key_for(m, VB_STOREY)}'");
  // ⚠ **THE DISPLACED VERB IS STILL THERE, WITH NO KEY.** A verb that vanished would
  // look like a feature you had deleted; an empty slot says *this still exists and you
  // have no key for it*, which a bar can draw.
  assert(key_for(m, VB_CELLAR) == "",
         "the cellar kept key '{key_for(m, VB_CELLAR)}' after losing it");
  assert(verb_is_known(m, VB_CELLAR), "the cellar was dropped from the definition");
  assert(len(keymap_verbs(m)) == 17,
         "the definition has {len(keymap_verbs(m))} verbs after a rebind — a rebind "
       + "moves a row and must neither add nor drop one");
  // …and `B`, which the storey left, is free for something else now.
  assert(verb_in(m, "B") == VB_NONE, "'B' still names '{verb_in(m, \"B\")}'");
}

// ⚠ **AND THE MAP IS STILL ONE ROW PER VERB AFTER A SWAP**, which is the property
// `key_for` and every bar reader assume and which two separate rebinds could break.
fn test_two_verbs_can_trade_keys_and_the_definition_stays_one_row_per_verb() {
  m = keymap_default();
  keymap_bind(m, "9", VB_STOREY);      // park the storey
  keymap_bind(m, "B", VB_CELLAR);      // the cellar takes B
  keymap_bind(m, "C", VB_STOREY);      // and the storey takes C
  assert(key_for(m, VB_STOREY) == "C" && key_for(m, VB_CELLAR) == "B",
         "after the trade the storey is on '{key_for(m, VB_STOREY)}' and the cellar "
       + "on '{key_for(m, VB_CELLAR)}'");
  assert(verb_in(m, "B") == VB_CELLAR && verb_in(m, "C") == VB_STOREY,
         "'B' names '{verb_in(m, \"B\")}' and 'C' names '{verb_in(m, \"C\")}'");
  assert(verb_in(m, "9") == VB_NONE, "the parking key still names '{verb_in(m, \"9\")}'");
  assert(len(keymap_verbs(m)) == 17,
         "the definition has {len(keymap_verbs(m))} rows after three rebinds");
}

// ⚠ **A REBIND MAY NOT INVENT A VERB.** `keymap_bind` MOVES a row, so a name with no
// row would bind nothing and report success — the *built and never called* defect
// reached through a typo.
fn test_a_rebind_refuses_a_verb_the_editor_does_not_have() {
  m = keymap_default();
  r = keymap_bind(m, "5", "tunnel");
  assert(!r.bm_ok, "'tunnel' is not a verb and the rebind reported success");
  assert(r.bm_say.contains("tunnel"), "the refusal does not name it: '{r.bm_say}'");
  assert(verb_in(m, "5") == VB_NONE, "'5' now names '{verb_in(m, \"5\")}'");
  assert(len(keymap_verbs(m)) == 17,
         "a refused rebind left {len(keymap_verbs(m))} rows");
}

fn test_a_rebind_refuses_a_key_the_editor_cannot_read() {
  m = keymap_default();
  for bad in [".", "ctrl-b", "", "Arrow"] {
    r = keymap_bind(m, bad, VB_CELLAR);
    assert(!r.bm_ok, "'{bad}' is not a key and binding to it reported success");
  }
  assert(key_for(m, VB_CELLAR) == "C",
         "the cellar moved to '{key_for(m, VB_CELLAR)}' through a refused rebind");
}

// ── ARM, PICK, PRESS — plan 22 `M3` ─────────────────────────────────────────
//
// The rows above test the EDIT; these test the gesture that reaches it from inside a
// running editor. ⚠ **The one they exist for is the settle**, and it is worth saying
// why it is not obvious: the client POLLS, so the key that completes a rebind is still
// physically down on the next frame, and the freshly-bound verb sees a rising edge.
// Without `RB_SETTLE` the rebind performs the verb it was defining — and a raise fired
// that way is indistinguishable from a correct one at every instrument in this tree.

fn test_arming_takes_the_keyboard_and_the_arm_key_gives_it_back() {
  rb = rebind_new();
  assert(!rebind_holds(rb), "a fresh rebinder already holds the keyboard");
  assert(rb.rb_at == RB_OFF, "a fresh rebinder is in state {rb.rb_at}");
  rebind_arm(rb);
  assert(rebind_holds(rb), "arming did not take the keyboard");
  assert(rb.rb_at == RB_ARMED, "arming reached state {rb.rb_at}");
  assert(rb.rb_say != "", "arming said nothing — the person has no way to know");
  rebind_arm(rb);
  assert(!rebind_holds(rb), "the arm key did not hand the keyboard back");
  assert(rb.rb_at == RB_OFF, "cancelling reached state {rb.rb_at}");
}

// ⚠ **THE ARM KEY MUST NAME NO VERB, or arming IS a gesture.** This is the row that
// would go red the day somebody adds `bind_of("Escape", …)` to the default layout,
// which is otherwise a perfectly reasonable-looking edit.
fn test_the_arm_key_names_no_verb_in_the_definition() {
  m = keymap_default();
  assert(verb_at_code(m, KEY_REBIND) == VB_NONE,
         "the arm key reaches verb '{verb_at_code(m, KEY_REBIND)}' — arming it would "
       + "fire a gesture");
  assert(key_name_of(KEY_REBIND) == "Escape",
         "the arm key is code {KEY_REBIND}, which names '{key_name_of(KEY_REBIND)}'");
}

// A key pressed while merely ARMED has no verb to name, so it must bind nothing —
// and it must not end the rebinding either, or a stray keystroke cancels the gesture.
fn test_a_key_pressed_before_a_verb_is_picked_binds_nothing() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  r = rebind_press(rb, m, key_code_of("5"));
  assert(!r.bm_ok, "a key pressed with nothing picked reported a bind: {r.bm_say}");
  assert(verb_in(m, "5") == VB_NONE, "'5' now names '{verb_in(m, \"5\")}'");
  assert(rb.rb_at == RB_ARMED,
         "a key pressed with nothing picked moved the machine to {rb.rb_at}");
}

// ── THE WHOLE GESTURE ───────────────────────────────────────────────────────

fn test_arm_pick_press_moves_the_verb_and_the_old_key_goes_dead() {
  m = keymap_default();
  rb = rebind_new();
  assert(verb_at_code(m, key_code_of("ArrowUp")) == VB_RAISE,
         "the fixture starts with raise somewhere else");
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  assert(rb.rb_at == RB_PICKED, "picking a verb reached state {rb.rb_at}");
  assert(rb.rb_verb == VB_RAISE, "the machine picked '{rb.rb_verb}'");
  // ⚠ THE PROMPT NAMES THE KEY THE VERB HAS NOW, which is half of what the person
  // needs before they choose a new one.
  assert(rb.rb_say.contains("ArrowUp"),
         "the prompt does not say where raise is now: '{rb.rb_say}'");
  r = rebind_press(rb, m, key_code_of("5"));
  assert(r.bm_ok, "the rebind was refused: {r.bm_say}");
  // The claim, asked the way the CLIENT asks it — by code, because a GL driver never
  // sees a name.
  assert(verb_at_code(m, key_code_of("5")) == VB_RAISE,
         "'5' reaches '{verb_at_code(m, key_code_of(\"5\"))}'");
  assert(verb_at_code(m, key_code_of("ArrowUp")) == VB_NONE,
         "the old key still reaches '{verb_at_code(m, key_code_of(\"ArrowUp\"))}' — a "
       + "rebind that adds a row instead of moving one leaves both live");
  assert(len(keymap_verbs(m)) == 17,
         "the definition has {len(keymap_verbs(m))} rows after a rebind through the "
       + "machine");
}

// ⛔ **THE ROW THIS STEP EXISTS FOR.** The completing key is still down, and the verb
// it now names must not fire.
fn test_the_key_that_completed_the_rebind_is_held_until_it_comes_up() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  code = key_code_of("5");
  rebind_press(rb, m, code);
  assert(rb.rb_at == RB_SETTLE, "a completed bind reached state {rb.rb_at}");
  assert(rb.rb_code == code, "the machine is holding code {rb.rb_code}, not {code}");
  // ⚠ **STILL HOLDING, WHICH IS THE WHOLE POINT** — the client's fence reads exactly
  // this, so a machine that answered `false` here would let the edge through.
  assert(rebind_holds(rb),
         "the keyboard was handed back with the completing key still down — the verb "
       + "just bound fires on the next frame");
  rebind_release(rb, true);
  assert(rebind_holds(rb) && rb.rb_at == RB_SETTLE,
         "the machine let go while the key was still reported down");
  rebind_release(rb, false);
  assert(!rebind_holds(rb), "the machine kept the keyboard after the key came up");
  assert(rb.rb_at == RB_OFF, "a released rebinder is in state {rb.rb_at}");
  // …and the sentence survives, because it is what the person is reading.
  assert(rb.rb_say != "", "the report was cleared when the key came up");
}

// ⚠ A COLLISION IS THE NORMAL CASE — every letter is taken — so the gesture's job is
// to SAY what it displaced rather than to refuse.
fn test_a_rebind_from_the_editor_reports_what_it_displaced() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_STOREY);
  r = rebind_press(rb, m, key_code_of("C"));
  assert(r.bm_ok, "a collision was refused: {r.bm_say}");
  assert(r.bm_took == VB_CELLAR, "'C' displaced '{r.bm_took}'");
  assert(rb.rb_say.contains(VB_CELLAR),
         "what the person reads does not name what lost its key: '{rb.rb_say}'");
  assert(key_for(m, VB_CELLAR) == "",
         "the cellar kept key '{key_for(m, VB_CELLAR)}'");
  assert(verb_is_known(m, VB_CELLAR),
         "the displaced verb was dropped — its slot must stay, blank");
}

// ── WHAT MUST NOT HAPPEN ────────────────────────────────────────────────────

fn test_a_pick_can_be_changed_and_only_the_second_verb_moves() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  rebind_pick(rb, m, VB_LOWER);        // the mis-click, corrected
  assert(rb.rb_verb == VB_LOWER, "the machine still holds '{rb.rb_verb}'");
  rebind_press(rb, m, key_code_of("5"));
  assert(verb_in(m, "5") == VB_LOWER, "'5' names '{verb_in(m, \"5\")}'");
  assert(key_for(m, VB_RAISE) == "ArrowUp",
         "raise moved to '{key_for(m, VB_RAISE)}' and it was never the pick");
}

fn test_a_key_the_editor_cannot_read_leaves_the_pick_standing() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_CELLAR);
  for bad in [13, 132, 133, 999, KEY_NONE] {
    r = rebind_press(rb, m, bad);
    assert(!r.bm_ok, "code {bad} is not a key and reported a bind");
    // ⚠ **STILL PICKED**, which is the difference between *try another key* and
    // *rebinding is over*. A machine that dropped the pick here would make an
    // unmapped keystroke feel like the feature breaking.
    assert(rb.rb_at == RB_PICKED,
           "code {bad} moved the machine to {rb.rb_at} instead of leaving the pick");
  }
  assert(key_for(m, VB_CELLAR) == "C",
         "the cellar moved to '{key_for(m, VB_CELLAR)}' through refused presses");
}

// ⚠ **YOU CANNOT BIND AWAY YOUR OWN WAY OUT.** In the client the arm key is handled
// before the scan and means cancel, so this is the guard for a driver that has only a
// code — and for the day somebody adds a second one.
fn test_the_arm_key_cannot_be_bound_to_a_verb() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_CELLAR);
  r = rebind_press(rb, m, KEY_REBIND);
  assert(!r.bm_ok, "the arm key was bound to a verb");
  assert(verb_at_code(m, KEY_REBIND) == VB_NONE,
         "the arm key now reaches '{verb_at_code(m, KEY_REBIND)}'");
  assert(rb.rb_at == RB_PICKED, "refusing the arm key moved the machine to {rb.rb_at}");
}

fn test_cancelling_a_pick_binds_nothing() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_CELLAR);
  rebind_arm(rb);                       // Escape again
  assert(!rebind_holds(rb), "cancelling left the keyboard with the rebinder");
  assert(rb.rb_verb == "", "a cancelled machine still holds '{rb.rb_verb}'");
  r = rebind_press(rb, m, key_code_of("5"));
  assert(!r.bm_ok, "a key after a cancel reported a bind: {r.bm_say}");
  assert(key_for(m, VB_CELLAR) == "C",
         "the cellar moved to '{key_for(m, VB_CELLAR)}' across a cancel");
}

fn test_a_pick_refuses_a_verb_the_editor_does_not_have() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, "tunnel");
  assert(rb.rb_at == RB_ARMED, "an unknown verb was picked — state {rb.rb_at}");
  assert(rb.rb_verb == "", "the machine picked '{rb.rb_verb}'");
  assert(rb.rb_say.contains("tunnel"), "the refusal does not name it: '{rb.rb_say}'");
}

// A pick with nothing armed must not arm, or a stray click on the bar starts a
// rebinding nobody asked for.
fn test_a_pick_with_nothing_armed_does_nothing() {
  m = keymap_default();
  rb = rebind_new();
  rebind_pick(rb, m, VB_CELLAR);
  assert(rb.rb_at == RB_OFF, "picking with nothing armed reached state {rb.rb_at}");
  assert(!rebind_holds(rb), "a stray pick took the keyboard");
}

// ── THE SCAN ────────────────────────────────────────────────────────────────
//
// ⚠ **BOTH DIRECTIONS, because either alone is satisfied by a mistake.** A scan
// missing the digits still passes *every code names a key*; a scan of every integer
// still passes *every key is in the scan*.
fn test_every_key_the_editor_can_read_is_in_the_scan_and_nothing_else_is() {
  cs = key_codes();
  for k in key_universe() {
    c = key_code_of(k);
    if c == KEY_NONE { continue; }
    found = false;
    for s in cs { if s == c { found = true; } }
    assert(found, "'{k}' is code {c} and the scan would never ask for it");
  }
  for s2 in cs {
    assert(key_name_of(s2) != "",
           "the scan asks for code {s2}, which names no key");
  }
  // The count closes it — 26 letters, 10 digits, 7 named — and it is the same 43 the
  // round-trip row counts from the other side.
  assert(len(cs) == 43, "the scan asks for {len(cs)} codes where the editor reads 43");
}

// ── A FRESH PRESS — plan 22 `M5` ────────────────────────────────────────────
//
// ⛔ **THE ROW THIS STEP EXISTS FOR.** `gl_key_pressed` answers *is it down*, so a key
// held from before the pick reads identically to one just struck — and the editor binds
// it. Walk forward on `w`, press `Escape` with the other hand, click a slot: `w` names
// the verb before the person has chosen anything.
//
// ⚠ **THE FIXTURE IS THE CLIENT'S SHAPE, NOT A CONVENIENT ONE.** Each call is one
// FRAME's whole observation — the codes down at that instant — because that is the only
// thing a poller can hand over, and a per-code question could not see a release.

fn test_a_key_already_down_when_the_verb_is_picked_names_nothing() {
  m = keymap_default();
  rb = rebind_new();
  w = key_code_of("W");
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  // Frame 1 — the seed. `w` has been down since before the gesture began.
  assert(rebind_scan(rb, [w]) == KEY_NONE,
         "the first look fired instead of seeding — a key held from before the pick "
       + "named the verb");
  // …and it stays stale for as long as it stays down, which is the half a one-frame
  // guard would miss.
  for _f in 0..8 {
    assert(rebind_scan(rb, [w]) == KEY_NONE,
           "a key that never moved read as freshly pressed");
  }
  assert(rb.rb_at == RB_PICKED, "the machine left RB_PICKED at state {rb.rb_at}");
  assert(verb_in(m, "W") == VB_NONE, "'W' now names '{verb_in(m, \"W\")}'");
}

// ⚠ **AND THE SILENCE IS SAID.** Before this step a held key bound itself — wrong, and
// visible; after it the key does nothing, and a person holding the one they meant needs
// to be told why.
fn test_a_key_already_down_is_named_rather_than_ignored_in_silence() {
  m = keymap_default();
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  quiet = rb.rb_say;
  rebind_scan(rb, [key_code_of("W")]);
  assert(rb.rb_say != quiet, "the seed found a key down and said nothing about it");
  assert(rb.rb_say.contains("W"),
         "the report does not name the key that is down: '{rb.rb_say}'");
  assert(rb.rb_say.contains(VB_RAISE),
         "the report forgot which verb is waiting: '{rb.rb_say}'");
  // ⚠ AND AN EMPTY KEYBOARD SAYS NOTHING, or the prompt that names the verb's current
  // key would be overwritten on the next frame by a sentence about nothing.
  rb2 = rebind_new();
  rebind_arm(rb2);
  rebind_pick(rb2, m, VB_RAISE);
  before = rb2.rb_say;
  rebind_scan(rb2, []);
  assert(rb2.rb_say == before,
         "a seed with no key down replaced the prompt with '{rb2.rb_say}'");
}

// The other side of the same rule, and without it the row above is satisfied by a scan
// that never answers at all.
fn test_a_key_pressed_after_the_pick_names_the_verb() {
  m = keymap_default();
  rb = rebind_new();
  five = key_code_of("5");
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  assert(rebind_scan(rb, []) == KEY_NONE, "the seed answered with nothing down");
  assert(rebind_scan(rb, [five]) == five,
         "a key struck after the pick did not name the verb");
  r = rebind_press(rb, m, five);
  assert(r.bm_ok, "the bind the scan found was refused: {r.bm_say}");
  assert(verb_at_code(m, five) == VB_RAISE, "'5' reaches '{verb_at_code(m, five)}'");
}

// ⚠ **A RELEASE IS WHAT MAKES THE NEXT PRESS FRESH**, and this is the row that says the
// staleness is not permanent — a guard that simply refused whatever was down at the
// seed would pass every row above and lock the key out for the rest of the gesture.
fn test_a_held_key_binds_once_it_is_released_and_pressed_again() {
  m = keymap_default();
  rb = rebind_new();
  w = key_code_of("W");
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  assert(rebind_scan(rb, [w]) == KEY_NONE, "the seed bound the held key");
  assert(rebind_scan(rb, []) == KEY_NONE, "an empty keyboard named a verb");
  assert(rebind_scan(rb, [w]) == w,
         "the key was released and pressed again and still did not count");
  r = rebind_press(rb, m, w);
  assert(r.bm_ok, "the second press was refused: {r.bm_say}");
  assert(verb_at_code(m, w) == VB_RAISE, "'W' reaches '{verb_at_code(m, w)}'");
}

// ⚠ **A RE-PICK CARRIES THE SCAN'S MEMORY RATHER THAN RESEEDING IT**, and the obvious
// symmetry — *every pick starts a fresh observation* — is what this row refuses.
// `rb_down` has been watching the keyboard continuously since the first pick, so the key
// held across a corrected mis-click is ALREADY known to be stale and nothing has to be
// re-established.
//
// ⛔ **AND THE SECOND HALF IS THE FALSIFIABLE ONE, WHICH IS WHY IT IS HERE.** The first
// is true under a reseed as well — reseeding makes the held key stale too — so a row
// that asked only that could not see the difference it exists to state, and was green
// under every sabotage in `probe/k2/sabotage-m5.sh` when it was written that way. What
// a reseed actually costs is a key struck in the same frame as the second click.
fn test_a_corrected_mis_click_keeps_the_held_key_stale_and_the_struck_one_fresh() {
  m = keymap_default();
  w = key_code_of("W");
  five = key_code_of("5");
  rb = rebind_new();
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  rebind_scan(rb, [w]);
  rebind_scan(rb, [w]);
  rebind_pick(rb, m, VB_LOWER);
  assert(rb.rb_verb == VB_LOWER, "the second pick chose '{rb.rb_verb}'");
  assert(rebind_scan(rb, [w]) == KEY_NONE,
         "the key held across a re-pick named the second verb");
  assert(verb_in(m, "W") == VB_NONE, "'W' now names '{verb_in(m, \"W\")}'");
  // …and the half a reseed would break: the person clicks the right slot and strikes
  // the key, and the press must not be eaten by the correction.
  rb2 = rebind_new();
  rebind_arm(rb2);
  rebind_pick(rb2, m, VB_RAISE);
  rebind_scan(rb2, []);
  rebind_pick(rb2, m, VB_LOWER);
  assert(rebind_scan(rb2, [five]) == five,
         "a key struck in the same frame as a corrected mis-click was swallowed");
}

// ⛔ **ARMING IS WHERE THE MEMORY IS DROPPED, AND IT IS THE ONE GAP THE SCAN DOES NOT
// WATCH.** Nothing observes the keyboard between a cancel and the next pick, so a
// `rb_down` carried across that gap describes a keyboard the person has since changed —
// and the key they took hold of in between reads as *already seen*, which is the rule
// inverted. ⚠ **The fixture has to scan with NOTHING down before the cancel**, or the
// stale memory happens to hold the right answer and the row cannot see the difference.
fn test_a_key_taken_up_between_two_gestures_is_not_fresh_at_the_second() {
  m = keymap_default();
  rb = rebind_new();
  w = key_code_of("W");
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  rebind_scan(rb, []);                   // nothing was down during the first gesture
  rebind_arm(rb);                        // cancel
  assert(rb.rb_at == RB_OFF, "cancelling reached state {rb.rb_at}");
  // …and now the person goes back to walking, which nothing is watching.
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  assert(rebind_scan(rb, [w]) == KEY_NONE,
         "a key taken up between two gestures read as freshly pressed at the second");
  assert(verb_in(m, "W") == VB_NONE, "'W' now names '{verb_in(m, \"W\")}'");
}

// The scan is only ever the picked state's question. ⚠ It must not remember anything
// outside it either, or the seed for the next pick was taken at the wrong moment.
fn test_the_scan_answers_nothing_unless_a_verb_is_picked() {
  rb = rebind_new();
  five = key_code_of("5");
  assert(rebind_scan(rb, [five]) == KEY_NONE, "a resting rebinder read the keyboard");
  rebind_arm(rb);
  assert(rebind_scan(rb, [five]) == KEY_NONE, "an armed rebinder named a verb");
  assert(!rb.rb_seen, "the scan seeded itself outside RB_PICKED");
}

// ⚠ **THE SEED IS AN OBSERVATION AND NOT A KEY**, so more than one held key is stale and
// a key struck beside them is still found. A machine that remembered one code would
// pass every row above.
fn test_one_fresh_key_is_found_among_several_that_were_already_down() {
  m = keymap_default();
  rb = rebind_new();
  w = key_code_of("W");
  a = key_code_of("A");
  five = key_code_of("5");
  rebind_arm(rb);
  rebind_pick(rb, m, VB_RAISE);
  assert(rebind_scan(rb, [w, a]) == KEY_NONE, "the seed with two keys down fired");
  assert(rebind_scan(rb, [w, a]) == KEY_NONE, "two keys that never moved read as fresh");
  assert(rebind_scan(rb, [w, a, five]) == five,
         "the fresh key was missed among the two that were already down");
}

// ⚠ **A BAR HAS A SLOT'S WIDTH, AND TRUNCATION IS WHAT IT MUST NOT DO.** `stair_up`
// and `stair_down` share five characters, so a truncating bar draws two identical
// slots — which is the failure `client_panel_spec`'s hotkey column already had, where
// "drag" cut to "d" and read as *press d*.
fn test_no_two_verbs_share_a_short_label() {
  m = keymap_default();
  vs = keymap_verbs(m);
  for i in 0..len(vs) {
    for j in 0..len(vs) {
      if i != j {
        assert(verb_short(vs[i] ?? "") != verb_short(vs[j] ?? ""),
               "'{vs[i] ?? \"\"}' and '{vs[j] ?? \"\"}' both draw as "
             + "'{verb_short(vs[i] ?? \"\")}'");
      }
    }
  }
}

fn test_a_short_label_fits_a_slot_and_an_unknown_verb_still_draws() {
  for v in keymap_verbs(keymap_default()) {
    assert(len(verb_short(v)) > 0 && len(verb_short(v)) <= 4,
           "verb '{v}' draws as '{verb_short(v)}', which is {len(verb_short(v))} "
         + "characters where a slot has 4");
  }
  // ⚠ AND A VERB THIS TABLE HAS NOT BEEN TAUGHT DRAWS UNDER ITS OWN NAME — long, and
  // correct — where a blank would read as a slot that does nothing.
  assert(verb_short("tunnel") == "tunnel",
         "an unlisted verb draws as '{verb_short(\"tunnel\")}'");
}

// ── THE MAP OUTLIVES THE PAGE — plan 22 `M5b` ───────────────────────────────
//
// ⚠ **THESE ROWS ARE ABOUT THE DOCUMENT, NOT THE DISK.** `keymap_delta` and
// `keymap_apply` are pure, so the whole rule is testable with no filesystem — and the
// one claim that needs a real page (*does a `--html` build have `fs_write_text`*) is a
// probe rather than a test, because a loft suite runs on the interpreter.

fn test_a_map_nobody_changed_writes_a_document_with_no_bindings_in_it() {
  d = keymap_delta(keymap_default(), keymap_default());
  assert(d.trim() == KEYMAP_DOC, "an untouched map wrote bindings: [{d}]");
}

fn test_a_rebound_map_round_trips_through_its_document() {
  m = keymap_default();
  keymap_bind(m, "5", VB_RAISE);
  keymap_bind(m, "7", VB_CELLAR);
  doc = keymap_delta(m, keymap_default());
  back = keymap_default();
  r = keymap_apply(back, doc);
  assert(r.kd_ok, "the document was refused: {r.kd_say}");
  // ⚠ EVERY ROW, not the two that were touched: a document that dropped an untouched
  // binding would pass a check that only asked about its own subject.
  for b in m.km_items {
    assert(key_for(back, b.kb_verb) == b.kb_key,
           "'{b.kb_verb}' came back on '{key_for(back, b.kb_verb)}' and was on "
         + "'{b.kb_key}'");
  }
  assert(len(keymap_verbs(back)) == len(keymap_verbs(m)),
         "the round trip changed the number of rows");
}

// ⛔ **THE ROW THE FORMAT WAS DESIGNED AROUND, worked on paper before it was written.**
// Default `A=1 B=2 C=3`; bind `B` to `1`, then bind `B` to `3`. The map is
// `A="" B=3 C=""`, and the only non-default row WITH a key is `B=3` — so a document
// holding just that, replayed onto a default, leaves `A` on `1`, a key its owner lost
// two gestures ago.
fn test_a_verb_left_with_no_key_is_recorded_and_comes_back_with_none() {
  m = keymap_default();
  keymap_bind(m, key_for(m, VB_LOWER), VB_RAISE);      // raise takes lower's key
  assert(key_for(m, VB_LOWER) == "", "the fixture did not displace lower");
  doc = keymap_delta(m, keymap_default());
  back = keymap_default();
  r = keymap_apply(back, doc);
  assert(r.kd_ok, "the document was refused: {r.kd_say}");
  assert(key_for(back, VB_LOWER) == "",
         "lower came back on '{key_for(back, VB_LOWER)}' — the absence was not recorded");
  assert(key_for(back, VB_RAISE) == key_for(m, VB_RAISE),
         "raise came back on '{key_for(back, VB_RAISE)}'");
}

// ⛔ **THE ROW THE DELTA ACTUALLY EARNS, and the first version of it was green for the
// wrong reason.** *A verb the editor GAINED keeps its key* is true of a whole-table file
// too, because applying assigns per named verb and an unmentioned one is simply left
// alone — so that row could not see the difference it was written to state. What only a
// delta gives is the other direction: **a verb the author never rebound follows the
// editor's default, including when that default MOVES.** A whole table pins every verb
// to the layout of the day it was written, forever, including the fourteen the author
// never chose.
fn test_a_verb_the_author_never_rebound_follows_the_editors_default() {
  old = keymap_default();
  keymap_bind(old, "5", VB_RAISE);
  doc = keymap_delta(old, keymap_default());
  // …and the editor's own layout later moves a verb this author never touched.
  moved = keymap_default();
  was = key_for(moved, VB_FENCE);
  keymap_bind(moved, "9", VB_FENCE);
  assert(was != "9", "the fixture's 'moved' default was already 9");
  r = keymap_apply(moved, doc);
  assert(r.kd_ok, "the older document was refused: {r.kd_say}");
  assert(key_for(moved, VB_FENCE) == "9",
         "fence came back on '{key_for(moved, VB_FENCE)}' — a document that never "
       + "mentioned it overwrote the editor's new default");
  assert(key_for(moved, VB_RAISE) == "5", "the author's own binding did not arrive");
}

// …and the vocabulary is not frozen either: a verb the editor gained since the document
// was written keeps its own key. ⚠ **This one is NOT about the delta** — see above — it
// is about applying onto today's map rather than replacing it, which is a different
// mistake with the same symptom.
fn test_a_verb_the_editor_gained_since_the_document_was_written_keeps_its_key() {
  old = keymap_default();
  keymap_bind(old, "5", VB_RAISE);
  doc = keymap_delta(old, keymap_default());
  grown = keymap_default();
  grown.km_items += [bind_of("8", "tunnel")];
  r = keymap_apply(grown, doc);
  assert(r.kd_ok, "the older document was refused: {r.kd_say}");
  assert(key_for(grown, "tunnel") == "8",
         "the new verb came back on '{key_for(grown, \"tunnel\")}' — a document written "
       + "before it existed took its key away");
  assert(verb_is_known(grown, "tunnel"),
         "the new verb was dropped from the map entirely");
  assert(key_for(grown, VB_RAISE) == "5", "the saved binding did not arrive");
}

// …and the other direction: a verb this editor no longer has is DROPPED and named,
// never refused, or one rename costs the author every other binding in the file.
fn test_a_verb_the_editor_no_longer_has_is_dropped_and_said() {
  back = keymap_default();
  r = keymap_apply(back, KEYMAP_DOC + "\nraise 5\ntunnel 8\n");
  assert(r.kd_ok, "one unknown verb refused the whole document: {r.kd_say}");
  assert(r.kd_took == 1, "{r.kd_took} rows were taken, not 1");
  assert(r.kd_unknown.contains("tunnel"),
         "the dropped verb was not named: '{r.kd_unknown}'");
  assert(key_for(back, VB_RAISE) == "5", "the row beside it did not arrive");
}

fn test_a_document_this_editor_did_not_write_is_refused_whole() {
  back = keymap_default();
  was = key_for(back, VB_RAISE);
  r = keymap_apply(back, "some other program's file\nraise 5\n");
  assert(!r.kd_ok, "a foreign document was accepted");
  assert(key_for(back, VB_RAISE) == was,
         "a refused document still moved raise to '{key_for(back, VB_RAISE)}'");
}

// ⚠ **A HAND-EDITED FILE IS THE ONLY WAY TO REACH THIS**, and the answer is to refuse
// the whole document rather than load half of it: a person whose keyboard was reshaped
// by a bad file cannot reach the gesture that would fix it.
fn test_a_document_putting_two_verbs_on_one_key_is_refused_and_changes_nothing() {
  back = keymap_default();
  was = key_for(back, VB_RAISE);
  r = keymap_apply(back, KEYMAP_DOC + "\nraise 5\nlower 5\n");
  assert(!r.kd_ok, "a document with a collision was accepted: {r.kd_say}");
  assert(key_for(back, VB_RAISE) == was,
         "a refused document left raise on '{key_for(back, VB_RAISE)}'");
  assert(key_for(back, VB_LOWER) != "5", "a refused document still bound lower to 5");
}

fn test_a_document_naming_a_key_the_editor_cannot_read_is_refused() {
  back = keymap_default();
  was = key_for(back, VB_RAISE);
  r = keymap_apply(back, KEYMAP_DOC + "\nraise F13\n");
  assert(!r.kd_ok, "a key this editor cannot read was accepted");
  assert(key_for(back, VB_RAISE) == was, "a refused document still moved raise");
}

// ── AND THE DISK, which the interpreter has ─────────────────────────────────
//
// ⚠ **ABSENT IS NOT A FAILURE**, it is every first run — so `kd_ok` says *the map is
// usable* and `kd_found` says *there was a document*. A caller reading one field for
// both would report a fresh install as a broken one.
fn test_a_map_that_was_never_saved_loads_as_the_default_without_complaint() {
  back = keymap_default();
  was = key_for(back, VB_RAISE);
  r = keymap_load(back, "keymap_test_never_written.txt");
  assert(r.kd_ok, "an absent key map was reported as a failure: {r.kd_say}");
  assert(!r.kd_found, "an absent key map reported that a document was found");
  assert(key_for(back, VB_RAISE) == was, "an absent key map moved raise");
}

fn test_a_saved_map_comes_back_off_the_disk() {
  p = "keymap_test_roundtrip.txt";
  if exists(p) { delete(p); }
  m = keymap_default();
  keymap_bind(m, "5", VB_RAISE);
  assert(keymap_save(m, keymap_default(), p), "the save reported nothing written");
  back = keymap_default();
  r = keymap_load(back, p);
  assert(r.kd_ok && r.kd_found, "the saved map did not load: {r.kd_say}");
  assert(key_for(back, VB_RAISE) == "5",
         "raise came off the disk on '{key_for(back, VB_RAISE)}'");
  // ⚠ **SAVING TWICE OVER ONE PATH IS THE NORMAL CASE** — a rebind is written on every
  // bind — and `f += …` APPENDS, which is `world_save_as`'s scar: a second save that
  // left two documents in the file would read back the first and hide the rest.
  keymap_bind(m, "7", VB_CELLAR);
  assert(keymap_save(m, keymap_default(), p), "the second save reported nothing written");
  again = keymap_default();
  r2 = keymap_load(again, p);
  assert(r2.kd_ok, "the twice-saved map did not load: {r2.kd_say}");
  assert(r2.kd_took == 2, "the twice-saved map restored {r2.kd_took} bindings, not 2");
  assert(key_for(again, VB_CELLAR) == "7",
         "cellar came off the disk on '{key_for(again, VB_CELLAR)}'");
  delete(p);
}

// The fixture: flat ground, so `press_verb` has somewhere to refuse or act. ⚠ The
// rows above assert `ak_why != PR_NONE`, which is *this verb is bound* — a refusal is
// a perfectly good answer and a fixture that had to satisfy every gesture would be a
// world, not a fixture.
fn flat_world() -> VoxelWorld {
  fw = world_new(0.25, W_RESERVE, 8, 3).wn_world;
  for gq in 0 - 20..21 {
    for gr in 0 - 20..21 { ground_set(fw, gq, gr, 8, SURFACE_MAT); }
  }
  fw
}
