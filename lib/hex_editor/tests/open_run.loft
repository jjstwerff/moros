// A RUN OF DOORWAY EDGES IS ONE OPENING — plan 17 `A8.9a`, §P9.14.
//
// ⚠ THE FIRST BUILD GAVE EVERY EDGE ITS OWN OPENING, and only a zoomed screenshot
// showed it: a two-edge gateway came out as two small arches side by side. An
// arch's rise IS its half-width, so halving the span quarters the rise — which is
// why the per-edge version read as a flat head with a notch at each jamb.
use hex_editor;

const EPS = 0.001;

fn seg(ax: float, az: float, bx: float, bz: float) -> OpenSeg {
  OpenSeg { og_ax: ax, og_az: az, og_bx: bx, og_bz: bz }
}

fn near(a: float, b: float) -> boolean {
  d = a - b;
  if d < 0.0 { d = 0.0 - d; }
  d < 0.0001
}

fn test_one_segment_is_its_own_run() {
  r = open_run_for([seg(0.0, 0.0, 1.0, 0.0)], EPS, 0);
  assert(near(r.ou_cx, 0.5) && near(r.ou_cz, 0.0),
         "centre ({r.ou_cx},{r.ou_cz}), want (0.5,0)");
  assert(near(r.ou_half, 0.5), "half {r.ou_half}, want 0.5");
}

fn test_two_segments_end_to_end_are_one_opening() {
  // ⚠ THE WHOLE STEP, AS A NUMBER. Two unit edges in a straight line span 2.0, so
  // the half-width is 1.0 — twice the 0.5 each would have alone, and a round head's
  // rise is its half-width, so the arch is twice as tall.
  segs = [seg(0.0, 0.0, 1.0, 0.0), seg(1.0, 0.0, 2.0, 0.0)];
  r = open_run_for(segs, EPS, 0);
  assert(near(r.ou_cx, 1.0), "centre x {r.ou_cx}, want 1.0");
  assert(near(r.ou_half, 1.0), "half {r.ou_half}, want 1.0");
  // …and asked from the OTHER segment it is the same opening, not a second one.
  r2 = open_run_for(segs, EPS, 1);
  assert(near(r2.ou_cx, r.ou_cx) && near(r2.ou_half, r.ou_half),
         "the second edge got a different opening: ({r2.ou_cx},{r2.ou_half})");
}

fn test_the_span_is_a_chord_and_not_a_path_length() {
  // ⚠ HEX EDGES MEET AT 120°, so a run of two is a shallow V and `opening_cuts`
  // measures straight-line distance from the centre. Half the SUMMED length would
  // claim 1.0 here and cut the jambs off the wall; the chord is what the renderer
  // actually samples against. Two unit edges at 120°: the chord is sqrt(3).
  segs = [seg(0.0, 0.0, 1.0, 0.0),
          seg(1.0, 0.0, 1.5, 0.8660254037844386)];
  r = open_run_for(segs, EPS, 0);
  assert(r.ou_half < 0.9,
         "half {r.ou_half} — a summed path length, not the chord");
  assert(near(r.ou_half, 0.8660254037844386),
         "half {r.ou_half}, want half of sqrt(3)");
}

fn test_three_in_a_row_are_one_run_even_though_the_ends_do_not_touch() {
  // ⚠ TRANSITIVE. The first and last share no endpoint, so a pairwise test done
  // once would split this into two runs and draw two arches with a pier between.
  segs = [seg(0.0, 0.0, 1.0, 0.0), seg(1.0, 0.0, 2.0, 0.0), seg(2.0, 0.0, 3.0, 0.0)];
  r = open_run_for(segs, EPS, 0);
  assert(near(r.ou_half, 1.5), "half {r.ou_half}, want 1.5");
  assert(near(r.ou_cx, 1.5), "centre x {r.ou_cx}, want 1.5");
}

fn test_two_separate_doorways_stay_two_openings() {
  // ⚠ THE CONTROL, and without it every test above is satisfied by a function that
  // merges everything it is given. A wall with a door at each end has two openings,
  // and one spanning arch across the whole wall would take the pier out.
  segs = [seg(0.0, 0.0, 1.0, 0.0), seg(5.0, 0.0, 6.0, 0.0)];
  a = open_run_for(segs, EPS, 0);
  b = open_run_for(segs, EPS, 1);
  assert(near(a.ou_half, 0.5), "the first is {a.ou_half}, want 0.5");
  assert(near(b.ou_half, 0.5), "the second is {b.ou_half}, want 0.5");
  assert(!near(a.ou_cx, b.ou_cx), "and they are not the same opening");
}

fn test_endpoints_within_eps_count_as_shared() {
  // Corner coordinates come out of a projection, so two edges that meet arrive as
  // two floats a rounding apart rather than as one. `hex_corner_world` is where
  // that happens; half a hex edge already measures 0.49999999999999994.
  segs = [seg(0.0, 0.0, 1.0, 0.0), seg(1.0000001, 0.0, 2.0, 0.0)];
  r = open_run_for(segs, EPS, 0);
  assert(near(r.ou_half, 1.0), "a rounding split the run: half {r.ou_half}");
}
