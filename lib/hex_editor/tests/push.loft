// THE PUSH — one cell across a boundary, and the laws of `WALL_PUSH.md` §2.
//
// ✅ **THE HEX GRID PAYS HERE, HAVING COST SO MUCH ELSEWHERE.** Recovering a form FROM the
// field is the hard direction — `corner_pool`, the chain cut, `FORMAL_CORE` §6's two regimes,
// and `AUTHORING_MAP` §5.2's finding that the aiming quantiser's cells are 13.898/15/16.102°
// so *"the authoring resolution is 6.949° and no input precision improves it"*. **A push has
// no aiming at all.** The six neighbours are exact, and which one is chosen by the author's
// own step — so the unit of authoring is a step of the character rather than a form pieced
// together from blocks and hoped to look right.
use hex_editor;
use hex_voxel;
use hex_grid;
// ⛔ **THE BOUNDARY RULE IS `hex_draw`'s AND THIS FILE ASKS IT RATHER THAN RESTATING IT.**
// `draw_walls` marks *"every edge between a cell of the region and one outside it"* — law
// L1's `∂` in the library that owns it. A second copy written here would agree with
// `boundary_follow` by construction and could never be surprised.
use hex_draw;
use hex_field;
use hex_edge;

const Q0 = 0 - 12;
const W = 25;

fn flat_world() -> VoxelWorld {
  w = world_new(0.25, 0, 10, 4).wn_world;
  ground_fill(w, Q0, Q0, W, W, 8, SURFACE_MAT);
  w
}

fn mat_at(w: VoxelWorld, q: integer, r: integer) -> integer {
  world_ground_cell(w, q, r).h_material as integer ?? 0
}

// |∂I| computed independently of `push_cell` — an edge is a wall where membership differs.
fn boundary(w: VoxelWorld, mat: integer) -> integer {
  n = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if mat_at(w, q, r) != mat { continue; }
      for d in 0..6 {
        (nq, nr) = hex_grid::hex_neighbor(q, r, d);
        if mat_at(w, nq, nr) != mat { n = n + 1; }
      }
    }
  }
  n
}

// Everything the window holds, so a locality claim can be made over the whole of it.
//
// **THE EDGE BYTES ARE IN IT.** Before L1 a push wrote only `h_material` and `h_height`, so a
// digest over those two was a complete reading of it; the moment the boundary follows the
// cell it is not, and L4 and L5 are the two rows whose whole job is to say what a push does
// NOT touch.
//
// ⚠ **AND THE SWEEP REFUTED THE REASON THIS COMMENT FIRST GAVE.** It claimed a blind digest
// *could not see a scribble* — so `probe/wp/sweep-l1.sh` row 8 removed these three terms and
// went **green**, and row 9 (a sabotage that writes the wrong id, WITH the blind digest)
// went red anyway, through `pu_id` and the per-edge loop rather than through the digest.
// **No row in this file is currently carried by them.** They stay for `run_normal`'s reason
// — the failure mode they cover is a byte wrong while the materials and the carried id are
// both right, which is silent — and this note is here because the sweep says so and the
// first version of the comment did not.
fn digest(w: VoxelWorld) -> integer {
  h = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      c = world_ground_cell(w, q, r);
      h = h + (q + 40) * 7919 * (c.h_material as integer ?? 0)
            + (r + 40) * 104729 * (c.h_height as integer ?? 0)
            + (q + 40) * 15485863 * (c.h_wall_nw as integer ?? 0)
            + (r + 40) * 32452843 * (c.h_wall_ne as integer ?? 0)
            + (q + r + 80) * 49979687 * (c.h_wall_e as integer ?? 0);
    }
  }
  h
}

fn stood(w: VoxelWorld, x: float, z: float, yaw: float) -> Author {
  author_at(x, z, yaw, 0.0)
}

// ── L2 — one push transfers ONE cell, in one of six directions ────────────
fn test_a_push_transfers_exactly_one_cell() {
  w = flat_world();
  a = stood(w, 0.0, 0.0, 0.0);
  before = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W { if mat_at(w, q, r) == ROAD_MAT { before = before + 1; } }
  }
  p = push_cell(w, a, ROAD_MAT);
  assert(p.pu_ok, "the push refused: {p.pu_say}");
  after = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W { if mat_at(w, q, r) == ROAD_MAT { after = after + 1; } }
  }
  assert(after - before == 1, "the push took {after - before} cells, not one");
  assert(mat_at(w, p.pu_q, p.pu_r) == ROAD_MAT,
         "the cell it named is not the cell it took");
  // …and it is a NEIGHBOUR of where the author stood, not an arbitrary cell
  (sq, sr) = px_to_hex(a.au_x, a.au_z);
  adj = false;
  for d in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(sq, sr, d);
    if nq == p.pu_q && nr == p.pu_r { adj = true; }
  }
  assert(adj, "the cell taken is not one of the six neighbours of the author's own");
}

// ── L3 — the cost is `6 - 2k`, and it is reported rather than assumed ─────
fn test_the_wall_edge_count_changes_by_six_minus_twice_k() {
  // ⚠ **FOUR PUSHES ALONG ONE LINE, so `k` takes more than one value** — a row that pushed
  // once would confirm the formula at a single point and could not tell it from a constant.
  w = flat_world();
  seen_k0 = false;
  seen_kn = false;
  for i in 0..4 {
    a = stood(w, (i as float) * 1.8, 0.0, 0.0);
    (tq, tr) = px_to_hex(a.au_x, a.au_z);
    k = 0;
    for d in 0..6 {
      (nq, nr) = hex_grid::hex_neighbor(tq, tr, d);
      if mat_at(w, nq, nr) == ROAD_MAT { k = k + 1; }
    }
    b0 = boundary(w, ROAD_MAT);
    p = push_cell(w, a, ROAD_MAT);
    assert(p.pu_ok, "push {i} refused: {p.pu_say}");
    if !p.pu_new { continue; }
    b1 = boundary(w, ROAD_MAT);
    // the `k` of the cell that was actually taken, counted before the write
    assert(b1 - b0 == p.pu_dn,
           "push {i}: the boundary moved {b1 - b0} and the push reported {p.pu_dn}");
    if p.pu_dn == 6 { seen_k0 = true; }
    if p.pu_dn < 6 { seen_kn = true; }
  }
  assert(seen_k0, "no push started a fresh set — `k = 0` never occurred");
  assert(seen_kn, "every push reported the same cost, so this row cannot see the formula");
}

// ── L4 — nothing outside the transferred cell is written ──────────────────
fn test_a_push_writes_nothing_but_the_cell_it_takes() {
  w = flat_world();
  a = stood(w, 0.0, 0.0, 0.0);
  d0 = digest(w);
  p = push_cell(w, a, ROAD_MAT);
  assert(p.pu_ok && p.pu_new, "the push did nothing to measure");
  // undo the one cell by hand, and the whole window must be as it was
  ground_set(w, p.pu_q, p.pu_r, p.pu_h, p.pu_was);
  assert(digest(w) == d0,
         "restoring the single cell did not restore the window — the push wrote elsewhere");
}

// ── L5 — push then unpush is the identity on the store ────────────────────
fn test_push_then_unpush_is_the_identity() {
  w = flat_world();
  a = stood(w, 0.0, 0.0, 0.0);
  d0 = digest(w);
  p = push_cell(w, a, ROAD_MAT);
  assert(p.pu_ok && p.pu_new, "nothing was pushed");
  assert(digest(w) != d0, "the push changed nothing — the control cannot see a difference");
  ground_set(w, p.pu_q, p.pu_r, p.pu_h, p.pu_was);
  assert(digest(w) == d0, "push then unpush is not the identity");
}

// ── THE SUBJECT — one mechanic, and the material is where you stand ───────
fn test_the_subject_is_the_material_under_the_author() {
  // ⚠ **THE SAME CALL, TWICE, WITH NO BRANCH.** A road extends and a floor grows because the
  // author is standing on different things, which is `EDITING_MODES`' WHERE axis — not
  // because the gesture asks which subject it is dealing with.
  road = flat_world();
  ground_set(road, 0, 0, 8, ROAD_MAT);
  ra = stood(road, 0.0, 0.0, 0.0);
  rp = session_push(road, ra);
  assert(rp.pu_ok && rp.pu_new, "standing on a road, the push did nothing: {rp.pu_say}");
  assert(rp.pu_mat == ROAD_MAT, "it extended '{rp.pu_mat}' rather than the road");

  floor = flat_world();
  ground_set(floor, 0, 0, 8, FLOOR_MAT);
  fa = stood(floor, 0.0, 0.0, 0.0);
  fp = session_push(floor, fa);
  assert(fp.pu_ok && fp.pu_new, "standing on a floor, the push did nothing: {fp.pu_say}");
  assert(fp.pu_mat == FLOOR_MAT, "it grew '{fp.pu_mat}' rather than the room");

  assert(rp.pu_q == fp.pu_q && rp.pu_r == fp.pu_r,
         "the two subjects took different cells from the same pose — the mechanic differs, "
       + "and it must not");
}

// ── A CELL ALREADY IN THE SET IS NOT A REFUSAL ────────────────────────────
fn test_pushing_into_the_set_is_reported_not_refused() {
  // Walking along a face pushes cells the previous tick already took; a gesture that refused
  // there would stutter on its own path.
  w = flat_world();
  a = stood(w, 0.0, 0.0, 0.0);
  first = push_cell(w, a, ROAD_MAT);
  assert(first.pu_ok && first.pu_new, "the first push did nothing");
  d1 = digest(w);
  again = push_cell(w, a, ROAD_MAT);
  assert(again.pu_ok, "the second push REFUSED where it should report: {again.pu_say}");
  assert(!again.pu_new, "the second push claimed to take a cell that was already taken");
  assert(again.pu_dn == 0, "it reported a cost of {again.pu_dn} for writing nothing");
  assert(digest(w) == d1, "the second push wrote to the store");
}

// ── THE VERB REACHES IT ───────────────────────────────────────────────────
fn test_the_push_verb_takes_a_cell() {
  // ⛔ **THE DEFECT THIS TREE CALLS ITS COMMONEST**: a function tested green and wired to no
  // consumer. This row presses the verb rather than calling the primitive.
  w = flat_world();
  ground_set(w, 0, 0, 8, ROAD_MAT);
  s = EditSession {};
  session_at(s, w, 0.0, 0.0, 0.0);
  before = boundary(w, ROAD_MAT);
  ak = press_verb(s, w, s.es_author, VB_PUSH, "");
  assert(ak.ak_ok, "the push verb was refused: {ak.ak_why}");
  assert(boundary(w, ROAD_MAT) != before,
         "pressing the verb changed no boundary — it is bound to nothing");
}

// ─────────────────────────────────────────────────────────────────────────────
// L1 — THE MARKS THE STORE HOLDS ARE EXACTLY `∂I'`
//
// ⛔ **THE ORACLE IS `hex_draw::draw_walls`, NOT A SECOND READING OF THE PUSH.** The rows
// below rebuild the cell set out of the store, hand it to the library's own boundary rule
// and compare its answer against the store's edge bytes. `boundary_follow` applies that
// same rule at the six edges where membership changed; if the two are ever asked to agree
// by resemblance rather than by measurement, the check is worth nothing.
//
// ⚠ **AND THE FIXTURE'S WALLS COME FROM THE ORACLE TOO**, so law L1's precondition — the
// marks were `∂I` before the push — is a fact about the room rather than an assertion in
// the row that needs it.
// ─────────────────────────────────────────────────────────────────────────────

const REF     = 2.0;      // world units: the fixtures' ground is height 8 at 0.25 wu
const FLOOR_H = 8;
const ROOM_N  = 2;        // a 19-cell room — the centre cell and two rings
// A wall slot this editor's vocabulary does not name, which `edge_is_wall` still answers
// yes for: a world's own declared wall type. Law L10 is measured with it rather than with
// `WALL_MAT`, because `WALL_MAT` is 1 and an invented id would most likely be 1 too.
const TYPED   = 9;

// The store's cells of one material, as the `HexSet` the library's boundary rule takes.
fn cells_of(w: VoxelWorld, mat: integer) -> HexSet {
  co_s = hexset_chunk(Q0, Q0, W, W);
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if mat_at(w, q, r) == mat { hexset_set(co_s, q, r, true); }
    }
  }
  co_s
}

// `∂I`, as `hex_draw` defines it. The count is discarded: this is a set, and the rows below
// ask about membership rather than about how many edges the library happened to mark.
fn want_walls(w: VoxelWorld, mat: integer, id: integer) -> EdgeSet {
  ww_e = edgeset_new(Q0, Q0, W, W);
  ww_ignored = draw_walls(cells_of(w, mat), ww_e, id);
  ww_e
}

// Stamp `∂I` into the store — the fixture's walls, from the definition.
fn redraw(w: VoxelWorld, mat: integer, id: integer) -> integer {
  rd_e = want_walls(w, mat, id);
  rd_n = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      for d in 0..6 {
        (rd_q, rd_r) = hex_grid::hex_neighbor(q, r, d);
        rd_m = edge_mat(rd_e, q, r, rd_q, rd_r);
        if rd_m == 0 { continue; }
        wall_set(w, q, r, d, rd_m, FLOOR_H, REF);
        rd_n = rd_n + 1;
      }
    }
  }
  rd_n
}

// A room whose stored marks are exactly its boundary.
fn roomed(id: integer) -> VoxelWorld {
  rm_w = flat_world();
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if hex_grid::hex_distance(q, r, 0, 0) <= ROOM_N {
        ground_set(rm_w, q, r, FLOOR_H, FLOOR_MAT);
      }
    }
  }
  redraw(rm_w, FLOOR_MAT, id);
  rm_w
}

// What the store holds against what the library says it should — as sightings, since every
// edge is visited from both of its cells. `(0, 0)` is law L1.
//
// ⚠ **IT COMPARES *WALL OR NOT*, NEVER THE ID, AND THAT IS THE DIVISION OF LABOUR RATHER
// THAN A WEAKENING.** L1 says which edges are walls; L10 says whose. Comparing ids here
// would report the fence row's kept `FENCE_MAT` as a defect, which is the one outcome that
// row exists to prove correct — so the id is asked for separately, by the rows that own it.
//
// ⛔ **AND IT REPORTS A VIOLATION FOR ANY STRUCTURE THAT LEAVES THE WINDOW, WHICH LOOKS
// EXACTLY LIKE A DEFECT IN THE GESTURE.** `cells_of` scans `[Q0, Q0 + W)` only, so a cell
// one step outside is *not in the set* as far as `draw_walls` is concerned: the edge facing
// it comes back **missing** and the walls around it come back **stray**. Measured while
// building `G2` — a pushed walk of 200 ticks reached `q = 13` against a window ending at
// 12 and reported `2 stray, 1 missing`, which reads as *the tick path does not maintain
// the boundary* and is a fact about this function. **Every walking row therefore asserts
// its own containment**, and `walked_inside` is where that is done once.
fn against(w: VoxelWorld, mat: integer, id: integer) -> (integer, integer) {
  ag_want = want_walls(w, mat, id);
  ag_stray = 0;
  ag_miss = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      for d in 0..6 {
        (ag_q, ag_r) = hex_grid::hex_neighbor(q, r, d);
        ag_held = wall_of(w, q, r, d, REF) != 0;
        ag_wanted = edge_mat(ag_want, q, r, ag_q, ag_r) != 0;
        if ag_held && !ag_wanted { ag_stray = ag_stray + 1; }
        if ag_wanted && !ag_held { ag_miss = ag_miss + 1; }
      }
    }
  }
  (ag_stray, ag_miss)
}

// Sweep one whole face: stand on every cell of the room's rim in turn, face east, and take
// the cell in front. The rim cells on the far side have room in front of them and report
// `already`, which is the gesture's own answer and not a skip this row invents.
//
// ⚠ **REFUSALS ARE COUNTED AND NOT ASSERTED AWAY.** A helper that swallowed one would make
// the L1 row's `0 stray, 0 missing` an answer about a shorter face than it thinks it swept.
fn sweep_east(w: VoxelWorld, mat: integer) -> (integer, integer) {
  sw_n = 0;
  sw_no = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if hex_grid::hex_distance(q, r, 0, 0) != ROOM_N { continue; }
      (sw_x, sw_z) = hex_grid::hex_to_px(q, r);
      sw_p = push_cell(w, stood(w, sw_x, sw_z, 0.0), mat);
      if !sw_p.pu_ok { sw_no = sw_no + 1; }
      if sw_p.pu_new { sw_n = sw_n + 1; }
    }
  }
  (sw_n, sw_no)
}

// ── L1 — after a swept face, the store's marks are `∂I'` exactly ──────────
fn test_after_a_push_the_marks_are_exactly_the_boundary() {
  w = roomed(WALL_MAT);
  (s0, m0) = against(w, FLOOR_MAT, WALL_MAT);
  assert(s0 == 0 && m0 == 0,
         "the fixture is not its own boundary before anything is pushed: {s0} stray, "
       + "{m0} missing");
  (n, refused) = sweep_east(w, FLOOR_MAT);
  assert(n > 0, "the sweep took no cell — this row cannot see anything");
  assert(refused == 0, "{refused} of the face refused — a shorter face than this row swept");
  (s1, m1) = against(w, FLOOR_MAT, WALL_MAT);
  assert(s1 == 0 && m1 == 0,
         "after {n} pushes the store holds {s1} stray and {m1} missing against "
       + "`hex_draw::draw_walls`");
}

// ── AND THE COMPARISON CAN FAIL — the instrument, checked ─────────────────
fn test_the_boundary_comparison_finds_an_unmaintained_write() {
  // ⚠ **AN INSTRUMENT GETS CHECKED AGAINST SOMETHING IT SHOULD FIND BEFORE IT IS TRUSTED
  // TO REPORT AN ABSENCE.** The row above reports `0 stray, 0 missing`, which is also what
  // a comparison aimed at the wrong channel, the wrong window or the wrong material would
  // say. This writes the cell exactly as `push_cell` did BEFORE law L1 was built — the
  // membership moved and the marks did not — and the same call must report it.
  w = roomed(WALL_MAT);
  (x, z) = hex_grid::hex_to_px(ROOM_N, 0);
  a = stood(w, x, z, 0.0);
  (found, tq, tr) = cell_ahead(a.au_x, a.au_z, a.au_yaw);
  assert(found, "no cell ahead of the rim — the fixture is not what this row thinks");
  ground_set(w, tq, tr, FLOOR_H, FLOOR_MAT);
  (s, m) = against(w, FLOOR_MAT, WALL_MAT);
  assert(s + m > 0,
         "a cell written with no boundary maintenance reports {s} stray and {m} missing — "
       + "the comparison cannot see the thing it is aimed at");
}

// ── L10 — the id is CARRIED, and `pu_id` says which ───────────────────────
fn test_the_moved_boundary_keeps_the_wall_id() {
  // A room walled in a type this vocabulary does not name. An id invented at the write
  // would be `WALL_MAT`; a carried one is `TYPED`, and the two are distinguishable.
  w = roomed(TYPED);
  (x, z) = hex_grid::hex_to_px(ROOM_N, 0);
  p = push_cell(w, stood(w, x, z, 0.0), FLOOR_MAT);
  assert(p.pu_ok && p.pu_new, "nothing was pushed: {p.pu_say}");
  assert(p.pu_id == TYPED, "the wall that travelled is id {p.pu_id}, not the room's {TYPED}");
  assert(p.pu_marks > 0, "the push wrote no edge at all");
  (s, m) = against(w, FLOOR_MAT, TYPED);
  assert(s == 0 && m == 0,
         "the room's own wall type does not survive a push: {s} stray, {m} missing");
  // …and every byte on the new boundary is that type, not the editor's plain wall
  for d in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(p.pu_q, p.pu_r, d);
    if mat_at(w, nq, nr) == FLOOR_MAT { continue; }
    b = wall_of(w, p.pu_q, p.pu_r, d, REF);
    assert(b == TYPED, "the new boundary at direction {d} carries {b}, not {TYPED}");
  }
}

// ── L4/L5 in a room — out and back, byte for byte ─────────────────────────
fn test_pushing_a_room_out_and_back_is_the_identity() {
  // ⚠ **THE WAY BACK IS THE SAME GESTURE, NOT AN UNDO.** Standing outside on the ground
  // and facing the cell just taken, the set being grown is the GROUND — so `push_cell`
  // shrinks the room through the identical call, and the wall it carries back is the one
  // now in front of the author. A push has no inverse operation to keep in step with it.
  w = roomed(WALL_MAT);
  d0 = digest(w);
  (ox, oz) = hex_grid::hex_to_px(ROOM_N, 0);
  out = push_cell(w, stood(w, ox, oz, 0.0), FLOOR_MAT);
  assert(out.pu_ok && out.pu_new, "nothing was pushed out: {out.pu_say}");
  assert(out.pu_marks > 0, "the push out wrote no edge — law L1 is not being exercised");
  assert(digest(w) != d0, "the push changed nothing — the control cannot see a difference");

  (bx, bz) = hex_grid::hex_to_px(ROOM_N + 2, 0);
  back = push_cell(w, stood(w, bx, bz, 3.141592653589793), SURFACE_MAT);
  assert(back.pu_ok && back.pu_new, "nothing was pushed back: {back.pu_say}");
  assert(back.pu_q == out.pu_q && back.pu_r == out.pu_r,
         "the way back took ({back.pu_q},{back.pu_r}) and the way out ({out.pu_q},"
       + "{out.pu_r})");
  assert(back.pu_id == WALL_MAT,
         "the wall carried back is id {back.pu_id} — the boundary the push out left is "
       + "not the one the way back reads");
  assert(digest(w) == d0, "out and back is not the identity on the store");
}

// ── THE VERB REACHES THE BOUNDARY, NOT ONLY THE CELL ──────────────────────
fn test_the_push_verb_moves_the_wall_in_front() {
  // ⛔ **A FUNCTION TESTED GREEN AND WIRED TO NOTHING IS THIS TREE'S COMMONEST DEFECT**, and
  // `boundary_follow` is one call deep: the row above presses nothing. This one presses the
  // key's verb and then asks the library whether the store is a boundary.
  w = roomed(WALL_MAT);
  s = EditSession {};
  (x, z) = hex_grid::hex_to_px(ROOM_N, 0);
  session_at(s, w, x, z, 0.0);
  before = boundary(w, FLOOR_MAT);
  ak = press_verb(s, w, s.es_author, VB_PUSH, "");
  assert(ak.ak_ok, "the push verb was refused: {ak.ak_why}");
  assert(boundary(w, FLOOR_MAT) != before, "the verb took no cell");
  // ⚠ **AND THE AUTHOR IS TOLD**, because a push that moved a boundary and one that moved
  // only a cell print the same word otherwise — which is law L1 being invisible from
  // inside the editor, and this tree finds defects by USING it.
  assert(ak.ak_why.contains("wall edges"),
         "the acknowledgement says '{ak.ak_why}' and never mentions the wall it moved");
  (st, ms) = against(w, FLOOR_MAT, WALL_MAT);
  assert(st == 0 && ms == 0,
         "the verb moved the room and left {st} stray and {ms} missing marks behind");
}

// ── ⛔ AND ON THE EDITOR'S OWN HOUSE, WHOSE MARKS ARE NOT `∂I` TO BEGIN WITH ──
//
// ⛔ **`place_house` DOES NOT LEAVE A BOUNDARY, AND IT NEVER HAS.** Its walls are stamped
// from four run LINES by `wall_stamp`, not from the floor's membership, so the store holds
// edges that bound no house cell — [BLUEPRINT](../../../doc/claude/BLUEPRINT.md) §0's first
// picture found four of them, one carrying an opening. Law L1's precondition therefore
// fails on the one structure the editor actually builds, and a row asserting `(0, 0)` here
// would be asserting somebody else's defect away.
//
// ✅ **SO THE CLAIM IS THE ONE A PUSH CAN OWE: IT NEVER MAKES THE STORE LESS LIKE ITS
// BOUNDARY.** Only the six edges of the transferred cell change status, and those six are
// written exactly; every other edge's residual is untouched. The measurement is
// componentwise `≤`, which is L1 stated for a store that did not start clean — which is
// the real editor.
fn test_a_push_never_adds_to_what_the_boundary_does_not_explain() {
  w = flat_world();
  s = EditSession {};
  ph_a = author_at(0.0, 0.0 - 4.0, 1.5707963267948966, (FLOOR_H as float) * 0.25);
  ph = place_house(w, ph_a, HOUSE_W, HOUSE_D, grade_under(w, ph_a), s.es_runs, s.es_roofs);
  assert(ph.ak_ok, "the house was refused: {ph.ak_why}");
  (b_stray, b_miss) = against(w, FLOOR_MAT, WALL_MAT);
  assert(b_stray + b_miss > 0,
         "`place_house` left an exact boundary — the premise of this row is gone, and the "
       + "row above is the one that should be asserting it");

  // A floor cell with open ground to its east: stand there, face east, push out.
  fq = 0;
  fr = 0;
  found = false;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if found { continue; }
      if mat_at(w, q, r) != FLOOR_MAT { continue; }
      (eq, er) = hex_grid::hex_neighbor(q, r, 0);
      if mat_at(w, eq, er) == FLOOR_MAT { continue; }
      fq = q; fr = r; found = true;
    }
  }
  assert(found, "no floor cell of the house has open ground east of it");
  (hx, hz) = hex_grid::hex_to_px(fq, fr);
  p = push_cell(w, stood(w, hx, hz, 0.0), FLOOR_MAT);
  assert(p.pu_ok && p.pu_new, "the house would not push: {p.pu_say}");
  assert(p.pu_id == WALL_MAT,
         "the wall in front of the author reads {p.pu_id} — the house's own wall is "
       + "{WALL_MAT}, so this row is not standing where it thinks");
  // ✅ **MEASURED: 8 stray and 0 missing before, 6 and 0 after** — 8 sightings is the FOUR
  // edges `BLUEPRINT` §0 names, each seen from both of its cells, and the push took one of
  // them out because it happened to lie on the transferred cell's rim. ⚠ The row asserts
  // only `≤`: which of the four a push reaches is the fixture's business, and a row pinned
  // to `6` would be asserting where the author happened to stand.
  (a_stray, a_miss) = against(w, FLOOR_MAT, WALL_MAT);
  assert(a_stray <= b_stray && a_miss <= b_miss,
         "the push took the store further from its own boundary: {b_stray}/{b_miss} stray/"
       + "missing before, {a_stray}/{a_miss} after");
  assert(p.pu_marks > 0, "the push wrote no edge on a house that has walls");
}

// ── L10 STRICTLY — a boundary already standing is somebody else's ─────────
fn test_a_push_does_not_repaint_a_boundary_it_did_not_make() {
  // ⛔ **THE TRANSFERRED CELL WAS OUTSIDE THE SET, SO ANY BYTE ALREADY ON ITS OUTWARD
  // EDGES BELONGS TO SOMETHING ELSE.** `∂I'` wants a wall there and the store already
  // holds one; the set of walled edges is exact whichever id survives, and the only thing
  // an overwrite changes is whose wall it is. Here it is a FENCE, which a room growing
  // past it must not turn into masonry.
  w = roomed(WALL_MAT);
  (fx, fz) = hex_grid::hex_to_px(ROOM_N, 0);
  (found, tq, tr) = cell_ahead(fx, fz, 0.0);
  assert(found, "no cell ahead of the rim");
  // a fence on the far side of the cell about to be taken — outward, so `∂I'` wants an
  // edge exactly there and this row is about the id rather than about the edge
  wall_set(w, tq, tr, 0, FENCE_MAT, FLOOR_H, REF);
  assert(wall_of(w, tq, tr, 0, REF) == FENCE_MAT, "the fixture's fence did not go down");

  p = push_cell(w, stood(w, fx, fz, 0.0), FLOOR_MAT);
  assert(p.pu_ok && p.pu_new, "nothing was pushed: {p.pu_say}");
  assert(wall_of(w, tq, tr, 0, REF) == FENCE_MAT,
         "the room grew past the fence and repainted it as {wall_of(w, tq, tr, 0, REF)}");
  // …and the boundary is still complete, so keeping the fence cost no edge
  (s, m) = against(w, FLOOR_MAT, WALL_MAT);
  assert(s == 0 && m == 0,
         "keeping the fence left {s} stray and {m} missing — the two claims are in "
       + "conflict and the law is not");
}

// ─────────────────────────────────────────────────────────────────────────────
// ⛔ WHAT IS NOT BUILT, PINNED RATHER THAN CAVEATED — `WALL_PUSH` §7
//
// Two rows that assert a LIMIT. They exist so the boundary of the feature is a measurement
// somebody can re-run, and so that the day structure identity arrives they go red and send
// the reader to §6 — where the question they turn on is already written down.
// ─────────────────────────────────────────────────────────────────────────────

// ── L6/L7 — an internal partition cannot be pushed at all ─────────────────
fn test_an_internal_partition_is_not_reachable() {
  // ⛔ **MEMBERSHIP IS THE MATERIAL, SO TWO ROOMS OF ONE FLOOR ARE ONE SET.** The third of
  // the request's three cases — *an internal partition slides* — asks about a wall between
  // two cells the store cannot tell apart, so the cell in front is already in the set and
  // the gesture answers `already`. That is §6's open question (*how a structure is
  // identified in the store*) with a consequence attached, not a bug in the mechanic.
  w = roomed(WALL_MAT);
  // a partition down the middle: the edge between (0,0) and its east neighbour
  wall_set(w, 0, 0, 0, WALL_MAT, FLOOR_H, REF);
  assert(wall_of(w, 0, 0, 0, REF) == WALL_MAT, "the fixture's partition did not go down");
  d0 = digest(w);
  (x, z) = hex_grid::hex_to_px(0, 0);
  p = push_cell(w, stood(w, x, z, 0.0), FLOOR_MAT);
  assert(p.pu_ok, "the push refused rather than reporting: {p.pu_say}");
  assert(!p.pu_new,
         "the partition moved — structure identity has arrived and `WALL_PUSH` §6 is the "
       + "section to read, along with L6 and L7");
  assert(digest(w) == d0, "nothing was transferred and the store changed anyway");
  assert(wall_of(w, 0, 0, 0, REF) == WALL_MAT, "the partition was rubbed out");
}

// ── R6 — a doorway is refused, and the refusal is what L9 costs ───────────
fn test_a_push_through_a_doorway_is_refused() {
  // ⛔ **THIS ROW MEASURED THE DAMAGE BEFORE IT NAMED THE REFUSAL.** Law L10 carries the
  // faced byte onto the new face, and an edge is ONE byte holding the wall and the feature
  // at once (`@HB-X70`) — so pushing from inside a doorway turned five edges of masonry
  // into **five edges of hole**: not a house with a door in it, a room with a side missing.
  // The measurement is kept in the assertion below, because a refusal whose alternative is
  // not written down reads like caution.
  //
  // ⚠ **AND THERE IS NOTHING EXACT TO PUT IN ITS PLACE, WHICH IS WHY IT IS A REFUSAL AND
  // NOT A FIX.** The right answer is law **L9** — the opening is a span on the wall's
  // surface and rides it — and the wall type the door perforates is recorded nowhere the
  // gesture can read. Substituting `WALL_MAT` invents an id in a room that may be walled in
  // another type, which is the one thing L10 forbids.
  w = roomed(WALL_MAT);
  (x, z) = hex_grid::hex_to_px(ROOM_N, 0);
  (found, tq, tr) = cell_ahead(x, z, 0.0);
  assert(found, "no cell ahead of the rim");
  d = hex_grid::hex_neighbor_dir(ROOM_N, 0, tq, tr);
  assert(d >= 0, "the cell ahead is not a neighbour, so this row has no faced edge");
  wall_set(w, ROOM_N, 0, d, DOOR_MAT, FLOOR_H, REF);
  assert(wall_of(w, ROOM_N, 0, d, REF) == DOOR_MAT, "the fixture's door did not go in");
  d0 = digest(w);

  p = push_cell(w, stood(w, x, z, 0.0), FLOOR_MAT);
  assert(!p.pu_ok, "a push through a doorway was accepted — `WALL_PUSH` L9 and R6");
  assert(digest(w) == d0, "the refusal wrote to the store");

  // ⛔ **AND WHAT R6 COSTS IS A NOTCH, WHICH IS L11 — SAID OUT LOUD RATHER THAN IMPLIED.**
  // The rest of the face sweeps; the doorway's own cell does not. So the face comes out
  // one cell short at exactly the place the author was standing, and L11's *a sweep
  // preserves the description* is what that breaks — the whole reason the gesture is a walk
  // and not a poke. The refusal keeps the world coherent and hands the shape problem to the
  // law that owns it, which is a trade rather than a fix.
  (n, refused) = sweep_east(w, FLOOR_MAT);
  assert(n > 0, "the rest of the face refused too — R6 is wider than it says it is");
  assert(refused == 1, "{refused} cells of the face refused, not the doorway's one");
  (s, m) = against(w, FLOOR_MAT, WALL_MAT);
  assert(s == 0 && m == 0,
         "the notched face is not its own boundary: {s} stray, {m} missing — a refusal in "
       + "the middle of a sweep must still leave L1 standing");
  // the doorway is still there, on a wall that did not move
  assert(wall_of(w, ROOM_N, 0, d, REF) == DOOR_MAT,
         "the door was lost by a sweep that never touched its cell");
}

// ─────────────────────────────────────────────────────────────────────────────
// `G2` — A HELD TOGGLE OVER A WALK, AND THE BODY IS THE TICK'S
//
// ⛔ **THE FIRST ARGUMENT FOR THE PER-TICK TRIGGER WAS A DEADLOCK, AND THE SWEEP
// REFUTED IT.** It ran: *the thing a push moves is the thing stopping the walk, so no
// new hex is ever entered and a per-hex trigger would hang on itself*.
// `probe/wp/sweep-g2.sh` row 2 IS the level stamp's trigger applied to the push, and it
// went **green** — a walker meeting a wall is standing in a hex they have just entered.
//
// ✅ **WHAT SEPARATES THE TWO IS TURNING**, which is the last row in this file: *the
// wall in front of you gives way* is about the FACING, and a facing changes with no hex
// entered at all.
//
// ⚠ **AND WHAT MAKES PER-TICK SAFE IS `push_cell`'s `already`** — taking a cell that is
// in the set writes nothing, so a thousand ticks standing still take the one cell one
// tick takes. The rate cannot vary anyway: `tick_dt()` is a constant by law.
// ─────────────────────────────────────────────────────────────────────────────

const TICK_REACH = 8;
const TICK_STEP  = 4;

fn walker_in(w: VoxelWorld, x: float, z: float, yaw: float) -> Walker {
  tw = walker_new(x, (FLOOR_H as float) * w.w_unit, z);
  tw.wk_yaw = yaw;
  tw
}

// One tick, with the CELL's own height as the ground — a test needs no mesher, which is
// the seam `walk_tick` takes its sampler by.
fn ticked(wk: Walker, w: VoxelWorld, pushing: boolean) -> TickOut {
  walk_tick(wk, w, WallRuns { items: [] }, TICK_REACH, TICK_STEP, LEVEL_R, pushing,
            fn(gx: float, gz: float, gref: float) -> float {
              (gq, gr) = hex_grid::px_to_hex(gx, gz);
              (terrain_h(gq, gr, w) as float) * w.w_unit
            })
}

fn floor_cells(w: VoxelWorld) -> integer {
  fc = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W { if mat_at(w, q, r) == FLOOR_MAT { fc = fc + 1; } }
  }
  fc
}

// Walk east from the room's centre for `n` ticks, with the toggle in the given state.
//
// ⛔ **AND IT ASSERTS IT STAYED INSIDE THE ORACLE'S WINDOW.** `against` is blind past
// `Q0 + W` and answers *stray* and *missing* rather than *I cannot see that* — so a row
// that walked out of the window would report a boundary violation the gesture did not
// commit. A margin of two, because the cell the last push takes is one PAST the cell the
// walker is standing in.
fn walked(w: VoxelWorld, pushing: boolean, n: integer) -> Walker {
  wk = walker_in(w, 0.0, 0.0, 0.0);
  wk.wk_held = HELD_FWD;
  for _i in 0..n { ticked(wk, w, pushing); }
  (wq, wr) = px_to_hex(wk.wk_x, wk.wk_z);
  assert(wq > Q0 + 1 && wq < Q0 + W - 2 && wr > Q0 + 1 && wr < Q0 + W - 2,
         "the walk left the window the oracle can see: ({wq},{wr}) against "
       + "[{Q0}, {Q0 + W}) — every boundary number below would be about the window");
  wk
}

// ── THE WALL STOPS THE WALK — the control, and it must go first ───────────
fn test_the_rooms_wall_stops_a_walker_who_is_not_pushing() {
  // ⚠ **WITHOUT THIS ROW EVERY ROW BELOW IS VACUOUS.** *The push let me through* is
  // only a claim if something was in the way; a room whose walls do not block would
  // make the whole section report success for a walker who was never stopped.
  w = roomed(WALL_MAT);
  wk = walked(w, false, 150);
  assert(wk.wk_x > 0.0, "the walker did not move at all — the fixture is not walkable");
  (sq, sr) = px_to_hex(wk.wk_x, wk.wk_z);
  assert(mat_at(w, sq, sr) == FLOOR_MAT,
         "the walker ended on '{mat_at(w, sq, sr)}' — the room's wall did not stop them");
  assert(floor_cells(w) == 19, "the room grew to {floor_cells(w)} cells with push OFF");
}

// ── `G2` — THE WALL GIVES WAY AND THE WALK CONTINUES ──────────────────────
fn test_the_held_push_lets_the_walk_through_its_own_wall() {
  held = roomed(WALL_MAT);
  hw = walked(held, true, 150);
  free = roomed(WALL_MAT);
  fw = walked(free, false, 150);
  assert(hw.wk_x > fw.wk_x,
         "pushing carried the walker to {hw.wk_x} and not pushing to {fw.wk_x} — the "
       + "wall did not give way");
  assert(floor_cells(held) > 19,
         "the room is still {floor_cells(held)} cells — nothing was taken");
  // …and the walker is standing on floor they made, not outside on the grass
  (hq, hr) = px_to_hex(hw.wk_x, hw.wk_z);
  assert(mat_at(held, hq, hr) == FLOOR_MAT,
         "the walker ended on '{mat_at(held, hq, hr)}' — they left the set they were "
       + "growing");
}

// ── AND LAW L1 HOLDS THROUGH THE TICK, NOT ONLY THROUGH THE PRESS ─────────
fn test_the_tick_leaves_the_store_a_boundary() {
  // ⛔ **A SECOND CALLER OF ONE RULE IS WHERE THAT RULE COMES APART.** `press_verb` and
  // `walk_tick` both reach `push_cell`, and this asks the tick's world the question
  // `test_after_a_push_the_marks_are_exactly_the_boundary` asks the press's.
  w = roomed(WALL_MAT);
  wk = walked(w, true, 150);
  assert(floor_cells(w) > 19, "nothing was pushed, so nothing is being measured");
  (s, m) = against(w, FLOOR_MAT, WALL_MAT);
  assert(s == 0 && m == 0,
         "after a pushed walk the store holds {s} stray and {m} missing against "
       + "`hex_draw::draw_walls`");
}

// ── STANDING STILL BORES NOTHING ──────────────────────────────────────────
fn test_a_held_push_that_does_not_walk_takes_one_cell() {
  // ⚠ **THIS IS WHAT MAKES THE PER-TICK TRIGGER SAFE**, and it is `push_cell`'s
  // `already` doing the work rather than a guard in the tick. A gesture that refused
  // there would stutter on its own path; one that wrote there would bore a tunnel
  // through a wall the author is merely leaning on.
  w = roomed(WALL_MAT);
  wk = walker_in(w, 0.0, 0.0, 0.0);
  // stand at the rim, facing out, holding nothing
  (rx, rz) = hex_grid::hex_to_px(ROOM_N, 0);
  wk.wk_x = rx;
  wk.wk_z = rz;
  before = floor_cells(w);
  first = ticked(wk, w, true);
  assert(first.tk_pushed, "the first tick took no cell");
  assert(floor_cells(w) == before + 1, "the first tick took more than one cell");
  tau1 = w.w_tau;
  took = 0;
  for _i in 0..200 { if ticked(wk, w, true).tk_pushed { took = took + 1; } }
  assert(took == 0, "{took} more cells were taken by a walker who never moved");
  assert(w.w_tau == tau1, "the store's clock moved {w.w_tau - tau1} while nothing was written");
  assert(floor_cells(w) == before + 1, "the room grew to {floor_cells(w)} standing still");
}

// ── THE TOGGLE IS OFF WHEN IT IS OFF ──────────────────────────────────────
fn test_the_second_press_stops_the_gesture() {
  // ⛔ **PRESSED, NOT SET.** The mode is `press_verb`'s to flip, and a row that set
  // `es_pushing` by hand would be testing a field rather than the verb — which is the
  // half a driver can get wrong.
  w = roomed(WALL_MAT);
  s = EditSession {};
  (x, z) = hex_grid::hex_to_px(ROOM_N, 0);
  session_at(s, w, x, z, 0.0);
  on = press_verb(s, w, s.es_author, VB_PUSH, "");
  assert(on.ak_ok, "the first press was refused: {on.ak_why}");
  assert(s.es_pushing, "the first press did not arm the gesture");
  off = press_verb(s, w, s.es_author, VB_PUSH, "");
  assert(off.ak_ok, "the second press was refused: {off.ak_why}");
  assert(!s.es_pushing, "the second press did not disarm it");

  // …and a walk with it off takes nothing more
  wk = walker_in(w, x, z, 0.0);
  wk.wk_held = HELD_FWD;
  after = floor_cells(w);
  for _i in 0..200 { ticked(wk, w, s.es_pushing); }
  assert(floor_cells(w) == after,
         "the room grew from {after} to {floor_cells(w)} with the gesture off");
}

// ── ⛔ L11, PRICED: A WALK STILL MAKES A DENT ─────────────────────────────
//
// L11 is *a sweep preserves the description* — **sweeping a whole face leaves the
// structure describable as what it was**, and *"an editor that lets you poke will
// quietly turn houses into linework."* `G2` was supposed to be what pays it: a walk
// rather than a poke.
//
// ⛔ **IT DOES NOT, AND THE REASON IS THE CONTROLS RATHER THAN THE GESTURE.** `W` walks
// along the facing and `cell_ahead` takes the cell along the facing, so **you can only
// push in the direction you walk**. Walking into a wall drives a ONE-CELL CORRIDOR
// through it; sweeping a face would mean walking ALONG the face while facing it, which
// this editor has no input for — there is no strafe, and A/D turn.
//
// So the row measures the corridor rather than asserting the law, and `WALL_PUSH` §7
// keeps L11 in the *not built* column with this as its price.
fn test_a_pushed_walk_drives_a_corridor_and_not_a_swept_face() {
  w = roomed(WALL_MAT);
  before = floor_cells(w);
  wk = walked(w, true, 150);
  gained = floor_cells(w) - before;
  assert(gained > 2, "only {gained} cells were taken — too few to have a shape at all");
  // every cell the walk added lies on the walk's own row: a corridor one cell wide
  off_line = 0;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if mat_at(w, q, r) != FLOOR_MAT { continue; }
      if hex_grid::hex_distance(q, r, 0, 0) <= ROOM_N { continue; }
      if r != 0 { off_line = off_line + 1; }
    }
  }
  assert(off_line == 0,
         "{off_line} of the {gained} cells taken lie off the walk's line — the gesture "
       + "has grown a way to sweep sideways and `WALL_PUSH` L11 is the law to re-read");
}

// ── AND THE HOUSE READER SAYS WHAT THAT COSTS ────────────────────────────
fn test_a_pushed_walk_stops_a_house_reading_as_a_house() {
  // ⛔ **L11'S OWN FALSIFICATION, RUN AS A MEASUREMENT.** *"Falsified by a swept face
  // that no longer reads as `house`."* The house reads before the walk and does not
  // read after it, which is the sentence L11 warned about — with the difference that
  // it is now measured rather than predicted.
  w = flat_world();
  s = EditSession {};
  ha = author_at(0.0, 0.0 - 4.0, 1.5707963267948966, (FLOOR_H as float) * 0.25);
  hk = place_house(w, ha, HOUSE_W, HOUSE_D, grade_under(w, ha), s.es_runs, s.es_roofs);
  assert(hk.ak_ok, "the house was refused: {hk.ak_why}");
  b4 = house_recover(w, Q0, Q0, W, W, REF);
  assert(b4.hs_ok, "the house does not read before anything is pushed: {b4.hs_why}");

  // stand on a floor cell with open ground east of it and walk east, pushing
  fq = 0; fr = 0; found = false;
  for r in Q0..Q0 + W {
    for q in Q0..Q0 + W {
      if found { continue; }
      if mat_at(w, q, r) != FLOOR_MAT { continue; }
      (eq, er) = hex_grid::hex_neighbor(q, r, 0);
      if mat_at(w, eq, er) == FLOOR_MAT { continue; }
      fq = q; fr = r; found = true;
    }
  }
  assert(found, "no floor cell of the house has open ground east of it");
  (hx, hz) = hex_grid::hex_to_px(fq, fr);
  wk = walker_in(w, hx, hz, 0.0);
  wk.wk_held = HELD_FWD;
  for _i in 0..80 { ticked(wk, w, true); }
  (wq, wr) = px_to_hex(wk.wk_x, wk.wk_z);
  assert(wq > Q0 + 1 && wq < Q0 + W - 2, "the walk left the window: ({wq},{wr})");

  af = house_recover(w, Q0, Q0, W, W, REF);
  assert(!af.hs_ok,
         "the house still reads after a corridor was driven out of it — L11 is paid "
       + "and `WALL_PUSH` §7 is the section to move");
}

// ── ⛔ THE TRIGGER: TURNING IS A PUSH, AND WALKING IS NOT THE ONLY ONE ────
fn test_turning_on_the_spot_takes_the_cell_you_turn_to_face() {
  // ⛔ **THE SABOTAGE SWEEP IS WHY THIS ROW EXISTS, AND IT REFUTED THE ARGUMENT THE
  // CODE WAS WRITTEN ON.** `G2` fires every tick rather than once per hex ENTERED, and
  // the reason first given was a DEADLOCK — *the thing a push moves is the thing
  // stopping the walk, so no new hex is ever entered*. `probe/wp/sweep-g2.sh` row 2 put
  // the level stamp's own trigger on the push and went **green**: there is no deadlock,
  // because a walker meeting a wall is standing in a hex they have just entered, so the
  // per-hex trigger fires there too.
  //
  // ✅ **WHAT ACTUALLY SEPARATES THE TWO IS TURNING.** *The wall in front of them gives
  // way* is a statement about the FACING, and a facing changes with no hex entered at
  // all — so a per-hex trigger would leave an author turning on the spot with the
  // gesture held and nothing happening. This row is that difference, and it is what
  // makes row 2 red.
  w = roomed(WALL_MAT);
  // stand at the rim on the WEST side, facing east — into the room, so there is
  // nothing to take and the gesture is armed against its own floor
  (wx, wz) = hex_grid::hex_to_px(0 - ROOM_N, 0);
  wk = walker_in(w, wx, wz, 0.0);
  before = floor_cells(w);
  for _i in 0..20 { ticked(wk, w, true); }
  assert(floor_cells(w) == before,
         "facing into the room took {floor_cells(w) - before} cells — the fixture is "
       + "not facing what this row thinks");

  // …now turn on the spot until the wall is in front, without walking a step
  wk.wk_held = HELD_LEFT;
  turned = 0;
  for _i in 0..400 {
    if floor_cells(w) > before { continue; }
    ticked(wk, w, true);
    turned = turned + 1;
  }
  (tq, tr) = px_to_hex(wk.wk_x, wk.wk_z);
  assert(tq == 0 - ROOM_N && tr == 0,
         "the walker left ({0 - ROOM_N},0) for ({tq},{tr}) — turning moved them, so this "
       + "row cannot separate a turn from a step");
  assert(floor_cells(w) == before + 1,
         "turning on the spot with the gesture held took {floor_cells(w) - before} cells "
       + "in {turned} ticks — a facing is what a push is aimed by, and a trigger that "
       + "waits for a hex cannot see one");
}
