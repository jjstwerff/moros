//
// THE LAYER STACK, WITHOUT A SERVER — `tools/gates/world/storey.mjs`'s claims and
// the stair `deck.mjs` needs to reach a deck at all.
//
// What is gated is the STACK, not "a floor appeared": a storey appends above, a
// cellar INSERTS at the bottom so the order still holds, and a cellar with no room
// below is refused for the right reason. The gate builds a tower through a socket
// to say this; these run against the store.
use hex_editor;
use hex_voxel;
use hex_grid;

fn world() -> VoxelWorld {
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 10..11 {
    for r in 0 - 10..11 { hex_editor::ground_set(w, q, r, 40, hex_editor::SURFACE_MAT); }
  }
  w
}

fn layers(w: VoxelWorld, q: integer, r: integer) -> integer {
  n = 0;
  for c in world_column(w, q, r).co_cells { if hex_voxel::hex_occupied(c) { n = n + 1; } }
  n
}

fn test_a_storey_appends_a_layer_above() {
  w = world();
  before = layers(w, 0, 0);
  why = "";
  n = hex_editor::storey_add(w, 0, 0, 1, 2, why);
  assert(n > 0, "the storey went on {n} cells: {why}");
  assert(layers(w, 0, 0) == before + 1, "one more layer: {before} -> {layers(w, 0, 0)}");
  top = hex_editor::col_top(world_column(w, 0, 0));
  assert(top == 40 + hex_editor::STOREY_H,
         "and it sits one storey up: {top} vs {40 + hex_editor::STOREY_H}");
}

fn test_three_storeys_stack_rather_than_replace() {
  // A tower, and the point is that each press ADDS: a version that wrote the same
  // slot would read as one floor however many times it was pressed.
  w = world();
  why = "";
  for i in 0..3 { hex_editor::storey_add(w, 0, 0, 1, 2, why); }
  assert(layers(w, 0, 0) == 4, "ground plus three storeys, got {layers(w, 0, 0)}");
  assert(hex_editor::col_top(world_column(w, 0, 0)) == 40 + 3 * hex_editor::STOREY_H,
         "the top is three storeys up");
}

fn test_a_cellar_inserts_at_the_bottom_and_the_order_still_holds() {
  // ⚠ INSERTS, not appends. A column is height-ascending because `F1` compares
  // CONSECUTIVE occupied cells, so a cellar that landed on the end would break the
  // ordering the whole model reads by.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  col = world_column(w, 0, 0);
  low = hex_editor::col_low(col);
  assert(low == 40 - hex_editor::STOREY_H, "the cellar is one storey down, got {low}");
  ascending = true;
  prev = 0 - 1;
  for c in col.co_cells {
    if hex_voxel::hex_occupied(c) {
      h = c.h_height as integer ?? 0;
      if prev >= 0 && h <= prev { ascending = false; }
      prev = h;
    }
  }
  assert(ascending, "and the column is still height-ascending");
}

// The index of the layer carrying this label, or -1.
fn layer_of(w: VoxelWorld, q: integer, r: integer, label: integer) -> integer {
  col = world_column(w, q, r);
  for i in 0..len(col.co_ids) { if (col.co_ids[i] ?? 0) == label { return i; } }
  0 - 1
}

fn test_the_ground_becomes_a_ceiling_the_moment_a_cellar_is_dug_under_it() {
  // ⚠ THE THIRD RECURRENCE OF ONE SHAPE: something overhead with no underside. The
  // roof had it, the deck had it one axis over, and the ground has it — a cellar's
  // ceiling IS the ground, and the ground is drawn by a different pass that answers
  // *the outdoors* by definition and so never asked whether anything was beneath it.
  //
  // What the renderer needs is not "is this a cellar" but the general fact, and this
  // is it: BEFORE, the ground layer has nothing below it and owes no underside;
  // AFTER, it does. Measured on the wire before this existed — digging a cellar put
  // 342 vertices into the `soffit` surface and every one of them was 3.0 wu BELOW
  // the ground, which is the cellar floor's own underside. Nothing was overhead.
  w = world();
  gi = layer_of(w, 0, 0, hex_voxel::LABEL_GROUND);
  assert(gi >= 0, "the ground has a label to be found by");
  assert(!hex_editor::col_has_below(world_column(w, 0, 0), gi),
         "open ground owes no underside — nothing is dug under it");
  why = "";
  n = hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  assert(n > 0, "the cellar went in on {n} cells: {why}");
  gi2 = layer_of(w, 0, 0, hex_voxel::LABEL_GROUND);
  assert(hex_editor::col_has_below(world_column(w, 0, 0), gi2),
         "and now it is a ceiling: something occupied lies below it");
  // ⚠ AND THE CELLAR FLOOR IS NOT. It is the bottom of the stack, so the predicate
  // must say no — a version that answered "is this column storeyed" would say yes to
  // every layer in it and put a second fan under the floor you stand on.
  ci = 0;
  for i in 0..len(world_column(w, 0, 0).co_cells) {
    if hex_voxel::hex_occupied(world_column(w, 0, 0).co_cells[i] ?? hex_voxel::Hex {})
       && i < gi2 { ci = i; }
  }
  assert(!hex_editor::col_has_below(world_column(w, 0, 0), ci),
         "the cellar floor has nothing under IT");
}

fn test_a_deck_and_the_ground_under_it_are_both_ceilings() {
  // A storey ABOVE is the mirror case, and it is worth pinning because it is the one
  // the predicate must NOT change: a deck already gets its underside unconditionally,
  // and the ground under a deck is still open ground with nothing dug beneath it.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 1, 2, why);
  gi = layer_of(w, 0, 0, hex_voxel::LABEL_GROUND);
  assert(!hex_editor::col_has_below(world_column(w, 0, 0), gi),
         "a deck overhead does not put anything UNDER the ground");
}

fn test_open_ground_is_told_from_unauthored_ground_by_the_column() {
  // ⚠ THE TWO ARE THE SAME CELL. Absence is `h_material == 0` and there is no field
  // for intent, while the renderer draws an unauthored cell as ground on purpose —
  // that fallback is what makes an empty world a plane rather than a void. So the
  // rule cannot read the cell; it reads what is UNDER it.
  w = world();
  assert(!hex_editor::ground_open(w, 0, 0), "authored ground is not a hole");
  assert(!hex_editor::ground_open(w, 40, 40),
         "and neither is ground nobody ever touched — the plane survives");
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  assert(!hex_editor::ground_open(w, 0, 0),
         "digging a cellar does not by itself open the floor over it");
}

fn test_the_cellar_stair_opens_the_ground_only_where_the_fold_rule_demands_it() {
  // ⚠ THE STAIR EXISTS BECAUSE OF `F1`, NOT BECAUSE OF THE DRAWING. A tread under an
  // intact ground is refused the moment it comes within ε — measured on this world:
  // ground−8 accepted, ground−6 `CW_FOLD`. Eight units is two and a half strides, so
  // no stair could arrive while the floor stayed whole.
  //
  // ⚠ AND IT OPENS EVERY TREAD, WHICH THE FIRST VERSION DID NOT. Opening only what
  // `F1` forces leaves the deepest tread under an intact floor — and `world_surface`
  // takes the highest layer at or below `feet + ε/2`, where ε/2 is exactly one
  // stride, so a walker on that tread finds the FLOOR and climbs back out. The
  // stair went down one step and returned you to the room. A stairwell is open along
  // its whole length, which is both simpler and what one actually is.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  n = hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  assert(n == 3, "a storey of 12 takes three strides of 3, got {n}: {why}");
  for d in 1..4 {
    (tq, tr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), d);
    assert(hex_editor::ground_open(w, tq, tr),
           "tread {d} is open to the room above");
  }
  // ⚠ AND NOTHING ELSE IS. A gesture that opened the disc would be a cellar with no
  // floor over it at all, which every count here would still call a success.
  assert(!hex_editor::ground_open(w, 0, 0), "the room itself keeps its ceiling");
  (bq, br) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 3.14159), 1);
  assert(!hex_editor::ground_open(w, bq, br),
         "and so does the cell behind the author");
}

fn test_a_cellar_stair_is_walkable_end_to_end() {
  // The claim the gesture actually makes: every step from the cellar floor to the
  // ground is one the walker that built it can climb. A stair it cannot climb is
  // the same defect as no stair, and it would pass every structural check.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  // ⚠ WALKED DOWNWARD, CARRYING THE FEET, and the first version of this test got it
  // wrong in a way worth keeping: it asked for the surface at each tread with the
  // feet at 41 — above the ground — and over the DEEPEST tread the floor is still
  // intact, so the query correctly answered "the floor" and the test read it as a
  // 12-unit step. `world_surface` takes the feet because a storeyed column has no
  // single surface; a test that pins the feet is asking about a different walker at
  // every cell.
  feet = 40.0;
  for d in 0..3 {
    (tq, tr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), 3 - d);
    sf = hex_voxel::world_surface(w, tq, tr, feet);
    drop = (feet as integer ?? 0) - sf.sf_units;
    assert(drop > 0 && drop <= 3,
           "tread {3 - d} is {drop} down from {feet}, which is not one stride");
    feet = sf.sf_units as float;
  }
  // …and off the bottom tread onto the cellar floor itself.
  last = hex_voxel::world_surface(w, 0, 0, feet);
  assert((feet as integer ?? 0) - last.sf_units <= 3,
         "the last step onto the cellar floor is "
       + "{(feet as integer ?? 0) - last.sf_units}");
  assert(last.sf_units == 40 - hex_editor::STOREY_H,
         "and it lands on the cellar floor, got {last.sf_units}");
}

fn test_a_room_is_a_floor_with_something_over_it_and_a_deck_is_not() {
  // ⚠ A VOID IS NOT A ROOM, and no count can tell them apart. Two stacked decks in
  // the open have exactly the shape a cellar has — a floor, a ceiling over it, and
  // missing neighbours at the edge — and they must draw opposite things there: the
  // deck's edge is a rim you see the garden past, the cellar's is a cut face through
  // earth. Every edge test agrees on both. What separates them is which side of the
  // ground they lie on.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 1, 2, why);          // a deck ABOVE
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);      // and a cellar BELOW
  col = world_column(w, 0, 0);
  gi = layer_of(w, 0, 0, hex_voxel::LABEL_GROUND);
  ci = 0;
  for i in 0..gi {
    if hex_voxel::hex_occupied(col.co_cells[i] ?? hex_voxel::Hex {}) { ci = i; }
  }
  assert(hex_editor::col_underground(col, ci), "the cellar is under the ground");
  assert(!hex_editor::col_underground(col, gi), "the ground itself is not");
  di = hex_editor::col_next_above(col, gi);
  assert(di > gi, "the deck is above the ground, got {di}");
  assert(!hex_editor::col_underground(col, di),
         "and the deck is NOT underground — its edge is a rim, not a wall");
  // …and the ceilings each room looks up at.
  assert(hex_editor::col_next_above(col, ci) == gi,
         "the cellar's ceiling is the ground");
  assert(hex_editor::col_next_above(col, di) < 0,
         "and the deck has nothing over it, so it is no room at all");
}

fn test_a_room_does_not_end_at_a_chunk_seam() {
  // ⚠ THIS TEST ONCE ASSERTED THE BUG. A cellar dug across a chunk boundary came
  // back carrying a DIFFERENT LABEL in each chunk, so this said *"the seam really
  // does split the label"* and went on to prove the drawing survived it. The writer
  // is fixed now (`hex_voxel/tests/seam_labels.loft`) and the same line asserts the
  // opposite — which is the point of having written it as a fact about the store
  // rather than folding it into the drawing claim.
  //
  // What is still worth pinning is that the PICTURE does not depend on the labels
  // being right: §5 defines continuity by height and proves it unique, `I1` is a
  // claim *about* that match rather than a second definition of it, and
  // `room_continues` asks the geometric question. A reader that cannot be misled is
  // worth keeping even once the writer stops misleading it.
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 4..5 {
    for r in 0 - 4..5 { hex_editor::ground_set(w, q, r, 40, hex_editor::SURFACE_MAT); }
  }
  why = "";
  // Centred ON the seam: r = 0 is the first row of one chunk, r = -1 the last of the
  // one below it, and the disc spans both.
  n = hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  assert(n == 19, "the disc went in whole across the seam, got {n}: {why}");
  lo = 40 - hex_editor::STOREY_H;
  hi = 40 - hex_editor::SLAB_THICK;
  a = world_column(w, 0, 0);
  b = world_column(w, 0, 0 - 1);
  assert(hex_voxel::world_chunk_of(0) != hex_voxel::world_chunk_of(0 - 1),
         "the disc really does straddle a seam, or this proves nothing");
  assert((a.co_ids[0] ?? 0) == (b.co_ids[0] ?? 0),
         "ONE cellar, ONE label across the seam: "
       + "{a.co_ids[0] ?? 0} vs {b.co_ids[0] ?? 0}");
  // …and the room continues across it.
  assert(hex_editor::room_continues(w, 0, 0 - 1, lo, hi),
         "the room continues from (0,0) into (0,-1) across the seam");
  assert(hex_editor::room_continues(w, 0, 0, lo, hi),
         "and back the other way");
  // ⚠ THE CONTROL: outside the disc it must still END, or the predicate is vacuous
  // and the cellar has no walls at all.
  assert(!hex_editor::room_continues(w, 0, 4, lo, hi),
         "and it does end where the digging stopped");
}

fn test_ground_below_the_ceiling_is_earth_and_not_an_opening() {
  // ⚠ THE CASE THAT EMPTIED THE WALLS — 240 vertices down to 12. One hex outside the
  // disc a hillside falls away, so the GROUND there sits below the room's ceiling; a
  // predicate that asked only "is there an occupied cell below my ceiling" read that
  // as an open void and drew no wall against it. It is solid earth, which is the
  // whole reason a wall is owed there.
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 6..7 {
    for r in 0 - 6..7 {
      // Falling away toward +q: by q = 3 the ground is well under the room's ceiling.
      h = 40 - 6 * q;
      if h < 16 { h = 16; }
      hex_editor::ground_set(w, q, r, h, hex_editor::SURFACE_MAT);
    }
  }
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  lo = 40 - hex_editor::STOREY_H;
  hi = 40 - hex_editor::SLAB_THICK;
  // Ground at (4,0) is 16 — below the room's ceiling of 38 — and still not a room.
  assert(hex_editor::terrain_h(4, 0, w) < hi,
         "the hillside really is under the ceiling: {hex_editor::terrain_h(4, 0, w)} < {hi}");
  assert(!hex_editor::room_continues(w, 4, 0, lo, hi),
         "and it is earth, so the room ends against it");
}

fn test_a_slab_edge_shows_wherever_the_neighbour_is_not_solid() {
  // ⚠ NO TOLERANCE, AND TWO WRONG ONES CAME FIRST. Posed as "does my floor continue",
  // this was a question about which LAYER the neighbour's cell was in, so the answer
  // became which slack identifies a layer — ε/2 first, then θ, and each was wrong in
  // the opposite direction. It is not a layer question: a slab's edge is exposed
  // where there is nothing beside it.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  lo = 40 - hex_editor::STOREY_H;
  assert(hex_editor::solid_at(w, 1, 0, lo), "a flat neighbour is solid at my height");
  // ⚠ ONE UNIT IS ENOUGH, which is the claim no tolerance can make.
  assert(!hex_editor::solid_at(w, 1, 0, lo + 1),
         "one unit above the neighbour's floor is air, so that much of my edge shows");
  // ⚠ AND THE CELLAR'S OWN PERIMETER IS BURIED. Outside the disc the column holds only
  // the ground, so everything under it is undug earth — the slab edge there is inside
  // solid ground and owes nothing. What the room shows at that edge is the WALL.
  assert(hex_editor::solid_at(w, 4, 0, lo),
         "undug ground is solid all the way down");
}

fn test_a_deck_over_air_is_not_buried_by_a_deck_far_above_it() {
  // ⚠ THE CASE THAT KILLED THE FIRST TOLERANCE-FREE VERSION. "Any occupied cell at or
  // above me" reads as buried — and a deck at mid-height beside a column holding the
  // ground far below and another deck far above is standing in AIR, with its whole
  // edge showing. A column's cells are SURFACES, so solidity is the spans between
  // them, not everything under the topmost one.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 1, 2, why);          // a deck at 40 + STOREY_H
  hex_editor::storey_add(w, 0, 0, 1, 2, why);          // and another above that
  col = world_column(w, 0, 0);
  top = hex_editor::col_top(col);
  mid = 40 + hex_editor::STOREY_H / 2 ?? 0;            // between the ground and the deck
  assert(top > mid, "the upper deck is above the height under test");
  assert(!hex_editor::solid_at(w, 0, 0, mid),
         "a height between two floors is AIR, whatever stands above it");
  // …and the spans themselves are solid: at a floor, and one thickness under it.
  assert(hex_editor::solid_at(w, 0, 0, top), "at a floor's own height it is solid");
  assert(hex_editor::solid_at(w, 0, 0, top - hex_editor::SLAB_THICK),
         "and through its thickness");
  assert(!hex_editor::solid_at(w, 0, 0, top - hex_editor::SLAB_THICK - 1),
         "but not below it, which is the room under that floor");
}

fn test_a_stair_tread_shows_its_riser_at_any_stride() {
  // ⚠ THE PROPERTY THAT SURVIVES BOTH CONSTANTS MOVING. A tread stands above the cell
  // beside it by the stride, so its edge is exposed by that much — at any stride. The
  // label version drew none at any size; the two tolerance versions drew them at some
  // sizes and not others, which is how a coincidence between an anatomy constant and
  // a store constant came to decide whether stairs have risers.
  lo = 40 - hex_editor::STOREY_H;
  ceil = 40 - hex_editor::SLAB_THICK;
  for stride in 2..6 {
    w = world();
    why = "";
    hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
    n = hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), stride, why);
    assert(n > 0, "a stair of stride {stride} went in: {why}");
    (tq, tr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), 1);
    // ⚠ THE NEIGHBOUR'S COLUMN AT THE TREAD'S HEIGHT — which is the way round the
    // renderer asks it, and I got it backwards twice writing this. The tread stands
    // at `lo + stride`; beside it, at that same height, the room's own column holds
    // nothing but air, so the tread's edge shows.
    assert(!hex_editor::solid_at(w, 0, 0, lo + stride),
           "stride {stride}: beside the tread, at its height, the room is air");
    // ⚠ AND THE ROOM CONTINUES EITHER WAY, which is why these are two questions and
    // not one. The plane steps; the void does not.
    assert(hex_editor::room_continues(w, tq, tr, lo, ceil),
           "stride {stride}: the room runs past the step");
  }
}

fn test_the_walkers_stride_must_clear_theta_or_a_stair_is_a_ramp() {
  // ⚠ THE RELATION THIS PINS IS BETWEEN A WALKER AND THE STORE, and nothing else in
  // the tree states it. θ is *the largest step read as continuous*, so a stair whose
  // rise does not exceed it is not a stair — every tread reads as more of the same
  // floor and no riser is drawn anywhere. It would look like a ramp and pass every
  // structural test, because the STORE would be perfectly correct.
  //
  // Today `cliff_step()` is 4 against θ 3: one unit of margin, and the margin is the
  // whole point of writing it down. It was ZERO against the tolerance this used
  // before (ε/2, also 4), which is how a coincidence between an anatomy constant and
  // a store constant came to decide whether stairs have risers.
  //
  // ⚠ AND THE OTHER HALF IS `ε > 2θ`, the one inequality relating the two world
  // constants — `B1` needs it for the match to be unique at all, and a world
  // violating it is refused at creation rather than failing quietly later.
  w = world();
  assert(w.w_eps > 2 * w.w_theta,
         "B1: ε ({w.w_eps}) must exceed 2θ ({2 * w.w_theta})");
  // The stride is the caller's — `hex_editor` must not depend on a moros package —
  // so this asserts the RELATION for the value the editor actually passes.
  stride = 4;
  assert(stride > w.w_theta,
         "a stride of {stride} clears θ ({w.w_theta}), so a stair reads as steps");
  // …and the negative control: at θ it would not, which is the failure mode named.
  assert(!(w.w_theta > w.w_theta), "a stride of θ would read as continuous floor");
}

fn test_a_stair_tread_does_not_wall_itself_off_from_its_own_room() {
  // A tread is a stride above the floor it belongs to, so "the neighbour is at my
  // height" would put a wall across the bottom of the stair. Two voids join when
  // they OVERLAP, which is the rule, and this is the case that needs it.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  lo = 40 - hex_editor::STOREY_H;
  hi = 40 - hex_editor::SLAB_THICK;
  (tq, tr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), 1);
  assert(hex_editor::room_continues(w, tq, tr, lo, hi),
         "the first tread is part of the room, three units up though it is");
}

fn test_a_second_cellar_climbs_to_the_room_above_and_not_to_the_ground() {
  // ⚠ FOUND BY A GATE, WHICH IS WHY IT IS HERE. `surface.mjs` digs twice and read
  // back `stair of 5` — five treads climbing from the deepest floor, straight past
  // the cellar in between, which is still there. A stair to "the ground" is only
  // right while there is nothing between; pressing `C` twice makes a room under a
  // room and the stair belongs to the pair it joins.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  n = hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  assert(n == 3, "the sub-basement gets its own three treads, got {n}: {why}");
  // Every tread lies between the two floors — never above the one it climbs to.
  deep = 40 - 2 * hex_editor::STOREY_H;
  mid = 40 - hex_editor::STOREY_H;
  for d in 1..4 {
    (tq, tr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), d);
    sf = hex_voxel::world_surface(w, tq, tr, (mid - 1) as float);
    assert(sf.sf_units > deep && sf.sf_units < mid,
           "tread {d} at {sf.sf_units} is between {deep} and {mid}");
  }
}

fn test_a_stair_stops_when_it_reaches_the_surface_rather_than_leaving_it() {
  // ⚠ ALSO FOUND BY A GATE, AND IT WAS A FLIGHT OF STEPS FLOATING OVER A HILLSIDE.
  // A stair is a straight run at a fixed pitch, so deriving every tread from the
  // column it starts in reads as the obvious thing — but the surface it climbs
  // toward is a HEIGHTFIELD, and downhill it falls away faster than the stair rises.
  // `ground.mjs` measured the drawn peak going 10.917 -> 11.25 wu on a dig it should
  // not have moved at all.
  //
  // Arriving early is not a failure: it is a shorter stair, which is what a slope
  // should give. What must never happen is a tread standing above the ground it is
  // supposed to come up through.
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 10..11 {
    for r in 0 - 10..11 {
      // A ramp falling away toward +q, which is where the stair will run.
      h = 40 - 3 * q;
      if h < 14 { h = 14; }
      hex_editor::ground_set(w, q, r, h, hex_editor::SURFACE_MAT);
    }
  }
  // ⚠ THE HILLSIDE IS READ BEFORE THE WELL IS CUT, because the cut REMOVES it.
  // A stairwell clears the ground cell at every tread, so `terrain_h` afterwards
  // asks about a hole. It used to answer the height the cleared cell still carried
  // in its bytes — material 0, height 37 — and that is a GHOST: `E1e` says a cell
  // holding only a height is not present, so a save elides it and the identical
  // read comes back 0 on the next load. The claim here is about the slope the stair
  // descends INTO, which is a quantity only the pre-cut world holds.
  pre: vector<integer> = [];
  for d in 0..24 {
    (pq, pr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), d);
    pre += [hex_editor::terrain_h(pq, pr, w)];
  }
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  n = hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  assert(n >= 0, "the stair is not an error on a slope: {why}");
  assert(n < 24, "the stair is no longer than the profile read ahead of it ({n} treads)");
  for d in 1..(n + 1) {
    (tq, tr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), d);
    gnd = pre[d] ?? 0;
    // ⚠ THE TOP OF THE COLUMN, NOT `world_surface` — the query alone cannot make
    // this claim. Asked for the surface under the ground, it answers the highest
    // layer AT OR BELOW those feet, and falls back to the LOWEST when none
    // qualifies. A tread floating above the hillside is exactly the case that
    // qualifies for neither, so it comes back as the cellar floor far below and
    // reads as a pass. `F1″` makes layer order height order, so the last occupied
    // cell is the topmost (`E1r`) — and that is the number the claim is about.
    col = world_column(w, tq, tr);
    top = 0 - 1;
    for c in col.co_cells {
      if hex_voxel::hex_occupied(c) { top = c.h_height as integer ?? 0; }
    }
    assert(top >= 0, "tread {d} at ({tq},{tr}) put something in its column");
    assert(top < gnd,
           "tread {d}'s column tops out at {top}, under the ground it came "
           + "through at {gnd}, not over it");
  }
}

fn test_the_stair_leaves_a_wall_standing_where_it_cuts() {
  // ⚠ `E1e` — A CELL HOLDING A WALL IS PRESENT WHATEVER ITS MATERIAL. Clearing the
  // ground for a stairwell must take the ground and nothing else; a version that
  // wrote a blank cell would delete a wall the opening happened to run beside, and
  // the loss would be invisible until the house was walked round.
  w = world();
  why = "";
  hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  (wq, wr) = hex_editor::ray_cell_at(hex_editor::author_at(0.0, 0.0, 0.0), 3);
  gl = hex_voxel::world_ground_layer(w, wq, wr);
  col = world_column(w, wq, wr);
  cells: vector<hex_voxel::Hex> = [];
  ids: vector<integer> = [];
  for i in 0..len(col.co_cells) {
    c = col.co_cells[i] ?? hex_voxel::Hex {};
    if i == gl {
      cells += [hex_voxel::Hex { h_height: c.h_height, h_material: c.h_material,
                                 h_wall_nw: 7 as u8? ?? 0 }];
    } else { cells += [c]; }
    ids += [col.co_ids[i] ?? 0];
  }
  world_set_column(w, hex_voxel::Column { co_q: wq, co_r: wr, co_cells: cells,
                                          co_ids: ids });
  hex_editor::cellar_stair(w, hex_editor::author_at(0.0, 0.0, 0.0), 3, why);
  assert(hex_editor::ground_open(w, wq, wr), "the stairwell did open that cell");
  after = hex_voxel::world_cell(w, wq, wr, hex_voxel::world_ground_layer(w, wq, wr));
  assert((after.h_wall_nw as integer ?? 0) == 7,
         "and the wall on it is untouched, got {after.h_wall_nw}");
}

fn test_a_cellar_with_no_room_below_is_refused_for_the_right_reason() {
  // The reserve is the floor of the world. Digging through it is refused, not
  // clamped — a clamped cellar is a room the walker cannot stand in.
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 4..5 {
    for r in 0 - 4..5 { hex_editor::ground_set(w, q, r, 2, hex_editor::SURFACE_MAT); }
  }
  before = w.w_tau;
  why = "";
  n = hex_editor::storey_add(w, 0, 0, 0 - 1, 2, why);
  assert(n < 0, "a cellar under a two-unit ground is refused, got {n}");
  assert(why != "", "with a reason: {why}");
  assert(w.w_tau == before, "and nothing was written first: τ {before} -> {w.w_tau}");
}

fn test_the_stair_cuts_one_step_and_the_step_height_is_the_callers() {
  // ⚠ THE HEIGHT COMES FROM THE CALLER. It used to be read from `moros_sim` — a
  // MOROS package — inside the gesture, which pointed the dependency backwards:
  // the rule about what a walker can climb belongs to whoever owns the walker.
  w = world();
  why = "";
  h = hex_editor::stair_cut(w, 1, 0, 40.0 * 0.25, 40, 1, 3, why);
  assert(h == 43, "one three-unit step up from 40, got {h}: {why}");
  down = hex_editor::stair_cut(w, 2, 0, 40.0 * 0.25, 40, 0 - 1, 3, why);
  assert(down == 37, "and one down, got {down}");
}

fn test_a_step_through_the_floor_is_refused_with_the_offer() {
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 4..5 {
    for r in 0 - 4..5 { hex_editor::ground_set(w, q, r, 1, hex_editor::SURFACE_MAT); }
  }
  why = "";
  h = hex_editor::stair_cut(w, 1, 0, 0.25, 1, 0 - 1, 3, why);
  assert(h < 0, "cutting below the world's floor is refused, got {h}");
  assert(why.contains("offer"), "with an offer: {why}");
  assert(why.contains("residual"), "and a residual: {why}");
}

fn test_a_storey_costs_exactly_one_layer_however_many_columns_it_touches() {
  // ⚠ THE DEFECT THIS PINS COST ELEVEN LAYERS A STOREY. A layer is CHUNK-WIDE
  // while the gesture writes a DISC of 19 columns, and each column read one cell
  // more than the last — the layer its neighbour had just made, absent at this hex
  // — and appended yet another. Measured then: 12, 23, 34 layers for three
  // storeys, against a LAYER_CAP of 64, so a six-storey tower hit the cap.
  //
  // The stack of OCCUPIED cells was right either way (25, 37, 49, 61), which is
  // why nothing caught it until something counted LAYERS. Exactly one per storey,
  // not "a few" — the defect was a constant factor and any slack admits it back.
  w = world();
  before = len(w.w_chunks[0].ck_layers);
  why = "";
  for i in 0..3 {
    hex_editor::storey_add(w, 0, 0, 1, 2, why);
    want = before + i + 1;
    got = len(w.w_chunks[0].ck_layers);
    assert(got == want, "storey {i + 1}: {want} layers, got {got}");
  }
}

fn test_a_storey_is_a_slab_and_a_clear_height_rather_than_a_line() {
  // ⚠ `storey_split` WAS WRITTEN, TESTED, AND CALLED BY NOTHING THAT BUILDS A
  // STOREY. `slab.loft` proved the arithmetic and `slab_over` used it for a house's
  // ceiling; the GESTURE did the addition itself and knew nothing about a thickness,
  // so a storey was a line and there was nowhere to say where the room below ended.
  // That is the same shape as `op_depth` reaching the library and stopping there,
  // and as `boom_take` being tested and never called.
  //
  // The claim is that the two agree — the deck the gesture writes is exactly the
  // `next` floor the decomposition names — so the ceiling is derivable from what was
  // built rather than being a second opinion about it.
  w = world();
  why = "";
  n = hex_editor::storey_add(w, 0, 0, 1, 2, why);
  assert(n > 0, "the storey went on: {why}");
  deck = hex_editor::col_top(world_column(w, 0, 0));
  ceil = 0;
  next = 0;
  hex_editor::storey_split(40, hex_editor::STOREY_H, hex_editor::SLAB_THICK, ceil, next);
  assert(deck == next, "the deck is the decomposition's own floor: {deck} vs {next}");
  assert(next - ceil == hex_editor::SLAB_THICK,
         "and the slab between them is one thickness: {next - ceil}");
  // …and the room below is a room: a ceiling at or under its own floor would mean a
  // storey pitch that cannot hold a slab at all, which is the case the decomposition
  // exists to make visible.
  assert(ceil > 40, "the room below has clear height {ceil - 40}");
  assert(hex_editor::slab_clear(40, hex_editor::slab_over(
           hex_editor::pose_footprint(0.0, 0.0, 0.0, 5, 4), 40,
           hex_editor::STOREY_H, hex_editor::SLAB_THICK)) == ceil - 40,
         "and `slab_clear` agrees with it");
}
