//
// S5 — AN OPENING IS A MATERIAL, AND THE WALL STAYS WHOLE.
//
// ⚠ `X70`, measured before it was a rule. Moros stored a door as wall material 0
// once, and hexbody measured what that costs: the wall RUN breaks — 38 edges with
// 0 ends becoming 36 with 2 — because a cleared edge cannot be told from no edge,
// so the recovery that finds a wall loses its middle. The boundary is still there;
// what changes is what it is made of.
//
// The consequence a renderer must honour, and the reason this is S5 rather than a
// store detail: an opening is a SUB-INTERVAL of the wall, not a shorter wall.
use hex_editor;
use hex_voxel;
use hex_grid;

fn world() -> VoxelWorld {
  w = world_new(0.25, 0, 8, 3).wn_world;
  for q in 0 - 12..13 {
    for r in 0 - 12..13 { hex_editor::ground_set(w, q, r, 8, hex_editor::SURFACE_MAT); }
  }
  w
}

// A ring of wall around the origin, and an author standing on it.
fn walled() -> VoxelWorld {
  w = world();
  hex_editor::fence_disc(w, 0, 0, 2, hex_editor::WALL_MAT, 2.0);
  w
}

fn owned_of(w: VoxelWorld, mat: integer) -> integer {
  n = 0;
  for q in 0 - 6..7 {
    for r in 0 - 6..7 {
      for d in 0..6 {
        (oq, orr, _s) = hex_editor::edge_owner(q, r, d);
        if oq == q && orr == r && hex_editor::wall_of(w, q, r, d, 2.0) == mat { n = n + 1; }
      }
    }
  }
  n
}

fn at_the_wall(w: VoxelWorld) -> Author {
  // Standing ON a ring cell, which is where an author is when they open a wall.
  (x, z) = hex_to_px(2, 0);
  hex_editor::author_on(w, x, z, 0.0)
}

fn test_an_opening_changes_a_material_and_deletes_no_edge() {
  // THE CLAIM. Count the boundary before and after: the total is untouched, one of
  // them simply reads differently.
  w = walled();
  walls0 = owned_of(w, hex_editor::WALL_MAT);
  doors0 = owned_of(w, hex_editor::DOOR_MAT);
  ack = hex_editor::open_ahead(w, at_the_wall(w), hex_editor::DOOR_MAT, 1);
  assert(ack.ak_ok, "the opening was cut: {ack.ak_why}");
  walls1 = owned_of(w, hex_editor::WALL_MAT);
  doors1 = owned_of(w, hex_editor::DOOR_MAT);
  assert(doors1 == doors0 + ack.ak_n, "{ack.ak_n} edges became doors, got {doors1 - doors0}");
  assert(walls0 - walls1 == ack.ak_n, "and exactly that many stopped being wall");
  assert(walls1 + doors1 == walls0 + doors0,
         "the boundary is the same size: {walls0 + doors0} -> {walls1 + doors1}");
}

fn test_a_wider_opening_takes_more_edges() {
  w = walled();
  ack = hex_editor::open_ahead(w, at_the_wall(w), hex_editor::DOOR_MAT, 2);
  assert(ack.ak_ok, "a two-edge opening: {ack.ak_why}");
  assert(ack.ak_n == 2, "took two edges, got {ack.ak_n}");
  assert(owned_of(w, hex_editor::DOOR_MAT) == 2, "and both are doors");
}

fn test_a_window_is_its_own_material_not_a_door() {
  // They differ in what the RENDERER does — a door leaves nothing, a window leaves
  // a sill below and a head above — so they cannot share a material.
  w = walled();
  hex_editor::open_ahead(w, at_the_wall(w), hex_editor::WINDOW_MAT, 1);
  assert(owned_of(w, hex_editor::WINDOW_MAT) == 1, "one window");
  assert(owned_of(w, hex_editor::DOOR_MAT) == 0, "and no door");
  assert(hex_editor::is_opening(hex_editor::WINDOW_MAT), "a window is an opening");
  assert(hex_editor::WINDOW_SILL < hex_editor::WINDOW_HEAD,
         "and it leaves a sill below its head");
}

fn test_opening_thin_air_is_refused() {
  // ⚠ NEVER A DOOR IN MID-AIR. Writing the material blind would put an opening
  // wherever the author happened to stand, and an opening with no wall around it
  // is a boundary the model believes in and the picture cannot show.
  w = world();
  before = w.w_tau;
  ack = hex_editor::open_ahead(w, hex_editor::author_on(w, 0.0, 0.0, 0.0),
                               hex_editor::DOOR_MAT, 1);
  assert(!ack.ak_ok, "an opening with no wall is refused");
  assert(ack.ak_why != "", "with a reason: {ack.ak_why}");
  assert(w.w_tau == before, "and nothing was written: τ {before} -> {w.w_tau}");
}

fn test_a_material_that_is_not_an_opening_is_refused_without_an_offer() {
  // Nominal, like every other material in this editor: a fence is not "nearly" a
  // door, and offering one would change what the hole IS.
  w = walled();
  ack = hex_editor::open_ahead(w, at_the_wall(w), hex_editor::FENCE_MAT, 1);
  assert(!ack.ak_ok, "a fence is not an opening");
  assert(!ack.ak_why.contains("offer"), "and gets no offer: {ack.ak_why}");
}

fn test_an_absurd_width_is_refused_with_one() {
  // Ordinal, so it does: a width has a nearest admissible value.
  w = walled();
  ack = hex_editor::open_ahead(w, at_the_wall(w), hex_editor::DOOR_MAT, 40);
  assert(!ack.ak_ok, "forty edges is refused");
  assert(ack.ak_why.contains("offer 6"), "with the widest that fits: {ack.ak_why}");
  assert(ack.ak_why.contains("residual 34"), "and how far off: {ack.ak_why}");
}

fn test_the_renderer_can_find_the_opening_by_position() {
  // What `emit_run_wall` needs: given a point on the wall, what is the edge made
  // of. Without this the band is drawn whole and the hole never reaches a picture.
  w = walled();
  hex_editor::open_ahead(w, at_the_wall(w), hex_editor::DOOR_MAT, 1);
  (x, z) = hex_to_px(2, 0);
  found = 0;
  for d in 0..6 {
    (nq, nr) = hex_neighbor(2, 0, d);
    (nx, nz) = hex_to_px(nq, nr);
    m = hex_editor::edge_mat_at(w, (x + nx) * 0.5, (z + nz) * 0.5, 2.0);
    if m == hex_editor::DOOR_MAT { found = found + 1; }
  }
  assert(found > 0, "the door is findable from a point on it");
}

// ── `S2a` — THE CHOOSING, WHICH USED TO NEED A SOCKET ────────────────────────
//
// ⚠ EVERY CLAIM BELOW WAS UNREACHABLE FROM A TEST UNTIL 2026-08-11. The wall
// projection, the tens-and-twenties reading and the niche host lived in
// `editor_server`'s `36:` handler, so the only instrument was a scripted
// screenshot — and the handler's own comments record what that cost: *"measured,
// three of four profiles cut nothing at all while the fourth worked by luck of
// rounding"*. Moving them is plan 22 `S2a`; the wire is proved unchanged over
// eight scripts and 240 report lines.

fn a_run(x0: float, z0: float, x1: float, z1: float) -> hex_editor::WallRuns {
  out = hex_editor::WallRuns { items: [] };
  out.items += [hex_editor::WallRun { wr_x0: x0, wr_z0: z0, wr_x1: x1, wr_z1: z1 }];
  out
}

fn no_openings() -> hex_editor::Openings { hex_editor::Openings { items: [] } }

// ⚠ THE DEFECT THE PROJECTION EXISTS FOR. A cell centre can sit half a hex off the
// run — 0.75 m — and a hole 1.1 m wide centred there misses the wall entirely.
fn test_the_hole_lands_on_the_wall_and_not_where_the_author_stands() {
  runs = a_run(0.0, 0.0, 12.0, 0.0);
  made = hex_editor::opening_make(runs, no_openings(), 4.0, 2.5,
                                  hex_editor::OP_ROUND, 12, 0.25);
  assert(made.om_ok, "the fixture refused: {made.om_why}");
  assert(made.om_open.op_z > 0.0 - 0.001 && made.om_open.op_z < 0.001,
         "the hole is at z={made.om_open.op_z} and the wall is at z=0 — the author "
       + "stood 2.5 away from it");
  assert(made.om_open.op_x > 3.999 && made.om_open.op_x < 4.001,
         "and it slid along the run to x={made.om_open.op_x} rather than staying at 4");
  // ⚠ THE CONTROL, and it is what makes the assertion above mean *projected*: with
  // no run to project onto, the author's own position is the honest answer, and a
  // routine that always answered z=0 would pass the first half of this test.
  none = hex_editor::opening_make(hex_editor::WallRuns { items: [] }, no_openings(),
                                  4.0, 2.5, hex_editor::OP_ROUND, 12, 0.25);
  assert(none.om_open.op_z > 2.499 && none.om_open.op_z < 2.501,
         "with no wall anywhere the hole is at z={none.om_open.op_z}, not under the "
       + "author at 2.5");
}

// ⚠ THE CLAIM THE WHOLE FAMILY RESTS ON: `11` is a round-headed NICHE and `1` a
// round-headed doorway — THE SAME CURVE, STOPPED SHORT. If the tens were a sixth
// kind instead of a depth, these two would differ in outline as well.
fn test_the_tens_are_depth_and_the_units_are_the_profile() {
  runs = a_run(0.0, 0.0, 12.0, 0.0);
  door  = hex_editor::opening_make(runs, no_openings(), 4.0, 1.0, 1, 12, 0.25);
  niche = hex_editor::opening_make(runs, no_openings(), 4.0, 1.0, 11, 12, 0.25);
  assert(door.om_ok && niche.om_ok, "the fixture refused one of them");
  assert(door.om_kind == niche.om_kind && door.om_kind == hex_editor::OP_ROUND,
         "the outlines differ: {door.om_kind} against {niche.om_kind}");
  assert(door.om_open.op_depth >= 1.0,
         "a doorway goes through: depth {door.om_open.op_depth}");
  assert(niche.om_open.op_depth < 1.0,
         "a niche stops short: depth {niche.om_open.op_depth}");
  // A niche starts at a seat's height rather than at the floor — a sleeping alcove
  // is cut into the wall above the bed, not into the skirting.
  assert(niche.om_open.op_lo > door.om_open.op_lo,
         "the niche's sill is at {niche.om_open.op_lo} and the doorway's at "
       + "{door.om_open.op_lo}");
}

// ⚠ THE TWENTIES ARE COMPOSITION, and the refusal is by NAME rather than by silence.
fn test_an_embrasure_with_no_niche_is_refused_by_name() {
  runs = a_run(0.0, 0.0, 12.0, 0.0);
  made = hex_editor::opening_make(runs, no_openings(), 4.0, 1.0, 21, 12, 0.25);
  assert(!made.om_ok, "a window was cut into a niche that does not exist");
  assert(made.om_code == hex_editor::OM_NO_HOST,
         "refused with code {made.om_code}, not OM_NO_HOST");
  assert(made.om_back, "and it still knows it was asked for a back-cut");
}

// …and with one, the child starts where the host STOPS. That datum is the whole
// reason an embrasure needs no primitive of its own.
fn test_an_embrasure_starts_where_its_niche_stops() {
  runs = a_run(0.0, 0.0, 12.0, 0.0);
  open = no_openings();
  host = hex_editor::opening_make(runs, open, 4.0, 1.0, 11, 12, 0.25);
  assert(host.om_ok, "the niche was refused: {host.om_why}");
  open.items += [host.om_open];

  win = hex_editor::opening_make(runs, open, 4.0, 1.0, 21, 12, 0.25);
  assert(win.om_ok, "the embrasure was refused: {win.om_why}");
  assert(win.om_open.op_near > 0.0,
         "the window is cut from the wall's own face (near {win.om_open.op_near}), "
       + "not from the back of the niche");
  assert(win.om_open.op_near == host.om_open.op_depth,
         "it starts at {win.om_open.op_near} and the niche stops at "
       + "{host.om_open.op_depth}");
  // ⚠ AND A DOORWAY IS NOT A HOST. `opening_at_back` is what tells a niche from a
  // hole that already goes through, and without it the last DOOR would be chosen.
  through = no_openings();
  through.items += [hex_editor::opening_make(runs, no_openings(), 4.0, 1.0, 1, 12, 0.25).om_open];
  nohost = hex_editor::opening_make(runs, through, 4.0, 1.0, 21, 12, 0.25);
  assert(nohost.om_code == hex_editor::OM_NO_HOST,
         "a doorway was accepted as a niche to cut into");
}

// ⚠ THE WORLD'S OWN UNIT REACHES THE PROFILE — `R1a`'s lesson, one gesture over: a
// part world is authored at another unit entirely (`door/slat` is 0.125), so a head
// struck in world units has to be measured in the world it is struck in.
//
// ⚠ THE PREDICTION WRITTEN FIRST WAS WRONG, AND THE MEASUREMENT IS THE BETTER
// CLAIM. It asserted *halving the unit doubles `op_hi`* and got **9 then 12**,
// because the SPRINGING is a fixed count of height units and only the RISE above it
// scales — and even the rise does not double, because it truncates: a round head of
// half-span 0.625 rises 2 units at 0.25 (2.5 truncated) and 5 at 0.125. So what is
// exact is the rise in WORLD units: never above the true semicircle, and within one
// of the world's own units below it.
fn test_the_profiles_head_is_measured_in_the_worlds_unit() {
  runs = a_run(0.0, 0.0, 12.0, 0.0);
  coarse = hex_editor::opening_make(runs, no_openings(), 4.0, 1.0, 1, 12, 0.25);
  fine   = hex_editor::opening_make(runs, no_openings(), 4.0, 1.0, 1, 12, 0.125);
  half = coarse.om_open.op_half;
  assert(fine.om_open.op_half == half, "the two spans differ, so nothing below compares");
  crise = ((coarse.om_open.op_hi - coarse.om_open.op_spring) as float) * 0.25;
  frise = ((fine.om_open.op_hi - fine.om_open.op_spring) as float) * 0.125;
  // ⚠ THE ONE THAT CATCHES A HARD-CODED CONSTANT: a `profile_opening` reaching for a
  // global 0.25 would strike the identical head in both worlds.
  assert(crise != frise,
         "both heads rise {crise} — the world's unit is not reaching the profile");
  assert(crise <= half && frise <= half,
         "a head rose above its own semicircle: {crise} / {frise} against {half}");
  assert(half - crise < 0.25 && half - frise < 0.125,
         "and each is within one of ITS OWN units of the true rise: "
       + "{half - crise} at 0.25, {half - frise} at 0.125");
}

// ── `S2b` — THE SELECTION, AND THE GESTURE THAT READS IT ────────────────────
//
// ⚠ `S1` WAS *"a selection in EditSession, nothing changes behaviour yet"* and it
// could not be built: a chosen profile's only possible consumer is the gesture that
// cuts one, and that gesture was eighty lines inside a socket handler until `S2a`.
// A field nobody reads is this tree's commonest defect with a planning hat on, so
// the field, the verb that sets it and the consumer are one step.
//
// ⚠ AND THE CLAIM IS NOT *the line says what is selected*. It is that picking a
// profile CHANGES WHAT THE NEXT OPENING CUTS — diffed on the `Opening`, never read
// off a sentence.

fn a_session_at_a_wall(w: VoxelWorld) -> hex_editor::EditSession {
  s = hex_editor::session_new();
  hex_editor::session_at(s, w, 0.0, 0.0, 0.0);
  s.es_runs.items += [hex_editor::WallRun { wr_x0: 0.0 - 6.0, wr_z0: 0.0,
                                            wr_x1: 6.0, wr_z1: 0.0 }];
  s
}

fn test_the_selection_decides_what_the_next_opening_cuts() {
  // Three selections, three worlds, one opening each — and the openings must differ
  // in the ways the selection names and in no others.
  round = walled();
  point = walled();
  niche = walled();
  rs = a_session_at_a_wall(round);
  ps = a_session_at_a_wall(point);
  ns = a_session_at_a_wall(niche);

  assert(hex_editor::session_select_open(rs, hex_editor::OP_ROUND).ak_ok, "round");
  assert(hex_editor::session_select_open(ps, hex_editor::OP_POINTED).ak_ok, "pointed");
  assert(hex_editor::session_select_open(ns, 10 + hex_editor::OP_ROUND).ak_ok, "a round niche");

  rm = hex_editor::session_opening(rs, round, at_the_wall(round), hex_editor::STOREY_H);
  pm = hex_editor::session_opening(ps, point, at_the_wall(point), hex_editor::STOREY_H);
  nm = hex_editor::session_opening(ns, niche, at_the_wall(niche), hex_editor::STOREY_H);
  assert(rm.om_ok && pm.om_ok && nm.om_ok,
         "the fixture refused one: {rm.om_why} / {pm.om_why} / {nm.om_why}");

  assert(rm.om_open.op_kind == hex_editor::OP_ROUND,
         "the round selection cut a {rm.om_open.op_kind}");
  assert(pm.om_open.op_kind == hex_editor::OP_POINTED,
         "the pointed selection cut a {pm.om_open.op_kind}");
  // ⚠ THE CLAIM THE FAMILY RESTS ON, ONE LAYER UP: `11` is the SAME CURVE as `1`,
  // stopped short. A selection that changed the outline as well would mean the tens
  // had become a sixth kind somewhere between the verb and the gesture.
  assert(nm.om_open.op_kind == hex_editor::OP_ROUND,
         "the round NICHE changed outline to {nm.om_open.op_kind}");
  assert(nm.om_open.op_depth < 1.0 && rm.om_open.op_depth >= 1.0,
         "the niche stops short ({nm.om_open.op_depth}) and the doorway does not "
       + "({rm.om_open.op_depth})");
  // …and a head struck to a different curve is a different height.
  assert(rm.om_open.op_hi != pm.om_open.op_hi,
         "a round head and a pointed one both reach {rm.om_open.op_hi}");

  // ⚠ AND EACH ONE REACHED THE REGISTRY THE RENDERER READS. A gesture that decided
  // correctly and appended nothing draws no hole at all — the "built and never
  // called" defect inside one function.
  assert(len(rs.es_open.items) == 1 && len(ps.es_open.items) == 1
         && len(ns.es_open.items) == 1,
         "the openings did not reach the session: {len(rs.es_open.items)} / "
       + "{len(ps.es_open.items)} / {len(ns.es_open.items)}");
}

// ⚠ THE STORE IS WRITTEN TOO, and that is why this wraps `open_ahead` rather than
// only `opening_make`. The edge material is the store's index of which boundary is
// passable — `X70` — and a gesture that set the shape and left the wall solid would
// draw a hole nobody can walk through.
fn test_the_opening_gesture_writes_the_edge_as_well_as_the_shape() {
  w = walled();
  s = a_session_at_a_wall(w);
  before = w.w_tau;
  made = hex_editor::session_opening(s, w, at_the_wall(w), hex_editor::STOREY_H);
  assert(made.om_ok, "refused: {made.om_why}");
  assert(w.w_tau > before, "the store was not written: τ {before} -> {w.w_tau}");
  // …and a wall with nothing to open is refused, with nothing appended.
  bare = world();
  bs = a_session_at_a_wall(bare);
  none = hex_editor::session_opening(bs, bare, hex_editor::author_on(bare, 0.0, 0.0, 0.0),
                                     hex_editor::STOREY_H);
  assert(!none.om_ok, "an opening was cut in thin air");
  assert(len(bs.es_open.items) == 0,
         "{len(bs.es_open.items)} openings were recorded for a hole that was refused");
}

// ⚠ A KIND THAT IS NOT ONE IS NOMINAL — `5` is not *nearly* an oculus, and `30` is
// not nearly anything. Refused without an offer, and the selection DOES NOT MOVE:
// the control is that the next opening still cuts what was chosen before.
fn test_a_selection_that_is_not_one_is_refused_and_changes_nothing() {
  w = walled();
  s = a_session_at_a_wall(w);
  assert(hex_editor::session_select_open(s, hex_editor::OP_POINTED).ak_ok, "pointed");
  for bad in [5, 15, 25, 30, 99, 0 - 1] {
    ack = hex_editor::session_select_open(s, bad);
    assert(!ack.ak_ok, "{bad} was accepted as an opening kind");
    assert(!ack.ak_why.contains("offer"), "and got no offer: {ack.ak_why}");
  }
  made = hex_editor::session_opening(s, w, at_the_wall(w), hex_editor::STOREY_H);
  assert(made.om_ok, "refused: {made.om_why}");
  assert(made.om_open.op_kind == hex_editor::OP_POINTED,
         "a refused selection moved the choice to {made.om_open.op_kind}");
}

// ⚠ AND THE ADMISSIBLE SET IS NOT A RANGE, which is the whole reason it is a
// predicate rather than a bound. `0..24` waves through nine kinds no branch answers.
fn test_every_kind_the_family_can_make_is_selectable_and_no_others() {
  ok = 0;
  for k in 0..30 {
    if hex_editor::opening_kind_ok(k) { ok = ok + 1; }
  }
  // Five outlines × three depths — through, niche, in the back of a niche.
  assert(ok == 15, "{ok} kinds are admissible, and the family has 5 x 3");
  for good in [0, 1, 2, 3, 4, 10, 11, 12, 13, 14, 20, 21, 22, 23, 24] {
    assert(hex_editor::opening_kind_ok(good), "{good} is one of the family");
  }
}
