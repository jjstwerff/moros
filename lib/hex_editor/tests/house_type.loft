//
// A HOUSE TYPE IS DATA — plan 22 `T1a.1`.
//
// > **The invariant, and it is testable: ADDING A TYPE TOUCHES NO CODE.**
// > — [EDITING_MODES](../../../doc/claude/EDITING_MODES.md)
//
// ⚠ **THAT SENTENCE IS THE ONLY ROW HERE THAT MATTERS**, and it is why the last test
// declares a 7x5 rather than asserting a parse. A parser can be perfect while the
// gesture still builds its constant, which is this tree's commonest defect wearing a
// declaration format: `slope_settle` was tested by five tests and called by no
// gesture. So the claim is made through `press_verb` — the one production consumer —
// and the world has to come out a different size.
//
// ⚠ **THE FORMAT IS PLAN 21's PALETTE, ON THE OWNER'S CALL.** A house type is
// `hex_voxel::PAL_HTYPE` slot 1 of the author's REGION, so it inherits slot-0
// absence, the 256 refusal, duplicate and newline refusals, and per-region scoping
// without any of it being written twice.
use hex_editor;
use hex_voxel;
use hex_grid;

const U     = 0.25;
const FLOOR = 40;
const YAW   = 1.5707963267948966;

fn meadow() -> VoxelWorld {
  w = world_new(U, hex_editor::W_RESERVE,
                hex_editor::WORLD_EPS, hex_editor::WORLD_THETA).wn_world;
  hex_editor::ground_fill(w, 0 - 30, 0 - 30, 61, 61, FLOOR, hex_editor::SURFACE_MAT);
  w
}

fn declare(w: VoxelWorld, body: text) {
  assert(hex_voxel::world_set_palette(w, hex_voxel::PAL_HTYPE, 0,
           [hex_voxel::PalEntry { pl_slot: hex_editor::HTYPE_DEFAULT_SLOT, pl_name: body }])
         == hex_voxel::PAL_OK, "the declaration '{body}' was refused");
}

// Place through the VERB, never through `place_house` directly — the verb is where a
// type has to be read, and a test that called the gesture would prove nothing about
// whether anything consults the table.
fn placed_by_verb(w: VoxelWorld) -> Ack {
  s = hex_editor::EditSession {};
  a = hex_editor::author_at(0.0, 0.0 - 4.0, YAW, (FLOOR as float) * U);
  s.es_author = a;
  hex_editor::press_verb(s, w, a, hex_editor::VB_PLACE, "")
}

fn footprint_cells(ack: Ack) -> integer { ack.ak_n }

// ── the parse ───────────────────────────────────────────────────────────────

fn test_a_world_that_declares_nothing_has_no_type() {
  w = meadow();
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(!ht.ht_ok, "an undeclared world has no type");
  assert(ht.ht_name == "", "and names none: '{ht.ht_name}'");
}

fn test_a_declaration_reads_back_as_its_name_and_its_defaults() {
  w = meadow();
  declare(w, "cottage wid=5 dep=4");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(ht.ht_ok, "the type resolved: {ht.ht_why}");
  assert(ht.ht_name == "cottage", "name '{ht.ht_name}'");
  assert(ht.ht_wid == 5 && ht.ht_dep == 4, "wid {ht.ht_wid} dep {ht.ht_dep}");
}

fn test_a_declaration_missing_its_dimensions_is_refused_not_defaulted() {
  // ⚠ `world_palette_check`'s own argument one axis over: a type that quietly fell
  // back to 5x4 would build the wrong house and say nothing.
  w = meadow();
  declare(w, "cottage");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(!ht.ht_ok, "a type with no wid/dep does not resolve");
  assert(ht.ht_name == "cottage", "and it still says which one: '{ht.ht_name}'");
  assert(ht.ht_why != "", "with a reason: '{ht.ht_why}'");
}

// ── and what the verb does with it ──────────────────────────────────────────

fn test_an_undeclared_world_builds_exactly_the_house_it_always_did() {
  // ⚠ THE ROW THAT MAKES THIS STEP BYTE-IDENTICAL over every existing script, and it
  // is a mechanism rather than care: `ht_ok` false means the constants are used.
  w = meadow();
  ack = placed_by_verb(w);
  assert(ack.ak_ok, "the default house stands: {ack.ak_why}");
  assert(footprint_cells(ack) == 27, "a 5x4 house is 27 cells, got {footprint_cells(ack)}");
}

fn test_a_declared_cottage_reproduces_that_house_exactly() {
  w = meadow();
  declare(w, "cottage wid=5 dep=4");
  ack = placed_by_verb(w);
  assert(ack.ak_ok, "the declared cottage stands: {ack.ak_why}");
  assert(footprint_cells(ack) == 27,
         "a declared 5x4 is the same 27 cells, got {footprint_cells(ack)}");
}

fn test_adding_a_type_touches_no_code() {
  // ⛔ **THE INVARIANT.** Nothing in `lib/` knows the number 7 or the number 5 below;
  // they exist only in this string. If the verb ever stops consulting the table this
  // row goes red while every parse test above stays green — which is exactly the gap
  // between *built* and *called*.
  w = meadow();
  declare(w, "longhouse wid=7 dep=5");
  ack = placed_by_verb(w);
  assert(ack.ak_ok, "the longhouse stands: {ack.ak_why}");
  assert(footprint_cells(ack) != 27,
         "a 7x5 is not the 5x4 house — the verb ignored the declaration");
  // ⚠ **THE EXPECTED COUNT IS THE GESTURE'S OWN, NOT A NUMBER WRITTEN HERE.** The
  // first draft asserted 47 because that is what 7x5 looks like it should be; a hex
  // rasterisation says 37, and a guessed constant would have made this row fail for
  // a reason that has nothing to do with the claim. So the control is `place_house`
  // called with 7 and 5 EXPLICITLY: two paths to one house, and the declaration has
  // to reach the same place the arguments do.
  c = meadow();
  cs = hex_editor::EditSession {};
  ca = hex_editor::author_at(0.0, 0.0 - 4.0, YAW, (FLOOR as float) * U);
  direct = hex_editor::place_house(c, ca, 7, 5, hex_editor::grade_under(c, ca),
                                   cs.es_runs, cs.es_roofs);
  assert(direct.ak_ok, "the control house stands: {direct.ak_why}");
  assert(footprint_cells(ack) == footprint_cells(direct),
         "declared 7x5 is {footprint_cells(ack)} cells, called 7x5 is "
       + "{footprint_cells(direct)}");
}

fn test_a_broken_declaration_refuses_the_gesture_rather_than_building_the_wrong_house() {
  w = meadow();
  declare(w, "cottage wid=0 dep=4");
  ack = placed_by_verb(w);
  assert(!ack.ak_ok, "the gesture refused rather than falling back");
  assert(ack.ak_why != "", "and said why: '{ack.ak_why}'");
}

// ── A TYPE'S OWN VERBS — plan 22 `T1a.2` ───────────────────────────────────
//
// > *"A castle may have a keystroke a cottage has no use for."* … *"a type that
// > contributes verbs means the verb set is not knowable at compile time, so which
// > keys does this editor have becomes a QUERY rather than a constant."*
//
// ⚠ **A TYPE VERB IS AN ALIAS ONTO AN EXISTING GESTURE.** It has to be: the invariant
// is *adding a type touches no code*, and a verb running NEW behaviour is new code by
// definition. What a declaration can contribute is a NAME for something the editor
// already does — the type's own defaults are what make it a portcullis rather than a
// window.

fn a_house(w: VoxelWorld, s: EditSession) -> Author {
  a = hex_editor::author_at(0.0, 0.0 - 4.0, YAW, (FLOOR as float) * U);
  s.es_author = a;
  hex_editor::press_verb(s, w, a, hex_editor::VB_PLACE, "");
  a
}

fn test_an_undeclared_verb_is_refused_and_stays_refused() {
  // ⛔ THE RED THIS FEATURE WAS BUILT AGAINST, kept as a row: a world that declares
  // no type must not acquire a vocabulary from anywhere.
  w = meadow();
  s = hex_editor::EditSession {};
  a = a_house(w, s);
  ack = hex_editor::press_verb(s, w, a, "portcullis", "");
  assert(!ack.ak_ok, "an undeclared verb does nothing");
}

fn test_a_type_verb_performs_its_base_gesture() {
  w = meadow();
  declare(w, "castle wid=5 dep=4 verbs=portcullis:opening");
  s = hex_editor::EditSession {};
  a = a_house(w, s);
  // Stand inside, against the near wall, exactly as the opening tests do.
  at = hex_editor::author_at(0.0, 0.0 - 1.5, 0.0 - YAW, (FLOOR as float) * U);
  s.es_author = at;
  ack = hex_editor::press_verb(s, w, at, "portcullis", "");
  assert(ack.ak_ok, "the castle's own verb cut its opening: {ack.ak_why}");
  assert(len(s.es_open.items) == 1,
         "and it went into the session as an opening: {len(s.es_open.items)}");
}

fn test_a_type_cannot_shadow_a_base_verb() {
  // ⚠ `place` means place in every world. A declaration that could redefine it would
  // change the editor for everyone standing in that region — the palette's *a byte
  // the palette does not name is a fault* argument pointed at silent REDEFINITION
  // rather than silent absence.
  w = meadow();
  declare(w, "rogue wid=5 dep=4 verbs=place:hole");
  base = hex_editor::verb_resolve(w, 0, hex_editor::HTYPE_DEFAULT_SLOT,
                                  hex_editor::VB_PLACE);
  assert(base == hex_editor::VB_PLACE,
         "`place` still means place, got '{base}'");
  // and the alias is not reachable under its own name either
  s = hex_editor::EditSession {};
  a = a_house(w, s);
  assert(!hex_editor::press_verb(s, w, a, "place:hole", "").ak_ok,
         "the declaration's pair does not become a verb of its own");
}

fn test_an_alias_onto_an_unknown_base_is_refused_not_dispatched() {
  w = meadow();
  declare(w, "castle wid=5 dep=4 verbs=portcullis:sorcery");
  s = hex_editor::EditSession {};
  a = a_house(w, s);
  ack = hex_editor::press_verb(s, w, a, "portcullis", "");
  assert(!ack.ak_ok, "an alias onto a gesture the editor does not have is refused");
}

fn test_an_alias_cannot_chain_onto_another_alias() {
  // ⚠ ONE resolution, never a loop with a depth limit — a depth limit is the shape a
  // cycle hides in.
  w = meadow();
  declare(w, "castle wid=5 dep=4 verbs=a:b,b:opening");
  got = hex_editor::verb_resolve(w, 0, hex_editor::HTYPE_DEFAULT_SLOT, "a");
  assert(got == "a", "`a` does not chain through `b`, got '{got}'");
}

// ── THE OPENING A TYPE GIVES AN AUTHOR WHO HAS NOT CHOSEN — plan 22 `T1b` ───
//
// > *"house types that set defaults for windows/doors/floors"* … *"each producing the
// > TYPE's defaults unless overridden"*
//
// ⚠ **ONE OPENING DEFAULT, BECAUSE THIS EDITOR HAS ONE OPENING SELECTION** — *which
// door* and *which window* are the same field, `es_open_kind`, since `S3` collapsed
// six keys onto one verb. ⚠ **And *which floor* is not reachable at all**: the tree's
// materials are structural kinds (`FLOOR_MAT` is *a built floor*, not a finish), so a
// `floor=` field would parse perfectly and change nothing.
//
// ⚠ **THE CLAIM IS MADE THROUGH `press_verb`**, exactly as the size rows above are:
// a parse that reads `opening=2` back is not evidence that any gesture consults it.

// The opening the gesture actually cut, read out of the session the verb wrote to.
fn cut_kind(w: VoxelWorld, s: EditSession, a: Author) -> integer {
  ack = hex_editor::press_verb(s, w, a, hex_editor::VB_OPENING, "");
  assert(ack.ak_ok, "the opening was refused: {ack.ak_why}");
  assert(len(s.es_open.items) > 0, "nothing reached the session");
  o = s.es_open.items[len(s.es_open.items) - 1] ?? hex_editor::opening_none();
  o.op_kind
}

// Stand inside the house that was just placed, against its near wall.
fn at_the_near_wall() -> Author {
  hex_editor::author_at(0.0, 0.0 - 1.5, 0.0 - YAW, (FLOOR as float) * U)
}

fn test_an_undeclared_world_cuts_the_opening_it_always_did() {
  w = meadow();
  s = hex_editor::EditSession {};
  a_house(w, s);
  at = at_the_near_wall();
  s.es_author = at;
  assert(cut_kind(w, s, at) == hex_editor::OP_ROUND,
         "an undeclared world stopped cutting a round-headed opening");
}

fn test_a_type_decides_the_opening_when_the_author_has_chosen_none() {
  // ⛔ **THE ROW.** Nothing in `lib/` names `OP_POINTED` as a default; it exists only
  // in the string below. If the gesture stops consulting the type this goes red while
  // every parse row stays green — the gap between *built* and *called*.
  w = meadow();
  declare(w, "castle wid=5 dep=4 opening=2");
  s = hex_editor::EditSession {};
  a_house(w, s);
  at = at_the_near_wall();
  s.es_author = at;
  assert(cut_kind(w, s, at) == hex_editor::OP_POINTED,
         "the castle's declared opening was not what the verb cut");
}

fn test_the_authors_own_choice_overrides_the_type() {
  // ⚠ *"…unless overridden"*, and this is the row that needs `es_open_set` rather
  // than a comparison against `OP_ROUND`: the author chooses the very kind that is
  // also the default, so a test that read *is it still the default* could not tell
  // the two apart. The type says pointed, the author says round, and round is what
  // must be cut.
  w = meadow();
  declare(w, "castle wid=5 dep=4 opening=2");
  s = hex_editor::EditSession {};
  a_house(w, s);
  assert(hex_editor::session_select_open(s, hex_editor::OP_ROUND).ak_ok, "chose round");
  at = at_the_near_wall();
  s.es_author = at;
  assert(cut_kind(w, s, at) == hex_editor::OP_ROUND,
         "the type overruled an author who had chosen");
}

fn test_a_refused_selection_does_not_count_as_choosing() {
  // ⚠ A TYPO MUST NOT SILENCE A HOUSE TYPE for the rest of the session. `5` is not an
  // opening kind, so the selection is refused — and the author is still un-chosen,
  // which means the castle still decides.
  w = meadow();
  declare(w, "castle wid=5 dep=4 opening=2");
  s = hex_editor::EditSession {};
  a_house(w, s);
  assert(!hex_editor::session_select_open(s, 5).ak_ok, "5 was accepted as a kind");
  at = at_the_near_wall();
  s.es_author = at;
  assert(cut_kind(w, s, at) == hex_editor::OP_POINTED,
         "a refused selection silenced the type's own opening");
}

fn test_an_opening_a_type_declares_must_be_one() {
  // ⚠ NOMINAL — the units are the outline and the tens the depth, so `5` is nothing
  // at all rather than nearly an oculus. A type that fell back to round would cut the
  // wrong hole in a castle and say nothing, which is `world_palette_check`'s argument.
  w = meadow();
  declare(w, "castle wid=5 dep=4 opening=5");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(!ht.ht_ok, "opening 5 was accepted");
  assert(ht.ht_why.contains("5"), "and the reason names it: '{ht.ht_why}'");
  // …and the gesture that needs the size refuses, rather than building a 5x4.
  ack = placed_by_verb(w);
  assert(!ack.ak_ok, "the broken declaration still built a house");
}

fn test_a_type_that_declares_no_opening_leaves_the_choice_alone() {
  // ⚠ THE CONTROL FOR THE WHOLE FAMILY: `wid`/`dep` without `opening=` must not
  // acquire one. `ht_open` is `0 - 1` and the session's own kind stands, which is
  // what keeps every existing world byte-identical.
  w = meadow();
  declare(w, "cottage wid=5 dep=4");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(ht.ht_ok, "the type resolved: {ht.ht_why}");
  assert(ht.ht_open < 0, "it invented an opening default: {ht.ht_open}");
  s = hex_editor::EditSession {};
  a_house(w, s);
  at = at_the_near_wall();
  s.es_author = at;
  assert(cut_kind(w, s, at) == hex_editor::OP_ROUND,
         "a type that declares no opening changed what the verb cuts");
}

// ── HOW A DECLARATION GETS IN — plan 22 `T1c` ───────────────────────────────
//
// ⛔ **IT COULD NOT, THROUGH TWO PLANS.** `hex_voxel::world_set_palette` had **zero
// production callers** when this was written — every one in the tree was a loft test
// — no driver had a `load` command, and the socket had no message for a palette. So
// every row above this line tested a table that nothing outside a test could fill.
//
// ⚠ **ONE PARSER, TWO DRIVERS.** `editor_run` performs a `declare` line and the
// server performs `54:`, and both hand the whole line to `world_declare` — because
// `S2c` had just measured a socket keeping its own body of a library gesture at six
// of eight scripts.

fn test_a_declaration_line_reaches_the_palette() {
  w = meadow();
  ack = hex_editor::world_declare(w, 0, "house 1 castle wid=9 dep=7 opening=2");
  assert(ack.ak_ok, "refused: {ack.ak_why}");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(ht.ht_ok, "the line did not resolve as a type: {ht.ht_why}");
  assert(ht.ht_wid == 9 && ht.ht_dep == 7 && ht.ht_open == hex_editor::OP_POINTED,
         "wid {ht.ht_wid} dep {ht.ht_dep} opening {ht.ht_open}");
}

fn test_the_body_keeps_its_spaces_and_its_commas() {
  // ⚠ **THE REASON THE WIRE CARRIES THE LINE AND NOT FIELDS.** A body has spaces
  // (`wid=5 dep=4`) AND commas (`verbs=a:opening,b:hole`), so any separator would
  // need a split-on-the-first-N rule in every reader — and `tools/script.mjs` would
  // have to know the shape to build one.
  w = meadow();
  assert(hex_editor::world_declare(w, 0,
           "house 1 castle wid=5 dep=4 verbs=portcullis:opening,sally:hole").ak_ok,
         "the comma-bearing body was refused");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(len(ht.ht_verbs) == 2, "{len(ht.ht_verbs)} verbs survived the wire form");
}

fn test_an_axis_that_is_not_one_is_refused_without_an_offer() {
  // Nominal — `houses` is not *nearly* `house`, and a declaration that guessed would
  // write a house type into the MATERIAL palette, which is exactly what `T1a.1`'s red
  // caught before it shipped.
  w = meadow();
  ack = hex_editor::world_declare(w, 0, "houses 1 castle wid=5 dep=4");
  assert(!ack.ak_ok, "'houses' was accepted as an axis");
  assert(!ack.ak_why.contains("offer"), "and got no offer: {ack.ak_why}");
  assert(hex_voxel::world_palette_name(w, hex_voxel::PAL_HTYPE, 0, 1) == "",
         "a house type was written anyway");
  assert(hex_voxel::world_palette_name(w, hex_voxel::PAL_MATERIAL, 0, 1) == "",
         "it landed in the MATERIAL palette — `T1a.1`'s red, one layer up");
}

fn test_a_malformed_line_says_which_half_it_could_not_read() {
  w = meadow();
  assert(!hex_editor::world_declare(w, 0, "").ak_ok, "an empty line was accepted");
  assert(!hex_editor::world_declare(w, 0, "house").ak_ok, "an axis alone was accepted");
  slotless = hex_editor::world_declare(w, 0, "house one castle wid=5 dep=4");
  assert(!slotless.ak_ok, "'one' was accepted as a slot");
  assert(slotless.ak_why.contains("one"), "the reason names it: '{slotless.ak_why}'");
}

fn test_the_palettes_own_refusals_come_through_unchanged() {
  // ⚠ NOT RE-DECIDED HERE. `world_palette_put` already knows that slot 0 is absence
  // and that 255 is the last a byte names; a second opinion is how the two disagree.
  w = meadow();
  assert(!hex_editor::world_declare(w, 0, "house 0 nothing").ak_ok, "slot 0 was written");
  assert(!hex_editor::world_declare(w, 0, "house 256 far").ak_ok, "slot 256 was written");
}

fn test_the_way_out_is_the_same_line() {
  w = meadow();
  assert(hex_editor::world_declare(w, 0, "house 1 castle wid=9 dep=7").ak_ok, "declared");
  assert(hex_editor::world_declare(w, 0, "house 1").ak_ok, "the clearing line was refused");
  ht = hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT);
  assert(!ht.ht_ok, "the type survived being cleared");
  // …and the gesture goes back to the house it always built.
  ack = placed_by_verb(w);
  assert(ack.ak_ok && footprint_cells(ack) == 27,
         "after clearing, the verb built {footprint_cells(ack)} cells rather than 27");
}

fn test_a_declaration_is_scoped_to_the_region_it_was_made_in() {
  // Plan 21 `R2`'s rule, and the reason both drivers pass the AUTHOR's region: a
  // declaration that always wrote region 0 would be global while the palette is not.
  w = meadow();
  assert(hex_editor::world_declare(w, 2, "house 1 castle wid=9 dep=7").ak_ok, "region 2");
  assert(!hex_editor::house_type(w, 0, hex_editor::HTYPE_DEFAULT_SLOT).ht_ok,
         "region 0 acquired region 2's type");
  assert(hex_editor::house_type(w, 2, hex_editor::HTYPE_DEFAULT_SLOT).ht_ok,
         "region 2 did not keep its own");
}

// ── WHICH VERBS DOES THIS EDITOR HAVE, HERE? — plan 22 `T1e` ───────────────
//
// > *"a type that contributes verbs means the verb set is not knowable at compile
// > time, so which keys does this editor have becomes a QUERY rather than a constant."*
//
// ⛔ **THIS QUERY WAS BUILT AND DELETED AT `T1a.2` FOR HAVING NO CONSUMER**, which is
// this tree's commonest defect caught before it shipped. It is back because a
// declaration can name a KEY now, so the verb bar has a glyph to draw and the client's
// poll has a code to watch — two consumers, in `src/editor_client.loft`.

fn keys_of(m: KeyMap, verb: text) -> text { hex_editor::key_for(m, verb) }

fn has_verb(m: KeyMap, verb: text) -> boolean {
  for v in hex_editor::keymap_verbs(m) { if v == verb { return true; } }
  false
}

fn test_an_undeclared_world_has_exactly_the_verbs_it_was_compiled_with() {
  // ⚠ THE CONTROL, AND IT IS WHAT KEEPS EVERY EXISTING EDITOR UNCHANGED: no type means
  // the answer IS the map that went in, row for row.
  w = meadow();
  base = hex_editor::keymap_default();
  got = hex_editor::verbs_here(w, 0, hex_editor::HTYPE_DEFAULT_SLOT, base);
  assert(len(hex_editor::keymap_verbs(got)) == len(hex_editor::keymap_verbs(base)),
         "an undeclared world changed the verb set: {len(hex_editor::keymap_verbs(got))} "
       + "against {len(hex_editor::keymap_verbs(base))}");
}

fn test_a_declared_verb_joins_the_set_with_the_key_it_asked_for() {
  w = meadow();
  declare(w, "castle wid=5 dep=4 verbs=portcullis:opening:F");
  got = hex_editor::verbs_here(w, 0, hex_editor::HTYPE_DEFAULT_SLOT,
                               hex_editor::keymap_default());
  assert(has_verb(got, "portcullis"), "the castle's verb is not in the set");
  assert(keys_of(got, "portcullis") == "F",
         "it did not take the key it asked for: '{keys_of(got, \"portcullis\")}'");
  // …and the code, because a bar draws a glyph and a POLL needs a number.
  assert(hex_editor::code_for(got, "portcullis") == hex_editor::key_code_of("F"),
         "and the code the keyboard sends is not F's");
}

fn test_a_declared_key_replaces_the_verb_that_had_it() {
  // ⚠ `keymap_bind`'s OWN RULE, one axis over: every letter is taken, so a type that
  // could only have an unused key could never have one. What must NOT happen is the
  // displaced verb vanishing — it keeps its row and says it has no key here.
  w = meadow();
  base = hex_editor::keymap_default();
  had = hex_editor::verb_in(base, "F");
  assert(had != "", "the fixture needs a base verb on F; the map has none");
  declare(w, "castle wid=5 dep=4 verbs=portcullis:opening:F");
  got = hex_editor::verbs_here(w, 0, hex_editor::HTYPE_DEFAULT_SLOT, base);
  assert(hex_editor::verb_in(got, "F") == "portcullis",
         "'F' still names '{hex_editor::verb_in(got, \"F\")}' inside the castle");
  assert(has_verb(got, had), "'{had}' fell out of the set entirely when it lost its key");
  assert(keys_of(got, had) == "",
         "'{had}' still claims key '{keys_of(got, had)}' after being displaced");
}

fn test_a_verb_with_no_key_is_still_offered_and_says_it_has_none() {
  // The state `T1c`/`T1d` shipped: reachable by script and by wire, pressable by
  // nobody. A bar that hid it would be hiding a verb the editor really has.
  w = meadow();
  declare(w, "castle wid=5 dep=4 verbs=portcullis:opening");
  got = hex_editor::verbs_here(w, 0, hex_editor::HTYPE_DEFAULT_SLOT,
                               hex_editor::keymap_default());
  assert(has_verb(got, "portcullis"), "a keyless declared verb was dropped from the set");
  assert(keys_of(got, "portcullis") == "", "it invented a key: '{keys_of(got, \"portcullis\")}'");
}

fn test_a_key_no_keyboard_sends_is_refused_rather_than_bound_to_zero() {
  // ⚠ `key_code_of` answers `KEY_NONE` for a name it does not know, and a binding that
  // cannot be pressed is worse than an absent one: the bar would draw a glyph for a key
  // that sends nothing.
  w = meadow();
  declare(w, "castle wid=5 dep=4 verbs=portcullis:opening:Meta");
  got = hex_editor::verbs_here(w, 0, hex_editor::HTYPE_DEFAULT_SLOT,
                               hex_editor::keymap_default());
  assert(!has_verb(got, "portcullis"),
         "a verb bound to a key the hardware has no code for was offered anyway");
}

fn test_the_query_makes_the_same_three_refusals_the_dispatch_does() {
  // ⚠ A BAR THAT OFFERED WHAT `press_verb` REFUSES would be an editor advertising a
  // gesture it will not perform. Same three rules as `verb_resolve`: no shadowing a
  // base verb, no alias onto an unknown base, and no chaining.
  w = meadow();
  declare(w, "rogue wid=5 dep=4 verbs=place:hole:F,portcullis:sorcery:G,a:b:H");
  got = hex_editor::verbs_here(w, 0, hex_editor::HTYPE_DEFAULT_SLOT,
                               hex_editor::keymap_default());
  assert(keys_of(got, "place") != "F", "a declaration shadowed `place` onto F");
  assert(!has_verb(got, "portcullis"), "an alias onto an unknown base was offered");
  assert(!has_verb(got, "a"), "an alias onto another alias was offered");
}
