//
// AN OPENING IS SIZED TO WHAT GOES IN IT — and one field turns it into an alcove.
//
// ⚠ THE OLD RULE WAS BACKWARDS. `place_opening` takes N whole hex edges, so a door
// is 0.87 m or 1.74 m and nothing between: the shape forced to the lattice. A leaf
// is 0.9 m wide because a person walks through it, so the HOLE is cut to fit the
// leaf and the edges it covers are the store's index of which boundary is passable.
//
// Same shape as `S3` one level down — there the edges were the index and the run
// was the truth, here the edges are the index and the opening is — and it is what
// lets a door, a window, a gateway and an ALCOVE be one thing with one number
// different, rather than four systems that cannot combine.
use hex_editor;
use hex_grid;

const BAND = 0.8660254037844386;   // hex_draw::BAND_SIDES — the wall's own thickness

fn test_a_hole_is_the_shape_plus_its_clearance() {
  // Nothing rounds to an edge, a cell or a span: a 0.9 m leaf gets a 0.9 m hole and
  // the reveal either side. A version that quantised would be the old design
  // wearing new parameters.
  o = hex_editor::door_opening(0.0, 0.0, 0.9, 12);
  want = 0.9 * 0.5 + hex_editor::OPENING_CLEAR;
  d = o.op_half - want;
  if d < 0.0 { d = 0.0 - d; }
  assert(d < 0.000001, "half-width is the leaf and its clearance: {o.op_half} vs {want}");
}

fn test_two_different_leaves_get_two_different_holes() {
  // The claim in one line: the shape leads. A cottage door and a barn door cannot
  // be the same hole, and under the old rule they were both "one edge" or "two".
  narrow = hex_editor::door_opening(0.0, 0.0, 0.8, 12);
  wide = hex_editor::door_opening(0.0, 0.0, 1.6, 12);
  assert(wide.op_half > narrow.op_half + 0.35,
         "a wider leaf cuts a wider hole: {narrow.op_half} vs {wide.op_half}");
}

fn test_a_door_goes_through_and_an_alcove_does_not() {
  // ⚠ ONE FIELD, FOUR FITTINGS. Depth is what separates a doorway from a niche, so
  // "put a statue in the wall" needs no new concept — the void already has a floor,
  // a back and a size.
  door = hex_editor::door_opening(0.0, 0.0, 0.9, 12);
  niche = hex_editor::alcove_opening(0.0, 0.0, 0.6, 4, 10, 0.6);
  assert(hex_editor::opening_through(door), "a door goes through");
  assert(!hex_editor::opening_through(niche), "an alcove does not");
  assert(hex_editor::opening_reach(niche, BAND) < BAND,
         "and its back wall stands inside the wall: {hex_editor::opening_reach(niche, BAND)}");
  assert(hex_editor::opening_reach(door, BAND) == BAND, "where a door's does not exist");
}

fn test_an_alcove_has_room_for_what_stands_in_it() {
  // A statue is a prop at the opening's own frame, so the niche has to say how much
  // room it offers — width, height and depth are all readable from the void itself.
  niche = hex_editor::alcove_opening(0.0, 0.0, 0.6, 4, 10, 0.6);
  assert(niche.op_half * 2.0 > 0.6, "wide enough for the shape it was cut for");
  assert(niche.op_hi > niche.op_lo, "and tall enough to stand in: {niche.op_lo}..{niche.op_hi}");
  assert(hex_editor::opening_reach(niche, BAND) > 0.3, "with depth to stand back in");
}

fn test_a_point_inside_the_void_is_reported_with_its_band() {
  // What the renderer asks, per step along the wall, without knowing anything about
  // doors: is this cut, and between which heights.
  o = hex_editor::window_opening(4.0, 0.0, 1.0, 3, 9);
  lo = 0;
  hi = 0;
  assert(hex_editor::opening_cuts(o, 4.0, 0.0, 0.25, lo, hi), "the centre is cut");
  assert(lo == 3 && hi == 9, "between the sill and the head: {lo}..{hi}");
  assert(!hex_editor::opening_cuts(o, 6.0, 0.0, 0.25, lo, hi), "and two metres away is not");
}

fn test_a_shape_too_wide_for_its_wall_is_told_what_fits() {
  // ⚠ REFUSED WITH AN OFFER, like everything else here. A hole cannot reach past
  // its own wall, and the widest that fits is a number the wall can state — so the
  // author is told what they can have instead of getting a hole with one jamb.
  room = hex_editor::opening_room(12.0, 6.0);
  assert(room > 11.0, "in the middle of a twelve-unit wall, nearly all of it fits: {room}");
  edge = hex_editor::opening_room(12.0, 0.5);
  assert(edge < 1.0, "half a unit from the end, almost nothing does: {edge}");
  assert(edge > 0.0, "but it is still an offer rather than a refusal with no answer");
}

fn test_an_arch_narrows_as_it_rises_and_is_tallest_at_the_crown() {
  // ⚠ THE HALF-ROUND, and it is the same curve `hex_roof::vault_arc` sweeps along a
  // track. A corridor is that profile swept far, an arch is it swept through a
  // wall, and an alcove is it stopped short — so the half-round corridor an author
  // draws IS the arch they get, rather than a fourth system that looks like one.
  a = hex_editor::arch_opening(0.0, 0.0, 1.2, 0, 8, 0.25, 1.0);
  assert(hex_editor::opening_arched(a), "it is arched");
  lo = 0;
  crown = 0;
  hex_editor::opening_cuts(a, 0.0, 0.0, 0.25, lo, crown);
  edge = 0;
  hex_editor::opening_cuts(a, a.op_half * 0.95, 0.0, 0.25, lo, edge);
  assert(crown > edge, "tallest at the crown, lowest at the jamb: {crown} vs {edge}");
  assert(edge >= 8, "and it never dips below the springing: {edge}");
  d = crown - (8 + ((a.op_half / 0.25 ?? 0.0) as integer));
  if d < 0 { d = 0 - d; }
  assert(d <= 1, "the crown stands a half-width above the springing, off by {d}");
}

fn test_an_arched_alcove_is_the_same_thing_stopped_short() {
  // Which is the whole argument: an arch and a niche differ in ONE field, so an
  // author who can draw a half-round corridor can already make an arched alcove.
  through = hex_editor::arch_opening(0.0, 0.0, 1.2, 0, 8, 0.25, 1.0);
  niche = hex_editor::arch_opening(0.0, 0.0, 1.2, 0, 8, 0.25, 0.5);
  assert(hex_editor::opening_through(through), "the arch goes through");
  assert(!hex_editor::opening_through(niche), "the alcove does not");
  assert(through.op_hi == niche.op_hi, "and they are the same shape in elevation");
}

// ── the profile family: every shape answers one question ────────────────────

const U = 0.25;

fn prof(kind: integer) -> Opening {
  hex_editor::profile_opening(0.0, 0.0, 1.2, 0, 8, kind, 0.0, U, 1.0)
}

fn head_at(o: Opening, d: float) -> integer {
  lo = 0;
  hi = 0;
  hex_editor::opening_cuts(o, d, 0.0, U, lo, hi);
  hi
}

fn test_a_pointed_arch_stands_taller_than_a_round_one_of_the_same_span() {
  // ⚠ THE DEFINING PROPERTY, and the reason Gothic exists: two arcs struck from the
  // opposite springings cross ABOVE the semicircle, so the same span reaches higher
  // without a wider wall. A profile family that got this wrong would be drawing
  // domes and calling them arches.
  round = prof(hex_editor::OP_ROUND);
  pointed = prof(hex_editor::OP_POINTED);
  assert(pointed.op_hi > round.op_hi,
         "pointed rises above round for one span: {round.op_hi} vs {pointed.op_hi}");
}

fn test_a_segmental_arch_is_shallower_than_a_round_one() {
  // The other direction, and the reason a cellar head is segmental: a larger radius
  // struck from below the springing rises less.
  round = prof(hex_editor::OP_ROUND);
  seg = prof(hex_editor::OP_SEGMENT);
  assert(seg.op_hi < round.op_hi,
         "segmental sits below round: {seg.op_hi} vs {round.op_hi}");
  assert(seg.op_hi > 8, "but it still rises above its springing: {seg.op_hi}");
}

fn test_every_arched_head_closes_at_its_jambs() {
  // The property they all share: at the jamb the head meets the springing, so the
  // opening is a closed shape rather than a slot with a curve floating over it.
  for k in [hex_editor::OP_ROUND, hex_editor::OP_POINTED, hex_editor::OP_SEGMENT] {
    o = prof(k);
    edge = head_at(o, o.op_half * 0.999);
    assert(edge <= 8 + 1, "profile {k} closes at the jamb, got {edge} against 8");
    assert(head_at(o, 0.0) > edge, "and is tallest at the crown");
  }
}

fn test_an_oculus_closes_at_the_bottom_as_well_as_the_top() {
  // ⚠ THE ONE NO "HEAD ON A RECTANGLE" CAN EXPRESS. A round window's sill curves
  // too, so `lo` has to vary with the offset — which is why the profile returns
  // both bounds rather than a height.
  o = hex_editor::oculus_opening(0.0, 0.0, 1.2, 6, U, 1.0);
  clo = 0;
  chi = 0;
  hex_editor::opening_cuts(o, 0.0, 0.0, U, clo, chi);
  elo = 0;
  ehi = 0;
  hex_editor::opening_cuts(o, o.op_half * 0.95, 0.0, U, elo, ehi);
  assert(chi > ehi, "the top curves in: {chi} at the centre, {ehi} at the edge");
  assert(clo < elo, "and so does the bottom: {clo} against {elo}");
  assert(chi - clo > ehi - elo, "so the circle is widest through its middle");
}

fn test_any_profile_can_be_an_alcove() {
  // Which is the point of a family: the shapes and the depth are independent, so a
  // pointed niche and a round doorway are both ordinary.
  niche = hex_editor::profile_opening(0.0, 0.0, 1.2, 0, 8,
                                      hex_editor::OP_POINTED, 0.0, U, 0.5);
  assert(!hex_editor::opening_through(niche), "a pointed alcove is an alcove");
  assert(niche.op_hi > 8, "and still a pointed arch");
}

// ── the frame, which is the same profile one step out ───────────────────────

fn frame_of(kind: integer) -> Opening {
  hex_editor::opening_frame(prof(kind), 0.12, U)
}

fn test_a_frame_surrounds_its_opening_at_the_crown_and_at_the_jamb() {
  // ⚠ THE PROPERTY THAT MAKES IT A RING. The renderer draws frame-minus-opening, so
  // if the frame failed to enclose the hole anywhere the ring would be EMPTY there
  // and the moulding would break — a frame with a gap in it reads as damage.
  for k in [hex_editor::OP_FLAT, hex_editor::OP_ROUND,
            hex_editor::OP_POINTED, hex_editor::OP_SEGMENT] {
    o = prof(k);
    f = frame_of(k);
    assert(f.op_half > o.op_half, "profile {k}: the frame is wider");
    assert(head_at(f, 0.0) > head_at(o, 0.0),
           "profile {k}: and stands above the crown, {head_at(f, 0.0)} over {head_at(o, 0.0)}");
    // ⚠ NOT "TALLER AT THE JAMB" — that was the first version of this line and it
    // failed on the pointed head, correctly. Near a jamb the arc is almost VERTICAL,
    // so an offset outward buys nearly no height; the ring there runs sideways. What
    // must hold everywhere is that the frame still covers ground the opening does
    // not, which just outside the jamb means it is cut where the opening is solid.
    jlo = 0;
    jhi = 0;
    assert(hex_editor::opening_cuts(f, o.op_half + 0.02, 0.0, U, jlo, jhi),
           "profile {k}: the frame reaches past the jamb");
    assert(!hex_editor::opening_cuts(o, o.op_half + 0.02, 0.0, U, jlo, jhi),
           "profile {k}: where the opening does not, so the ring has a side");
    assert(f.op_lo < o.op_lo, "profile {k}: and reaches below the sill");
  }
}

fn test_an_oculus_frame_is_concentric_and_not_a_crescent() {
  // ⚠ THE ONE THAT CAUGHT THE BUG. A circle is struck about its own centre, which
  // `opening_cuts` derives from the springing — so growing only the half-width lifts
  // the frame's centre and the ring comes out thick below and nothing above. Both
  // gaps are measured, and they have to match.
  o = hex_editor::oculus_opening(0.0, 0.0, 1.2, 6, U, 1.0);
  f = hex_editor::opening_frame(o, 0.12, U);
  olo = 0; ohi = 0;
  hex_editor::opening_cuts(o, 0.0, 0.0, U, olo, ohi);
  flo = 0; fhi = 0;
  hex_editor::opening_cuts(f, 0.0, 0.0, U, flo, fhi);
  assert(fhi > ohi, "the frame clears the top: {ohi} -> {fhi}");
  assert(flo < olo, "and the bottom: {olo} -> {flo}");
  above = fhi - ohi;
  below = olo - flo;
  d = above - below;
  if d < 0 { d = 0 - d; }
  assert(d <= 1, "by the same amount top and bottom: {above} above, {below} below");
}

fn test_a_frame_keeps_the_shape_it_frames() {
  // A pointed arch framed by a round one would be a different building. The family
  // survives the offset because the offset is applied to the profile, not to a box.
  assert(frame_of(hex_editor::OP_POINTED).op_kind == hex_editor::OP_POINTED,
         "a pointed head keeps its point");
  rf = frame_of(hex_editor::OP_ROUND);
  sf = frame_of(hex_editor::OP_SEGMENT);
  assert(head_at(frame_of(hex_editor::OP_POINTED), 0.0) > head_at(rf, 0.0),
         "and still stands above a round frame of the same span");
  assert(head_at(sf, 0.0) < head_at(rf, 0.0), "a segmental frame is still shallow");
}

// ── the datum: which surface an opening is cut FROM ─────────────────────────

fn embrasure() -> Opening {
  // A castle wall's window seat: a deep niche, benches in its reveal, and a small
  // window at the BACK of it — which is the one shape "depth from the front face"
  // cannot state, however many profiles it has.
  hex_editor::profile_opening(0.0, 0.0, 2.0, 2, 10, hex_editor::OP_SEGMENT,
                              0.0, U, 0.55)
}

fn test_a_plain_opening_is_cut_from_the_front_face() {
  // The default, and it has to be: every opening written before the datum existed
  // means "from the face I am standing at", so the field's zero must be that.
  d = hex_editor::door_opening(0.0, 0.0, 0.9, 12);
  assert(hex_editor::opening_at_front(d), "a door breaks the near face");
  assert(hex_editor::opening_at_back(d), "and the far one");
  assert(hex_editor::opening_through(d), "so you can walk through it");
}

fn test_a_niche_breaks_the_near_face_only() {
  n = embrasure();
  assert(hex_editor::opening_at_front(n), "a niche breaks the near face");
  assert(!hex_editor::opening_at_back(n), "and leaves the far one standing");
  assert(!hex_editor::opening_through(n), "so it is not a way through");
}

fn test_a_window_in_a_niches_back_breaks_the_far_face_only() {
  // ⚠ THE CLAIM THE DATUM EXISTS FOR. The child starts where the host stops, so it
  // never touches the wall's own front face — and `opening_through` is FALSE for
  // both halves while the pair together is a way for light. A model with one depth
  // field can express neither.
  n = embrasure();
  w = hex_editor::opening_in_back(n, 0.8, 4, 8, hex_editor::OP_ROUND, U);
  assert(!hex_editor::opening_at_front(w), "the window does not break the near face");
  assert(hex_editor::opening_at_back(w), "it breaks the far one");
  assert(w.op_near == n.op_depth, "and it starts exactly where the niche stops: "
                                  + "{w.op_near} against {n.op_depth}");
}

fn test_the_two_voids_meet_with_no_stone_between_them_and_no_overlap() {
  // ⚠ THE ARITHMETIC THAT MAKES IT ONE HOLE. A gap would leave a pane of stone in
  // the middle of the embrasure; an overlap would have two surfaces claiming the
  // same slab. They must ABUT — the niche's far end is the window's near end.
  n = embrasure();
  w = hex_editor::opening_in_back(n, 0.8, 4, 8, hex_editor::OP_ROUND, U);
  hn = 0.0; hf = 0.0;
  hex_editor::opening_span(n, BAND, hn, hf);
  cn = 0.0; cf = 0.0;
  hex_editor::opening_span(w, BAND, cn, cf);
  d = cn - hf;
  if d < 0.0 { d = 0.0 - d; }
  assert(d < 0.000001, "the niche ends at {hf} and the window starts at {cn}");
  assert(hn == 0.0, "the niche starts at the wall's face");
  assert(cf == BAND, "and the window comes out the far side");
}

fn test_a_window_too_wide_for_its_niche_is_refused_with_the_width_that_fits() {
  // ⚠ THE ONE THING COMPOSITION CAN GET WRONG THAT A LONE OPENING CANNOT. A window
  // wider than its host cuts through the niche's own jamb and out into the wall
  // beside it — a hole with a reveal on one side only, which reads as damage.
  n = embrasure();
  wide = hex_editor::opening_in_back(n, 4.0, 4, 8, hex_editor::OP_ROUND, U);
  ack = hex_editor::opening_fits_in(n, wide);
  assert(!ack.ak_ok, "a window wider than its niche is refused");
  assert(ack.ak_why.contains("offer"), "with the width that fits: {ack.ak_why}");
  assert(ack.ak_why.contains("residual"), "and how far off: {ack.ak_why}");
  ok = hex_editor::opening_in_back(n, 0.8, 4, 8, hex_editor::OP_ROUND, U);
  assert(hex_editor::opening_fits_in(n, ok).ak_ok, "and one that fits is allowed");
}

fn test_a_window_reaching_past_the_niches_head_is_refused_too() {
  n = embrasure();
  tall = hex_editor::opening_in_back(n, 0.8, 4, 30, hex_editor::OP_ROUND, U);
  ack = hex_editor::opening_fits_in(n, tall);
  assert(!ack.ak_ok, "a window above the niche's head is refused");
  assert(ack.ak_why.contains("offer"), "with the head that fits: {ack.ak_why}");
}

fn test_the_datum_survives_being_framed() {
  // A frame is the opening offset outward; offsetting must not move it through the
  // wall, or the moulding would surface on the wrong face.
  n = embrasure();
  w = hex_editor::opening_in_back(n, 0.8, 4, 8, hex_editor::OP_ROUND, U);
  f = hex_editor::opening_frame(w, 0.12, U);
  assert(f.op_near == w.op_near, "the frame keeps the datum: {f.op_near}");
  assert(!hex_editor::opening_at_front(f), "so it stays off the near face");
}
