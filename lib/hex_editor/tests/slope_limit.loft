// A SURFACE MAY ONLY BE GIVEN THE SLOPE IT CAN TAKE — plan 20 `A2`.
//
// *Roads and fields can slope with a limit, grass has a higher limit, forest even
// more* — and *the current routine is the start for an unlimited grass type
// terrain*. So the falloff is not replaced by a table: it becomes the **grass row**
// of one, and every number below was measured (`probe/house/slope.loft`) before it
// was asserted.
use hex_editor;
use hex_world;

const U = 0.25;
const G = 40;

fn strip(mat: integer, item: integer) -> World {
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 24)..25 {
    for r in (0 - 24)..25 { ground_set(w, q, r, G, SURFACE_MAT); }
  }
  for q2 in (0 - 24)..25 {
    ground_set(w, q2, 0, G, mat);
    if item != 0 {
      c = world_ground_cell(w, q2, 0);
      ground_write(w, q2, 0, hex_world::Hex {
        h_height: c.h_height, h_material: c.h_material,
        h_item: item as u8? ?? 0, h_item_rotation: c.h_item_rotation,
        h_wall_n: c.h_wall_n, h_wall_ne: c.h_wall_ne, h_wall_se: c.h_wall_se });
    }
  }
  w
}

// The steepest step along the strip, outward from the centre.
fn steepest(w: World, rad: integer) -> integer {
  worst = 0;
  prev = ground_h(w, 0, 0);
  for q in 1..(rad + 1) {
    h = ground_h(w, q, 0);
    st = prev - h;
    if st < 0 { st = 0 - st; }
    if st > worst { worst = st; }
    prev = h;
  }
  worst
}

fn profile(w: World, rad: integer) -> text {
  out = "";
  for q in 0..(rad + 1) { out += "{ground_h(w, q, 0) - G} "; }
  out
}

// ── the table ───────────────────────────────────────────────────────────────

fn test_a_road_climbs_at_one_unit_a_hex() {
  w = strip(ROAD_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(steepest(w, 7) <= ground_kind_of(ROAD_MAT).tr_slope,
         "the road's steepest step is {steepest(w, 7)}, over its limit of {ground_kind_of(ROAD_MAT).tr_slope}: "
       + "{profile(w, 7)}");
  // ⚠ AND IT SAYS WHAT IT COULD NOT DO. A limit that silently delivers less than was
  // asked is the `K-FIT` failure this tree has a rule for.
  assert(cl > 0 && rs > 0,
         "the road was clamped to {steepest(w, 7)} and reported clamped={cl} residual={rs}");
}

fn test_a_field_may_tilt_twice_as_far_as_a_road() {
  w = strip(FIELD_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(steepest(w, 7) <= ground_kind_of(FIELD_MAT).tr_slope,
         "the field's steepest step is {steepest(w, 7)}: {profile(w, 7)}");
  assert(ground_kind_of(FIELD_MAT).tr_slope > ground_kind_of(ROAD_MAT).tr_slope,
         "a field must be allowed more than a road");
  // ⚠ THE ORDERING IS THE CLAIM, not the constants. A field takes the same stroke
  // further up than a road does — if both merely "passed their own limit" the table
  // could be all ones and every test here would still be green.
  wr = strip(ROAD_MAT, 0);
  cl2 = 0;
  rs2 = 0;
  brush(wr, 0, 0, 12, 7, cl2, rs2);
  assert(ground_h(w, 0, 0) > ground_h(wr, 0, 0),
         "the field reached {ground_h(w, 0, 0) - G} and the road {ground_h(wr, 0, 0) - G} "
       + "— a field must get further up the same hill");
}

fn test_grass_is_the_unlimited_row_and_is_untouched() {
  // ⚠ `A3`'s CLAIM, ASSERTED HERE ALREADY: the plain raise over grass must be what
  // it always was. If the table ever grows a grass limit this test is the one that
  // has to be changed on purpose.
  w = strip(SURFACE_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(cl == 0 && rs == 0,
         "grass was clamped: clamped={cl} residual={rs} — {profile(w, 7)}");
  assert(steepest(w, 7) == 3,
         "the grass profile changed shape: steepest {steepest(w, 7)}, {profile(w, 7)}");
  assert(slope_limit(w, 3, 3) == SLOPE_FREE, "open grass carries a limit");
}

fn test_anything_planted_loosens_the_limit() {
  // *forest even more* — and the species palette stays in the server, so the library
  // asks only whether something is planted here.
  w = strip(ROAD_MAT, 1);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(cl == 0 && rs == 0,
         "a planted cell was still held to the road's limit: clamped={cl} residual={rs}");
  assert(slope_limit(w, 3, 0) == SLOPE_FREE, "a planted road still carries a limit");
}

// ── the negative control, which is what makes the rest mean anything ────────

fn test_a_stroke_that_already_fits_is_left_exactly_alone() {
  // ⚠ A LIMIT THAT ALTERS A LEGAL EDIT IS A BUG, NOT A LIMIT. A gentle stroke is
  // within every row of the table, so a road and open grass must come out
  // IDENTICAL — and neither may report a residual.
  wg = strip(SURFACE_MAT, 0);
  wr = strip(ROAD_MAT, 0);
  cg = 0;
  rg = 0;
  cr = 0;
  rr = 0;
  brush(wg, 0, 0, 3, 12, cg, rg);
  brush(wr, 0, 0, 3, 12, cr, rr);
  assert(cr == 0 && rr == 0,
         "a stroke a road can take still reported clamped={cr} residual={rr}");
  for q in 0..13 {
    assert(ground_h(wg, q, 0) == ground_h(wr, q, 0),
           "at {q} the road is {ground_h(wr, q, 0)} and the grass {ground_h(wg, q, 0)} — "
         + "a limit that binds on a legal stroke");
  }
}

fn test_the_relaxation_never_pushes_past_where_it_started() {
  // A raise may be reduced to nothing; it may never become a cut. The road here is
  // asked for far more than it can take, so every cell is clamped hard.
  w = strip(ROAD_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 40, 5, cl, rs);
  for q in 0..6 {
    assert(ground_h(w, q, 0) >= G,
           "the road at {q} ended at {ground_h(w, q, 0)}, BELOW where it started ({G})");
  }
}

fn test_lowering_is_limited_the_same_way() {
  // The gesture is signed and `LEVEL` uses the negative half constantly; a limit
  // enforced only on the way up would let a road be cut to a cliff downhill.
  w = strip(ROAD_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 0 - 12, 7, cl, rs);
  assert(steepest(w, 7) <= ground_kind_of(ROAD_MAT).tr_slope,
         "lowering left the road at {steepest(w, 7)} a hex: {profile(w, 7)}");
  for q in 0..8 {
    assert(ground_h(w, q, 0) <= G,
           "a lowering raised the road at {q} to {ground_h(w, q, 0)}");
  }
}

// ── the identity comes from the WORLD — plan 21 `R1` ────────────────────────

fn test_a_world_palette_decides_which_byte_is_a_road() {
  // ⚠ THE WHOLE OF PLAN 21, AS ONE ASSERTION. Byte 2 is a road only because this
  // file says so; a world that calls byte 5 `road` must get a road's limit on 5 and
  // none on 2. If this passes with the palette ignored, nothing has been decoupled.
  w = strip(SURFACE_MAT, 0);
  for q in (0 - 24)..25 { ground_set(w, q, 0, G, 5); }
  assert(hex_world::world_set_palette(w, hex_world::PAL_MATERIAL, 0,
           [hex_world::PalEntry { pl_slot: 5, pl_name: "road" },
            hex_world::PalEntry { pl_slot: 1, pl_name: "grass" }]) == hex_world::PAL_OK,
         "the palette was refused");
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(steepest(w, 7) <= ground_kind_of(ROAD_MAT).tr_slope,
         "byte 5 was named 'road' and still took {steepest(w, 7)} a hex: {profile(w, 7)}");
  assert(cl > 0, "a road by another number was not clamped at all");
}

fn test_the_same_byte_is_ordinary_ground_when_the_world_says_so() {
  // ⚠ THE CONTROL, and it is the half that proves the constant stopped deciding.
  // Byte 2 is `ROAD_MAT` in this file; a world that calls it `grass` must get
  // grass's freedom, or the palette is being read and then ignored.
  w = strip(ROAD_MAT, 0);
  assert(hex_world::world_set_palette(w, hex_world::PAL_MATERIAL, 0,
           [hex_world::PalEntry { pl_slot: 2, pl_name: "grass" },
            hex_world::PalEntry { pl_slot: 1, pl_name: "grass" }]) == hex_world::PAL_OK,
         "the palette was refused");
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(cl == 0 && rs == 0,
         "byte 2 was named 'grass' and was still held to a road's limit "
       + "(clamped {cl}, residual {rs})");
}

fn test_a_world_with_no_palette_keeps_the_built_in_numbering() {
  // Every world written before palettes existed is one of these, and the fallback
  // is what lets the change arrive without a migration.
  w = strip(ROAD_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 12, 7, cl, rs);
  assert(steepest(w, 7) <= ground_kind_of(ROAD_MAT).tr_slope,
         "a palette-free world stopped treating byte 2 as a road");
}

fn test_a_gesture_reads_the_identity_of_the_region_it_is_standing_in() {
  // ⚠ PLAN 21 `R2` REACHING A GESTURE. The same byte 3 is a road in one chunk and
  // ordinary ground in the next, and the slope limit follows the REGION rather than
  // the byte — which is the whole claim, one gesture down.
  w = strip(SURFACE_MAT, 0);
  for q in (0 - 24)..25 { ground_set(w, q, 0, G, 3); }
  assert(hex_world::world_set_region(w, 0, 0, 1) == hex_world::PAL_OK, "assign");
  assert(hex_world::world_set_palette(w, hex_world::PAL_MATERIAL, 1,
           [hex_world::PalEntry { pl_slot: 3, pl_name: "road" },
            hex_world::PalEntry { pl_slot: 1, pl_name: "grass" }]) == hex_world::PAL_OK,
         "region 1's palette was refused");
  cl = 0;
  rs = 0;
  brush(w, 4, 4, 12, 7, cl, rs);
  assert(cl > 0, "byte 3 is a road in region 1 and was not clamped at all");

  road_steep = steepest(w, 7);

  // ⚠ AND THE CONTROL IS THE SAME BYTE IN AN UNASSIGNED CHUNK. Region 0 names
  // nothing here, so byte 3 falls back to the BUILT-IN numbering, where 3 is a
  // field — a different limit, from a different authority. If both come out the
  // same the region is being ignored and the first half proves nothing.
  //
  // ⚠ A REGION WITH NO PALETTE FALLING BACK IS `R1`'s RULE APPLIED PER REGION, and
  // it is what lets a world name one biome without having to name them all. The
  // first version of this test asserted *no clamp at all* and was wrong about the
  // code rather than the other way round.
  w2 = strip(SURFACE_MAT, 0);
  for q2 in (0 - 24)..25 { ground_set(w2, q2, 0, G, 3); }
  assert(hex_world::world_set_palette(w2, hex_world::PAL_MATERIAL, 1,
           [hex_world::PalEntry { pl_slot: 3, pl_name: "road" }]) == hex_world::PAL_OK,
         "palette");
  cl2 = 0;
  rs2 = 0;
  brush(w2, 4, 4, 12, 7, cl2, rs2);
  assert(steepest(w2, 7) == ground_kind_of(FIELD_MAT).tr_slope,
         "the unassigned chunk took {steepest(w2, 7)} a hex, not the built-in field's "
       + "{ground_kind_of(FIELD_MAT).tr_slope}");
  assert(road_steep < steepest(w2, 7),
         "byte 3 gave {road_steep} named as a road and {steepest(w2, 7)} unnamed — "
       + "the region is not deciding");
}

// ── `A7` — the limit is the WORLD's, not one gesture's ──────────────────────

fn test_a_road_walked_up_a_hill_lands_inside_its_limit_by_itself() {
  rl_c = 0;
  rl_r = 0;
  // ⚠ THE ONE MEASURED DEFECT IN THE ORDER MODEL. `brush` enforced the limits and
  // nothing else did, so a road WALKED up a hill came out at a steepest step of 3
  // where its limit is 1 — the invariant was a property of one gesture, and any
  // other way of writing a road simply did not have it.
  //
  // ⚠ AND THIS TEST USED TO CALL `slope_settle` ITSELF, which is what let `A7` ship
  // with no consumer: it proved the RULE worked and said nothing about whether any
  // gesture used it. `road_lay` settles its own run now, so the fixture below lays
  // a road and asks the world — no repair call anywhere in it. The old shape
  // failed the moment the gesture was wired, on its own fixture guard: *"the
  // fixture did not violate anything — nothing is being tested"*, which is exactly
  // what a test that repairs its own subject should say once the subject repairs
  // itself.
  w = strip(SURFACE_MAT, 0);
  cl0 = 0;
  rs0 = 0;
  brush(w, 0, 0, 24, 12, cl0, rs0);          // a hill first, on unlimited grass
  // ⚠ THE GRADES ARE FROZEN BEFORE ANY ROAD IS LAID. Reading the ground as the walk
  // proceeds reads the road just laid, drags the starting grade to the crest and
  // flattens the hill — a green answer to a question never asked.
  hs: vector<integer> = [];
  for s0 in 0..13 { hs += [ground_h(w, s0, 0)]; }
  hilly = 0;
  for hq in 0..12 {
    st = (hs[hq + 1] ?? G) - (hs[hq] ?? G);
    if st < 0 { st = 0 - st; }
    if st > hilly { hilly = st; }
  }
  assert(hilly > ground_kind_of(ROAD_MAT).tr_slope,
         "the HILL is only {hilly} a hex, so a road along it breaks nothing and "
         + "this fixture tests nothing");

  for q in 0..13 {
    x = 12 - q;
    h = hs[x] ?? G;
    road_lay(w, x, 0, h, 1, (h as float) * U, rl_c, rl_r);
  }
  assert(steepest(w, 12) <= ground_kind_of(ROAD_MAT).tr_slope,
         "the gesture handed back a road at {steepest(w, 12)} a hex: {profile(w, 12)}");
  assert(slope_owed(w, 0, 0) == 0,
         "and it owes {slope_owed(w, 0, 0)} — the run did not settle");
}

// ⚠ AND THE GUARD IS A CLAIM, NOT AN OPTIMISATION. `road_lay` asks a constant-cost
// question before it asks the linear one, and the answer has to be NO for the road
// the editor actually lays: `road_h` is frozen once when road mode is switched on,
// so every stroke uses the same grade and the strip is flat however far it runs.
// Measured (`probe/house/roadcost.loft`): an 80-cell flat road costs `w_tau` 414
// with the settle wired and 414 without — not one write — while an unguarded call
// walked the whole run on every stroke for a 1.7x wall clock.
fn test_a_flat_road_is_never_settled_because_it_never_breaks() {
  rl_c = 0;
  rl_r = 0;
  w = strip(SURFACE_MAT, 0);
  cl0 = 0;
  rs0 = 0;
  brush(w, 0, 0, 24, 12, cl0, rs0);          // a hill, so the ground is not flat
  grade = ground_h(w, 0, 0);                 // frozen ONCE, as the server does it
  before = w.w_tau;
  for q in 0..13 { road_lay(w, q, 0, grade, 1, (grade as float) * U, rl_c, rl_r); }
  laid = w.w_tau - before;

  // The same strokes again change nothing, so a settle firing would show up as
  // writes with no cause.
  mid = w.w_tau;
  for q2 in 0..13 { road_lay(w, q2, 0, grade, 1, (grade as float) * U, rl_c, rl_r); }
  assert(w.w_tau == mid,
         "re-laying the identical flat road wrote {w.w_tau - mid} times — the "
         + "settle is firing on a run that breaks nothing");
  assert(laid > 0, "the fixture laid no road at all");
  assert(steepest(w, 12) == 0, "a road at ONE frozen grade is flat, got {steepest(w, 12)}");
}

fn test_a_settled_road_conserves_its_spoil() {
  rl_c = 0;
  rl_r = 0;
  // ⚠ THIS ROW USED TO ASSERT THE OPPOSITE — *settling only ever cuts and never
  // fills* — and plan 20 `A8` is the step that reverses it on purpose. Cut-only is
  // what a cutting is and is half the answer: *"the builders had a lot of materials
  // over after cutting into the hill, using it to heighten the lower side a bit"*.
  //
  // ⚠ AND THE OLD ROW HAD ALREADY GONE VACUOUS BEFORE IT WAS REPLACED. `road_lay`
  // settles its own run since `A7` was wired, so by the time the test called
  // `slope_settle` itself the road was already settled — it was asserting that a
  // second settle of a settled road raises nothing, which is true of doing nothing.
  w = strip(SURFACE_MAT, 0);
  cl0 = 0;
  rs0 = 0;
  brush(w, 0, 0, 24, 12, cl0, rs0);
  ground: vector<integer> = [];
  for s0 in 0..13 { ground += [ground_h(w, s0, 0)]; }
  for q in 0..13 {
    x = 12 - q;
    h = ground[x] ?? G;
    road_lay(w, x, 0, h, 1, (h as float) * U, rl_c, rl_r);
  }
  cut = 0;
  fill = 0;
  for q2 in 0..13 {
    d = (ground[q2] ?? 0) - ground_h(w, q2, 0);
    if d > 0 { cut = cut + d; }
    if d < 0 { fill = fill - d; }
  }
  assert(cut > 0 && fill > 0,
         "a road across a hill must both cut and fill, got cut {cut} fill {fill}");
  // The stated tolerance: a height is an integer and a mean is not, so the balance
  // is exact only up to one unit a cell.
  gap = cut - fill;
  if gap < 0 { gap = 0 - gap; }
  assert(gap <= 13,
         "cut {cut} against fill {fill} — out of balance by {gap} over 13 cells");
}

// ⚠ THE NEGATIVE CONTROL THE PLAN NAMES, and it is the half that makes the row
// above mean anything: *a road on flat ground must cut nothing and fill nothing — a
// balance that moves earth where none was needed is not a balance.*
fn test_a_road_on_flat_ground_moves_no_earth_at_all() {
  rl_c = 0;
  rl_r = 0;
  w = strip(SURFACE_MAT, 0);
  ground: vector<integer> = [];
  for s0 in 0..13 { ground += [ground_h(w, s0, 0)]; }
  for q in 0..13 { road_lay(w, q, 0, ground[q] ?? G, 1, ((ground[q] ?? G) as float) * U, rl_c, rl_r); }
  for q2 in 0..13 {
    assert(ground_h(w, q2, 0) == (ground[q2] ?? 0),
           "flat ground moved at ({q2},0): {ground[q2]} -> {ground_h(w, q2, 0)}");
  }
  // ⚠ AND AGAIN WITH THE GUARD OUT OF THE WAY, because the row above passes for a
  // reason that is not the one being claimed: on flat ground `road_lay`'s guard says
  // *nothing broke* and no settle runs at all, so `spoil_place`'s own control is
  // never reached. Measured — a mutation that forced the shift to 1 was caught only
  // by the BALANCE row, and this one stayed green. Calling the settle directly is
  // what asks the question the row's name asks.
  cl = 0;
  rs = 0;
  slope_settle(w, 0, 0, cl, rs);
  for q3 in 0..13 {
    assert(ground_h(w, q3, 0) == (ground[q3] ?? 0),
           "a settle on FLAT ground moved ({q3},0): {ground[q3]} -> {ground_h(w, q3, 0)}");
  }
  assert(cl == 0 && rs == 0,
         "and it reported clamped {cl} residual {rs} for moving nothing");
}

fn test_settling_a_surface_with_no_limit_does_nothing() {
  // ⚠ THE CONTROL. A settle that moved open grass would be a terrain edit nobody
  // asked for, fired by a gesture that only meant to lay a path.
  w = strip(SURFACE_MAT, 0);
  cl0 = 0;
  rs0 = 0;
  brush(w, 0, 0, 24, 12, cl0, rs0);
  was: vector<integer> = [];
  for s in 0..13 { was += [ground_h(w, s, 0)]; }
  cl = 0;
  rs = 0;
  slope_settle(w, 0, 0, cl, rs);
  assert(cl == 0 && rs == 0, "grass was settled: clamped {cl}, residual {rs}");
  for q in 0..13 {
    assert(ground_h(w, q, 0) == (was[q] ?? 0), "grass moved at ({q},0)");
  }
}

fn test_both_orders_now_agree_about_the_limit() {
  rl_c = 0;
  rl_r = 0;
  // ⚠ THE CONVERGENCE PLAN 20 NAMED: *the same steepest step both orders*. They do
  // not produce the same HEIGHTS — a road cut into a hill and a road that shaped
  // the hill are different places — but they now agree about the one thing that
  // was a fault rather than a choice.
  a = strip(SURFACE_MAT, 0);        // hill first, then the road, then settle
  c1 = 0;
  r1 = 0;
  brush(a, 0, 0, 24, 12, c1, r1);
  hs: vector<integer> = [];
  for s0 in 0..13 { hs += [ground_h(a, s0, 0)]; }
  for q in 0..13 {
    x = 12 - q;
    h = hs[x] ?? G;
    road_lay(a, x, 0, h, 1, (h as float) * U, rl_c, rl_r);
  }
  c2 = 0;
  r2 = 0;
  slope_settle(a, 0, 0, c2, r2);

  b = strip(ROAD_MAT, 0);           // the road first, then the hill
  c3 = 0;
  r3 = 0;
  brush(b, 0, 0, 24, 12, c3, r3);

  assert(steepest(a, 12) == steepest(b, 12),
         "hill-first settles to {steepest(a, 12)} a hex and build-first to "
       + "{steepest(b, 12)} — the orders still disagree about the limit");
}

// ── THE GUARD ITSELF — plan 20 `A7`'s wiring ────────────────────────────────
//
// ⚠ `w_tau` CANNOT SEE A WALK, ONLY A WRITE, so the cost claim above is only half
// testable through it: a settle that fires on an already-flat road writes nothing
// and the clock does not move. What decides whether the walk happens at all is
// `stroke_over_limit`, so that is what these ask — directly, on the four shapes it
// has to separate.

fn road_at(w: World, q0: integer, n: integer, h0: integer, step: integer) {
  for i in 0..n {
    for r in (0 - 1)..2 { ground_set(w, q0 + i, r, h0 + i * step, ROAD_MAT); }
  }
}

fn test_the_guard_is_quiet_on_the_road_the_editor_lays() {
  // One frozen grade, which is what `road_h` is: flat however far it runs.
  w = strip(SURFACE_MAT, 0);
  road_at(w, 0, 13, G, 0);
  assert(!stroke_over_limit(w, 6, 0, 2),
         "the guard fired on a flat road, so every stroke would walk the whole run");
}

fn test_the_guard_fires_whichever_way_the_road_runs() {
  // ⚠ BOTH DIRECTIONS, AND THIS IS THE ROW THAT CAUGHT THE REAL BUG. The first
  // guard asked only *is this cell too high above its neighbour*, which is true
  // climbing and false descending — because descending, the high cell is the OLDER
  // one and sits outside the disc just stamped. Measured, a road walked downhill
  // slipped past it entirely and came back at its raw 3-per-hex.
  up = strip(SURFACE_MAT, 0);
  road_at(up, 0, 13, G, 3);
  assert(stroke_over_limit(up, 6, 0, 2),
         "a road climbing at 3 a hex did not trip its own limit of "
         + "{ground_kind_of(ROAD_MAT).tr_slope}");
  down = strip(SURFACE_MAT, 0);
  road_at(down, 0, 13, G + 40, 0 - 3);
  assert(stroke_over_limit(down, 6, 0, 2),
         "a road falling at 3 a hex did not trip its own limit — the guard is "
         + "one-sided, and downhill is the side it cannot see");
}

// ⚠ AND IT MUST IGNORE THE SEAM TO THE GROUND BESIDE IT, which is the difference
// between a guard and a tripwire. A road cut into a hill has a big step to the
// grass alongside ON PURPOSE — `T4`'s deliberate seam, and what `A5` draws as rock.
// Counting that would ask for a full run settle on every footfall of every road.
fn test_the_guard_ignores_the_seam_to_unlimited_ground() {
  w = strip(SURFACE_MAT, 0);
  road_at(w, 0, 13, G, 0);
  // a cliff of grass alongside, far steeper than a road may ever be
  for q in 0..13 {
    for r in 2..5 { ground_set(w, q, r, G + 40, SURFACE_MAT); }
  }
  assert(ground_h(w, 6, 2) - ground_h(w, 6, 1) > ground_kind_of(ROAD_MAT).tr_slope * 10,
         "the fixture has no seam in it, so it controls nothing");
  assert(!stroke_over_limit(w, 6, 0, 2),
         "the guard counted the seam to the grass beside the road");
}

// ⚠ THE INCREMENTAL WALK IS THE ONLY SHAPE THAT CAN SEE THE ONE-SIDED GUARD, and
// the direct guard rows above cannot: they lay the whole road first, so the disc
// they ask about contains the high cell AND the low one and a one-sided test trips
// on it either way. The bug lives in the walk — stamping ONE disc at a time, where
// on a descending road the higher cell is the previous stroke's and sits OUTSIDE
// the disc just laid. Measured with the guard one-sided, a road walked downhill
// came back at its raw 3 a hex with `w_tau` unchanged at the unwired numbers.
fn test_a_road_walked_down_a_ramp_also_lands_inside_its_limit() {
  rl_c = 0;
  rl_r = 0;
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 4)..30 {
    for r in (0 - 6)..7 { ground_set(w, q, r, G + 200 - q * 3, SURFACE_MAT); }
  }
  hs: vector<integer> = [];
  for s in 0..24 { hs += [ground_h(w, s, 0)]; }
  for i in 0..24 {
    h = hs[i] ?? G;
    road_lay(w, i, 0, h, 2, (h as float) * U, rl_c, rl_r);
  }
  worst = 0;
  for q2 in 0..23 {
    st = ground_h(w, q2 + 1, 0) - ground_h(w, q2, 0);
    if st < 0 { st = 0 - st; }
    if st > worst { worst = st; }
  }
  assert(worst <= ground_kind_of(ROAD_MAT).tr_slope,
         "a road walked downhill came back at {worst} a hex — the guard cannot see "
       + "the direction where the high cell is the PREVIOUS stroke's");
  assert(slope_owed(w, 0, 0) == 0, "and it owes {slope_owed(w, 0, 0)}");
}

// ── A ROAD CANNOT BE CUT THROUGH THE ROOM UNDER IT — plan 20 ────────────────
//
// ⚠ `road_lay` THREW `surface_set`'s VERDICT AWAY, and while the grade was frozen
// from the author's feet that could never bite: the road was never asked for a
// height far below them. A grade that follows the landscape asks for exactly that,
// and a write landing within `ε` of a layer beneath is refused — `CW_FOLD`, code 1,
// with nothing said. Measured (`probe/house/roadlayer.loft`) against a cellar floor
// at 28: a grade 4 below the ground is written; 8, 10, 11 and 12 below are all
// refused, and the column comes back byte for byte unchanged.
//
// ⚠ AND THE ANSWER IS AN OFFER, NOT A REFUSAL. `ε` is the model's own minimum layer
// separation, so the lowest a road can sit here is the room's floor plus one of
// them. The road is laid there and the author is told by how much it came up.

fn cellared(depth: integer) -> World {
  w = strip(SURFACE_MAT, 0);
  why = "";
  storey_add(w, 0, 0, 0 - 1, 3, why);
  w
}

fn test_a_road_is_lifted_clear_of_a_room_rather_than_refused() {
  w = cellared(1);
  col = world_column(w, 0, 0);
  assert(len(col.co_cells) >= 2, "the fixture dug no cellar: {len(col.co_cells)} layers");
  floor = (col.co_cells[0] ?? hex_world::Hex {}).h_height as integer ?? 0;
  // A grade far below the ground — deep enough that it would fold into the room.
  want = floor + 1;
  cl = 0;
  rs = 0;
  road_lay(w, 0, 0, want, 1, (G as float) * U, cl, rs);
  got = ground_h(w, 0, 0);
  assert((world_ground_cell(w, 0, 0).h_material as integer ?? 0) == ROAD_MAT,
         "the road was not laid at all — the write was refused and swallowed");
  assert(got >= floor + w.w_eps,
         "the road sits at {got}, less than one eps ({w.w_eps}) above a room floor "
         + "at {floor}");
  assert(cl > 0 && rs > 0,
         "it was lifted silently — clamped {cl}, residual {rs}");
  // ⚠ AND THE OFFER IS THE LOWEST LEGAL ONE, not merely a legal one. A road shoved
  // to the surface would pass every row above and would not be a cutting at all.
  assert(got == floor + w.w_eps,
         "the road was lifted to {got} where {floor + w.w_eps} clears the room");
}

// ⚠ THE NEGATIVE CONTROL: nothing dug, nothing lifted. Without it a `road_lay` that
// lifted every road everywhere would pass the row above.
fn test_a_road_over_open_ground_is_never_lifted() {
  w = strip(SURFACE_MAT, 0);
  cl = 0;
  rs = 0;
  road_lay(w, 0, 0, G - 20, 1, (G as float) * U, cl, rs);
  assert(ground_h(w, 0, 0) == G - 20,
         "a road cut 20 into open ground ended at {ground_h(w, 0, 0)}, not {G - 20}");
  assert(cl == 0 && rs == 0,
         "open ground reported a lift: clamped {cl}, residual {rs}");
}

// ── LEVELLING SETS ITS DISC; A RAISE BLENDS INTO ONE — plan 20 ──────────────
//
// ⚠ A FALLOFF IS A HILL'S SHAPE AND IT IS WRONG FOR A PAD. `(1 - t²)²` is smooth
// at both ends, which is what a hill wants and what a pad cannot have: a pad has an
// EDGE. Measured (`probe/house/levelpad.loft`) before this existed, levelling a
// disc by walking it closed only the cells the walker stepped on — `2 4 4 4 4 4 2`
// along the path and `2 4 4 4 2` across it — so the 19 cells a deck covers were
// never flat and no number of passes made them so.

fn test_levelling_sets_every_cell_of_its_disc() {
  w = strip(SURFACE_MAT, 0);
  cl = 0;
  rs = 0;
  brush_level(w, 0, 0, G + 9, 5, cl, rs);
  n = 0;
  for q in (0 - 5)..6 {
    for r in (0 - 5)..6 {
      if hex_grid::hex_distance(q, r, 0, 0) >= 5 { continue; }
      assert(ground_h(w, q, r) == G + 9,
             "({q},{r}) ended at {ground_h(w, q, r)}, not the target {G + 9}");
      n = n + 1;
    }
  }
  assert(n > 40, "the disc was only {n} cells — this is not testing a disc");
  // ⚠ AND IT STOPS AT THE RIM. A set that ran past its radius would be a level
  // gesture that flattens the county, and every row above would still pass.
  assert(ground_h(w, 7, 0) == G, "the level reached {ground_h(w, 7, 0)} at radius 7");
}

// ⚠ THE CONTROL, AND IT IS THE HALF THAT KEEPS THE HILL A HILL. `brush` must be
// untouched: a raise still blends, so its rim is still tangent to the plain and a
// stroke still reads as a dome. If this ever comes out flat, the two faces have
// been collapsed into one.
fn test_a_raise_still_blends_and_is_not_a_disc() {
  w = strip(SURFACE_MAT, 0);
  cl = 0;
  rs = 0;
  brush(w, 0, 0, 24, 12, cl, rs);
  assert(ground_h(w, 0, 0) == G + 24, "the raise did not reach its amplitude");
  assert(ground_h(w, 6, 0) > G && ground_h(w, 6, 0) < G + 24,
         "half way out the raise is {ground_h(w, 6, 0) - G}, which is not a falloff");
  assert(ground_h(w, 11, 0) < ground_h(w, 6, 0),
         "the falloff does not fall: {ground_h(w, 6, 0) - G} then {ground_h(w, 11, 0) - G}");
}

// ⚠ AND A BUILDING IN THE DISC STILL MOVES RIGIDLY (`A1`), which the flat path has
// its own arm for: a body is already level, so its delta is one subtraction rather
// than the *largest the disc offers* search a hill needs for a porch on the rim.
fn test_a_levelled_pad_carries_a_building_rigidly() {
  w = strip(SURFACE_MAT, 0);
  runs = WallRuns { items: [] };
  ack = place_house(w, author_at(0.0, 0.0, 0.5235987755982988), 3, 3, G, runs);
  assert(ack.ak_ok, "the fixture did not place: {ack.ak_why}");
  cl = 0;
  rs = 0;
  brush_level(w, ack.ak_q, ack.ak_r, G + 6, 6, cl, rs);
  lo = 0 - 1;
  hi = 0;
  for q in (0 - 8)..9 {
    for r in (0 - 8)..9 {
      if (world_ground_cell(w, q, r).h_material as integer ?? 0) != FLOOR_MAT { continue; }
      h = ground_h(w, q, r);
      if lo < 0 { lo = h; hi = h; }
      if h < lo { lo = h; }
      if h > hi { hi = h; }
    }
  }
  assert(lo >= 0, "the fixture has no floor left");
  assert(hi - lo == 0, "levelling sheared the floor by {hi - lo}");
  assert(lo == G + 6, "the floor ended at {lo}, not the level target {G + 6}");
}
