//
// THE WALL RUN AND THE ROAD — `tools/gates/world/straight.mjs` measures the drawn
// vertices; this measures the STORE, which is the half a gate cannot reach.
//
// The claim S3 turned on: `25:` carries the material, and the material decides.
// A wall is the line itself — the edges that line crosses, marked, and nothing
// paved. A road is a centreline with a WIDTH: a band of cells plus a fence down
// each offset. Until S3 both laid a road whatever they were told, and the ack said
// so on every press.
use hex_editor;
use hex_voxel;
use hex_grid;

fn world() -> VoxelWorld {
  w = world_new(0.25, 0, 8, 3).wn_world;
  hex_editor::ground_fill(w, 0 - 20, 0 - 20, 21, 21, 8, hex_editor::SURFACE_MAT);
  w
}

fn east_run(mat: integer) -> WallRun {
  hex_editor::WallRun { wr_base: 0, wr_up: 0, wr_x0: 0 - 6.0, wr_z0: 0.0, wr_x1: 6.0, wr_z1: 0.0,
                        wr_mat: mat, wr_step: 0 }
}

fn no_runs() -> WallRuns { hex_editor::WallRuns { items: [] } }

fn paved(w: VoxelWorld) -> integer {
  n = 0;
  for q in 0 - 20..21 {
    for r in 0 - 20..21 {
      if hex_editor::ground_h(w, q, r) > 0
         && world_ground_cell(w, q, r).h_material == hex_editor::ROAD_MAT { n = n + 1; }
    }
  }
  n
}

fn test_a_wall_marks_edges_and_paves_nothing() {
  // ⚠ THE WHOLE OF S3 IN ONE ASSERTION. A wall run used to answer "road laid 19
  // cells and 40 fence edges" — a paved band with a waist-high fence down each
  // side and nothing in the middle. It marks the line's own edges now.
  w = world();
  runs = no_runs();
  marked = 0;
  hex_editor::wall_stamp(w, east_run(hex_editor::WALL_MAT), hex_editor::WALL_MAT,
                         8, runs, marked);
  assert(marked > 0, "the wall marked {marked} edges");
  assert(paved(w) == 0, "and paved nothing, got {paved(w)} road cells");
  assert(len(runs.items) == 1, "one run for the renderer, got {len(runs.items)}");
}

fn test_a_road_paves_a_band_and_fences_both_offsets() {
  // The other half, unchanged and still wanted: a road IS a width, and its fences
  // are the two offset lines rather than the outline of the paved cells.
  w = world();
  runs = no_runs();
  fenced = 0;
  cut = 0;
  n = hex_editor::road_stamp(w, east_run(hex_editor::FENCE_MAT),
                             hex_editor::ROAD_HALF as float, hex_editor::FENCE_MAT,
                             8, runs, fenced, cut);
  assert(n > 0, "the road paved {n} cells");
  assert(fenced > 0, "and fenced {fenced} edges");
  assert(len(runs.items) == 2, "one run per offset, got {len(runs.items)}");
}

fn test_the_wall_run_stays_on_the_authors_line() {
  // Every edge a wall marks has its midpoint on the line, within the tolerance the
  // stamp itself uses. A staircase of edges wandering either side is what the
  // library's surface recovery exists to avoid, and what `straight.mjs` measures
  // in the drawn mesh — this is the same claim one layer down.
  w = world();
  runs = no_runs();
  marked = 0;
  hex_editor::wall_stamp(w, east_run(hex_editor::WALL_MAT), hex_editor::WALL_MAT,
                         8, runs, marked);
  worst = 0.0;
  for q in 0 - 20..21 {
    for r in 0 - 20..21 {
      for d in 0..6 {
        if hex_editor::wall_of(w, q, r, d, 2.0) == hex_editor::WALL_MAT {
          (nq, nr) = hex_neighbor(q, r, d);
          (cx, cz) = hex_to_px(q, r);
          (nx, nz) = hex_to_px(nq, nr);
          off = (cz + nz) * 0.5;
          if off < 0.0 { off = 0.0 - off; }
          if off > worst { worst = off; }
        }
      }
    }
  }
  assert(worst < 0.9, "every marked edge sits on the line, worst {worst} wu off");
}

// ⛔ **`test_the_heading_snaps_to_one_of_twenty_four_and_reports_the_residual` IS
// GONE — plan 24 `H1e`, and this note is what it left behind.** It exercised
// `hex_editor::snap_heading` and `WALL_SNAP` directly: *due east is heading 0*, and
// *0.2 rad snaps to heading 1 with residual `0.2 - WALL_SNAP`*.
//
// Both are now false about the editor. `WALL_SNAP`'s `2*pi/24` grid asks for
// directions the lattice cannot express — `@HB-X31`: no odd multiple of 15 degrees is
// reachable — so heading 1 is `13.898` degrees and not `15`, and a residual measured
// against `15` was measuring against a direction no wall can take.
//
// ⚠ **WHAT IT GUARDED IS NOT LOST, IT MOVED**: that a run records a heading and the
// heading matches the run. `tests/runsnap.loft` holds that now, against `D` — every
// direction the gesture produces is a `d24` its own `wall_run_ok` admits, and each
// ring chord points where its recorded heading says.

fn test_a_run_of_no_length_writes_nothing() {
  w = world();
  runs = no_runs();
  marked = 0;
  before = w.w_tau;
  hex_editor::wall_stamp(w, hex_editor::WallRun { wr_base: 0, wr_up: 0, wr_x0: 1.0, wr_z0: 1.0,
                                                  wr_x1: 1.0, wr_z1: 1.0,
                                                  wr_mat: hex_editor::WALL_MAT,
                                                  wr_step: 0 },
                         hex_editor::WALL_MAT, 8, runs, marked);
  assert(marked == 0, "a run of no length marks nothing, got {marked}");
  assert(w.w_tau == before, "and writes nothing: τ {before} -> {w.w_tau}");
}

// ── THE RUN GOES ONTO THE WALL WHEN THE WALL HAS A LINE — plan 22 `D1a.3` ───
//
// ⛔ **A WALL WAS DRAWN 0.75 WORLD UNITS OFF THE BOUNDARY IT IS STORED ON.** Measured in
// `probe/d2/runline.loft` on `door.keys`'s own wall: the run said `z 0`, the store's
// fourteen edge midpoints were **all** at `z -0.75`, and the emitted masonry ran
// `-0.433 .. +0.433` — centred on the line, its near face stopping 0.317 short of the
// boundary a walker collides with. A row of cell CENTRES has no lattice edge on it, so
// `wall_stamp` marks the nearest boundary instead, half a row away.
//
// ⚠ **AND *JUST SHIFT THE RUN* IS REFUTED FOR MOST HEADINGS.** Over eight headings the
// perpendicular offsets spread by up to **1.55** — the wall zigzags about its line and
// there is no line the edges lie on. So the rule is narrow: when every stamped edge
// shares one offset, the wall HAS a line and the run must be it.

// Every stamped edge midpoint's perpendicular offset from `run`, as a spread.
fn offsets(w: VoxelWorld, run: hex_editor::WallRun, mat: integer, ref: float,
           lo: &float, hi: &float) -> integer {
  n = 0;
  lo = 1000000.0;
  hi = 0.0 - 1000000.0;
  dx = run.wr_x1 - run.wr_x0;
  dz = run.wr_z1 - run.wr_z0;
  dl = sqrt(dx * dx + dz * dz) ?? 0.0;
  nx = 0.0 - (dz / dl ?? 0.0);
  nz = dx / dl ?? 0.0;
  for q in 0 - 12..13 {
    for r in 0 - 12..13 {
      for d in 0..6 {
        (oq, orr, _s) = hex_editor::edge_owner(q, r, d);
        if oq == q && orr == r && hex_editor::wall_of(w, q, r, d, ref) == mat {
          (nq, nr) = hex_grid::hex_neighbor(q, r, d);
          (ax, az) = hex_grid::hex_to_px(q, r);
          (bx, bz) = hex_grid::hex_to_px(nq, nr);
          off = nx * ((ax + bx) * 0.5 - run.wr_x0) + nz * ((az + bz) * 0.5 - run.wr_z0);
          if off < lo { lo = off; }
          if off > hi { hi = off; }
          n = n + 1;
        }
      }
    }
  }
  n
}

// Two presses of `run`, at the two ends of a line through the origin at `ang`.
fn walked(ang: float, s: hex_editor::EditSession) -> VoxelWorld {
  ww = world_new(0.25, hex_editor::W_RESERVE,
                 hex_editor::WORLD_EPS, hex_editor::WORLD_THETA).wn_world;
  hex_editor::ground_fill(ww, 0 - 20, 0 - 20, 41, 41, 40, hex_editor::SURFACE_MAT);
  hx = cos(ang) * 6.0;
  hz = sin(ang) * 6.0;
  hex_editor::press_verb(s, ww, hex_editor::author_at(0.0 - hx, 0.0 - hz, 0.0, 10.0), "run");
  hex_editor::press_verb(s, ww, hex_editor::author_at(hx, hz, 0.0, 10.0), "run");
  ww
}

fn test_a_straight_wall_is_registered_on_the_line_its_edges_are_on() {
  s = hex_editor::EditSession {};
  w = walked(0.0, s);
  assert(len(s.es_runs.items) == 1, "the fixture laid {len(s.es_runs.items)} runs");
  run = s.es_runs.items[0] ?? hex_editor::WallRun {};
  lo = 0.0;
  hi = 0.0;
  n = offsets(w, run, hex_editor::WALL_MAT, 10.0, lo, hi);
  assert(n > 8, "the fixture stamped {n} edges, too few to be a wall");
  // ⚠ THE FIXTURE'S OWN PRECONDITION: this heading has to be one of the straight ones,
  // or the row below would be asserting something about a zigzag.
  assert(hi - lo < 0.000001,
         "heading 0 is not a straight wall here: offsets spread {hi - lo}");
  d = lo; if d < 0.0 { d = 0.0 - d; }
  assert(d < 0.000001,
         "the run is {d} off the wall it stamped — it used to be 0.75, and the picture "
       + "is drawn from this line");
}

// ⚠ **THE CONTROL, AND THE ROW ABOVE IS WORTH NOTHING WITHOUT IT.** A zigzag heading
// has no line its edges lie on, so its run must be left exactly where the author walked
// — a correction that moved it would be a best fit presented as a fact.
fn test_and_a_zigzag_heading_is_left_where_the_author_walked() {
  s = hex_editor::EditSession {};
  w = walked(PI / 8.0 ?? 0.0, s);
  run = s.es_runs.items[0] ?? hex_editor::WallRun {};
  lo = 0.0;
  hi = 0.0;
  offsets(w, run, hex_editor::WALL_MAT, 10.0, lo, hi);
  assert(hi - lo > 0.5,
         "this heading was meant to zigzag and its offsets spread only {hi - lo} — "
       + "the control cannot see a wrongly-moved run");
  assert(lo < 0.0 && hi > 0.0,
         "the wall no longer straddles its run: offsets {lo} .. {hi}");
}
