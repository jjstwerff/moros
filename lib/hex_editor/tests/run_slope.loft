// A LINEAR RUN BENDS ALONG ITSELF; A BUILDING STAYS RIGID — plan 20 `A2c`.
//
// *A wall (city or castle) can slope too like a road (see the great wall of china).*
// `A1` moved every connected fabric component rigidly, which is right for a garden
// fence bounding a yard and wrong for a wall crossing a county: measured, a 51-cell
// wall came up as ONE SLAB, every cell +12, floating at its ends.
//
// What separates them is not length — it is whether the thing has an INSIDE.
use hex_editor;
use hex_voxel;

const U = 0.25;
const G = 40;

fn plain() -> VoxelWorld {
  w = world_new(U, 0, 8, 3).wn_world;
  ground_fill(w, (0 - 30), (0 - 30), 31, 31, G, SURFACE_MAT);
  w
}

fn line(w: VoxelWorld, mat: integer, from: integer, to: integer) {
  for q in from..to { wall_set(w, q, 0, SLOT_NE, mat, G, (G as float) * U); }
}

fn raise(w: VoxelWorld, q: integer, r: integer, amp: integer, rad: integer) -> integer {
  cl = 0;
  rs = 0;
  brush(w, q, r, amp, rad, cl, rs);
  cl
}

fn steepest_along(w: VoxelWorld, n: integer) -> integer {
  worst = 0;
  prev = ground_h(w, 0, 0);
  for q in 1..n {
    st = prev - ground_h(w, q, 0);
    if st < 0 { st = 0 - st; }
    if st > worst { worst = st; }
    prev = ground_h(w, q, 0);
  }
  worst
}

fn test_a_city_wall_climbs_instead_of_moving_as_one_slab() {
  w = plain();
  line(w, WALL_MAT, 0 - 25, 26);
  raise(w, 0, 0, 12, 7);
  // ⚠ THE SLAB IS THE THING BEING REFUSED. Before `A2c` every cell of this wall
  // came out at +12, including the ones far outside the stroke.
  assert(ground_h(w, 20, 0) == G,
         "the wall moved {ground_h(w, 20, 0) - G} at 20 hexes out — it is still a slab");
  assert(steepest_along(w, 8) <= edge_kind_of(WALL_MAT).ek_slope,
         "the wall's steepest step is {steepest_along(w, 8)}, over its limit");
  assert(ground_h(w, 0, 0) > G, "the wall did not climb at all");
}

fn test_a_fence_is_allowed_a_steeper_climb_than_masonry() {
  // ⚠ THE ORDERING IS THE CLAIM. If both merely "passed their own limit" the table
  // could be all ones and this file would still be green.
  assert(edge_kind_of(FENCE_MAT).ek_slope > edge_kind_of(WALL_MAT).ek_slope,
         "a fence must be allowed more than a wall");
  ww = plain();
  line(ww, WALL_MAT, 0 - 25, 26);
  raise(ww, 0, 0, 12, 7);
  wf = plain();
  line(wf, FENCE_MAT, 0 - 25, 26);
  raise(wf, 0, 0, 12, 7);
  assert(ground_h(wf, 0, 0) > ground_h(ww, 0, 0),
         "the fence reached {ground_h(wf, 0, 0) - G} and the wall {ground_h(ww, 0, 0) - G} "
       + "— a fence must get further up the same hill");
}

fn test_a_building_still_moves_rigidly() {
  // ⚠ THE CONTROL THAT KEEPS `A1` ALIVE. A discriminator that called everything a
  // run would satisfy every claim above and would put back the shear `A1` removed.
  w = plain();
  runs = WallRuns { items: [] };
  ack = place_house(w, author_on(w, 0.0, 0.0, 0.5235987755982988), 5, 4, G, runs,
                    RoofPlans { items: [] });
  assert(ack.ak_ok, "{ack.ak_why}");
  fq: vector<integer> = [];
  fr: vector<integer> = [];
  for q in (0 - 24)..25 {
    for r in (0 - 24)..25 {
      if (world_ground_cell(w, q, r).h_material as integer ?? 0) == FLOOR_MAT {
        fq += [q];
        fr += [r];
      }
    }
  }
  raise(w, ack.ak_q, ack.ak_r, 6, 7);
  lo = 99999;
  hi = 0 - 99999;
  for i in 0..len(fq) {
    h = ground_h(w, fq[i] ?? 0, fr[i] ?? 0);
    if h < lo { lo = h; }
    if h > hi { hi = h; }
  }
  assert(hi == lo, "the floor sheared by {hi - lo} — a building was read as a run");
}

fn test_a_fenced_yard_still_moves_rigidly() {
  // An enclosure is a building however thin its walls: it has an INSIDE.
  w = plain();
  for q in (0 - 4)..5 {
    for r in (0 - 4)..5 {
      if hex_distance(q, r, 0, 0) == 4 {
        for slot in 0..3 { wall_set(w, q, r, slot, FENCE_MAT, G, (G as float) * U); }
      }
    }
  }
  raise(w, 0, 0, 6, 7);
  assert(ground_h(w, 0, 0) == ground_h(w, 4, 0),
         "the yard ({ground_h(w, 0, 0)}) and its fence ({ground_h(w, 4, 0)}) came apart "
       + "— an enclosure was read as a run");
}

// The cross-fall at a cell, in HALVES of a height unit, measured at the SAME STATION.
//
// ⚠ THERE IS NO CELL DIRECTLY ACROSS, and that is the whole difficulty. In odd-r offset
// lane `r+1` sits half a hex ALONG the run from lane `r`, so differencing the two reads
// the along-grade and calls it camber. The cell across at the same station is the
// MIDPOINT of two neighbours, so this doubles to stay exact — and one half is therefore
// the floor: a midpoint of two integers cannot be matched more closely than that, which
// is why the phase row's literal "zero cross-fall" is not reachable on this lattice.
fn cross_halves(w: VoxelWorld, q: integer) -> integer {
  a = ground_h(w, q, 0);
  b = ground_h(w, q, 1);
  c = ground_h(w, q - 1, 1);
  f = 2 * a - b - c;
  if f < 0 { f = 0 - f; }
  f
}

fn worst_cross(w: VoxelWorld) -> integer {
  worst = 0;
  for q in (0 - 13)..14 {
    f = cross_halves(w, q);
    if f > worst { worst = f; }
  }
  worst
}

fn two_lane(w: VoxelWorld) {
  for q in (0 - 25)..26 {
    ground_set(w, q, 0, G, ROAD_MAT);
    ground_set(w, q, 1, G, ROAD_MAT);
  }
}

fn test_a_two_wide_road_comes_out_level_across() {
  // ⚠ THIS ROW USED TO ASSERT `<= tr_slope` AND SIT AT ONE STROKE OFFSET, and it was
  // both the wrong quantity and a lucky place to ask it. Differencing the two lanes
  // reads the along-grade as camber; and offset 4 happens to be one of the offsets that
  // came out level anyway, so a bound of one whole unit could not have caught the
  // camber that was there. Measured across the sweep below, offsets 0, 5 and 7 and every
  // steep tight stroke carried a full unit of real cross-fall.
  for sr in [0, 1, 2, 3, 4, 5, 7] {
    w = plain();
    two_lane(w);
    raise(w, 0, sr, 12, 9);
    assert(worst_cross(w) <= 1,
           "a stroke at r={sr} left {worst_cross(w)} halves of cross-fall on a road "
           + "whose limit across itself is nothing");
  }
  // steeper and tighter, where a scalar limit has the most room to hide a camber
  for amp in [24, 48] {
    w2 = plain();
    two_lane(w2);
    raise(w2, 0, 3, amp, 4);
    assert(worst_cross(w2) <= 1,
           "an amp-{amp} stroke left {worst_cross(w2)} halves of cross-fall");
  }
}

fn test_and_the_run_still_climbs_along_itself() {
  // ⚠ THE CONTROL THE TWO REMOVED ATTEMPTS NEEDED. An across-rule that flattens the
  // road satisfies the row above perfectly and destroys the run: both earlier versions
  // chained their equalities down the line until the whole thing sat back at its
  // original height, with every count agreeing. So the road must still BEND along
  // itself under the same stroke.
  w = plain();
  two_lane(w);
  raise(w, 0, 0, 12, 9);
  lo = G;
  hi = G;
  for q in (0 - 12)..13 {
    h = ground_h(w, q, 0);
    if h < lo { lo = h; }
    if h > hi { hi = h; }
  }
  assert(hi > lo,
         "the road came out at one height end to end — an across-rule that flattens the "
         + "run is worse than none");
  assert(worst_cross(w) <= 1, "and it is still level across, got {worst_cross(w)}");
}

fn test_a_road_with_no_run_around_it_has_no_axis() {
  // ⚠ THE PLAN'S OWN NEGATIVE CONTROL: *a road cell with no road neighbour has no axis
  // — it falls back to the scalar limit, not to flat.* A single paved cell is not a run
  // and nothing about it is "across", so the stroke moves it exactly as it moves the
  // ground, and this rule must not touch it.
  w = plain();
  ground_set(w, 0, 0, G, ROAD_MAT);
  raise(w, 0, 0, 12, 9);
  bare = plain();
  raise(bare, 0, 0, 12, 9);
  assert(ground_h(w, 0, 0) == ground_h(bare, 0, 0),
         "a lone paved cell rose to {ground_h(w, 0, 0)} where bare ground rose to "
         + "{ground_h(bare, 0, 0)} — it was given an axis it does not have");
}
