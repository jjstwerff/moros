// EVERY STRUCTURE IN A WINDOW, BY PEELING — plan 26 `B4s`.
//
// ⛔ **A WINDOW HELD TWO DESCRIPTIONS AND EVERY REAL SCENE HOLDS MORE.** `B4o` split a
// house's marks from a wall's; `B4p` gave that leftover the whole chain. Both took out
// exactly ONE structure, because the exclusion was a `Box` — so a window with three
// things in it described two and dropped the third in silence.
//
// ⚠ **WHAT MADE THE LOOP POSSIBLE IS `run_edges`.** Every other shape could always say
// what it owns: a disc's boundary walk, an octagon's `poly_holds`, a rectangle's
// `house_owns`. The RUN could not be asked at all until `B4q` extracted the stamper's
// rule, and its answer was not stable until `B4r` — a peel built before either would
// have subtracted the wrong edges on five headings in ten.
use hex_editor;
use hex_voxel;
use hex_shape;
use hex_grid;

const YAW = 1.5707963267948966;
const U = 0.25;

fn flat_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - 30, 0 - 30, 61, 61, 8, SURFACE_MAT);
  w
}

fn house_at(w: VoxelWorld, x: float, z: float) {
  s = EditSession {};
  session_at(s, w, x, z, YAW);
  assert(press_verb(s, w, s.es_author, VB_PLACE, "").ak_ok, "the fixture's house was refused");
}

fn tower_at(w: VoxelWorld, x: float, z: float) {
  s = EditSession {};
  session_at(s, w, x, z, 0.0);
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the fixture's tower was refused");
}

fn wall_at(w: VoxelWorld, x0: float, z0: float, x1: float, z1: float) {
  d = run_between(x0, z0, x1, z1, WALL_MAT);
  assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
  rs = WallRuns { items: [] };
  m = 0;
  wall_stamp(w, d.rd_run, WALL_MAT, 8, rs, m);
  assert(m > 0, "the fixture's wall stamped nothing");
}

// The chain, peeled over COMPONENTS — the same order and the same readers `plan_panel`
// asks, written out here so the LIBRARY's half can be tested without a picture.
//
// ⚠ **THE FIELD IS SPLIT FIRST — plan 26 `B4t`.** A component is asked about by CLAIMING
// everything else, so every reader keeps the signature it had and `FORMAL_CORE` §6's R1
// keeps comparing over a field that is entirely one structure's.
// ⛔ **AND A COMPONENT NO ONE READER EXPLAINS GETS A SET OF THEM — plan 26 `B4v`.**
// Each shape's own boundary must lie WITHIN the component's marks, and the set is taken
// only when it claims every one of them and nothing outside — one integer, both
// directions. ⚠ **The trial runs on a copy**, so a rejected one leaves nothing behind:
// its claims would otherwise silence the marks the refusal exists to count.
fn trial(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer, base: Claims,
         sg: Segments, id: integer, before: integer, mine: integer) -> text {
  sc = claims_copy(base, q0, r0, wq, hr);
  within = segment_claims(base, w, q0, r0, wq, hr, 0.0, sg, id);
  got = "";
  for t in 0..8 {
    rest = segment_claims(sc, w, q0, r0, wq, hr, 0.0, sg, id);
    rr = wall_recover_claimed(w, q0, r0, wq, hr, 0.0, rest);
    // ⚠ `missing == 0` IS THE *WITHIN* TEST FOR A RUN, in the number `RunRead` has
    // carried since `B4q`: edges it generates that the store does not hold.
    if rr.rr_ok && rr.rr_missing == 0
       && claim_run(sc, rr.rr_x0, rr.rr_z0, rr.rr_x1, rr.rr_z1, q0, r0, wq, hr) > 0 {
      got = got + "run;";
      continue;
    }
    dw = disc_within(w, q0, r0, wq, hr, 0.0, within, sc);
    if dw.dc_ok && claim_disc(sc, dw.dc_cq, dw.dc_cr, dw.dc_shell, q0, r0, wq, hr) > 0 {
      got = got + "disc;";
      continue;
    }
    hh = house_recover_claimed(w, q0, r0, wq, hr, 0.0, rest);
    if hh.hs_ok {
      hb = hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep, hh.hs_rot, false);
      if claim_house(sc, hb, q0, r0, wq, hr) > 0 { got = got + "house;"; continue; }
    }
    break;
  }
  if got == "" { return ""; }
  if marks_unclaimed(w, q0, r0, wq, hr, 0.0, sc) != before - mine { return ""; }
  // …accepted: the copy becomes the answer
  claims_adopt(base, sc, q0, r0, wq, hr);
  got
}

// The trial's claims, moved onto the real set once it has been accepted.
fn claims_adopt(dst: Claims, src: Claims, q0: integer, r0: integer, wq: integer,
                hr: integer) {
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      if hexset_get(src.cl_cells, q, r) { hexset_set(dst.cl_cells, q, r, true); }
      for d in [4, 5, 0] {
        (nq, nr) = hex_grid::hex_neighbor(q, r, d);
        if edge_mat(src.cl_edges, q, r, nq, nr) != 0 {
          edge_set_mat(dst.cl_edges, q, r, nq, nr, 1);
        }
      }
    }
  }
}

fn peel(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer,
        cl: Claims) -> text {
  out = "";
  part = false;
  for i in 0..8 {
    sg = segments_of(w, q0, r0, wq, hr, 0.0, cl);
    if segment_count(sg) == 0 { return out; }
    told = out;
    for id in 0..segment_count(sg) {
      only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, id);
      before = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
      mine = marks_unclaimed(w, q0, r0, wq, hr, 0.0, only);
      rr = wall_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
      // ⛔ **THE TRIAL IS ASKED WHERE ONE READER CANNOT ACCOUNT FOR THE COMPONENT** —
      // either because it refused, or because it answered while being handed marks it
      // does not want, which is `rr_stray` for a run and `hs_other` for a house.
      short = rr.rr_ok && rr.rr_stray > 0;
      if !rr.rr_ok {
        dq = disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
        hq = house_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
        short = !dq.dc_ok && (!hq.hs_ok || hq.hs_other > 0);
      }
      if short {
        t = trial(w, q0, r0, wq, hr, cl, sg, id, before, mine);
        if t != "" { out = out + t; continue; }
      }
      if rr.rr_ok {
        out = out + "run;";
        if claim_run(cl, rr.rr_x0, rr.rr_z0, rr.rr_x1, rr.rr_z1, q0, r0, wq, hr) == 0 {
          return out + "STUCK;";
        }
        if segment_marks_left(w, q0, r0, wq, hr, 0.0, cl, sg, id) > 0 { part = true; }
        continue;
      }
      dc = disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
      if dc.dc_ok {
        out = out + "disc;";
        if claim_disc(cl, dc.dc_cq, dc.dc_cr, dc.dc_shell, q0, r0, wq, hr) == 0 {
          return out + "STUCK;";
        }
        if segment_marks_left(w, q0, r0, wq, hr, 0.0, cl, sg, id) > 0 { part = true; }
        continue;
      }
      hh = house_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
      if hh.hs_ok {
        out = out + "house;";
        hb = hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep, hh.hs_rot, false);
        if claim_house(cl, hb, q0, r0, wq, hr) == 0 { return out + "STUCK;"; }
        if segment_marks_left(w, q0, r0, wq, hr, 0.0, cl, sg, id) > 0 { part = true; }
        continue;
      }
    }
    // ⚠ A ROUND THAT DESCRIBED NOTHING ENDS IT, whatever is left: peeling one structure
    // can SPLIT what remains, which is why the labels are rebuilt each round — but a
    // round with no answer will not produce one next time either.
    // ⛔ AND SO DOES A DESCRIPTION THAT EXPLAINED ONLY PART OF ITS OWN COMPONENT — plan
    // 26 `B4u`. Re-splitting a structure somebody else's claim broke in half is where
    // the false runs come from; the fragments are counted, not described.
    if out == told || part { return out; }
  }
  out + "CAPPED;"
}

// ── ⛔ THE ROW `B4p` MEASURED THE OTHER WAY ────────────────────────────────
//
// `B4p` pinned this scene as the limitation: *"a closed rim contributes no ends, so
// `wall_read_run` sees exactly the wall's two and answers for the wall — correctly, and
// with 54 of the tower's marks unmentioned."* The wall is still described first. The
// difference is that its marks are then taken out, and what is left IS a disc.
fn test_a_house_a_tower_and_a_wall_are_all_three_described() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  tower_at(w, 0.0, 0.0 - 12.0);
  wall_at(w, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  cl = claims_new(0 - 12, 0 - 16, 25, 26);
  got = peel(w, 0 - 12, 0 - 16, 25, 26, cl);
  // ⚠ **THE ORDER IS THE LABEL SCAN'S, NOT THE CHAIN'S — plan 26 `B4t`.** Components are
  // visited as the window is read, row by row, so the tower at `r = -8` comes before the
  // house at `r = 4`. Deterministic either way, and a row asserting the chain's order
  // would be asserting where the fixture happens to stand.
  assert(got == "disc;run;house;",
         "the peel described `{got}`, not a disc, a run and a house");
  // ⚠ **AND NOTHING IS LEFT OVER**, which is the claim that says the three descriptions
  // account for the field rather than merely being three answers.
  left = marks_unclaimed(w, 0 - 12, 0 - 16, 25, 26, 0.0, cl);
  assert(left == 0, "{left} marks are explained by none of the three");
}

// ── THE FLOOR CHANNEL IS WHAT ENDS THE LOOP ───────────────────────────────
//
// ⛔ **EVERY OTHER READER IS SUBTRACTED BY TAKING ITS MARKS AWAY, AND THE HOUSE READER
// NEVER LOOKS AT A MARK.** `B4n`'s finding — the rectangle comes from the FLOOR — is
// what makes it able to describe a house at all, and it is exactly why claiming edges
// cannot silence it. Without the cell channel the peel does not give a wrong answer; it
// gives the same right one for ever.
fn test_claiming_a_houses_marks_is_not_what_silences_it() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  h = house_recover(w, 0 - 10, 0 - 10, 21, 21, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  b = hex_shape::box_new(h.hs_cq, h.hs_cr, h.hs_wid, h.hs_dep, h.hs_rot, false);

  // ⚠ EDGES ONLY — a run straight through the house takes several of its marks out.
  // The reader must be unmoved, because it never reads them.
  edges = claims_new(0 - 10, 0 - 10, 21, 21);
  before = marks_unclaimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, edges);
  claim_run(edges, 0.0 - 9.0, 3.0, 9.0, 3.0, 0 - 10, 0 - 10, 21, 21);
  after = marks_unclaimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, edges);
  assert(after < before,
         "the fixture claimed none of the house's {before} marks, so this row proves "
       + "nothing about the edge channel");
  e = house_recover_claimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, edges);
  assert(e.hs_ok && e.hs_cq == h.hs_cq && e.hs_cr == h.hs_cr && e.hs_wid == h.hs_wid
         && e.hs_dep == h.hs_dep,
         "a house with some of its MARKS claimed reads back as a different rectangle — "
       + "the reader has started reading them, and `B4n`'s finding wants re-measuring");

  // …and with its floor accounted for, it is silent
  cells = claims_new(0 - 10, 0 - 10, 21, 21);
  claim_house(cells, b, 0 - 10, 0 - 10, 21, 21);
  assert(!house_recover_claimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, cells).hs_ok,
         "a house whose own floor is accounted for is described a second time — the "
       + "peel would answer it for ever");
}

// ⚠ **A CLAIM IS IDEMPOTENT AND SAYS WHETHER IT WAS NEW**, which is what lets the peel
// notice a reader that answers without accounting for anything. Without it the loop's
// only bound is the cap, and a cap is not a termination argument.
fn test_a_claim_is_idempotent_and_reports_only_what_was_new() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  d = disc_recover(w, 0 - 10, 0 - 10, 21, 21, 0.0);
  assert(d.dc_ok, "the fixture's tower did not recover: {d.dc_why}");
  cl = claims_new(0 - 10, 0 - 10, 21, 21);
  first = claim_disc(cl, d.dc_cq, d.dc_cr, d.dc_shell, 0 - 10, 0 - 10, 21, 21);
  again = claim_disc(cl, d.dc_cq, d.dc_cr, d.dc_shell, 0 - 10, 0 - 10, 21, 21);
  assert(first > 0, "claiming a disc's boundary claimed nothing");
  assert(again == 0, "claiming it twice claimed {again} more");
}

// ⛔ **WHAT A SHAPE OWNS MUST OVERLAP WHAT IT EXPLAINED**, or the peel would subtract
// somebody else's marks — which is `B4o`'s defect with the sign flipped. Measured
// against the reader's own count rather than against the claim: two numbers from
// opposite sides.
fn test_each_shape_accounts_for_the_marks_it_was_recovered_from() {
  // a disc
  dw = flat_world();
  tower_at(dw, 0.0, 0.0);
  dd = disc_recover(dw, 0 - 10, 0 - 10, 21, 21, 0.0);
  dcl = claims_new(0 - 10, 0 - 10, 21, 21);
  claim_disc(dcl, dd.dc_cq, dd.dc_cr, dd.dc_shell, 0 - 10, 0 - 10, 21, 21);
  assert(marks_unclaimed(dw, 0 - 10, 0 - 10, 21, 21, 0.0, dcl) == 0,
         "a disc leaves {marks_unclaimed(dw, 0 - 10, 0 - 10, 21, 21, 0.0, dcl)} of its "
       + "own {dd.dc_marks} marks unaccounted for");

  // a run
  rw = flat_world();
  wall_at(rw, 0.0 - 9.0, 0.0, 6.0, 0.0);
  rr = wall_recover(rw, 0 - 14, 0 - 14, 29, 29, 0.0);
  assert(rr.rr_ok, "the fixture's wall did not recover");
  rcl = claims_new(0 - 14, 0 - 14, 29, 29);
  claim_run(rcl, rr.rr_x0, rr.rr_z0, rr.rr_x1, rr.rr_z1, 0 - 14, 0 - 14, 29, 29);
  assert(marks_unclaimed(rw, 0 - 14, 0 - 14, 29, 29, 0.0, rcl) == 0,
         "a run leaves {marks_unclaimed(rw, 0 - 14, 0 - 14, 29, 29, 0.0, rcl)} of its "
       + "own {rr.rr_marks} marks unaccounted for");

  // a house — its boundary AND the mitre one cell past it
  hw = flat_world();
  house_at(hw, 0.0, 0.0);
  hh = house_recover(hw, 0 - 10, 0 - 10, 21, 21, 0.0);
  hcl = claims_new(0 - 10, 0 - 10, 21, 21);
  claim_house(hcl, hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep,
                                      hh.hs_rot, false), 0 - 10, 0 - 10, 21, 21);
  assert(marks_unclaimed(hw, 0 - 10, 0 - 10, 21, 21, 0.0, hcl) == 0,
         "a house leaves {marks_unclaimed(hw, 0 - 10, 0 - 10, 21, 21, 0.0, hcl)} marks "
       + "unaccounted for — including its mitre, which `B4o` measured it owns");
}

// ── ✅ AND TWO OF A KIND, WHICH THE PEEL ALONE COULD NOT — plan 26 `B4t` ──
//
// ⛔ **`B4s` MEASURED THESE AS THE LIMITATION**: two houses described nothing with 84
// marks left, two walls nothing with 23, a house and two towers only the house with 108.
// The peel subtracts what has been DESCRIBED and nothing had been, because `disc_fits`
// and `box_fits` compare over the whole field in BOTH directions — *every boundary edge
// is marked AND every mark is a boundary edge* — which is exactly what stops a disc being
// accepted with a wall drawn across it.
//
// ✅ **SPLITTING THE FIELD FIRST LEAVES THAT CHECK UNTOUCHED**, because each reader is
// then handed a field that is entirely one structure's.
fn test_two_of_a_kind_are_each_described() {
  hw = flat_world();
  house_at(hw, 0.0, 0.0);
  house_at(hw, 0.0 - 16.0, 0.0);
  hcl = claims_new(0 - 18, 0 - 8, 26, 20);
  assert(peel(hw, 0 - 18, 0 - 8, 26, 20, hcl) == "house;house;",
         "two houses describe `{peel(hw, 0 - 18, 0 - 8, 26, 20, claims_new(0 - 18, 0 - 8, 26, 20))}`");
  assert(marks_unclaimed(hw, 0 - 18, 0 - 8, 26, 20, 0.0, hcl) == 0,
         "two described houses leave "
       + "{marks_unclaimed(hw, 0 - 18, 0 - 8, 26, 20, 0.0, hcl)} marks over");

  ww = flat_world();
  wall_at(ww, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  wall_at(ww, 6.0, 0.0 - 3.0, 6.0, 6.0);
  wcl = claims_new(0 - 14, 0 - 8, 26, 18);
  assert(peel(ww, 0 - 14, 0 - 8, 26, 18, wcl) == "run;run;",
         "two walls describe `{peel(ww, 0 - 14, 0 - 8, 26, 18, claims_new(0 - 14, 0 - 8, 26, 18))}`");
  assert(marks_unclaimed(ww, 0 - 14, 0 - 8, 26, 18, 0.0, wcl) == 0,
         "two described walls leave marks over");
}

// ── ⛔ AND WHAT STILL REFUSES, WHICH IS THE POINT OF NOT SOFTENING R1 ──────
//
// ⚠ **A SPLIT IS NOT A LICENCE TO ANSWER.** The boundary of a two-cell domino is one
// component and every reader gives up on it: no chain ends for the run reader, no disc
// reproduces it, no floor for the house reader. ⚠ **Without this row the step could have
// shipped a chain that answered for anything** — which is what softening the both-ways
// comparison would have bought, and the reason it was not touched.
fn test_a_component_no_reader_explains_is_still_refused() {
  w = flat_world();
  for d0 in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(0, 0, d0);
    if !(nq == 1 && nr == 0) { wall_set(w, 0, 0, d0, WALL_MAT, 8, 2.0); }
  }
  for d1 in 0..6 {
    (mq, mr) = hex_grid::hex_neighbor(1, 0, d1);
    if !(mq == 0 && mr == 0) { wall_set(w, 1, 0, d1, WALL_MAT, 8, 2.0); }
  }
  cl = claims_new(0 - 8, 0 - 8, 17, 17);
  sg = segments_of(w, 0 - 8, 0 - 8, 17, 17, 0.0, cl);
  assert(segment_count(sg) == 1,
         "the domino's boundary is {segment_count(sg)} components, not one — the fixture "
       + "is not what this row is about");
  assert(peel(w, 0 - 8, 0 - 8, 17, 17, cl) == "",
         "a closed loop no disc reproduces was described as "
       + "`{peel(w, 0 - 8, 0 - 8, 17, 17, claims_new(0 - 8, 0 - 8, 17, 17))}`");
  assert(marks_unclaimed(w, 0 - 8, 0 - 8, 17, 17, 0.0, cl) > 0,
         "it left nothing unexplained while explaining nothing");
}

// ── ✅ AND STRUCTURES THAT TOUCH, WHICH THE CELL FLOOD COULD NOT — `B4u` ──
//
// ⛔ **`B4t` NAMED THIS AS WHAT IT DELIBERATELY DID NOT DO**: *"a component is SPATIAL,
// so structures that touch are still one field"*. Measured, that costs more than a
// refusal — a house with a wall running off it described the house and left seven marks,
// and a house beside a tower drew a **run over the tower's rim**, which is a wall that is
// not there.
//
// ✅ **A MARK BELONGS TO THE CHAIN IT IS PART OF**, so the marks are flooded through the
// VERTICES they share while the floor keeps the cell flood. ⚠ **EVERY ROW HERE FIRST
// ASSERTS THE CELL FLOOD MAKES THEM ONE**, because a fixture that drifted apart would
// pass all of this while testing nothing.
fn touching(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer) -> integer {
  lb = labels_new(q0, r0, wq, hr);
  cells_label(touched_cells(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr)), lb)
}

fn test_two_walls_two_cells_apart_are_two_runs() {
  w = flat_world();
  wall_at(w, 0.0 - 2.0, 0.0 - 3.0, 0.0 - 2.0, 6.0);
  wall_at(w, 0.0, 0.0 - 3.0, 0.0, 6.0);
  assert(touching(w, 0 - 14, 0 - 8, 26, 18) == 1,
         "the two walls are {touching(w, 0 - 14, 0 - 8, 26, 18)} cell components, so they "
       + "do not touch and this row is about nothing");
  cl = claims_new(0 - 14, 0 - 8, 26, 18);
  assert(peel(w, 0 - 14, 0 - 8, 26, 18, cl) == "run;run;",
         "two walls two cells apart describe "
       + "`{peel(w, 0 - 14, 0 - 8, 26, 18, claims_new(0 - 14, 0 - 8, 26, 18))}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 8, 26, 18, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 14, 0 - 8, 26, 18, 0.0, cl)} marks over");
}

fn test_two_walls_meeting_at_a_corner_are_two_runs() {
  w = flat_world();
  wall_at(w, 0.0 - 6.0, 0.0, 0.0, 0.0);
  wall_at(w, 0.0, 0.0, 0.0, 6.0);
  assert(touching(w, 0 - 14, 0 - 8, 26, 18) == 1, "the L is not one cell component");
  cl = claims_new(0 - 14, 0 - 8, 26, 18);
  assert(peel(w, 0 - 14, 0 - 8, 26, 18, cl) == "run;run;",
         "an L of two walls describes "
       + "`{peel(w, 0 - 14, 0 - 8, 26, 18, claims_new(0 - 14, 0 - 8, 26, 18))}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 8, 26, 18, 0.0, cl) == 0, "marks over");
}

// ⛔ **THE HOUSE ATE PART OF THE WALL.** `claim_house` owns the mitre one cell past the
// box — `B4o`'s own rule, and right — so a wall that STARTS there had marks taken from
// it and the seven that were left described nothing. The wall's own piece is claimed
// before the house is asked, so the rule is unchanged and the order is what fixes it.
fn test_a_house_with_a_wall_running_off_it_is_both() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  wall_at(w, 4.0, 0.0, 12.0, 0.0);
  assert(touching(w, 0 - 12, 0 - 12, 30, 26) == 1,
         "the house and its wall are {touching(w, 0 - 12, 0 - 12, 30, 26)} cell "
       + "components, so they do not touch");
  cl = claims_new(0 - 12, 0 - 12, 30, 26);
  assert(peel(w, 0 - 12, 0 - 12, 30, 26, cl) == "run;house;",
         "a house with a wall running off it describes "
       + "`{peel(w, 0 - 12, 0 - 12, 30, 26, claims_new(0 - 12, 0 - 12, 30, 26))}`");
  assert(marks_unclaimed(w, 0 - 12, 0 - 12, 30, 26, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 12, 0 - 12, 30, 26, 0.0, cl)} marks over — `B4t` left 7");
}

// ⛔ **AND THIS ONE DREW A WALL THAT IS NOT THERE.** With the two in one field the house
// was described first, its claim opened the rim, and the opened rim read back as a RUN —
// a false description, which is worse than the refusal the other rows got.
fn test_a_house_beside_a_tower_is_a_disc_and_a_house() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  tower_at(w, 0.0, 0.0 - 7.0);
  assert(touching(w, 0 - 14, 0 - 16, 30, 30) == 1,
         "the house and the tower are {touching(w, 0 - 14, 0 - 16, 30, 30)} cell "
       + "components, so they do not touch");
  cl = claims_new(0 - 14, 0 - 16, 30, 30);
  got = peel(w, 0 - 14, 0 - 16, 30, 30, cl);
  assert(got == "disc;house;", "a house beside a tower describes `{got}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 16, 30, 30, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 14, 0 - 16, 30, 30, 0.0, cl)} marks over");
}

fn test_two_towers_a_cell_apart_are_two_discs() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  tower_at(w, 15.0, 0.0);
  assert(touching(w, 0 - 14, 0 - 14, 44, 30) == 1,
         "the two towers are {touching(w, 0 - 14, 0 - 14, 44, 30)} cell components, so "
       + "they do not touch");
  cl = claims_new(0 - 14, 0 - 14, 44, 30);
  assert(peel(w, 0 - 14, 0 - 14, 44, 30, cl) == "disc;disc;",
         "two towers a cell apart describe "
       + "`{peel(w, 0 - 14, 0 - 14, 44, 30, claims_new(0 - 14, 0 - 14, 44, 30))}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 14, 44, 30, 0.0, cl) == 0, "marks over");
}

// ── ⚠ THE INSTRUMENT, CHECKED BEFORE IT IS BELIEVED ───────────────────────
//
// The flood walks to the four edges sharing a corner by ROTATION — from `A` the two
// third cells lie at `d±1` and from `B` the same two lie at `d∓2`. That is an assertion
// about the lattice, so it is compared here against the corner IDENTITY: `hex_corner_tri_a`
// and `hex_corner_tri_b`, the exact triangle-lattice integers `wall_chain_ends` counts
// degrees over. Two edges are in one piece iff they are joined by a path of shared
// corners; the two answers must partition the marks identically.
fn same_corner(aq: integer, ar: integer, ad: integer,
               bq: integer, br: integer, bd: integer) -> boolean {
  (a1, a2) = hex_grid::hex_edge_corners(ad);
  (b1, b2) = hex_grid::hex_edge_corners(bd);
  for i in 0..2 {
    ac = if i == 0 { a1 } else { a2 };
    for j in 0..2 {
      bc = if j == 0 { b1 } else { b2 };
      if hex_shape::hex_corner_tri_a(aq, ar, ac) == hex_shape::hex_corner_tri_a(bq, br, bc)
         && hex_shape::hex_corner_tri_b(aq, ar, ac) == hex_shape::hex_corner_tri_b(bq, br, bc) {
        return true;
      }
    }
  }
  false
}

fn corner_partition_agrees(w: VoxelWorld, q0: integer, r0: integer, wq: integer,
                           hr: integer) -> text {
  cl = claims_new(q0, r0, wq, hr);
  ed = edgeset_new(q0, r0, wq, hr);
  np = marks_label(w, q0, r0, wq, hr, 0.0, cl, ed);
  eq: vector<integer> = [];
  er: vector<integer> = [];
  edir: vector<integer> = [];
  lab: vector<integer> = [];
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      for d in [4, 5, 0] {
        // ⚠ THE FIXTURES HAVE NOTHING CLAIMED, so *is this a mark* is the whole test.
        if !edge_is_wall(wall_of(w, q, r, d, 0.0)) { continue; }
        eq += [q]; er += [r]; edir += [d]; lab += [len(lab)];
      }
    }
  }
  if len(eq) == 0 { return "no marks"; }
  moved = true;
  while moved {
    moved = false;
    for i in 0..len(lab) {
      for j in 0..len(lab) {
        if i == j { continue; }
        if !same_corner(eq[i] ?? 0, er[i] ?? 0, edir[i] ?? 0,
                        eq[j] ?? 0, er[j] ?? 0, edir[j] ?? 0) { continue; }
        if (lab[j] ?? 0) < (lab[i] ?? 0) { lab[i] = lab[j] ?? 0; moved = true; }
      }
    }
  }
  seen: vector<integer> = [];
  for i in 0..len(lab) {
    got = false;
    for k in 0..len(seen) { if (seen[k] ?? 0) == (lab[i] ?? 0) { got = true; } }
    if !got { seen += [lab[i] ?? 0]; }
  }
  if len(seen) != np { return "{len(seen)} pieces by corner, {np} by the flood"; }
  for i in 0..len(lab) {
    for j in 0..len(lab) {
      (inq, inr) = hex_grid::hex_neighbor(eq[i] ?? 0, er[i] ?? 0, edir[i] ?? 0);
      (jnq, jnr) = hex_grid::hex_neighbor(eq[j] ?? 0, er[j] ?? 0, edir[j] ?? 0);
      byc = (lab[i] ?? 0) == (lab[j] ?? 0);
      byf = edge_mat(ed, eq[i] ?? 0, er[i] ?? 0, inq, inr)
            == edge_mat(ed, eq[j] ?? 0, er[j] ?? 0, jnq, jnr);
      if byc != byf { return "the two disagree about a pair of marks"; }
    }
  }
  ""
}

fn test_the_vertex_flood_is_the_corner_identity() {
  h = flat_world();
  house_at(h, 0.0, 0.0);
  assert(corner_partition_agrees(h, 0 - 10, 0 - 10, 21, 21) == "",
         "a house: {corner_partition_agrees(h, 0 - 10, 0 - 10, 21, 21)}");
  t = flat_world();
  tower_at(t, 0.0, 0.0);
  assert(corner_partition_agrees(t, 0 - 10, 0 - 10, 21, 21) == "",
         "a tower: {corner_partition_agrees(t, 0 - 10, 0 - 10, 21, 21)}");
  v = flat_world();
  house_at(v, 0.0, 0.0);
  tower_at(v, 0.0, 0.0 - 12.0);
  wall_at(v, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  assert(corner_partition_agrees(v, 0 - 12, 0 - 16, 25, 26) == "",
         "the village: {corner_partition_agrees(v, 0 - 12, 0 - 16, 25, 26)}");
  l = flat_world();
  wall_at(l, 0.0 - 6.0, 0.0, 0.0, 0.0);
  wall_at(l, 0.0, 0.0, 0.0, 6.0);
  assert(corner_partition_agrees(l, 0 - 14, 0 - 8, 26, 18) == "",
         "an L: {corner_partition_agrees(l, 0 - 14, 0 - 8, 26, 18)}");
}

// ⛔ **A HOUSE'S FOUR CORNER STUBS MUST NOT BECOME FOUR ONE-EDGE RUNS.** `B4t` measured
// that a lone marked edge is its own component with two chain ends, so it IS a run — and
// `B0`'s four stray edges are exactly four lone marks if the flood does not reach them.
// It does: each shares a vertex with the boundary it over-runs, which is what makes them
// the house's own mitre rather than four walls nobody built.
fn test_a_lone_house_is_one_piece() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  ed = edgeset_new(0 - 10, 0 - 10, 21, 21);
  np = marks_label(w, 0 - 10, 0 - 10, 21, 21, 0.0, claims_new(0 - 10, 0 - 10, 21, 21), ed);
  assert(np == 1, "a house's marks are {np} pieces, so its mitre stubs are their own runs");
}

// ⚠ **A PIECE NEVER CROSSES A CELL COMPONENT**, which is what lets a component be a piece
// plus the cell component it stands in. Two marks meeting at a vertex have cells that
// touch, and `touched_cells` takes BOTH cells of every mark — so the pieces refine the
// cell flood rather than cutting across it. Measured on the fixture that has three
// structures and one that has two in one field.
fn crosses(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer) -> boolean {
  cl = claims_new(q0, r0, wq, hr);
  lb = labels_new(q0, r0, wq, hr);
  cells_label(touched_cells(w, q0, r0, wq, hr, 0.0, cl), lb);
  ed = edgeset_new(q0, r0, wq, hr);
  np = marks_label(w, q0, r0, wq, hr, 0.0, cl, ed);
  home: vector<integer> = [];
  for i in 0..np { home += [0 - 2]; }
  bad = false;
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      for d in [4, 5, 0] {
        (nq, nr) = hex_grid::hex_neighbor(q, r, d);
        pv = edge_mat(ed, q, r, nq, nr);
        if pv == 0 { continue; }
        c = label_get(lb, q, r);
        if (home[pv - 1] ?? 0 - 2) == 0 - 2 { home[pv - 1] = c; }
        else if (home[pv - 1] ?? 0 - 2) != c { bad = true; }
      }
    }
  }
  bad
}

fn test_a_piece_never_crosses_a_cell_component() {
  v = flat_world();
  house_at(v, 0.0, 0.0);
  tower_at(v, 0.0, 0.0 - 12.0);
  wall_at(v, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  assert(!crosses(v, 0 - 12, 0 - 16, 25, 26), "a piece of the village crosses two cell components");
  d = flat_world();
  house_at(d, 0.0, 0.0);
  wall_at(d, 4.0, 0.0, 12.0, 0.0);
  assert(!crosses(d, 0 - 12, 0 - 12, 30, 26), "a piece of the attached pair crosses two");
}

// ── ✅ AND SHARING A VERTEX IS DESCRIBED NOW — plan 26 `B4v` ─────────────
//
// A wall that MEETS a tower's rim shares vertices with it, so no flood separates them —
// `B4u`'s honest residual, and it drew the wall and counted the rim's 52 marks. The
// component is partitioned by what a candidate ACCOUNTS FOR instead: each shape's own
// boundary must lie WITHIN the component's marks, and the set is taken only when it
// claims every one of them and nothing outside.
fn test_a_wall_meeting_a_rim_is_a_run_and_a_disc() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 8.0, 0.0 - 6.0, 8.0, 6.0);
  ed = edgeset_new(0 - 14, 0 - 14, 34, 30);
  np = marks_label(w, 0 - 14, 0 - 14, 34, 30, 0.0, claims_new(0 - 14, 0 - 14, 34, 30), ed);
  assert(np == 1,
         "the wall and the rim are {np} pieces, so they do not share a vertex and this "
       + "row is about nothing");
  cl = claims_new(0 - 14, 0 - 14, 34, 30);
  got = peel(w, 0 - 14, 0 - 14, 34, 30, cl);
  assert(got == "run;disc;", "a wall meeting a rim describes `{got}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 14, 34, 30, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 14, 0 - 14, 34, 30, 0.0, cl)} marks over — `B4u` left 52");

  // …and the control, one cell further out: no shared vertex, both described
  c = flat_world();
  tower_at(c, 0.0, 0.0);
  wall_at(c, 10.0, 0.0 - 6.0, 10.0, 6.0);
  ccl = claims_new(0 - 14, 0 - 14, 34, 30);
  assert(peel(c, 0 - 14, 0 - 14, 34, 30, ccl) == "disc;run;",
         "the same pair clear of each other describes "
       + "`{peel(c, 0 - 14, 0 - 14, 34, 30, claims_new(0 - 14, 0 - 14, 34, 30))}`");
  assert(marks_unclaimed(c, 0 - 14, 0 - 14, 34, 30, 0.0, ccl) == 0, "marks over");
}

// ⛔ **AND THE HOUSE'S OWN RESIDUAL STOPS COUNTING ITS NEIGHBOUR'S MARKS — plan 26
// `B4u`.** `B4o` bounded `stray` to `house_owns` — the mitre's own one-cell reach — and
// asked for exactly this control with the other structure **eight** hexes away. At ONE
// cell the bound is not enough: a tower's rim reaches inside it, and the caption read
// `11 stray` about a house whose mitre is four marks. The claim set already says whose
// those marks are, which is what the split made true.
fn test_the_mitre_count_is_unmoved_by_a_tower_one_cell_away() {
  lone = flat_world();
  house_at(lone, 0.0, 0.0);
  alone = house_recover(lone, 0 - 14, 0 - 16, 30, 30, 0.0);
  assert(alone.hs_ok, "the lone house did not recover: {alone.hs_why}");

  w = flat_world();
  house_at(w, 0.0, 0.0);
  tower_at(w, 0.0, 0.0 - 7.0);
  assert(touching(w, 0 - 14, 0 - 16, 30, 30) == 1,
         "the pair is not one cell component, so this row is about nothing");
  sg = segments_of(w, 0 - 14, 0 - 16, 30, 30, 0.0, claims_new(0 - 14, 0 - 16, 30, 30));
  // ⚠ **EVERY COMPONENT THE HOUSE READER ANSWERS FOR, NOT ONE THAT MATCHES.** An
  // existence check would pass on a chain that got it right somewhere and wrong here.
  asked = 0;
  for id in 0..segment_count(sg) {
    only = segment_claims(claims_new(0 - 14, 0 - 16, 30, 30), w, 0 - 14, 0 - 16, 30, 30,
                          0.0, sg, id);
    if disc_recover_claimed(w, 0 - 14, 0 - 16, 30, 30, 0.0, only).dc_ok { continue; }
    h = house_recover_claimed(w, 0 - 14, 0 - 16, 30, 30, 0.0, only);
    if !h.hs_ok { continue; }
    asked = asked + 1;
    assert(h.hs_stray == alone.hs_stray,
           "the house reports {h.hs_stray} stray marks beside a tower and "
         + "{alone.hs_stray} alone — the rim is being counted as its corner over-run");
  }
  assert(asked > 0, "the house reader answered for no component at all");
}

// ⛔ **AND A COMPONENT IS HANDED ITS OWN CELL COMPONENT'S FLOOR, NOTHING ELSE.** The
// sweep asked for this the hard way: a row that gave every piece cell component 0 went
// **GREEN** across both suites, because in every fixture above either everything stands
// in one cell component or the round readers answer before the house reader is reached.
// ⚠ **What that row would break is `B4o`'s rule, one layer down** — a piece nothing
// explains would reach the house reader, be answered with somebody else's rectangle, and
// carry a residual measured over marks that are not the house's. So the property is
// asserted directly rather than through a caption that cannot see it.
fn test_a_component_is_handed_only_its_own_floor() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  // …and a two-cell domino's boundary, far enough to be its own cell component
  for d0 in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(0 - 14, 0 - 10, d0);
    if !(nq == 0 - 13 && nr == 0 - 10) { wall_set(w, 0 - 14, 0 - 10, d0, WALL_MAT, 8, 2.0); }
  }
  for d1 in 0..6 {
    (mq, mr) = hex_grid::hex_neighbor(0 - 13, 0 - 10, d1);
    if !(mq == 0 - 14 && mr == 0 - 10) { wall_set(w, 0 - 13, 0 - 10, d1, WALL_MAT, 8, 2.0); }
  }
  q0 = 0 - 20; r0 = 0 - 16; wq = 34; hr = 30;
  assert(touching(w, q0, r0, wq, hr) == 2,
         "the house and the domino are {touching(w, q0, r0, wq, hr)} cell components, "
       + "not two — this row needs them apart");
  cl = claims_new(q0, r0, wq, hr);
  sg = segments_of(w, q0, r0, wq, hr, 0.0, cl);
  answered = 0;
  for id in 0..segment_count(sg) {
    only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, id);
    if house_recover_claimed(w, q0, r0, wq, hr, 0.0, only).hs_ok { answered = answered + 1; }
  }
  assert(answered == 1,
         "the house reader answers for {answered} of the {segment_count(sg)} components — "
       + "a piece is being handed a floor that stands in another component");
}

// ── ✅ TWO RIMS THAT MEET, AND WHAT THE UNION TEST REFUSES — plan 26 `B4v` ─
//
// ⛔ **`B4u` REFUSED THIS WITH ALL 106 MARKS COUNTED**, and correctly: neither rim is the
// whole component's boundary, so the both-ways fit each round reader makes could not
// accept either. A SET of them can, and R1 moves up one level to the union.
fn test_two_rims_that_meet_are_two_discs() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  tower_at(w, 13.0, 0.0);
  ed = edgeset_new(0 - 14, 0 - 14, 44, 30);
  np = marks_label(w, 0 - 14, 0 - 14, 44, 30, 0.0, claims_new(0 - 14, 0 - 14, 44, 30), ed);
  assert(np == 1,
         "the two rims are {np} pieces, so they do not share a vertex and `B4u` already "
       + "describes them — this row is about nothing");
  cl = claims_new(0 - 14, 0 - 14, 44, 30);
  got = peel(w, 0 - 14, 0 - 14, 44, 30, cl);
  assert(got == "disc;disc;", "two rims that meet describe `{got}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 14, 44, 30, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 14, 0 - 14, 44, 30, 0.0, cl)} marks over");
}

// ⛔ **AND WHAT NO SET CLOSES OVER IS STILL REFUSED.** Two walls crossing at a vertex are
// one component with four chain ends and no rim in them, so nothing is drawn and every
// mark is counted — exactly what `B4u` did. ⚠ **Without this row the relaxation could
// have shipped a chain that answers for anything**, which is what a one-directional fit
// does on its own.
fn test_two_walls_crossing_are_still_refused() {
  w = flat_world();
  wall_at(w, 0.0 - 6.0, 0.0, 6.0, 0.0);
  wall_at(w, 0.0, 0.0 - 6.0, 0.0, 6.0);
  assert(touching(w, 0 - 14, 0 - 14, 30, 30) == 1, "the crossing is not one component");
  cl = claims_new(0 - 14, 0 - 14, 30, 30);
  got = peel(w, 0 - 14, 0 - 14, 30, 30, cl);
  assert(got == "", "a crossing no set of shapes closes over described `{got}`");
  assert(marks_unclaimed(w, 0 - 14, 0 - 14, 30, 30, 0.0, cl)
         == marks_unclaimed(w, 0 - 14, 0 - 14, 30, 30, 0.0,
                            claims_new(0 - 14, 0 - 14, 30, 30)),
         "a refused trial left claims behind — it must run on a COPY, or the marks the "
       + "refusal exists to count are silenced by it");
}

// ── ⚠ THE ACCEPTANCE IS ONE NUMBER AND IT IS TWO-DIRECTIONAL ──────────────
//
// ⛔ **TOO FEW CLAIMS AND THE COMPONENT IS NOT EXPLAINED; TOO MANY AND THE TRIAL REACHED
// INTO A NEIGHBOUR** — `B4o`'s defect, which a count of the component alone cannot see.
// Both are `after == before - mine`, measured here from either side on one field.
fn test_the_union_test_refuses_a_trial_that_reaches_outside() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 0.0 - 20.0, 0.0 - 6.0, 0.0 - 20.0, 6.0);
  q0 = 0 - 26; r0 = 0 - 16; wq = 44; hr = 34;
  cl = claims_new(q0, r0, wq, hr);
  sg = segments_of(w, q0, r0, wq, hr, 0.0, cl);
  assert(segment_count(sg) == 2,
         "the tower and the far wall are {segment_count(sg)} components, not two");
  before = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
  // the tower's own component
  tid = 0 - 1;
  for id in 0..segment_count(sg) {
    only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, id);
    if disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only).dc_ok { tid = id; }
  }
  assert(tid >= 0, "no component recovers as a disc — the fixture is not what this needs");
  only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, tid);
  mine = marks_unclaimed(w, q0, r0, wq, hr, 0.0, only);
  d = disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only);

  // …the rim alone: exactly its own component, and the number accepts
  right = claims_copy(cl, q0, r0, wq, hr);
  claim_disc(right, d.dc_cq, d.dc_cr, d.dc_shell, q0, r0, wq, hr);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, right) == before - mine,
         "the rim alone does not satisfy the acceptance — the number cannot say yes");

  // …and the rim PLUS the far wall: the component is explained and a neighbour is not
  // its business, so the same number must refuse
  wide = claims_copy(cl, q0, r0, wq, hr);
  claim_disc(wide, d.dc_cq, d.dc_cr, d.dc_shell, q0, r0, wq, hr);
  claim_run(wide, 0.0 - 20.0, 0.0 - 6.0, 0.0 - 20.0, 6.0, q0, r0, wq, hr);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, wide) != before - mine,
         "a trial that claimed a NEIGHBOUR's marks as well is accepted — the number is "
       + "one-directional and cannot see it");
}

// ⛔ **A CANDIDATE THAT ACCOUNTS FOR NOTHING NEW IS THE PASS'S ONLY TERMINATION
// ARGUMENT.** A rim already claimed still lies within the marks and would be returned for
// ever, so `disc_within` has to ask before it answers rather than after.
fn test_a_within_candidate_already_claimed_is_not_offered_again() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  q0 = 0 - 10; r0 = 0 - 10; wq = 21; hr = 21;
  base = claims_new(q0, r0, wq, hr);
  first = disc_within(w, q0, r0, wq, hr, 0.0, base, claims_new(q0, r0, wq, hr));
  assert(first.dc_ok, "the rim is not within its own marks: {first.dc_why}");
  taken = claims_new(q0, r0, wq, hr);
  claim_disc(taken, first.dc_cq, first.dc_cr, first.dc_shell, q0, r0, wq, hr);
  again = disc_within(w, q0, r0, wq, hr, 0.0, base, taken);
  assert(!again.dc_ok,
         "the same rim is offered a second time as {again.dc_cq},{again.dc_cr} shell "
       + "{again.dc_shell} — the pass would never end");
}

// ⛔ **AND THE ADMITTED SET IS THE GESTURE'S, WHICH ONLY THE RELAXED READER NEEDS.**
// Measured: a shell-**0** disc — one cell's six edges — lies inside the marks of a wall
// meeting a rim, and `disc_recover`'s equality could never reach it. `fit_shell` is what
// says no tower is that small, and without it the picture draws a circle of no radius
// over a cell that is part of two other structures.
fn test_the_relaxed_reader_admits_only_shells_a_tower_can_be() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 8.0, 0.0 - 6.0, 8.0, 6.0);
  q0 = 0 - 14; r0 = 0 - 14; wq = 34; hr = 30;
  base = claims_new(q0, r0, wq, hr);
  cl = claims_new(q0, r0, wq, hr);
  // walk every disc the reader will offer, and none may be a shell no tower can be
  for i in 0..6 {
    d = disc_within(w, q0, r0, wq, hr, 0.0, base, cl);
    if !d.dc_ok { break; }
    assert(fit_shell(d.dc_shell).ft_ok,
           "the relaxed reader offered shell {d.dc_shell}, which `fit_shell` refuses — "
         + "no gesture can build it and no field is it");
    if claim_disc(cl, d.dc_cq, d.dc_cr, d.dc_shell, q0, r0, wq, hr) == 0 { break; }
  }
}

// ⛔ **AND A SET THAT EXPLAINS PART OF ITS COMPONENT IS REFUSED, WITH THE MARKS
// COUNTED.** A tower whose rim a **T** of two walls meets is one component; the trial
// finds the rim, and what is left is three chain ends that no run and no disc answers
// for. ⚠ **This is the row the ACCEPTANCE side is measured by** — the crossed walls above
// refuse because the trial finds nothing at all, which says nothing about what happens
// when it finds something. Without both, a pass that drew a right shape over a field it
// does not account for would ship as a picture with a silent leftover, which is exactly
// what `B4p` spent a step removing.
fn test_a_set_that_explains_only_part_of_its_component_is_refused() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 8.0, 0.0 - 6.0, 8.0, 6.0);
  wall_at(w, 8.0, 0.0, 16.0, 0.0);
  q0 = 0 - 16; r0 = 0 - 16; wq = 40; hr = 33;
  ed = edgeset_new(q0, r0, wq, hr);
  assert(marks_label(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr), ed) == 1,
         "the tower and the T are not one component, so this row is about nothing");
  all = marks_unclaimed(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr));
  cl = claims_new(q0, r0, wq, hr);
  got = peel(w, q0, r0, wq, hr, cl);
  assert(got == "",
         "a component the trial explains only part of was described as `{got}` — the "
       + "union test accepted a set that does not account for it");
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl) == all,
         "the refused trial left claims behind — it must run on a COPY, or the marks the "
       + "refusal exists to count are silenced by it");
}
