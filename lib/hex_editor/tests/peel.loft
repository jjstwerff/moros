// EVERY STRUCTURE IN A WINDOW, BY PEELING — plan 26 `B4s`.
//
// ⛔ **A WINDOW HELD TWO DESCRIPTIONS AND EVERY REAL SCENE HOLDS MORE.** `B4o` split a
// house's marks from a wall's; `B4p` gave that leftover the whole chain. Both took out
// exactly ONE structure, because the exclusion was a `Box` — so a window with three
// things in it described two and dropped the third in silence.
//
// ⚠ **WHAT MADE THE LOOP POSSIBLE IS `run_edges`.** Every other shape could always say
// what it owns: a disc's boundary walk, an octagon's `poly_holds`, a rectangle's
// `house_owns`. The RUN could not be asked at all until `B4q` extracted the stamper's
// rule, and its answer was not stable until `B4r` — a peel built before either would
// have subtracted the wrong edges on five headings in ten.
//
// ── ✅ IT WAS THIRTY-ONE TESTS AND NOT ONE, AND THE WINDOWS WERE PAYING FOR IT ──
//
// **The question this header used to carry is answered — measured 2026-08-31, one process
// per test, `loft test tests/peel.loft::<name>` for each of the 31, with the overhead taken
// rather than assumed (a run naming a test that does not exist compiles everything and runs
// nothing: 1.8 s).** It is NOT `planview.loft`'s shape. That file was **88% one test**;
// here the worst is `test_two_walls_that_cross_are_two_runs` at **32 s — 21%**, and the top
// five are 51%. **No single cut was worth taking**, so the answer had to be something every
// test shared.
//
// ⚠ **IT WAS THE WINDOW, AND THE RATIO IS WORSE THAN THE ONE THAT MADE `planview` WORTH
// FIXING.** Asked of the STORE rather than of the test, every fixture's marks sat inside a
// box **8 … 19× smaller than the window scanned around it** — 1369 cells around a field of
// 72. `claims_new`, `marks_unclaimed`, `segments_of`, `touched_cells` and `claims_adopt`
// are each `O(window)` and the peel calls them per component per round, so the empty margin
// was most of the file.
//
// | interleaved A-B-B-A, one machine state | | load |
// |---|---|---|
// | the 37 × 37 windows | 211.5 s · 210.2 s | 79 · 64 |
// | ✅ the field's own extent plus two | **71.7 s · 82.1 s** | 55 · 32 |
//
// **2.7×, and 70% of the deadline down to 26%.** ⚠ The two WIDE rows agree to 0.6% across a
// fifteen-point load swing, which is what says the clock is answering about the file here.
// ⛔ **And they also correct this header's own previous claim.** It read *"173 s idle, 174 s
// at load 25, 180 s at load 52 — the answer barely moves with the machine"*, true over the
// range it sampled and **not** past it: at the loads this shared box actually reaches the
// same file was 211 s. *58% of the budget* was the quiet-afternoon number.
//
// ✅ **EVERY WINDOW IS THE FIELD'S OWN EXTENT PLUS TWO NOW**, taken from the store, and
// `field_is` asserts the mark total exactly beside each one. ⛔ **That assertion is not
// decoration**: a clipped window is a DIFFERENT FIELD, not a smaller picture, and
// `marks_unclaimed(…) == 0` after a peel passes just as well over a field that has lost a
// third of itself — [`probe/tw`](../../../probe/tw/README.md) measured exactly that.
//
// ⚠ **AND THE CONTROL CAME BEFORE THE CHANGE, WHICH IS WHAT MAKES THE NUMBERS MEAN
// ANYTHING.** Twenty-seven fixtures were peeled at BOTH windows in one process and compared
// on four counts — the mark total, the cell components, the mark components and the
// description string. **All twenty-seven identical.** A green suite after a window is shrunk
// is not evidence of anything; two windows agreeing about one field is.
use hex_editor;
use hex_voxel;
use hex_shape;
use hex_grid;

const YAW = 1.5707963267948966;
const U = 0.25;

fn flat_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  ground_fill(w, 0 - 30, 0 - 30, 61, 61, 8, SURFACE_MAT);
  w
}

fn house_at(w: VoxelWorld, x: float, z: float) {
  s = EditSession {};
  session_at(s, w, x, z, YAW);
  assert(press_verb(s, w, s.es_author, VB_PLACE, "").ak_ok, "the fixture's house was refused");
}

fn tower_at(w: VoxelWorld, x: float, z: float) {
  s = EditSession {};
  session_at(s, w, x, z, 0.0);
  assert(press_verb(s, w, s.es_author, VB_TOWER, "").ak_ok, "the fixture's tower was refused");
}

fn wall_at(w: VoxelWorld, x0: float, z0: float, x1: float, z1: float) {
  d = run_between(x0, z0, x1, z1, WALL_MAT);
  assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
  rs = WallRuns { items: [] };
  m = 0;
  wall_stamp(w, d.rd_run, WALL_MAT, 8, rs, m);
  assert(m > 0, "the fixture's wall stamped nothing");
}

// The chain, peeled over COMPONENTS — the same order and the same readers `plan_panel`
// asks, written out here so the LIBRARY's half can be tested without a picture.
//
// ⚠ **THE FIELD IS SPLIT FIRST — plan 26 `B4t`.** A component is asked about by CLAIMING
// everything else, so every reader keeps the signature it had and `FORMAL_CORE` §6's R1
// keeps comparing over a field that is entirely one structure's.
// ⛔ **AND A COMPONENT NO ONE READER EXPLAINS GETS A SET OF THEM — plan 26 `B4v`.**
// Each shape's own boundary must lie WITHIN the component's marks, and the set is taken
// only when it claims every one of them and nothing outside — one integer, both
// directions. ⚠ **The trial runs on a copy**, so a rejected one leaves nothing behind:
// its claims would otherwise silence the marks the refusal exists to count.
fn trial(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer, base: Claims,
         sg: Segments, id: integer, before: integer, mine: integer) -> text {
  sc = claims_copy(base, q0, r0, wq, hr);
  within = segment_claims(base, w, q0, r0, wq, hr, 0.0, sg, id);
  got = "";
  // ⚠ **SIXTEEN, NOT EIGHT — plan 26 `B4x`.** The greedy chain cut describes a four-wall
  // room in 4…9 runs depending on where its walk started, so a cap of eight would turn a
  // measured worst case into a silent truncation.
  for t in 0..16 {
    rest = segment_claims(sc, w, q0, r0, wq, hr, 0.0, sg, id);
    rr = wall_recover_claimed(w, q0, r0, wq, hr, 0.0, rest);
    // ⚠ `missing == 0` IS THE *WITHIN* TEST FOR A RUN, in the number `RunRead` has
    // carried since `B4q`: edges it generates that the store does not hold.
    if rr.rr_ok && rr.rr_missing == 0
       && claim_run(sc, rr.rr_x0, rr.rr_z0, rr.rr_x1, rr.rr_z1, q0, r0, wq, hr) > 0 {
      got = got + "run;";
      continue;
    }
    dw = disc_within(w, q0, r0, wq, hr, 0.0, within, sc);
    if dw.dc_ok && claim_disc(sc, dw.dc_cq, dw.dc_cr, dw.dc_shell, q0, r0, wq, hr) > 0 {
      got = got + "disc;";
      continue;
    }
    hh = house_recover_claimed(w, q0, r0, wq, hr, 0.0, rest);
    if hh.hs_ok {
      hb = hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep, hh.hs_rot, false);
      if claim_house(sc, hb, q0, r0, wq, hr) > 0 { got = got + "house;"; continue; }
    }
    // ⚠ **LAST — plan 26 `B4w`.** A run whose endpoints are the component's own ends and
    // junctions is the weakest question here, so it is asked only where every stronger
    // one has given up: a house's marks hold pool corners too, and the house reader must
    // reach its floor first.
    rw = run_within(w, q0, r0, wq, hr, 0.0, within, sc);
    if rw.rr_ok
       && claim_run(sc, rw.rr_x0, rw.rr_z0, rw.rr_x1, rw.rr_z1, q0, r0, wq, hr) > 0 {
      got = got + "run;";
      continue;
    }
    // ⛔ **AND LAST OF ALL, THE CHAIN — plan 26 `B4x`.** `corner_pool` admits a chain END
    // or a JUNCTION, and a wall that TURNS gives neither: a closed room fuses at every
    // corner, so the pool is empty and the reader above is handed nothing to offer. This
    // one cuts the walk into spans instead. Weakest and last, for the same reason
    // `run_within` is next-to-last.
    rc = run_chain_within(w, q0, r0, wq, hr, 0.0, within, sc);
    if rc.rr_ok
       && claim_run(sc, rc.rr_x0, rc.rr_z0, rc.rr_x1, rc.rr_z1, q0, r0, wq, hr) > 0 {
      got = got + "run;";
      continue;
    }
    break;
  }
  if got == "" { return ""; }
  if marks_unclaimed(w, q0, r0, wq, hr, 0.0, sc) != before - mine { return ""; }
  // …accepted: the copy becomes the answer
  claims_adopt(base, sc, q0, r0, wq, hr);
  got
}

// The trial's claims, moved onto the real set once it has been accepted.
fn claims_adopt(dst: Claims, src: Claims, q0: integer, r0: integer, wq: integer,
                hr: integer) {
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      if hexset_get(src.cl_cells, q, r) { hexset_set(dst.cl_cells, q, r, true); }
      for d in [4, 5, 0] {
        (nq, nr) = hex_grid::hex_neighbor(q, r, d);
        if edge_mat(src.cl_edges, q, r, nq, nr) != 0 {
          edge_set_mat(dst.cl_edges, q, r, nq, nr, 1);
        }
      }
    }
  }
}

// ── ⚠ A TIGHT WINDOW NEEDS AN EXACT COUNT, OR IT CLIPS IN SILENCE ─────────
//
// Every window in this file is the field's own extent plus a margin of two, measured from
// the STORE rather than chosen by shrinking until something goes red — `probe/tw`'s
// method, and the reason it is not optional here: **`marks_unclaimed(…) == 0` after a peel
// passes just as well over a field that has lost a third of itself.** A clipped window is
// a different field, not a smaller picture, so the total is asserted BEFORE the peel and
// the description is asserted after. Both, or neither says anything.
fn field_is(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer,
            marks: integer) -> integer {
  all = marks_unclaimed(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr));
  assert(all == marks,
         "the window {q0},{r0} {wq}x{hr} holds {all} marks, not the {marks} this row was "
       + "measured on — it clips the field");
  all
}

fn peel(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer,
        cl: Claims) -> text {
  out = "";
  part = false;
  for i in 0..8 {
    sg = segments_of(w, q0, r0, wq, hr, 0.0, cl);
    if segment_count(sg) == 0 { return out; }
    told = out;
    for id in 0..segment_count(sg) {
      only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, id);
      before = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
      mine = marks_unclaimed(w, q0, r0, wq, hr, 0.0, only);
      rr = wall_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
      // ⛔ **THE TRIAL IS ASKED WHERE ONE READER CANNOT ACCOUNT FOR THE COMPONENT** —
      // either because it refused, or because it answered while being handed marks it
      // does not want, which is `rr_stray` for a run and `hs_other` for a house.
      short = rr.rr_ok && rr.rr_stray > 0;
      if !rr.rr_ok {
        dq = disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
        hq = house_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
        short = !dq.dc_ok && (!hq.hs_ok || hq.hs_other > 0);
      }
      if short {
        t = trial(w, q0, r0, wq, hr, cl, sg, id, before, mine);
        if t != "" { out = out + t; continue; }
      }
      if rr.rr_ok {
        out = out + "run;";
        if claim_run(cl, rr.rr_x0, rr.rr_z0, rr.rr_x1, rr.rr_z1, q0, r0, wq, hr) == 0 {
          return out + "STUCK;";
        }
        if segment_marks_left(w, q0, r0, wq, hr, 0.0, cl, sg, id) > 0 { part = true; }
        continue;
      }
      dc = disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
      if dc.dc_ok {
        out = out + "disc;";
        if claim_disc(cl, dc.dc_cq, dc.dc_cr, dc.dc_shell, q0, r0, wq, hr) == 0 {
          return out + "STUCK;";
        }
        if segment_marks_left(w, q0, r0, wq, hr, 0.0, cl, sg, id) > 0 { part = true; }
        continue;
      }
      hh = house_recover_claimed(w, q0, r0, wq, hr, 0.0, only);
      if hh.hs_ok {
        out = out + "house;";
        hb = hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep, hh.hs_rot, false);
        if claim_house(cl, hb, q0, r0, wq, hr) == 0 { return out + "STUCK;"; }
        if segment_marks_left(w, q0, r0, wq, hr, 0.0, cl, sg, id) > 0 { part = true; }
        continue;
      }
    }
    // ⚠ A ROUND THAT DESCRIBED NOTHING ENDS IT, whatever is left: peeling one structure
    // can SPLIT what remains, which is why the labels are rebuilt each round — but a
    // round with no answer will not produce one next time either.
    // ⛔ AND SO DOES A DESCRIPTION THAT EXPLAINED ONLY PART OF ITS OWN COMPONENT — plan
    // 26 `B4u`. Re-splitting a structure somebody else's claim broke in half is where
    // the false runs come from; the fragments are counted, not described.
    if out == told || part { return out; }
  }
  out + "CAPPED;"
}

// ── ⛔ THE ROW `B4p` MEASURED THE OTHER WAY ────────────────────────────────
//
// `B4p` pinned this scene as the limitation: *"a closed rim contributes no ends, so
// `wall_read_run` sees exactly the wall's two and answers for the wall — correctly, and
// with 54 of the tower's marks unmentioned."* The wall is still described first. The
// difference is that its marks are then taken out, and what is left IS a disc.
fn test_a_house_a_tower_and_a_wall_are_all_three_described() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  tower_at(w, 0.0, 0.0 - 12.0);
  wall_at(w, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  cl = claims_new(0 - 9, 0 - 15, 16, 25);
  field_is(w, 0 - 9, 0 - 15, 16, 25, 107);
  got = peel(w, 0 - 9, 0 - 15, 16, 25, cl);
  // ⚠ **THE ORDER IS THE LABEL SCAN'S, NOT THE CHAIN'S — plan 26 `B4t`.** Components are
  // visited as the window is read, row by row, so the tower at `r = -8` comes before the
  // house at `r = 4`. Deterministic either way, and a row asserting the chain's order
  // would be asserting where the fixture happens to stand.
  assert(got == "disc;run;house;",
         "the peel described `{got}`, not a disc, a run and a house");
  // ⚠ **AND NOTHING IS LEFT OVER**, which is the claim that says the three descriptions
  // account for the field rather than merely being three answers.
  left = marks_unclaimed(w, 0 - 9, 0 - 15, 16, 25, 0.0, cl);
  assert(left == 0, "{left} marks are explained by none of the three");
}

// ── THE FLOOR CHANNEL IS WHAT ENDS THE LOOP ───────────────────────────────
//
// ⛔ **EVERY OTHER READER IS SUBTRACTED BY TAKING ITS MARKS AWAY, AND THE HOUSE READER
// NEVER LOOKS AT A MARK.** `B4n`'s finding — the rectangle comes from the FLOOR — is
// what makes it able to describe a house at all, and it is exactly why claiming edges
// cannot silence it. Without the cell channel the peel does not give a wrong answer; it
// gives the same right one for ever.
fn test_claiming_a_houses_marks_is_not_what_silences_it() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  h = house_recover(w, 0 - 10, 0 - 10, 21, 21, 0.0);
  assert(h.hs_ok, "no rectangle: {h.hs_why}");
  b = hex_shape::box_new(h.hs_cq, h.hs_cr, h.hs_wid, h.hs_dep, h.hs_rot, false);

  // ⚠ EDGES ONLY — a run straight through the house takes several of its marks out.
  // The reader must be unmoved, because it never reads them.
  edges = claims_new(0 - 10, 0 - 10, 21, 21);
  before = marks_unclaimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, edges);
  claim_run(edges, 0.0 - 9.0, 3.0, 9.0, 3.0, 0 - 10, 0 - 10, 21, 21);
  after = marks_unclaimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, edges);
  assert(after < before,
         "the fixture claimed none of the house's {before} marks, so this row proves "
       + "nothing about the edge channel");
  e = house_recover_claimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, edges);
  assert(e.hs_ok && e.hs_cq == h.hs_cq && e.hs_cr == h.hs_cr && e.hs_wid == h.hs_wid
         && e.hs_dep == h.hs_dep,
         "a house with some of its MARKS claimed reads back as a different rectangle — "
       + "the reader has started reading them, and `B4n`'s finding wants re-measuring");

  // …and with its floor accounted for, it is silent
  cells = claims_new(0 - 10, 0 - 10, 21, 21);
  claim_house(cells, b, 0 - 10, 0 - 10, 21, 21);
  assert(!house_recover_claimed(w, 0 - 10, 0 - 10, 21, 21, 0.0, cells).hs_ok,
         "a house whose own floor is accounted for is described a second time — the "
       + "peel would answer it for ever");
}

// ⚠ **A CLAIM IS IDEMPOTENT AND SAYS WHETHER IT WAS NEW**, which is what lets the peel
// notice a reader that answers without accounting for anything. Without it the loop's
// only bound is the cap, and a cap is not a termination argument.
fn test_a_claim_is_idempotent_and_reports_only_what_was_new() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  d = disc_recover(w, 0 - 10, 0 - 10, 21, 21, 0.0);
  assert(d.dc_ok, "the fixture's tower did not recover: {d.dc_why}");
  cl = claims_new(0 - 10, 0 - 10, 21, 21);
  first = claim_disc(cl, d.dc_cq, d.dc_cr, d.dc_shell, 0 - 10, 0 - 10, 21, 21);
  again = claim_disc(cl, d.dc_cq, d.dc_cr, d.dc_shell, 0 - 10, 0 - 10, 21, 21);
  assert(first > 0, "claiming a disc's boundary claimed nothing");
  assert(again == 0, "claiming it twice claimed {again} more");
}

// ⛔ **WHAT A SHAPE OWNS MUST OVERLAP WHAT IT EXPLAINED**, or the peel would subtract
// somebody else's marks — which is `B4o`'s defect with the sign flipped. Measured
// against the reader's own count rather than against the claim: two numbers from
// opposite sides.
fn test_each_shape_accounts_for_the_marks_it_was_recovered_from() {
  // a disc
  dw = flat_world();
  tower_at(dw, 0.0, 0.0);
  dd = disc_recover(dw, 0 - 10, 0 - 10, 21, 21, 0.0);
  dcl = claims_new(0 - 10, 0 - 10, 21, 21);
  claim_disc(dcl, dd.dc_cq, dd.dc_cr, dd.dc_shell, 0 - 10, 0 - 10, 21, 21);
  assert(marks_unclaimed(dw, 0 - 10, 0 - 10, 21, 21, 0.0, dcl) == 0,
         "a disc leaves {marks_unclaimed(dw, 0 - 10, 0 - 10, 21, 21, 0.0, dcl)} of its "
       + "own {dd.dc_marks} marks unaccounted for");

  // a run
  rw = flat_world();
  wall_at(rw, 0.0 - 9.0, 0.0, 6.0, 0.0);
  rr = wall_recover(rw, 0 - 14, 0 - 14, 29, 29, 0.0);
  assert(rr.rr_ok, "the fixture's wall did not recover");
  rcl = claims_new(0 - 14, 0 - 14, 29, 29);
  claim_run(rcl, rr.rr_x0, rr.rr_z0, rr.rr_x1, rr.rr_z1, 0 - 14, 0 - 14, 29, 29);
  assert(marks_unclaimed(rw, 0 - 14, 0 - 14, 29, 29, 0.0, rcl) == 0,
         "a run leaves {marks_unclaimed(rw, 0 - 14, 0 - 14, 29, 29, 0.0, rcl)} of its "
       + "own {rr.rr_marks} marks unaccounted for");

  // a house — its boundary AND the mitre one cell past it
  hw = flat_world();
  house_at(hw, 0.0, 0.0);
  hh = house_recover(hw, 0 - 10, 0 - 10, 21, 21, 0.0);
  hcl = claims_new(0 - 10, 0 - 10, 21, 21);
  claim_house(hcl, hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep,
                                      hh.hs_rot, false), 0 - 10, 0 - 10, 21, 21);
  assert(marks_unclaimed(hw, 0 - 10, 0 - 10, 21, 21, 0.0, hcl) == 0,
         "a house leaves {marks_unclaimed(hw, 0 - 10, 0 - 10, 21, 21, 0.0, hcl)} marks "
       + "unaccounted for — including its mitre, which `B4o` measured it owns");
}

// ── ✅ AND TWO OF A KIND, WHICH THE PEEL ALONE COULD NOT — plan 26 `B4t` ──
//
// ⛔ **`B4s` MEASURED THESE AS THE LIMITATION**: two houses described nothing with 84
// marks left, two walls nothing with 23, a house and two towers only the house with 108.
// The peel subtracts what has been DESCRIBED and nothing had been, because `disc_fits`
// and `box_fits` compare over the whole field in BOTH directions — *every boundary edge
// is marked AND every mark is a boundary edge* — which is exactly what stops a disc being
// accepted with a wall drawn across it.
//
// ✅ **SPLITTING THE FIELD FIRST LEAVES THAT CHECK UNTOUCHED**, because each reader is
// then handed a field that is entirely one structure's.
fn test_two_of_a_kind_are_each_described() {
  hw = flat_world();
  house_at(hw, 0.0, 0.0);
  house_at(hw, 0.0 - 16.0, 0.0);
  hcl = claims_new(0 - 15, 0 - 2, 21, 12);
  field_is(hw, 0 - 15, 0 - 2, 21, 12, 84);
  assert(peel(hw, 0 - 15, 0 - 2, 21, 12, hcl) == "house;house;",
         "two houses describe `{peel(hw, 0 - 15, 0 - 2, 21, 12, claims_new(0 - 15, 0 - 2, 21, 12))}`");
  assert(marks_unclaimed(hw, 0 - 15, 0 - 2, 21, 12, 0.0, hcl) == 0,
         "two described houses leave "
       + "{marks_unclaimed(hw, 0 - 15, 0 - 2, 21, 12, 0.0, hcl)} marks over");

  ww = flat_world();
  wall_at(ww, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  wall_at(ww, 6.0, 0.0 - 3.0, 6.0, 6.0);
  wcl = claims_new(0 - 9, 0 - 4, 16, 11);
  field_is(ww, 0 - 9, 0 - 4, 16, 11, 23);
  assert(peel(ww, 0 - 9, 0 - 4, 16, 11, wcl) == "run;run;",
         "two walls describe `{peel(ww, 0 - 9, 0 - 4, 16, 11, claims_new(0 - 9, 0 - 4, 16, 11))}`");
  assert(marks_unclaimed(ww, 0 - 9, 0 - 4, 16, 11, 0.0, wcl) == 0,
         "two described walls leave marks over");
}

// ── ⛔ AND WHAT STILL REFUSES, WHICH IS THE POINT OF NOT SOFTENING R1 ──────
//
// ⚠ **A SPLIT IS NOT A LICENCE TO ANSWER.** The boundary of a two-cell domino is one
// component and every reader gives up on it: no chain ends for the run reader, no disc
// reproduces it, no floor for the house reader. ⚠ **Without this row the step could have
// shipped a chain that answered for anything** — which is what softening the both-ways
// comparison would have bought, and the reason it was not touched.
fn test_a_closed_outline_no_round_reader_explains_is_cut_into_runs() {
  // ⚠ **THIS ROW ASSERTED A REFUSAL UNTIL `B4x`, AND THE BOUNDARY MOVED ON PURPOSE.** A
  // two-cell domino's outline is a closed loop of straight stretches that no round reader
  // reproduces, so the peel drew nothing and counted all ten marks. The chain cut covers it
  // exactly — three runs, nothing over — and an exact cover is the acceptance `FORMAL_CORE`
  // §6 states, whether or not anybody built three walls there.
  w = flat_world();
  for d0 in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(0, 0, d0);
    if !(nq == 1 && nr == 0) { wall_set(w, 0, 0, d0, WALL_MAT, 8, 2.0); }
  }
  for d1 in 0..6 {
    (mq, mr) = hex_grid::hex_neighbor(1, 0, d1);
    if !(mq == 0 && mr == 0) { wall_set(w, 1, 0, d1, WALL_MAT, 8, 2.0); }
  }
  cl = claims_new(0 - 8, 0 - 8, 17, 17);
  sg = segments_of(w, 0 - 8, 0 - 8, 17, 17, 0.0, cl);
  assert(segment_count(sg) == 1,
         "the domino's boundary is {segment_count(sg)} components, not one — the fixture "
       + "is not what this row is about");
  got = peel(w, 0 - 8, 0 - 8, 17, 17, cl);
  assert(got == "run;run;run;", "the domino's outline describes `{got}`");
  assert(marks_unclaimed(w, 0 - 8, 0 - 8, 17, 17, 0.0, cl) == 0,
         "it left {marks_unclaimed(w, 0 - 8, 0 - 8, 17, 17, 0.0, cl)} marks unexplained");
}

// ⛔ **AND THE GUARD THAT REPLACES THE REFUSAL: THE CHAIN READER MUST STEAL NOTHING.** It is
// asked last, so a shape a round reader explains must never come back as runs — a rim cut
// into straight pieces is the *wall nobody built* `B4u` named, and it is the one way this
// step could have made the picture worse. Measured over the whole package: 751 of 754 tests
// were unmoved by it, and the three that moved are this file's own boundary rows.
fn test_the_chain_reader_does_not_steal_a_shape_a_round_reader_explains() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  cl = claims_new(0 - 7, 0 - 7, 14, 15);
  all = marks_unclaimed(w, 0 - 7, 0 - 7, 14, 15, 0.0, cl);
  assert(all > 40, "the rim is {all} marks — too small to be the curve this row is about");
  assert(all == 54, "the rim is {all} marks, not the 54 this row was measured on");
  got = peel(w, 0 - 7, 0 - 7, 14, 15, cl);
  assert(got == "disc;", "a whole tower rim describes `{got}`, not one disc");
  assert(marks_unclaimed(w, 0 - 7, 0 - 7, 14, 15, 0.0, cl) == 0,
         "the rim left marks over");
  h = flat_world();
  house_at(h, 0.0, 0.0);
  hc = claims_new(0 - 6, 0 - 1, 12, 11);
  field_is(h, 0 - 6, 0 - 1, 12, 11, 42);
  hgot = peel(h, 0 - 6, 0 - 1, 12, 11, hc);
  assert(hgot == "house;", "a house describes `{hgot}`, not one house");
}

// ── ✅ AND STRUCTURES THAT TOUCH, WHICH THE CELL FLOOD COULD NOT — `B4u` ──
//
// ⛔ **`B4t` NAMED THIS AS WHAT IT DELIBERATELY DID NOT DO**: *"a component is SPATIAL,
// so structures that touch are still one field"*. Measured, that costs more than a
// refusal — a house with a wall running off it described the house and left seven marks,
// and a house beside a tower drew a **run over the tower's rim**, which is a wall that is
// not there.
//
// ✅ **A MARK BELONGS TO THE CHAIN IT IS PART OF**, so the marks are flooded through the
// VERTICES they share while the floor keeps the cell flood. ⚠ **EVERY ROW HERE FIRST
// ASSERTS THE CELL FLOOD MAKES THEM ONE**, because a fixture that drifted apart would
// pass all of this while testing nothing.
fn touching(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer) -> integer {
  lb = labels_new(q0, r0, wq, hr);
  cells_label(touched_cells(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr)), lb)
}

fn test_two_walls_two_cells_apart_are_two_runs() {
  w = flat_world();
  wall_at(w, 0.0 - 2.0, 0.0 - 3.0, 0.0 - 2.0, 6.0);
  wall_at(w, 0.0, 0.0 - 3.0, 0.0, 6.0);
  assert(touching(w, 0 - 5, 0 - 4, 9, 11) == 1,
         "the two walls are {touching(w, 0 - 5, 0 - 4, 9, 11)} cell components, so they "
       + "do not touch and this row is about nothing");
  cl = claims_new(0 - 5, 0 - 4, 9, 11);
  field_is(w, 0 - 5, 0 - 4, 9, 11, 22);
  assert(peel(w, 0 - 5, 0 - 4, 9, 11, cl) == "run;run;",
         "two walls two cells apart describe "
       + "`{peel(w, 0 - 5, 0 - 4, 9, 11, claims_new(0 - 5, 0 - 4, 9, 11))}`");
  assert(marks_unclaimed(w, 0 - 5, 0 - 4, 9, 11, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 5, 0 - 4, 9, 11, 0.0, cl)} marks over");
}

fn test_two_walls_meeting_at_a_corner_are_two_runs() {
  w = flat_world();
  wall_at(w, 0.0 - 6.0, 0.0, 0.0, 0.0);
  wall_at(w, 0.0, 0.0, 0.0, 6.0);
  assert(touching(w, 0 - 6, 0 - 2, 10, 9) == 1, "the L is not one cell component");
  cl = claims_new(0 - 6, 0 - 2, 10, 9);
  field_is(w, 0 - 6, 0 - 2, 10, 9, 13);
  assert(peel(w, 0 - 6, 0 - 2, 10, 9, cl) == "run;run;",
         "an L of two walls describes "
       + "`{peel(w, 0 - 6, 0 - 2, 10, 9, claims_new(0 - 6, 0 - 2, 10, 9))}`");
  assert(marks_unclaimed(w, 0 - 6, 0 - 2, 10, 9, 0.0, cl) == 0, "marks over");
}

// ⛔ **THE HOUSE ATE PART OF THE WALL.** `claim_house` owns the mitre one cell past the
// box — `B4o`'s own rule, and right — so a wall that STARTS there had marks taken from
// it and the seven that were left described nothing. The wall's own piece is claimed
// before the house is asked, so the rule is unchanged and the order is what fixes it.
fn test_a_house_with_a_wall_running_off_it_is_both() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  wall_at(w, 4.0, 0.0, 12.0, 0.0);
  assert(touching(w, 0 - 6, 0 - 2, 15, 12) == 1,
         "the house and its wall are {touching(w, 0 - 6, 0 - 2, 15, 12)} cell "
       + "components, so they do not touch");
  cl = claims_new(0 - 6, 0 - 2, 15, 12);
  field_is(w, 0 - 6, 0 - 2, 15, 12, 50);
  assert(peel(w, 0 - 6, 0 - 2, 15, 12, cl) == "run;house;",
         "a house with a wall running off it describes "
       + "`{peel(w, 0 - 6, 0 - 2, 15, 12, claims_new(0 - 6, 0 - 2, 15, 12))}`");
  assert(marks_unclaimed(w, 0 - 6, 0 - 2, 15, 12, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 6, 0 - 2, 15, 12, 0.0, cl)} marks over — `B4t` left 7");
}

// ⛔ **AND THIS ONE DREW A WALL THAT IS NOT THERE.** With the two in one field the house
// was described first, its claim opened the rim, and the opened rim read back as a RUN —
// a false description, which is worse than the refusal the other rows got.
fn test_a_house_beside_a_tower_is_a_disc_and_a_house() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  tower_at(w, 0.0, 0.0 - 7.0);
  assert(touching(w, 0 - 7, 0 - 11, 14, 21) == 1,
         "the house and the tower are {touching(w, 0 - 7, 0 - 11, 14, 21)} cell "
       + "components, so they do not touch");
  field_is(w, 0 - 7, 0 - 11, 14, 21, 96);
  cl = claims_new(0 - 7, 0 - 11, 14, 21);
  got = peel(w, 0 - 7, 0 - 11, 14, 21, cl);
  assert(got == "disc;house;", "a house beside a tower describes `{got}`");
  assert(marks_unclaimed(w, 0 - 7, 0 - 11, 14, 21, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 7, 0 - 11, 14, 21, 0.0, cl)} marks over");
}

fn test_two_towers_a_cell_apart_are_two_discs() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  tower_at(w, 15.0, 0.0);
  assert(touching(w, 0 - 7, 0 - 7, 23, 15) == 1,
         "the two towers are {touching(w, 0 - 7, 0 - 7, 23, 15)} cell components, so "
       + "they do not touch");
  cl = claims_new(0 - 7, 0 - 7, 23, 15);
  field_is(w, 0 - 7, 0 - 7, 23, 15, 108);
  assert(peel(w, 0 - 7, 0 - 7, 23, 15, cl) == "disc;disc;",
         "two towers a cell apart describe "
       + "`{peel(w, 0 - 7, 0 - 7, 23, 15, claims_new(0 - 7, 0 - 7, 23, 15))}`");
  assert(marks_unclaimed(w, 0 - 7, 0 - 7, 23, 15, 0.0, cl) == 0, "marks over");
}

// ── ⚠ THE INSTRUMENT, CHECKED BEFORE IT IS BELIEVED ───────────────────────
//
// The flood walks to the four edges sharing a corner by ROTATION — from `A` the two
// third cells lie at `d±1` and from `B` the same two lie at `d∓2`. That is an assertion
// about the lattice, so it is compared here against the corner IDENTITY: `hex_corner_tri_a`
// and `hex_corner_tri_b`, the exact triangle-lattice integers `wall_chain_ends` counts
// degrees over. Two edges are in one piece iff they are joined by a path of shared
// corners; the two answers must partition the marks identically.
fn same_corner(aq: integer, ar: integer, ad: integer,
               bq: integer, br: integer, bd: integer) -> boolean {
  (a1, a2) = hex_grid::hex_edge_corners(ad);
  (b1, b2) = hex_grid::hex_edge_corners(bd);
  for i in 0..2 {
    ac = if i == 0 { a1 } else { a2 };
    for j in 0..2 {
      bc = if j == 0 { b1 } else { b2 };
      if hex_shape::hex_corner_tri_a(aq, ar, ac) == hex_shape::hex_corner_tri_a(bq, br, bc)
         && hex_shape::hex_corner_tri_b(aq, ar, ac) == hex_shape::hex_corner_tri_b(bq, br, bc) {
        return true;
      }
    }
  }
  false
}

fn corner_partition_agrees(w: VoxelWorld, q0: integer, r0: integer, wq: integer,
                           hr: integer) -> text {
  cl = claims_new(q0, r0, wq, hr);
  ed = edgeset_new(q0, r0, wq, hr);
  np = marks_label(w, q0, r0, wq, hr, 0.0, cl, ed);
  eq: vector<integer> = [];
  er: vector<integer> = [];
  edir: vector<integer> = [];
  lab: vector<integer> = [];
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      for d in [4, 5, 0] {
        // ⚠ THE FIXTURES HAVE NOTHING CLAIMED, so *is this a mark* is the whole test.
        if !edge_is_wall(wall_of(w, q, r, d, 0.0)) { continue; }
        eq += [q]; er += [r]; edir += [d]; lab += [len(lab)];
      }
    }
  }
  if len(eq) == 0 { return "no marks"; }
  moved = true;
  while moved {
    moved = false;
    for i in 0..len(lab) {
      for j in 0..len(lab) {
        if i == j { continue; }
        if !same_corner(eq[i] ?? 0, er[i] ?? 0, edir[i] ?? 0,
                        eq[j] ?? 0, er[j] ?? 0, edir[j] ?? 0) { continue; }
        if (lab[j] ?? 0) < (lab[i] ?? 0) { lab[i] = lab[j] ?? 0; moved = true; }
      }
    }
  }
  seen: vector<integer> = [];
  for i in 0..len(lab) {
    got = false;
    for k in 0..len(seen) { if (seen[k] ?? 0) == (lab[i] ?? 0) { got = true; } }
    if !got { seen += [lab[i] ?? 0]; }
  }
  if len(seen) != np { return "{len(seen)} pieces by corner, {np} by the flood"; }
  for i in 0..len(lab) {
    for j in 0..len(lab) {
      (inq, inr) = hex_grid::hex_neighbor(eq[i] ?? 0, er[i] ?? 0, edir[i] ?? 0);
      (jnq, jnr) = hex_grid::hex_neighbor(eq[j] ?? 0, er[j] ?? 0, edir[j] ?? 0);
      byc = (lab[i] ?? 0) == (lab[j] ?? 0);
      byf = edge_mat(ed, eq[i] ?? 0, er[i] ?? 0, inq, inr)
            == edge_mat(ed, eq[j] ?? 0, er[j] ?? 0, jnq, jnr);
      if byc != byf { return "the two disagree about a pair of marks"; }
    }
  }
  ""
}

fn test_the_vertex_flood_is_the_corner_identity() {
  h = flat_world();
  house_at(h, 0.0, 0.0);
  assert(corner_partition_agrees(h, 0 - 10, 0 - 10, 21, 21) == "",
         "a house: {corner_partition_agrees(h, 0 - 10, 0 - 10, 21, 21)}");
  t = flat_world();
  tower_at(t, 0.0, 0.0);
  assert(corner_partition_agrees(t, 0 - 10, 0 - 10, 21, 21) == "",
         "a tower: {corner_partition_agrees(t, 0 - 10, 0 - 10, 21, 21)}");
  v = flat_world();
  house_at(v, 0.0, 0.0);
  tower_at(v, 0.0, 0.0 - 12.0);
  wall_at(v, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  assert(corner_partition_agrees(v, 0 - 12, 0 - 16, 25, 26) == "",
         "the village: {corner_partition_agrees(v, 0 - 12, 0 - 16, 25, 26)}");
  l = flat_world();
  wall_at(l, 0.0 - 6.0, 0.0, 0.0, 0.0);
  wall_at(l, 0.0, 0.0, 0.0, 6.0);
  assert(corner_partition_agrees(l, 0 - 14, 0 - 8, 26, 18) == "",
         "an L: {corner_partition_agrees(l, 0 - 14, 0 - 8, 26, 18)}");
}

// ⛔ **A HOUSE'S FOUR CORNER STUBS MUST NOT BECOME FOUR ONE-EDGE RUNS.** `B4t` measured
// that a lone marked edge is its own component with two chain ends, so it IS a run — and
// `B0`'s four stray edges are exactly four lone marks if the flood does not reach them.
// It does: each shares a vertex with the boundary it over-runs, which is what makes them
// the house's own mitre rather than four walls nobody built.
fn test_a_lone_house_is_one_piece() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  ed = edgeset_new(0 - 6, 0 - 1, 12, 11);
  field_is(w, 0 - 6, 0 - 1, 12, 11, 42);
  np = marks_label(w, 0 - 6, 0 - 1, 12, 11, 0.0, claims_new(0 - 6, 0 - 1, 12, 11), ed);
  assert(np == 1, "a house's marks are {np} pieces, so its mitre stubs are their own runs");
}

// ── ⛔ A MARKING THE WINDOW CLIPS — plan 26, [`probe/tw`](../../../probe/tw/README.md) ──
//
// ⛔ **THE FLOOD READ THE WORLD AND WROTE INTO THE WINDOW, AND THOSE ARE NOT THE SAME
// PLACE.** `mark_piece_grow` enqueues a neighbouring mark when `mark_left` says the WORLD
// holds one and `edge_mat(out, …)` says this piece has not recorded it — but an edge
// outside the window's grid cannot be recorded at all: `edge_set_mat` drops the write and
// `edge_mat` reads back 0, measured with an inside control that reads back 7. So a mark
// the window clips is enqueued **every time it is reached and never marked**, and the
// queue never empties.
//
// ⛔ **IT IS NOT SLOW, IT IS ENDLESS**, which is why this is a correctness test and not a
// budget: `segments_of` on the clipped window below had not returned after 190 s with RSS
// climbing 106 → 238 MB, while the same fixture one column wider answers in 2.6 s.
// ⚠ **So its failure mode on the defect is the FILE DEADLINE, not an assertion** — a
// reader seeing `[timeout] … fn=…` here is seeing this defect, restored.
//
// ⚠ **AND `src/plan_view.loft` TAKES ITS WINDOW FROM THE ENVIRONMENT**, so this is a
// picture an author asks for and never gets back — [EDITOR_DEFECTS
// 11](../../../doc/claude/EDITOR_DEFECTS.md), not a test-suite matter.
fn tee_row(w: VoxelWorld) {
  for k in 0..7 {
    for d in 0..6 { wall_set(w, k - 3, 0, d, WALL_MAT, 8, 2.0); }
  }
}

fn labelled_edges(ed: EdgeSet, q0: integer, r0: integer, wq: integer,
                  hr: integer) -> integer {
  n = 0;
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      for d in [4, 5, 0] {
        (nq, nr) = hex_grid::hex_neighbor(q, r, d);
        if edge_mat(ed, q, r, nq, nr) != 0 { n = n + 1; }
      }
    }
  }
  n
}

// ⚠ **THE INVARIANT IS THE WINDOW'S OWN SCAN**: every unclaimed mark the window holds
// gets a piece, and nothing else does. That is what `marks_unclaimed` counts, and asking
// the two to agree is what makes this more than *it came back*.
fn test_a_marking_the_window_clips_still_terminates() {
  w = flat_world();
  tee_row(w);
  // ⚠ **THE CONTROL FIRST — a window that holds the whole marking.** The tee's marks span
  // `q -4..4`; this holds all of them and has always answered.
  cw = claims_new(0 - 6, 0 - 6, 13, 13);
  ce = edgeset_new(0 - 6, 0 - 6, 13, 13);
  cn = marks_label(w, 0 - 6, 0 - 6, 13, 13, 2.0, cw, ce);
  assert(cn == 1, "the whole tee is {cn} pieces, not one");
  assert(labelled_edges(ce, 0 - 6, 0 - 6, 13, 13)
         == marks_unclaimed(w, 0 - 6, 0 - 6, 13, 13, 2.0,
                            claims_new(0 - 6, 0 - 6, 13, 13)),
         "the control labelled {labelled_edges(ce, 0 - 6, 0 - 6, 13, 13)} of "
       + "{marks_unclaimed(w, 0 - 6, 0 - 6, 13, 13, 2.0, claims_new(0 - 6, 0 - 6, 13, 13))} marks");
  // …and now one that cuts the low-q end off, which is where it looped.
  kw = claims_new(0 - 2, 0 - 6, 9, 13);
  ke = edgeset_new(0 - 2, 0 - 6, 9, 13);
  kn = marks_label(w, 0 - 2, 0 - 6, 9, 13, 2.0, kw, ke);
  assert(kn >= 1, "a clipped marking came back as {kn} pieces");
  assert(labelled_edges(ke, 0 - 2, 0 - 6, 9, 13)
         == marks_unclaimed(w, 0 - 2, 0 - 6, 9, 13, 2.0,
                            claims_new(0 - 2, 0 - 6, 9, 13)),
         "the clipped window labelled {labelled_edges(ke, 0 - 2, 0 - 6, 9, 13)} of "
       + "{marks_unclaimed(w, 0 - 2, 0 - 6, 9, 13, 2.0, claims_new(0 - 2, 0 - 6, 9, 13))} "
       + "marks — the flood does not cover the window's own field");
}

// ⚠ **AND THE OTHER THREE SIDES, BECAUSE THE STORAGE IS NOT SYMMETRIC.** `eg_index`
// canonicalises three of the six directions onto the NEIGHBOUR cell, so which clipped
// edges are addressable depends on which side the window cuts — the first prediction from
// the mechanism was *two cells outside on any side* and the `q1` and `r0` sides both
// refuted it by answering. A test that clipped one side would have been green on three
// quarters of the defect.
fn test_a_marking_clipped_on_any_side_terminates() {
  w = flat_world();
  tee_row(w);
  for side in 0..4 {
    q0 = if side == 0 { 0 - 2 } else { 0 - 6 };
    r0 = if side == 2 { 1 } else { 0 - 6 };
    wq = if side == 1 { 9 } else { if side == 0 { 9 } else { 13 } };
    hr = if side == 3 { 6 } else { if side == 2 { 6 } else { 13 } };
    ed = edgeset_new(q0, r0, wq, hr);
    n = marks_label(w, q0, r0, wq, hr, 2.0, claims_new(q0, r0, wq, hr), ed);
    left = marks_unclaimed(w, q0, r0, wq, hr, 2.0, claims_new(q0, r0, wq, hr));
    // ⚠ **A PIECE COUNT AND A MARK COUNT HAVE TO AGREE ABOUT EMPTINESS**, or the row
    // would be green for a window the flood simply refused to enter.
    assert((left > 0) == (n > 0),
           "side {side} ({q0},{r0} {wq}x{hr}) has {left} marks and {n} pieces");
    assert(labelled_edges(ed, q0, r0, wq, hr) == left,
           "side {side} ({q0},{r0} {wq}x{hr}) labelled "
         + "{labelled_edges(ed, q0, r0, wq, hr)} of {left} marks");
  }
}

// ⚠ **A PIECE NEVER CROSSES A CELL COMPONENT**, which is what lets a component be a piece
// plus the cell component it stands in. Two marks meeting at a vertex have cells that
// touch, and `touched_cells` takes BOTH cells of every mark — so the pieces refine the
// cell flood rather than cutting across it. Measured on the fixture that has three
// structures and one that has two in one field.
fn crosses(w: VoxelWorld, q0: integer, r0: integer, wq: integer, hr: integer) -> boolean {
  cl = claims_new(q0, r0, wq, hr);
  lb = labels_new(q0, r0, wq, hr);
  cells_label(touched_cells(w, q0, r0, wq, hr, 0.0, cl), lb);
  ed = edgeset_new(q0, r0, wq, hr);
  np = marks_label(w, q0, r0, wq, hr, 0.0, cl, ed);
  home: vector<integer> = [];
  for i in 0..np { home += [0 - 2]; }
  bad = false;
  for r in r0..r0 + hr {
    for q in q0..q0 + wq {
      for d in [4, 5, 0] {
        (nq, nr) = hex_grid::hex_neighbor(q, r, d);
        pv = edge_mat(ed, q, r, nq, nr);
        if pv == 0 { continue; }
        c = label_get(lb, q, r);
        if (home[pv - 1] ?? 0 - 2) == 0 - 2 { home[pv - 1] = c; }
        else if (home[pv - 1] ?? 0 - 2) != c { bad = true; }
      }
    }
  }
  bad
}

fn test_a_piece_never_crosses_a_cell_component() {
  v = flat_world();
  house_at(v, 0.0, 0.0);
  tower_at(v, 0.0, 0.0 - 12.0);
  wall_at(v, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  assert(!crosses(v, 0 - 12, 0 - 16, 25, 26), "a piece of the village crosses two cell components");
  d = flat_world();
  house_at(d, 0.0, 0.0);
  wall_at(d, 4.0, 0.0, 12.0, 0.0);
  assert(!crosses(d, 0 - 12, 0 - 12, 30, 26), "a piece of the attached pair crosses two");
}

// ── ✅ AND SHARING A VERTEX IS DESCRIBED NOW — plan 26 `B4v` ─────────────
//
// A wall that MEETS a tower's rim shares vertices with it, so no flood separates them —
// `B4u`'s honest residual, and it drew the wall and counted the rim's 52 marks. The
// component is partitioned by what a candidate ACCOUNTS FOR instead: each shape's own
// boundary must lie WITHIN the component's marks, and the set is taken only when it
// claims every one of them and nothing outside.
fn test_a_wall_meeting_a_rim_is_a_run_and_a_disc() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 8.0, 0.0 - 6.0, 8.0, 6.0);
  ed = edgeset_new(0 - 7, 0 - 7, 16, 15);
  np = marks_label(w, 0 - 7, 0 - 7, 16, 15, 0.0, claims_new(0 - 7, 0 - 7, 16, 15), ed);
  assert(np == 1,
         "the wall and the rim are {np} pieces, so they do not share a vertex and this "
       + "row is about nothing");
  cl = claims_new(0 - 7, 0 - 7, 16, 15);
  field_is(w, 0 - 7, 0 - 7, 16, 15, 67);
  got = peel(w, 0 - 7, 0 - 7, 16, 15, cl);
  assert(got == "run;disc;", "a wall meeting a rim describes `{got}`");
  assert(marks_unclaimed(w, 0 - 7, 0 - 7, 16, 15, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 7, 0 - 7, 16, 15, 0.0, cl)} marks over — `B4u` left 52");

  // …and the control, one cell further out: no shared vertex, both described
  c = flat_world();
  tower_at(c, 0.0, 0.0);
  wall_at(c, 10.0, 0.0 - 6.0, 10.0, 6.0);
  ccl = claims_new(0 - 7, 0 - 7, 16, 15);
  field_is(c, 0 - 7, 0 - 7, 16, 15, 69);
  assert(peel(c, 0 - 7, 0 - 7, 16, 15, ccl) == "disc;run;",
         "the same pair clear of each other describes "
       + "`{peel(c, 0 - 7, 0 - 7, 16, 15, claims_new(0 - 7, 0 - 7, 16, 15))}`");
  assert(marks_unclaimed(c, 0 - 7, 0 - 7, 16, 15, 0.0, ccl) == 0, "marks over");
}

// ⛔ **AND THE HOUSE'S OWN RESIDUAL STOPS COUNTING ITS NEIGHBOUR'S MARKS — plan 26
// `B4u`.** `B4o` bounded `stray` to `house_owns` — the mitre's own one-cell reach — and
// asked for exactly this control with the other structure **eight** hexes away. At ONE
// cell the bound is not enough: a tower's rim reaches inside it, and the caption read
// `11 stray` about a house whose mitre is four marks. The claim set already says whose
// those marks are, which is what the split made true.
fn test_the_mitre_count_is_unmoved_by_a_tower_one_cell_away() {
  lone = flat_world();
  house_at(lone, 0.0, 0.0);
  alone = house_recover(lone, 0 - 7, 0 - 11, 14, 21, 0.0);
  assert(alone.hs_ok, "the lone house did not recover: {alone.hs_why}");

  w = flat_world();
  house_at(w, 0.0, 0.0);
  tower_at(w, 0.0, 0.0 - 7.0);
  assert(touching(w, 0 - 7, 0 - 11, 14, 21) == 1,
         "the pair is not one cell component, so this row is about nothing");
  field_is(w, 0 - 7, 0 - 11, 14, 21, 96);
  sg = segments_of(w, 0 - 7, 0 - 11, 14, 21, 0.0, claims_new(0 - 7, 0 - 11, 14, 21));
  // ⚠ **EVERY COMPONENT THE HOUSE READER ANSWERS FOR, NOT ONE THAT MATCHES.** An
  // existence check would pass on a chain that got it right somewhere and wrong here.
  asked = 0;
  for id in 0..segment_count(sg) {
    only = segment_claims(claims_new(0 - 7, 0 - 11, 14, 21), w, 0 - 7, 0 - 11, 14, 21,
                          0.0, sg, id);
    if disc_recover_claimed(w, 0 - 7, 0 - 11, 14, 21, 0.0, only).dc_ok { continue; }
    h = house_recover_claimed(w, 0 - 7, 0 - 11, 14, 21, 0.0, only);
    if !h.hs_ok { continue; }
    asked = asked + 1;
    assert(h.hs_stray == alone.hs_stray,
           "the house reports {h.hs_stray} stray marks beside a tower and "
         + "{alone.hs_stray} alone — the rim is being counted as its corner over-run");
  }
  assert(asked > 0, "the house reader answered for no component at all");
}

// ⛔ **AND A COMPONENT IS HANDED ITS OWN CELL COMPONENT'S FLOOR, NOTHING ELSE.** The
// sweep asked for this the hard way: a row that gave every piece cell component 0 went
// **GREEN** across both suites, because in every fixture above either everything stands
// in one cell component or the round readers answer before the house reader is reached.
// ⚠ **What that row would break is `B4o`'s rule, one layer down** — a piece nothing
// explains would reach the house reader, be answered with somebody else's rectangle, and
// carry a residual measured over marks that are not the house's. So the property is
// asserted directly rather than through a caption that cannot see it.
fn test_a_component_is_handed_only_its_own_floor() {
  w = flat_world();
  house_at(w, 0.0, 0.0);
  // …and a two-cell domino's boundary, far enough to be its own cell component
  for d0 in 0..6 {
    (nq, nr) = hex_grid::hex_neighbor(0 - 14, 0 - 10, d0);
    if !(nq == 0 - 13 && nr == 0 - 10) { wall_set(w, 0 - 14, 0 - 10, d0, WALL_MAT, 8, 2.0); }
  }
  for d1 in 0..6 {
    (mq, mr) = hex_grid::hex_neighbor(0 - 13, 0 - 10, d1);
    if !(mq == 0 - 14 && mr == 0 - 10) { wall_set(w, 0 - 13, 0 - 10, d1, WALL_MAT, 8, 2.0); }
  }
  q0 = 0 - 17; r0 = 0 - 13; wq = 23; hr = 23;
  field_is(w, q0, r0, wq, hr, 52);
  assert(touching(w, q0, r0, wq, hr) == 2,
         "the house and the domino are {touching(w, q0, r0, wq, hr)} cell components, "
       + "not two — this row needs them apart");
  cl = claims_new(q0, r0, wq, hr);
  sg = segments_of(w, q0, r0, wq, hr, 0.0, cl);
  answered = 0;
  for id in 0..segment_count(sg) {
    only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, id);
    if house_recover_claimed(w, q0, r0, wq, hr, 0.0, only).hs_ok { answered = answered + 1; }
  }
  assert(answered == 1,
         "the house reader answers for {answered} of the {segment_count(sg)} components — "
       + "a piece is being handed a floor that stands in another component");
}

// ── ✅ TWO RIMS THAT MEET, AND WHAT THE UNION TEST REFUSES — plan 26 `B4v` ─
//
// ⛔ **`B4u` REFUSED THIS WITH ALL 106 MARKS COUNTED**, and correctly: neither rim is the
// whole component's boundary, so the both-ways fit each round reader makes could not
// accept either. A SET of them can, and R1 moves up one level to the union.
fn test_two_rims_that_meet_are_two_discs() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  tower_at(w, 13.0, 0.0);
  ed = edgeset_new(0 - 7, 0 - 7, 22, 15);
  np = marks_label(w, 0 - 7, 0 - 7, 22, 15, 0.0, claims_new(0 - 7, 0 - 7, 22, 15), ed);
  assert(np == 1,
         "the two rims are {np} pieces, so they do not share a vertex and `B4u` already "
       + "describes them — this row is about nothing");
  cl = claims_new(0 - 7, 0 - 7, 22, 15);
  field_is(w, 0 - 7, 0 - 7, 22, 15, 106);
  got = peel(w, 0 - 7, 0 - 7, 22, 15, cl);
  assert(got == "disc;disc;", "two rims that meet describe `{got}`");
  assert(marks_unclaimed(w, 0 - 7, 0 - 7, 22, 15, 0.0, cl) == 0,
         "{marks_unclaimed(w, 0 - 7, 0 - 7, 22, 15, 0.0, cl)} marks over");
}

// ── ✅ AND A CROSSING IS TWO RUNS — plan 26 `B4w` ─────────────────────────
//
// ⛔ **`B4v` REFUSED THIS AND ITS RECORD NAMED WHY**: the trial had no candidate generator
// for a run, because a run's endpoints are continuous world points rather than a grid.
//
// ✅ **A WALL CAN ONLY BEGIN WHERE THE CHAIN DOES** — at a free END (one mark meets) or at
// a JUNCTION (three or more), both exact integers over the corner identity. ⚠ **FOUR
// GEOMETRIES, BECAUSE ONE CLOSING PROVES NOTHING ABOUT A GENERATOR**: a plus, a diagonal,
// an offset pair and a long/short pair.
fn crossing(ax0: float, az0: float, ax1: float, az1: float,
            bx0: float, bz0: float, bx1: float, bz1: float) -> VoxelWorld {
  w = flat_world();
  wall_at(w, ax0, az0, ax1, az1);
  wall_at(w, bx0, bz0, bx1, bz1);
  w
}

// ⚠ **THE WINDOW AND THE MARK TOTAL ARE THE CALLER'S, BECAUSE THE FOUR GEOMETRIES ARE
// NOT THE SAME SIZE.** One shared 37 × 37 covered every one of them and was 14 … 19× the
// field it held; the extent of each is measured from the STORE and `marks` is asserted
// exactly, so a window that clips one of them cannot pass quietly.
fn crossing_closes(tag: text, w: VoxelWorld, q0: integer, r0: integer, wq: integer,
                   hr: integer, marks: integer) {
  assert(touching(w, q0, r0, wq, hr) == 1,
         "{tag} is {touching(w, q0, r0, wq, hr)} components, so `B4u` already separates "
       + "it and this row is about nothing");
  all = marks_unclaimed(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr));
  assert(all == marks,
         "{tag} is {all} marks in this window, not the {marks} it was measured on — the "
       + "window clips its field");
  cl = claims_new(q0, r0, wq, hr);
  got = peel(w, q0, r0, wq, hr, cl);
  assert(got == "run;run;", "{tag} describes `{got}`, not two runs");
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl) == 0,
         "{tag} leaves {marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl)} of its {all} marks over");
}

fn test_two_walls_that_cross_are_two_runs() {
  crossing_closes("a plus",
    crossing(0.0 - 6.0, 0.0, 6.0, 0.0, 0.0, 0.0 - 6.0, 0.0, 6.0), 0 - 6, 0 - 6, 12, 13, 28);
  crossing_closes("a diagonal X",
    crossing(0.0 - 6.0, 0.0 - 6.0, 6.0, 6.0, 0.0 - 6.0, 6.0, 6.0, 0.0 - 6.0),
    0 - 6, 0 - 7, 13, 15, 47);
  crossing_closes("an offset pair",
    crossing(0.0 - 7.0, 1.0, 5.0, 1.0, 1.0, 0.0 - 5.0, 1.0, 7.0), 0 - 6, 0 - 6, 12, 13, 29);
  crossing_closes("a long and a short",
    crossing(0.0 - 10.0, 0.0, 10.0, 0.0, 0.0, 0.0 - 4.0, 0.0, 4.0), 0 - 8, 0 - 5, 16, 11, 32);
}

// ── ⚠ THE ACCEPTANCE IS ONE NUMBER AND IT IS TWO-DIRECTIONAL ──────────────
//
// ⛔ **TOO FEW CLAIMS AND THE COMPONENT IS NOT EXPLAINED; TOO MANY AND THE TRIAL REACHED
// INTO A NEIGHBOUR** — `B4o`'s defect, which a count of the component alone cannot see.
// Both are `after == before - mine`, measured here from either side on one field.
fn test_the_union_test_refuses_a_trial_that_reaches_outside() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 0.0 - 20.0, 0.0 - 6.0, 0.0 - 20.0, 6.0);
  q0 = 0 - 15; r0 = 0 - 7; wq = 22; hr = 15;
  cl = claims_new(q0, r0, wq, hr);
  field_is(w, q0, r0, wq, hr, 70);
  sg = segments_of(w, q0, r0, wq, hr, 0.0, cl);
  assert(segment_count(sg) == 2,
         "the tower and the far wall are {segment_count(sg)} components, not two");
  before = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
  // the tower's own component
  tid = 0 - 1;
  for id in 0..segment_count(sg) {
    only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, id);
    if disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only).dc_ok { tid = id; }
  }
  assert(tid >= 0, "no component recovers as a disc — the fixture is not what this needs");
  only = segment_claims(cl, w, q0, r0, wq, hr, 0.0, sg, tid);
  mine = marks_unclaimed(w, q0, r0, wq, hr, 0.0, only);
  d = disc_recover_claimed(w, q0, r0, wq, hr, 0.0, only);

  // …the rim alone: exactly its own component, and the number accepts
  right = claims_copy(cl, q0, r0, wq, hr);
  claim_disc(right, d.dc_cq, d.dc_cr, d.dc_shell, q0, r0, wq, hr);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, right) == before - mine,
         "the rim alone does not satisfy the acceptance — the number cannot say yes");

  // …and the rim PLUS the far wall: the component is explained and a neighbour is not
  // its business, so the same number must refuse
  wide = claims_copy(cl, q0, r0, wq, hr);
  claim_disc(wide, d.dc_cq, d.dc_cr, d.dc_shell, q0, r0, wq, hr);
  claim_run(wide, 0.0 - 20.0, 0.0 - 6.0, 0.0 - 20.0, 6.0, q0, r0, wq, hr);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, wide) != before - mine,
         "a trial that claimed a NEIGHBOUR's marks as well is accepted — the number is "
       + "one-directional and cannot see it");
}

// ⛔ **A CANDIDATE THAT ACCOUNTS FOR NOTHING NEW IS THE PASS'S ONLY TERMINATION
// ARGUMENT.** A rim already claimed still lies within the marks and would be returned for
// ever, so `disc_within` has to ask before it answers rather than after.
fn test_a_within_candidate_already_claimed_is_not_offered_again() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  q0 = 0 - 10; r0 = 0 - 10; wq = 21; hr = 21;
  base = claims_new(q0, r0, wq, hr);
  first = disc_within(w, q0, r0, wq, hr, 0.0, base, claims_new(q0, r0, wq, hr));
  assert(first.dc_ok, "the rim is not within its own marks: {first.dc_why}");
  taken = claims_new(q0, r0, wq, hr);
  claim_disc(taken, first.dc_cq, first.dc_cr, first.dc_shell, q0, r0, wq, hr);
  again = disc_within(w, q0, r0, wq, hr, 0.0, base, taken);
  assert(!again.dc_ok,
         "the same rim is offered a second time as {again.dc_cq},{again.dc_cr} shell "
       + "{again.dc_shell} — the pass would never end");
}

// ⛔ **AND THE ADMITTED SET IS THE GESTURE'S, WHICH ONLY THE RELAXED READER NEEDS.**
// Measured: a shell-**0** disc — one cell's six edges — lies inside the marks of a wall
// meeting a rim, and `disc_recover`'s equality could never reach it. `fit_shell` is what
// says no tower is that small, and without it the picture draws a circle of no radius
// over a cell that is part of two other structures.
fn test_the_relaxed_reader_admits_only_shells_a_tower_can_be() {
  w = flat_world();
  tower_at(w, 0.0, 0.0);
  wall_at(w, 8.0, 0.0 - 6.0, 8.0, 6.0);
  q0 = 0 - 7; r0 = 0 - 7; wq = 15; hr = 15;
  base = claims_new(q0, r0, wq, hr);
  field_is(w, q0, r0, wq, hr, 67);
  cl = claims_new(q0, r0, wq, hr);
  // walk every disc the reader will offer, and none may be a shell no tower can be
  for i in 0..6 {
    d = disc_within(w, q0, r0, wq, hr, 0.0, base, cl);
    if !d.dc_ok { break; }
    assert(fit_shell(d.dc_shell).ft_ok,
           "the relaxed reader offered shell {d.dc_shell}, which `fit_shell` refuses — "
         + "no gesture can build it and no field is it");
    if claim_disc(cl, d.dc_cq, d.dc_cr, d.dc_shell, q0, r0, wq, hr) == 0 { break; }
  }
}

// ⛔ **AND A SET THAT EXPLAINS PART OF ITS COMPONENT IS REFUSED, WITH THE MARKS
// COUNTED.** A tower whose rim a **T** of two walls meets is one component; the trial
// finds the rim, and what is left is three chain ends that no run and no disc answers
// for. ⚠ **This is the row the ACCEPTANCE side is measured by** — the crossed walls above
// refuse because the trial finds nothing at all, which says nothing about what happens
// when it finds something. Without both, a pass that drew a right shape over a field it
// does not account for would ship as a picture with a silent leftover, which is exactly
// what `B4p` spent a step removing.
fn test_a_tee_whose_stem_meets_no_corner_now_closes_by_splitting_the_crossbar() {
  // ⚠ **`B4w` MEASURED WHICH TEE JUNCTIONS CLOSE: TWO OF EIGHT.** The stem's far endpoint is
  // a continuous point on the crossbar's centreline, and `corner_pool` could offer it only
  // where the field's own corners happened to carry it. This is one of the six that did not,
  // and it drew nothing while counting every mark.
  //
  // ✅ **THE CHAIN MAKES THAT POINT A VERTEX BY CONSTRUCTION**, because the walk passes
  // through it — so the stem is recoverable, and the price is named rather than hidden: the
  // crossbar comes back as TWO collinear runs instead of one. Two walls authored, three
  // described, every mark accounted for. `B4w`'s own record says neither outcome is wrong,
  // because the union test is the acceptance either way.
  w = flat_world();
  wall_at(w, 0.0 - 6.0, 0.0, 6.0, 0.0);
  wall_at(w, 0.0, 0.0, 0.0, 8.0);
  q0 = 0 - 6; r0 = 0 - 2; wq = 12; hr = 11;
  ed = edgeset_new(q0, r0, wq, hr);
  assert(marks_label(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr), ed) == 1,
         "the T is not one component, so this row is about nothing");
  all = field_is(w, q0, r0, wq, hr, 24);
  cl = claims_new(q0, r0, wq, hr);
  got = peel(w, q0, r0, wq, hr, cl);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl) == 0,
         "the T describes `{got}` and still leaves "
       + "{marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl)} of its {all} marks");
  // ⚠ **THREE, NOT TWO — the split is the finding.** A row asserting two would be asserting
  // that the crossbar survives whole, which is exactly what this cut does not promise.
  assert(got == "run;run;run;",
         "the T describes `{got}` — two authored walls should come back as three runs, the "
       + "crossbar split at the stem");
}

// ── ⛔ AND WHICH `T`s CLOSE, WHICH IS NOT A CATEGORY BUT A MEASUREMENT — `B4w` ─
//
// ⛔ **THE FIRST STATEMENT OF THIS WAS "A T IS NOT RECOVERABLE", AND THE SUITE REFUTED
// IT.** A T's stem ends at a continuous point on the crossbar's centreline; the pool holds
// the field's own CORNERS. Whether the two coincide is a fact about where the stem was
// authored, not about T-junctions — so the honest claim is a count, and this row is it.
//
// ⚠ **WHAT MATTERS IS THAT NEITHER OUTCOME IS WRONG.** A T that closes is described
// exactly; one that does not is refused with every mark counted, because the union test is
// the acceptance either way. A row that only asserted the total would pass on a chain that
// drew something false, so both halves are checked per stem.
fn test_every_tee_stem_closes_now_and_the_crossbar_is_what_pays() {
  // ⚠ **THIS ROW MEASURED A SPLIT AND NOW MEASURES ITS ABSENCE — deliberately.** Under
  // `corner_pool` alone, two of eight stem positions closed and six were refused, and this
  // row's guard was that BOTH outcomes occur: all-closed "would mean the pool is finding
  // runs it should not". That reading was right about the pool and does not carry to the
  // chain, where the stem's meeting point is a walk vertex whatever its position — so every
  // stem closes, and the guard has to become what it COSTS instead of whether it happens.
  //
  // ⚠ **THE WINDOW IS THE T's OWN EXTENT AND THE STEMS ARE THREE.** Each stem is a whole
  // peel over every reader, so this row is among the most expensive in the file.
  q0 = 0 - 6; r0 = 0 - 2; wq = 12; hr = 11;
  closed = 0;
  whole = 0;
  split = 0;
  for i in 0..3 {
    x = (i as float) - 1.0;
    w = flat_world();
    wall_at(w, 0.0 - 6.0, 0.0, 6.0, 0.0);
    wall_at(w, x, 0.0, x, 8.0);
    assert(touching(w, q0, r0, wq, hr) == 1, "the T at x={x} is not one component");
    // ⚠ 25 where the stem stands off the crossbar's own corner, 24 where it meets one.
    all = field_is(w, q0, r0, wq, hr, if i == 0 { 25 } else { 24 });
    cl = claims_new(q0, r0, wq, hr);
    got = peel(w, q0, r0, wq, hr, cl);
    left = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
    assert(left == 0,
           "the T at x={x} describes `{got}` and leaves {left} of its {all} marks — a set "
         + "that does not account for its component was accepted");
    // ⚠ **TWO OR THREE, AND WHICH ONE IS THE ORDERING SHOWING ITSELF.** Where the pool
    // carries the stem's meeting point it answers first and the crossbar survives WHOLE —
    // two runs for two authored walls, the better description. Where it cannot, the chain
    // cuts through the junction and the crossbar comes back as two collinear pieces.
    assert(got == "run;run;" || got == "run;run;run;",
           "the T at x={x} describes `{got}`");
    if got == "run;run;" { whole = whole + 1; } else { split = split + 1; }
    closed = closed + 1;
  }
  assert(closed == 3, "{closed} stems closed, not three");
  // ⛔ **BOTH OUTCOMES MUST STILL OCCUR, AND THE CLAIM HAS CHANGED.** It is no longer
  // *closed vs refused* — nothing refuses now — but *the pool served it vs the chain did*.
  // All-split would mean the chain reader is answering where the stronger reader could, and
  // all-whole that this row no longer reaches the chain at all.
  assert(whole > 0 && split > 0,
         "{whole} kept the crossbar whole and {split} split it — one outcome never happens, "
       + "so this row cannot tell the fallback from a replacement");
}

// ⛔ **THE POOL IS ENDS *AND* JUNCTIONS, AND EACH HALF IS LOAD-BEARING.** A crossing's four
// arms are free ends; a wall that begins where another passes has none. ⚠ Measured through
// the ANSWER rather than through the pool, because a count of corners cannot say which run
// was generated from them.
fn test_a_run_is_not_offered_from_the_middle_of_a_chain() {
  // one plain wall: its own sub-runs all lie within its marks, so a pool admitting
  // degree-2 corners would have plenty to offer — and the longest must still win
  w = flat_world();
  wall_at(w, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  q0 = 0 - 16; r0 = 0 - 12; wq = 30; hr = 26;
  all = marks_unclaimed(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr));
  got = run_within(w, q0, r0, wq, hr, 0.0, claims_new(q0, r0, wq, hr),
                   claims_new(q0, r0, wq, hr));
  assert(got.rr_ok, "a plain wall is not within its own marks: it read nothing");
  cl = claims_new(q0, r0, wq, hr);
  claim_run(cl, got.rr_x0, got.rr_z0, got.rr_x1, got.rr_z1, q0, r0, wq, hr);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl) == 0,
         "the run it offered accounts for {marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl)} "
       + "of a plain wall's {all} marks short of all of them — a SUB-run was taken, and "
       + "the remainder is one no pair of corners can generate");
}

// ⛔ **A CANDIDATE THAT ACCOUNTS FOR NOTHING NEW MUST BE SKIPPED.** The pool does not
// shrink as the pass claims — it is the whole component's, so the winning run stays within
// the marks for ever and would be offered again.
fn test_run_within_does_not_offer_a_run_already_claimed() {
  w = flat_world();
  wall_at(w, 0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0);
  q0 = 0 - 16; r0 = 0 - 12; wq = 30; hr = 26;
  base = claims_new(q0, r0, wq, hr);
  first = run_within(w, q0, r0, wq, hr, 0.0, base, claims_new(q0, r0, wq, hr));
  assert(first.rr_ok, "the wall is not within its own marks");
  taken = claims_new(q0, r0, wq, hr);
  claim_run(taken, first.rr_x0, first.rr_z0, first.rr_x1, first.rr_z1, q0, r0, wq, hr);
  again = run_within(w, q0, r0, wq, hr, 0.0, base, taken);
  assert(!again.rr_ok,
         "the same run is offered a second time as d{again.rr_d} p{again.rr_p} — the pass "
       + "would never end");
}

// ── ✅ AND A WALL THAT TURNS — plan 26 `B4x` ──────────────────────────────
//
// ⛔ **`corner_pool` COULD SERVE NEITHER OF THESE.** It admits a vertex at degree 1 (a chain
// end) or degree >= 3 (a junction); a corner where two runs MEET is neither. Measured before
// this landed: a zigzag of three walls drew `run;run;` and lost **12 of its 18 marks**, and a
// closed room of four drew **nothing at all** and lost all **50**.
//
// ⚠ **THE ACCEPTANCE IS THE POINT, NOT THE COUNT.** `run_span`'s within-ness alone — every
// edge the candidate generates is a mark of this component — cuts a room cleanly at only 12
// of its 50 possible starting vertices, losing up to 45 marks. `chain_covers` is the other
// half of `FORMAL_CORE` §6's R1, and with it all 50 seeds leave nothing over.
// [probe/b4x](../../../probe/b4x/README.md).
fn test_a_zigzag_of_three_walls_is_read_as_three() {
  w = flat_world();
  wall_at(w, 0.0 - 6.0, 0.0, 0.0 - 4.0, 0.0);
  wall_at(w, 0.0 - 4.0, 0.0, 4.0, 4.0);
  wall_at(w, 4.0, 4.0, 6.0, 4.0);
  q0 = 0 - 6; r0 = 0 - 2; wq = 12; hr = 9;
  cl = claims_new(q0, r0, wq, hr);
  all = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
  // ⚠ **17 AND NOT 16 SINCE plan 26 `B4y`.** One of the two bends was a GAP — the corner
  // edge neither run's segment reached — and `wall_corner_close` writes it now, so the
  // fixture this row was first measured on had a hole in it at one bend.
  assert(all == 17, "the zigzag is {all} marks, not the 17 this row was measured on");
  got = peel(w, q0, r0, wq, hr, cl);
  assert(got == "run;run;run;", "a zigzag of three walls describes `{got}`");
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl) == 0,
         "it leaves {marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl)} of its {all} marks over");
}

fn test_a_closed_room_leaves_nothing_over() {
  w = flat_world();
  wall_at(w, 0.0 - 5.0, 0.0 - 5.0, 5.0, 0.0 - 5.0);
  wall_at(w, 5.0, 0.0 - 5.0, 5.0, 5.0);
  wall_at(w, 5.0, 5.0, 0.0 - 5.0, 5.0);
  wall_at(w, 0.0 - 5.0, 5.0, 0.0 - 5.0, 0.0 - 5.0);
  q0 = 0 - 6; r0 = 0 - 6; wq = 12; hr = 13;
  cl = claims_new(q0, r0, wq, hr);
  all = marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl);
  assert(all == 50, "the room is {all} marks, not the 50 this row was measured on");
  // ⚠ **THE CONTROL IS THAT THE POOL REALLY IS EMPTY**, so this row is about the gap rather
  // than about a shape the older reader could already serve: no free end, no junction.
  me = edges_mat_claimed(w, q0, r0, wq, hr, 0.0, cl);
  assert(hex_shape::wall_chain_ends(me, q0, r0, wq, hr) == 0,
         "the room has {hex_shape::wall_chain_ends(me, q0, r0, wq, hr)} free ends, so "
       + "`corner_pool` could serve it and this row is about nothing");
  assert(hex_shape::wall_chain_branches(me, q0, r0, wq, hr) == 0,
         "the room has a junction, so the pool is not empty either");
  got = peel(w, q0, r0, wq, hr, cl);
  assert(marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl) == 0,
         "the room leaves {marks_unclaimed(w, q0, r0, wq, hr, 0.0, cl)} of its {all} marks "
       + "over — it describes `{got}`");
  // ⚠ **EVERY DESCRIPTION IS A RUN, AND THE COUNT IS DELIBERATELY NOT PINNED TO FOUR.** The
  // greedy cut splits a wall into collinear pieces depending on where the walk started —
  // 4…9 over the room's 50 seeds, measured. Four walls is the floor and nine the ceiling; a
  // row asserting one number would be asserting where this fixture's scan happens to begin.
  runs_ok = false;
  exp = "";
  for n in 1..10 {
    exp = exp + "run;";
    if got == exp && n >= 4 { runs_ok = true; }
  }
  assert(runs_ok, "the room describes `{got}` — not between four and nine runs");
}
