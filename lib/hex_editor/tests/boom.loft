//
// THE BOOM MAY COLLAPSE, AND WHEN IT DOES IT SLIDES OVER A SHOULDER.
//
// ⚠ The camera already swept walls exactly and then took `max(free, want * 0.22)` —
// a floor the sweep could not pass. In a room narrower than that fraction the eye
// went to the clamp regardless of what the sweep had just measured, which is OUTSIDE
// the wall. Measured in a 5x4 house: the frame was the roof from outside, a slab of
// exterior wall, and NO CHARACTER AT ALL.
//
// Taking the floor off is half of it. The other half is that a boom collapsing
// straight down its own axis ends at the back of a head, so it slides sideways as it
// shortens — which is what makes a short boom an over-the-shoulder view rather than
// a failure.
use hex_editor;

const WANT = 5.0;
const FRAC = 0.22;
const SKIN = 0.20;

fn test_a_boom_with_room_takes_what_it_asked_for() {
  b = hex_editor::boom_take(WANT, 20.0, SKIN);
  assert(b == WANT, "in the open it is the full boom: {b}");
}

fn test_a_boom_takes_the_room_and_not_the_clamp() {
  // ⚠ THE FIX, IN ONE LINE. A wall 1.0 away used to give a boom of 1.1 — the clamp —
  // which is 10 cm PAST the wall the sweep had just found. Now it gives 0.8, which
  // is this side of it.
  b = hex_editor::boom_take(WANT, 1.0, SKIN);
  assert(b < WANT * FRAC, "it goes below the old floor: {b} against {WANT * FRAC}");
  assert(b == 1.0 - SKIN, "taking the room less its skin: {b}");
}

fn test_the_eye_never_passes_what_the_sweep_found() {
  // The invariant the clamp broke, checked across the whole range rather than at one
  // convenient value: whatever the room, the boom stays this side of it.
  for i in 0..12 {
    free = (i as float) * 0.25;
    b = hex_editor::boom_take(WANT, free, SKIN);
    assert(b <= free, "free {free} gives boom {b} — never past it");
    assert(b >= 0.0, "and never behind the subject: {b}");
  }
}

fn test_collapse_runs_from_nothing_to_everything() {
  assert(hex_editor::boom_collapse(WANT, WANT, FRAC) == 0.0, "full boom, no collapse");
  assert(hex_editor::boom_collapse(WANT * FRAC, WANT, FRAC) == 1.0,
         "at the old floor it is fully collapsed");
  mid = hex_editor::boom_collapse(WANT * 0.6, WANT, FRAC);
  assert(mid > 0.0 && mid < 1.0, "and in between it is in between: {mid}");
  assert(hex_editor::boom_collapse(0.0, WANT, FRAC) == 1.0, "past it, still 1");
}

fn test_the_shoulder_offset_grows_as_the_boom_shrinks() {
  // ⚠ MONOTONE, WHICH IS THE WHOLE FEEL OF IT. The camera CREEPS: any step where the
  // offset went backwards would read as the camera changing its mind.
  prev = 0.0 - 1.0;
  for i in 0..11 {
    boom = WANT * (10 - i) as float / 10.0 ?? 0.0;
    r = hex_editor::shoulder_reach(boom, WANT, FRAC);
    assert(r >= prev, "offset {r} at boom {boom} never goes backwards from {prev}");
    prev = r;
  }
  assert(hex_editor::shoulder_reach(WANT, WANT, FRAC) == 0.0,
         "centred at full length");
  assert(hex_editor::shoulder_reach(WANT * FRAC, WANT, FRAC) == hex_editor::CAM_SHOULDER,
         "and a full shoulder once collapsed");
}

fn test_it_swings_toward_the_side_with_more_room() {
  // Or it creeps into the wall it was avoiding — which is the failure the offset
  // would otherwise introduce while fixing the boom.
  right = hex_editor::shoulder_take(0.5, 0.3, 4.0, SKIN);
  assert(right > 0.0, "with room on the right it goes right: {right}");
  left = hex_editor::shoulder_take(0.5, 4.0, 0.3, SKIN);
  assert(left < 0.0, "and left when the room is there: {left}");
}

fn test_it_never_slides_further_than_that_side_allows() {
  // ⚠ THE SAME MISTAKE THE CLAMP MADE, one axis over — an offset that ignored the
  // room would put the eye through a wall exactly as the floor did.
  o = hex_editor::shoulder_take(0.55, 0.1, 0.4, SKIN);
  assert(o <= 0.4 - SKIN + 0.000001, "it stops at the clearance: {o}");
  none = hex_editor::shoulder_take(0.55, 0.1, 0.1, SKIN);
  assert(none == 0.0, "and in a corridor it does not slide at all: {none}");
}

fn test_a_tie_resolves_the_same_way_every_time() {
  // A tie that flipped would oscillate exactly where a character stands still, which
  // is the one place a player is looking at it.
  a = hex_editor::shoulder_take(0.5, 2.0, 2.0, SKIN);
  b = hex_editor::shoulder_take(0.5, 2.0, 2.0, SKIN);
  assert(a == b, "the same answer twice: {a} and {b}");
  assert(a != 0.0, "and it does pick a side: {a}");
}

fn test_the_body_hides_and_returns_at_different_lengths() {
  // ⚠ TWO THRESHOLDS, because the crossing happens in a DOORWAY — the one place a
  // player is guaranteed to stand still. One threshold is a design that fails
  // precisely where it is looked at.
  assert(hex_editor::body_shown(3.0, true), "at length the body is drawn");
  assert(!hex_editor::body_shown(0.5, true), "collapsed, it is not");
  assert(!hex_editor::body_shown(0.9, false),
         "and between the two thresholds it stays hidden once hidden");
  assert(hex_editor::body_shown(0.9, true),
         "while it stays shown once shown — which is what stops the flicker");
  assert(hex_editor::BODY_SHOW > hex_editor::BODY_HIDE, "the band is a band");
}

fn test_the_skin_clears_half_a_wall_band() {
  // ⚠ THE ONE ROW THAT WOULD HAVE CAUGHT THE EYE ENDING UP INSIDE THE MASONRY.
  // `sweep_path` reports a hit on an EDGE, which is a line on the lattice; the wall
  // drawn on that edge is a band `wall_band()` wide, centred on it. So a skin under
  // half a band stops the boom inside the material — and with nothing culling
  // backfaces the far face is then a millimetre from the lens and takes the whole
  // frame. Measured before the fix, walking a 5x4 room: 39% masonry at one station
  // and 99.7% at the next, with the eye crossing the wall's inner face between them.
  //
  // The claim is a RELATION, not a value: whatever the family's band becomes, the
  // skin has to clear half of it, and this fails the day one moves without the other.
  half = hex_editor::wall_band() * 0.5;
  assert(hex_editor::CAM_SKIN > half,
         "the skin {hex_editor::CAM_SKIN} clears half a band {half}");
  // …and by a real margin rather than a float's worth, or a boom that stops exactly
  // on the face still shows a plane edge-on across the frame.
  assert(hex_editor::CAM_SKIN - half > 0.05,
         "with a margin: {hex_editor::CAM_SKIN - half}");
}

fn test_an_unobstructed_boom_takes_its_whole_length() {
  // ⚠ THE ROW THAT WAS MISSING, AND ITS ABSENCE COST A NINTH OF THE BOOM OUTDOORS.
  // `cam_free_dist` returns `want` when the march finds NOTHING, so "free == want"
  // is the sweep saying *nothing constrained this* — and subtracting a clearance
  // from a thing that was never found took the open-field boom to `want - skin`
  // every time. It read 5.66 against 5.86 for a year and nobody looked; at half a
  // wall band it read 5.33, and the gate's outdoor control is what noticed.
  //
  // The claim is stated at three skins so it cannot be satisfied by one lucky value.
  for sk in [0.0, 0.20, hex_editor::CAM_SKIN] {
    assert(hex_editor::boom_take(5.0, 5.0, sk) == 5.0,
           "free == want takes the whole boom at skin {sk}");
    assert(hex_editor::boom_take(5.0, 9.0, sk) == 5.0,
           "and free BEYOND want takes it too, at skin {sk}");
  }
  // …while anything the march actually found still costs a skin, or the fix above
  // would be a licence to put the eye in the wall.
  got = hex_editor::boom_take(5.0, 4.0, 0.5);
  assert(got == 3.5, "a found obstruction still keeps its skin: {got}");
}
