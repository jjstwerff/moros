//
// AN EDITING SESSION, WITH NO SOCKET IN IT — the state a gate needs and nothing else.
//
// ⚠ WHY THIS EXISTS. Every gesture is already a function in this package, so the
// server does not own the editing — but it does own the STATE the gestures are
// applied to, and that is what forced a gate to start one. Beside the `VoxelWorld` the
// server carries eight registries: the wall runs, the roof plans, the door leaves,
// the openings, the annexes, the props, the slabs and the holes. `part_mode.mjs` says
// it plainly — *"those are the SERVER's records for the world being edited, not the
// store's"* — and no message reads them back, so a test that wanted them had to drive
// a socket and photograph the result.
//
// They are all types of THIS package. Only the holding was the server's, and holding
// is not editing. `EditSession` holds them, so a test can build a scene, apply the
// same gestures the wire applies, and read the same answers back — in process, in
// milliseconds, with no port, no browser and no tick.
//
// ⚠ WHAT IT DELIBERATELY DOES NOT HOLD, so nobody reads it as the whole editor:
//   · the TICK — the walk, the fall, the camera ease. Those integrate over time and
//     the server is where time lives. A gate about walking is still a gate.
//   · the STREAMING policy — which chunks a client is sent. That is a function of a
//     viewer, and there is no viewer here.
//   · the SENTENCES. `hex_editor` returns an `Ack` carrying numbers; the wire's text
//     is composed in `editor_server`. So a headless test asserts what was DONE and a
//     wire gate asserts what was SAID, which is the division `CLAUDE.md` already
//     draws — and the better half of it, because a count is a fact and a sentence is
//     a presentation of one.
//
// ⚠ AND IT IS NOT A SECOND IMPLEMENTATION. Every function here threads the session's
// own fields into the same gesture the server calls; none of them decides anything.
// If one ever did, the two paths could disagree and the headless answer would be
// worth nothing — which is the trap `editor_run.loft` was written to avoid and this
// inherits. `make headless-same` is the check that they still agree.
use self::gesture;
// What a world DECLARES a house type to be — plan 22 `T1b`. A type carries the
// opening an author gets when they have chosen none, and the reader of that default
// is the gesture that cuts one, which is in this file.
use self::htype;
use hex_voxel;
use hex_grid;
// ⚠ THE FIRST `use say` IN THIS FILE, and it is the file's own note above being taken
// at its word rather than an exception to it. *"The SENTENCES … are composed in
// `editor_server`"* was true when this was written and stopped being true when
// `say.loft` was cut out of the server — so a sentence a gate reads belongs there, and
// the three composed inline below (`a bed … in the box`, `hole refused — …`) are the
// residue of the older arrangement rather than the rule.
use self::say;

// ⚠ `EditSession`, NOT `Session`. `ssh` publishes `pub struct Session` and a struct
// name is GLOBAL across a consumer's dependency graph — two declarations merge into
// one with whichever field types were declared last, and the diagnostic never
// mentions a collision. Grepped before it was written; see CLAUDE.md.
// ⚠ THE WORLD IS **NOT** IN HERE, AND THAT IS A LOFT DEFECT SHOWING THROUGH — but it
// is also the better shape, which is why it is not written as a grudging workaround.
//
// It was a field. Under `loft --tests` a gesture called with `w` SIGSEGVs the
// runner at 169, 289 and 441 ground cells and NOT at 49 or 625, while the same calls as
// a program are fine at every size — memory corruption rather than a limit, filed as
// loft#796 and related in shape to #775 and #774.
//
// And the honest design is the same: the `VoxelWorld` is already the argument every gesture
// takes, and the server's own registries are what nothing else could hold. A session
// that owned the world too would be a second place a world can live, which is the thing
// `HEX_STACK.md`'s first invariant forbids — the store is the only authority.
// ⚠ AND THE SERVER HOLDS ONE OF THESE NOW — not a parallel set of nine locals.
// `editor_server.loft` carried each registry as its own variable and passed all nine
// to `chunk_meshes_all` at four call sites; part mode held each aside by hand. Two
// shapes of one state is how the wire and a headless test come to disagree about
// what a scene IS, so there is one type with two drivers.
//
// ⚠ EXCEPT THE POSE, DELIBERATELY. `es_author` is a driver's stand-in for a walker —
// a test has no tick, so it teleports. The server HAS a walker and writes `px`/`pz`/
// `yaw` from it, and a session author kept in step there would be a second authority
// on where the author is. Read `es_author` as *this driver's pose*, never as *the
// editor's*.
pub struct EditSession {
  es_author: Author,
  // The eight the server holds beside the store. Empty is a legal scene: a world with
  // no house in it has no wall runs, and `chunk_mesh_props` already keeps the fallback
  // paths that makes it take.
  es_runs:    WallRuns,
  es_awalls:  WallRuns,      // an annex's walls are their own run set
  es_roofs:   RoofPlans,
  es_leaves:  DoorLeaves,
  es_open:    Openings,
  es_annex:   Annexes,
  es_props:   Props,
  es_slabs:   Slabs,
  es_holes:   Holes,
  // ⚠ THE TWO-PRESS DRAFT IS STATE TOO, and it was the server's until `25:`'s
  // machine moved. A run is two presses; what sits between them belongs with the
  // rest of the scene rather than beside the socket that delivered the keys.
  es_draft:   WallDraft = WallDraft {},
  // ⚠ THE LAST RING, AND IT IS SCENE STATE FOR THE SAME REASON THE RUNS ARE —
  // plan 22 `R1b`. A ring of wall is a cylinder and a cylinder is a host, but it is
  // stored as EDGES rather than as a run (correctly: it has no ends), so nothing
  // `annex_host` looks for would find it. This is the ninth registry, and it was
  // four locals beside the socket until `R1b` — which meant `K` could only mean
  // "on that trunk" for the one driver that happened to keep them.
  es_trunk:   Trunk = Trunk {},
  // ── THE SELECTION — plan 22 `S2b`, and it is NOT a registry ─────────────────
  //
  // The nine above are records ABOUT THE STORE — `session_scene_clear` empties them
  // when the store is replaced. This is not one of them: it is what THIS AUTHOR has
  // chosen, which is `es_author`'s category. Two clients editing one world hold two
  // selections, and neither belongs in the world's bytes — which is what killed
  // `S1`'s round-trip test and merged it into this step.
  //
  // ⚠ IT SURVIVES A LOAD AND A PART, deliberately: choosing a round-headed door and
  // then opening a part should not silently hand you back a flat one.
  //
  // ⚠ AND IT HOLDS THE WIRE'S OWN ENCODING FOR NOW — units the outline, tens the
  // depth, twenties the composition. Splitting it into *outline* and *how deep* is
  // the right shape and is deliberately not done here: the step that needs it is the
  // one where six keys collapse to one verb, and inventing the split before then
  // would be designing a container for contents nobody has measured.
  es_open_kind: integer = OP_ROUND,
  // ── …AND WHETHER THIS AUTHOR EVER CHOSE IT — plan 22 `T1b` ─────────────────
  //
  // ⚠ **A SECOND FIELD, BECAUSE `OP_ROUND` IS A LEGAL CHOICE AND ALSO THE DEFAULT.**
  // A house type declares the opening an author gets *unless overridden*, and
  // *overridden* cannot be read off `es_open_kind` alone: an author who deliberately
  // chose `OP_ROUND` and an author who has chosen nothing hold the same number. The
  // field above says WHAT and this one says WHETHER, which is the only pair that can
  // tell them apart.
  //
  // ⚠ **AND IT IS NOT A SENTINEL IN `es_open_kind`**, which the note above already
  // refuses for its own reason: *a session that never chose must still cut something
  // defensible rather than an invalid value every caller must test for*. A sentinel
  // would also have moved every session digest and every `H:` line in the corpus,
  // where this moves nothing until a world declares a type.
  //
  // ⚠ **ONE-WAY, FOR NOW, AND SAID OUT LOUD.** Nothing clears it, so an author who
  // has chosen once stops seeing type defaults. That is the same shape a brush has
  // and it is not obviously right — `session_select_part` takes an empty name to mean
  // *nothing chosen*, and a bare `49:` doing the same here is the answer the day
  // somebody wants one. It is a declaration change, not a mechanism change.
  es_open_set: boolean = false,
  // ── WHICH PART IS CHOSEN — plan 22 `B2e` ───────────────────────────────────
  //
  // Empty means *none*, and that is a real state rather than a missing one: with
  // nothing chosen the placing verb builds the procedural house it always did, so
  // a driver that never selects behaves exactly as it did before this field
  // existed.
  //
  // ⚠ A NAME, NOT A LOADED WORLD. A part is a file, the two drivers read it from
  // different places (a disk, a baked base tree), and a session that held bytes
  // would be a second copy of the library going stale behind whoever edits it.
  es_part: text = "",
  // ── WHICH SEAT IS CHOSEN — plan 22 `K3` ────────────────────────────────────
  //
  // `Y` and `T` are one gesture on one message (`38:0`, `38:1`), differing by the
  // thing seated. That is `es_open_kind`'s situation and takes its answer: the key
  // stops carrying the kind and the selection holds it.
  //
  // ⚠ IT DEFAULTS TO A BED because `PROP_BED` is `0` and a session that never chose
  // must still seat something defensible — the same reason `es_open_kind` defaults to
  // `OP_ROUND` rather than to an invalid sentinel that every caller must test for.
  es_seat_kind: integer = PROP_BED,
  // ── WHICH ANNEX IS CHOSEN — plan 22 `K3` ───────────────────────────────────
  //
  // `J`, `K` and `V` are three keys on one message (`37:0`, `37:1`, `37:2`). Same
  // situation, same answer. ⚠ It defaults to `AN_BOX`, which is `0` — a session that
  // never chose hangs the bedstee `J` always hung.
  es_annex_kind: integer = AN_BOX,
}

// A session over a fresh world, at the constants the editor uses.
//
// ⚠ THE CONSTANTS ARE THE CALLER'S, and that is not laziness. A scene built at a
// different `ε` is a different world however identical the script — `editor_run.loft`
// says so at the top — so a test that wants the editor's world states the editor's
// numbers rather than inheriting a default that could drift away from them.
pub fn session_new() -> EditSession {
  EditSession {
    // ⚠ 0.0 IS HONEST HERE AND NOWHERE ELSE: a fresh session has no world yet,
    // and the first `session_at` derives the real height from one.
    es_author: author_at(0.0, 0.0, 0.0, 0.0),
    es_runs:   WallRuns { items: [] },
    es_awalls: WallRuns { items: [] },
    es_roofs:  RoofPlans { items: [] },
    es_leaves: DoorLeaves { items: [] },
    es_open:   Openings { items: [] },
    es_annex:  Annexes { items: [] },
    es_props:  Props { items: [] },
    es_slabs:  Slabs { items: [] },
    es_holes:  Holes { items: [] },
  }
}

// Everything the session records ABOUT ONE WORLD, emptied — the nine registries and
// the half-laid run between them.
//
// ⚠ THE REGISTRIES DESCRIBE THE STORE, SO A DIFFERENT STORE HAS NONE OF THEM. That
// is `part_thumb_wire`'s argument — *a part has no runs, roofs, leaves or dressing of
// its own* — and it is not only about parts: **loading a world is the same event**.
// Measured 2026-08-11 through the socket: build a house, save, load a world with no
// house in it, and `37:` still built a balcony on the vanished house's wall. The
// store said flat ground and the session said cottage, and the annex believed the
// session — because `annex_host` is pure geometry over `es_runs` and never asks the
// world at all. `36:` refused correctly in the same breath, because it reads the
// store. **Two authorities, one of them describing a world that is gone.**
//
// ⚠ EMPTY IS NOT A LOSS OF THE HOUSE — it is a loss of the RECORDS, and the drawn
// result degrades to the one the fallback already gives: `chunk_mesh_props` reads
// per-edge panels and a roof from cells when there are no plans. The alternative is
// to put the registries in the world's own bytes, which is a FORMAT question and a
// plan of its own; until then, admitting the loss beats describing another world.
//
// ⚠ THE POSE IS NOT IN HERE, deliberately. `es_author` is a driver's stand-in for a
// walker — the server keeps writing it from its own — and a load does not teleport
// anybody. The DRAFT is, and that is the one thing this clears that part mode did
// not: a two-press run whose first press was in the world you just closed would lay
// a wall between two different worlds.
pub fn session_scene_clear(s: EditSession) {
  s.es_runs   = WallRuns { items: [] };
  s.es_awalls = WallRuns { items: [] };
  s.es_roofs  = RoofPlans { items: [] };
  s.es_leaves = DoorLeaves { items: [] };
  s.es_open   = Openings { items: [] };
  s.es_annex  = Annexes { items: [] };
  s.es_props  = Props { items: [] };
  s.es_slabs  = Slabs { items: [] };
  s.es_holes  = Holes { items: [] };
  s.es_trunk  = Trunk {};
  s.es_draft  = WallDraft {};
}

// Ground under the scene. Every gate that builds anything starts by making somewhere
// to build it, and a gesture on unauthored ground is a different test.
pub fn session_ground(w: VoxelWorld, half: integer, h: integer, mat: integer) {
  for q in 0 - half..half + 1 {
    for r in 0 - half..half + 1 { ground_set(w, q, r, h, mat); }
  }
}

// ── where the author is ──────────────────────────────────────────────────────
//
// ⚠ IN WORLD UNITS, AS `7:` TAKES THEM. A gesture reads the author's position and
// derives its own hex, so a session that placed by hex would be doing the conversion
// the editor does and could do it differently.
// ⚠ IT TAKES THE WORLD NOW — plan 22 `R1a`. The wire's `7:` carries x, z and yaw
// because that is what a person typed; the ground under those coordinates is a fact
// about the WORLD, so a teleport derives it rather than inventing a zero. A session
// that kept 0.0 here would put a fence on the ground floor of a building whose
// author had just walked upstairs.
pub fn session_at(s: EditSession, w: VoxelWorld, x: float, z: float, yaw: float) {
  s.es_author = author_on(w, x, z, yaw);
}

// ── the gestures, threaded ───────────────────────────────────────────────────
//
// One line each, and each one calls exactly what the server's handler calls. The
// value is not the wrapper; it is that a caller does not have to know which of the
// nine registries a given gesture happens to touch — which is knowledge the server's
// message loop encodes and nothing else did.

pub fn session_raise(s: EditSession, w: VoxelWorld, dir: integer) -> Ack {
  raise_ahead(w, s.es_author, dir)
}

// ⚠ THERE IS NO `session_house`, AND THE REASON IS THE MODULE GRAPH RATHER THAN A
// CHOICE. `place_house` is declared in the ENTRY module, which uses this one, so a
// wrapper here would be a cycle. A caller says
// `place_house(w, s.es_author, w, d, grade, s.es_runs)` — which is the
// server's own call with the session's fields in it, and reads no worse. That is the
// shape for every gesture the entry owns; the wrappers below exist only for the ones
// in `gesture`, and only because they thread a registry a caller would otherwise have
// to know about.

// A ring, and the trunk it leaves behind — plan 22 `R1b`, and the one place both.
//
// ⚠ THE TWO WERE SEPARATE AND THAT IS THE DEFECT THIS CLOSES. `editor_server` rang
// the disc in `do_fence` and remembered the cylinder eleven hundred lines away in
// its message loop, so a second driver could ring perfectly and leave `K` nothing to
// attach to — which is exactly what `press` did. One call does both, and a driver
// that only wanted the ring cannot get half of it.
//
// ⚠ A REFUSED RING RECORDS NOTHING, and that is a decision rather than a
// transcription. The server's loop recorded the cylinder from the PAYLOAD, after
// `do_fence` had already returned early on a refusal — so `23:9,2` (not a wall
// material) left a phantom trunk of radius 2 standing where no edge had been
// written, and the next `K` would have hung a balcony on it.
//
// ⚠ THE AUTHOR IS EXPLICIT, NOT `s.es_author`. The pose is the DRIVER's — a server
// writes it from its walker and knows the interpolated height under the feet, a test
// teleports — so the ring takes the pose it is given, exactly as `press` does.
// `session_fence` below is the same call for a driver whose pose IS the session's.
pub fn ring_set(s: EditSession, w: VoxelWorld, a: Author, mat: integer, rad: integer,
                ref: float) -> Ack {
  rs_ack = fence_ring(w, a, mat, rad, ref, s.es_runs);
  if rs_ack.ak_ok { s.es_trunk = trunk_of(a, rad); }
  rs_ack
}

pub fn session_fence(s: EditSession, w: VoxelWorld, mat: integer, rad: integer, ref: float) -> Ack {
  ring_set(s, w, s.es_author, mat, rad, ref)
}

pub fn session_open(s: EditSession, w: VoxelWorld, kind: integer, nedges: integer) -> Ack {
  open_ahead(w, s.es_author, kind, nedges)
}

// ── THE SELECTION, AND THE GESTURE THAT READS IT — plan 22 `S2b` ─────────────
//
// ⚠ CHOOSING IS A GESTURE TOO, and it refuses the way every other one does. A kind
// that is not one is NOMINAL — `5` is not *nearly* an oculus — so it is refused
// without an offer, and the selection does not move. A verb that clamped would let
// an author pick a niche and get a doorway with nothing said.
pub fn session_select_open(s: EditSession, kind: integer) -> Ack {
  if !opening_kind_ok(kind) {
    return ack_no("{kind} is not an opening kind; nominal, so there is no nearest one");
  }
  s.es_open_kind = kind;
  // ⚠ **THE CHOICE IS RECORDED AS A CHOICE — plan 22 `T1b`, and only on the way that
  // SUCCEEDS.** A refused kind must leave the author exactly as they were, which
  // includes leaving them un-chosen: setting this above the guard would let a typo
  // silence a house type for the rest of the session.
  s.es_open_set = true;
  ack_ok(kind)
}

// ── CHOOSING A PART — plan 22 `B2e`, and it is `session_select_open`'s shape ──
//
// ⚠ THE NAME IS CHECKED, NOT TRUSTED, and by the package that owns what a part name
// is: `hex_part::part_name_ok` is the inverse of `part_list`, and the server's
// `place_part` already calls it under the note *"this site, `44:` and `8:` each
// spelled out their own `..` check … three copies is how one of them comes to
// disagree."* A fourth here would be that again.
//
// ⚠ AND IT DOES NOT CHECK THAT THE PART EXISTS, deliberately. Whether a name is
// well-formed is a fact about the name; whether a file is there is a fact about a
// LIBRARY, and the two drivers look in different places. The placing gesture
// refuses a part it cannot load, with the reason, which is where that answer can
// actually be known.
pub fn session_select_part(s: EditSession, name: text) -> Ack {
  if name == "" {
    s.es_part = "";
    return ack_about(0, "nothing chosen — the placing verb builds a house again", 0);
  }
  nk = hex_part::part_name_ok(name);
  if nk.nk_code != hex_part::PN_OK { return ack_no(nk.nk_why); }
  s.es_part = name;
  ack_about(1, "part '{name}' chosen", 0)
}

// One press of the opening gesture, with the profile taken from the SELECTION
// rather than from the key that was pressed.
//
// ⚠ THIS IS THE WHOLE POINT OF THE SELECTION EXISTING, and it is why `S1` could not
// be built on its own: a chosen profile's only possible consumer is the gesture that
// cuts one, and until `S2a` moved the choosing out of `editor_server`'s `36:`
// handler there was nothing here to consume it.
//
// ⚠ BOTH HALVES, IN THE HANDLER'S OWN ORDER. `open_ahead` writes the store — the
// edge material, which is what `X70` protects — and `opening_make` decides the
// SHAPE, which lives beside the store because a profile is the picture's business.
// A wrapper that did only the second would leave a hole in the drawing and a whole
// wall in the world.
//
// ⚠ `w.w_unit`, NOT A GLOBAL. `R1a`'s finding, one gesture over: a part world is
// authored at another unit entirely, so an arch struck against `hex_proj`'s constant
// would be right on the landscape and wrong on every part.
pub fn session_opening(s: EditSession, w: VoxelWorld, a: Author, up: integer) -> OpeningMade {
  session_open_kind(s, w, a, open_kind_here(s, w, a.au_x, a.au_z), up)
}

// ── WHAT THE NEXT OPENING WILL CUT — plan 22 `T1b` ──────────────────────────
//
// > *"…each producing the TYPE's defaults unless overridden"*
// > — [EDITING_MODES](../../../doc/claude/EDITING_MODES.md)
//
// ⚠ **THIS IS ONE DERIVATION WITH TWO READERS, AND THAT IS WHY IT IS A FUNCTION.**
// The gesture needs it, and so does the SUBJECT LINE — `editor_server`'s `H:` says
// what you are working on, and it read `es_open_kind` at twelve sites. With a type
// default in play those are two different numbers: the panel would say *round* while
// the next press cut *pointed*, which is the one thing a subject line exists to make
// impossible ([CATALOGUE](../../../doc/claude/CATALOGUE.md) §C1).
//
// ⚠ **THE REGION IS THE AUTHOR'S, NOT ZERO** — plan 21 `R2`'s rule, and `press_verb`'s
// place arm already reads its dimensions that way. A type belongs to where its author
// is standing, so asking region 0 would make types global while the palette they live
// in is not, and the divergence would appear on the first world with two regions.
//
// ⚠ **AND IT TAKES x/z RATHER THAN AN `Author`** because the subject line's callers
// hold a walker and not a pose, and a helper that made twelve broadcast sites
// construct an `Author` to ask a question about a region would not be called at
// twelve sites for long.
pub fn open_kind_here(s: EditSession, w: VoxelWorld, x: float, z: float) -> integer {
  if s.es_open_set { return s.es_open_kind; }
  (okq, okr) = hex_grid::px_to_hex(x, z);
  ht = house_type(w, hex_voxel::world_region_at(w, okq, okr), HTYPE_DEFAULT_SLOT);
  // ⚠ A BROKEN DECLARATION FALLS BACK RATHER THAN REFUSING **HERE**, and the place
  // arm's opposite choice is not an inconsistency. `place` cannot proceed without
  // `wid`/`dep`, so it refuses and says why; an opening needs nothing from the type
  // at all, so refusing one would make a malformed field the author cannot see stop a
  // gesture that does not depend on it. The refusal an author must not miss already
  // fires, on the verb that needs the number.
  if !ht.ht_ok || ht.ht_open < 0 { return s.es_open_kind; }
  ht.ht_open
}

// …and the same gesture told which kind THIS TIME — plan 22 `S3`.
//
// ⚠ THE ONE-SHOT DOES NOT MOVE THE SELECTION, and that is the decision the collapse
// turned on rather than a detail. Six keys reach ONE gesture now instead of six
// branches, which is the collapse; what they do NOT do is re-choose. `36:<kind>` on
// the wire does not either, so a key means the same thing in every driver — which is
// `W4`'s whole invariant, and the thing that would have been broken by the obvious
// alternative.
//
// ⚠ THE ALTERNATIVE, WRITTEN DOWN BECAUSE IT LOOKS RIGHT: let a key mean *choose
// this and cut it*, the way picking a brush works. It is defensible — pressing `N`
// arguably IS what you are now working on — and it was refused for one reason: the
// wire's `36:<kind>` would have to move the selection too, or the runner and the
// server would leave different SESSIONS from one keystroke while leaving identical
// worlds, and the equality test that proves the collapse looks at worlds. A
// divergence under a green test is the exact shape `W4` exists to prevent.
//
// The key stops carrying a profile at `V1`, by which point the scripts say
// `select` and `opening` — and then this entry point is the only one left.
pub fn session_open_kind(s: EditSession, w: VoxelWorld, a: Author, kind: integer,
                         up: integer) -> OpeningMade {
  // ⛔ **THE SHAPE IS DECIDED FIRST, AND THE ORDER IS THE FIX — plan 22 `D1a.2`.** This
  // was `open_ahead(w, a, DOOR_MAT, 1)` and then `opening_make`: the store was marked
  // before anything knew how WIDE the opening would be, so it could only ever mark a
  // fixed number of edges — one — and a doorway 1.3 world units across landed on a
  // single 0.87 wu edge. Measured in [`probe/d2`](../../../probe/d2/README.md): the
  // walker met the edge still marked a wall and stopped **outside the house**, so the
  // `inside` editing mode was unreachable by walking in every driver.
  //
  // ⚠ `opening_make` WRITES NOTHING — it reads the runs and the standing openings and
  // returns a shape — so putting it first costs no atomicity. What still holds is the
  // clause the previous order was written for: the store is marked before the session
  // records anything, so a refusal at either half leaves nothing behind.
  so_made = opening_make(s.es_runs, s.es_open, a.au_x, a.au_z, kind, up, w.w_unit);
  if !so_made.om_ok { return so_made; }
  so_ack = open_span(w, a, DOOR_MAT, so_made.om_open.op_x, so_made.om_open.op_z,
                     so_made.om_open.op_half);
  if !so_ack.ak_ok {
    return OpeningMade { om_ok: false, om_why: so_ack.ak_why, om_open: opening_none(),
                         om_kind: kind };
  }
  s.es_open.items += [so_made.om_open];
  // ⚠ **THE CELL COMES BACK WITH THE ANSWER — plan 22 `S2c`.** `open_span` searched
  // the author's own cell and then the one they face, and it is the only thing here
  // that knows which of the two carried the wall. A driver marking a chunk dirty from
  // the author's position instead would be right most of the time and wrong exactly
  // when the opening went into the cell ahead, which is the common case for a walker.
  so_made.om_q = so_ack.ak_q;
  so_made.om_r = so_ack.ak_r;
  so_made
}

// `12:` — a storey up, or a cellar down, under where the author is STANDING.
//
// ⚠ THIS ONE DERIVES A CELL, and it is the only wrapper that does — so it is the only
// one that could disagree with the server. It does not, and here is why in full: the
// handler is `shx = world_to_hex(px, pz); storey_add(wld, shx.ha_q, shx.ha_r, …)`, and
// `moros_render::world_to_hex` is a two-line delegation to `hex_grid::px_to_hex` — the
// same mapping, checked, not assumed. `hex_editor` cannot call `world_to_hex` itself:
// that would point this package at `moros_render`, which is the arrow the layering
// guard exists to forbid.
//
// ⚠ AND THE RADIUS IS COUPLED BY A LITERAL. The handler writes a bare `2`
// (`src/editor_server.loft`, the `MSG_STOREY` branch); `STENCIL_R` is that 2, because a
// cellar is dug under the built-in house's footprint. If either moves without the
// other, this wrapper and the wire stop describing the same gesture — and no test can
// see it, because both sides would still be internally consistent. Named here because a
// grep is the only instrument there is.
//
// Returns `storey_add`'s count: negative is a refusal, and `why` says which.
pub fn session_storey(s: EditSession, w: VoxelWorld, dir: integer, why: &text) -> integer {
  (sq, sr) = hex_grid::px_to_hex(s.es_author.au_x, s.es_author.au_z);
  storey_add(w, sq, sr, dir, STENCIL_R, why)
}

// ── AN ATTACHED VOLUME — `37:`, plan 22 `K3` ────────────────────────────────
//
// ⚠ **THREE KEYS ON ONE MESSAGE** — `J` a bedstee, `K` a balcony, `V` a cupboard —
// which is the seat family again with one more member, and it takes the same answer:
// one `annex` verb, and the kind comes from the selection.
//
// ⚠ **AND THE THIRD KIND IS NOT A STORED KIND, WHICH IS WHY IT HAS ITS OWN NAME.**
// `AN_BOX` and `AN_DECK` are what an `Annex` *is*, and `37:0`/`37:1` pass straight
// through to `annex_build` as exactly that. `37:2` selects a different CONSTRUCTION —
// `annex_cupboard`, hosted on the last box rather than on a wall — and the annex it
// returns is an `AN_BOX`. So the payload space is two stored kinds plus one gesture
// kind, and calling the third `AN_CUPBOARD` would invite somebody to store it.
pub const ANX_CUPBOARD = 2;

pub fn annex_kind_ok(kind: integer) -> boolean {
  kind == AN_BOX || kind == AN_DECK || kind == ANX_CUPBOARD
}

pub fn session_select_annex(s: EditSession, kind: integer) -> Ack {
  if !annex_kind_ok(kind) {
    return ack_no("{kind} is not an annex kind; nominal, so there is no nearest one");
  }
  s.es_annex_kind = kind;
  ack_ok(kind)
}

// ⚠ THE TWO COUNTS TRAVEL BECAUSE THE CUPBOARD'S SENTENCE SAYS THEM, and they are
// counts of the SESSION after the append — a caller re-deriving them would be reading
// the same registry one line later and could not disagree, but would have to know that
// `annexes_runs` rebuilds `es_awalls` wholesale rather than appending to it.
pub struct AnnexMade {
  ax_ok:    boolean,
  ax_say:   text = "",
  ax_kind:  integer = 0,
  ax_walls: integer = 0,       // annex wall runs, after the rebuild
  ax_boxes: integer = 0,       // annexes in the session, after the append
  ax_q: integer = 0, ax_r: integer = 0,
  ax_pad: integer = 0,
}

// `37:` — hang the volume that is chosen on whatever the author is standing at.
pub fn session_annex(s: EditSession, w: VoxelWorld, a: Author) -> AnnexMade {
  session_annex_kind(s, w, a, s.es_annex_kind)
}

// …and the same gesture told which kind THIS TIME. ⚠ THE ONE-SHOT DOES NOT MOVE THE
// SELECTION — `session_open_kind`'s rule, third family to take it.
//
// ⚠ **THE UNIT IS THE WORLD'S, NOT THE GLOBAL**, and that is a fix rather than a
// translation: the handler passed `hex_proj::HEIGHT_SCALE`, and this file's own note at
// `author_on` says why that is wrong — *"the same number (0.25) kept as a global … and
// **wrong on a part world**; a world's own unit is the only answer that survives
// leaving the landscape."* Identical on the editor's world, which is why nothing could
// have gone red, and it is the same global-for-world substitution `hex_mesh` had.
pub fn session_annex_kind(s: EditSession, w: VoxelWorld, a: Author,
                          kind: integer) -> AnnexMade {
  if !annex_kind_ok(kind) {
    return AnnexMade { ax_ok: false, ax_kind: kind,
      ax_say: "annex refused — {kind} is not an annex kind" };
  }
  // ⚠ AN ANNEX IS BUILT FROM THE HOST OUTWARD, so the first thing needed is the host's
  // own outward normal where the author stands. On a wall that is the run's normal; on
  // a trunk — a ring of wall — it is the radial direction. One code path, because a
  // tree is not a special host.
  sa_built = if kind == ANX_CUPBOARD {
               annex_cupboard(s.es_annex, w.w_unit)
             } else {
               annex_build(annex_host(s.es_runs, a.au_x, a.au_z, a.au_yaw, s.es_trunk),
                           kind, hex_draw::BAND_SIDES, w.w_unit)
             };
  if !sa_built.ab_ok {
    return AnnexMade { ax_ok: false, ax_kind: kind, ax_say: sa_built.ab_why };
  }
  // ⚠ THREE REGISTRIES MOVE, NOT ONE, and the middle is a REBUILD rather than an
  // append: whether an annex's wall is left- or right-handed depends on what it abuts,
  // so adding one can change a neighbour's runs. `annexes_runs` re-derives all of them,
  // which is why `es_awalls` is emptied first.
  s.es_annex.items += [sa_built.ab_annex];
  s.es_awalls.items = [];
  annexes_runs(s.es_annex, WALL_MAT, s.es_awalls);
  s.es_open.items += [sa_built.ab_open];
  (aq, ar) = hex_grid::px_to_hex(sa_built.ab_annex.an_x, sa_built.ab_annex.an_z);
  if kind == ANX_CUPBOARD {
    return AnnexMade { ax_ok: true, ax_kind: kind, ax_q: aq, ax_r: ar, ax_pad: 4,
      ax_walls: len(s.es_awalls.items), ax_boxes: len(s.es_annex.items),
      ax_say: "a cupboard beside it — {len(s.es_awalls.items)} walls for "
            + "{len(s.es_annex.items)} boxes" };
  }
  AnnexMade { ax_ok: true, ax_kind: kind, ax_q: aq, ax_r: ar, ax_pad: 4,
    ax_walls: len(s.es_awalls.items), ax_boxes: len(s.es_annex.items),
    ax_say: "an annex of kind {kind} at {aq},{ar} — 3 walls, a deck" }
}

// ── WHAT STANDS IN A VOID — `38:`, plan 22 `K3` ─────────────────────────────
//
// ⚠ **`Y` AND `T` ARE ONE GESTURE, WHICH IS WHY THIS IS A FAMILY AND `run` WAS NOT.**
// `R` was the only key on `25:` and the road had none; `38:0` and `38:1` are two keys
// on ONE message differing by a *thing chosen* — a bed or a figure. That is the
// opening family's shape exactly, and this file's own rule says which way it goes: a
// DIRECTION is part of the action (`raise`/`lower` stay two verbs forever), a THING is
// not. So one `seat` verb, and the kind comes from the selection.
//
// ⚠ **THE SEATING ITSELF WAS ALREADY HERE AND THE ASSEMBLY WAS NOT.** `seat_bed` and
// `seat_statue` pick the void and size the thing; what lived in `editor_server.loft`
// was *which of the two*, the registry append, and the two sentences. The middle one
// is the part that matters — a prop in `es_props` and nothing in the store is what the
// mesher reads, so a driver that seated without filing would draw nothing and report
// success.
pub fn seat_kind_ok(kind: integer) -> boolean { kind == PROP_BED || kind == PROP_STATUE }

// ⚠ NOMINAL, SO A REFUSAL OFFERS NOTHING — `session_select_open`'s wording, and for
// its reason: `2` is not "the nearest seat kind to a statue", it is not a seat kind.
pub fn session_select_seat(s: EditSession, kind: integer) -> Ack {
  if !seat_kind_ok(kind) {
    return ack_no("{kind} is not a seat kind; nominal, so there is no nearest one");
  }
  s.es_seat_kind = kind;
  ack_ok(kind)
}

// ⚠ THE PROP TRAVELS WHOLE. The server prints the bed's LENGTH and the statue's
// HEIGHT — two different fields of the same struct — so a result carrying `sm_size`
// would be this function choosing which one its caller is allowed to say.
pub struct SeatMade {
  sm_ok:   boolean,
  sm_say:  text = "",          // the sentence, refusal and success alike
  sm_kind: integer = 0,
  sm_prop: Prop = Prop {},
  sm_q: integer = 0, sm_r: integer = 0,
  sm_pad: integer = 0,         // how far around it the picture is stale
}

// `38:` — seat the thing that is chosen, in the nearest void that has room.
pub fn session_seat(s: EditSession, a: Author) -> SeatMade {
  session_seat_kind(s, a, s.es_seat_kind)
}

// …and the same gesture told which kind THIS TIME — `session_open_kind`'s shape, and
// its rule with it: ⚠ **THE ONE-SHOT DOES NOT MOVE THE SELECTION.** `38:<kind>` on the
// wire does not either, so a key means the same thing in every driver. A key that
// silently re-chose would make *what am I working on* depend on what you last pressed.
pub fn session_seat_kind(s: EditSession, a: Author, kind: integer) -> SeatMade {
  if !seat_kind_ok(kind) {
    return SeatMade { sm_ok: false, sm_kind: kind,
      sm_say: "seat refused — {kind} is not a seat kind" };
  }
  ss_made = if kind == PROP_BED {
              seat_bed(s.es_annex, a.au_x, a.au_z)
            } else {
              seat_statue(s.es_open, a.au_x, a.au_z, hex_draw::BAND_SIDES)
            };
  if !ss_made.se_ok {
    return SeatMade { sm_ok: false, sm_kind: kind, sm_say: ss_made.se_why };
  }
  // ⚠ FILED BEFORE IT IS REPORTED. `es_props` is the ninth registry and the mesher's
  // only source for a prop — nothing about a seat reaches the store — so a gesture
  // that answered without appending would be a success nobody can see.
  s.es_props.items += [ss_made.se_prop];
  (sq, sr) = hex_grid::px_to_hex(ss_made.se_prop.pr_x, ss_made.se_prop.pr_z);
  if kind == PROP_BED {
    return SeatMade { sm_ok: true, sm_kind: kind, sm_prop: ss_made.se_prop,
      sm_q: sq, sm_r: sr, sm_pad: 3,
      sm_say: "a bed {ss_made.se_prop.pr_len} long in the box" };
  }
  SeatMade { sm_ok: true, sm_kind: kind, sm_prop: ss_made.se_prop,
    sm_q: sq, sm_r: sr, sm_pad: 3,
    sm_say: "a figure {ss_made.se_prop.pr_up} units tall in the niche" }
}

// ── A FLOOR WITH A THICKNESS — `39:0`, plan 22 `K3` ─────────────────────────
//
// ⚠ **THE OTHER HALF OF THE PAIR BELOW, AND IT ARRIVED SECOND FOR A REASON WORTH
// KEEPING.** `Z` took its verb first because `hole` is what `slab.keys` photographs;
// this is the gesture `hole` refuses without. So the two are now `place`/`opening`'s
// relationship end to end — a verb that BUILDS and a verb that CUTS INTO what was
// built — and the refusal one screen down (*"lay a slab first"*) names this one.
//
// ⚠ **AND IT IS THE FOURTH SLICE WHOSE ASSEMBLY WAS AT THE SOCKET AND WHOSE GESTURE
// WAS ALREADY HERE.** `slab_over` — the storey split, the yaw, the extent off the
// footprint — has been `gesture.loft`'s since the band was designed. What sat in
// `editor_server.loft` was the `es_slabs` append, the sentence and where the picture
// went stale, which is the seats' finding and the holes' finding word for word.
//
// ⚠ **THE APPEND IS AGAIN THE HALF THAT MATTERS.** A slab reaches NO STORE — `w_tau`
// does not move — so `es_slabs` is the mesher's only source for a floor *and*
// `slab_hole`'s only source for something to cut through. A driver that laid without
// filing would draw nothing, report success, and then refuse every hole with *no slab
// to cut*, which reads as the hole being broken.

// How far around a laid floor or a cut void the picture is stale, in cells — the
// slab's whole footprint, because both change the surface a floor draws across all
// of it.
//
// ⚠ **IT WAS `HOLE_PAD`, AND ONE NUMBER UNDER TWO NAMES IS THE THING THIS TREE SPENDS
// ITS TIME DELETING** — plan 22 `K3` · `X`. The server marked `HOUSE_W + HOUSE_D + 4`
// for the slab and `hm_pad` for the hole, which are the same footprint for the same
// reason; giving the slab a `SLAB_PAD` of its own beside a `HOLE_PAD` would have been
// two constants that must agree and no instrument that says so.
//
// ⚠ **AND IT IS `HOUSE_W + HOUSE_D + 4` AND CANNOT SAY SO**: those live in the root
// module, which `use`s this one, and a `use` goes one way. So the number is written
// out here and **a test makes the two equal** — the test file can see both, where this
// file cannot. A comment claiming the equality would be the kind of agreement-by-luck
// `WORLD_EPS` was declared twice under.
//
// ⚠ **IT SITS ABOVE BOTH GESTURES THAT READ IT, AND THAT IS NOT TIDINESS.** Declared
// below `session_slab` — where it was, as the hole's own constant — it still RESOLVED
// (measured: `sb_pad = 13`), but `loft test` reported
// *"Variable 'SLAB_PAD' is UPPER_CASE — that style is reserved for constants"* against
// the use site. A forward reference inside one file reads to the linter as a local
// being introduced, so the one diagnostic pointing at a real constant is the one that
// says it is not one. Filed as a gotcha; the fix here is the declaration order the
// shared constant wanted anyway.
pub const SLAB_PAD = 13;

// ⚠ **THE FOOTPRINT IS THE CALLER'S AND THE PITCH IS NOT.** `pose_footprint`,
// `HOUSE_W` and `HOUSE_D` live in the root module, which `use`s this one — so the
// footprint arrives as an argument, exactly as `session_opening` takes `STOREY_H`.
// The pitch and the thickness do NOT: they are `gesture.loft`'s own constants, this
// file can read them, and a socket allowed to pass its own would be the second place
// that decides how tall a storey is.
pub struct SlabLaid {
  sb_ok:   boolean,
  sb_say:  text = "",           // the sentence, refusal and success alike
  sb_slab: Slab = Slab {},
  sb_n:    integer = 0,         // slabs in the session, after the append
  sb_q: integer = 0, sb_r: integer = 0,
  sb_pad:  integer = 0,         // how far around it the picture is stale
}

// `39:0` — lay a floor over the footprint given, one storey above the floor given.
//
// ⚠ **IT CANNOT REFUSE, AND `sb_ok` IS THERE ANYWAY.** `slab_over` is total: a
// footprint and a floor always decompose into a ceiling and the floor above. The field
// is the shape every other gesture in this file answers in, and a caller that had to
// remember *this one is the infallible one* is a caller that will stop checking the
// others too.
//
// ⚠ **THE FLOOR IS THE AUTHOR'S GROUND, NOT THE FOOTPRINT'S.** They differ — a
// footprint is placed AHEAD of the author — and the server has read it under the
// author since the gesture existed. Taking it under the slab instead would move every
// slab ever laid on sloping ground, which is a change to make on purpose and not in a
// step about verbs.
pub fn session_slab(s: EditSession, f: Footprint, floor: integer) -> SlabLaid {
  sb_new = slab_over(f, floor, STOREY_H, SLAB_THICK);
  s.es_slabs.items += [sb_new];
  (sq, sr) = hex_grid::px_to_hex(sb_new.sl_x, sb_new.sl_z);
  SlabLaid { sb_ok: true, sb_slab: sb_new, sb_n: len(s.es_slabs.items),
    sb_q: sq, sb_r: sr, sb_pad: SLAB_PAD, sb_say: say_slab(sb_new, floor) }
}

// ── A VOID THROUGH THE LAST SLAB — `39:1`…`39:3`, plan 22 `K3` ──────────────
//
// ⚠ **`X` AND `Z` ARE TWO VERBS, AND NOT FOR THE STAIR PAIR'S REASON.** `E`/`Q` stayed
// apart because a DIRECTION is part of the action; these stay apart because they are
// **two actions**: `39:0` lays a floor into `es_slabs`, and `39:1`…`39:3` cut a void
// into `es_holes` — different registries, different refusals, and one **cannot run
// until the other has**. That is `place`/`opening`'s relationship exactly (`H` builds a
// house, `O` cuts into its wall), and those have been two verbs since `V1`.
//
// ⚠ **AND WITHIN `hole` THERE IS NO FAMILY TO COLLAPSE YET.** Kinds 1, 2 and 3 differ
// by the THING made — a stairwell, a coffer, a sunken panel — which is the seats'
// situation and would take the seats' answer, **but only kind 1 has a key**. So `Z` is
// one key, one verb, one-to-one: `R`'s situation, and it takes `R`'s answer. The wire
// keeps carrying the RESOLVED kind, and `39:2`/`39:3` reach this gesture with no key of
// their own exactly as `25:3` reaches the run.
//
// ⚠ **A BARE `39:` IS A SLAB, NOT A CHOSEN HOLE.** The handler reads
// `payload as integer ?? 0` and `0` is the slab — so the trick `36:`, `37:` and `38:`
// all use, *empty payload means the one I chose*, is **unavailable on this id** and
// would silently lay a floor where an author asked for a hole. Said out loud here
// because the next person to add a selection will reach for it.

// How big a void this gesture cuts, as half-extents in world units. ⚠ IT IS A
// CONSTANT RATHER THAN A LITERAL AT THE SOCKET, for `WORLD_EPS`'s reason: it was
// `2.0, 2.0` written at the one call site, and a second driver would have picked its
// own number with every test green on both.
pub const HOLE_HALF = 2.0;

// ⚠ THE HOLE TRAVELS WHOLE, like the seat's prop: a caller may want the reveal, the
// datum or the extents, and a result carrying one of them would be this function
// choosing which its caller is allowed to say.
pub struct HoleMade {
  hm_ok:   boolean,
  hm_say:  text = "",           // the sentence, refusal and success alike
  hm_kind: integer = 0,
  hm_hole: Hole = Hole {},
  hm_n:    integer = 0,         // holes in the session, after the append
  hm_q: integer = 0, hm_r: integer = 0,
  hm_pad: integer = 0,          // how far around it the picture is stale
}

// `39:1` — cut the void this verb names through the slab last laid.
pub fn session_hole(s: EditSession, a: Author) -> HoleMade {
  session_hole_kind(s, a, HOLE_THROUGH)
}

// …and the same gesture told which kind THIS TIME.
//
// ⚠ **THE HOST IS THE LAST SLAB AND THAT IS `slab_hole`'s RULE, NOT THIS FUNCTION'S.**
// What was at the socket is the three lines below it: the `es_holes` append, the
// sentence, and where the picture went stale.
//
// ⚠ **AND THE APPEND IS THE ONE THAT MATTERS — NOTHING ABOUT A HOLE REACHES THE
// STORE.** `es_holes` is a session registry and the mesher's only source for a void,
// so a driver that cut without filing would report success and draw an unbroken floor.
// Which also makes a saved world **structurally blind** to this gesture, exactly as it
// is to a seat: the sentence is the instrument, and `probe/k2` check 2 cannot fail here.
pub fn session_hole_kind(s: EditSession, a: Author, kind: integer) -> HoleMade {
  hk_cut = slab_hole(s.es_slabs, kind, a.au_x, a.au_z, HOLE_HALF, HOLE_HALF);
  if !hk_cut.hx_ok {
    return HoleMade { hm_ok: false, hm_kind: kind, hm_hole: hk_cut.hx_hole,
      hm_say: "hole refused — {hk_cut.hx_why}" };
  }
  s.es_holes.items += [hk_cut.hx_hole];
  (hq, hr) = hex_grid::px_to_hex(hk_cut.hx_hole.ho_x, hk_cut.hx_hole.ho_z);
  HoleMade { hm_ok: true, hm_kind: kind, hm_hole: hk_cut.hx_hole,
    hm_n: len(s.es_holes.items), hm_q: hq, hm_r: hr, hm_pad: SLAB_PAD,
    hm_say: "a hole of kind {kind} through the slab" }
}

// ── A RUN, END TO END — `25:`, plan 22 `K3` ─────────────────────────────────
//
// ⚠ **THE STAMPING HALF WAS NEVER HERE, AND THE WRAPPER THAT WAS HID IT.**
// `session_wall` moved the two-press MACHINE into the library and stopped at the
// draft; *which material lays which shape, at what grade, into which registry* stayed
// in `editor_server.loft`. Measured before this step: `session_wall` had four callers
// and **every one of them was a test** — which is this tree's commonest defect wearing
// a wrapper's clothes, and it read as coverage because the tests were green.
//
// ⚠ **AND THAT IS WHY `R` IS THE SLICE TO TAKE FIRST**: 22 of the 40 non-arrow key
// presses across `tools/scripts/*.keys` are `R`, so the gesture with the least
// library behind it was the one the scripts lean on hardest.
//
// ⚠ THE GRADE IS TAKEN AT THE NEAR END, which is the decision `wall_stamp` and
// `road_stamp` both rest on: a way is GRADED, so it takes one height for its whole
// run rather than following every bump under it. The near end is `wd_x`/`wd_z`, and
// it survives `wall_step` closing the draft — only `wd_open` is cleared.
pub const RL_STARTED = 0;   // the near end is recorded; press again to close
pub const RL_LAID    = 1;
pub const RL_REFUSED = 2;   // …and the draft is closed either way

// ⚠ **TWO ENDS, AND `Ack` CARRIES ONE.** A run spans from a near cell to a far one
// and a caller with a picture has to rebuild around **both** — which is why this is
// its own answer rather than an `Ack`. The server marked two dirty discs from numbers
// it derived itself; a library that handed back a single anchor would force it to go
// on deriving them, which is the re-derivation `ak_q`/`ak_r` exists to stop.
pub struct RunLaid {
  rl_code:   integer,
  rl_say:    text = "",        // the whole sentence, refusal and success alike
  rl_wall:   boolean = false,  // the line itself, or a road and two fences
  rl_n:      integer = 0,      // edges marked (a wall) or cells paved (a road)
  rl_fenced: integer = 0,
  rl_cut:    integer = 0,
  rl_step:   integer = 0,
  rl_resid:  float = 0.0,
  rl_reach:  float = 0.0,
  rl_q0: integer = 0, rl_r0: integer = 0,
  rl_q1: integer = 0, rl_r1: integer = 0,
  rl_pad: integer = 0,         // how far around each end the picture is stale
}

// `25:` — a press of the run key, at wherever this driver stands.
//
// ⚠ THE MATERIAL IS THE CALLER'S, and until a selection holds it that is the honest
// shape rather than a shortcut: `25:1` is a wall and `25:3` a road, both reach this
// from the wire today, and only one of them has a key. See `VB_RUN`.
pub fn session_run(s: EditSession, w: VoxelWorld, a: Author, mat: integer) -> RunLaid {
  sr_fit = fit_nominal(mat, FENCE_MAT, "wall material");
  if !sr_fit.ft_ok {
    return RunLaid { rl_code: RL_REFUSED, rl_say: "road refused — {fit_why(sr_fit)}" };
  }
  sr_st = wall_step(s.es_draft, a.au_x, a.au_z, mat);
  if sr_st.ds_code == DS_STARTED {
    return RunLaid { rl_code: RL_STARTED,
                     rl_say: "road started at {a.au_x},{a.au_z}" };
  }
  if sr_st.ds_code == DS_REFUSED {
    return RunLaid { rl_code: RL_REFUSED, rl_say: "road refused — {sr_st.ds_why}" };
  }
  sr_run = sr_st.ds_run.rd_run;
  sr_step = sr_st.ds_run.rd_step;
  sr_resid = sr_st.ds_run.rd_resid;
  sr_reach = sr_st.ds_run.rd_reach;
  (sr_gq, sr_gr) = hex_grid::px_to_hex(s.es_draft.wd_x, s.es_draft.wd_z);
  sr_grade = terrain_h(sr_gq, sr_gr, w);
  (sr_q0, sr_r0) = hex_grid::px_to_hex(sr_run.wr_x0, sr_run.wr_z0);
  (sr_q1, sr_r1) = hex_grid::px_to_hex(sr_run.wr_x1, sr_run.wr_z1);

  // ⚠ THE MATERIAL DECIDES, and until `S3` it did not. A wall is the line the author
  // walked; a fence keeps the road-and-two-offsets shape, which is what it is and what
  // `straight.mjs` measures.
  if mat == WALL_MAT {
    sr_marked = 0;
    wall_stamp(w, sr_run, mat, sr_grade, s.es_runs, sr_marked);
    return RunLaid { rl_code: RL_LAID, rl_wall: true, rl_n: sr_marked,
      rl_step: sr_step, rl_resid: sr_resid, rl_reach: sr_reach,
      rl_q0: sr_q0, rl_r0: sr_r0, rl_q1: sr_q1, rl_r1: sr_r1, rl_pad: 4,
      // ⚠ **THE RUN'S OWN ENDS ARE IN THE SENTENCE — plan 24 `H1d`.** They were not,
      // and `tools/gates/world/straight` therefore RE-DERIVED the line it measures
      // against: *"the run the server actually laid: from A along the snapped
      // heading, for the walked distance projected onto it. Re-derived here rather
      // than trusted."* That is a second implementation of `run_between`'s geometry,
      // in JavaScript, and `H1b` moved the real one out from under it — the wall went
      // on being straight and the gate's ruler stopped agreeing, reported as
      // `straight: false`.
      //
      // ⚠ AND IT WAS ALWAYS WRONG FOR THE ODD HEADINGS, WHICH IS THE PART TO KEEP.
      // The gate reconstructs at `step * 15°`; `D`'s in-between twelve sit
      // `1.1021°` off nominal (`X29`). Over the 24.98-unit run this gate walks that
      // is a perpendicular fan of `24.98 * tan(1.1021°) = 0.48` — so the ruler was
      // bent before `H1b` and only happened to agree while our own snap was bent the
      // same way.
      rl_say: "wall laid {sr_marked} edges, heading {sr_step} of {HEADINGS} "
            + "(snapped, residual {sr_resid}°), length {sr_reach}"
            + ", from {sr_run.wr_x0},{sr_run.wr_z0} to {sr_run.wr_x1},{sr_run.wr_z1}" };
  }

  sr_fenced = 0;
  sr_cut = 0;
  sr_paved = road_stamp(w, sr_run, ROAD_HALF as float, mat, sr_grade, s.es_runs,
                        sr_fenced, sr_cut);
  RunLaid { rl_code: RL_LAID, rl_wall: false, rl_n: sr_paved,
    rl_fenced: sr_fenced, rl_cut: sr_cut,
    rl_step: sr_step, rl_resid: sr_resid, rl_reach: sr_reach,
    rl_q0: sr_q0, rl_r0: sr_r0, rl_q1: sr_q1, rl_r1: sr_r1, rl_pad: ROAD_HALF + 4,
    // ⚠ THE RUN'S ENDS, FOR THE SAME REASON THE WALL'S CARRIES THEM — plan 24
    // `H1d`. `tools/gates/world/straight` lays a ROAD and measures its fences, and
    // it was reconstructing the centreline from `step * 15°` and a projection.
    rl_say: "road laid {sr_paved} cells and {sr_fenced} fence edges, "
          + "cut {sr_cut}, heading {sr_step} of {HEADINGS} "
          + "(snapped, residual {sr_resid}°), length {sr_reach}"
          + ", from {sr_run.wr_x0},{sr_run.wr_z0} to {sr_run.wr_x1},{sr_run.wr_z1}" }
}

// `19:` — a prop where the author is STANDING.
//
// ⚠ THE CELL IS DERIVED THE WAY THE HANDLER DERIVES IT, which is `session_storey`'s
// note one gesture over: `world_to_hex(px, pz)` in the server is a two-line
// delegation to `hex_grid::px_to_hex`, checked rather than assumed. A wrapper that
// took a cell would let a test agree with itself about a mapping the wire does
// differently.
pub fn session_prop(s: EditSession, w: VoxelWorld, item: integer) -> Dressed {
  (pq, pr) = hex_grid::px_to_hex(s.es_author.au_x, s.es_author.au_z);
  prop_at(w, pq, pr, item)
}

// `20:` — the dressing at a cell, as `height/item` pairs. ⚠ THE DRESSING VIEW AND
// NOT THE TERRAIN ONE: two answers about one cell is the whole of `D1`, and a test
// that read the column would be asking the question the separation exists to keep
// apart.
pub fn session_dressing(w: VoxelWorld, q: integer, r: integer) -> vector<integer> {
  sd_out: vector<integer> = [];
  for sd_e in world_dressing(w, q, r).co_cells {
    if hex_voxel::hex_occupied(sd_e) { sd_out += [sd_e.h_item as integer ?? 0]; }
  }
  sd_out
}

// ── WHAT THE SESSION HOLDS, IN WORDS — plan 22 `K1`, moved here at `B1b.1b` ──
//
// The nine registries, every opening's GEOMETRY, and the standing choice. `K1`
// built it inside `editor_run` because the world cannot see what a conversion
// loses; `B1b.1b` moved it here because a page in local mode needs to be held
// against that runner, and a second copy of this text in the client would be two
// programs agreeing about a string rather than about a session.
//
// ⚠ IT IS THE OTHER HALF OF `hex_voxel::world_key`, AND NEITHER HALF IS OPTIONAL.
// A ring records its TRUNK in the session and its edges in the store, so a caller
// that rang with a scratch session builds a byte-identical world and a different
// scene — `V1`'s finding, and `R1b`'s before it. The world says what was written;
// this says what the editor remembers.
//
// ⚠ AND IT PRINTS EVERY OPENING'S SHAPE, NEVER ONLY `op_kind`. A digest of the
// label agrees with itself for as long as the label is copied correctly, which is
// exactly the mistake `K1` was built to catch.
pub fn session_digest(sess: EditSession) -> text {
  d = "session: runs {len(sess.es_runs.items)} roofs {len(sess.es_roofs.items)} "
    + "leaves {len(sess.es_leaves.items)} openings {len(sess.es_open.items)} "
    + "annex {len(sess.es_annex.items)} props {len(sess.es_props.items)} "
    + "slabs {len(sess.es_slabs.items)} holes {len(sess.es_holes.items)} "
    + "trunk {sess.es_trunk.tk_live}/{sess.es_trunk.tk_r}";
  for op in sess.es_open.items {
    d += "\n  opening kind {op.op_kind} at {op.op_x},{op.op_z} half {op.op_half} "
       + "band {op.op_lo}..{op.op_hi} spring {op.op_spring} "
       + "depth {op.op_near}..{op.op_depth}";
  }
  d + "\nchosen: opening {sess.es_open_kind}"
}

// ── the read-backs a gate asks for over the wire ─────────────────────────────
//
// `15:` `16:` `26:` `29:` — the four queries every socket gate uses to see what a
// gesture did. ⚠ They take the WORLD and not the session, because a read is a question
// about the store and nothing else — a reader that needed the registries would be asking
// something the wire cannot ask either. They are `hex_voxel`'s already; naming them here is so that a headless
// test and a wire gate ask the same question in the same words.

// `15:` — the column's occupied heights, low to high.
pub fn session_column(w: VoxelWorld, q: integer, r: integer) -> vector<integer> {
  out: vector<integer> = [];
  for c in world_column(w, q, r).co_cells {
    if hex_present(c) { out += [c.h_height as integer ?? 0]; }
  }
  out
}

// `16:` — the three edge materials this hex OWNS, in slot order.
pub fn session_walls(w: VoxelWorld, q: integer, r: integer) -> vector<integer> {
  c = world_ground_cell(w, q, r);
  [c.h_wall_nw as integer ?? 0, c.h_wall_ne as integer ?? 0, c.h_wall_e as integer ?? 0]
}

// `29:` — the layer labels of the chunk this hex is in, in layer order. The ground's
// reserved label is what makes *which layer is the ground* answerable at all.
pub fn session_labels(w: VoxelWorld, q: integer, r: integer) -> vector<integer> {
  out: vector<integer> = [];
  n = world_chunk_layers(w, hex_voxel::world_chunk_of(q), hex_voxel::world_chunk_of(r));
  for l in 0..n { out += [world_layer_id(w, q, r, l)]; }
  out
}

// `26:` — the material and height of the cell the ground layer holds here.
pub fn session_cell(w: VoxelWorld, q: integer, r: integer) -> vector<integer> {
  c = world_ground_cell(w, q, r);
  [c.h_material as integer ?? 0, c.h_height as integer ?? 0]
}
