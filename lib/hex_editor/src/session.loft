//
// AN EDITING SESSION, WITH NO SOCKET IN IT — the state a gate needs and nothing else.
//
// ⚠ WHY THIS EXISTS. Every gesture is already a function in this package, so the
// server does not own the editing — but it does own the STATE the gestures are
// applied to, and that is what forced a gate to start one. Beside the `World` the
// server carries eight registries: the wall runs, the roof plans, the door leaves,
// the openings, the annexes, the props, the slabs and the holes. `part_mode.mjs` says
// it plainly — *"those are the SERVER's records for the world being edited, not the
// store's"* — and no message reads them back, so a test that wanted them had to drive
// a socket and photograph the result.
//
// They are all types of THIS package. Only the holding was the server's, and holding
// is not editing. `EditSession` holds them, so a test can build a scene, apply the
// same gestures the wire applies, and read the same answers back — in process, in
// milliseconds, with no port, no browser and no tick.
//
// ⚠ WHAT IT DELIBERATELY DOES NOT HOLD, so nobody reads it as the whole editor:
//   · the TICK — the walk, the fall, the camera ease. Those integrate over time and
//     the server is where time lives. A gate about walking is still a gate.
//   · the STREAMING policy — which chunks a client is sent. That is a function of a
//     viewer, and there is no viewer here.
//   · the SENTENCES. `hex_editor` returns an `Ack` carrying numbers; the wire's text
//     is composed in `editor_server`. So a headless test asserts what was DONE and a
//     wire gate asserts what was SAID, which is the division `CLAUDE.md` already
//     draws — and the better half of it, because a count is a fact and a sentence is
//     a presentation of one.
//
// ⚠ AND IT IS NOT A SECOND IMPLEMENTATION. Every function here threads the session's
// own fields into the same gesture the server calls; none of them decides anything.
// If one ever did, the two paths could disagree and the headless answer would be
// worth nothing — which is the trap `editor_run.loft` was written to avoid and this
// inherits. `make headless-same` is the check that they still agree.
use gesture;
use hex_world;
use hex_grid;

// ⚠ `EditSession`, NOT `Session`. `ssh` publishes `pub struct Session` and a struct
// name is GLOBAL across a consumer's dependency graph — two declarations merge into
// one with whichever field types were declared last, and the diagnostic never
// mentions a collision. Grepped before it was written; see CLAUDE.md.
// ⚠ THE WORLD IS **NOT** IN HERE, AND THAT IS A LOFT DEFECT SHOWING THROUGH — but it
// is also the better shape, which is why it is not written as a grudging workaround.
//
// It was a field. Under `loft --tests` a gesture called with `w` SIGSEGVs the
// runner at 169, 289 and 441 ground cells and NOT at 49 or 625, while the same calls as
// a program are fine at every size — memory corruption rather than a limit, filed as
// loft#796 and related in shape to #775 and #774.
//
// And the honest design is the same: the `World` is already the argument every gesture
// takes, and the server's own registries are what nothing else could hold. A session
// that owned the world too would be a second place a world can live, which is the thing
// `HEX_STACK.md`'s first invariant forbids — the store is the only authority.
pub struct EditSession {
  es_author: Author,
  // The eight the server holds beside the store. Empty is a legal scene: a world with
  // no house in it has no wall runs, and `chunk_mesh_props` already keeps the fallback
  // paths that makes it take.
  es_runs:    WallRuns,
  es_awalls:  WallRuns,      // an annex's walls are their own run set
  es_roofs:   RoofPlans,
  es_leaves:  DoorLeaves,
  es_open:    Openings,
  es_annex:   Annexes,
  es_props:   Props,
  es_slabs:   Slabs,
  es_holes:   Holes,
}

// A session over a fresh world, at the constants the editor uses.
//
// ⚠ THE CONSTANTS ARE THE CALLER'S, and that is not laziness. A scene built at a
// different `ε` is a different world however identical the script — `editor_run.loft`
// says so at the top — so a test that wants the editor's world states the editor's
// numbers rather than inheriting a default that could drift away from them.
pub fn session_new() -> EditSession {
  EditSession {
    es_author: author_at(0.0, 0.0, 0.0),
    es_runs:   WallRuns { items: [] },
    es_awalls: WallRuns { items: [] },
    es_roofs:  RoofPlans { items: [] },
    es_leaves: DoorLeaves { items: [] },
    es_open:   Openings { items: [] },
    es_annex:  Annexes { items: [] },
    es_props:  Props { items: [] },
    es_slabs:  Slabs { items: [] },
    es_holes:  Holes { items: [] },
  }
}

// Ground under the scene. Every gate that builds anything starts by making somewhere
// to build it, and a gesture on unauthored ground is a different test.
pub fn session_ground(w: World, half: integer, h: integer, mat: integer) {
  for q in 0 - half..half + 1 {
    for r in 0 - half..half + 1 { ground_set(w, q, r, h, mat); }
  }
}

// ── where the author is ──────────────────────────────────────────────────────
//
// ⚠ IN WORLD UNITS, AS `7:` TAKES THEM. A gesture reads the author's position and
// derives its own hex, so a session that placed by hex would be doing the conversion
// the editor does and could do it differently.
pub fn session_at(s: EditSession, x: float, z: float, yaw: float) {
  s.es_author = author_at(x, z, yaw);
}

// ── the gestures, threaded ───────────────────────────────────────────────────
//
// One line each, and each one calls exactly what the server's handler calls. The
// value is not the wrapper; it is that a caller does not have to know which of the
// nine registries a given gesture happens to touch — which is knowledge the server's
// message loop encodes and nothing else did.

pub fn session_raise(s: EditSession, w: World, dir: integer) -> Ack {
  raise_ahead(w, s.es_author, dir)
}

// ⚠ THERE IS NO `session_house`, AND THE REASON IS THE MODULE GRAPH RATHER THAN A
// CHOICE. `place_house` is declared in the ENTRY module, which uses this one, so a
// wrapper here would be a cycle. A caller says
// `place_house(w, s.es_author, w, d, grade, s.es_runs)` — which is the
// server's own call with the session's fields in it, and reads no worse. That is the
// shape for every gesture the entry owns; the wrappers below exist only for the ones
// in `gesture`, and only because they thread a registry a caller would otherwise have
// to know about.

pub fn session_fence(s: EditSession, w: World, mat: integer, rad: integer, ref: float) -> Ack {
  fence_ring(w, s.es_author, mat, rad, ref)
}

pub fn session_open(s: EditSession, w: World, kind: integer, nedges: integer) -> Ack {
  open_ahead(w, s.es_author, kind, nedges)
}

// ── the read-backs a gate asks for over the wire ─────────────────────────────
//
// `15:` `16:` `26:` `29:` — the four queries every socket gate uses to see what a
// gesture did. ⚠ They take the WORLD and not the session, because a read is a question
// about the store and nothing else — a reader that needed the registries would be asking
// something the wire cannot ask either. They are `hex_world`'s already; naming them here is so that a headless
// test and a wire gate ask the same question in the same words.

// `15:` — the column's occupied heights, low to high.
pub fn session_column(w: World, q: integer, r: integer) -> vector<integer> {
  out: vector<integer> = [];
  for c in world_column(w, q, r).co_cells {
    if hex_present(c) { out += [c.h_height as integer ?? 0]; }
  }
  out
}

// `16:` — the three edge materials this hex OWNS, in slot order.
pub fn session_walls(w: World, q: integer, r: integer) -> vector<integer> {
  c = world_ground_cell(w, q, r);
  [c.h_wall_n as integer ?? 0, c.h_wall_ne as integer ?? 0, c.h_wall_se as integer ?? 0]
}

// `29:` — the layer labels of the chunk this hex is in, in layer order. The ground's
// reserved label is what makes *which layer is the ground* answerable at all.
pub fn session_labels(w: World, q: integer, r: integer) -> vector<integer> {
  out: vector<integer> = [];
  n = world_chunk_layers(w, hex_world::world_chunk_of(q), hex_world::world_chunk_of(r));
  for l in 0..n { out += [world_layer_id(w, q, r, l)]; }
  out
}

// `26:` — the material and height of the cell the ground layer holds here.
pub fn session_cell(w: World, q: integer, r: integer) -> vector<integer> {
  c = world_ground_cell(w, q, r);
  [c.h_material as integer ?? 0, c.h_height as integer ?? 0]
}
