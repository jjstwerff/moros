//
// GESTURES, AS FUNCTIONS — `SCRIPTED_EDITOR.md` §2, and the reason the gate suite
// is slow.
//
// Every authoring gesture lives inside the editor server's message loop, so the
// only way to ask "does raising the ground raise the ground" is to start a
// server, open a socket, send `5:1` and wait for an acknowledgement. Measured:
// 28 gates that way take 67 seconds at ten in parallel, and took 40 MINUTES
// before that. The same claims as loft tests run in milliseconds, on the
// interpreter, with no port and no clock — and can be mutation-checked, which a
// gate that drives a socket cannot be.
//
// So a gesture is a FUNCTION here:
//
//     gesture(world, author, args) -> Ack
//
// `Author` is where the character is — the gestures need exactly that and nothing
// else. `Ack` is the doorstep shape this editor already uses everywhere: applied,
// refused with a named reason and an offer, or applied as an explicit
// approximation with its residual shown. ⚠ Those three states are invariant I;
// a gesture that returns a bare boolean has thrown away the only thing that makes
// a refusal legitimate.
//
// The server keeps the socket, the tick and the streaming. It calls these.
use hex_field;
use hex_grid;
use hex_world;

// Where the author is standing. `au_yaw` is radians on the lattice plane, 0 = +x.
pub struct Author {
  au_x:   float,
  au_z:   float,
  au_yaw: float,
}

pub fn author_at(x: float, z: float, yaw: float) -> Author {
  Author { au_x: x, au_z: z, au_yaw: yaw }
}

// The answer to a gesture. `ak_n` is what it did — cells, edges, whatever the
// gesture counts — and is 0 on a refusal.
//
// ⚠ `ak_residual` IS NOT AN ERROR TERM. It is what the author asked for and did
// not get: the clamped height, the degrees a facing moved, the cut-and-fill a
// seat owes. A gesture that applies an approximation and reports 0 has lied.
pub struct Ack {
  ak_ok:       boolean,
  ak_why:      text,
  ak_n:        integer,
  ak_residual: integer,
  ak_q:        integer,   // WHERE it happened — the caller needs this to know
  ak_r:        integer,   // which chunks to rebuild, and must not re-derive it
}

pub fn ack_ok(n: integer) -> Ack {
  Ack { ak_ok: true, ak_why: "", ak_n: n, ak_residual: 0, ak_q: 0, ak_r: 0 }
}

pub fn ack_no(why: text) -> Ack {
  Ack { ak_ok: false, ak_why: why, ak_n: 0, ak_residual: 0, ak_q: 0, ak_r: 0 }
}

pub fn ack_about(n: integer, why: text, residual: integer) -> Ack {
  Ack { ak_ok: true, ak_why: why, ak_n: n, ak_residual: residual, ak_q: 0, ak_r: 0 }
}

pub fn ack_at(a: Ack, q: integer, r: integer) -> Ack {
  Ack { ak_ok: a.ak_ok, ak_why: a.ak_why, ak_n: a.ak_n,
        ak_residual: a.ak_residual, ak_q: q, ak_r: r }
}

// ── THE DOORSTEP (`K-FIT`, invariant I) ─────────────────────────────────────
//
// > No edit is ever silently corrected. Every author action ends in exactly one
// > of three states — applied exactly, refused with a NAMED REASON, an OFFER and
// > a RESIDUAL, or applied as an explicit approximation with its residual shown.
//
// A refusal that says only "no" is half the obligation. The author asked for
// something; they are owed what they can have instead (the offer) and how far
// off they were (the residual). Otherwise the next move is guesswork.
//
// ⚠ AND THE OFFER IS NOT ALWAYS MEANINGFUL. An ORDINAL parameter — a height, a
// length — has a nearest admissible value, so an offer is a correction. A
// NOMINAL one — a material, a species, a palette index — does not: 255 is not
// "nearly" 256, it is a different thing entirely, and offering it reads as a
// small correction while changing what the wall is made of (`X68`). So nominal
// parameters are refused WITHOUT an offer, and that is a distinction the type
// carries rather than each caller remembering.
pub struct Fit {
  ft_ok:       boolean,
  ft_reason:   text,
  ft_offer:    integer,          // meaningless unless ft_ordinal
  ft_residual: integer,
  ft_ordinal:  boolean,
}

pub fn fit_ok() -> Fit {
  Fit { ft_ok: true, ft_reason: "", ft_offer: 0, ft_residual: 0, ft_ordinal: true }
}

// An ordinal parameter: it has a nearest admissible value, so refusing carries
// an offer and the distance to it.
pub fn fit_ordinal(v: integer, lo: integer, hi: integer, what: text) -> Fit {
  if v < lo {
    return Fit { ft_ok: false, ft_reason: "{what} {v} is below the minimum {lo}",
                 ft_offer: lo, ft_residual: lo - v, ft_ordinal: true };
  }
  if v > hi {
    return Fit { ft_ok: false, ft_reason: "{what} {v} is above the maximum {hi}",
                 ft_offer: hi, ft_residual: v - hi, ft_ordinal: true };
  }
  fit_ok()
}

// A nominal parameter: a name, not a magnitude. No offer, ever.
pub fn fit_nominal(v: integer, hi: integer, what: text) -> Fit {
  if v < 0 || v > hi {
    return Fit { ft_ok: false,
                 ft_reason: "{what} {v} is not a {what}; nominal, so there is no nearest one",
                 ft_offer: 0, ft_residual: 0, ft_ordinal: false };
  }
  fit_ok()
}

// One rendering of a refusal, so every tool says it the same way and a NOMINAL
// refusal cannot accidentally grow an offer.
pub fn fit_text(f: Fit) -> text {
  if f.ft_ordinal {
    return "{f.ft_reason} (offer {f.ft_offer}, residual {f.ft_residual})";
  }
  f.ft_reason
}

// ── the ground the gestures write through ───────────────────────────────────

pub const SURFACE_MAT = 1;     // any non-zero index: 0 is absence (`E1`)
pub const W_RESERVE   = 0;     // the floor a height may not go below
pub const H_CEILING   = 65535; // and the ceiling, which is the u16 the voxel holds

// The ground height at a cell — the OUTDOORS, by label, never layer 0. Layer 0 is
// the outdoors right up until a cellar is dug beneath it and then it silently
// becomes the cellar floor; three cellars under a hill once sank the drawn ground
// from 10.917 to 5.583 wu.
pub fn ground_h(w: World, q: integer, r: integer) -> integer {
  c = world_ground_cell(w, q, r);
  c.h_height
}

// Replace ONE cell of ONE named layer, carrying every other cell and every label
// through untouched. The surface writers differ only in which index they name, so
// the read-modify-write lives here once.
//
// A layer index of -1 means *there is no such layer* — an unwritten hex, or an edge
// whose owning column has nothing at the level being authored. The store names the
// layer it creates in that case, which is what an unwritten hex has always done.
pub fn layer_write(w: &World, q: integer, r: integer, li: integer,
                   nc: hex_world::Hex) -> integer {
  if li < 0 {
    return world_set_column(w, hex_world::Column { co_q: q, co_r: r,
                                                   co_cells: [nc] }).cw_code;
  }
  col = world_column(w, q, r);
  cells: vector<hex_world::Hex> = [];
  for i in 0..len(col.co_cells) {
    if i == li { cells += [nc]; } else { cells += [col.co_cells[i]]; }
  }
  world_set_column(w, hex_world::Column { co_q: q, co_r: r, co_cells: cells,
                                          co_ids: col.co_ids }).cw_code
}

pub fn ground_write(w: &World, q: integer, r: integer, nc: hex_world::Hex) -> integer {
  layer_write(w, q, r, world_ground_layer(w, q, r), nc)
}

// Write a height and material at a cell, keeping everything else the cell holds.
pub fn ground_set(w: &World, q: integer, r: integer, h: integer, mat: integer) -> integer {
  c = world_ground_cell(w, q, r);
  nc = hex_world::Hex { h_height: h as u16? ?? 0,
                        h_material: mat as u8? ?? 0,
                        h_item: c.h_item,
                        h_item_rotation: c.h_item_rotation,
                        h_wall_n: c.h_wall_n,
                        h_wall_ne: c.h_wall_ne,
                        h_wall_se: c.h_wall_se };
  ground_write(w, q, r, nc)
}

// ── the surface and edge writers the gestures share ─────────────────────────

// The three edge slots a hex owns, and the height unit everything is measured in.
pub const SLOT_NW = 0;                // h_wall_n
pub const SLOT_NE = 1;                // h_wall_ne
pub const SLOT_E  = 2;                // h_wall_se


// The height of a cell: every peak's contribution, summed.
//
// The falloff is `(1 - (d/R)^2)^2` — a smooth bump that reaches zero WITH ZERO
// SLOPE at the rim. A linear cone would meet the flat ground at an angle and
// leave a visible crease ring around every hill; this one lands tangent, so a
// hill blends into the plain and into its neighbours without a seam to hide.
//
// The result is an INTEGER height unit, because `L13` makes moros's cell the
// storage of record and its height is an integer at 0.25 wu. Quantising here
// rather than at the mesh keeps the field the thing that is true.
// The surface height at a hex — ONE voxel read, not a sum over authored peaks.
// An unwritten cell reads as absent, which is height 0: the flat plane, and the
// same answer the peak version gave for ground nobody had touched.
pub fn terrain_h(hq: integer, hr: integer, wld: World) -> integer {
  // ⚠ THE GROUND IS A LABEL, NOT AN INDEX. This read `world_cell(…, SURFACE)` —
  // layer 0 — which is the outdoors right up until a cellar is dug beneath it, and
  // then silently becomes the cellar floor. Measured: three cellars under a hill
  // sank the drawn ground from 10.917 to 5.583 wu.
  //
  // ⚠ Bound to a local, not `…().h_height` in tail position — that is loft H9's
  // shape (a field projected off an inline call) and it aborted the interpreter
  // here even though H9 itself is fixed for the case it was filed as.
  c = world_ground_cell(wld, hq, hr);
  h = c.h_height;
  h
}

// ⚠ WRITE THE GROUND, WHICHEVER LAYER THAT IS — the one place a ground write
// names a layer, so there is nowhere else to get it wrong.
//
// Both ground writers used to send a ONE-ELEMENT column, `co_cells: [nc]`, which
// `world_set_column` applies POSITIONALLY to layer 0. That was right for exactly
// as long as layer 0 was the ground, and it is the half of this defect that does
// not show in a picture: fixing only the READ would have drawn a ground that
// editing no longer moves, because a raise would still have raised the cellar.
//
// The column is read, the ground cell replaced, and the whole thing written back
// WITH ITS LABELS — so nothing is created (every label is already its layer's
// own), and because step 5 stamps only layers whose bytes actually changed, no
// other layer's version is touched (`T2`).
//
// A hex with no ground at all is the one case that still sends a single cell:
// there is no layer to address, and the store names the one it creates.
// Write one cell of THE LAYER THOSE FEET ARE ON — `ground_write`'s twin for the
// other surface question. A column with no surface at all falls back to authoring
// the ground, which is what an unwritten hex has always done.
//
// ⚠ Deliberately NOT folded into `terrain_set`. Every other ground writer — the
// raise, the field, the vegetation, the walls — genuinely means the outdoors, and
// giving all of them a height they would have to invent would be rewriting every
// producer to serve one consumer. The road is the consumer that knows its feet.
pub fn surface_set(wld: &World, q: integer, r: integer, feet: float,
               h: integer, mat: integer) -> integer {
  // ⚠ THE UNIT IS THE WORLD'S, not a constant this package keeps. `w_unit` is
  // what `world_new` was given, so a world built at a different scale measures
  // its own heights — and there is no second copy to drift.
  sf = hex_world::world_surface(wld, q, r, feet / wld.w_unit ?? 0.0);
  c = hex_world::world_cell(wld, q, r, sf.sf_layer);
  nc = hex_world::Hex { h_height: h as u16? ?? 0,
                        h_material: mat as u8? ?? 0,
                        h_item: c.h_item,
                        h_item_rotation: c.h_item_rotation,
                        h_wall_n: c.h_wall_n,
                        h_wall_ne: c.h_wall_ne,
                        h_wall_se: c.h_wall_se };
  if sf.sf_layer < 0 { return ground_write(wld, q, r, nc); }
  col = hex_world::world_column(wld, q, r);
  cells: vector<hex_world::Hex> = [];
  for i in 0..len(col.co_cells) {
    if i == sf.sf_layer { cells += [nc]; } else { cells += [col.co_cells[i]]; }
  }
  world_set_column(wld, hex_world::Column { co_q: q, co_r: r, co_cells: cells,
                                            co_ids: col.co_ids }).cw_code
}

// hex_grid's directions: 0=E 1=SE 2=SW 3=W 4=NW 5=NE.
pub fn edge_owner(q: integer, r: integer, dir: integer) -> (integer, integer, integer) {
  if dir == 0 { return (q, r, SLOT_E); }
  if dir == 5 { return (q, r, SLOT_NE); }
  if dir == 4 { return (q, r, SLOT_NW); }
  (nq, nr) = hex_grid::hex_neighbor(q, r, dir);
  if dir == 3 { return (nq, nr, SLOT_E); }      // our W is the west neighbour's E
  if dir == 1 { return (nq, nr, SLOT_NW); }     // our SE is the SE neighbour's NW
  (nq, nr, SLOT_NE)                             // our SW is the SW neighbour's NE
}

// The material on the edge between (q, r) and its neighbour in `dir`, at the
// surface layer. 0 is no boundary at all — which is NOT the same as a doorway
// (`X70`), and the difference is the reason a door has a material of its own.
// ── WHICH LAYER STORES AN EDGE AT THIS HEIGHT ───────────────────────────────
//
// ⚠⚠ `world_surface` IS THE WRONG SELECTOR ON ITS OWN, and the fence count is what
// said so: 30 edges before, **16** after, with "stored outside" falling 15 → 1.
// The rule picks among OCCUPIED layers — and `E1e` is the invariant that *an edge
// is content whatever the cell under it holds*, so half of any boundary is stored
// in cells that hold no ground at all. For those `world_surface` answers −1, and a
// −1 means "the store names the layer it creates": a one-element column, applied
// positionally to layer 0, which is not the ground once anything is dug beneath.
//
// So the fallback is the GROUND LAYER, which exists chunk-wide whether or not this
// particular cell is occupied. `world_ground_layer` answers from the layer list and
// not from the cell, which is exactly the difference that matters here.
pub fn edge_layer(wld: World, q: integer, r: integer, ref: float) -> integer {
  li = hex_world::world_surface(wld, q, r, ref / wld.w_unit ?? 0.0).sf_layer;
  if li >= 0 { return li; }
  hex_world::world_ground_layer(wld, q, r)
}

// Put a material on that edge. `h` is the height the edge should take if the cell
// that stores it holds nothing — a boundary is content in its own right (`E1e`),
// and it stands at the height of what it bounds rather than at zero.
//
// ── ⚠ AN EDGE BELONGS TO THE SURFACE IT BOUNDS ──────────────────────────────
//
// This wrote THE GROUND, whichever layer that is — right for as long as the
// ground was the only thing anyone could stand on, and wrong the day a stair
// existed. Measured from a deck at 16 with the ground at 4: `24:` reported
// `edge 0 of (6,0) = 1` and the byte landed on the ground's cell, so the author
// fenced a room on the first floor and got a fence in the yard below. `23:`
// FENCE and `25:` WALL go through here too, so one write had all three.
//
// `ref` is the height the author is authoring AT — their feet — and it selects
// the layer the same way the road's write does. Wall bytes live on a `Hex`, and
// a `Hex` is per-layer, so a deck's own edges are already representable and
// already drawn: `chunk_mesh_props` reads them from every layer's cell, outside
// the occupancy guard. Only the write and the collision proxy named the ground.
//
// ⚠ THE OWNER MAY BE A DIFFERENT COLUMN FROM THE ONE YOU STAND IN — that is
// `E1e`, half of any boundary is stored outside the thing it bounds — and it may
// have nothing at your level. Then there is no layer to address and the store
// names the one it creates, at height `h`, exactly as for an unwritten hex.
pub fn wall_set(wld: &World, q: integer, r: integer, dir: integer,
            mat: integer, h: integer, ref: float) -> integer {
  (oq, orr, slot) = edge_owner(q, r, dir);
  eli = edge_layer(wld, oq, orr, ref);
  c = hex_world::world_cell(wld, oq, orr, eli);
  hh = c.h_height as integer ?? 0;
  if !hex_world::hex_present(c) { hh = h; }
  wn = c.h_wall_n as integer ?? 0;
  we = c.h_wall_ne as integer ?? 0;
  ws2 = c.h_wall_se as integer ?? 0;
  if slot == SLOT_NW { wn = mat; }
  else if slot == SLOT_NE { we = mat; }
  else { ws2 = mat; }
  nc = hex_world::Hex { h_height: hh as u16? ?? 0,
                        h_material: c.h_material,
                        h_item: c.h_item,
                        h_item_rotation: c.h_item_rotation,
                        h_wall_n: wn as u8? ?? 0,
                        h_wall_ne: we as u8? ?? 0,
                        h_wall_se: ws2 as u8? ?? 0 };
  layer_write(wld, oq, orr, eli, nc)
}

// ── raise / lower ───────────────────────────────────────────────────────────

pub const PEAK_AHEAD = 10;     // hexes ahead of the author the stroke lands
pub const PEAK_R     = 7;      // brush radius, in hexes
pub const PEAK_STEP  = 6;      // height units per press (1.5 wu, about 1.3 m)

// One stroke of the terrain brush, centred on a cell.
//
// ⚠ THE STROKE IS APPLIED, NOT RECORDED, and that is what makes two strokes
// deepen one hill: holding the key adds each time, so the merge a stored-peak
// version had to special-case is just addition. The falloff `(1 - t²)²` is smooth
// at both ends, so one stroke is a gentle dome; twenty presses is that dome scaled
// twenty times vertically, which is where the steep flanks come from. They are
// wanted — the author's call, confirmed 2026-07-29 — so do not soften this.
pub fn brush(w: &World, tq: integer, tr: integer, amp: integer, rad: integer,
             clamped: &integer, residual: &integer) {
  for dq in (0 - rad)..(rad + 1) {
    for dr in (0 - rad)..(rad + 1) {
      q = tq + dq;
      r = tr + dr;
      d = hex_distance(q, r, tq, tr);
      if d < rad {
        t = (d as float) / (rad as float) ?? 0.0;
        f = 1.0 - t * t;
        delta = ((amp as float) * f * f) as integer;
        if delta != 0 {
          h = ground_h(w, q, r) + delta;
          if h < W_RESERVE {
            lost = W_RESERVE - h;
            if lost > residual { residual = lost; }
            clamped = clamped + 1;
            h = W_RESERVE;
          }
          if h > H_CEILING {
            lost2 = h - H_CEILING;
            if lost2 > residual { residual = lost2; }
            clamped = clamped + 1;
            h = H_CEILING;
          }
          ground_set(w, q, r, h, SURFACE_MAT);
        }
      }
    }
  }
}

// The cell `PEAK_AHEAD` hexes along the author's facing, or a refusal.
//
// ⚠ MEASURED IN HEXES WITH `hex_distance`, NOT CONVERTED FROM A WORLD RADIUS. A
// hex step is 1.5 wu north–south and sqrt(3) east–west, so a fixed world radius
// puts the target at a different hex distance depending on which way the author
// happens to face. The walk-out bound must cover the LONGEST step for the same
// reason: a search that only reaches `PEAK_AHEAD * 1.5` wu never hits distance 10
// facing east.
//
// ⚠ AND THE RULER IS ANCHORED WHERE THE AUTHOR IS. The server's version read a
// cached hex written once per tick, so between a teleport and the next tick the
// ray started at the new position while the ruler measured from the old one — and
// the hill landed underfoot, burying the camera. Derived from the position, both.
pub fn peak_cell(a: Author, tq: &integer, tr: &integer) -> boolean {
  (sq, sr) = px_to_hex(a.au_x, a.au_z);
  tq = sq;
  tr = sr;
  ky = cos(a.au_yaw);
  sy = sin(a.au_yaw);
  for si in 1..PEAK_AHEAD * 8 {
    (pq, pr) = px_to_hex(a.au_x + ky * (si as float) * 0.5,
                         a.au_z + sy * (si as float) * 0.5);
    if hex_distance(pq, pr, sq, sr) >= PEAK_AHEAD {
      tq = pq;
      tr = pr;
      return true;
    }
  }
  false
}

// Raise (`dir` = +1) or lower (-1) the ground ahead of the author.
//
// A refusal when no cell lies `PEAK_AHEAD` hexes away — never a silent fallback to
// the author's own cell, which is how the hill ended up underfoot.
pub fn raise_ahead(w: &World, a: Author, dir: integer) -> Ack {
  if dir == 0 { return ack_no("a stroke of nothing"); }
  tq = 0;
  tr = 0;
  if !peak_cell(a, tq, tr) {
    return ack_no("no cell at {PEAK_AHEAD} hexes ahead");
  }
  clamped = 0;
  residual = 0;
  brush(w, tq, tr, dir * PEAK_STEP, PEAK_R, clamped, residual);
  if clamped != 0 {
    return ack_at(ack_about(clamped,
                            "ground approximated — {clamped} cells hit the floor",
                            residual), tq, tr);
  }
  ack_at(ack_ok(1), tq, tr)
}
