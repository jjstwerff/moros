//
// hex_editor — the editor's gestures, as FUNCTIONS.
//
// ⚠ **THE POINT OF THIS PACKAGE IS THAT IT CALLS THE LIBRARY.** The editor grew
// its own wall, its own fence ring, its own roof and its own openings, and every
// one of them is worse than the `hex_*` family's: a wall was laid as a ROAD with
// a fence down each side, a ring as thirty per-hex-edge panels, and both follow
// the lattice's staircase where `hex_draw` recovers a wall as ONE ANALYTIC
// SURFACE. Measured before this package existed: `grep` for hex_draw, hex_shape,
// hex_form, hex_roof or hex_place across the whole tree returned nothing.
//
// So the rule for anything added here: **if the family has it, call it.** New hex
// interpretation does not belong in a consumer — that is what four parity bugs
// and one road-shaped wall already cost.
//
// The other half of the point is that a gesture is a FUNCTION. Every one of them
// lives inside the server's message loop today, reachable only through a socket,
// which is why nothing can be scripted, replayed or tested without one.
// The gestures — `SCRIPTED_EDITOR.md` §2 — live in their own module and are
// re-exported here, the way `hex_draw` carries `housedraw` and `hexsurf`.
use gesture;

use hex_draw;
use hex_form;
use hex_field;
use hex_way;
use hex_shape;
use hex_place;
use hex_grid;
use hex_part;
use names;
// ⚠ AFTER `gesture`, because a session is the state those gestures are applied to.
use session;
// The sentences the editor says — plan: the wire becomes transport.
use say;
// ⚠ AFTER `gesture`, because it takes an `Author`. What a HELD key means, how fast
// it turns you and how big one step is — plan 22 `B1c`. Those three lived in
// `src/editor_server.loft` alone, which is why a page with the same keyboard and
// the same author could not move at all.
use pose;
// Cliffs, as EDGES — plan 22 `B1c.2a`, moved from `moros_sim`. A cliff is a
// hex-lattice fact rather than a Moros one, both of its dependencies (`hex_field`,
// `hex_edge`) were already ours, and the walker that consults it is arriving here.
use cliff;
// ⚠ AFTER `cliff`, which it consults, and after `gesture` for `edge_layer` and the
// wall materials. Where a walker ENDS UP — plan 22 `B1c.2b`, moved verbatim out of
// `src/editor_server.loft` so one walk answers both drivers.
use walk;

// One wall, as the renderer should draw it: the mitred segment from corner to
// corner. Not a strip of hex edges — those are the INDEX, and drawing them is the
// staircase the pictures keep showing.
pub struct WallQuad {
  wq_side: integer,
  wq_x0: float, wq_y0: float,
  wq_x1: float, wq_y1: float,
}

// A rectangular plan has four sides, and `surface_quad` needs to know how many so
// it can mitre against the neighbours. Named rather than passed as a literal 4 at
// each call, because it is the same fact three times.
pub const PLAN_SIDES = 4;

// The walls of a plan, mitred so consecutive sides share an endpoint EXACTLY and
// the outline closes with no corner gap.
//
// `cells` must already hold the plan's floor — `hex_draw::draw_floor` puts it
// there. The surface is recovered from those cells, which is what makes this the
// inverse of drawing rather than a second description of it.
pub fn plan_walls(p: Plan, cells: HexSet) -> vector<WallQuad> {
  out: vector<WallQuad> = [];
  for side in 0..PLAN_SIDES {
    (x0, y0, x1, y1) = surface_quad(p, cells, side, PLAN_SIDES);
    out += [WallQuad { wq_side: side, wq_x0: x0, wq_y0: y0, wq_x1: x1, wq_y1: y1 }];
  }
  out
}

// Is every one of a plan's walls an exact analytic surface — a heading, not a
// fitted approximation? A `false` here means the cells are not a plan's floor,
// and the wall a renderer draws from them would be an average of a zigzag.
pub fn plan_walls_exact(p: Plan, cells: HexSet) -> boolean {
  for side in 0..PLAN_SIDES {
    if !surface_is_exact(surface_of(p, cells, side)) { return false; }
  }
  true
}

// ── S3: THE WALL A FREE RUN DRAWS ───────────────────────────────────────────
//
// A run is the editor's other wall: two presses, an author's line, at any of the
// 24 headings it snaps to — NOT a plan side. `surface_quad` cannot draw it and
// should not be asked to: its exactness claim is about recovering a wall from the
// cells that store it, and a run at 15° has no lattice family to be exact in.
// What the family DOES own here, and the editor did not ask for, is two things:
//
//   the offset      `hex_way::track_offset` — for a straight, the parallel line
//                   exactly, which is what a wall's two faces are;
//   the thickness   `hex_draw`'s band. A presented wall is `BAND_SIDES` wide —
//                   sqrt(3)/2 u, the larger of the two families, which is the
//                   width the widening rule presents BOTH at.
//
// ⚠ **The wall the editor drew had no thickness at all.** `emit_run_wall` emitted
// one quad and the same quad flipped, so a wall was a plane seen from either side:
// no top, no jamb, nothing to read a doorway or a corner against. That is not a
// missing feature, it is what makes a wall read as a wall in a picture, and it is
// why this step is measured in a band and not in triangles.
pub struct RunWall {
  rw_ok:   boolean,
  rw_len:  float,
  rw_half: float,
  rw_cx:   vector<float>,   // the four plan corners, in order around the strip
  rw_cz:   vector<float>,
}

// The presented thickness of a wall, from `hex_draw`'s band table rather than from
// a number chosen here. `BAND_SIDES` is the full extent of the wider family's
// strip; a wall run is presented at that width whatever direction it took, which
// is the same rule `WIDEN_TOTAL` states for the recovered case.
pub fn wall_band() -> float { BAND_SIDES }

// The strip one run draws: the centreline offset both ways by half the band.
//
// A zero-length run is REFUSED rather than returned degenerate — an `rw_ok` of
// false with no corners. The normal of a zero-length line is 0/0, and a renderer
// that got one back would emit a NaN quad that draws as nothing while measuring
// as something.
pub fn run_wall(x0: float, z0: float, x1: float, z1: float) -> RunWall {
  t = hex_way::track_new();
  hex_way::track_straight(t, x0, z0, x1, z1);
  ln = hex_way::seg_len(t, 0);
  if ln <= 0.0 {
    return RunWall { rw_ok: false, rw_len: 0.0, rw_half: 0.0, rw_cx: [], rw_cz: [] };
  }
  half = wall_band() * 0.5;
  l = hex_way::track_offset(t, half);
  r = hex_way::track_offset(t, 0.0 - half);
  (lx0, lz0) = hex_way::seg_point(l, 0, 0.0);
  (lx1, lz1) = hex_way::seg_point(l, 0, ln);
  (rx1, rz1) = hex_way::seg_point(r, 0, ln);
  (rx0, rz0) = hex_way::seg_point(r, 0, 0.0);
  RunWall { rw_ok: true, rw_len: ln, rw_half: half,
            rw_cx: [lx0, lx1, rx1, rx0], rw_cz: [lz0, lz1, rz1, rz0] }
}

pub fn run_wall_x(w: RunWall, i: integer) -> float { w.rw_cx[i] ?? 0.0 }
pub fn run_wall_z(w: RunWall, i: integer) -> float { w.rw_cz[i] ?? 0.0 }

// ── S4: A FOOTPRINT, FROM WHERE THE AUTHOR IS STANDING ──────────────────────
//
// A house is placed, not drawn edge by edge: the author stands somewhere, faces
// somewhere, and a rectangle lands in front of them. `hex_shape::Box` is that
// rectangle and `hex_shape::box_fill` its cells — no rasterisation of ours.
//
// ⚠ **TWELVE ORIENTATIONS, AND ONLY SIX OF THEM HAVE MITRED WALLS.** This is the
// lattice's own `X24` — 6-fold symmetry, not 12 — and it decides what this gesture
// can promise. `Box` turns in 30° steps and splits into two orbits:
//
//   EVEN rot   local u on an EDGE heading. `Plan`'s six, exactly: an even-rot Box
//              and the `Plan` at `rot / 2` are the SAME rectangle. `surface_of`
//              recovers each side as an exact heading, so `surface_quad` mitres
//              the corners and the outline closes with no gap.
//   ODD  rot   local u on a VERTEX heading. A second family, NOT a rotation of the
//              first by any exact map — and `Plan` cannot express it, so there is
//              no `surface_quad` and no mitre.
//
// A footprint on the odd orbit is therefore REFUSED here, with the nearest even
// rotation as the offer and the angle as the residual — this editor's doorstep
// shape (`K-FIT`: reason, offer, residual, never a blank no). Quietly rounding to
// the even orbit would turn a building 30° under the author's hands, and drawing
// it unmitred would put the corner gaps back that `S1` measured at 0.45 wu.
pub const POSE_ROT = 12;              // hex_shape's BOX_ROT — the placement granularity

pub struct Footprint {
  fp_ok:       boolean,   // false — the odd orbit; read `fp_offer` and say why
  fp_cq:       integer,   // the anchor cell: the rectangle's centre
  fp_cr:       integer,
  fp_wid:      integer,
  fp_dep:      integer,
  fp_rot:      integer,   // 0..11, the Box rotation the facing snapped to
  fp_offer:    integer,   // the nearest EVEN rotation, always
  fp_residual: float,     // degrees between where the author looked and what landed
}

// The rotation whose +v axis a facing snaps to, and how far it moved.
fn snap_rot(facing: float, residual: &float) -> integer {
  st = 2.0 * PI / (POSE_ROT as float) ?? 0.0;
  k = facing / st ?? 0.0;
  ki = 0;
  if k >= 0.0 { ki = (k + 0.5) as integer; } else { ki = (k - 0.5) as integer; }
  d = facing - (ki as float) * st;
  if d < 0.0 { d = 0.0 - d; }
  residual = d * 180.0 / PI ?? 0.0;
  ((ki % POSE_ROT ?? 0) + POSE_ROT) % POSE_ROT ?? 0
}

// The gap between the author's feet and the near wall — one hex step, so the
// building lands in FRONT of them and never around them. A footprint that swallows
// its author is the placement bug every editor writes once.
// ⚠ TAKEN FROM THE LATTICE OWNER, not re-typed. This was a literal 1.7320508…
// with `// hex_grid::HEX_LEN` beside it, which is a second copy of the family's
// √3 that a comment cannot keep in step — moros#3's "no lattice math lives in
// this repo" covers a copied CONSTANT, not only a copied formula.
// `moros_render` already does this; the two now name one number.
pub POSE_GAP = HEX_LEN;

// Where a `wid` x `dep` building goes for an author at (px, py) looking along
// `facing`, in radians on the lattice plane.
//
// The building's +v axis is the author's facing, so the wall they are looking at is
// the near one, and the centre sits half a depth plus a step further on. The offset
// uses `box_cos`/`box_sin` of the SNAPPED rotation — the family's exact table in
// Q(sqrt3) — rather than the raw facing, so the placement lands where the drawn
// rectangle actually is and not half a cell off it.
pub fn pose_footprint(px: float, py: float, facing: float,
                      wid: integer, dep: integer) -> Footprint {
  resid = 0.0;
  fdir = snap_rot(facing, resid);
  rot = ((fdir - 3) % POSE_ROT + POSE_ROT) % POSE_ROT ?? 0;
  reach = (dep as float) * HEX_LEN * 0.5 + POSE_GAP;
  cx = px + box_cos(fdir) * reach;
  cy = py + box_sin(fdir) * reach;
  (cq, cr) = px_to_hex(cx, cy);
  even = rot;
  if box_orbit(rot) != 0 { even = ((rot - 1) % POSE_ROT + POSE_ROT) % POSE_ROT ?? 0; }
  Footprint { fp_ok: box_orbit(rot) == 0, fp_cq: cq, fp_cr: cr,
              fp_wid: wid, fp_dep: dep, fp_rot: rot,
              fp_offer: even, fp_residual: resid }
}

// The placement, as the shape family holds it — valid on both orbits.
pub fn footprint_box(f: Footprint) -> Box {
  box_new(f.fp_cq, f.fp_cr, f.fp_wid, f.fp_dep, f.fp_rot, false)
}

// The same rectangle as a `Plan`, which exists only on the even orbit. Asking for
// one on the odd orbit gives the OFFER's plan — the caller has already been told
// `fp_ok` is false, and handing back a plan of a different rectangle silently is
// how a refusal becomes a wrong building.
pub fn footprint_plan(f: Footprint) -> Plan {
  r = f.fp_rot;
  if box_orbit(r) != 0 { r = f.fp_offer; }
  plan_new(f.fp_cq, f.fp_cr, f.fp_wid, f.fp_dep, r / 2 ?? 0, false)
}

// The cells, from `box_fill` — the shape family's own rasterisation.
pub fn footprint_fill(f: Footprint, cells: HexSet) -> integer {
  box_fill(footprint_box(f), cells)
}

// The four walls, mitred. Only meaningful where `fp_ok` — see the orbit note above.
pub fn footprint_walls(f: Footprint, cells: HexSet) -> vector<WallQuad> {
  plan_walls(footprint_plan(f), cells)
}

// Sit the footprint on the terrain and say what it cost. The height is
// `hex_place`'s choice under `policy`, the write is `seat_write`, and the residual
// is the cut-and-fill — RETURNED, because a placement that flattens a slope without
// saying so is the silent-wrong-data this stack refuses everywhere else.
// ⚠ MEASURED BEFORE THE WRITE, and the first version measured after — which reads
// the heights `seat_write` has just flattened and therefore reports 0 on every
// slope in the world. A cut-and-fill of zero is exactly the silent-wrong-answer
// this returns a number to prevent.
pub fn footprint_seat(cells: HexSet, terr: Heights, policy: integer) -> float {
  z = seat_height(cells, terr, policy);
  cost = seat_residual(cells, terr, z);
  seat_write(cells, terr, z);
  cost
}

// ── S4: PLACE A HOUSE ───────────────────────────────────────────────────────
//
// The gesture the footprint was built for: an author stands somewhere, looks
// somewhere, and a rectangle lands in front of them with four walls that MEET.
// `pose_footprint` decides where, `box_fill` says which cells, `footprint_walls`
// gives the four sides mitred against each other by `surface_quad` — the editor
// never computes a corner here.
//
// ⚠ A FACING CAN BE REFUSED, and it is the LATTICE refusing rather than this
// code. A rectangle turns in twelve 30° steps and only the six whose own axis lies
// on an edge heading have a `Plan`; only a `Plan` can be mitred. The rectangle's
// axis is 90° off the author's facing, so the placeable facings are the odd ones —
// 30°, 90°, 150°, 210°, 270°, 330°. An author looking due east cannot place a
// house with mitred corners, and is told so with the rotation that can.
//
// The walls are laid as four RUNS whose ends are the mitred corners, so S3's band
// draws them and two consecutive sides share an endpoint exactly — the strips meet
// on the centreline instead of overshooting each other by half a wall.
pub fn place_house(w: VoxelWorld, a: Author, wid: integer, dep: integer,
                   grade: integer, runs: WallRuns) -> Ack {
  f = pose_footprint(a.au_x, a.au_z, a.au_yaw, wid, dep);
  if !f.fp_ok {
    return ack_no("a footprint at this facing has no mitred corners; turn one step "
                + "(rot {f.fp_rot} of 12, offer {f.fp_offer}, residual {f.fp_residual})");
  }
  pad = wid + dep + 4;
  cells = hexset_chunk(f.fp_cq - pad, f.fp_cr - pad, 2 * pad + 1, 2 * pad + 1);
  n = footprint_fill(f, cells);

  // ── A PAD IS SEATED ON ITS OWN FOOTPRINT — plan 20 `A4` ───────────────────
  //
  // ⚠ IT USED TO TAKE THE CALLER'S `grade`, WHICH IS THE AUTHOR'S FEET, and the
  // house is not where the author is standing — `pose_footprint` puts it AHEAD of
  // them. So the pad was seated at the ground under a point several cells away and
  // the footprint's own uphill edge stood over it by that many cells of gradient.
  //
  // Measured before this existed (`probe/house/pads.loft`), earth standing OVER the
  // floor at the wall: **7, 12, 17, 22** units as the ramp goes 1, 2, 3, 4 per hex
  // — 5.5 wu of soil against the wall at the steepest, growing without bound, and
  // one-sided: the PROUD direction stayed at 5 throughout.
  //
  // ⚠ AND THE FUNCTION THAT ANSWERS IT HAS BEEN HERE ALL ALONG WITH NO CALLER.
  // `footprint_seat` picks the height under a policy, returns the cut-and-fill, and
  // writes the seat — built for this, tested in `tests/footprint.loft`, and called
  // by nothing until now. A tested claim no consumer honours is a claim about
  // nothing, and it passed CI for as long as it has existed.
  //
  // ⚠ `SEAT_MEAN`, NOT `LOW` OR `HIGH`, AND THE TWO ENDS SAY WHY. `SEAT_LOW` seats
  // at the bottom of the footprint, which is the buried case this exists to remove;
  // `SEAT_HIGH` seats at the top, which is a house on a plinth with its whole
  // footprint filled. The mean is the one that balances what it cuts against what
  // it fills, and it is the only one whose residual means *cut-and-fill* rather
  // than *all of one*.
  terr = heights_new(f.fp_cq - pad, f.fp_cr - pad, 2 * pad + 1, 2 * pad + 1);
  seat_q = f.fp_cq;
  seat_r = f.fp_cr;
  for hr in f.fp_cr - pad..f.fp_cr + pad + 1 {
    for hq in f.fp_cq - pad..f.fp_cq + pad + 1 {
      if hexset_get(cells, hq, hr) {
        height_set(terr, hq, hr, (terrain_h(hq, hr, w) as float) * w.w_unit);
        seat_q = hq;
        seat_r = hr;
      }
    }
  }
  cost = footprint_seat(cells, terr, SEAT_MEAN);
  // ⚠ READ BACK FROM THE FIELD `footprint_seat` JUST WROTE, never re-derived by
  // calling `seat_height` a second time. Two derivations of one quantity is the
  // shape this tree has been bitten by three times; the seat is whatever the seat
  // function said it was.
  seat_res = 0.0;
  seat = freeze_grade(height_get(terr, seat_q, seat_r) / w.w_unit ?? 0.0, seat_res);
  // What the author asked for against what the ground under the house can give.
  moved = seat - grade;
  if moved < 0 { moved = 0 - moved; }
  owed = (cost / w.w_unit ?? 0.0) as integer;

  for r in f.fp_cr - pad..f.fp_cr + pad + 1 {
    for q in f.fp_cq - pad..f.fp_cq + pad + 1 {
      if hexset_get(cells, q, r) { ground_set(w, q, r, seat, FLOOR_MAT); }
    }
  }
  qs = footprint_walls(f, cells);
  marked = 0;
  for i in 0..PLAN_SIDES {
    side = qs[i] ?? WallQuad {};
    m = 0;
    wall_stamp(w, WallRun { wr_base: 0, wr_up: 0, wr_x0: side.wq_x0, wr_z0: side.wq_y0,
                            wr_x1: side.wq_x1, wr_z1: side.wq_y1,
                            wr_mat: WALL_MAT, wr_step: 0 },
               WALL_MAT, seat, runs, m);
    marked = marked + m;
  }
  // ⚠ S6 — AND IT GETS A ROOF, because that is what makes it read as a house
  // rather than a walled box. The eave is the wall's own height, so the roof starts
  // exactly where the wall stops: lower would cut into it, higher would leave a
  // band of daylight. A refusal here refuses the HOUSE — half a house is not an
  // answer — and the footprint's cells are already the ones the roof covers.
  rf = roof_over(w, f, cells, seat, ROOF_EAVE_UP, ROOF_PITCH_DEFAULT, 0);
  if !rf.ak_ok { return ack_no("the walls stand but the roof was refused: {rf.ak_why}"); }
  // ⚠ THE RESIDUAL IS THE CUT-AND-FILL NOW, not the wall count. `Ack.ak_residual`
  // is documented as *what the author asked for and did not get*, and a tally of
  // stamped edges is neither — it is a success count wearing the refusal field. The
  // cut-and-fill is exactly what that field is for: the ground this house had to
  // move to stand level, which on flat ground is 0 and on a slope is the number the
  // author is owed.
  ack_at(ack_about(n, "house placed {n} cells, {marked} wall edges, "
                    + "ridge at {rf.ak_residual}, seated at {seat} "
                    + "({moved} from your feet, cut and fill {owed})", owed),
         f.fp_cq, f.fp_cr)
}

// ── S6: THE ROOF, FROM THE FAMILY'S OWN PROFILE ─────────────────────────────
//
// ⚠ THE EDITOR'S ROOF WAS A LINEAR SPECIAL CASE. `roof_height` is
// `anchor + eave + (rad - dist) * PITCH` — a cone about the stencil's centre,
// which is the shape a disc gives you and not the shape a building has.
// `hex_draw::draw_roof` runs `hex_roof`'s ridge profile along the plan's own u
// axis, so a rectangle gets a GABLE: two slopes meeting on a line, hipping at the
// ends when the ridge is shortened.
//
// It writes a HEIGHT FIELD over the cells rather than a mesh — a height per hex,
// which is exactly what a column can store. So the roof reaches the world the same
// way the stencil's did: a band of `[floor, roof]` per column, checked before
// anything is written so a refusal means no roof rather than half a roof.
//
// ⚠ THE RIDGE RUNS PAST BOTH ENDS ON PURPOSE. `draw_roof`'s own comment: stopping
// it at the wall makes the distance go radial past the tip, so the gable end rolls
// over like a cone quadrant — 0.43 units, 0.37 m of bulge. A hip is the same call
// with the ridge shortened, and then the conical ends are the FEATURE.
pub fn roof_over(w: VoxelWorld, f: Footprint, cells: HexSet, floor_h: integer,
                 eave_up: integer, pitch: float, hip_steps: integer) -> Ack {
  if !f.fp_ok { return ack_no("no plan at this facing, so no ridge to run"); }
  pad = f.fp_wid + f.fp_dep + 4;
  hz = heights_new(f.fp_cq - pad, f.fp_cr - pad, 2 * pad + 1, 2 * pad + 1);
  eave = ((floor_h + eave_up) as float) * w.w_unit;
  draw_roof(footprint_plan(f), cells, hz, eave, pitch, hip_steps);

  // ⚠ ONE ROOF, ONE LABEL, HOWEVER MANY CHUNKS IT COVERS — `I1`. A layer is
  // chunk-wide, so a roof spanning a boundary makes a layer record in each chunk it
  // touches; letting each allocate its own label is the violation this repairs.
  // Measured before it: a cone centred on a seam came back labelled 5 on one side
  // and 4 on the other.
  roof_id = hex_voxel::world_fresh_label(w);
  n = 0;
  ridge = 0;
  for r in f.fp_cr - pad..f.fp_cr + pad + 1 {
    for q in f.fp_cq - pad..f.fp_cq + pad + 1 {
      if hexset_get(cells, q, r) {
        hu = (height_get(hz, q, r) / w.w_unit ?? 0.0) as integer;
        if hu > ridge { ridge = hu; }
        band: vector<hex_voxel::Hex> = [
          hex_voxel::Hex { h_height: (floor_h as u16? ?? 0),
                           h_material: (FLOOR_MAT as u8? ?? 0) },
          hex_voxel::Hex { h_height: (hu as u16? ?? 0),
                           h_material: (ROOF_MAT as u8? ?? 0) }
        ];
        wr = world_merge_band_as(w, q, r, floor_h, hu, band, roof_id);
        if wr.cw_code != 0 {
          return ack_no("the roof was refused at ({q},{r}): {wr.cw_detail}");
        }
        n = n + 1;
      }
    }
  }
  ack_at(ack_about(n, "roof over {n} cells, ridge at {ridge}", ridge), f.fp_cq, f.fp_cr)
}

// The pitch a house gets when nobody says otherwise. ⚠ MEASURED IN A PICTURE, not
// chosen: 0.45 is 24 degrees, and at that angle the roof reads as a LID — the S6
// shot showed a flat red plane sitting on the walls. A domestic pitch is 35-45
// degrees, and 0.7 is 35: steep enough that the gable is visible from the ground,
// which is the only test this step has.
pub const ROOF_PITCH_DEFAULT = 0.70;
pub const ROOF_EAVE_UP = 12;      // the wall's own height — the roof starts where it ends

// ── S6b: THE ROOF IS DRAWN FROM ITS PLAN, NOT FROM ITS CELLS ────────────────
//
// ⚠ THE SAME FINDING AS `S3`, ONE LEVEL UP. The cells a roof occupies are its
// INDEX — the store's way of saying which columns are under it — and drawing them
// gives a hex staircase: the S6 picture showed a red slab with a sawtooth eave,
// which is the roof's version of the zigzag wall.
//
// A gable over a rectangle is TWO QUADS meeting on a line. The plan already knows
// where they are: the eaves run along local u at v = ±hd, the ridge runs along u at
// v = 0, and `plan_to_world` puts all six points in the world exactly. Straight by
// construction, at any rotation, with no tolerance anywhere.
//
// The heights stay the cells' business — `roof_over` writes them, the walk and the
// camera read them. This is the PICTURE, and the two agree because both take the
// ridge height from the same `eave + pitch * hd`.
// ⚠ `RoofPlan` AND `RoofPlans` ARE DECLARED IN `gesture.loft`, not here, and that is
// not tidiness — it is the one thing that made `EditSession` unbuildable. This file
// imports `session`, so `session` cannot import this one; a field it declares as a
// type from HERE resolves by name (struct names are global) but gets **no storage**,
// and the record is then written past. That was loft#796's SIGSEGV — non-monotonic in
// scene size, fine as a program, fatal under `--tests`. loft 2026.8.0 refuses it by
// name instead: *"field 'es_roofs' of 'EditSession' has no storage in that type's
// layout"*. The other eight registries were always in `gesture.loft` and were always
// fine, which is the control. A type a session holds belongs where the session can
// reach it without a cycle.

pub fn roof_plan_of(f: Footprint, eave: float, pitch: float) -> RoofPlan {
  r = f.fp_rot;
  if box_orbit(r) != 0 { r = f.fp_offer; }
  RoofPlan { rp_cq: f.fp_cq, rp_cr: f.fp_cr, rp_wid: f.fp_wid, rp_dep: f.fp_dep,
             rp_rot: r / 2 ?? 0, rp_eave: eave, rp_pitch: pitch }
}

fn rp_plan(rp: RoofPlan) -> Plan {
  plan_new(rp.rp_cq, rp.rp_cr, rp.rp_wid, rp.rp_dep, rp.rp_rot, false)
}

// The ridge stands `pitch * hd` above the eave — the same rise `draw_roof` gives
// the cells, so the drawn surface and the stored heights are one shape.
pub fn roof_ridge_y(rp: RoofPlan) -> float {
  rp.rp_eave + rp.rp_pitch * plan_hd(rp_plan(rp))
}

// The six points a gable needs, in world space and in a fixed order:
//   0,1  the -v eave, at -u and +u        4  the -u ridge end
//   2,3  the +v eave, at -u and +u        5  the +u ridge end
// Everything a renderer draws — two slopes and two gable ends — is a face of these.
pub fn roof_point_x(rp: RoofPlan, i: integer) -> float {
  p = rp_plan(rp);
  hw = plan_hw(p);
  hd = plan_hd(p);
  u = 0.0 - hw;
  if i == 1 || i == 3 || i == 5 { u = hw; }
  v = 0.0;
  if i == 0 || i == 1 { v = 0.0 - hd; }
  if i == 2 || i == 3 { v = hd; }
  (x, _y) = plan_to_world(p, u, v);
  x
}

pub fn roof_point_z(rp: RoofPlan, i: integer) -> float {
  p = rp_plan(rp);
  hw = plan_hw(p);
  hd = plan_hd(p);
  u = 0.0 - hw;
  if i == 1 || i == 3 || i == 5 { u = hw; }
  v = 0.0;
  if i == 0 || i == 1 { v = 0.0 - hd; }
  if i == 2 || i == 3 { v = hd; }
  (_x, z) = plan_to_world(p, u, v);
  z
}

pub fn roof_point_y(rp: RoofPlan, i: integer) -> float {
  if i >= 4 { return roof_ridge_y(rp); }
  rp.rp_eave
}

// ── S6c: THE ROOF HAS FOUR FACES, AND THEY HAVE AN OUTSIDE ──────────────────
//
// ⚠ THE FACES WERE WOUND BY HAND AND ONE OF THEM WAS BACKWARDS. The renderer's
// `emit_tri_n` takes the cross product and then flips any normal with `n.y < 0`
// upward, which quietly corrected both SLOPES — their normals have a y component,
// so the flip could see they were inside out. A GABLE END is vertical, `n.y` is
// exactly 0, and the flip has nothing to test: the -u gable came out facing -u
// (correct) and the +u gable came out facing -u as well, because the two are wound
// the same way and "outward" is opposite for them. Every house since S6 has had one
// gable end lit from inside.
//
// It survived because a lighting sign is not a shape and no gate reads shading. It
// stops surviving here, because a soffit is derived by pushing a face along its own
// normal: with the normal backwards the underside is built OUTSIDE the roof.
//
// So the winding is a table now, and it is the table both the top and the underside
// are drawn from — one statement of which way each face looks, tested rather than
// corrected downstream.
//
//   0  the -v slope   p0 p4 p5 p1
//   1  the +v slope   p2 p3 p5 p4
//   2  the -u gable   p0 p2 p4
//   3  the +u gable   p1 p5 p3      ⚠ the reversed one
pub const ROOF_FACES = 4;

// A slope is a quad, a gable end is a triangle.
pub fn roof_face_len(f: integer) -> integer {
  if f >= 2 { return 3; }
  4
}

// Which of the six points is corner `k` of face `f`, wound so the cross product of
// the first three points OUT of the roof.
pub fn roof_face_pt(f: integer, k: integer) -> integer {
  if f == 0 {
    if k == 0 { return 0; }
    if k == 1 { return 4; }
    if k == 2 { return 5; }
    return 1;
  }
  if f == 1 {
    if k == 0 { return 2; }
    if k == 1 { return 3; }
    if k == 2 { return 5; }
    return 4;
  }
  if f == 2 {
    if k == 0 { return 0; }
    if k == 1 { return 2; }
    return 4;
  }
  if k == 0 { return 1; }
  if k == 1 { return 5; }
  3
}

// The face's OUTWARD unit normal, from its own first three corners. One derivation,
// so the table above is the only place the winding is stated and a test can check
// the two agree.
pub fn roof_face_normal(rp: RoofPlan, f: integer) -> (float, float, float) {
  i0 = roof_face_pt(f, 0);
  i1 = roof_face_pt(f, 1);
  i2 = roof_face_pt(f, 2);
  ax = roof_point_x(rp, i0); ay = roof_point_y(rp, i0); az = roof_point_z(rp, i0);
  bx = roof_point_x(rp, i1) - ax;
  by = roof_point_y(rp, i1) - ay;
  bz = roof_point_z(rp, i1) - az;
  cx = roof_point_x(rp, i2) - ax;
  cy = roof_point_y(rp, i2) - ay;
  cz = roof_point_z(rp, i2) - az;
  nx = by * cz - bz * cy;
  ny = bz * cx - bx * cz;
  nz = bx * cy - by * cx;
  ln = sqrt(nx * nx + ny * ny + nz * nz) ?? 0.0;
  if ln <= 0.0 { return (0.0, 1.0, 0.0); }
  (nx / ln ?? 0.0, ny / ln ?? 0.0, nz / ln ?? 0.0)
}

// ── THE SOFFIT — the roof's underside, and it needs a THICKNESS to exist ────
//
// ⚠ A REVERSED COPY AT THE SAME COORDINATES IS NOT A SURFACE. The design called
// this *"a handful of triangles with the winding reversed"*, and that is true only
// where backface culling is on. This renderer never enables it, so both copies are
// rasterised — at bit-identical depths, where `gl.LESS` fails the second one
// everywhere. Whichever is drawn first wins at every pixel, so the pair is either
// a roof with no underside or an underside with no roof. Coincident geometry
// cannot be two surfaces.
//
// So the underside is the roof pushed `ROOF_SOFFIT` along each face's own inward
// normal — which is to say **the roof has a thickness now**, the smallest honest
// version of the `Slab` treatment horizontal surfaces are owed. Per FACE and not
// as one vertical drop: a vertical drop leaves the gable ends, which are vertical,
// coplanar with themselves and back at the same defect.
//
// ⚠ AND AT A CONVEX CORNER AN INWARD OFFSET OVERLAPS RATHER THAN GAPS, which is
// `A9b`'s result and the reason this needs no mitre. Seen from inside the tent
// every corner it has — the ridge, both eaves, the gable rakes — is convex, so the
// four offset faces cross each other and the seam is hidden. A concave corner would
// open a wedge and want `skin_fit`; this shape has none.
//
// The size: `SLAB_THICK`'s two height units at the editor's 0.25 wu, so a roof is
// as deep as a floor — joists and boards either way. ⚠ It is bounded from above by
// `roof_soffit_fits`: past that the ceiling parts company with the wall head.
pub const ROOF_SOFFIT = 0.5;

// ⚠ AND THE RIDGE HAS TO BE MITRED, WHICH THE FIRST VERSION DID NOT DO — the tests
// found it at a pitch of 1.1 and it is real geometry rather than an oversight.
// A ridge vertex lies on BOTH slope planes, so pushing it along one slope's normal
// moves it by `-t·(n₀·n₁)` relative to the other. The dot of the two outward
// normals is `(hd² − rise²)/L²`: positive under 45°, ZERO at 45°, and NEGATIVE past
// it. So on a steep roof the -v slope's underside pushes its ridge end **up through
// the +v slope** and out of the building — an inward offset that ends up outside.
//
// The mitre is the exact fix and it is one number: the two offset planes meet on a
// line directly under the ridge, `t·sec θ` below it. Both slopes take that height
// and no horizontal offset at all there, so a ridge corner is at exactly `-t` from
// **both** planes, which is what "the ceiling meets itself at the ridge" means.
//
// A vertical thickness of `t·sec θ` for a perpendicular `t` is the carpenter's own
// rule, arrived at from the other end.
pub fn roof_soffit_drop(rp: RoofPlan) -> float {
  p = rp.rp_pitch;
  ROOF_SOFFIT * sqrt(1.0 + p * p) ?? 0.0
}

// Points 4 and 5 are the ridge ends — the two the mitre applies to.
fn roof_pt_at_ridge(i: integer) -> boolean { i >= 4 }

pub fn roof_soffit_x(rp: RoofPlan, f: integer, k: integer) -> float {
  i = roof_face_pt(f, k);
  // A SLOPE takes no horizontal offset at the ridge — its whole normal is spent on
  // the drop. A GABLE END is vertical, so its offset is horizontal and the mitre
  // only decides how far down its apex is cut.
  if roof_pt_at_ridge(i) && f < 2 { return roof_point_x(rp, i); }
  (nx, _ny, _nz) = roof_face_normal(rp, f);
  roof_point_x(rp, i) - nx * ROOF_SOFFIT
}

pub fn roof_soffit_y(rp: RoofPlan, f: integer, k: integer) -> float {
  i = roof_face_pt(f, k);
  if roof_pt_at_ridge(i) { return roof_ridge_y(rp) - roof_soffit_drop(rp); }
  (_nx, ny, _nz) = roof_face_normal(rp, f);
  roof_point_y(rp, i) - ny * ROOF_SOFFIT
}

pub fn roof_soffit_z(rp: RoofPlan, f: integer, k: integer) -> float {
  i = roof_face_pt(f, k);
  if roof_pt_at_ridge(i) && f < 2 { return roof_point_z(rp, i); }
  (_nx, _ny, nz) = roof_face_normal(rp, f);
  roof_point_z(rp, i) - nz * ROOF_SOFFIT
}

// The signed distance from a point to face `f`'s own plane — negative inside. The
// soffit's defining claim is that every one of its vertices reads exactly `-t`
// against the face it belongs to, which is a stronger statement than "displaced by
// t along the normal" and the one that survives the mitre.
pub fn roof_face_depth(rp: RoofPlan, f: integer, x: float, y: float, z: float) -> float {
  (nx, ny, nz) = roof_face_normal(rp, f);
  i0 = roof_face_pt(f, 0);
  (x - roof_point_x(rp, i0)) * nx
    + (y - roof_point_y(rp, i0)) * ny
    + (z - roof_point_z(rp, i0)) * nz
}

// Corner `j` of the soffit, in EMISSION order — the face's own order, reversed. A
// surface that faces the room is the same points wound the other way, and stating
// it here is what lets a test measure the reversal instead of trusting the emitter.
pub fn roof_soffit_k(f: integer, j: integer) -> integer {
  roof_face_len(f) - 1 - j
}

// Is this world point OUTSIDE the tent — past any one of its four faces? The tent
// is open at its base, so those four half-spaces are the whole of it. This is the
// invariant that says "underside", and it is stated as the NEGATIVE on purpose.
//
// ⚠ "STRICTLY INSIDE" WAS THE WRONG CLAIM AND THE TESTS SAID SO. A slope's soffit
// keeps its full width — the offset is perpendicular to the slope, which has no u
// component — so its edge lands exactly ON the gable end's plane, where a strict
// test reads false. That is not a defect: the slope's underside running out to the
// gable is what leaves no slot between them, because the gable's own soffit is
// pulled `t` further in. On the boundary is fine; past it is not.
pub const ROOF_EPS = 0.000000001;

pub fn roof_outside(rp: RoofPlan, x: float, y: float, z: float) -> boolean {
  out = false;
  for f in 0..ROOF_FACES {
    if roof_face_depth(rp, f, x, y, z) > ROOF_EPS { out = true; }
  }
  out
}

// How far the soffit's eave edge sits INSIDE the roof's, in plan. A slope's inward
// normal has a horizontal component, so thickening the roof pulls its underside off
// the eave line by `t·sin θ` — exactly, and free of the building's size.
pub fn roof_soffit_inset(rp: RoofPlan) -> float {
  p = rp.rp_pitch;
  ROOF_SOFFIT * p / sqrt(1.0 + p * p) ?? 0.0
}

// ⚠ AND THAT INSET IS WHAT BOUNDS THE THICKNESS. The wall head is under the eave,
// so a ceiling pulled further in than the wall's own half-band stops meeting it and
// opens a slot between the two — the roof's version of the gap an opening's reveal
// exists to close. Refused with the thickness that would have worked.
pub fn roof_soffit_fits(rp: RoofPlan, band: float) -> Ack {
  ins = roof_soffit_inset(rp);
  half = band * 0.5;
  if ins > half {
    p = rp.rp_pitch;
    room = half * sqrt(1.0 + p * p) / p ?? 0.0;
    return ack_no("the soffit is pulled {ins} inside the eave and the wall head is "
                  + "only {half} deep — offer {room}, residual {ins - half}");
  }
  ack_ok(1)
}

// Does this roof plan cover the cell at (q, r)? The renderer asks before drawing a
// roof CELL: a cell under a plan-drawn gable is already in the picture, and drawing
// it again puts the hex staircase back underneath the straight eave.
//
// ⚠ NOT EVERY ROOF HAS A PLAN. The stencil places a cone over a DISC and has no
// rectangle to draw from, so its cells still draw themselves — which is why this is
// a question about one roof rather than a global switch. Turning the cell path off
// entirely broke the stencil's roof, and its gate said so on the next run.
pub fn roof_plan_covers(rp: RoofPlan, q: integer, r: integer) -> boolean {
  p = plan_new(rp.rp_cq, rp.rp_cr, rp.rp_wid, rp.rp_dep, rp.rp_rot, false);
  (wx, wy) = hex_to_px(q, r);
  (lu, lv) = plan_to_local(p, wx, wy);
  au = lu; if au < 0.0 { au = 0.0 - au; }
  av = lv; if av < 0.0 { av = 0.0 - av; }
  au <= plan_hw(p) + HEX_LEN * 0.5 && av <= plan_hd(p) + HEX_LEN * 0.5
}

// ⚠ THE ROOF'S OWN SURFACE AT A POINT, which nothing could ask before. The six
// points give a renderer its two slopes; a CAMERA needs the height over one spot,
// because "am I under this roof" is not answered by the footprint alone — standing
// beside a cottage you are inside its plan's tolerance and very much outdoors.
//
// The gable runs along u, so the height falls off with |v| from the ridge at exactly
// the pitch — the same `pitch * hd` rise `roof_ridge_y` uses, so the surface a camera
// tests against and the one an eye sees are one shape.
pub fn roof_plan_y(rp: RoofPlan, x: float, z: float) -> float {
  p = rp_plan(rp);
  (lu, lv) = plan_to_local(p, x, z);
  av = lv;
  if av < 0.0 { av = 0.0 - av; }
  hd = plan_hd(p);
  drop = rp.rp_pitch * av;
  if av > hd { drop = rp.rp_pitch * hd; }
  roof_ridge_y(rp) - drop
}

// Is this point under the roof's own plan, in WORLD coordinates rather than cells —
// the camera samples continuously and a cell-quantised answer flickers along a wall.
pub fn roof_plan_over(rp: RoofPlan, x: float, z: float) -> boolean {
  p = rp_plan(rp);
  (lu, lv) = plan_to_local(p, x, z);
  au = lu; if au < 0.0 { au = 0.0 - au; }
  av = lv; if av < 0.0 { av = 0.0 - av; }
  au <= plan_hw(p) && av <= plan_hd(p)
}

// ── SHELTER: what the camera is standing under ──────────────────────────────
//
// ⚠ ONE QUERY, AND WHAT TO DO ABOUT IT IS THE MODE'S BUSINESS. `sh_inside` means the
// eye is under a roof or a deck — NOT "hide the roof", not "suppress the pitch". A
// field named for one consumer's decision would bake that consumer's mode into the
// query and make the others unbuildable.
pub struct Shelter {
  sh_inside: boolean,
  sh_head:   integer,     // clear height above the eye, in units; -1 under open sky
  // ⚠ THESE TWO ARE MEASURED, NOT DERIVED, and that is why `shelter_at` leaves them
  // at -1. A clear RADIUS needs a march against the view-blocking edge set, which is
  // the same sweep the boom uses — `cam_free_dist` and its proxy live where the
  // camera solves, and re-deriving them here would be a second answer to a question
  // that already has one. The design put them in this struct so that *every mode
  // reads one query*, and that still holds: the server fills them with
  // `shelter_room` before anything consults the modes.
  sh_room:   float,       // clear radius before a view-blocking edge, all round; -1 unmeasured
  sh_back:   float,       // clear distance directly behind the subject; -1 unmeasured
}

pub fn shelter_at(w: VoxelWorld, roofs: RoofPlans, x: float, z: float,
                  eye_units: integer, unit: float) -> Shelter {
  best = 0 - 1;
  for rp in roofs.items {
    if roof_plan_over(rp, x, z) {
      h = ((roof_plan_y(rp, x, z) / unit ?? 0.0) as integer);
      if h > eye_units {
        if best < 0 || h - eye_units < best { best = h - eye_units; }
      }
    }
  }
  // ⚠ AND A DECK IS A CEILING TOO. A storey above is as much "indoors" as a roof,
  // and a camera that only knew about roofs would climb happily through a floor.
  (q, r) = px_to_hex(x, z);
  col = world_column(w, q, r);
  for c in col.co_cells {
    if hex_voxel::hex_occupied(c) {
      ch = c.h_height as integer ?? 0;
      if ch > eye_units {
        if best < 0 || ch - eye_units < best { best = ch - eye_units; }
      }
    }
  }
  Shelter { sh_inside: best >= 0, sh_head: best, sh_room: 0.0 - 1.0, sh_back: 0.0 - 1.0 }
}

// The two measured fields, filled where the sweep lives. Separate from the
// constructor because they come from a different instrument, and a caller that
// forgets is left holding -1 rather than a plausible zero — an unmeasured radius
// that read 0 would say "no room at all" and degrade every camera on the box.
pub fn shelter_room(s: Shelter, room: float, back: float) -> Shelter {
  Shelter { sh_inside: s.sh_inside, sh_head: s.sh_head, sh_room: room, sh_back: back }
}

//
// WHAT A KEY MEANS — one place, plan 22 `W4`.
//
// ⚠ **IT MEANT FOUR THINGS IN FOUR PLACES, AND OMITTING ONE WAS SILENT.** Measured
// 2026-08-11, before this file existed:
//
//   1. `src/editor_client.loft`  ASCII constants  → a wire message
//   2. `src/editor_server.loft`  a wire message   → a gesture
//   3. `tools/script.mjs`        `KEYMAP`, **23 entries** → a wire message
//   4. `src/editor_run.loft`     a key → a gesture **directly**, 6 of them
//
// A key that builds a house in the browser and does nothing headless produces a
// DIFFERENT SCENE with every count agreeing — and that is not hypothetical:
//
// ⚠ **`H` ALREADY BUILT THE HOUSE AT TWO DIFFERENT HEIGHTS.** The server takes the
// grade under the author's feet (`py_of` → `terrain_h`); `editor_run` took
// `ground_h(w, 0, 0)` — the grade at the **origin**. On flat ground at the origin
// the two agree, which is every fixture anyone had looked at. Step off it and the
// same script builds a house at a different height depending on which program ran
// it — while `SCRIPTED_EDITOR.md`'s whole claim is *"build a scene both ways and
// the worlds must match"*.
//
// ⚠ **AND BOTH PROGRAMS CARRIED THEIR OWN `HOUSE_W` / `HOUSE_D`.** They happened to
// agree at 5×4. Nothing made them.
//
// ⚠ **TWO OF THE FOUR SITES SAY SO IN THEIR OWN SOURCE.** `editor_run`'s fallback
// reads *"no gesture for key {k} — add it here **and to the page**"*, and
// `script.mjs` says *"that is the one duplication here"* under a comment ordering
// the reader to **"KEEP IN STEP WITH `html/editor.html`'s keydown handler"** — a
// file **deleted on 2026-08-02**. The instruction naming where the truth lives has
// pointed at nothing since.
//
// ── WHAT THIS FILE OWNS, AND WHAT IT DELIBERATELY DOES NOT ───────────────────
//
// **Owns:** which gesture a key runs, with which parameters, and the session
// registries that gesture updates. That is *the meaning of the key*.
//
// **Does not own:** the sentence, the dirty set, the broadcast, the tick. Those
// are TRANSPORT and they belong to whichever program is driving — a server sends
// on a socket, a page repaints, a script prints. This is the same split that let
// `prop`, `annex`, `slab`, `seat` and the wall run move into this package with
// their wire behaviour byte-identical: **move the choosing, keep the sentence.**
//
// ⚠ **A `KEYMAP` OF KEY → WIRE-ID IS STILL FINE AND IS NOT A DUPLICATE.** What
// `script.mjs` may keep deciding is which *message* carries a key over a socket;
// that is genuinely the socket's business. What it must stop deciding is what the
// key MEANS.

// One shape for now — the gesture is the question here, not the parameters. ⚠ It
// is here rather than in each program because it was in each program: two copies
// that agreed by luck (`src/editor_run.loft` and `src/editor_server.loft`).
pub const HOUSE_W = 5;
pub const HOUSE_D = 4;

// The ground under the AUTHOR, which is what every gesture that seats something
// means by "the grade".
//
// ⚠ THIS IS THE FUNCTION `editor_run` DID NOT HAVE, and its absence is why it
// asked the origin instead. A helper that is missing gets substituted for, and the
// substitute is never announced.
pub fn grade_under(w: VoxelWorld, a: Author) -> integer {
  (gu_q, gu_r) = px_to_hex(a.au_x, a.au_z);
  ground_h(w, gu_q, gu_r)
}

// What one key press does. `PR_NONE` in `ak_why` means *this key is not a gesture*
// — a walk key, a camera key, or nothing at all — and is NOT a refusal: the caller
// decides whether that is worth saying.
//
// ⚠ THE UNKNOWN CASE IS A NAMED ANSWER RATHER THAN A FALSE. `ak_ok == false` is
// how a gesture REFUSES ("too steep", "no wall there"), and a caller that cannot
// tell *refused* from *not a gesture* will report one as the other — which is
// exactly how `editor_run` came to print "no gesture for key W" for every step of
// a walk.
pub const PR_NONE = "not a gesture";

// …and a key that IS a gesture and cannot be resolved yet is a third answer —
// plan 22 `R3`. `PR_NONE` would say *this is a walk key*, which is false and would
// send a reader looking for a binding that is deliberately absent.
//
// ⚠ WHY `O`/`P` ARE HERE AND `F`/`G` WERE NOT. The ring diverged on a NUMBER (the
// reference height), so it could be reconciled by taking the right one. The opening
// diverges on an AXIS: `36:<kind>` on the wire is a PROFILE — 0 flat, 1 round, 2
// pointed, 3 segmental, 4 an oculus, 11 a niche, 21 an embrasure — always cut with
// `DOOR_MAT`, while `press` read `O`/`P` as door-versus-window, a MATERIAL. There
// is no number to pick: the profile has to come from a selection, and nothing
// selects one yet ([EDITING_MODES § phase 2](../../../doc/claude/EDITING_MODES.md)).
//
// ⚠ AND ANSWERING *SOMETHING* NOW WOULD POISON THE STEP THAT PROVES THE COLLAPSE.
// `S3` asserts the six old keys and one verb with six selections build **six
// identical worlds**; if `press` invented a meaning here, that equality would be
// measured against the guess rather than against the editor.
pub const PR_SELECT = "an opening needs a profile, and nothing selects one yet";

// ── `press(key)` WAS HERE, AND IT IS GONE — plan 22 `V3` ────────────────────
//
// It was the chokepoint `W4` built: eleven keys, one body, so that what a key means
// stopped being re-asserted in four places. It did that job and then stopped being
// the right shape, because a key is a KEYBOARD's business and a verb is what
// travels — onto the wire, into a script, into a house type's own declaration.
//
// What replaces it is two levels, both below: `verb_of(key)` says which verb a key
// names, and `press_verb(…, verb)` says what a verb does. A caller resolves in that
// order; `src/editor_run.loft` is the one that did, and it was the last production
// caller this function had (`V2b`). `editor_server`'s `MSG_HOUSE` passes a literal
// verb (`V2a`), and `editor_client` never called it.
//
// ⚠ **AND THE DELETION IS NOT A RENAME, WHICH IS WHY IT NEEDED THE THREE STEPS
// BEFORE IT.** `verb_of` is not injective — `O P I U N M` all answer `opening` —
// so a key press cuts **what is chosen** rather than what the key used to spell.
// `K1` gave the scripts `select`, `K2a` converted the eighteen presses that carried
// a profile, and only then could `V2b` move the runner. Deleting this earlier would
// have changed what every one of those scripts built, silently: the store takes
// `DOOR_MAT` whatever the profile and the outline lives in the session, so no world
// instrument in the tree could have seen it.
//
// ⚠ **`open_press` WENT WITH IT** — it existed to turn `session_open_kind`'s
// `OpeningMade` into the `Ack` this function answered in, and `press_verb` reads the
// selection through `session_opening` instead. One caller, one lifetime.
//
// ⚠ **AND THE NAME IS NOT REUSED.** `press_verb` could take the plain `press` now
// that nothing collides, and it deliberately does not: both forms are
// `(sess, w, a, text)`, so a stale `press(…, "H")` would compile, run, and answer
// *not a gesture* at runtime instead of failing to build. The longer name is the
// only thing that distinguishes the two layers to a reader or to a compiler.

// ── THE VERB LAYER — plan 22 `V1` ───────────────────────────────────────────
//
// **A key names a VERB; the verb names what happens.** Two levels, and the split is
// the whole design ([EDITING_MODES § the mechanism](../../../doc/claude/EDITING_MODES.md)):
//
// ```
//   the DEFINITION      key  → verb                stable · declared · a person's
//   the FLEXIBLE layer  verb → gesture + params    data · grows with the catalogue
// ```
//
// ⚠ **A VERB IS A PUBLISHED NAME AND A KEY IS NOT.** The verb is what travels — on
// the wire, into `tools/scripts/*.keys`, into a house type's own declaration — while
// the key is resolved **where the keyboard is** and may be remapped freely. That
// asymmetry is not decoration: a client sending its keystroke to a server that
// resolves the key itself would mean two different things at the two ends, which is
// the four-site divergence `press` exists to close, rebuilt on a new message. So
// **name the verbs carefully and the keys casually.**
//
// ⚠ **TEXT, NOT AN ENUM.** The verb goes on the wire and into a script that a person
// reads and writes; an integer code would need a name↔number table at both ends,
// which is the second table this layer exists to remove.
pub const VB_NONE    = "";
pub const VB_RAISE   = "raise";
pub const VB_LOWER   = "lower";
pub const VB_PLACE   = "place";
pub const VB_OPENING = "opening";
pub const VB_FENCE   = "fence";
pub const VB_WALL    = "wall";

// The DEFINITION — what key means what, and the only layer a person may remap.
//
// `VB_NONE` is *this key names no verb*, which is `PR_NONE`'s question one level up:
// a walk key, a camera key, or nothing at all.
//
// ⚠ **SIX KEYS, ONE VERB.** `O P I U N M` all answer `opening`, and the profile they
// used to carry comes from the selection (`session_select_open`) instead. That is
// the collapse `S3` measured, finished: the key stops carrying a profile **here**.
// ⏭ Which means `verb_of` is deliberately NOT injective and the key form is not
// recoverable from the verb — a script that says `opening` and never says `select`
// gets whatever was last chosen, which is why `K1`–`K3` convert the scripts to say
// both before `V3` deletes `press(key)`.
pub fn verb_of(key: text) -> text {
  if key == "ArrowUp"   { return VB_RAISE; }
  if key == "ArrowDown" { return VB_LOWER; }
  if key == "H" { return VB_PLACE; }
  if key == "O" || key == "P" || key == "I" || key == "U"
     || key == "N" || key == "M" { return VB_OPENING; }
  if key == "F" { return VB_FENCE; }
  if key == "G" { return VB_WALL; }
  VB_NONE
}

// The FLEXIBLE layer — what a verb does, here, with what is chosen.
//
// ⚠ **THIS IS A SECOND BODY BESIDE `press` ON PURPOSE, AND ONLY UNTIL `V3`.** The
// two paths run at once and a test drives every key through both, comparing the
// worlds **as bytes** — which is the only way to move a chokepoint without a period
// where two tables both exist and neither is known to be the authority. `W1` moved
// the world format the same way. `V2` moves the callers one at a time; `V3` deletes
// `press(key)`, and this takes the name `press` once nothing is left to collide
// with — a rename is free here and only here, because `hex_editor` is unpublished.
//
// ⚠ **AND THE DUPLICATION IS WHAT MAKES THE TEST ABLE TO FAIL.** Writing
// `press(key) = press_verb(verb_of(key))` today would make the equality a tautology
// — a table checked against itself, which cannot be surprised.
//
// ⚠ **`raise`/`lower` AND `fence`/`wall` ARE TWO VERBS EACH, AND FOR DIFFERENT
// REASONS.** A direction is part of the action — every editor has *zoom in* and
// *zoom out* — so `raise` and `lower` stay two verbs however the layer grows. A
// MATERIAL is not: `fence` and `wall` are one `ring` verb waiting for a selection to
// hold the material, exactly as the opening family waited for `es_open_kind`. They
// cannot collapse before that selection exists — the equality below would go red on
// one of them the moment `verb_of` mapped both keys to one verb, which is the test
// enforcing the decomposition rather than a rule anybody has to remember.
pub fn press_verb(sess: EditSession, w: VoxelWorld, a: Author, verb: text) -> Ack {
  if verb == VB_RAISE { return raise_ahead(w, a, 1); }
  if verb == VB_LOWER { return raise_ahead(w, a, 0 - 1); }
  if verb == VB_PLACE {
    return place_house(w, a, HOUSE_W, HOUSE_D, grade_under(w, a), sess.es_runs);
  }
  // ⚠ THE PROFILE COMES FROM THE SELECTION AND FROM NOWHERE ELSE. `session_opening`
  // is the entry point `S2b` built for exactly this — reading `es_open_kind` here
  // instead would be the tenth site that knows what a selection is.
  if verb == VB_OPENING {
    vo_made = session_opening(sess, w, a, STOREY_H);
    if !vo_made.om_ok { return ack_no(vo_made.om_why); }
    return ack_ok(1);
  }
  if verb == VB_FENCE { return ring_set(sess, w, a, FENCE_MAT, FENCE_R, a.au_y); }
  if verb == VB_WALL  { return ring_set(sess, w, a, WALL_MAT,  FENCE_R, a.au_y); }
  Ack { ak_ok: false, ak_why: PR_NONE }
}
