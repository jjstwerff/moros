//
// hex_editor — the editor's gestures, as FUNCTIONS.
//
// ⚠ **THE POINT OF THIS PACKAGE IS THAT IT CALLS THE LIBRARY.** The editor grew
// its own wall, its own fence ring, its own roof and its own openings, and every
// one of them is worse than the `hex_*` family's: a wall was laid as a ROAD with
// a fence down each side, a ring as thirty per-hex-edge panels, and both follow
// the lattice's staircase where `hex_draw` recovers a wall as ONE ANALYTIC
// SURFACE. Measured before this package existed: `grep` for hex_draw, hex_shape,
// hex_form, hex_roof or hex_place across the whole tree returned nothing.
//
// So the rule for anything added here: **if the family has it, call it.** New hex
// interpretation does not belong in a consumer — that is what four parity bugs
// and one road-shaped wall already cost.
//
// The other half of the point is that a gesture is a FUNCTION. Every one of them
// lives inside the server's message loop today, reachable only through a socket,
// which is why nothing can be scripted, replayed or tested without one.
// The gestures — `SCRIPTED_EDITOR.md` §2 — live in their own module and are
// re-exported here, the way `hex_draw` carries `housedraw` and `hexsurf`.
use gesture;

use hex_draw;
use hex_form;
use hex_field;
use hex_way;
use hex_shape;
use hex_place;
use hex_grid;

// One wall, as the renderer should draw it: the mitred segment from corner to
// corner. Not a strip of hex edges — those are the INDEX, and drawing them is the
// staircase the pictures keep showing.
pub struct WallQuad {
  wq_side: integer,
  wq_x0: float, wq_y0: float,
  wq_x1: float, wq_y1: float,
}

// A rectangular plan has four sides, and `surface_quad` needs to know how many so
// it can mitre against the neighbours. Named rather than passed as a literal 4 at
// each call, because it is the same fact three times.
pub const PLAN_SIDES = 4;

// The walls of a plan, mitred so consecutive sides share an endpoint EXACTLY and
// the outline closes with no corner gap.
//
// `cells` must already hold the plan's floor — `hex_draw::draw_floor` puts it
// there. The surface is recovered from those cells, which is what makes this the
// inverse of drawing rather than a second description of it.
pub fn plan_walls(p: Plan, cells: HexSet) -> vector<WallQuad> {
  out: vector<WallQuad> = [];
  for side in 0..PLAN_SIDES {
    (x0, y0, x1, y1) = surface_quad(p, cells, side, PLAN_SIDES);
    out += [WallQuad { wq_side: side, wq_x0: x0, wq_y0: y0, wq_x1: x1, wq_y1: y1 }];
  }
  out
}

// Is every one of a plan's walls an exact analytic surface — a heading, not a
// fitted approximation? A `false` here means the cells are not a plan's floor,
// and the wall a renderer draws from them would be an average of a zigzag.
pub fn plan_walls_exact(p: Plan, cells: HexSet) -> boolean {
  for side in 0..PLAN_SIDES {
    if !surface_is_exact(surface_of(p, cells, side)) { return false; }
  }
  true
}

// ── S3: THE WALL A FREE RUN DRAWS ───────────────────────────────────────────
//
// A run is the editor's other wall: two presses, an author's line, at any of the
// 24 headings it snaps to — NOT a plan side. `surface_quad` cannot draw it and
// should not be asked to: its exactness claim is about recovering a wall from the
// cells that store it, and a run at 15° has no lattice family to be exact in.
// What the family DOES own here, and the editor did not ask for, is two things:
//
//   the offset      `hex_way::track_offset` — for a straight, the parallel line
//                   exactly, which is what a wall's two faces are;
//   the thickness   `hex_draw`'s band. A presented wall is `BAND_SIDES` wide —
//                   sqrt(3)/2 u, the larger of the two families, which is the
//                   width the widening rule presents BOTH at.
//
// ⚠ **The wall the editor drew had no thickness at all.** `emit_run_wall` emitted
// one quad and the same quad flipped, so a wall was a plane seen from either side:
// no top, no jamb, nothing to read a doorway or a corner against. That is not a
// missing feature, it is what makes a wall read as a wall in a picture, and it is
// why this step is measured in a band and not in triangles.
pub struct RunWall {
  rw_ok:   boolean,
  rw_len:  float,
  rw_half: float,
  rw_cx:   vector<float>,   // the four plan corners, in order around the strip
  rw_cz:   vector<float>,
}

// The presented thickness of a wall, from `hex_draw`'s band table rather than from
// a number chosen here. `BAND_SIDES` is the full extent of the wider family's
// strip; a wall run is presented at that width whatever direction it took, which
// is the same rule `WIDEN_TOTAL` states for the recovered case.
pub fn wall_band() -> float { BAND_SIDES }

// The strip one run draws: the centreline offset both ways by half the band.
//
// A zero-length run is REFUSED rather than returned degenerate — an `rw_ok` of
// false with no corners. The normal of a zero-length line is 0/0, and a renderer
// that got one back would emit a NaN quad that draws as nothing while measuring
// as something.
pub fn run_wall(x0: float, z0: float, x1: float, z1: float) -> RunWall {
  t = hex_way::track_new();
  hex_way::track_straight(t, x0, z0, x1, z1);
  ln = hex_way::seg_len(t, 0);
  if ln <= 0.0 {
    return RunWall { rw_ok: false, rw_len: 0.0, rw_half: 0.0, rw_cx: [], rw_cz: [] };
  }
  half = wall_band() * 0.5;
  l = hex_way::track_offset(t, half);
  r = hex_way::track_offset(t, 0.0 - half);
  (lx0, lz0) = hex_way::seg_point(l, 0, 0.0);
  (lx1, lz1) = hex_way::seg_point(l, 0, ln);
  (rx1, rz1) = hex_way::seg_point(r, 0, ln);
  (rx0, rz0) = hex_way::seg_point(r, 0, 0.0);
  RunWall { rw_ok: true, rw_len: ln, rw_half: half,
            rw_cx: [lx0, lx1, rx1, rx0], rw_cz: [lz0, lz1, rz1, rz0] }
}

pub fn run_wall_x(w: RunWall, i: integer) -> float { w.rw_cx[i] ?? 0.0 }
pub fn run_wall_z(w: RunWall, i: integer) -> float { w.rw_cz[i] ?? 0.0 }

// ── S4: A FOOTPRINT, FROM WHERE THE AUTHOR IS STANDING ──────────────────────
//
// A house is placed, not drawn edge by edge: the author stands somewhere, faces
// somewhere, and a rectangle lands in front of them. `hex_shape::Box` is that
// rectangle and `hex_shape::box_fill` its cells — no rasterisation of ours.
//
// ⚠ **TWELVE ORIENTATIONS, AND ONLY SIX OF THEM HAVE MITRED WALLS.** This is the
// lattice's own `X24` — 6-fold symmetry, not 12 — and it decides what this gesture
// can promise. `Box` turns in 30° steps and splits into two orbits:
//
//   EVEN rot   local u on an EDGE heading. `Plan`'s six, exactly: an even-rot Box
//              and the `Plan` at `rot / 2` are the SAME rectangle. `surface_of`
//              recovers each side as an exact heading, so `surface_quad` mitres
//              the corners and the outline closes with no gap.
//   ODD  rot   local u on a VERTEX heading. A second family, NOT a rotation of the
//              first by any exact map — and `Plan` cannot express it, so there is
//              no `surface_quad` and no mitre.
//
// A footprint on the odd orbit is therefore REFUSED here, with the nearest even
// rotation as the offer and the angle as the residual — this editor's doorstep
// shape (`K-FIT`: reason, offer, residual, never a blank no). Quietly rounding to
// the even orbit would turn a building 30° under the author's hands, and drawing
// it unmitred would put the corner gaps back that `S1` measured at 0.45 wu.
pub const POSE_ROT = 12;              // hex_shape's BOX_ROT — the placement granularity

pub struct Footprint {
  fp_ok:       boolean,   // false — the odd orbit; read `fp_offer` and say why
  fp_cq:       integer,   // the anchor cell: the rectangle's centre
  fp_cr:       integer,
  fp_wid:      integer,
  fp_dep:      integer,
  fp_rot:      integer,   // 0..11, the Box rotation the facing snapped to
  fp_offer:    integer,   // the nearest EVEN rotation, always
  fp_residual: float,     // degrees between where the author looked and what landed
}

// The rotation whose +v axis a facing snaps to, and how far it moved.
fn snap_rot(facing: float, residual: &float) -> integer {
  st = 2.0 * PI / (POSE_ROT as float) ?? 0.0;
  k = facing / st ?? 0.0;
  ki = 0;
  if k >= 0.0 { ki = (k + 0.5) as integer; } else { ki = (k - 0.5) as integer; }
  d = facing - (ki as float) * st;
  if d < 0.0 { d = 0.0 - d; }
  residual = d * 180.0 / PI ?? 0.0;
  ((ki % POSE_ROT ?? 0) + POSE_ROT) % POSE_ROT ?? 0
}

// The gap between the author's feet and the near wall — one hex step, so the
// building lands in FRONT of them and never around them. A footprint that swallows
// its author is the placement bug every editor writes once.
pub const POSE_GAP = 1.7320508075688772;   // hex_grid::HEX_LEN

// Where a `wid` x `dep` building goes for an author at (px, py) looking along
// `facing`, in radians on the lattice plane.
//
// The building's +v axis is the author's facing, so the wall they are looking at is
// the near one, and the centre sits half a depth plus a step further on. The offset
// uses `box_cos`/`box_sin` of the SNAPPED rotation — the family's exact table in
// Q(sqrt3) — rather than the raw facing, so the placement lands where the drawn
// rectangle actually is and not half a cell off it.
pub fn pose_footprint(px: float, py: float, facing: float,
                      wid: integer, dep: integer) -> Footprint {
  resid = 0.0;
  fdir = snap_rot(facing, resid);
  rot = ((fdir - 3) % POSE_ROT + POSE_ROT) % POSE_ROT ?? 0;
  reach = (dep as float) * HEX_LEN * 0.5 + POSE_GAP;
  cx = px + box_cos(fdir) * reach;
  cy = py + box_sin(fdir) * reach;
  (cq, cr) = px_to_hex(cx, cy);
  even = rot;
  if box_orbit(rot) != 0 { even = ((rot - 1) % POSE_ROT + POSE_ROT) % POSE_ROT ?? 0; }
  Footprint { fp_ok: box_orbit(rot) == 0, fp_cq: cq, fp_cr: cr,
              fp_wid: wid, fp_dep: dep, fp_rot: rot,
              fp_offer: even, fp_residual: resid }
}

// The placement, as the shape family holds it — valid on both orbits.
pub fn footprint_box(f: Footprint) -> Box {
  box_new(f.fp_cq, f.fp_cr, f.fp_wid, f.fp_dep, f.fp_rot, false)
}

// The same rectangle as a `Plan`, which exists only on the even orbit. Asking for
// one on the odd orbit gives the OFFER's plan — the caller has already been told
// `fp_ok` is false, and handing back a plan of a different rectangle silently is
// how a refusal becomes a wrong building.
pub fn footprint_plan(f: Footprint) -> Plan {
  r = f.fp_rot;
  if box_orbit(r) != 0 { r = f.fp_offer; }
  plan_new(f.fp_cq, f.fp_cr, f.fp_wid, f.fp_dep, r / 2 ?? 0, false)
}

// The cells, from `box_fill` — the shape family's own rasterisation.
pub fn footprint_fill(f: Footprint, cells: HexSet) -> integer {
  box_fill(footprint_box(f), cells)
}

// The four walls, mitred. Only meaningful where `fp_ok` — see the orbit note above.
pub fn footprint_walls(f: Footprint, cells: HexSet) -> vector<WallQuad> {
  plan_walls(footprint_plan(f), cells)
}

// Sit the footprint on the terrain and say what it cost. The height is
// `hex_place`'s choice under `policy`, the write is `seat_write`, and the residual
// is the cut-and-fill — RETURNED, because a placement that flattens a slope without
// saying so is the silent-wrong-data this stack refuses everywhere else.
// ⚠ MEASURED BEFORE THE WRITE, and the first version measured after — which reads
// the heights `seat_write` has just flattened and therefore reports 0 on every
// slope in the world. A cut-and-fill of zero is exactly the silent-wrong-answer
// this returns a number to prevent.
pub fn footprint_seat(cells: HexSet, terr: Heights, policy: integer) -> float {
  z = seat_height(cells, terr, policy);
  cost = seat_residual(cells, terr, z);
  seat_write(cells, terr, z);
  cost
}

// ── S4: PLACE A HOUSE ───────────────────────────────────────────────────────
//
// The gesture the footprint was built for: an author stands somewhere, looks
// somewhere, and a rectangle lands in front of them with four walls that MEET.
// `pose_footprint` decides where, `box_fill` says which cells, `footprint_walls`
// gives the four sides mitred against each other by `surface_quad` — the editor
// never computes a corner here.
//
// ⚠ A FACING CAN BE REFUSED, and it is the LATTICE refusing rather than this
// code. A rectangle turns in twelve 30° steps and only the six whose own axis lies
// on an edge heading have a `Plan`; only a `Plan` can be mitred. The rectangle's
// axis is 90° off the author's facing, so the placeable facings are the odd ones —
// 30°, 90°, 150°, 210°, 270°, 330°. An author looking due east cannot place a
// house with mitred corners, and is told so with the rotation that can.
//
// The walls are laid as four RUNS whose ends are the mitred corners, so S3's band
// draws them and two consecutive sides share an endpoint exactly — the strips meet
// on the centreline instead of overshooting each other by half a wall.
pub fn place_house(w: &World, a: Author, wid: integer, dep: integer,
                   grade: integer, runs: WallRuns) -> Ack {
  f = pose_footprint(a.au_x, a.au_z, a.au_yaw, wid, dep);
  if !f.fp_ok {
    return ack_no("a footprint at this facing has no mitred corners; turn one step "
                + "(rot {f.fp_rot} of 12, offer {f.fp_offer}, residual {f.fp_residual})");
  }
  pad = wid + dep + 4;
  cells = hexset_chunk(f.fp_cq - pad, f.fp_cr - pad, 2 * pad + 1, 2 * pad + 1);
  n = footprint_fill(f, cells);
  for r in f.fp_cr - pad..f.fp_cr + pad + 1 {
    for q in f.fp_cq - pad..f.fp_cq + pad + 1 {
      if hexset_get(cells, q, r) { ground_set(w, q, r, grade, FLOOR_MAT); }
    }
  }
  qs = footprint_walls(f, cells);
  marked = 0;
  for i in 0..PLAN_SIDES {
    side = qs[i] ?? WallQuad {};
    m = 0;
    wall_stamp(w, WallRun { wr_x0: side.wq_x0, wr_z0: side.wq_y0,
                            wr_x1: side.wq_x1, wr_z1: side.wq_y1,
                            wr_mat: WALL_MAT, wr_step: 0 },
               WALL_MAT, grade, runs, m);
    marked = marked + m;
  }
  // ⚠ S6 — AND IT GETS A ROOF, because that is what makes it read as a house
  // rather than a walled box. The eave is the wall's own height, so the roof starts
  // exactly where the wall stops: lower would cut into it, higher would leave a
  // band of daylight. A refusal here refuses the HOUSE — half a house is not an
  // answer — and the footprint's cells are already the ones the roof covers.
  rf = roof_over(w, f, cells, grade, ROOF_EAVE_UP, ROOF_PITCH_DEFAULT, 0);
  if !rf.ak_ok { return ack_no("the walls stand but the roof was refused: {rf.ak_why}"); }
  ack_at(ack_about(n, "house placed {n} cells, {marked} wall edges, "
                    + "ridge at {rf.ak_residual}", marked),
         f.fp_cq, f.fp_cr)
}

// ── S6: THE ROOF, FROM THE FAMILY'S OWN PROFILE ─────────────────────────────
//
// ⚠ THE EDITOR'S ROOF WAS A LINEAR SPECIAL CASE. `roof_height` is
// `anchor + eave + (rad - dist) * PITCH` — a cone about the stencil's centre,
// which is the shape a disc gives you and not the shape a building has.
// `hex_draw::draw_roof` runs `hex_roof`'s ridge profile along the plan's own u
// axis, so a rectangle gets a GABLE: two slopes meeting on a line, hipping at the
// ends when the ridge is shortened.
//
// It writes a HEIGHT FIELD over the cells rather than a mesh — a height per hex,
// which is exactly what a column can store. So the roof reaches the world the same
// way the stencil's did: a band of `[floor, roof]` per column, checked before
// anything is written so a refusal means no roof rather than half a roof.
//
// ⚠ THE RIDGE RUNS PAST BOTH ENDS ON PURPOSE. `draw_roof`'s own comment: stopping
// it at the wall makes the distance go radial past the tip, so the gable end rolls
// over like a cone quadrant — 0.43 units, 0.37 m of bulge. A hip is the same call
// with the ridge shortened, and then the conical ends are the FEATURE.
pub fn roof_over(w: &World, f: Footprint, cells: HexSet, floor_h: integer,
                 eave_up: integer, pitch: float, hip_steps: integer) -> Ack {
  if !f.fp_ok { return ack_no("no plan at this facing, so no ridge to run"); }
  pad = f.fp_wid + f.fp_dep + 4;
  hz = heights_new(f.fp_cq - pad, f.fp_cr - pad, 2 * pad + 1, 2 * pad + 1);
  eave = ((floor_h + eave_up) as float) * w.w_unit;
  draw_roof(footprint_plan(f), cells, hz, eave, pitch, hip_steps);

  n = 0;
  ridge = 0;
  for r in f.fp_cr - pad..f.fp_cr + pad + 1 {
    for q in f.fp_cq - pad..f.fp_cq + pad + 1 {
      if hexset_get(cells, q, r) {
        hu = (height_get(hz, q, r) / w.w_unit ?? 0.0) as integer;
        if hu > ridge { ridge = hu; }
        band: vector<hex_world::Hex> = [
          hex_world::Hex { h_height: (floor_h as u16? ?? 0),
                           h_material: (FLOOR_MAT as u8? ?? 0) },
          hex_world::Hex { h_height: (hu as u16? ?? 0),
                           h_material: (ROOF_MAT as u8? ?? 0) }
        ];
        wr = world_merge_band(w, q, r, floor_h, hu, band);
        if wr.cw_code != 0 {
          return ack_no("the roof was refused at ({q},{r}): {wr.cw_detail}");
        }
        n = n + 1;
      }
    }
  }
  ack_at(ack_about(n, "roof over {n} cells, ridge at {ridge}", ridge), f.fp_cq, f.fp_cr)
}

// The pitch a house gets when nobody says otherwise. ⚠ MEASURED IN A PICTURE, not
// chosen: 0.45 is 24 degrees, and at that angle the roof reads as a LID — the S6
// shot showed a flat red plane sitting on the walls. A domestic pitch is 35-45
// degrees, and 0.7 is 35: steep enough that the gable is visible from the ground,
// which is the only test this step has.
pub const ROOF_PITCH_DEFAULT = 0.70;
pub const ROOF_EAVE_UP = 12;      // the wall's own height — the roof starts where it ends
