//
// THE KEYBOARD IS THE PERSON'S — the definition layer, as DATA.
//
// ⚠ **WHY THIS EXISTS: *what key means what* IS ASSERTED IN FOUR PLACES AND ONE OF
// THEM IS VISIBLY WRONG ON SCREEN.** Counted 2026-08-15, and the last row is what
// turns this from tidiness into a defect:
//
//   1. `hex_editor::verb_of` — an `if` chain, and the authority. ⚠ **Deleted at
//      `M4`**: this table is the authority now, and the chain outlived its purpose
//      by exactly the four slices it took to prove this one
//   2. `editor_client.loft`'s `KEY_*` constants — a physical code per key
//   3. …and the poll block beside them, which spells the SAME key again as a string:
//      `gl_key_pressed(KEY_STOREY_UP)` then `verb_of("B")`. The file's own comment
//      admits it — *"the key is spelled twice here … a mismatch here is the last
//      place this step could hide one"*
//   4. `client_panel_spec`'s toolbar, which draws a hotkey GLYPH per button as a
//      literal. ⛔ **Three of its five are wrong**: it shows `e` beside *Stencil*
//      where `e` is `stair_up`, `c` beside *Cart* where `c` is `cellar`, and `f`
//      beside *Field* where `f` is `fence`. Nobody noticed, because a literal glyph
//      is connected to nothing that could disagree with it.
//
// > **THE INVARIANT: a key is resolved to a verb exactly ONCE, where the keyboard is,
// > out of a table the person owns — and nothing downstream can tell which key was
// > pressed.**
//
// The second clause is what makes rebinding free, and it is already true of
// everything below the resolution: the wire carries the verb
// ([EDITING_MODES](../../../doc/claude/EDITING_MODES.md)), `tools/scripts/*.keys`
// says `verb <name>` for every gesture since plan 22 `K3`, and `press_verb` never
// sees a key. **The scripts had to be converted first, and they now are** — a
// recording written in keystrokes would replay differently for two people.
//
// ⚠ **A KEY IS A LOCAL PREFERENCE AND A VERB IS A PUBLISHED NAME.** Renaming a verb
// breaks every recording in `tools/scripts/`; rebinding a key breaks nothing at all.
//
// ── ⚠ WHAT THIS FILE DELIBERATELY DOES NOT KNOW ────────────────────────────
//
// **Which verbs exist.** There is no `VB_*` in here and no default layout: those live
// in `hex_editor.loft` beside `press_verb`, which is the authority on what a verb
// DOES. This file is the mechanism — a table, a lookup, a rebind — and it would serve
// a different editor with a different vocabulary unchanged. That is `lavition_ui`'s
// rule one layer down: *this file knows nothing about what it is showing.*
//
// ⚠ **AND `""` IS THE UNBOUND VERB, WHICH THE ROOT MODULE CALLS `VB_NONE`.** It cannot
// be named here — `hex_editor.loft` `use`s this one and a `use` goes one way — so the
// equality is a TEST rather than a comment claiming it, exactly as `SLAB_PAD` is
// pinned to `HOUSE_W + HOUSE_D + 4`.

// ── ONE BINDING ─────────────────────────────────────────────────────────────
//
// ⚠ **TWO SPELLINGS OF ONE KEY, AND THAT IS NOT THE DUPLICATION ABOVE.** `kb_key` is
// the key's NAME — what `tools/scripts/*.keys` writes, what a person reads in a
// binding list, what the deleted `verb_of` took. `kb_code` is what the HARDWARE
// reports. They are two facts about one key and the second is DERIVED from the first
// by `key_code_of`, so a binding cannot carry a name and a code that disagree unless
// somebody builds one by hand.
//
// ⚠ AND THE CODE IS CARRIED RATHER THAN DERIVED AT EVERY POLL, because a GL client
// asks `gl_key_pressed(code)` once per binding per frame; a lookup by name there
// would put a string compare in the input loop.
pub struct KeyBind {
  kb_key:  text,        // "B", "ArrowUp", "Tab" — the name every driver shares
  kb_code: integer,     // the same key as `gl_key_pressed` takes; 0 = no code
  kb_verb: text,        // the verb it names
}

// The whole definition, in the order it is shown.
//
// ⚠ **A VECTOR AND NOT A MAP, BECAUSE THE ORDER IS PART OF THE ANSWER.** This is what
// a binding list and a verb bar are drawn from, and *which verb sits where* must not
// depend on a hash. It is short by construction — one row per verb a person can press
// — so a linear scan is the right shape as well as the honest one.
pub struct KeyMap { km_items: vector<KeyBind> }

// ── NAMES AND CODES ─────────────────────────────────────────────────────────
//
// ⚠ **THIS IS HARDWARE, NOT PREFERENCE, WHICH IS WHY IT IS A FUNCTION AND NOT A TABLE
// A PERSON EDITS.** Which byte the keyboard sends for `b` is not something anyone
// gets to choose; which VERB `b` names is the only choice this file carries.
//
// The code space is `graphics`': lowercase ASCII for letters, `48`–`57` for digits,
// `128`–`131` for the arrows, and the named keys the editor already uses. ⚠ `Tab` IS
// 9 AND IT IS NOT DECORATION — the catalogue cycles on it, and punctuation is
// unreachable to the page at all (the browser bridge's `mapKey` answers 0 for
// anything that is not `Key*`, `Digit*` or one of eight names), which is what made
// `Tab` the choice at plan 22 `K3`.
pub const KEY_NONE = 0;

const UPPERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const LOWERS = "abcdefghijklmnopqrstuvwxyz";
const DIGITS = "0123456789";

pub fn key_code_of(name: text) -> integer {
  if name == "ArrowUp"    { return 128; }
  if name == "ArrowDown"  { return 129; }
  if name == "ArrowLeft"  { return 130; }
  if name == "ArrowRight" { return 131; }
  if name == "Tab"        { return 9; }
  if name == "Space"      { return 32; }
  if name == "Escape"     { return 27; }
  // ⚠ THE LENGTH TEST COMES FIRST. Without it `"ArrowUp"` falls through to the letter
  // branch on its own first character and answers the code for `A` — a binding that
  // works, points at the wrong key, and never says so.
  if len(name) != 1 { return KEY_NONE; }
  for i in 0..26 {
    // Letters are NAMED in upper case (a script says `key B`) and PRESSED in lower.
    // The definition is about which key, not about a shift state.
    if name == UPPERS[i..i + 1] || name == LOWERS[i..i + 1] { return 97 + i; }
  }
  for d in 0..10 {
    if name == DIGITS[d..d + 1] { return 48 + d; }
  }
  KEY_NONE
}

// …and back, for a driver that has only what the hardware sent.
pub fn key_name_of(code: integer) -> text {
  if code == 128 { return "ArrowUp"; }
  if code == 129 { return "ArrowDown"; }
  if code == 130 { return "ArrowLeft"; }
  if code == 131 { return "ArrowRight"; }
  if code == 9   { return "Tab"; }
  if code == 32  { return "Space"; }
  if code == 27  { return "Escape"; }
  if code >= 97 && code <= 122 { return UPPERS[code - 97..code - 96]; }
  if code >= 48 && code <= 57  { return DIGITS[code - 48..code - 47]; }
  ""
}

// A key's name, short enough for a slot.
//
// ⛔ **THE ROW THAT CAUGHT THIS WAS A FIXTURE THAT COULD NOT FAIL.** The verb bar's
// layout suite used a one-character key for all fifteen of its slots, so *the glyph
// fits its box* passed with nothing to fit — and the first real run drew
// `ArrowUp:raise`, a seven-character name in a 34px slot at an 8px advance. Fifty-six
// pixels of text in thirty-four. **A fixture easier than the thing it stands for is
// how a picture claim goes green while the picture is wrong.**
//
// ⚠ **AND IT IS A SEPARATE FUNCTION RATHER THAN TRUNCATION, FOR `verb_short`'s
// REASON.** `ArrowUp` and `ArrowDown` share their first five characters, so a bar that
// truncated would draw two identical glyphs on two different keys — the failure the
// panel's hotkey column already shipped once, where "drag" cut to "d" and read as
// *press d*. ⚠ The bar truncates too, as a backstop; this is what stops it mattering.
//
// ⚠ ASCII, NOT ARROWS. `↑` reads better and the editor's font is a bitmap atlas built
// from the ASCII range — a glyph it has no cell for draws as nothing at all, which is
// the blank a rebind is supposed to mean.
pub fn key_glyph(name: text) -> text {
  if name == "ArrowUp"    { return "Up"; }
  if name == "ArrowDown"  { return "Dn"; }
  if name == "ArrowLeft"  { return "Lt"; }
  if name == "ArrowRight" { return "Rt"; }
  if name == "Space"      { return "Spc"; }
  if name == "Escape"     { return "Esc"; }
  name
}

// One row, with its code derived rather than written twice.
pub fn bind_of(key: text, verb: text) -> KeyBind {
  KeyBind { kb_key: key, kb_code: key_code_of(key), kb_verb: verb }
}

pub fn keymap_of(items: vector<KeyBind>) -> KeyMap { KeyMap { km_items: items } }

// ── ASKING THE MAP ──────────────────────────────────────────────────────────

// What this key names here. `""` — the root module's `VB_NONE` — is *nothing is bound
// to it*: a walk key, a camera key, or a key nobody has used yet.
pub fn verb_in(m: KeyMap, key: text) -> text {
  if key == "" { return ""; }
  for b in m.km_items { if b.kb_key == key { return b.kb_verb; } }
  ""
}

// …and the same question from a driver that has a hardware code.
//
// ⚠ **IT IS NOT `verb_in(m, key_name_of(code))`, AND THE DIFFERENCE IS REAL.** A code
// outside the named keys, the letters and the digits round-trips to `""`, which would
// then match an UNBOUND row — every rebind leaves one behind. Asking the code
// directly cannot do that, and the unbound rows carry `KEY_NONE` so they cannot be
// hit by a real press either.
pub fn verb_at_code(m: KeyMap, code: integer) -> text {
  if code == KEY_NONE { return ""; }
  for b in m.km_items { if b.kb_code == code { return b.kb_verb; } }
  ""
}

// Which key reaches this verb, for a bar or a binding list to draw. `""` means the
// verb is bound to nothing — which a UI must show as a BLANK rather than hide, so
// that *this verb exists and you have no key for it* stays visible.
pub fn key_for(m: KeyMap, verb: text) -> text {
  if verb == "" { return ""; }
  for b in m.km_items { if b.kb_verb == verb { return b.kb_key; } }
  ""
}

// …and the same answer as a hardware code, for a GL driver that polls per verb.
//
// ⚠ **THIS IS THE FUNCTION THAT DELETES THE `KEY_*` CONSTANTS.** A client polling
// `gl_key_pressed(KEY_STOREY_UP)` and then resolving the string `"B"` spells one key
// twice, in two alphabets, on adjacent lines — its own comment called that *"the last
// place this step could hide one"*. Polling `code_for(m, VB_STOREY)` names the VERB at
// the input site and lets the map say which finger reaches it, which is the invariant
// at the top of this file with the keyboard actually attached.
pub fn code_for(m: KeyMap, verb: text) -> integer {
  if verb == "" { return KEY_NONE; }
  for b in m.km_items { if b.kb_verb == verb { return b.kb_code; } }
  KEY_NONE
}

// The verbs this definition can reach, in the order they are shown.
//
// ⚠ **A QUERY AND NOT A CONSTANT, WHICH [EDITING_MODES] ASKED FOR BEFORE IT COULD BE
// BUILT.** *"A type that contributes verbs means the verb set is not knowable at
// compile time, so 'which keys does this editor have' becomes a query. Anything that
// lists keys — the subject line, a help overlay, a script validator — has to ask
// rather than know."* This is that function. The mode and the type narrow what it
// returns later, and no caller has to change when they do.
pub fn keymap_verbs(m: KeyMap) -> vector<text> {
  vs: vector<text> = [];
  for b in m.km_items { vs += [b.kb_verb]; }
  vs
}

// ── REBINDING ───────────────────────────────────────────────────────────────

// What a rebind did, because it is never only *ok*.
//
// ⚠ **A COLLISION IS THE NORMAL CASE, NOT THE ERROR CASE.** Every letter is taken —
// counted at plan 22 `K3`: 21 in the script's table and 5 more in the client's
// movement keys, all 26 — so *the key you want is already doing something* is what
// rebinding IS, and refusing it would make the feature useless. It replaces, and it
// says what it displaced: **reason, offer, residual, never a blank no**, applied to a
// keyboard.
pub struct BindMade {
  bm_ok:    boolean,
  bm_say:   text = "",
  bm_took:  text = "",       // the verb that lost this key; "" if it was free
  bm_freed: text = "",       // the key this verb used to have; "" if it had none
}

// Bind `key` to `verb`, moving it off whatever had it.
//
// ⚠ **A VERB HAS AT MOST ONE KEY, AND THAT IS A DECISION RATHER THAN A LIMITATION.**
// Two keys for one verb is harmless in itself; two ROWS for one verb is not, because
// a bar draws a row per verb and `key_for` answers the first. So a rebind MOVES a
// verb's row rather than adding one, and the vector stays one-row-per-verb — the
// property every reader of it assumes.
//
// ⚠ **AND THE DISPLACED VERB KEEPS ITS ROW WITH NO KEY, rather than being dropped.**
// A verb that vanished from the bar the moment you took its letter would look like a
// feature you had deleted; an empty slot says *this still exists and you have no key
// for it*, which is the only honest reading.
pub fn keymap_bind(m: KeyMap, key: text, verb: text) -> BindMade {
  if verb == "" {
    return BindMade { bm_ok: false, bm_say: "nothing to bind — name a verb" };
  }
  code = key_code_of(key);
  if code == KEY_NONE {
    return BindMade { bm_ok: false,
      bm_say: "'{key}' is not a key this editor can read" };
  }
  had  = key_for(m, verb);
  took = verb_in(m, key);
  if took == verb {
    return BindMade { bm_ok: true, bm_freed: had, bm_say: "{verb} is already on {key}" };
  }
  if key_for(m, verb) == "" && !verb_is_known(m, verb) {
    return BindMade { bm_ok: false,
      bm_say: "'{verb}' is not a verb this editor has" };
  }
  // ⚠ ONE PASS THAT REBUILDS, and the two arms are exclusive because `took != verb`
  // was answered above: a row is either the verb being moved or the one being
  // displaced, never both.
  next: vector<KeyBind> = [];
  for b in m.km_items {
    if b.kb_verb == verb {
      next += [KeyBind { kb_key: key, kb_code: code, kb_verb: verb }];
    } else if b.kb_key == key {
      next += [KeyBind { kb_key: "", kb_code: KEY_NONE, kb_verb: b.kb_verb }];
    } else {
      next += [b];
    }
  }
  m.km_items = next;
  if took == "" {
    return BindMade { bm_ok: true, bm_freed: had, bm_say: "{verb} is on {key}" };
  }
  BindMade { bm_ok: true, bm_took: took, bm_freed: had,
    bm_say: "{verb} is on {key} — {took} has no key now" }
}

// ⚠ **A REBIND MAY NOT INVENT A VERB, and this is what stops it.** `keymap_bind`
// MOVES a row; a verb with no row would silently bind nothing and report success,
// which is the *built and never called* defect reached through a typo. The map is the
// list of verbs this editor has — that is `keymap_verbs`' whole claim — so a name
// that is not in it is a mistake rather than a new feature.
pub fn verb_is_known(m: KeyMap, verb: text) -> boolean {
  for b in m.km_items { if b.kb_verb == verb { return true; } }
  false
}

// ── THE MAP OUTLIVES THE PAGE — plan 22 `M5b` ───────────────────────────────
//
// A rebind that dies with the tab is a preference nobody would ever set. `P6` proved a
// `--html` page has a filesystem — an immutable base tree plus a `localStorage` delta —
// so this is the map written into it and read back.
//
// ⛔ **A SAVED WHOLE TABLE PINS EVERY VERB TO THE LAYOUT OF THE DAY IT WAS WRITTEN,
// INCLUDING THE FOURTEEN THE AUTHOR NEVER CHOSE.** That is the defect, and it is worth
// being exact about which one it is: *a verb the editor GAINED keeps its key* is true of
// a whole table too, because `keymap_apply` assigns per named verb and leaves an
// unmentioned one alone. The row a whole table actually loses is the EDITOR's own
// freedom to move a default — change `raise` from `ArrowUp` in a release, and every
// person with a saved table stays on the old key forever, having asked for nothing.
//
// > **THE INVARIANT: the file holds only what the author CHANGED, so a verb they never
// > rebound follows the editor's default — including when that default moves.**
//
// ⚠ **AND THE BASE IS A PARAMETER RATHER THAN `keymap_default()`.** This file does not
// know which verbs exist — that is its first rule, at the top — and a delta computed
// against a default it reached for itself would be the layering broken for one
// convenience.

pub struct KeyLoad {
  kd_ok:      boolean,          // the map is in a state the editor can use
  kd_found:   boolean = false,  // …and there WAS a document; absent is not a failure
  kd_say:     text    = "",
  kd_took:    integer = 0,      // rows taken from the document
  kd_unknown: text    = "",     // verbs it names and this editor does not have
}

// ⚠ A VERSION IN THE FIRST LINE, because what has to be refused is not a corrupt file
// but a file some OTHER program wrote to the same name.
pub const KEYMAP_DOC = "keymap 1";

// The rows that differ from `base`, as the text that gets written down.
//
// ⛔ **A ROW WITH NO KEY IS RECORDED, AND LEAVING IT OUT IS NOT A SIMPLIFICATION.**
// Worked on paper before this was written. Default `A=1 B=2 C=3`; bind `B` to `1`, then
// bind `B` to `3`. The map is `A="" B=3 C=""`, and the only non-default row WITH a key
// is `B=3` — so a document holding just that, replayed onto a default, leaves `A` on
// `1`, a key its owner lost two gestures ago. The absences are what make the document
// exact, and they are why applying is an ASSIGNMENT rather than a replay of binds.
pub fn keymap_delta(m: KeyMap, base: KeyMap) -> text {
  out = KEYMAP_DOC;
  for b in m.km_items {
    if key_for(base, b.kb_verb) == b.kb_key { continue; }
    if b.kb_key == "" { out = out + "\n" + b.kb_verb; }
    else { out = out + "\n" + b.kb_verb + " " + b.kb_key; }
  }
  out + "\n"
}

// …and back onto a map the caller has just built from the CURRENT default.
//
// ⚠ **IT BUILDS A NEW VECTOR AND ASSIGNS AT THE END**, so a document that turns out to
// be illegal leaves the editor on its default rather than half-loaded. A person whose
// keyboard was reshaped by a bad file cannot reach the gesture that would fix it.
pub fn keymap_apply(m: KeyMap, doc: text) -> KeyLoad {
  lines = doc.split('\n');
  if len(lines) == 0 || (lines[0] ?? "").trim() != KEYMAP_DOC {
    return KeyLoad { kd_ok: false, kd_found: true,
      kd_say: "that file is not a key map this editor wrote" };
  }
  next: vector<KeyBind> = [];
  for b in m.km_items { next += [b]; }
  took = 0;
  unknown = "";
  for i in 1..len(lines) {
    ln = (lines[i] ?? "").trim();
    if ln == "" { continue; }
    verb = ln;
    key  = "";
    sp = ln.find(" ");
    if sp != null { verb = ln[..sp]; key = ln[sp + 1..].trim(); }
    if key != "" && key_code_of(key) == KEY_NONE {
      return KeyLoad { kd_ok: false, kd_found: true,
        kd_say: "that file binds '{verb}' to '{key}', which is not a key this editor "
              + "can read" };
    }
    hit = false;
    put: vector<KeyBind> = [];
    for b2 in next {
      if b2.kb_verb == verb {
        hit = true;
        put += [KeyBind { kb_key: key, kb_code: key_code_of(key), kb_verb: verb }];
      } else {
        put += [b2];
      }
    }
    // ⚠ **A VERB THIS EDITOR NO LONGER HAS IS DROPPED AND NAMED, never refused.** One
    // renamed verb would otherwise cost the author every other binding in the file.
    if !hit {
      if unknown != "" { unknown = unknown + ","; }
      unknown = unknown + verb;
      continue;
    }
    next = put;
    took = took + 1;
  }
  // ⚠ **ONE KEY PER VERB IS CHECKED RATHER THAN ASSUMED**, because this document is on a
  // disk a person can edit. A well-formed delta cannot collide — the row that lost a key
  // is recorded beside the row that took it — so a collision means the file was written
  // by hand, or by something else.
  for a in next {
    if a.kb_key == "" { continue; }
    n = 0;
    for b3 in next { if b3.kb_key == a.kb_key { n = n + 1; } }
    if n > 1 {
      return KeyLoad { kd_ok: false, kd_found: true,
        kd_say: "that file puts {n} verbs on '{a.kb_key}' — nothing was loaded" };
    }
  }
  m.km_items = next;
  if unknown != "" {
    return KeyLoad { kd_ok: true, kd_found: true, kd_took: took, kd_unknown: unknown,
      kd_say: "{took} binding(s) restored; '{unknown}' is not a verb this editor has" };
  }
  KeyLoad { kd_ok: true, kd_found: true, kd_took: took,
    kd_say: "{took} binding(s) restored" }
}

// ── …AND THE FILE ───────────────────────────────────────────────────────────
//
// ⚠ **TEXT, AND NOT THE WORLD'S BYTE FORMAT.** A key map is fifteen short rows a person
// may want to read, copy between machines or repair by hand, and there is no CRC to
// protect because a wrong line costs one binding rather than a document. `f.lines()` is
// loft's own reader, and `fs_read_text`/`fs_write_text` are both bound in an emitted
// `--html` page — checked in the import table before this was designed around them, and
// then measured in a running one.

pub fn keymap_save(m: KeyMap, base: KeyMap, path: text) -> boolean {
  // ⚠ A SAVE REPLACES. `f += …` on an existing file APPENDS — `world_save_as` carries
  // the scar, where an ordinary second save produced a file holding two worlds back to
  // back, the first of which read fine and the rest of which was unreachable.
  if exists(path) { delete(path); }
  f = file(path);
  f += keymap_delta(m, base);
  f.sync();
  // …and then ask the disk, because nothing above can fail out loud.
  file(path).size > 0
}

pub fn keymap_load(m: KeyMap, path: text) -> KeyLoad {
  f = file(path);
  // ⚠ **ABSENT IS NOT A FAILURE**, it is every first run — so `kd_ok` says *the map is
  // usable* and `kd_found` says *there was a document*. A caller that read one field for
  // both would report a fresh install as a broken one.
  if f.format == Format.NotExists {
    return KeyLoad { kd_ok: true, kd_say: "no saved key map — this is the default one" };
  }
  doc = "";
  for ln in f.lines() { doc = doc + ln + "\n"; }
  keymap_apply(m, doc)
}

// ── ARM, PICK, PRESS — rebinding as a state machine, plan 22 `M3` ────────────
//
// `keymap_bind` above is the EDIT; this is the gesture that reaches it from inside a
// running editor. Three moves — arm, pick a slot, press a key — and the reason it is
// a machine rather than three handlers is one sentence:
//
// > **THE INVARIANT: while a rebind is in progress the keyboard belongs to the
// > rebinder, and the key that COMPLETES one does not fire the verb it just bound.**
//
// ⛔ **THE SECOND CLAUSE IS A REAL DEFECT AND NOT A NICETY, because the client polls
// rather than listens.** `poll_input` asks `gl_key_pressed(code_for(m, verb))` every
// frame and acts on the EDGE. Bind `raise` to `B` and the physical `B` is still down
// on the very next frame: `verb_down(raise)` is suddenly true where it was false, so
// the edge fires and the ground rises. **The rebind gesture performs the verb it was
// defining** — and every instrument in the tree would report that as a correct raise.
// `RB_SETTLE` is what stops it: the machine keeps the keyboard until the key that
// completed the bind has come back up.
//
// ⚠ **AND `RB_ARMED` IS NOT DECORATION EITHER.** Without it a click on the bar would
// eat whatever key came next, so a person who clicked a slot to READ it would have
// silently rebound something. Arming is the deliberate act; the click is a choice
// inside it.
pub const RB_OFF    = 0;    // the keyboard is the editor's
pub const RB_ARMED  = 1;    // …the rebinder's, waiting for a verb to be picked
pub const RB_PICKED = 2;    // …and now waiting for the key that will name it
pub const RB_SETTLE = 3;    // bound; held until the completing key comes up

// The key that arms, and it is DELIBERATELY NOT IN THE MAP.
//
// ⚠ **A REBIND KEY YOU CAN REBIND AWAY IS A FEATURE YOU CAN LOCK YOURSELF OUT OF**,
// and every letter is taken, so an author hunting for a free key would reach for this
// one within the first minute. `Escape` is reachable everywhere the editor runs —
// the browser bridge's `mapKey` carries it (`Escape: 27`) — it names no verb, and
// *stop what you are doing* is what it already means to everyone.
pub const KEY_REBIND = 27;

pub struct Rebind {
  rb_at:   integer = 0,
  rb_verb: text    = "",     // the verb being rebound; "" unless RB_PICKED
  rb_code: integer = 0,      // the key held through RB_SETTLE
  // ⚠ **WHAT TO SAY, AND IT SURVIVES THE RETURN TO `RB_OFF`.** A machine that cleared
  // its sentence on finishing would wipe *cellar has no key now* off the screen in the
  // same frame it was earned — which is the one thing the person needs to read.
  rb_say:  text    = "",
  // The scan's memory — see `rebind_scan`. `rb_down` is the codes observed down on the
  // previous look; `rb_seen` says whether there HAS been a previous look, which is the
  // difference between a seed and an edge.
  rb_down: vector<integer> = [],
  rb_seen: boolean = false,
}

pub fn rebind_new() -> Rebind { Rebind {} }

// Is the rebinder holding the keyboard? The client's ONE question — see `act`/`wire`
// in `src/editor_client.loft`, where it is a fence at the two places a key becomes an
// effect rather than a condition sprinkled over ten edge detectors.
pub fn rebind_holds(rb: Rebind) -> boolean { rb.rb_at != RB_OFF }

// The arm key, from any state. It arms when off and CANCELS from anywhere else —
// including `RB_SETTLE`, where cancelling costs nothing because the bind already
// happened and the machine is only waiting for a finger.
pub fn rebind_arm(rb: Rebind) {
  // ⚠ THE SCAN'S MEMORY GOES BOTH WAYS, because it is only ever read while `RB_PICKED`
  // and a stale seed from a previous gesture would let a key that never moved read as
  // freshly pressed.
  rb.rb_down = [];
  rb.rb_seen = false;
  if rb.rb_at == RB_OFF {
    rb.rb_at   = RB_ARMED;
    rb.rb_verb = "";
    rb.rb_code = KEY_NONE;
    rb.rb_say  = "rebinding — pick a verb";
    return;
  }
  rb.rb_at   = RB_OFF;
  rb.rb_verb = "";
  rb.rb_code = KEY_NONE;
  rb.rb_say  = "rebinding cancelled";
}

// Choose the verb a key is about to name.
//
// ⚠ **RE-PICKING IS LEGAL AND REFUSING IT WOULD BE WRONG**: clicking a second slot is
// how a person corrects a mis-click, and the alternative is cancelling and arming
// again to fix a click.
//
// ⚠ **AND IT SAYS WHICH KEY THE VERB HAS NOW**, because *press a key for `cellar`* to
// somebody who cannot remember whether `cellar` is on `C` is half a prompt.
pub fn rebind_pick(rb: Rebind, m: KeyMap, verb: text) {
  if rb.rb_at != RB_ARMED && rb.rb_at != RB_PICKED { return; }
  // The same rule `keymap_bind` keeps, kept one move earlier so the prompt cannot
  // name a verb the bind would then refuse.
  if !verb_is_known(m, verb) {
    rb.rb_say = "'{verb}' is not a verb this editor has";
    return;
  }
  had = key_for(m, verb);
  rb.rb_at   = RB_PICKED;
  rb.rb_verb = verb;
  // ⚠ **AND A RE-PICK DELIBERATELY DOES NOT RESEED THE SCAN.** The obvious symmetry —
  // every pick starts a fresh observation — is WRONG here, and measured on paper before
  // it was written: `rb_down` has been tracking the keyboard continuously since the
  // first pick, so a key held across a corrected mis-click is already known to be
  // stale, and reseeding would additionally swallow a key the person struck in the same
  // frame as the second click. Arming is where the memory is dropped, because that is
  // the only gap the scan does not watch.
  if had == "" {
    rb.rb_say = "press a key for {verb} — it has none";
    return;
  }
  rb.rb_say = "press a key for {verb} — it is on {had} now";
}

// The key that names it. Answers what `keymap_bind` answered, so a caller that wants
// to know what was displaced reads it here rather than asking the map afterwards.
//
// ⚠ **A REFUSAL LEAVES THE PICK STANDING**, which is the difference between *that key
// cannot be read, try another* and *rebinding is over, start again*. Only a bind that
// happened moves the machine on.
pub fn rebind_press(rb: Rebind, m: KeyMap, code: integer) -> BindMade {
  if rb.rb_at != RB_PICKED {
    return BindMade { bm_ok: false, bm_say: "nothing is picked — nothing to rebind" };
  }
  // ⚠ **THE WAY OUT IS NOT BINDABLE.** In the client this is unreachable, because the
  // arm key is handled before the scan and means *cancel*; it is here because the
  // machine must be safe for a driver that has only a code, and because binding a verb
  // onto `Escape` is exactly the mistake that leaves an author with no way to arm.
  if code == KEY_REBIND {
    rb.rb_say = "that key arms rebinding — it cannot name a verb";
    return BindMade { bm_ok: false, bm_say: rb.rb_say };
  }
  name = key_name_of(code);
  if name == "" {
    rb.rb_say = "that key cannot be read here — press another";
    return BindMade { bm_ok: false, bm_say: rb.rb_say };
  }
  r = keymap_bind(m, name, rb.rb_verb);
  rb.rb_say = r.bm_say;
  if !r.bm_ok { return r; }
  rb.rb_at   = RB_SETTLE;
  rb.rb_code = code;
  r
}

// The finger came up — hand the keyboard back.
//
// ⚠ **`down` IS THE CALLER'S OBSERVATION AND NOT A CLOCK**, because that is the only
// honest form of *is it still held*: a machine that released after N frames would
// hand the keyboard back under a key somebody was leaning on, which is the defect
// `RB_SETTLE` exists to prevent, arriving a few milliseconds later.
pub fn rebind_release(rb: Rebind, down: boolean) {
  if rb.rb_at != RB_SETTLE || down { return; }
  rb.rb_at   = RB_OFF;
  rb.rb_code = KEY_NONE;
}

// Every code this editor can read, for a driver that must ask *which key is down*
// rather than *is this key down*.
//
// ⚠ **A SCAN AND NOT AN EVENT, BECAUSE THE CLIENT HAS NO EVENTS** — `graphics` offers
// `gl_key_pressed(code)` and nothing else, so *what did they just press* is 43 asks.
// It runs only while `RB_PICKED`, which is the handful of frames between a click and
// a keystroke.
pub fn key_codes() -> vector<integer> {
  cs: vector<integer> = [128, 129, 130, 131, 9, 32, KEY_REBIND];
  for i in 0..26 { cs += [97 + i]; }
  for d in 0..10 { cs += [48 + d]; }
  cs
}

fn code_among(cs: vector<integer>, c: integer) -> boolean {
  for x in cs { if x == c { return true; } }
  false
}

// …and WHICH of them was just pressed, out of a keyboard that can only be asked
// *is it down* — plan 22 `M5`.
//
// ⛔ **A KEY HELD FROM BEFORE THE PICK BINDS ITSELF, AND `RB_SETTLE` CANNOT SEE IT.**
// The settle above is the same missing edge at the other end of the gesture — the key
// that COMPLETES a bind is still down on the next frame — and this is the beginning of
// it: walk forward on `w`, press `Escape` with the other hand, click a slot, and `w` is
// bound before the person has chosen anything. Both halves are one fact about this
// editor, which is that `graphics` has no event queue.
//
// > **THE INVARIANT: only a key that has been observed UP since the pick, and is down
// > now, can name a verb.**
//
// ⚠ **AN EDGE DETECTOR WHOSE FIRST LOOK SEEDS RATHER THAN FIRES**, which is the whole
// mechanism and the only part of it that is not obvious. `st.was_arm` in the client
// does this for one key with a `false` seed, and it is right to: the client starts
// before any key can be down. This machine arrives in the MIDDLE of a keyboard whose
// state it has never seen, so *unknown* has to read as *was already down* — which is
// what makes a held key stale rather than fresh.
//
// ⚠ AND IT TAKES THE WHOLE OBSERVATION RATHER THAN ONE CODE AT A TIME, because *was
// this key down last time* cannot be answered by a caller that only reports the keys
// that are down NOW: a key that was released between two looks is invisible to it, and
// that release is exactly what makes the next press fresh.
pub fn rebind_scan(rb: Rebind, downs: vector<integer>) -> integer {
  if rb.rb_at != RB_PICKED { return KEY_NONE; }
  if !rb.rb_seen {
    rb.rb_seen = true;
    rb.rb_down = downs;
    // ⚠ **AND THE SILENCE THIS STEP INTRODUCES IS SAID OUT LOUD.** Before it, a key
    // held at the pick bound itself — wrong, and visible. After it, that key does
    // nothing at all, which is the *blank no* this tree refuses everywhere else. A
    // person who was holding the key they meant gets told why it did not take.
    if len(downs) > 0 {
      names = "";
      for c in downs {
        if names != "" { names = names + ","; }
        names = names + key_name_of(c);
      }
      rb.rb_say = "press a key for {rb.rb_verb} — {names} already down, so press it "
                + "again or use another";
    }
    return KEY_NONE;
  }
  fresh = KEY_NONE;
  for c in downs {
    if !code_among(rb.rb_down, c) { fresh = c; break; }
  }
  rb.rb_down = downs;
  fresh
}
