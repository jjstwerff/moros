//
// The voxel world — the implementation of the contract in
// `doc/claude/WORLD_MODEL.md` Part II, which is NORMATIVE. Rule names below
// (`F1`, `W1`, `E1`, `S1`, `R1`, `Q1` …) are that document's; where this file and
// the contract disagree, the contract is right and this file is a bug.
//
// The name is not a claim on Moros: `LAVITION.md`'s naming principle puts the
// brand in org and repo names and keeps `use X;` descriptive, and its
// `loft-libs-world` inventory already names this axis `hex_voxel`. Moros is one
// consumer — the tabletop RPG — and lavition is the editor product this serves.
//
// ⚠ THIS IS NOT A REFACTOR OF `moros_map`. It is written fresh beside it, per
// plan 8 § "How this is built". `moros_map` sits at a PREDECESSOR of the contract
// — chunks keyed one-layer-each, no window, no labels, and game state packed into
// two bits of its voxel — so reshaping it would mean carrying those forward.
// Being in one tree buys DESIGN reuse, not code reuse.
//
// Scope of V1: the model, the routine, and the guards. The file is V2, the edit
// clock V4. Nothing here reads or writes bytes.
// ⚠ No `use hex_grid` yet, and the reason is a finding rather than an oversight.
// `chunk_idx_32` / `hex_idx_32` live in **`hex_voxel`** (the audience-crystal
// package) and in `moros_map` privately — two copies, one of them made public
// with a comment explaining it is public so nobody re-implements it, and the
// other re-implementing it anyway. `hex_grid`, where they belong, has neither.
//
// Depending on `hex_voxel` here would mean importing a crystal-decay world model
// in order to divide a coordinate by 32. So V1 carries them locally, deliberately
// as a THIRD copy that is written down rather than hidden, and V9 moves the one
// true version down into `hex_grid` and deletes all three.

// ── The voxel ────────────────────────────────────────────────────────────────
//
// Seven integers, eight bytes. Every `u8` is an INDEX into a definition table,
// never a value: names, categories and floats live once per definition rather
// than once per cell, which is the whole reason a cell fits in eight bytes.
//
// In memory a height is ABSOLUTE. On disk it is relative to its chunk's window
// (`S1`), and `StoredHex` is a DIFFERENT TYPE precisely so the two cannot be
// confused — in loft `u16` is an alias of `integer`, so nominal separation is the
// only thing that turns "compared a windowed height against an absolute one" into
// a compile error rather than a wrong number at a chunk seam.
pub struct Hex {
  h_height:        u16,      // ABSOLUTE, above the world floor
  h_material:      u8,
  h_item:          u8,
  h_item_rotation: u8,
  h_wall_nw:        u8,
  h_wall_ne:       u8,
  h_wall_e:       u8,
}

pub struct StoredHex {
  sv_height:        u16,     // RELATIVE to its chunk's base — meaningless alone
  sv_material:      u8,
  sv_item:          u8,
  sv_item_rotation: u8,
  sv_wall_nw:        u8,
  sv_wall_ne:       u8,
  sv_wall_e:       u8,
}

// A cell is OCCUPIED iff its material is not absence. Index 0 is absence in every
// table, because a defaulted cell is all zeroes and that is what an unwritten cell
// IS.
pub fn hex_occupied(h: Hex) -> boolean { h.h_material != 0 }
pub fn stored_occupied(s: StoredHex) -> boolean { s.sv_material != 0 }

// ── `E1e` — AN EDGE IS CONTENT, WHATEVER THE CELL UNDER IT HOLDS ─────────────
//
// OCCUPIED and PRESENT are different questions, and collapsing them loses data.
//
//   occupied — is there GROUND here? The floor-and-roof question (`E1r`), what
//              `F1` stacks, what a column read means by a surface.
//   present  — does this cell RECORD carry anything at all? The storage question:
//              may elision drop it, must the window span its height.
//
// They part company because a hex stores three of its six edges, so the boundary
// of a region lives HALF in the region's cells and half in the cells outside it —
// and the cell that owns a slot need hold no ground. Keying elision on material
// alone therefore made a fence survive or vanish according to which SIDE of it the
// ground happened to be, an anisotropy with no physical meaning.
//
// Measured before it was fixed (`probe/edgehold.loft`): a wall beside occupied
// cells survived save and load, and a layer whose only content was walls was
// dropped whole at step 6 — silently, since a dropped layer reads back as absence.
pub fn hex_present(h: Hex) -> boolean {
  h.h_material != 0 || h.h_item != 0
    || h.h_wall_nw != 0 || h.h_wall_ne != 0 || h.h_wall_e != 0
}

pub fn stored_present(s: StoredHex) -> boolean {
  s.sv_material != 0 || s.sv_item != 0
    || s.sv_wall_nw != 0 || s.sv_wall_ne != 0 || s.sv_wall_e != 0
}

// ── Layers and chunks ────────────────────────────────────────────────────────

pub const KIND_TERRAIN  = 0;
pub const KIND_DRESSING = 1;

// ⚠ A RESERVED LABEL — the outdoors, and the answer to "which layer is the
// ground" for a caller that has no feet to ask about.
//
// `I1` identifies CORRESPONDING LAYERS OF DIFFERENT CHUNKS by label, and "the
// ground" is exactly such a correspondence, so this is the model's own mechanism
// used for what it is for. It is a NAME, matched by equality — never an ordinal,
// and nothing here reads label order.
//
// It is never drawn from `ν`, which starts above it. A chunk holding terrain
// carries exactly one; a chunk holding none carries none and reads as absent,
// which is height 0 — the same answer unauthored ground always gave.
//
// ⚠ This is NOT the feet's rule (`WORLD_MODEL.md` § "Which layer is the surface")
// with the feet dropped. A column with three storeys has three surfaces and one
// outdoors; the two questions have different answers and different callers.
pub const LABEL_GROUND  = 1;
pub const LABEL_FIRST   = 2;        // `ν` starts here — 1 is reserved above

pub const CHUNK_W    = 32;          // hexes per axis
pub const CHUNK_CELLS = 1024;       // CHUNK_W * CHUNK_W
// ⚠ THE SAME 32, SAID TWO MORE WAYS — because a chunk axis is a power of two and
// `world_chunk_of` / `local_of` are on every cell access in the store. A floor
// divide by a power of two IS an arithmetic shift, and the non-negative remainder
// IS a mask; both were spelled out as a branch and a division, and together they
// were **16.4 %** of `hex_editor`'s test suite.
//
// ⚠ THREE NAMES FOR ONE FACT IS A DUPLICATION, so it is asserted rather than
// trusted: `tests/lattice.loft` requires `1 << CHUNK_W_SHIFT == CHUNK_W` and
// `CHUNK_W_MASK == CHUNK_W - 1`. Change the width and the suite says which two
// constants did not follow.
//
// ⚠ **`CHUNK_W_SHIFT`, NOT `CHUNK_SHIFT` — AND THAT IS A COLLISION, NOT A STYLE.**
// `src/editor_server.loft` declares `const CHUNK_SHIFT = 3` for an **8-wide MESH
// chunk**, a different chunk entirely, and a public name is global across a
// consumer's whole dependency graph. The first spelling here compiled, passed
// `hex_voxel`'s 151 tests and `make lib-test`'s 3300 on both backends — and took
// the editor program from building to `error: constant 'CHUNK_SHIFT' conflicts`,
// with **every one of the 53 gates** reporting `SERVER NEVER LISTENED`. That is
// CLAUDE.md's *"a package suite cannot see this"* reproduced exactly. Grepped
// `lib/`, `src/`, `../loft-libs-world/` and the registry before the rename: zero
// hits for these two.
pub const CHUNK_W_SHIFT = 5;          // 1 << 5 == CHUNK_W
pub const CHUNK_W_MASK  = 31;         // CHUNK_W - 1
pub const LAYER_CAP  = 64;          // layers per chunk
pub const WINDOW     = 65536;       // what a u16 relative height spans

// A layer is this tile's own, with an OPTIONAL cross-chunk label (`I1`-`I3`):
// a u32 name drawn from the world's counter, never an ordinal, 0 = unlabelled.
pub struct Layer {
  ly_id:    integer,                // u32 label, 0 = unlabelled
  ly_kind:  integer,                // KIND_TERRAIN | KIND_DRESSING
  ly_ver:   integer,                // `T1` — the clock value at its last write
  ly_cells: vector<StoredHex>,      // exactly CHUNK_CELLS, terrain only
}

// A chunk is a (cx, cz) tile: a base height and its OWN ORDERED list of layers.
// The index of a layer is a position in THIS chunk and means nothing outside it —
// there is no world-wide layer list and no global budget.
pub struct VoxelChunk {
  ck_cx:     integer,
  ck_cz:     integer,
  ck_base:   integer,               // absolute floor of the window
  ck_layers: vector<Layer>,
}

// The chunk index. `find_chunk` was a linear scan over every chunk in the world,
// and a terrain sample calls it ONCE PER CELL — so a mesh rebuild over 48 loaded
// chunks was O(cells x chunks) and took seconds where the old peak-summing
// version took a tenth of one. The key packs (cx, cz) into one integer because a
// loft hash keys on a single field.
pub struct ChunkAt { ca_key: integer, ca_at: integer }

// A TAGGED SECTION — a four-character tag and bytes this library never reads.
//
// The store is the landscape and nothing else, and everything a consumer wants to
// keep BESIDE the landscape — what a part is called, where it anchors, what is
// placed in it (plan 17 `PART`, `ANCH`, `INST`) — travels here. `hex_voxel` owns
// the framing and never the content, exactly as it owns the palette's length and
// position without knowing what a material means.
//
// ⚠ THE POINT IS THE ONES IT DOES NOT KNOW. A section this build has never heard
// of is loaded, carried on the world, and written back byte for byte — so a newer
// writer does not cost an older reader the data it cannot use. That is the whole
// argument for tag+length over a flags word: this property can be TESTED, and a
// flags word offers nothing to test.
//
// ⚠ IT CARRIED A TEXT VIEW FOR A DAY, AND THE REASON WAS FALSE. Sections were
// built on 2026-08-03 believing loft could turn a text into bytes and nothing
// could turn them back, so the file layer looked like the only decoder and this
// reader was already holding the file. `text_from_bytes(vector<u8>)` and
// `byte_at(i)` had shipped **two releases earlier** and were merely missing from
// the generated reference (loft#748 — a documentation defect, not a language
// one). The view, its `sc_is_text` write flag and `world_set_section_text` are
// gone; a consumer that wants text decodes its own bytes, which is what a library
// that interprets nothing should have required all along.
//
// ⚠ `vector<u8>` AND NOT `vector<integer>`, and the type is doing real work.
// "each byte is a byte" used to be a `WS_SECTION` check at save time; the element
// type enforces it at every construction instead — `[1, 300]` is now
// *cannot implicitly narrow integer to u8*, at the literal, rather than a code
// returned by a save that already happened. It is also what makes a consumer's
// `text_from_bytes(s.sc_bytes)` correct: handing that builtin a
// `vector<integer>` is accepted SILENTLY and reads the 8-byte elements as bytes
// (loft#751), so `[72, 105]` decodes to `H` and a space.
pub struct Section {
  sc_tag:   integer,                // four ASCII characters, `section_tag("PART")`
  sc_bytes: vector<u8>,             // the consumer's bytes — opaque, and a BYTE type
}

pub struct VoxelWorld {
  w_chunks: vector<VoxelChunk>,
  w_index:  hash<ChunkAt[ca_key]>,
  w_unit:   float,                  // `u` — what one height step is worth
  w_reserve: integer,               // `ρ` — authoring floor
  w_eps:     integer,               // `ε` — minimum layer separation
  w_theta:   integer,               // `θ` — match tolerance
  w_next_id: integer,               // `ν` — next free label
  w_tau:     integer,               // `τ` — the edit clock, monotonic
  // Defaulted, so every existing `VoxelWorld { … }` literal in this tree and in its
  // consumers keeps compiling and a world simply has no sections until something
  // puts one there.
  w_sections: vector<Section> = [],
  // ── THE GROUND DEFAULT — plan `G4`, [GROUND_DEFAULT.md](../../../doc/claude/GROUND_DEFAULT.md)
  //
  // *A world is an infinite plane of its ground default, and storage holds only what
  // differs from it.* This is that default, and **absent means today, exactly**:
  // `Hex {}` has no material, `hex_present` says so, and every path behaves as it
  // always has until a scenario sets one. That is what makes `G4` revertible by
  // deleting a line and what lets the work stop here.
  //
  // ⚠ **NOTHING READS IT YET** — `G5` is where the accessors consult it. What `G4`
  // can be surprised by is the round trip (a default that does not survive save and
  // load is a scenario that silently forgets its own ground) and the `R1` check
  // (a ground under the reserve must be refused where it is STATED, not where a
  // layer is later born from it).
  //
  // ⚠ **A FIELD, AND A SECTION ONLY IN THE FORMAT.** `w_sections` says of itself
  // that it is *the consumer's bytes, which this library never reads*, so the
  // default does not live there — the codec writes a `GRND` section from this field
  // and reads it back into it. One home for the value, and the format still moves
  // not at all: an old build sees a tag it ignores, a new build sees a file without
  // one and starts absent.
  w_ground: Hex = Hex {},
}

// A column: ABSOLUTE heights, indexed by the chunk's layer order. It carries NO
// base — it is the absolute form, so the window cannot leak past it (`S1`).
pub struct Column {
  co_q:     integer,
  co_r:     integer,
  co_cells: vector<Hex>,            // one per layer of the chunk, in its order
  // ⚠ THE LABEL OF THE LAYER EACH CELL CAME FROM — identity travelling WITH the
  // cell. `F1″` makes index height order, so inserting below shifts every index;
  // a marker left on an index therefore lands on the wrong layer, which is how a
  // cellar took the ground's identity. `I1` uses labels by EQUALITY only, never
  // order, so a label is the one marker an insert cannot move.
  //
  // Defaulted to empty, so a caller building a fresh column supplies nothing and
  // keeps the positional behaviour it always had. A READ fills it, so any
  // read-modify-write carries identity through without the caller helping.
  // An EMPTY list here means "no claim about identity" — never "all new".
  co_ids:   vector<integer> = [],
}

// ── VoxelWorld creation ───────────────────────────────────────────────────────────

pub const WC_OK        = 0;
pub const WC_CONSTANTS = 1;         // `C1`: ε > 2θ does not hold

pub struct WorldNew { wn_code: integer, wn_world: VoxelWorld }

// ⚠ `C1` is checked HERE and never assumed. A world with ε ≤ 2θ fails `B1`
// SILENTLY — two layers can both fall within θ of one height — and the symptom is
// intermittently wrong geometry at chunk borders, which reads as a renderer bug.
pub fn world_new(unit: float, reserve: integer, eps: integer, theta: integer) -> WorldNew {
  if eps <= 2 * theta {
    return WorldNew { wn_code: WC_CONSTANTS, wn_world: VoxelWorld { w_unit: 1.0 } };
  }
  WorldNew {
    wn_code: WC_OK,
    wn_world: VoxelWorld { w_chunks: [], w_unit: unit, w_reserve: reserve,
                      w_eps: eps, w_theta: theta, w_next_id: LABEL_FIRST, w_tau: 1 },
  }
}

// ── Addressing ───────────────────────────────────────────────────────────────
//
// floor(v / 32), which is NOT `v / 32`: C-style division rounds toward zero, so
// cell −1 would land in chunk 0 instead of chunk −1, and every negative
// coordinate would fold onto its positive neighbour's tile. The same trap is
// documented on `hex_voxel`'s public copy; see the note at the top of this file.
// ⚠ `world_chunk_of`, NOT `chunk_of` — plan 19 `L6`. `gridmesh` publishes a
// `chunk_of` too, and it is a different function: `chunk_of(x, y, shift) -> ChunkKey`
// packs a chunk KEY, where this one floor-divides ONE axis. Both programs import both
// packages, so which one a bare call meant was decided by the order of the `use` block
// — `gridmesh` won in the server and this package won in the client, from the same two
// names. `tools/names.sh` found it; the rest of this API is `world_*` anyway.
// ⚠ AN ARITHMETIC SHIFT, AND IT IS THE SAME FUNCTION — not an approximation of it.
// This was a branch and a fallible division: `if v >= 0 { v / 32 } else { 0 - ((31
// - v) / 32) }`, which is floor division written out because `/` truncates toward
// zero. A chunk axis is a power of two, and `>>` on a signed integer floors by
// construction — so the branch, the division and its `?? 0` all go.
//
// ⚠ MEASURED EQUAL BEFORE IT WAS BELIEVED, on both backends: every value in
// `-200..200` through the old body and the new one, zero mismatches interpreted and
// zero under `--native`. loft's `>>` sign-extends and `&` yields the non-negative
// remainder — neither is a language guarantee anybody had written down here, and a
// LOGICAL shift would have turned `-1` into 288230376151711743 silently.
// `tests/lattice.loft` keeps that comparison as a test rather than a memory.
pub fn world_chunk_of(v: integer) -> integer { v >> CHUNK_W_SHIFT }

// The non-negative remainder, likewise: `v % 32` is negative for negative `v`, and
// the mask is not — `-1 & 31` is 31, which is the cell at the far edge of the chunk
// below, exactly what the subtraction used to compute.
pub fn local_of(v: integer) -> integer { v & CHUNK_W_MASK }

pub fn cell_index(q: integer, r: integer) -> integer {
  local_of(q) * CHUNK_W + local_of(r)
}

fn chunk_key(cx: integer, cz: integer) -> integer {
  ((cx & 4294967295) << 32) | (cz & 4294967295)
}

// ⚠ A ONE-ENTRY MEMO WAS TRIED HERE AND MEASURED WORSE — plan-less experiment,
// 2026-08-12, recorded so it is not re-attempted from the same reasoning.
//
// The idea: callers sample neighbouring hexes of one chunk, so remember the last
// chunk resolved and confirm it with `ck_cx`/`ck_cz` rather than deriving the key
// and probing the hash again. **Checked, never trusted** — a stale index either
// names a different chunk or falls out of range, so nothing has to invalidate it,
// which made it N=1 with no silent failure. The design was sound.
//
// ⚠ **IT COST 2.9 % INSTEAD OF SAVING 1.5–3 %.** `find_chunk` went from 3.8 % of
// `hex_editor`'s suite to **8.8 %**, the guard line alone 7.8 %. Two reasons, and
// the second is the one worth carrying:
//
//   · the guard is FOUR conditions — `w_last >= 0`, `< len(w_chunks)`, and two
//     coordinate compares — over three reads of `w_last` and a `len()` call. The
//     probe that priced it measured **two** compares with a literal index, so it
//     priced a simpler check than the one the design needs.
//   · and it mostly MISSES, which is the falsifier that was written down before
//     building: consecutive lookups in this suite do not hit the same chunk often
//     enough to pay for a guard on every call.
//
// **A probe of a simplified version of the thing is a probe of a different thing.**
//
// ⚠ AND INLINING `chunk_key` HERE WAS MEASURED TOO — **−0.74 %** (2,201,138 →
// 2,184,933 samples), because the call is ~42 % of the key's cost. **Not taken.**
// It would put the store's key ENCODING in two places: this reader and the six
// writers that build `ca_key` through `chunk_key`. A divergence makes every lookup
// miss — reads answer absent and writes create a duplicate chunk — which is loud in
// a suite and is still the same class that cost this tree a whole gate run today.
// **0.74 % of a test-time profile does not buy a second home for the key.**
fn find_chunk(w: VoxelWorld, cx: integer, cz: integer) -> integer {
  e = w.w_index[chunk_key(cx, cz)];
  if e == null { return 0 - 1; }
  e.ca_at
}

// Rebuilt whenever the chunk vector is reordered — which only happens when an
// emptied chunk is dropped. Every other path appends, and an append keeps every
// existing index valid.
fn reindex(w: VoxelWorld) {
  w.w_index = [];
  for i in 0..len(w.w_chunks) {
    w.w_index += ChunkAt { ca_key: chunk_key(w.w_chunks[i].ck_cx, w.w_chunks[i].ck_cz),
                           ca_at: i };
  }
}

pub fn world_has_chunk(w: VoxelWorld, q: integer, r: integer) -> boolean {
  find_chunk(w, world_chunk_of(q), world_chunk_of(r)) >= 0
}

// ⚠ **THE COMPREHENSION IS KEPT, AND THE APPEND LOOP WAS TRIED AND REVERTED.**
// This is 1024 records per layer and **6.8 %** of `hex_editor`'s test suite, so it
// looks like the obvious next win. On a microbenchmark the append form is **2.1×**
// faster — 100 × 1024 elements is 179 ms by comprehension against 85 ms by append,
// same value, same types. In the suite it was worth **0.6 %**, and it **broke two
// dressing tests**: a prop vanished when the ground under it was raised.
//
// ⚠ **FOUR HYPOTHESES FOR WHY WERE EACH REFUTED BY THEIR OWN PROBE**, so do not
// re-derive them: two calls do NOT share storage; cells within one vector do NOT
// alias each other; neither is true at 1024 rather than 4; and neither changes when
// the vector goes into a struct field inside a vector of structs, which is the shape
// the store actually uses. The two forms produce identical values in every probe and
// different behaviour in the consumer. **Not shipped, because 0.6 % does not buy a
// change to the store's core whose mechanism nobody can state.**
//
// ⏭ [loft#872](https://github.com/loft-lang/loft/issues/872) carries the finding with
// the four refutations attached.
//
// ⚠ AND THE SAME PATH HAS A CLIFF, found on the way: for a **ranged** element type a
// comprehension stops terminating above **16 elements** —
// `[for i in 0..17 { 0 as u8? ?? 0 }]` does not finish where 16 takes 40 ms and 4096
// plain integers take 50 ms ([loft#871](https://github.com/loft-lang/loft/issues/871)).
// `StoredHex` is a struct so this function is clear of it, but a **flat-byte-blob**
// layer — the obvious next representation — is built exactly that way, and reads as
// unworkable until you bisect the harness instead of the idea.
//
fn empty_cells() -> vector<StoredHex> {
  [for i in 0..CHUNK_CELLS { StoredHex {} }]
}

// ── Read ─────────────────────────────────────────────────────────────────────
//
// Every height gets `ck_base` ADDED here. This is the only addition in the
// design (`S1`); above this line a height is absolute and the window does not
// exist.

// ONE stored cell, decoded against its chunk's window base — the single place the
// addition happens, so `E1`(3) has one home instead of four.
//
// ⚠ AN ABSENT CELL HAS NO HEIGHT, AND THE BASE IS NOT ONE. `sv_height` is
// meaningless unless the cell is present (`S1`), so adding the base to a stored
// zero hands back a cell standing at `ck_base` — and ONE base serves the whole
// 32×32 tile. Four readers did exactly that, which made a single brush stroke
// silently raise the apparent ground of every unwritten cell in every chunk it
// touched.
//
// Measured (`probe/stale/extent.loft`): a radius-7 brush at the origin WROTE 91
// cells over q -5..5, r -5..5 and MOVED 4096 — the whole 64×64 block of the four
// chunks it opened, out to q,r -32..31. `terrain_h(20,20)` read 6 with nothing
// ever written there, because chunk (0,0) had rebased to 6.
//
// ⚠ IT IS THE READ THAT WAS WRONG, NOT THE MARKING. The dirty radius is `PEAK_R + 2`
// around a brush of `PEAK_R`, and it contains the write exactly; what escaped it was
// a height nobody wrote. That is why the editor's stale chunks sat ~48 units out,
// far past any plausible brush, and why every store-reading gate stayed green — the
// gates asked the same lying reader.
//
// `E1`(3) is the rule — *reading an absent cell yields exactly what reading a stored
// all-zero one would* — and `stored_present` is the predicate the WRITE path already
// uses to fit the window and to rebase (`W1`). Both ends now ask the same question.
fn hex_of(base: integer, e: StoredHex) -> Hex {
  if !stored_present(e) { return Hex {}; }
  return Hex { h_height: (base + e.sv_height) as u16? ?? 0,
               h_material: e.sv_material, h_item: e.sv_item,
               h_item_rotation: e.sv_item_rotation, h_wall_nw: e.sv_wall_nw,
               h_wall_ne: e.sv_wall_ne, h_wall_e: e.sv_wall_e };
}
// `ν` — the next free label. The field existed, was persisted, and was never
// incremented: every layer's label was 0, so nothing could be identified across a
// shift. Labels are equality-only (`I1`), so a monotonic counter is the whole of
// the identity this model asks for.
fn fresh_label(w: VoxelWorld) -> integer {
  id = w.w_next_id;
  w.w_next_id = w.w_next_id + 1;
  id
}

// A name for a layer a caller is about to build, taken ONCE and handed to every
// column of it.
//
// ⚠ THIS EXISTS BECAUSE `I1` WAS BEING BROKEN BY THIS FILE. A layer is chunk-wide,
// so one gesture covering a disc that straddles a boundary makes a layer in each
// chunk — and `world_set_column` allocated a fresh label for each, because a caller
// had no way to say the second was a continuation of the first. Measured from the
// editor: one cellar carrying label 2 on one side of the seam and 3 on the other,
// cells at the same height adjacent across it, which is the exact case §I1 forbids.
//
// The identity belongs to whoever knows the extent, and that is never this function:
// a column write sees one column. So the caller names the layer and `world_set_column_as`
// spends the name on whatever it creates.
pub fn world_fresh_label(w: VoxelWorld) -> integer { fresh_label(w) }

// The label to stamp on a layer being created in chunk `ci`: the caller's name if it
// supplied one, otherwise a fresh one.
//
// ⚠ AND NEVER THE SAME NAME TWICE IN ONE CHUNK. A label is an identity, so two
// layers of one chunk answering to it would make every by-label read take whichever
// came first — silently, and with no way to tell which. It cannot happen through a
// gesture, because after the first column creates the layer the rest find it and
// create nothing; this is the guard that says so rather than assuming it, and it
// degrades to a fresh label instead of corrupting the chunk.
fn named_label(w: VoxelWorld, ci: integer, new_id: integer) -> integer {
  if new_id == 0 { return fresh_label(w); }
  for ly in w.w_chunks[ci].ck_layers {
    if ly.ly_id == new_id { return fresh_label(w); }
  }
  new_id
}

// The label of the layer at index `l`, so a caller can tell one layer from another
// across an insert that renumbers them.
pub fn world_layer_id(w: VoxelWorld, q: integer, r: integer, l: integer) -> integer {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return 0; }
  if l < 0 || l >= len(w.w_chunks[ci].ck_layers) { return 0; }
  w.w_chunks[ci].ck_layers[l].ly_id
}

// Which layer here is the outdoors — the index of the one labelled `LABEL_GROUND`,
// or −1 when this chunk holds no terrain at all.
//
// ⚠ −1 IS A USABLE ANSWER, not an error to branch on: `world_cell` guards `l < 0`
// and hands back an absent cell, which is height 0 — the flat plane, and exactly
// what unauthored ground has always read as. Callers pass it straight through.
pub fn world_ground_layer(w: VoxelWorld, q: integer, r: integer) -> integer {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  // `G5a` — the synthesised ground is layer 0, which is where a minted one lands.
  if ci < 0 {
    if world_has_ground_default(w) { return 0; }
    return 0 - 1;
  }
  // ⚠ ITERATED, NOT INDEXED — 1.6× on the same scan, measured. `w.w_chunks[ci]
  // .ck_layers[i].ly_id` walks three levels for one field, and the condition reads
  // TWO fields, so an indexed scan pays six navigations per layer where a loop
  // binding pays two. 200k scans over a 4-layer chunk: 369 ms indexed, 229 ms
  // iterated. ⚠ The binding is a REFERENCE, not a copy — `world_set_column_as`'s
  // rebase mutates through exactly this form and the change sticks — so a layer's
  // 1024 cells are not touched by taking it.
  gli = 0;
  for gly in w.w_chunks[ci].ck_layers {
    if gly.ly_id == LABEL_GROUND && gly.ly_kind == KIND_TERRAIN { return gli; }
    gli = gli + 1;
  }
  0 - 1
}

// The ground cell at a hex — the chokepoint every "the ground here" read goes
// through, and the reason the editor no longer names a layer INDEX anywhere.
//
// One chunk lookup, one scan of at most `LAYER_CAP` labels, one cell. It is a
// sampling-path call — a mesh rebuild makes thousands — so it deliberately does
// NOT build a `Column`: doing that per sample once slowed chunk rebuilds enough to
// reorder the editor's own gates.
pub fn world_ground_cell(w: VoxelWorld, q: integer, r: integer) -> Hex {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  // `G5a` — THE chokepoint for *the ground here*, so it is the one this matters most
  // at: every gesture that seats something asks it.
  if ci < 0 {
    if world_has_ground_default(w) { return ground_copy(w); }
    return Hex {};
  }
  // ⚠ ITERATED, NOT INDEXED — see `world_ground_layer` above for the measurement.
  // This is the sampling chokepoint (*a mesh rebuild makes thousands*) and it was
  // the top of the profile at 8.4 %, most of it these two lines.
  gl = 0 - 1;
  gn = 0;
  for gcl in w.w_chunks[ci].ck_layers {
    if gcl.ly_id == LABEL_GROUND && gcl.ly_kind == KIND_TERRAIN { gl = gn; break; }
    gn = gn + 1;
  }
  // ⚠ `G5b` MAKES THIS REACHABLE FOR A CHUNK THAT EXISTS. A ground layer equal to the
  // default everywhere is dropped, and if a storey above keeps the chunk alive there
  // is then no `LABEL_GROUND` layer to find — but the ground is still there, because
  // the default is what an unwritten cell reads as. Without this, elision punches
  // back exactly the hole `G5a.1` closed.
  if gl < 0 {
    if world_has_ground_default(w) { return ground_copy(w); }
    return Hex {};
  }
  e = w.w_chunks[ci].ck_layers[gl].ly_cells[cell_index(q, r)];
  return cell_or_ground(w, w.w_chunks[ci].ck_base, w.w_chunks[ci].ck_layers[gl], e);
}

// ── The OTHER surface question — the one that takes a height ─────────────────
//
// `world_ground_cell` above answers *which layer is the outdoors*. This answers
// *which surface is someone at this height standing on*, and the two are genuinely
// different questions with different answers: a column with three storeys has ONE
// outdoors and THREE surfaces. `WORLD_MODEL.md` § "Which layer is the surface":
//
// > The surface at a hex is the highest occupied `KIND_TERRAIN` layer at or below
// > the feet.
//
// It lived in the editor, over a `Column` read — which allocates a `Hex` per layer
// on every call. That was affordable while only the feet asked, once a tick. The
// camera asks it about five times per boom sample, fifteen booms a tick, so it is
// here instead: one chunk lookup, no allocation, and the invariant sits in the
// library where a pure test can reach it rather than in a consumer.
pub struct SurfaceAt {
  sf_units:  integer,     // the surface height, absolute; −1 when nothing is here
  // ⚠ WHICH layer answered, so a WRITER can reach it. `world_ground_layer` is the
  // same service for the outdoors; this is it for "the surface I am standing on",
  // and a road graded from a deck must land on the deck, not three storeys down.
  sf_layer:  integer,     // index of the layer chosen; −1 when there is none
  sf_occ:    integer,     // how many occupied terrain layers this column holds
  // ⚠ SMOOTH FOR TERRAIN, FLAT FOR WHAT IS BUILT ON IT. One occupied layer — or
  // none — is the ordinary case and the caller should interpolate its heightfield
  // across the cell's corners, which is what makes a slope a slope. A deck is not
  // a heightfield and is taken flat. Reported rather than decided here, because
  // the interpolation is the consumer's geometry, not the store's.
  sf_smooth: boolean,
}

// `feet` is in the same absolute units as a cell's height.
//
// The tolerance is the model's own `ε`: layers are at least that far apart, so
// half of it cannot select the wrong one, and it absorbs the difference between a
// terrain layer's smoothed surface and its cell's stored integer height — on any
// slope the interpolated surface sits BELOW the cell's own value.
pub fn world_surface(w: VoxelWorld, q: integer, r: integer, feet: float) -> SurfaceAt {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 {
    // `G5a` — one occupied terrain layer, so the surface is the ground's height at
    // layer 0 whatever the feet are: with a single layer the loop below reaches the
    // same answer through `low` when nothing is at or under the feet and through
    // `best` when it is. ⚠ `hex_occupied`, not `hex_present`: the loop tests the
    // MATERIAL, so a default carrying only an edge is no surface here either.
    if world_has_ground_default(w) && hex_occupied(w.w_ground) {
      return SurfaceAt { sf_units: w.w_ground.h_height, sf_layer: 0, sf_occ: 1,
                         sf_smooth: true };
    }
    return SurfaceAt { sf_units: 0 - 1, sf_layer: 0 - 1, sf_occ: 0, sf_smooth: true };
  }
  ix = cell_index(q, r);
  base = w.w_chunks[ci].ck_base;
  // ⚠ THE TOLERANCE IS `θ`, WHICH IS WHAT §5 SAYS AND WHAT THIS DID NOT. It read
  // `ε/2`, reasoning that `F1` keeps layers ε apart so half of it cannot select two.
  // The uniqueness is right; the CONSTANT is not. θ is the model's own *"largest step
  // read as continuous"* and §5's match is defined with it — `|H − h| ≤ θ` — while
  // ε/2 is half the fold separation and answers a different question.
  //
  // ⚠ AND ε/2 REACHES A LAYER THE WALKER IS STANDING UNDER. Feet exactly midway
  // between two layers ε apart are ε/2 from BOTH, so the "at or below" rule picks the
  // one ABOVE. Measured on the cellar stair: feet 14, a tread at 10 and the floor at
  // 18, and the query answered 18 — the walker climbed its own ceiling. `B1` needs
  // only `ε > 2θ` for the match to be unique, so θ costs nothing and cannot reach
  // past the midpoint.
  tol = w.w_theta as float;
  best = 0; found = false; low = 0; havelow = false; occ = 0;
  bestl = 0 - 1; lowl = 0 - 1; li = 0 - 1;
  for ly in w.w_chunks[ci].ck_layers {
    li = li + 1;
    // `G5a.1` — the EFFECTIVE cell, so an unwritten ground cell of an existing
    // chunk is the surface it is everywhere else. `hex_occupied` on it is the same
    // material test the stored one made.
    eff = cell_or_ground(w, base, ly, ly.ly_cells[ix]);
    if ly.ly_kind == KIND_TERRAIN && hex_occupied(eff) {
      hh = eff.h_height;
      occ = occ + 1;
      // `F1″` makes layer order height order, so the first occupied one is the
      // lowest — no sort, and no assumption beyond the invariant.
      if !havelow { low = hh; lowl = li; havelow = true; }
      if (hh as float) <= feet + tol {
        if !found || hh > best { best = hh; bestl = li; found = true; }
      }
    }
  }
  if !havelow { return SurfaceAt { sf_units: 0 - 1, sf_layer: 0 - 1, sf_occ: 0, sf_smooth: true }; }
  // Below every floor — land on the lowest rather than on nothing. Falling into a
  // sealed cellar has to end somewhere, and the alternative is falling forever.
  h = low; hl = lowl;
  if found { h = best; hl = bestl; }
  SurfaceAt { sf_units: h, sf_layer: hl, sf_occ: occ, sf_smooth: occ <= 1 }
}

pub fn world_column(w: VoxelWorld, q: integer, r: integer) -> Column {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  // A missing chunk is an empty column, never a refusal: unauthored ground is a
  // legal answer, and `E1` makes absent and all-zero indistinguishable.
  //
  // ⚠ `G5a` — AND IF THE WORLD HAS A GROUND, "unauthored" IS NOT EMPTY. It is the
  // one cell a minted first layer would hold, under the reserved label it would take.
  if ci < 0 {
    if world_has_ground_default(w) {
      return Column { co_q: q, co_r: r, co_cells: [ground_copy(w)],
                      co_ids: [LABEL_GROUND] };
    }
    return Column { co_q: q, co_r: r, co_cells: [] };
  }
  ch = w.w_chunks[ci];
  ix = cell_index(q, r);
  out: vector<Hex> = [];
  ids: vector<integer> = [];
  for ly in ch.ck_layers {
    ids += [ly.ly_id];
    if ly.ly_kind == KIND_TERRAIN {
      c = ly.ly_cells[ix];
      out += [cell_or_ground(w, ch.ck_base, ly, c)];
    } else {
      out += [Hex {}];   // dressing holds no cell here; see #14
    }
  }
  Column { co_q: q, co_r: r, co_cells: out, co_ids: ids }
}

// Convenience over `world_column`. Read-only, and deliberately WITHOUT a writing
// twin — a single-cell write cannot check any rule in the contract, because every
// rule is a property of a column.
// ⚠ Reads the cell DIRECTLY — it does not go through `world_column`.
//
// The convenience version did, and it allocated a whole `Column` (a vector, plus
// a `Hex` per layer) for every single cell anyone sampled. A mesh rebuild samples
// thousands of cells, so the editor's chunk rebuilds slowed enough to reorder its
// own gates. The column is the unit the WRITE path needs, because every invariant
// is a column property; the read path needs one cell and should pay for one.
pub fn world_cell(w: VoxelWorld, q: integer, r: integer, l: integer) -> Hex {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  // `G5a` — an absent chunk is one defaulted ground layer at index 0, and nothing
  // above it. A caller asking for layer 3 of untouched ground is asking about a
  // storey that was never built, which is absence either way.
  if ci < 0 {
    if world_has_ground_default(w) && l == 0 { return ground_copy(w); }
    return Hex {};
  }
  if l < 0 || l >= len(w.w_chunks[ci].ck_layers) { return Hex {}; }
  if w.w_chunks[ci].ck_layers[l].ly_kind != KIND_TERRAIN { return Hex {}; }
  // The height is un-windowed here, so this builds a record regardless — the copy
  // is the conversion, not a workaround. (It also WAS a workaround for loft H12,
  // now fixed: returning `local.vec[i]` used to hand back a dead value.)
  e = w.w_chunks[ci].ck_layers[l].ly_cells[cell_index(q, r)];
  return cell_or_ground(w, w.w_chunks[ci].ck_base, w.w_chunks[ci].ck_layers[l], e);
}

// ── Write — the whole routine ────────────────────────────────────────────────

pub const CW_OK        = 0;
pub const CW_FOLD      = 1;   // a layer breached the one above (`F1`)
pub const CW_WINDOW    = 2;   // the tile's span exceeds any window (`W1`)
pub const CW_LAYER_CAP = 3;   // more layers than a chunk may hold
pub const CW_RESERVE   = 4;   // terrain authored below `ρ` (`R1`)
pub const CW_BAND      = 5;   // a stencil cell sat outside its declared band (`P1`)
pub const CW_MIX       = 6;   // terrain content aimed at a dressing layer (`P2`)

pub struct ColumnWrite { cw_code: integer, cw_layer: integer, cw_detail: text }

fn ok_write() -> ColumnWrite { ColumnWrite { cw_code: CW_OK, cw_layer: 0 - 1, cw_detail: "" } }

// Steps 1 and 2 of the routine: the checks that run BEFORE anything is written,
// so a refusal leaves the world untouched rather than half-applied.
fn check_column(w: VoxelWorld, col: Column) -> ColumnWrite {
  // `P2` — TERRAIN AND DRESSING DO NOT MIX. A column write addresses layers BY
  // INDEX, so a caller that miscounts does not get a shifted picture — it gets
  // terrain written into a dressing layer, which is the one thing the two-kind
  // split exists to prevent. Nothing downstream could detect it afterwards:
  // `world_column` reads dressing layers as absent, so the mixed cell would
  // simply be invisible, and the terrain it displaced would be gone.
  //
  // The guard lives HERE because this is the only place a cell reaches a layer.
  // Put it in the callers and it is N places that must each remember; put it
  // here and forgetting is impossible.
  for k in 0..len(col.co_cells) {
    if hex_present(col.co_cells[k])
       && world_layer_kind(w, col.co_q, col.co_r, k) != KIND_TERRAIN {
      return ColumnWrite { cw_code: CW_MIX, cw_layer: k,
                           cw_detail: "layer {k} is dressing; terrain cannot be written into it" };
    }
  }
  // `R1` — nothing authored below the reserve. The space beneath belongs to
  // whatever gets dug later, and heights are unsigned so there is no digging
  // below zero to fall back on.
  for i in 0..len(col.co_cells) {
    c = col.co_cells[i];
    if hex_present(c) && c.h_height < w.w_reserve {
      return ColumnWrite { cw_code: CW_RESERVE, cw_layer: i,
                           cw_detail: "height {c.h_height} is below the reserve {w.w_reserve}" };
    }
  }
  // `F1` — consecutive OCCUPIED layers separated by at least ε. Absent layers are
  // gaps, not constraints: terrain at 3 under terrain at 9 constrains 3 against 9
  // and nothing between. Compared in ABSOLUTE space, which is the only space a
  // Column has.
  prev = 0 - 1;
  for i in 0..len(col.co_cells) {
    if hex_occupied(col.co_cells[i]) {
      if prev >= 0 {
        gap = col.co_cells[i].h_height - col.co_cells[prev].h_height;
        if gap < w.w_eps {
          return ColumnWrite { cw_code: CW_FOLD, cw_layer: i,
                               cw_detail: "layer {i} is {gap} above layer {prev}, needs {w.w_eps}" };
        }
      }
      prev = i;
    }
  }
  ok_write()
}

// Steps 3-6: fit the window, materialise layers, encode, drop what emptied.
//
// `w` is a reference because the routine may rebase the chunk and append to the
// world's chunk list — the caller's world is the one that changes.
// ── `P1` — A STENCIL WRITES A BAND, NOT A COLUMN ─────────────────────────────
//
// A stencil is content with a vertical extent, placed into a column that may
// already hold other things: a cave under it, a bridge over it, the surface it
// meets. Replacing the column would be the easy write and the wrong one — it
// would delete the cave to build the house.
//
// So a placement declares the closed interval `[lo, hi]` it OWNS, and the write:
//   · replaces every occupied cell whose height lies in `[lo, hi]`,
//   · keeps every occupied cell outside it, unchanged,
//   · refuses if the result would breach `F1` against the nearest kept cell
//     below `lo` or above `hi` — refuses, never clips, never silently drops.
//
// That one rule is all three cases the editor needs. Under a bridge: the deck is
// above `hi`, so it is kept. Over a cave: the floor is below `lo`, so it is kept.
// On the surface: the surface cell is inside the band, so the stencil's own floor
// replaces it — which is what "interacts with the surface" means concretely.
//
// ⚠ INDEX IS NOT IDENTITY. A column is height-ascending because `F1` compares
// CONSECUTIVE occupied cells in vector order, so when a band's cell count differs
// from what it replaced, every cell ABOVE it shifts slot. Cells below keep theirs.
// Anything needing a stable handle across a merge must hold the layer's `ly_id`,
// not its index — the same shape of mistake as reading `cells[n-1]` for the roof
// (`E1r`): a position is not a name.
//
// Validation is NOT duplicated here. This composes the merged column and hands it
// to `world_set_column`, so there is exactly one place that decides whether a
// column is legal, and a band cannot acquire a weaker rule than a plain write.
// The column a band placement WOULD produce. Split out so a caller can ask
// before it writes: a placement covering many columns must be able to refuse as
// a whole, and the only honest way to know is to compose and check each one
// first. This is not a second validator — `world_band_check` runs the same
// `check_column` the write runs.
fn band_column(w: VoxelWorld, cq: integer, cr: integer,
               lo: integer, hi: integer, band: vector<Hex>) -> Column {
  cur = world_column(w, cq, cr);

  // What survives, plus what the band brings, in ascending height — the order
  // `F1` reads.
  // PRESENT, not occupied (`E1e`): a cell holding only the boundary edges of the
  // region beside it is content, and compacting by material would drop it here as
  // surely as elision did.
  keep: vector<Hex> = [];
  for e in cur.co_cells {
    if hex_present(e) && (e.h_height as integer ?? 0) < lo { keep += [e]; }
  }
  for b2 in band { if hex_present(b2) { keep += [b2]; } }
  for e2 in cur.co_cells {
    if hex_present(e2) && (e2.h_height as integer ?? 0) > hi { keep += [e2]; }
  }

  // ⚠ REBUILD INDEX-ALIGNED, do not compact. A column read carries one entry per
  // layer OF THE CHUNK, dressing layers included as absent placeholders, and a
  // write puts entry `i` into layer `i`. Packing the survivors into a dense
  // vector therefore slides terrain DOWN into whatever slots the dressing layers
  // held — `P2` violated, and invisibly, since a dressing layer reads back as
  // absent. So terrain goes only into terrain slots, ascending, and the dressing
  // slots keep the placeholder they came with.
  out: vector<Hex> = [];
  taken = 0;
  for i in 0..len(cur.co_cells) {
    if world_layer_kind(w, cq, cr, i) == KIND_TERRAIN && taken < len(keep) {
      out += [keep[taken]];
      taken = taken + 1;
    } else {
      out += [Hex {}];
    }
  }
  // Anything that did not fit extends the stack. These are the HIGHEST cells, so
  // appending keeps the ascending order the slot assignment above relies on.
  while taken < len(keep) { out += [keep[taken]]; taken = taken + 1; }

  Column { co_q: cq, co_r: cr, co_cells: out }
}

// Would this placement be accepted? Read-only, and the SAME check the write runs.
pub fn world_band_check(w: VoxelWorld, cq: integer, cr: integer,
                        lo: integer, hi: integer, band: vector<Hex>) -> ColumnWrite {
  if hi < lo {
    return ColumnWrite { cw_code: CW_BAND, cw_layer: 0 - 1,
                         cw_detail: "band [{lo},{hi}] is inverted" };
  }
  // `G0` — the caller's declared band is CHECKED, not trusted. A cell outside it
  // would silently overwrite something the interval promised to preserve, and the
  // promise is the whole point of the operation.
  for b in band {
    bh = b.h_height as integer ?? 0;
    if hex_occupied(b) && (bh < lo || bh > hi) {
      return ColumnWrite { cw_code: CW_BAND, cw_layer: 0 - 1,
                           cw_detail: "stencil cell at {bh} is outside its band [{lo},{hi}]" };
    }
  }
  check_column(w, band_column(w, cq, cr, lo, hi, band))
}

pub fn world_merge_band(w: VoxelWorld, cq: integer, cr: integer,
                        lo: integer, hi: integer, band: vector<Hex>) -> ColumnWrite {
  world_merge_band_as(w, cq, cr, lo, hi, band, 0)
}

// The same merge, with a NAME for the layer it creates — `I1` again, and it needed
// doing here as well as on the plain column write.
//
// ⚠ A ROOF STRADDLING A SEAM HAD THE IDENTICAL DEFECT. Measured: a stencil cone
// centred on a chunk boundary came back with its roof layer labelled 5 on one side
// and 4 on the other. Fixing only `world_set_column` would have repaired the cellar
// and left every house and roof breaking the invariant — a half-fix whose gate goes
// green while saying nothing about the other half.
//
// ⚠ THE NAME IS FOR THE LAYER THIS CALL CREATES, singular. A band can in principle
// create two — a floor and a roof over virgin ground — and then only the first takes
// the name, because `named_label` will not put one id on two layers of a chunk. That
// is a real limit and it is stated rather than assumed: every gesture here merges a
// band onto ground that already exists, so the floor lands in the ground layer and
// the roof is the only thing made. `test_a_band_onto_authored_ground_makes_exactly_one_layer` is the test that says so.
pub fn world_merge_band_as(w: VoxelWorld, cq: integer, cr: integer,
                           lo: integer, hi: integer, band: vector<Hex>,
                           new_id: integer) -> ColumnWrite {
  pre = world_band_check(w, cq, cr, lo, hi, band);
  if pre.cw_code != CW_OK { return pre; }
  world_set_column_as(w, band_column(w, cq, cr, lo, hi, band), new_id)
}

// ── `D1` — DRESSING IS INERT, AND IT NEEDS A WAY IN ─────────────────────────
//
// > Dressing layers are excluded from `col_K`, from `F1`, and from every
// > collision query. Adding, removing or altering one leaves every terrain layer
// > bit-identical.
//
// Until now nothing could CREATE one: `world_set_column` materialises every
// layer as terrain, so `P2` was enforced against a case that could not arise.
// A rule with no reachable instance is a rule nobody has tested.
//
// Dressing gets its own view. A terrain column is index-aligned to the chunk's
// layers because `F1` reads consecutive occupied cells in order; dressing has no
// `F1`, so its view is simply "the dressing layers, in order" — and that
// independence is the point. A prop moving must not renumber a terrain slot.
pub fn world_set_dressing(w: VoxelWorld, col: Column) -> ColumnWrite {
  // `R1` still applies — dressing shares the window, so it cannot sit below the
  // floor any more than terrain can. `F1` does NOT: two props may overlap, and a
  // lantern may hang inside the arch it lights.
  for i in 0..len(col.co_cells) {
    c = col.co_cells[i];
    if hex_occupied(c) && c.h_height < w.w_reserve {
      return ColumnWrite { cw_code: CW_RESERVE, cw_layer: i,
                           cw_detail: "dressing at {c.h_height} is below the reserve {w.w_reserve}" };
    }
  }

  cx = world_chunk_of(col.co_q);
  cz = world_chunk_of(col.co_r);
  ix = cell_index(col.co_q, col.co_r);
  ci = find_chunk(w, cx, cz);
  if ci < 0 {
    nb = 0;
    for c2 in col.co_cells { if hex_occupied(c2) { nb = c2.h_height; } }
    w.w_chunks += [VoxelChunk { ck_cx: cx, ck_cz: cz, ck_base: nb, ck_layers: [] }];
    ci = len(w.w_chunks) - 1;
    w.w_index += ChunkAt { ca_key: chunk_key(cx, cz), ca_at: ci };
  }

  // Where the dressing layers are. New ones are APPENDED, so terrain slots keep
  // their indices — `D1`'s "leaves every terrain layer bit-identical" is a
  // statement about the bytes, and renumbering would break it even if every
  // value survived.
  slots: vector<integer> = [];
  for li in 0..len(w.w_chunks[ci].ck_layers) {
    if w.w_chunks[ci].ck_layers[li].ly_kind == KIND_DRESSING { slots += [li]; }
  }
  while len(slots) < len(col.co_cells) {
    w.w_chunks[ci].ck_layers += [Layer { ly_id: fresh_label(w), ly_kind: KIND_DRESSING,
                                         ly_ver: 0, ly_cells: empty_cells() }];
    slots += [len(w.w_chunks[ci].ck_layers) - 1];
  }

  base = w.w_chunks[ci].ck_base;
  changed = false;
  for k in 0..len(col.co_cells) {
    c3 = col.co_cells[k];
    l = slots[k];
    nv = StoredHex { sv_height: (c3.h_height - base) as u16? ?? 0,
                     sv_material: c3.h_material, sv_item: c3.h_item,
                     sv_item_rotation: c3.h_item_rotation,
                     sv_wall_nw: c3.h_wall_nw, sv_wall_ne: c3.h_wall_ne,
                     sv_wall_e: c3.h_wall_e };
    prev = w.w_chunks[ci].ck_layers[l].ly_cells[ix];
    if prev.sv_height != nv.sv_height || prev.sv_material != nv.sv_material
       || prev.sv_item != nv.sv_item || prev.sv_item_rotation != nv.sv_item_rotation {
      if !changed { w.w_tau = w.w_tau + 1; changed = true; }
      w.w_chunks[ci].ck_layers[l].ly_cells[ix] = nv;
      w.w_chunks[ci].ck_layers[l].ly_ver = w.w_tau;
    }
  }
  ok_write()
}

// The dressing at a cell — its own index space, over dressing layers only.
pub fn world_dressing(w: VoxelWorld, q: integer, r: integer) -> Column {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return Column { co_q: q, co_r: r, co_cells: [] }; }
  ch = w.w_chunks[ci];
  ix = cell_index(q, r);
  out: vector<Hex> = [];
  for ly in ch.ck_layers {
    if ly.ly_kind == KIND_DRESSING {
      c = ly.ly_cells[ix];
      out += [hex_of(ch.ck_base, c)];
    }
  }
  Column { co_q: q, co_r: r, co_cells: out }
}

// ── ONE CELL, IN PLACE — the fast path (and its honest fallback) ────────────
//
// ⚠ THIS FILE USED TO SAY A SINGLE-CELL WRITE WAS IMPOSSIBLE: *"deliberately
// WITHOUT a writing twin — a single-cell write cannot check any rule in the
// contract, because every rule is a property of a column."* Measured, that claim
// costs more than it protects. Every one-cell edit went through `world_column` +
// `world_set_column`: build a `Column` (a vector, plus a `Hex` per layer), copy
// every cell into a second vector, write the lot back. One cell cost **1 ms
// interpreted and 0.5 ms native** — only 2x apart, so it was never the
// interpreter. A 91-cell brush stroke is 45 ms of store work and filling 10,000
// cells took 16 seconds, which is the editor getting slower exactly as a map fills.
//
// And three of the four rules ARE local:
//
//   `P2` kind      a property of the LAYER          — one read
//   `R1` reserve   a property of the CELL           — one comparison
//   `F1` epsilon   the occupied layers AT THIS CELL — a walk, no allocation
//   `W1` window    a property of the CHUNK          — genuinely not local
//
// So the window is what decides. A height inside the chunk's current window is
// written in place; a height outside it needs the chunk rebased, which is a
// column-wide operation — and that case FALLS BACK to `world_set_column` rather
// than growing a second implementation of rebasing. Same for a cell whose chunk
// or layer does not exist yet: the slow path creates those, and creating is rare.
//
// The invariant that makes this safe is `HEX_STACK.md`'s own: **writes go in
// place**. Rebuilding a column to change one cell was the departure.
pub fn world_set_cell(w: VoxelWorld, q: integer, r: integer, li: integer,
                      c: Hex) -> ColumnWrite {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  // No chunk, or no such layer yet — the slow path materialises both.
  if ci < 0 || li < 0 || li >= len(w.w_chunks[ci].ck_layers) {
    return set_cell_slow(w, q, r, li, c);
  }
  present = hex_present(c);
  // `P2` — terrain content may not land in a dressing layer.
  if present && w.w_chunks[ci].ck_layers[li].ly_kind != KIND_TERRAIN {
    return ColumnWrite { cw_code: CW_MIX, cw_layer: li,
                         cw_detail: "layer {li} is dressing; terrain cannot be written into it" };
  }
  h = c.h_height as integer ?? 0;
  // `R1` — nothing authored below the reserve.
  if present && h < w.w_reserve {
    return ColumnWrite { cw_code: CW_RESERVE, cw_layer: li,
                         cw_detail: "height {h} is below the reserve {w.w_reserve}" };
  }
  base = w.w_chunks[ci].ck_base;
  // `W1` — outside the chunk's window the chunk must be rebased, which is a
  // column-wide move. Hand it over rather than reimplement it.
  if present && (h - base < 0 || h - base >= WINDOW) {
    return set_cell_slow(w, q, r, li, c);
  }
  // `F1` — epsilon against the nearest OCCUPIED terrain cells below and above, in
  // the index order `check_column` reads. Absent layers are gaps, not constraints.
  ix = cell_index(q, r);
  if hex_occupied(c) {
    for i in 0..li {
      j = li - 1 - i;
      ly = w.w_chunks[ci].ck_layers[j];
      if ly.ly_kind == KIND_TERRAIN && stored_occupied(ly.ly_cells[ix]) {
        gap = h - (base + ly.ly_cells[ix].sv_height);
        if gap < w.w_eps {
          return ColumnWrite { cw_code: CW_FOLD, cw_layer: li,
                               cw_detail: "layer {li} is {gap} above layer {j}, needs {w.w_eps}" };
        }
        break;
      }
    }
    for k in li + 1..len(w.w_chunks[ci].ck_layers) {
      ly2 = w.w_chunks[ci].ck_layers[k];
      if ly2.ly_kind == KIND_TERRAIN && stored_occupied(ly2.ly_cells[ix]) {
        gap2 = (base + ly2.ly_cells[ix].sv_height) - h;
        if gap2 < w.w_eps {
          return ColumnWrite { cw_code: CW_FOLD, cw_layer: k,
                               cw_detail: "layer {k} is {gap2} above layer {li}, needs {w.w_eps}" };
        }
        break;
      }
    }
  }
  // Checked, so write — and bump the clock only if something actually changed,
  // which is what makes `w_tau` a cost and not a call count.
  nv = StoredHex { sv_height: (h - base) as u16? ?? 0,
                   sv_material: c.h_material, sv_item: c.h_item,
                   sv_item_rotation: c.h_item_rotation,
                   sv_wall_nw: c.h_wall_nw, sv_wall_ne: c.h_wall_ne,
                   sv_wall_e: c.h_wall_e };
  prev = w.w_chunks[ci].ck_layers[li].ly_cells[ix];
  if prev.sv_height != nv.sv_height || prev.sv_material != nv.sv_material
     || prev.sv_item != nv.sv_item || prev.sv_item_rotation != nv.sv_item_rotation
     || prev.sv_wall_nw != nv.sv_wall_nw || prev.sv_wall_ne != nv.sv_wall_ne
     || prev.sv_wall_e != nv.sv_wall_e {
    w.w_tau = w.w_tau + 1;
    w.w_chunks[ci].ck_layers[li].ly_cells[ix] = nv;
    w.w_chunks[ci].ck_layers[li].ly_ver = w.w_tau;
  }
  ok_write()
}

// The whole-column write, for the cases the fast path hands over: a chunk or layer
// that does not exist yet, and a height that needs the window moved. One
// implementation of rebasing, and it is the one that already had tests.
fn set_cell_slow(w: VoxelWorld, q: integer, r: integer, li: integer, c: Hex) -> ColumnWrite {
  // ⚠ -1 MEANS "THERE IS NO SUCH LAYER", and it is a WRITE, not a no-op. Losing
  // this branch made every first write to a fresh column compose a column of no
  // cells: accepted, silent, and nothing stored. The store names the layer it
  // creates, which is what an unwritten hex has always relied on.
  if li < 0 {
    return world_set_column(w, Column { co_q: q, co_r: r, co_cells: [c] });
  }
  col = world_column(w, q, r);
  cells: vector<Hex> = [];
  n = len(col.co_cells);
  if li >= n { n = li + 1; }
  for i in 0..n {
    if i == li { cells += [c]; }
    else if i < len(col.co_cells) { cells += [col.co_cells[i]]; }
    else { cells += [Hex {}]; }
  }
  world_set_column(w, Column { co_q: q, co_r: r, co_cells: cells, co_ids: col.co_ids })
}

pub fn world_set_column(w: VoxelWorld, col: Column) -> ColumnWrite {
  world_set_column_as(w, col, 0)
}

// The same write, with a NAME for whatever layer it has to create.
//
// ⚠ `new_id` IS SPENT ON CREATION ONLY, and that is what makes it safe to hand the
// same one to every column of a gesture: the first column of each chunk creates the
// layer and takes the name; every column after that finds it already there and
// creates nothing. So a disc of nineteen columns across two chunks makes exactly two
// layer records bearing one label — which is `I1`, and which no per-chunk allocation
// could ever produce.
//
// `new_id = 0` means "allocate one for me" and is what `world_set_column` passes, so
// every caller that does not care about identity is unchanged.
pub fn world_set_column_as(w: VoxelWorld, col: Column, new_id: integer) -> ColumnWrite {
  n = len(col.co_cells);
  if n > LAYER_CAP {
    return ColumnWrite { cw_code: CW_LAYER_CAP, cw_layer: LAYER_CAP,
                         cw_detail: "{n} layers exceeds the cap of {LAYER_CAP}" };
  }
  // 1 and 2 — every check before any write, so a refusal changes nothing.
  chk = check_column(w, col);
  if chk.cw_code != CW_OK { return chk; }

  cx = world_chunk_of(col.co_q);
  cz = world_chunk_of(col.co_r);
  ix = cell_index(col.co_q, col.co_r);

  // The column's own extent, needed before the chunk exists so a NEW chunk can be
  // based on its content rather than on zero.
  clo = 0; chi = 0; cseen = false;
  for i in 0..n {
    if hex_present(col.co_cells[i]) {
      h = col.co_cells[i].h_height;
      if !cseen { clo = h; chi = h; cseen = true; }
      if h < clo { clo = h; }
      if h > chi { chi = h; }
    }
  }

  ci = find_chunk(w, cx, cz);
  if ci < 0 {
    // ⚠ A fresh chunk is based on its FIRST CONTENT, not on zero. Basing it at
    // zero looks harmless and quietly disables the window: for any world under
    // 65536 the base would then never move, every stored height would equal its
    // absolute height, and `S1` would be unobservable — subtracting the base
    // indistinguishable from subtracting nothing. Found by mutation: dropping the
    // subtraction left every gate green.
    nb = 0;
    if cseen { nb = clo; }
    w.w_chunks += [VoxelChunk { ck_cx: cx, ck_cz: cz, ck_base: nb, ck_layers: [] }];
    ci = len(w.w_chunks) - 1;
    w.w_index += ChunkAt { ca_key: chunk_key(cx, cz), ca_at: ci };
  }

  // 3 — materialise absent layers. THE ONLY PLACE A LAYER IS EVER CREATED, which
  // is what stops unneeded ones existing: a layer exists because a column put
  // something in it.
  //
  // ⚠ WHERE it is created is the whole of `co_ids`. Appending at the end and then
  // writing positionally moves every cell down one index while the LAYER records —
  // and their labels and versions — stay put, so a cellar dug under the ground took
  // the ground's label and nothing downstream could tell them apart. Measured: the
  // drawn ground sank from 10.917 to 5.583.
  //
  // With labels the insert point is known: a position whose INCOMING label is 0 —
  // a cell that came from no layer — is new, and the layers from there on shift
  // down carrying their own labels with their own cells.
  //
  // ⚠ Only where the layer being displaced is TERRAIN. A dressing layer is not a
  // heightfield and a terrain write must never disturb it — the same rule step 5
  // keeps below, and the reason a band merge once deleted one.
  if len(col.co_ids) == n {
    for i in 0..n {
      have = len(w.w_chunks[ci].ck_layers);
      if i < have && col.co_ids[i] == 0
         && w.w_chunks[ci].ck_layers[i].ly_id != 0
         && w.w_chunks[ci].ck_layers[i].ly_kind == KIND_TERRAIN {
        nl: vector<Layer> = [];
        for li0 in 0..i { nl += [w.w_chunks[ci].ck_layers[li0]]; }
        nl += [Layer { ly_id: named_label(w, ci, new_id), ly_kind: KIND_TERRAIN,
                       ly_ver: 0, ly_cells: empty_cells() }];
        for li1 in i..have { nl += [w.w_chunks[ci].ck_layers[li1]]; }
        w.w_chunks[ci].ck_layers = nl;
      }
    }
  }
  // ⚠ AND THIS IS WHERE THE OUTDOORS IS NAMED. A layer is created in exactly one
  // place, so a label is assigned in exactly one place and there is nowhere else
  // to forget it: the first terrain layer a chunk ever gets takes `LABEL_GROUND`;
  // everything after takes a fresh label from `ν`.
  //
  // ⚠ That is an INFERENCE — "the first terrain layer written here is the
  // outdoors" — and it is true of every gesture the editor has, because you author
  // ground before you build on it. A disc spilling into a virgin neighbouring
  // chunk would label that chunk's first floor as its ground. The alternative is
  // not milder: an unlabelled chunk renders FLAT, which is loud and does not
  // repair itself. See `WORLD_MODEL.md` § "Where it is assigned".
  while len(w.w_chunks[ci].ck_layers) < n {
    lbl = LABEL_GROUND;
    for gl in w.w_chunks[ci].ck_layers {
      if gl.ly_id == LABEL_GROUND && gl.ly_kind == KIND_TERRAIN { lbl = 0; }
    }
    // ⚠ THE CALLER'S NAME REACHES THIS PATH TOO, not only the insert. A storey ABOVE
    // appends rather than inserts, and it spans a seam exactly as a cellar does — so
    // fixing only the insert would have left `12:+1` breaking `I1` while `12:-1` no
    // longer did, which is the worst kind of half-fix: the gate for one direction
    // would go green and say nothing about the other.
    //
    // ⚠ AND `LABEL_GROUND` STILL WINS. A chunk's first terrain layer is the outdoors
    // by the rule above, and a name handed in by a gesture must never displace that
    // — a disc spilling into a virgin chunk would otherwise label that chunk's
    // ground with the cellar's id and there would be no outdoors there at all.
    if lbl == 0 { lbl = named_label(w, ci, new_id); }
    w.w_chunks[ci].ck_layers += [Layer { ly_id: lbl, ly_kind: KIND_TERRAIN,
                                         ly_ver: 0, ly_cells: empty_cells() }];
  }

  // 4 — fit the window across the WHOLE chunk once this column is applied: one
  // base serves every column in the tile, so the span is a tile-wide question.
  lo = clo; hi = chi; seen = cseen;
  // ⚠ THE STORED CELLS ARE INSIDE THE WINDOW BY THE FIELD'S TYPE, so only the
  // INCOMING column can move it — and that is what makes the sweep skippable.
  //
  // `StoredHex.sv_height` is a **u16**: every stored cell sits at `base + [0,
  // 65535]` and `WINDOW` is 65536. So no existing cell can be below the base or at
  // or past the far edge, and no existing PAIR can span the window — **whatever
  // path wrote it**. That is stronger than "the write path maintains it": three
  // other functions write `ly_cells` without coming through here
  // (`world_set_cell`, `world_set_dressing`, `world_put_layer`) and none of them
  // can break this, because the type will not hold a value that would.
  //
  // The two decisions below are therefore about the column and nothing else: it
  // needs a rebase when it falls outside the window, and the tile can only span
  // too far when it does. While the column fits, `lo` and `hi` are never read.
  //
  // ⚠ AND WHEN IT DOES NOT FIT, THE SWEEP STILL RUNS AND STILL DECIDES. It is not
  // an approximation of the old answer, it is the old answer computed on the rare
  // path: a column *below* the base with the tile already spanning 65535 must be
  // REFUSED, not rebased, and only the true minimum over the tile can tell those
  // apart. The guard asks about the column; the sweep answers about the tile.
  if seen && (lo < w.w_chunks[ci].ck_base || hi >= w.w_chunks[ci].ck_base + WINDOW) {
    for ly in w.w_chunks[ci].ck_layers {
      if ly.ly_kind == KIND_TERRAIN {
        for j in 0..CHUNK_CELLS {
          // ⚠ NO `if !seen` SEEDING ANY MORE — the guard admits only `seen`, so
          // `lo`/`hi` always start at the column's own span and every present cell
          // is folded into it. The seeding branch was reachable when the sweep ran
          // unconditionally and a column carried no content; it cannot be now, and
          // a dead branch that looks live is how the next reader mis-reads this.
          if j != ix && stored_present(ly.ly_cells[j]) {
            h = w.w_chunks[ci].ck_base + ly.ly_cells[j].sv_height;
            if h < lo { lo = h; }
            if h > hi { hi = h; }
          }
        }
      }
    }
  }
  if seen && hi - lo >= WINDOW {
    return ColumnWrite { cw_code: CW_WINDOW, cw_layer: 0 - 1,
                         cw_detail: "tile spans {hi - lo}, the window holds {WINDOW}" };
  }
  rebased = false;
  if seen && (lo < w.w_chunks[ci].ck_base
              || hi >= w.w_chunks[ci].ck_base + WINDOW) {
    // REBASE. Expensive, correct, and rare: every stored layer of the chunk is
    // re-encoded against the new floor. `W1` guarantees this succeeds whenever
    // any base would, because `lo` is by construction the lowest height present.
    rebased = true;
    old = w.w_chunks[ci].ck_base;
    for ly in w.w_chunks[ci].ck_layers {
      if ly.ly_kind == KIND_TERRAIN {
        for j in 0..CHUNK_CELLS {
          if stored_present(ly.ly_cells[j]) {
            ly.ly_cells[j].sv_height = (old + ly.ly_cells[j].sv_height - lo) as u16? ?? 0;
          }
        }
      }
    }
    w.w_chunks[ci].ck_base = lo;
  }

  // 5 — encode. Subtracting the base is the ONLY subtraction in the design; above
  // this line every height has been absolute.
  base = w.w_chunks[ci].ck_base;
  // `T1` — one tick per write that changes anything, and `T2` — only the layers
  // whose bytes ACTUALLY changed are stamped. Stamping every layer the column
  // touched would invalidate caches over layers that did not move, which is
  // exactly the coupling `T2` exists to forbid: a prop change must not stale a
  // terrain cache.
  changed = false;
  for i in 0..n {
    // ⚠ A TERRAIN WRITE DOES NOT TOUCH A DRESSING LAYER — not even to blank it.
    // `check_column` already refused an OCCUPIED cell aimed at one (`P2`); what
    // reaches here is the absent placeholder a column read produces for a
    // dressing slot, and writing that placeholder would CLEAR the dressing
    // content at this cell. Step 6 would then drop the emptied layer outright.
    // Measured: a band merge over a column with a dressing layer deleted the
    // layer, and the only visible symptom was that it had stopped existing.
    if w.w_chunks[ci].ck_layers[i].ly_kind != KIND_TERRAIN { continue; }
    c = col.co_cells[i];
    nv = StoredHex { sv_height: (c.h_height - base) as u16? ?? 0,
                     sv_material: c.h_material, sv_item: c.h_item,
                     sv_item_rotation: c.h_item_rotation,
                     sv_wall_nw: c.h_wall_nw, sv_wall_ne: c.h_wall_ne,
                     sv_wall_e: c.h_wall_e };
    prev = w.w_chunks[ci].ck_layers[i].ly_cells[ix];
    same = prev.sv_height == nv.sv_height && prev.sv_material == nv.sv_material
        && prev.sv_item == nv.sv_item && prev.sv_item_rotation == nv.sv_item_rotation
        && prev.sv_wall_nw == nv.sv_wall_nw && prev.sv_wall_ne == nv.sv_wall_ne
        && prev.sv_wall_e == nv.sv_wall_e;
    if !same {
      if !changed { w.w_tau = w.w_tau + 1; changed = true; }
      w.w_chunks[ci].ck_layers[i].ly_cells[ix] = nv;
      w.w_chunks[ci].ck_layers[i].ly_ver = w.w_tau;
    }
  }
  // A rebase rewrites every layer's stored bytes, so every layer of the chunk is
  // genuinely new on disk and must be stamped — the encoding changed even where
  // the world did not. This is the one place `T2`'s independence yields to the
  // truth that the bytes moved.
  if rebased {
    if !changed { w.w_tau = w.w_tau + 1; changed = true; }
    for ly in w.w_chunks[ci].ck_layers { ly.ly_ver = w.w_tau; }
  }

  // 6 — drop what emptied, so elision is an invariant maintained on write rather
  // than a compaction pass that does not exist (`E1`).
  live: vector<Layer> = [];
  for ly in w.w_chunks[ci].ck_layers {
    // ⚠ THE CELL THIS WRITE TOUCHED IS ASKED FIRST, AND IT DECIDES THE COMMON
    // CASE IN O(1). A column write changes exactly one index — `ix` — so a layer
    // holding content THERE is live and there is nothing to scan. Only proving
    // ABSENCE needs the sweep, and absence is the rare answer: a layer empties
    // when the last thing in it is cleared.
    //
    // ⚠ A REBASE CANNOT CHANGE THIS ANSWER. It rewrites `sv_height`, and height
    // is not one of the five fields `stored_present` reads — so the presence of
    // every cell is identical before and after, and the check is safe to make
    // after step 5 whatever step 4 did.
    //
    // ⚠ AND THE SWEEP STOPS AT THE FIRST PRESENT CELL. It computes an OR; running
    // it to 1024 after the answer is known is the same waste one loop out. It was
    // measured in 2026-08 (`probe/perf/README.md`: *"short-circuiting step 6:
    // 116 → 98 ms"*) and the finding was written down and never applied — which
    // is why it is worth saying that the two lines below are the whole of it.
    // ⚠ `G5b` — WHAT AN UNWRITTEN CELL OF *THIS* LAYER READS AS, hoisted: it is one
    // value for the whole layer, and computing it inside the sweep would put a
    // `cell_or_ground` on each of 1024 turns to learn a constant.
    blank = cell_or_ground(w, w.w_chunks[ci].ck_base, ly, StoredHex {});
    any = !hex_same(cell_or_ground(w, w.w_chunks[ci].ck_base, ly, ly.ly_cells[ix]),
                    blank);
    if !any {
      for j in 0..CHUNK_CELLS {
        if !hex_same(cell_or_ground(w, w.w_chunks[ci].ck_base, ly, ly.ly_cells[j]),
                     blank) { any = true; break; }
      }
    }
    if any { live += [ly]; }
  }
  w.w_chunks[ci].ck_layers = live;
  // `E1` clause 2 — a chunk whose last layer emptied leaves the directory
  // entirely. Elision is maintained ON WRITE, so the file never carries an empty
  // chunk waiting for a sweep that does not exist.
  if len(live) == 0 {
    keep: vector<VoxelChunk> = [];
    for k in w.w_chunks { if len(k.ck_layers) > 0 { keep += [k]; } }
    w.w_chunks = keep;
    reindex(w);
  }
  ok_write()
}

// ── Change, and what a cache may ask ─────────────────────────────────────────
//
// A cache built at clock `c` over a region is valid iff every layer it read still
// has `ver <= c`. That is an exact comparison, not a heuristic and not a
// timestamp: a clock value is a fact about what HAS happened, where a time is a
// guess about whether it has.

// The newest write anywhere in the tile holding (q, r). 0 when the tile does not
// exist, which is the right answer — nothing has happened there.
pub fn world_chunk_version(w: VoxelWorld, q: integer, r: integer) -> integer {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return 0; }
  hi = 0;
  for ly in w.w_chunks[ci].ck_layers { if ly.ly_ver > hi { hi = ly.ly_ver; } }
  hi
}

// One layer's version, for a cache that depends on a single layer rather than a
// whole tile — which is the point of `T2`.
// The kind of layer `l` of the chunk holding (q, r). A layer that does not exist
// yet is KIND_TERRAIN: `world_set_column` materialises new layers as terrain, so
// that is what the slot WILL be, and a caller reasoning about a future slot must
// get the same answer as one reasoning about a present one.
pub fn world_layer_kind(w: VoxelWorld, q: integer, r: integer, l: integer) -> integer {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return KIND_TERRAIN; }
  if l < 0 || l >= len(w.w_chunks[ci].ck_layers) { return KIND_TERRAIN; }
  w.w_chunks[ci].ck_layers[l].ly_kind
}

pub fn world_layer_version(w: VoxelWorld, q: integer, r: integer, l: integer) -> integer {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return 0; }
  if l < 0 || l >= len(w.w_chunks[ci].ck_layers) { return 0; }
  w.w_chunks[ci].ck_layers[l].ly_ver
}

// ── S2 (plan 16) — A LAYER, AS BYTES AND AS A CHECKSUM ──────────────────────
//
// The client caches voxels and has to prove its copy is the server's. Three calls
// carry that, and they are here rather than in the consumer because the ENCODING is
// the file format's: a checksum both sides invent separately is a checksum that
// agrees about the wrong thing.
//
// ⚠ THE CRC IS THE FILE FORMAT'S OWN, not a hash for the wire. `layer_crc` is what
// `world_save` writes after each layer's cells and what `world_load` refuses on, so
// "the client agrees with the server" and "the client would survive a round trip"
// are one claim rather than two that might drift.
// A chunk's window base, by CHUNK coordinate — the number every stored height in it
// is relative to.
//
// ⚠ IT HAS TO TRAVEL WITH THE LAYER. `sv_height` is meaningless without it (`S1`), so
// a cache that took the cells and defaulted the base to zero would hold a layer whose
// every height is wrong by the base and whose CRC is nonetheless right — the cells
// are what is checksummed, not their absolute heights. That is the failure this
// accessor exists to make impossible rather than to detect.
pub fn world_chunk_base(w: VoxelWorld, cx: integer, cz: integer) -> integer {
  ci = find_chunk(w, cx, cz);
  if ci < 0 { return 0; }
  w.w_chunks[ci].ck_base
}

// How many layers this CHUNK holds, asked by chunk coordinate.
//
// A layer spans a whole chunk, so `len(world_column(…).co_ids)` at any hex of the chunk
// answers the same question — I assumed otherwise and the test above refuted it, which
// is why it is written down. What this adds is the ability to ask WITHOUT a hex, and to
// get **0 for a chunk that does not exist**: the caller distinguishing "empty" from
// "absent" is the whole of `E1`, and building a column just to count is a wasteful way
// to reach it.
pub fn world_chunk_layers(w: VoxelWorld, cx: integer, cz: integer) -> integer {
  ci = find_chunk(w, cx, cz);
  if ci < 0 { return 0; }
  len(w.w_chunks[ci].ck_layers)
}

pub fn world_layer_crc(w: VoxelWorld, q: integer, r: integer, l: integer) -> integer {
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return 0; }
  if l < 0 || l >= len(w.w_chunks[ci].ck_layers) { return 0; }
  layer_crc(w.w_chunks[ci].ck_layers[l])
}

// One layer's cells, flat, in the file format's field order: seven integers a cell,
// `CHUNK_CELLS` of them.
//
// ⚠ HEIGHTS COME OUT RELATIVE TO THE CHUNK BASE — `sv_height`, exactly as stored and
// exactly as saved. Absolute heights would need the base sent beside them and would
// re-window on the far side, which is a second derivation of a number the format
// already agreed on. The base travels with the layer instead.
pub const LAYER_FIELDS = 7;

pub fn world_layer_bytes(w: VoxelWorld, q: integer, r: integer, l: integer) -> vector<integer> {
  out: vector<integer> = [];
  ci = find_chunk(w, world_chunk_of(q), world_chunk_of(r));
  if ci < 0 { return out; }
  if l < 0 || l >= len(w.w_chunks[ci].ck_layers) { return out; }
  for c in w.w_chunks[ci].ck_layers[l].ly_cells {
    out += [c.sv_height as integer ?? 0, c.sv_material as integer ?? 0,
            c.sv_item as integer ?? 0, c.sv_item_rotation as integer ?? 0,
            c.sv_wall_nw as integer ?? 0, c.sv_wall_ne as integer ?? 0,
            c.sv_wall_e as integer ?? 0];
  }
  out
}

// The other direction: a whole layer written at once, for a cache filling itself.
//
// ⚠ NOT `world_set_column` PER CELL. A layer is 1024 cells and a column write checks
// `F1`, `W1` and `R1` over the whole column each time — a thousand of those to place
// one layer, on every chunk the client streams. This is the cache's own path and it
// writes what it was given: the CALLER is copying a store that already passed those
// checks, and re-deriving them here would be checking the server's arithmetic with
// the server's arithmetic.
//
// That is exactly why it returns the CRC rather than `void`. A bulk write with no
// checks needs the caller to be able to say *this is the layer I was sent* — so the
// answer to "did it land" is the same number the format uses, computed after.
// Record that a chunk is KNOWN and EMPTY — `E1` made storable.
//
// ⚠ A RECEIVER CANNOT TELL ABSENCE FROM SILENCE, and that is not a defect it can fix
// at its end. The editor's client held 36 of 48 ground verdicts forever because the
// chunks its mesher needed did not exist on the SERVER either — so nothing was ever
// going to arrive, and "I have not been sent it" and "there is nothing there" are the
// same observation from inside the cache. Only the authority can separate them, and
// this is the shape it says it in: the chunk exists, and holds nothing.
//
// Idempotent, and it never removes layers — a touch that arrives after the real thing
// is a no-op rather than a deletion, because the wire does not promise an order.
pub fn world_touch_chunk(w: VoxelWorld, cx: integer, cz: integer, base: integer) {
  ci = find_chunk(w, cx, cz);
  if ci < 0 {
    w.w_chunks += [VoxelChunk { ck_cx: cx, ck_cz: cz, ck_base: base, ck_layers: [] }];
    w.w_index += ChunkAt { ca_key: chunk_key(cx, cz), ca_at: len(w.w_chunks) - 1 };
  }
}

// Does this world know about that chunk at all — layers or not.
//
// ⚠ NOT "does it hold ground". The difference is the whole point: a chunk known to be
// empty is an ANSWER, and a consumer that treats it as a gap waits forever.
pub fn world_chunk_known(w: VoxelWorld, cx: integer, cz: integer) -> boolean {
  find_chunk(w, cx, cz) >= 0
}

pub fn world_put_layer(w: VoxelWorld, cx: integer, cz: integer, base: integer,
                       id: integer, kind: integer, ver: integer,
                       flat: vector<integer>) -> integer {
  if len(flat) != CHUNK_CELLS * LAYER_FIELDS { return 0; }
  ci = find_chunk(w, cx, cz);
  if ci < 0 {
    w.w_chunks += [VoxelChunk { ck_cx: cx, ck_cz: cz, ck_base: base, ck_layers: [] }];
    ci = len(w.w_chunks) - 1;
    w.w_index += ChunkAt { ca_key: chunk_key(cx, cz), ca_at: ci };
  }
  w.w_chunks[ci].ck_base = base;
  li = 0 - 1;
  // Same shape as the two ground scans, iterated for the same measured reason.
  pli = 0;
  for ply in w.w_chunks[ci].ck_layers {
    if ply.ly_id == id { li = pli; }
    pli = pli + 1;
  }
  if li < 0 {
    w.w_chunks[ci].ck_layers += [Layer { ly_id: id, ly_kind: kind, ly_ver: ver,
                                         ly_cells: empty_cells() }];
    li = len(w.w_chunks[ci].ck_layers) - 1;
  }
  w.w_chunks[ci].ck_layers[li].ly_kind = kind;
  w.w_chunks[ci].ck_layers[li].ly_ver = ver;
  for k in 0..CHUNK_CELLS {
    b = k * LAYER_FIELDS;
    w.w_chunks[ci].ck_layers[li].ly_cells[k] = StoredHex {
      sv_height: (flat[b] ?? 0) as u16? ?? 0,
      sv_material: (flat[b + 1] ?? 0) as u8? ?? 0,
      sv_item: (flat[b + 2] ?? 0) as u8? ?? 0,
      sv_item_rotation: (flat[b + 3] ?? 0) as u8? ?? 0,
      sv_wall_nw: (flat[b + 4] ?? 0) as u8? ?? 0,
      sv_wall_ne: (flat[b + 5] ?? 0) as u8? ?? 0,
      sv_wall_e: (flat[b + 6] ?? 0) as u8? ?? 0,
    };
  }
  layer_crc(w.w_chunks[ci].ck_layers[li])
}

pub fn world_is_stale(w: VoxelWorld, q: integer, r: integer, built_at: integer) -> boolean {
  world_chunk_version(w, q, r) > built_at
}

// ── `M2` — a reader sees a consistent snapshot ───────────────────────────────
//
// A read observes the world as of ONE clock value and never a half-applied write.
// That is what lets derivation run ALONGSIDE editing rather than between edits: a
// mesh builder or an LOD pass takes a snapshot, works off the critical path, and
// `T1` tells it whether its result is still current when it lands.
//
// ⚠ THE CONTRACT NAMES COPY-ON-WRITE AND LOFT CANNOT EXPRESS IT — measured, not
// assumed. Assignment into a struct field DEEP-COPIES:
//
//     h = Holder { ms: live };     live[0].xs[0].v = 99;
//     → live reads 99, h reads 1
//
// So there is no shared representation to write-on-copy from: taking a snapshot
// copies the world whether or not you ask it to. The GUARANTEE `M2` states is
// intact and gated below; the O(1)-snapshot mechanism is simply not available at
// this level, and would need explicit indirection (an arena with handles) rather
// than a cleverer assignment. Recorded so nobody re-derives the same dead end.
//
// The copy is therefore written as the assignment it already is, rather than as a
// hand-rolled loop that duplicates what the language does.
pub struct Snapshot { sn_tau: integer, sn_chunks: vector<VoxelChunk> }

pub fn world_snapshot(w: VoxelWorld) -> Snapshot {
  return Snapshot { sn_tau: w.w_tau, sn_chunks: w.w_chunks };
}

// Reading a snapshot is reading a VoxelWorld whose chunks are the frozen ones — the
// same routine, so a snapshot cannot drift from a live read by having its own.
pub fn snap_world(s: Snapshot) -> VoxelWorld {
  w = VoxelWorld { w_chunks: s.sn_chunks, w_unit: 1.0, w_reserve: 0,
              w_eps: 1, w_theta: 0, w_next_id: 1, w_tau: s.sn_tau };
  reindex(w);
  return w;
}

// ── The file ─────────────────────────────────────────────────────────────────
//
// ONE FILE per world (decided 2026-07-26). Stencils and placeable assets live in
// their own files, because the world mutates constantly — authoring, then game
// mechanics — while they are near-static, and storing them together would drag
// stable bytes through every volatile write.
//
//   [header ] magic, version, chunk_w, u, rho, eps, theta, nu, tau, palette_len
//   [palette] OPAQUE — the consumer's bytes. The library owns its length and
//             position and never interprets it (it cannot: what a material MEANS
//             is the consumer's, and a substrate that knows is not one).
//   [chunks ] count, then per chunk: cx, cz, base, layer count,
//             then per layer: id, kind, cells, CRC32
//   [sections] tag i32, length i32, that many bytes — repeated to END OF FILE
// The format's EXACT sizes. Gates assert against these rather than against
// whatever the writer happens to produce, so a padding regression is a failure
// rather than a new baseline.
pub const SZ_HEADER = 52;                     // 9 i32 + tau (8) + owner + chunk count
pub const SZ_CHUNK  = 16;                     // cx, cz, base, layer count
pub const SZ_CELL   = 8;                      // u16 + 6 * u8 — the voxel, exactly
pub const SZ_SECTION_HEAD = 8;                // tag i32 + length i32
// The DIRECTORY and the PAYLOAD are separate regions, which the contract calls
// structural rather than an optimisation: validating a cache must cost a
// directory read and never an 8 KB one. Every layer's id, kind and version live
// in the directory; only cells and their CRC live in the data region.
pub const SZ_VER       = 8;                   // `τ` and `ver`, as two i32 halves
pub const SZ_LAYER_DIR = 13;                  // id i32 + kind u8 + ver 8
pub const SZ_LAYER     = 8196;                // 1024 * 8 cells + crc i32

// ⚠ THE FILES SAY `WTTH`, AND THIS COMMENT SAID `HXW7` UNTIL 2026-08-03 — every
// `.hxw` in the tree opens `57 54 54 48`. 1213486167 is 0x48545457, and the header
// is written LittleEndian, so the low byte lands first and the four characters
// come out reversed. Nothing is wrong with the file; what was wrong is the one
// line a person reads before dumping the first four bytes to identify a format.
// The value is NOT corrected — every saved world carries it — and it is `WTTH`
// that names the format from here on.
pub const WORLD_MAGIC   = 1213486167;   // 'WTTH', low byte first — see above
pub const WORLD_VERSION = 1;

// ── Sections: the tag, and reaching one ──────────────────────────────────────
//
// A tag is four characters packed LEAST-significant first, so that written
// LittleEndian they land in reading order and `PART` appears as `PART` in a hex
// dump. That is the only reason a four-character tag exists rather than a number,
// and it is also the convention `WORLD_MAGIC` turns out to use — so
// `section_tag("WTTH") == WORLD_MAGIC` is a real cross-check against a value this
// function did not produce, and the test asserts it.
//
// ⚠ THAT CROSS-CHECK IS WHAT FOUND THE COMMENT ABOVE. The first version of this
// packed most-significant first, which is what `'HXW7'` implied, and the check
// disagreed by 262880. Held against itself it would have passed either way.
//
// ⚠ NOT a constant, and the reason changed on 2026-08-03. It used to be that
// `const X = some_fn()` aborted with a non-unwinding panic and no source location;
// loft#744 fixed that, and the advice it now carries is the better argument: **a
// file-scope constant is an inlined expression, re-evaluated at every reference**,
// so a derived tag would re-run this loop at each use. Tags are literals and a
// test holds them equal to this.
pub fn section_tag(name: text) -> integer {
  t = 0;
  sh = 0;
  for ch in name {
    t = t | ((ch as i32? ?? 0) << sh);
    sh = sh + 8;
  }
  t
}

// The index of the first section with this tag, or −1. An index rather than the
// bytes, because a section that is PRESENT AND EMPTY is a real thing — a flag —
// and returning `[]` for both would make it indistinguishable from absence.
pub fn world_section_at(w: VoxelWorld, tag: integer) -> integer {
  for i in 0..len(w.w_sections) {
    if w.w_sections[i].sc_tag == tag { return i; }
  }
  0 - 1
}

// ── THE GROUND DEFAULT — `G4` ────────────────────────────────────────────────
//
// The tag the codec writes it under. A four-character section tag like every other,
// and free — `PART`, `WALL`, `OPEN` and `WTTH` are the ones in use.
pub fn ground_tag() -> integer { section_tag("GRND") }

// What this world's untouched ground is, or an absent cell if it has none.
pub fn world_ground_default(w: VoxelWorld) -> Hex { w.w_ground }

// ⚠ ABSENCE IS `hex_present`, NOT A SEPARATE FLAG. A ground with no material is not
// ground — it is exactly the nothing an unwritten cell already reads as — so the
// predicate the store already uses for *is there anything here* answers this too,
// and there is no second field that can disagree with the first.
pub fn world_has_ground_default(w: VoxelWorld) -> boolean { hex_present(w.w_ground) }

// Set it, or refuse — and the refusal is `R1`, checked HERE.
//
// ⚠ **`R1` IS CHECKED WHERE THE GROUND IS STATED, NOT WHERE A LAYER IS BORN FROM
// IT.** GROUND_DEFAULT.md's failure path 5: a scenario that sets a ground under the
// reserve and is not refused here surfaces the failure in an unrelated chunk much
// later, when some layer inherits it — a wrong answer a long way from its cause.
// `check_column` uses the same comparison for an authored cell, deliberately: a
// defaulted cell is an absolute height like any other.
pub fn world_set_ground(w: VoxelWorld, cell: Hex) -> ColumnWrite {
  if hex_present(cell) && cell.h_height < w.w_reserve {
    return ColumnWrite { cw_code: CW_RESERVE, cw_layer: 0 - 1,
                         cw_detail: "ground height {cell.h_height} is below the "
                                  + "reserve {w.w_reserve}" };
  }
  w.w_ground = cell;
  ok_write()
}

// ⚠ **AND AN UNWRITTEN CELL OF AN EXISTING CHUNK ANSWERS IT TOO — `G5a.1`.**
//
// The design said *synthesise the ground where the CHUNK is absent*, and following
// that literally leaves a seam the invariant forbids: write one cell and the other
// 1023 of its chunk read as **nothing** while the untouched chunk next door reads as
// grass. Measured before it was fixed — default 200/4, one cell written at (0,0):
//
//     written cell             h 300 mat 7
//     untouched, chunk EXISTS  h 0   mat 0     <- a hole in the grass
//     untouched, chunk ABSENT  h 200 mat 4
//
// *A defaulted cell and a written one of the same value are indistinguishable* — so
// two untouched cells cannot differ by whether a NEIGHBOUR was written. At `G6` this
// would have arrived as *the terrain has holes around every building*, with its cause
// four steps away.
//
// ⚠ **AND IT IS THE GROUND LAYER ONLY.** The default is the ground plane; a cellar's
// unwritten cells are genuinely absent, and answering the ground for them would fill
// every storey with earth. `LABEL_GROUND` + `KIND_TERRAIN` is the test, the same pair
// `world_ground_layer` uses.
// ⚠ **A COPY, NEVER THE FIELD ITSELF.** Returning `w.w_ground` directly leaked a
// store per call — `store table exhausted: 65535 stores live at once` from
// `hex_editor/tests/face.loft`, on a reader called once per cell. Every other reader
// here hands back a value CONSTRUCTED by `hex_of`, and `world_cell`'s own comment
// already says why: *the copy is the conversion, not a workaround.* The default is
// the one value that was tempting to pass through, and it is the one that must not be.
fn ground_copy(w: VoxelWorld) -> Hex {
  Hex { h_height: w.w_ground.h_height, h_material: w.w_ground.h_material,
        h_item: w.w_ground.h_item, h_item_rotation: w.w_ground.h_item_rotation,
        h_wall_nw: w.w_ground.h_wall_nw, h_wall_ne: w.w_ground.h_wall_ne,
        h_wall_e: w.w_ground.h_wall_e }
}

// ── `G5b` — WHAT STORAGE MAY DROP ──────────────────────────────────────────
//
// **A cell is elidable iff it reads the same as an UNWRITTEN one.** That is the whole
// rule, and it is `E1` generalised rather than replaced: with no ground default an
// unwritten cell reads as `Hex {}`, no present cell can read as that (absence *is*
// material 0), and the rule collapses to today's *no present cells* — including an
// absent cell carrying a stale height, which `hex_of` already discards on read.
// **Today is the special case, so nothing moves until a scenario sets a ground.**
//
// ⚠ **AND IT IS PER LAYER WITHOUT BRANCHING ON THE LAYER.** `cell_or_ground` already
// knows that an unwritten GROUND cell reads as the default and an unwritten cellar
// cell reads as nothing, so asking it what a blank reads as is the same question in
// both — where a rule testing `LABEL_GROUND` here would be a second home for that.
fn hex_same(a: Hex, b: Hex) -> boolean {
  a.h_height == b.h_height && a.h_material == b.h_material && a.h_item == b.h_item
    && a.h_item_rotation == b.h_item_rotation && a.h_wall_nw == b.h_wall_nw
    && a.h_wall_ne == b.h_wall_ne && a.h_wall_e == b.h_wall_e
}

fn cell_or_ground(w: VoxelWorld, base: integer, ly: Layer, sv: StoredHex) -> Hex {
  if stored_present(sv) { return hex_of(base, sv); }
  if hex_present(w.w_ground) && ly.ly_id == LABEL_GROUND && ly.ly_kind == KIND_TERRAIN {
    return ground_copy(w);
  }
  Hex {}
}

// ── `G5a` — WHAT AN ABSENT CHUNK ANSWERS ────────────────────────────────────
//
// **A world is an infinite plane of its ground default**, so a chunk nobody wrote is
// not nothing — it is one terrain layer, labelled `LABEL_GROUND`, every cell equal to
// the default. The readers below synthesise exactly that, and the invariant's last
// clause is why it is safe: *a defaulted cell and a written one of the same value are
// indistinguishable, because they are the same cell.*
//
// ⚠ **THE SYNTHESISED CHUNK HAS EXACTLY ONE LAYER, AT INDEX 0.** That is not a
// convention picked here — it is what `world_set_column_as` step 3 builds when a
// chunk's first terrain layer is minted, and `lib/hex_voxel/tests/ground_read.loft`
// pins the two against each other cell by cell rather than trusting this sentence.
//
// ⚠ **AND THE BRANCHES BELOW ASK `world_has_ground_default`, NOT A PRIVATE TWIN.**
// This had one for a while — `fn world_has_ground_default(w)`, the same `hex_present(w.w_ground)`
// under a second name — and it cost a cross-mode failure: a test file with its own
// `defaulted` helper compiled on the interpreter and died under `--native` with
// `error[E0425]: cannot find function n_defaulted in this scope`. One home for the
// predicate removes both the duplication and the collision.
//
// ⚠ **AND IT IS `hex_present`, NOT `hex_occupied`, THAT DECIDES WHETHER THERE IS A
// DEFAULT AT ALL** — a ground of nothing is exactly today, and `world_ground_default`
// answers `Hex {}` for it, so every branch below falls through to the old answer.

// Replaces the FIRST section with this tag, or appends. Duplicates of a tag are
// not refused — the format carries whatever it was handed, and refusing here
// would mean this library had an opinion about content it cannot read.
pub fn world_set_section(w: VoxelWorld, tag: integer, bytes: vector<u8>) {
  at = world_section_at(w, tag);
  if at < 0 {
    w.w_sections += [Section { sc_tag: tag, sc_bytes: bytes }];
  } else {
    w.w_sections[at].sc_bytes = bytes;
  }
}

// The bytes of a section, or an empty vector when there is none. ⚠ Empty is also
// what a PRESENT AND EMPTY section reads as — a flag is a real payload — which is
// why presence is asked with `world_section_at` and never with this.
pub fn world_section_bytes(w: VoxelWorld, tag: integer) -> vector<u8> {
  at = world_section_at(w, tag);
  if at < 0 { return []; }
  // ⚠ AN EXPLICIT `return`, AND IT IS NOT A STYLE CHOICE. Written as an implicit
  // tail, `w.w_sections[at].sc_bytes` — a vector FIELD of a vector ELEMENT —
  // comes back EMPTY on `--native` and correct on the interpreter, with no
  // diagnostic on either. Measured side by side in one program: tail 0 / return 4
  // / a local 4 / an element copy 4. loft#754.
  return w.w_sections[at].sc_bytes;
}

pub fn world_drop_section(w: VoxelWorld, tag: integer) -> boolean {
  at = world_section_at(w, tag);
  if at < 0 { return false; }
  keep: vector<Section> = [];
  for i in 0..len(w.w_sections) {
    if i != at { keep += [w.w_sections[i]]; }
  }
  w.w_sections = keep;
  true
}

pub const WL_OK        = 0;
pub const WL_MISSING   = 1;   // no such file
pub const WL_MAGIC     = 2;   // not one of ours, or a version we do not know
pub const WL_CONSTANTS = 3;   // `C1` — the file's own constants fail eps > 2*theta
pub const WL_CRC       = 4;   // a chunk's bytes are damaged
pub const WL_SECTION   = 5;   // the trailing block is not a run of whole sections

pub struct WorldLoad {
  wl_code:    integer,
  wl_world:   VoxelWorld,
  wl_palette: vector<integer>,
  wl_detail:  text,
}

// CRC32, table-free. Small enough that pulling in a dependency for it would cost
// more than it saves, and the polynomial is the standard reversed 0xEDB88320.
fn crc32_of(acc: integer, v: integer) -> integer {
  c = acc ^ (v & 255);
  for _ in 0..8 {
    if c & 1 == 1 { c = (c >> 1) ^ 3988292384; } else { c = c >> 1; }
  }
  c
}

fn crc_cell(acc: integer, s: StoredHex) -> integer {
  a = crc32_of(acc, s.sv_height & 255);
  a = crc32_of(a, (s.sv_height >> 8) & 255);
  a = crc32_of(a, s.sv_material);
  a = crc32_of(a, s.sv_item);
  a = crc32_of(a, s.sv_item_rotation);
  a = crc32_of(a, s.sv_wall_nw);
  a = crc32_of(a, s.sv_wall_ne);
  crc32_of(a, s.sv_wall_e)
}

// ⚠ CRC32 is UNSIGNED 32-bit and the file stores i32, so a checksum above
// 2^31 comes back NEGATIVE. Comparing the raw values then fails on a perfectly
// intact file — which it did, on the first run of the round-trip gate. Both sides
// are therefore masked to exactly 32 bits before comparison, and the mask is the
// rule rather than a repair: a checksum is a bit pattern, and comparing it as a
// signed quantity is a category error that happens to work half the time.
const U32_MASK = 4294967295;

fn layer_crc(ly: Layer) -> integer {
  acc = U32_MASK;
  for c in ly.ly_cells { acc = crc_cell(acc, c); }
  (acc ^ U32_MASK) & U32_MASK
}

pub const WS_OK         = 0;
pub const WS_PALETTE    = 1;   // a palette entry is not a byte
pub const WS_CONCURRENT = 2;   // `X2` — someone else is writing this world
pub const WS_IO         = 3;   // the bytes did not reach the disk — see below

// ⚠ `WS_IO` EXISTS BECAUSE A SAVE USED TO REPORT SUCCESS OVER A FILE IT NEVER
// CREATED. Measured 2026-08-04 while building plan 17 `A7.3e`: `f = file(path)`
// on a path whose DIRECTORY is missing hands back a usable handle, every `f += …`
// prints `file open error … (os error 2)` on stderr, and this function returned
// `WS_OK`. The editor then told an author *"part 'newfam/thing' saved — 1 chunks,
// 2 sections"*, renamed its subject line to the new part and re-anchored the edit
// clock — over nothing. Silent loss, from the one gesture that exists to prevent
// it.
//
// ⚠ AND THE CHECK IS THE EXACT LENGTH, NOT `exists`. A missing directory is only
// the cheapest way to lose the bytes; a full disk or a permission that changes
// mid-write truncates instead, and an existence test reads that as a good save.
// The format's length is a closed form — `SZ_*` are already public *"so gates
// assert against these rather than against whatever the writer happens to
// produce"* — so the writer can be held to the same numbers a reader is.
pub fn world_file_size(w: VoxelWorld, palette: vector<integer>) -> integer {
  n = SZ_HEADER + len(palette);
  for ch in w.w_chunks {
    n = n + SZ_CHUNK + len(ch.ck_layers) * (SZ_LAYER_DIR + SZ_LAYER);
  }
  n + sections_size(w.w_sections)
}

// `X2` — MANY AUTHORS ARE NORMAL; A SECOND WRITER TO ONE STORE IS A BUG.
//
// Those are different claims. Players and editors produce many edit streams and
// they merge into one serialised writer (`M1`); what this refuses is two
// PROCESSES writing one file, which is not a use case and, undetected, corrupts
// rather than errors.
//
// The marker is whatever the caller uses to mean "me" — a pid, a session id. A
// save over a world last written by a different owner is refused, and passing
// `OWNER_ANY` opts out for a single-writer tool that does not care.
pub const OWNER_ANY = 0;

fn file_owner(path: text) -> integer {
  f = file(path);
  if f.format == Format.NotExists { return OWNER_ANY; }
  f#format = LittleEndian;
  if f#read as i32 != WORLD_MAGIC { return OWNER_ANY; }
  skipv = f#read as i32; skipw = f#read as i32; skipu = f#read as i32;
  skipr = f#read as i32; skipe = f#read as i32; skipt = f#read as i32;
  skipn = f#read as i32; skiph = f#read as i32; skipl = f#read as i32;
  f#read as i32
}

// ── THE FORMAT IS BYTES, AND A FILE IS ONE DESTINATION — plan 22 `W1` ────────
//
// `world_save` and `world_load` used to be the only encoder and decoder in the
// tree, and both wrote field by field straight into a `File` — so the format was
// reachable ONLY through a filesystem. A browser page has none
// ([loft#851](https://github.com/loft-lang/loft/issues/851)), and a world kept in
// web storage is bytes rather than a path.
//
// ⚠ **THE WRAPPER DIRECTION IS THE INVARIANT, AND IT IS THE WHOLE STEP.**
// `world_save` is `world_to_bytes` plus one append; the bytes are **not** derived
// by writing a file and reading it back. Done the other way there would be two
// encoders, and a page and a server could disagree about what a world IS while
// every test passed against one of them.
//
// ⚠ **`Bytes` AND `ByteReader` ARE DELIBERATELY PRIVATE.** A public name is global
// across a consumer's whole dependency graph, and `Bytes` is the most collidable
// name this package could possibly publish — this tree has paid for `Surface`,
// `Fit` and `Chunk` already. The public surface added here is exactly two
// functions, both already spelled `world_*`.
struct Bytes { const b_data: vector<u8> }

struct ByteReader {
  const br_data: vector<u8>,
  br_pos:  integer,
  // ⚠ A SHORT BUFFER MUST NOT READ ZEROES AND CALL THEM DATA. Every primitive
  // below sets this and answers 0, and the decoder asks ONCE at the end — the
  // alternative is a null check at some forty thousand call sites, which is how a
  // reader stops being readable and starts being trusted instead.
  br_short: boolean,
}

// ⚠ THE WIDTHS ARE EXPLICIT AND LITTLE-ENDIAN BY HAND, matching `f#format =
// LittleEndian` byte for byte. They are not a re-derivation of the format: the
// format is what `world_save_as` below writes, and these are how it writes it.
fn bw_u8(b: Bytes, v: integer) { b.b_data += [(v & 255) as u8? ?? 0]; }
fn bw_u16(b: Bytes, v: integer) { bw_u8(b, v); bw_u8(b, v >> 8); }
fn bw_i32(b: Bytes, v: integer) {
  bw_u8(b, v); bw_u8(b, v >> 8); bw_u8(b, v >> 16); bw_u8(b, v >> 24);
}

fn br_u8(r: ByteReader) -> integer {
  if r.br_pos >= len(r.br_data) { r.br_short = true; return 0; }
  bru_v = r.br_data[r.br_pos] as integer? ?? 0;
  r.br_pos = r.br_pos + 1;
  bru_v
}
fn br_u16(r: ByteReader) -> integer {
  brh_lo = br_u8(r); brh_hi = br_u8(r);
  brh_lo | (brh_hi << 8)
}
// ⚠ SIGN-EXTENDED, because `f#read as i32` is. `w_tau`'s own reader already says
// so — it masks the LOW half with `& 4294967295` and does NOT mask the high one,
// which is only correct if the high half arrived signed. A reader that answered
// unsigned here would round-trip every positive world and quietly corrupt any
// negative chunk coordinate, which is most worlds one hex west of the origin.
fn br_i32(r: ByteReader) -> integer {
  bri_0 = br_u8(r); bri_1 = br_u8(r); bri_2 = br_u8(r); bri_3 = br_u8(r);
  bri_v = bri_0 | (bri_1 << 8) | (bri_2 << 16) | (bri_3 << 24);
  if bri_v >= 2147483648 { bri_v = bri_v - 4294967296; }
  bri_v
}

// Returns a code because a save that cannot represent what it was handed must say
// so. The palette is the CONSUMER's bytes and the library never interprets them —
// but it does have to fit them in a byte, and silently masking a 300 would hand
// back a different palette than the one given, which is the `ML_LABEL_TOO_WIDE`
// lesson at a different seam.
pub fn world_save(w: VoxelWorld, path: text, palette: vector<integer>) -> integer {
  return world_save_as(w, path, palette, OWNER_ANY);
}

// ── WHAT THE EDIT CLOCK CANNOT SEE — plan 17 `A7.3f` ─────────────────────────
//
// ⚠ `w_tau` DOES NOT MOVE FOR A SECTION WRITE, and that was measured rather than
// assumed: loading a part reads `tau 20`, writing an `INST` section leaves it at
// **20**, writing a `PART` section leaves it at **20**, and one cell write takes it
// to 21. The clock counts writes to the STORE's cells, which is what it was built
// for and is why it is an exact cost instrument — but it means *has anything
// changed* is only half answered by it.
//
// ⚠ AND THE HALF IT MISSES IS THE HALF AN AUTHOR LOSES. A consumer that reports
// *"N edits discarded"* from the clock alone tells an author who added an instance
// that **nothing** is being thrown away, and then throws it away. That is the exact
// failure the message exists to prevent, so the other half needs an instrument too.
//
// A key over the section block: every tag, its length, and a checksum of its
// bytes. Equal keys mean the sections are the same; a differing key means they are
// not. ⚠ It is a CHECKSUM and not the bytes, so it is a key and not an identity —
// two different blocks could collide. That is the right trade for *did this
// change*, and the wrong one for *are these the same document*; use the bytes for
// the second question.
pub fn world_sections_key(w: VoxelWorld) -> text {
  key = "";
  for s in w.w_sections {
    sum = 0;
    for b in s.sc_bytes { sum = (sum * 31 + (b as integer? ?? 0)) & U32_MASK; }
    key = key + "{s.sc_tag}:{len(s.sc_bytes)}:{sum};";
  }
  key
}

// The bytes a section block occupies on disk. The incremental writer needs it to
// know where the file ends after it has rewritten the block; the full writer does
// not, because it deletes the file first and whatever it writes IS the length.
fn sections_size(secs: vector<Section>) -> integer {
  n = 0;
  for s in secs { n = n + SZ_SECTION_HEAD + len(s.sc_bytes); }
  n
}

fn write_sections(f: File, secs: vector<Section>) {
  for s in secs {
    f += (s.sc_tag as i32);
    f += (len(s.sc_bytes) as i32);
    // ⚠ `as u8` EVEN THOUGH THE ELEMENT ALREADY IS ONE. A `for` binding over a
    // `vector<u8>` widens to `integer`, and `f += <integer>` writes EIGHT BYTES —
    // so the payload went out 8x its declared length and the reader took the next
    // section's tag from inside it. loft warns about exactly this now; it is the
    // third seam this tree has met the same trap at (`write_bytes` was the first).
    for b in s.sc_bytes { f += (b as u8); }
  }
}

// The whole world, encoded — the same bytes `world_save_as` puts on disk, in the
// same order, and nothing else. `owner` is part of the format rather than a file
// concern, so it is a parameter here; it defaults to `OWNER_ANY`, which is what a
// page holding one world in web storage wants.
//
// ⚠ THIS IS THE ENCODER AND `world_save_as` IS A DESTINATION. While `W1` was being
// built the two ran side by side and a test compared them byte for byte — that is
// the only way to move a format without a period where two encoders both exist and
// neither is known to be the authority.
pub fn world_to_bytes(w: VoxelWorld, palette: vector<integer>,
                      owner: integer = 0) -> vector<u8> {
  wtb = Bytes { b_data: [] };
  bw_i32(wtb, WORLD_MAGIC);
  bw_i32(wtb, WORLD_VERSION);
  bw_i32(wtb, CHUNK_W);
  bw_i32(wtb, (w.w_unit * 1000000.0) as integer);   // `u` as micro-units, exactly
  bw_i32(wtb, w.w_reserve);
  bw_i32(wtb, w.w_eps);
  bw_i32(wtb, w.w_theta);
  bw_i32(wtb, w.w_next_id);
  bw_i32(wtb, w.w_tau >> 32);
  bw_i32(wtb, w.w_tau & 4294967295);
  bw_i32(wtb, owner);
  bw_i32(wtb, len(palette));
  for wtb_p in palette { bw_u8(wtb, wtb_p); }
  bw_i32(wtb, len(w.w_chunks));
  // ── the directory: everything a cache needs, and no voxels
  for wtb_ch in w.w_chunks {
    bw_i32(wtb, wtb_ch.ck_cx);
    bw_i32(wtb, wtb_ch.ck_cz);
    bw_i32(wtb, wtb_ch.ck_base);
    bw_i32(wtb, len(wtb_ch.ck_layers));
    for wtb_ly in wtb_ch.ck_layers {
      bw_i32(wtb, wtb_ly.ly_id);
      bw_u8(wtb, wtb_ly.ly_kind);
      bw_i32(wtb, wtb_ly.ly_ver >> 32);
      bw_i32(wtb, wtb_ly.ly_ver & 4294967295);
    }
  }
  // ── the data, at the voxel's REAL widths — see `world_save_as`
  for wtb_c2 in w.w_chunks {
    for wtb_l2 in wtb_c2.ck_layers {
      for wtb_cell in wtb_l2.ly_cells {
        bw_u16(wtb, wtb_cell.sv_height);
        bw_u8(wtb, wtb_cell.sv_material);
        bw_u8(wtb, wtb_cell.sv_item);
        bw_u8(wtb, wtb_cell.sv_item_rotation);
        bw_u8(wtb, wtb_cell.sv_wall_nw);
        bw_u8(wtb, wtb_cell.sv_wall_ne);
        bw_u8(wtb, wtb_cell.sv_wall_e);
      }
      bw_i32(wtb, layer_crc(wtb_l2));
    }
  }
  // ── the sections, LAST — the forward-compatibility ordering `world_save_as`
  // argues for, and the reason a pre-section reader stops at the final CRC.
  for wtb_s in w.w_sections {
    bw_i32(wtb, wtb_s.sc_tag);
    bw_i32(wtb, len(wtb_s.sc_bytes));
    for wtb_b in wtb_s.sc_bytes { bw_u8(wtb, wtb_b); }
  }
  // ⚠ THE GROUND DEFAULT, AND ONLY IF THERE IS ONE — `G4`. A world that has not set
  // one writes NOTHING here, so its bytes are what they were before this existed:
  // that is the whole safety property, and `make parts` byte-identical is its check.
  // Eight bytes, the cell's own fields in the layer cell's order, height ABSOLUTE
  // because a default belongs to no chunk and so has no base to be relative to.
  if hex_present(w.w_ground) {
    bw_i32(wtb, ground_tag());
    bw_i32(wtb, 8);
    bw_u16(wtb, w.w_ground.h_height);
    bw_u8(wtb, w.w_ground.h_material);
    bw_u8(wtb, w.w_ground.h_item);
    bw_u8(wtb, w.w_ground.h_item_rotation);
    bw_u8(wtb, w.w_ground.h_wall_nw);
    bw_u8(wtb, w.w_ground.h_wall_ne);
    bw_u8(wtb, w.w_ground.h_wall_e);
  }
  wtb.b_data
}

pub fn world_save_as(w: VoxelWorld, path: text, palette: vector<integer>,
                     owner: integer) -> integer {
  for b in palette {
    if b < 0 || b > 255 { return WS_PALETTE; }
  }
  if owner != OWNER_ANY {
    held = file_owner(path);
    if held != OWNER_ANY && held != owner { return WS_CONCURRENT; }
  }
  // ⚠ A save REPLACES; it does not append. `f += …` on an existing file appends,
  // so without this an ordinary second save produced a file containing two worlds
  // back to back — the first one read back fine and the rest was silently
  // unreachable. Saving repeatedly over one path is the normal case, not an edge.
  if exists(path) { delete(path); }
  // ⚠ ONE ENCODER. This function used to write the whole format field by field,
  // and `world_to_bytes` was built beside it and proved byte-identical
  // (`tests/bytes.loft`) before this call replaced ~50 lines of writes. The file
  // is a destination; the bytes are the format.
  //
  // ⚠ `f += <vector<u8>>` WRITES ONE BYTE PER ELEMENT, which is the whole reason
  // this is a single append rather than a loop. A `for` binding over the same
  // vector widens each element to `integer` and writes EIGHT — the trap
  // `write_sections` documents below, and the one that once sent every section out
  // at 8× its declared length.
  f = file(path);
  f#format = LittleEndian;
  f += world_to_bytes(w, palette, owner);
  // ⚠ AND THEN ASK THE DISK, because nothing above can fail out loud. See
  // `WS_IO`: a write into a directory that is not there costs a line on stderr
  // and returns here as though it had worked.
  if file(path).size != world_file_size(w, palette) { return WS_IO; }
  return WS_OK;
}


// ── Versions WITHOUT the payload ─────────────────────────────────────────────
//
// The contract calls this structural rather than an optimisation: validating a
// cache must cost a directory lookup and not an 8 KB read, or the check becomes
// dearer than the rebuild it was meant to avoid.
//
// So this walks the layer HEADERS and seeks past the cells — it never reads a
// voxel. The gate proves that by scanning a file whose cells are deliberately
// corrupt: the scan succeeds where a full load refuses on CRC, which is only
// possible if the payload was never touched.
pub struct VersionScan { vs_code: integer, vs_tau: integer, vs_max: integer, vs_layers: integer }

pub fn world_scan_versions(path: text) -> VersionScan {
  f = file(path);
  if f.format == Format.NotExists { return VersionScan { vs_code: WL_MISSING }; }
  f#format = LittleEndian;
  if f#read as i32 != WORLD_MAGIC || f#read as i32 != WORLD_VERSION {
    return VersionScan { vs_code: WL_MAGIC };
  }
  if (f#read as i32) != CHUNK_W { return VersionScan { vs_code: WL_MAGIC }; }
  skip4 = f#read as i32;                                   // u
  skip5 = f#read as i32;                                   // rho
  eps = f#read as i32;
  th  = f#read as i32;
  skip8 = f#read as i32;                                   // nu
  thi = f#read as i32;
  tlo = f#read as i32;
  tau = (thi << 32) | (tlo & 4294967295);
  ownr = f#read as i32;
  if eps <= 2 * th { return VersionScan { vs_code: WL_CONSTANTS }; }
  pn = f#read as i32;
  for _sp in 0..pn { skipb = f#read as u8; }
  nc = f#read as i32;
  hi = 0;
  cnt = 0;
  // The directory comes FIRST and is contiguous, so the scan simply stops when it
  // ends — it never reaches a voxel. No seek is needed. ⚠ The rest of this line
  // used to say `seek` was documented but absent (LOFT_HANDOFF H11); it was fixed
  // on 2026-07-27 and both writers below use it, so the layout is what makes the
  // scan cheap here — not a missing primitive.
  for _sc in 0..nc {
    skipx = f#read as i32; skipz = f#read as i32; skipb2 = f#read as i32;
    nl = f#read as i32;
    for _sl in 0..nl {
      skipid = f#read as i32; skipk = f#read as u8;
      vhi = f#read as i32; vlo = f#read as i32;
      v = (vhi << 32) | (vlo & 4294967295);
      if v > hi { hi = v; }
      cnt = cnt + 1;
    }
  }
  VersionScan { vs_code: WL_OK, vs_tau: tau, vs_max: hi, vs_layers: cnt }
}

// ── `X3`-`X5` — a store that survives a long life ────────────────────────────
//
// A full rewrite satisfies `X3`, `X4` and `X5` trivially — nothing fragments,
// nothing relocates, and every save is a compaction — but it costs O(world) to
// change one chunk, which is the opposite of what a huge world needs. The point
// of slots is that a save costs what CHANGED.
//
// This writes incrementally when it can: the header and directory are small and
// always rewritten, and a layer's 8 KB of cells is rewritten only if its `ver`
// says it moved since the file was written. Everything else is left where it lies,
// which is `X3`'s reclamation in its simplest honest form — the slot a layer
// already owns is the slot it keeps.
//
// ⚠ It falls back to a full write whenever the SHAPE changes — a chunk added or
// dropped, or a layer count moved — because then offsets shift and every slot
// after the change would have to move. That is `X5`'s compaction, and doing it as
// "rewrite the file" rather than as a relocation pass is why `X4` never arises
// here: nothing is ever moved while keeping its identity, so there is no
// opportunity to stamp the clock for a move that changed nothing.
fn same_shape(w: VoxelWorld, path: text) -> boolean {
  sc = world_scan_versions(path);
  if sc.vs_code != WL_OK { return false; }
  n = 0;
  for ch in w.w_chunks { n = n + len(ch.ck_layers); }
  sc.vs_layers == n && sc.vs_tau <= w.w_tau
}

// ⚠ Returns HOW MANY payloads it wrote, not just whether it worked. Comparing the
// file before and after cannot tell "skipped it" from "rewrote the same bytes" —
// a mutation that rewrote every layer passed a byte-comparison gate — so the count
// is what makes the saving observable rather than merely plausible.
pub struct SaveStat { ss_code: integer, ss_layers: integer }

pub fn world_save_incremental(w: VoxelWorld, path: text, palette: vector<integer>,
                              owner: integer) -> SaveStat {
  if !same_shape(w, path) {
    n = 0;
    for ch in w.w_chunks { n = n + len(ch.ck_layers); }
    return SaveStat { ss_code: world_save_as(w, path, palette, owner), ss_layers: n };
  }
  if owner != OWNER_ANY {
    held = file_owner(path);
    if held != OWNER_ANY && held != owner {
      return SaveStat { ss_code: WS_CONCURRENT, ss_layers: 0 };
    }
  }
  for b in palette {
    if b < 0 || b > 255 { return SaveStat { ss_code: WS_PALETTE, ss_layers: 0 }; }
  }

  was = world_scan_versions(path).vs_tau;
  f = file(path);
  f#format = LittleEndian;
  // ⚠ Seek to 0 before writing. `f += …` APPENDS on an existing file — the same
  // trap that made an ordinary second `world_save` produce a file holding two
  // worlds — so an in-place update has to position itself explicitly.
  seek(f, 0);

  // header + directory, always — they are small and every version moved
  f += (WORLD_MAGIC as i32); f += (WORLD_VERSION as i32); f += (CHUNK_W as i32);
  f += ((w.w_unit * 1000000.0) as i32); f += (w.w_reserve as i32);
  f += (w.w_eps as i32); f += (w.w_theta as i32); f += (w.w_next_id as i32);
  f += ((w.w_tau >> 32) as i32); f += ((w.w_tau & 4294967295) as i32);
  f += (owner as i32); f += (len(palette) as i32);
  for b in palette { f += (b as u8? ?? 0); }
  f += (len(w.w_chunks) as i32);
  for ch in w.w_chunks {
    f += (ch.ck_cx as i32); f += (ch.ck_cz as i32);
    f += (ch.ck_base as i32); f += (len(ch.ck_layers) as i32);
    for ly in ch.ck_layers {
      f += (ly.ly_id as i32); f += (ly.ly_kind as u8? ?? 0);
      f += ((ly.ly_ver >> 32) as i32); f += ((ly.ly_ver & 4294967295) as i32);
    }
  }

  // the payload: seek past every layer that has not moved
  dir = 0;
  for ch in w.w_chunks { dir = dir + SZ_CHUNK + len(ch.ck_layers) * SZ_LAYER_DIR; }
  at = SZ_HEADER + len(palette) + dir;
  wrote = 0;
  for ch in w.w_chunks {
    for ly in ch.ck_layers {
      if ly.ly_ver > was {
        wrote = wrote + 1;
        seek(f, at);
        for c in ly.ly_cells {
          f += (c.sv_height as u16); f += (c.sv_material as u8);
          f += (c.sv_item as u8); f += (c.sv_item_rotation as u8);
          f += (c.sv_wall_nw as u8); f += (c.sv_wall_ne as u8); f += (c.sv_wall_e as u8);
        }
        f += (layer_crc(ly) as i32);
      }
      at = at + SZ_LAYER;
    }
  }
  // ⚠ THE SECTION BLOCK IS REWRITTEN WHOLE, EVERY TIME, and the file is then cut
  // to exactly where it ends. A section's length is not fixed by the SHAPE that
  // `same_shape` compares, so an in-place update that skipped this leaves a
  // trailing block belonging to an older world — bytes that load cleanly and say
  // something untrue, which is this model's worst class. It is cheap to be right
  // here: the block is metadata, not the 8 KB payload the incremental path exists
  // to skip.
  seek(f, at);
  write_sections(f, w.w_sections);
  f#size = at + sections_size(w.w_sections);
  // The same question the full writer asks, for the same reason. This path can
  // only be reached over a file that already existed and kept its shape, so a
  // missing directory cannot land here — a permission or a full disk can.
  if file(path).size != world_file_size(w, palette) {
    return SaveStat { ss_code: WS_IO, ss_layers: wrote };
  }
  SaveStat { ss_code: WS_OK, ss_layers: wrote }
}

// A whole world from bytes — the decoder, and the only one. `world_load` reads a
// file into a buffer and calls this; nothing decodes the format twice.
//
// ⚠ EVERY `f#read as X` IN THE OLD READER BECAME `br_X(r)` AND NOTHING ELSE MOVED,
// deliberately. The comments below are the original's and are load-bearing — the
// counter-name hazard, the explicit sequencing, the migration's position after the
// CRC, and end-of-buffer as the section terminator. A decoder rewritten rather than
// translated would have re-earned every one of them.
pub fn world_from_bytes(b: vector<u8>) -> WorldLoad {
  empty = VoxelWorld { w_unit: 1.0 };
  r = ByteReader { br_data: b, br_pos: 0, br_short: false };
  if br_i32(r) != WORLD_MAGIC || br_i32(r) != WORLD_VERSION {
    return WorldLoad { wl_code: WL_MAGIC, wl_world: empty, wl_palette: [], wl_detail: "not this format" };
  }
  cw = br_i32(r);
  if cw != CHUNK_W {
    return WorldLoad { wl_code: WL_MAGIC, wl_world: empty, wl_palette: [],
                       wl_detail: "chunk width {cw}, this build is {CHUNK_W}" };
  }
  unit = br_i32(r) as float / 1000000.0 ?? 1.0;
  res = br_i32(r);
  eps = br_i32(r);
  th  = br_i32(r);
  nid = br_i32(r);
  thi = br_i32(r);
  tlo = br_i32(r);
  tau = (thi << 32) | (tlo & 4294967295);
  ownr = br_i32(r);
  if eps <= 2 * th {
    return WorldLoad { wl_code: WL_CONSTANTS, wl_world: empty, wl_palette: [],
                       wl_detail: "eps {eps} <= 2*theta {th}" };
  }
  pal: vector<integer> = [];
  pn = br_i32(r);
  // ⚠ A COUNT OUT OF A BUFFER IS UNTRUSTED INPUT. The file reader was bounded by
  // the file's own end; a caller-supplied buffer is bounded by nothing, and a
  // corrupt `pn` would otherwise spin allocating a palette of two billion entries.
  if pn < 0 || pn > len(b) {
    return WorldLoad { wl_code: WL_MAGIC, wl_world: empty, wl_palette: [],
                       wl_detail: "palette claims {pn} entries in {len(b)} bytes" };
  }
  for _pi in 0..pn { pal += [br_u8(r)]; }

  nid2 = nid;
  if nid2 < LABEL_FIRST { nid2 = LABEL_FIRST; }
  w = VoxelWorld { w_chunks: [], w_unit: unit, w_reserve: res, w_eps: eps,
              w_theta: th, w_next_id: nid2, w_tau: tau };
  nc = br_i32(r);
  if nc < 0 || nc > len(b) {
    return WorldLoad { wl_code: WL_MAGIC, wl_world: empty, wl_palette: [],
                       wl_detail: "directory claims {nc} chunks in {len(b)} bytes" };
  }
  // ── the directory, read whole before any payload
  dcx: vector<integer> = []; dcz: vector<integer> = []; dcb: vector<integer> = [];
  dnl: vector<integer> = [];
  lid_all: vector<integer> = []; lk_all: vector<integer> = []; lv_all: vector<integer> = [];
  for _ci in 0..nc {
    dcx += [br_i32(r)]; dcz += [br_i32(r)];
    dcb += [br_i32(r)]; dnl += [br_i32(r)];
    for _li in 0..dnl[len(dnl) - 1] {
      lid_all += [br_i32(r)];
      lk_all += [br_u8(r)];
      vhi = br_i32(r); vlo = br_i32(r);
      lv_all += [(vhi << 32) | (vlo & 4294967295)];
    }
  }
  // ── the data
  li_at = 0;
  for _c2 in 0..nc {
    cx = dcx[_c2]; cz = dcz[_c2]; cb = dcb[_c2]; nl = dnl[_c2];
    lays: vector<Layer> = [];
    for _l2 in 0..nl {
      lid = lid_all[li_at]; lk = lk_all[li_at]; lver = lv_all[li_at];
      li_at = li_at + 1;
      // ⚠ Nested loops must not share a counter name, and every field is read into
      // a LOCAL before the record is built — a struct literal's initialisers are
      // not guaranteed to evaluate in written order, and `br_*` has a side effect.
      // Both hazards are the original reader's, found by a round trip that lost a
      // layer; the translation keeps them answered the same way.
      cells: vector<StoredHex> = [];
      for _xi in 0..CHUNK_CELLS {
        rh = br_u16(r);
        rm = br_u8(r);
        ri = br_u8(r);
        rr = br_u8(r);
        rn = br_u8(r);
        re = br_u8(r);
        rs = br_u8(r);
        cells += [StoredHex { sv_height: rh as u16? ?? 0, sv_material: rm as u8? ?? 0,
                              sv_item: ri as u8? ?? 0, sv_item_rotation: rr as u8? ?? 0,
                              sv_wall_nw: rn as u8? ?? 0, sv_wall_ne: re as u8? ?? 0,
                              sv_wall_e: rs as u8? ?? 0 }];
      }
      ly = Layer { ly_id: lid, ly_kind: lk, ly_ver: lver, ly_cells: cells };
      if (br_i32(r) & U32_MASK) != layer_crc(ly) {
        return WorldLoad { wl_code: WL_CRC, wl_world: empty, wl_palette: [],
                           wl_detail: "chunk ({cx},{cz}) layer id {lid} failed CRC" };
      }
      lays += [ly];
    }
    // ⚠ MIGRATION, and AFTER the CRC — see `world_load`'s note. A pre-label world
    // has `ly_id = 0` everywhere, so nothing carries `LABEL_GROUND` and the world
    // would render FLAT; such a chunk labels its lowest terrain layer.
    gseen = false;
    for gl in lays { if gl.ly_id == LABEL_GROUND && gl.ly_kind == KIND_TERRAIN { gseen = true; } }
    if !gseen {
      for gi in 0..len(lays) {
        if !gseen && lays[gi].ly_kind == KIND_TERRAIN {
          lays[gi].ly_id = LABEL_GROUND;
          gseen = true;
        }
      }
    }
    w.w_chunks += [VoxelChunk { ck_cx: cx, ck_cz: cz, ck_base: cb, ck_layers: lays }];
    w.w_index += ChunkAt { ca_key: chunk_key(cx, cz), ca_at: len(w.w_chunks) - 1 };
  }
  // ── the sections, read to the END OF THE BUFFER — the terminator is the end,
  // never a count, which is what lets a pre-section file load unchanged.
  while r.br_pos < len(b) {
    left = len(b) - r.br_pos;
    if left < SZ_SECTION_HEAD {
      return WorldLoad { wl_code: WL_SECTION, wl_world: empty, wl_palette: [],
                         wl_detail: "{left} trailing bytes: too few for a section header" };
    }
    stag = br_i32(r);
    slen = br_i32(r);
    if slen < 0 || slen > len(b) - r.br_pos {
      return WorldLoad { wl_code: WL_SECTION, wl_world: empty, wl_palette: [],
                         wl_detail: "section {stag} claims {slen} bytes, "
                                  + "{len(b) - r.br_pos} remain" };
    }
    sb: vector<u8> = [];
    for _sbi in 0..slen { sb += [br_u8(r) as u8? ?? 0]; }
    // ⚠ `GRND` GOES TO THE FIELD, NOT TO `w_sections` — `G4`, and it is the same
    // one-home rule the field's own comment states: a default that were both a
    // section AND a field could disagree with itself across a save. A file that has
    // no such section simply leaves the default absent, which is a world exactly as
    // this library read it before the tag existed.
    if stag == ground_tag() && slen == 8 {
      w.w_ground = Hex { h_height: ((sb[0] ?? 0) | ((sb[1] ?? 0) << 8)) as u16? ?? 0,
                         h_material: sb[2] ?? 0, h_item: sb[3] ?? 0,
                         h_item_rotation: sb[4] ?? 0, h_wall_nw: sb[5] ?? 0,
                         h_wall_ne: sb[6] ?? 0, h_wall_e: sb[7] ?? 0 };
    } else {
      w.w_sections += [Section { sc_tag: stag, sc_bytes: sb }];
    }
  }
  // ⚠ ASKED ONCE, HERE. Every primitive above answers 0 past the end and sets the
  // flag; a buffer that ran out mid-record would otherwise decode as a world made
  // of zeroes, which is the "reads cleanly and says something untrue" class this
  // format's CRC exists to prevent. A file reader could not hit this — a caller
  // handing over a truncated buffer can.
  if r.br_short {
    return WorldLoad { wl_code: WL_SECTION, wl_world: empty, wl_palette: [],
                       wl_detail: "buffer ended mid-record: {len(b)} bytes" };
  }
  WorldLoad { wl_code: WL_OK, wl_world: w, wl_palette: pal, wl_detail: "" }
}

pub fn world_load(path: text) -> WorldLoad {
  empty = VoxelWorld { w_unit: 1.0 };
  f = file(path);
  if f.format == Format.NotExists {
    return WorldLoad { wl_code: WL_MISSING, wl_world: empty, wl_palette: [], wl_detail: path };
  }
  // ⚠ ONE DECODER. This function used to read the whole format field by field, a
  // near-exact mirror of `world_from_bytes` — two decoders that had to be kept in
  // step by hand, which is the shape this format's own history warns about (a
  // writer that padded the voxel to 28 bytes round-tripped perfectly for as long
  // as both halves agreed with each other and with nothing else).
  //
  // ⚠ THERE IS NO `f.bytes()` IN loft, so the buffer is filled a byte at a time.
  // That is the same number of reads the field-by-field version issued for the
  // payload — a cell was seven reads and is now eight bytes — so it is not a new
  // cost; `make parts` is the control and it is timed at the seam.
  f#format = LittleEndian;
  wl_n = f.size;
  wl_buf: vector<u8> = [];
  for _wli in 0..wl_n { wl_buf += [f#read as u8]; }
  world_from_bytes(wl_buf)
}

// ════════════════════════════════════════════════════════════════════════════
// THE PALETTE — what a cell's bytes MEAN, and the only thing fixed in code is 0.
//
// Plan [21](../../../plans/21-region-mappings/README.md) `R1`.
//
// > *"We have 256 terrains and walls and that will be plenty for many games,
// > however open world games give their own problems … so there cannot be
// > hard-coded mappings left outside 0 = nothing for terrain/wall/items."*
//
// A cell holds a `u16` height and six `u8`s. Those `u8`s are **indices**, not
// values: which ground `2` is, which wall `1` is, which thing `3` is, are facts
// about the WORLD and not about the code that reads it. Two worlds may use the
// same byte for different things and neither is wrong.
//
// ⚠ THE STORE OWNS IDENTITY AND NOT POLICY, which is this package's own rule
// arriving intact. `hex_voxel` says a byte is called `road`; whether a road may
// slope, and how steeply, is `hex_editor`'s business and stays there. A palette
// carrying gameplay attributes would be a store with an opinion about its
// consumers — the thing the section mechanism exists to avoid.
//
// ⚠ SLOT 0 IS ABSENCE ON ALL THREE AXES, AND IT IS THE ONE FIXED FACT. It is
// already load-bearing everywhere: `h_material == 0` is *no cell*, a zero wall
// byte is *no boundary* (`E1`), `h_item == 0` is *nothing placed*, and a
// freshly-defaulted `Hex` is all zeroes and must read as empty because that is
// what an unwritten cell IS. So slot 0 can never be a definition, and a palette
// that tried would make empty space resolve to whatever was defined first.

pub const PAL_MAX = 256;        // a `u8` names no more, so a 257th is unaddressable
pub const PAL_ABSENT = "-";     // what slot 0 answers, named so a reader can say so

// The three axes. ⚠ Separate tables rather than one, because the same byte on two
// axes is two unrelated things — `1` may be grass on the cell axis while `1` is a
// wall on the edge axis, and they are already numbered independently today.
pub const PAL_MATERIAL = 0;
pub const PAL_EDGE     = 1;
pub const PAL_ITEM     = 2;

// ⚠ LITERALS, held equal to `section_tag(…)` by a test — the same rule and the same
// reason as the part sections: a file-scope constant is an inlined expression,
// re-evaluated at every reference, so a derived tag re-runs the packing loop at
// each use.
pub const TAG_PALM = 1296843088;   // 'PALM', low byte first — materials
pub const TAG_PALW = 1464615248;   // 'PALW' — edges
pub const TAG_PALI = 1229734224;   // 'PALI' — items
pub const TAG_RGNS = 1397638994;   // 'RGNS' — which region each chunk belongs to

pub struct PalEntry { pl_slot: integer, pl_name: text }

pub const PAL_OK       = 0;
pub const PAL_SLOT     = 1;   // a slot outside 1..255 — 0 is absence and is not writable
pub const PAL_DUP      = 2;   // two entries claiming one slot
pub const PAL_NEWLINE  = 3;   // a newline in a name would forge a line
pub const PAL_ABSENT_C = 4;   // a byte a cell uses that the palette does not name

fn pal_tag(kind: integer) -> integer {
  if kind == PAL_EDGE { return TAG_PALW; }
  if kind == PAL_ITEM { return TAG_PALI; }
  TAG_PALM
}

// ⚠ TWO LINES EACH WAY, and no text view in the store. `text_from_bytes` and
// `byte_at` have shipped since before this file (loft#748 reported them missing and
// was wrong); the store carries the section as opaque bytes and this is the only
// place that decides they are text.
fn pal_write(w: VoxelWorld, tag: integer, t: text) {
  b: vector<u8> = [];
  for i in 0..t.size() { b += [t.byte_at(i) as u8? ?? 0]; }
  world_set_section(w, tag, b);
}

fn pal_read(w: VoxelWorld, tag: integer) -> text {
  text_from_bytes(world_section_bytes(w, tag))
}

// ── AND A PALETTE BELONGS TO A REGION — plan 21 `R2` ───────────────────────
//
// > *"So we need to be able to define regions with their own mapping of walls and
// > terrains … see desert biome beside a mountain one, beside an oceanic one."*
//
// A line is `region:slot=name`. ⚠ **Region 0 is the default and is what a world
// with no regions uses**, so everything `R1` wrote keeps resolving unchanged — the
// negative control of this phase is that a one-region world is byte-for-byte what
// it was, and that is true by construction rather than by care.
//
// ⚠ A REGION IS A PROPERTY OF THE CHUNK, NOT OF THE CELL, and that is the one real
// decision here. There is no room in the cell — it is a `u16` and six `u8`s, all
// spoken for — and a per-cell answer has to be cheap: `A2c` measured what a
// six-lookup question per cell costs a stroke (262 ms). The mesher, the streamer and
// the dirty set already iterate chunk by chunk, so a chunk label is resolved ONCE
// where they already stand. The cost is 32-hex granularity at a seam, which is what
// `R3`'s blend band is for.
pub fn world_set_palette(w: VoxelWorld, kind: integer, region: integer,
                         items: vector<PalEntry>) -> integer {
  if region < 0 { return PAL_SLOT; }
  keep = "";
  // every OTHER region's lines survive this write — a palette is set per region,
  // and setting one must not silently drop its neighbours
  if world_section_at(w, pal_tag(kind)) >= 0 {
    for line in pal_read(w, pal_tag(kind)).split('\n') {
      if line == "" { continue; }
      c = line.find(":");
      lr = 0;
      if c != null { lr = (line[0..c] as i32?) ?? 0; }
      if lr != region { keep += "{line}\n"; }
    }
  }
  seen: vector<integer> = [];
  body = keep;
  for e in items {
    // ⚠ SLOT 0 IS NOT WRITABLE. Absence is not a definition, and a palette that
    // let one be written would make an unwritten cell resolve to a real thing.
    if e.pl_slot < 1 || e.pl_slot >= PAL_MAX { return PAL_SLOT; }
    if e.pl_name.find("\n") != null { return PAL_NEWLINE; }
    for s in seen { if s == e.pl_slot { return PAL_DUP; } }
    seen += [e.pl_slot];
    body += "{region}:{e.pl_slot}={e.pl_name}\n";
  }
  pal_write(w, pal_tag(kind), body);
  PAL_OK
}

// ── WHICH REGION IS THIS CHUNK IN? — plan 21 `R2` ──────────────────────────
//
// A sparse list, `cx,cz=region`; a chunk nobody has assigned is region **0**. That
// default is what makes `R1`'s worlds keep working untouched and is the negative
// control of this phase stated as a mechanism rather than as care.
pub fn world_set_region(w: VoxelWorld, cx: integer, cz: integer, region: integer) -> integer {
  if region < 0 { return PAL_SLOT; }
  keep = "";
  if world_section_at(w, TAG_RGNS) >= 0 {
    for line in pal_read(w, TAG_RGNS).split('\n') {
      if line == "" { continue; }
      if line.find("{cx},{cz}=") == 0 { continue; }
      keep += "{line}\n";
    }
  }
  pal_write(w, TAG_RGNS, keep + "{cx},{cz}={region}\n");
  PAL_OK
}

// The region a hex falls in — its CHUNK's, because that is where the label lives.
pub fn world_region_at(w: VoxelWorld, q: integer, r: integer) -> integer {
  if world_section_at(w, TAG_RGNS) < 0 { return 0; }
  cx = world_chunk_of(q);
  cz = world_chunk_of(r);
  want = "{cx},{cz}=";
  for line in pal_read(w, TAG_RGNS).split('\n') {
    if line == "" { continue; }
    if line.find(want) == 0 { return (line[want.size()..] as i32?) ?? 0; }
  }
  0
}

pub struct PalRead { pr_code: integer, pr_items: vector<PalEntry>, pr_why: text }

// ⚠ ABSENT AND MALFORMED ARE DIFFERENT ANSWERS, and `pr_items` is usable on both
// `PAL_ABSENT_C`-free readings: a world written before palettes exist names nothing
// and is fine; one whose section says `x=road` is damaged. Collapsing them makes the
// damaged one look ordinary.
pub fn world_palette(w: VoxelWorld, kind: integer, region: integer) -> PalRead {
  none: vector<PalEntry> = [];
  tag = pal_tag(kind);
  if world_section_at(w, tag) < 0 {
    return PalRead { pr_code: PAL_OK, pr_items: none, pr_why: "no palette on this axis" };
  }
  out: vector<PalEntry> = [];
  for line0 in pal_read(w, tag).split('\n') {
    if line0 == "" { continue; }
    c0 = line0.find(":");
    lr0 = 0;
    line = line0;
    if c0 != null {
      lr0 = (line0[0..c0] as i32?) ?? 0;
      line = line0[(c0 + 1)..];
    }
    if lr0 != region { continue; }
    i = line.find("=");
    if i == null {
      return PalRead { pr_code: PAL_SLOT, pr_items: none, pr_why: "line '{line}' has no =" };
    }
    n = line[0..i] as i32?;
    if n == null {
      return PalRead { pr_code: PAL_SLOT, pr_items: none,
                       pr_why: "slot '{line[0..i]}' is not a number" };
    }
    if (n ?? 0) < 1 || (n ?? 0) >= PAL_MAX {
      return PalRead { pr_code: PAL_SLOT, pr_items: none, pr_why: "slot {n} is out of range" };
    }
    out += [PalEntry { pl_slot: n ?? 0, pl_name: line[(i + 1)..] }];
  }
  PalRead { pr_code: PAL_OK, pr_items: out, pr_why: "" }
}

// What this world calls `slot` on this axis. `PAL_ABSENT` for 0; **empty for a byte
// the palette does not name**, which a caller must treat as a fault rather than as
// a default.
pub fn world_palette_name(w: VoxelWorld, kind: integer, region: integer,
                          slot: integer) -> text {
  if slot == 0 { return PAL_ABSENT; }
  tag = pal_tag(kind);
  if world_section_at(w, tag) < 0 { return ""; }
  for line in pal_read(w, tag).split('\n') {
    if line == "" { continue; }
    c = line.find(":");
    lr = 0;
    rest = line;
    if c != null {
      lr = (line[0..c] as i32?) ?? 0;
      rest = line[(c + 1)..];
    }
    if lr != region { continue; }
    i = rest.find("=");
    if i == null { continue; }
    if ((rest[0..i] as i32?) ?? 0) == slot { return rest[(i + 1)..]; }
  }
  ""
}

// ── DOES EVERY BYTE THIS WORLD USES HAVE A NAME? ────────────────────────────
//
// ⚠ THE NEGATIVE CONTROL OF THE WHOLE DESIGN, and it is why this is a refusal and
// not a default. A byte the palette does not name must be REFUSED, because the
// alternative — resolving it to ground, or to the first definition, or to nothing —
// is exactly how a world loaded against the WRONG palette looks correct: every cell
// draws something, no error is raised, and the map is quietly a different place.
//
// Returns "" when every used byte is named, or a sentence naming the first that is
// not — the axis, the byte, and where it was found, because "a byte is unmapped" is
// not actionable and "material 7 at (12,-3)" is.
pub fn world_palette_check(w: VoxelWorld) -> text {
  for ch in w.w_chunks {
    q0 = ch.ck_cx * CHUNK_W;
    r0 = ch.ck_cz * CHUNK_W;
    for dq in 0..CHUNK_W {
      for dr in 0..CHUNK_W {
        q = q0 + dq;
        r = r0 + dr;
        for c in world_column(w, q, r).co_cells {
          m = c.h_material as integer ?? 0;
          rg = world_region_at(w, q, r);
          if m != 0 && world_palette_name(w, PAL_MATERIAL, rg, m) == "" {
            return "material {m} at ({q},{r}) is not in region {rg}'s palette";
          }
          it = c.h_item as integer ?? 0;
          if it != 0 && world_palette_name(w, PAL_ITEM, rg, it) == "" {
            return "item {it} at ({q},{r}) is not in region {rg}'s palette";
          }
          for e in [c.h_wall_nw as integer ?? 0, c.h_wall_ne as integer ?? 0,
                    c.h_wall_e as integer ?? 0] {
            if e != 0 && world_palette_name(w, PAL_EDGE, rg, e) == "" {
              return "edge material {e} at ({q},{r}) is not in region {rg}'s palette";
            }
          }
        }
      }
    }
  }
  ""
}
