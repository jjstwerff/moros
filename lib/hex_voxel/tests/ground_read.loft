//
// `G5a` — AN ABSENT CHUNK READS AS THE GROUND, AND AS NOTHING ELSE.
//
// [GROUND_DEFAULT.md](../../../doc/claude/GROUND_DEFAULT.md)'s invariant ends with the
// clause this file is about: *a defaulted cell and a written one of the same value are
// **indistinguishable, because they are the same cell**.*
//
// ⚠ **SO THE TEST IS AN EQUIVALENCE, NOT FIVE BRANCH CHECKS.** Asserting that each
// reader returns the default where a chunk is absent proves only that five branches
// were written; it cannot be surprised by any of them being subtly different from
// what a REAL defaulted chunk answers — the wrong layer index, a missing label, a
// surface that reports `sf_occ: 0`. Every row below asks the same question of two
// worlds — one where the ground was AUTHORED cell by cell, one where it is the
// default and nothing was written — and requires the same answer.
//
// ⚠ **AND THE AUTHORED WORLD IS THE ORACLE**, which is what makes it able to fail:
// it is built by `world_set_column`, the path that has been minting first layers
// since long before this design, so nothing in it is a restatement of `G5a`'s code.
use hex_voxel;

const RESERVE = 100;

fn grass(h: integer) -> Hex {
  Hex { h_height: h as u16? ?? 0, h_material: 4 as u8? ?? 0 }
}

// The oracle: a world with the ground WRITTEN over a whole chunk, no default.
fn authored(h: integer) -> VoxelWorld {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  for q in 0..CHUNK_W {
    for r in 0..CHUNK_W {
      world_set_column(w, Column { co_q: q, co_r: r, co_cells: [grass(h)] });
    }
  }
  w
}

// The subject: the same ground, said once, with nothing written at all.
fn with_default(h: integer) -> VoxelWorld {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  assert(world_set_ground(w, grass(h)).cw_code == CW_OK, "the fixture's ground was refused");
  w
}

// ⚠ THE FIXTURES MUST DIFFER IN STORAGE OR THE EQUIVALENCE IS VACUOUS: if the
// defaulted world had chunks, every row below would be comparing two written worlds.
fn test_the_two_fixtures_are_stored_differently() {
  a = authored(200);
  d = with_default(200);
  assert(len(a.w_chunks) == 1, "the oracle stored {len(a.w_chunks)} chunks, want 1");
  assert(len(d.w_chunks) == 0,
         "the defaulted world stored {len(d.w_chunks)} chunks — it should have "
       + "written nothing, and this test would be comparing two authored worlds");
  assert(world_has_chunk(a, 5, 5) && !world_has_chunk(d, 5, 5),
         "the two worlds agree about chunk existence, so nothing here is synthesised");
}

// ── the equivalence, reader by reader ───────────────────────────────────────

fn test_the_ground_cell_is_the_same_either_way() {
  a = authored(200);
  d = with_default(200);
  for q in [0, 1, 17, CHUNK_W - 1] {
    for r in [0, 3, 31] {
      ga = world_ground_cell(a, q, r);
      gd = world_ground_cell(d, q, r);
      assert(ga.h_height == gd.h_height && ga.h_material == gd.h_material,
             "at ({q},{r}) authored reads {ga.h_height}/{ga.h_material} and "
           + "defaulted {gd.h_height}/{gd.h_material}");
      assert(gd.h_material == 4, "…and it is the ground, not nothing");
    }
  }
}

fn test_the_ground_layer_index_is_the_same_either_way() {
  a = authored(200);
  d = with_default(200);
  assert(world_ground_layer(a, 7, 7) == world_ground_layer(d, 7, 7),
         "authored says layer {world_ground_layer(a, 7, 7)} and defaulted "
       + "{world_ground_layer(d, 7, 7)}");
  assert(world_ground_layer(d, 7, 7) == 0, "…and it is layer 0");
}

fn test_the_cell_is_the_same_either_way_and_nothing_is_above_it() {
  a = authored(200);
  d = with_default(200);
  ca = world_cell(a, 9, 9, 0);
  cd = world_cell(d, 9, 9, 0);
  assert(ca.h_height == cd.h_height && ca.h_material == cd.h_material,
         "layer 0 reads {ca.h_height}/{ca.h_material} against {cd.h_height}/{cd.h_material}");
  // ⚠ AND A STOREY THAT WAS NEVER BUILT IS STILL ABSENT — the default is ONE layer,
  // not an infinite stack of them. Without this row the branch could answer the
  // ground for every index and every row above would still pass.
  for l in [1, 2, 7] {
    assert(!hex_present(world_cell(d, 9, 9, l)),
           "layer {l} of untouched ground answered a cell");
    assert(!hex_present(world_cell(a, 9, 9, l)), "…and the oracle agrees");
  }
}

fn test_the_column_is_the_same_either_way() {
  a = authored(200);
  d = with_default(200);
  ca = world_column(a, 4, 6);
  cd = world_column(d, 4, 6);
  assert(len(ca.co_cells) == len(cd.co_cells),
         "authored gives {len(ca.co_cells)} cells and defaulted {len(cd.co_cells)}");
  assert(len(cd.co_cells) == 1, "…and it is one");
  assert((ca.co_cells[0] ?? Hex {}).h_height == (cd.co_cells[0] ?? Hex {}).h_height,
         "the heights differ");
  // The LABEL matters: `I1` identifies corresponding layers across chunks by it, so
  // a synthesised column carrying the wrong one would name a different layer.
  assert(len(ca.co_ids) == len(cd.co_ids) && (ca.co_ids[0] ?? 0) == (cd.co_ids[0] ?? 0),
         "authored labels {ca.co_ids} and defaulted {cd.co_ids}");
  assert((cd.co_ids[0] ?? 0) == LABEL_GROUND, "…and it is the reserved ground label");
}

// ⚠ THE SURFACE IS ASKED FROM THREE HEIGHTS, because its loop chooses between `low`
// and `best` depending on where the feet are, and a single-layer synthesis has to
// give the same answer in every one of those cases rather than in the one that was
// tried first.
fn test_the_surface_is_the_same_either_way_from_any_height() {
  a = authored(200);
  d = with_default(200);
  for feet in [0.0, 200.0, 500.0] {
    sa = world_surface(a, 11, 2, feet);
    sd = world_surface(d, 11, 2, feet);
    assert(sa.sf_units == sd.sf_units && sa.sf_layer == sd.sf_layer
           && sa.sf_occ == sd.sf_occ && sa.sf_smooth == sd.sf_smooth,
           "at feet {feet}: authored units {sa.sf_units} layer {sa.sf_layer} occ "
         + "{sa.sf_occ}, defaulted units {sd.sf_units} layer {sd.sf_layer} occ "
         + "{sd.sf_occ}");
    assert(sd.sf_units == 200, "…and it is the ground's height, got {sd.sf_units}");
  }
}

// ── and absent still means TODAY ────────────────────────────────────────────
//
// ⚠ THE ROW THAT KEEPS `G5a` REVERTIBLE. With no ground set, every reader must give
// exactly the answer it gave before this step — otherwise the six steps of this plan
// stop being independent and a regression anywhere lands on all of them.
fn test_a_world_with_no_ground_reads_as_nothing() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  assert(!hex_present(world_ground_cell(w, 3, 3)), "the ground answered a cell");
  assert(!hex_present(world_cell(w, 3, 3, 0)), "layer 0 answered a cell");
  assert(world_ground_layer(w, 3, 3) == 0 - 1,
         "the ground layer is {world_ground_layer(w, 3, 3)}, want -1");
  assert(len(world_column(w, 3, 3).co_cells) == 0, "the column is not empty");
  s = world_surface(w, 3, 3, 0.0);
  assert(s.sf_units == 0 - 1 && s.sf_layer == 0 - 1 && s.sf_occ == 0,
         "the surface answered units {s.sf_units} layer {s.sf_layer} occ {s.sf_occ}");
}

// ⚠ AND A GROUND WITH NO MATERIAL IS NO SURFACE, which is `hex_occupied` against
// `hex_present`: the two predicates part company exactly here, and `world_surface`'s
// own loop tests the material. A synthesis using the wrong one would report a surface
// the authored world does not have.
fn test_a_default_with_no_material_is_not_a_surface() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  edge: Hex = Hex { h_height: 200 as u16? ?? 0, h_material: 0 as u8? ?? 0,
                    h_wall_e: 1 as u8? ?? 0 };
  assert(world_set_ground(w, edge).cw_code == CW_OK, "the fixture's ground was refused");
  assert(world_has_ground_default(w), "an edge-only ground is still a ground");
  assert(hex_present(world_ground_cell(w, 2, 2)), "…and it reads back");
  s = world_surface(w, 2, 2, 500.0);
  assert(s.sf_occ == 0 && s.sf_units == 0 - 1,
         "a ground with no material reported a surface: units {s.sf_units} occ "
       + "{s.sf_occ}");
}

// ── `G5a.1` — THE SEAM: A CHUNK THAT EXISTS BUT WHOSE CELL WAS NEVER WRITTEN ──
//
// ⚠ **THE ROWS ABOVE COULD NOT SEE THIS AND IT WAS A REAL DEFECT.** The oracle wrote
// EVERY cell, so no untouched cell of an existing chunk was ever compared. Measured
// on the first build of `G5a`: with a default of 200/4 and one cell written at (0,0),
// its neighbour at (5,5) read `h 0 mat 0` — **a hole in the grass** — while an
// untouched chunk read the ground. Two untouched cells differing by whether a
// NEIGHBOUR was written is exactly what the invariant forbids.
//
// The design said *synthesise where the CHUNK is absent*; the invariant says
// *infinite plane*. The invariant wins, and this pair of fixtures is why.

// One cell written into an otherwise untouched world that HAS a ground.
fn dented() -> VoxelWorld {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  assert(world_set_ground(w, grass(200)).cw_code == CW_OK, "the fixture's ground was refused");
  world_set_column(w, Column { co_q: 0, co_r: 0,
    co_cells: [Hex { h_height: 300 as u16? ?? 0, h_material: 7 as u8? ?? 0 }] });
  w
}

// …and the oracle: the same dent, over ground that was written out in full.
fn dented_oracle() -> VoxelWorld {
  w = authored(200);
  world_set_column(w, Column { co_q: 0, co_r: 0,
    co_cells: [Hex { h_height: 300 as u16? ?? 0, h_material: 7 as u8? ?? 0 }] });
  w
}

fn test_a_neighbour_being_written_does_not_punch_a_hole() {
  d = dented();
  o = dented_oracle();
  assert(world_has_chunk(d, 5, 5),
         "the chunk does not exist, so this test is the absent-chunk case again");

  for q in [1, 5, 17, 31] {
    a = world_ground_cell(o, q, q);
    b = world_ground_cell(d, q, q);
    assert(a.h_height == b.h_height && a.h_material == b.h_material,
           "at ({q},{q}) the authored world reads {a.h_height}/{a.h_material} and "
         + "the defaulted one {b.h_height}/{b.h_material} — a neighbour's write "
         + "changed what an untouched cell says");
    assert(b.h_material == 4, "…and it is the ground, not a hole");
  }
  // the dent itself is still the dent, in both
  assert(world_ground_cell(d, 0, 0).h_height == 300
         && world_ground_cell(o, 0, 0).h_height == 300,
         "the written cell moved: {world_ground_cell(d, 0, 0).h_height}");
}

// ⚠ AND THE SURFACE AND THE COLUMN AGREE THERE TOO, because `world_surface` tests the
// STORED cell's material in its own loop and would skip an unwritten one — reporting
// no surface where the reader is standing on grass.
fn test_the_surface_and_column_agree_over_a_dented_chunk() {
  d = dented();
  o = dented_oracle();
  sa = world_surface(o, 5, 5, 500.0);
  sb = world_surface(d, 5, 5, 500.0);
  assert(sa.sf_units == sb.sf_units && sa.sf_occ == sb.sf_occ,
         "authored surface units {sa.sf_units} occ {sa.sf_occ}, defaulted "
       + "{sb.sf_units} occ {sb.sf_occ}");
  assert(sb.sf_units == 200, "…and it is the ground's height, got {sb.sf_units}");

  ca = world_column(o, 5, 5);
  cb = world_column(d, 5, 5);
  assert(len(ca.co_cells) == len(cb.co_cells), "the columns are different lengths");
  assert((ca.co_cells[0] ?? Hex {}).h_height == (cb.co_cells[0] ?? Hex {}).h_height,
         "the column heights differ over an untouched cell");
}

// ⚠ AND A NON-GROUND LAYER IS NOT FILLED. The default is the ground PLANE; answering
// it for a cellar's unwritten cells would pack every storey with earth. The control
// that keeps `cell_or_ground` from being "any absent cell reads as the ground".
fn test_a_second_terrain_layer_is_not_filled_with_ground() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  assert(world_set_ground(w, grass(200)).cw_code == CW_OK, "the fixture's ground was refused");
  // two layers at one cell: the ground, and a storey above it
  // ⚠ THE GROUND CELL DIFFERS FROM THE DEFAULT ON PURPOSE — `G5b`. Written AT the
  // default it would make the ground layer elidable everywhere, the layer would be
  // dropped, and layer 0 would name the STOREY: a true statement about elision that
  // says nothing about the over-reach this row is the control for.
  world_set_column(w, Column { co_q: 2, co_r: 2,
    co_cells: [grass(300), grass(400)] });
  // …and at a cell where only the first was ever written
  assert(hex_present(world_cell(w, 9, 9, 0)), "the ground layer is not there");
  assert(!hex_present(world_cell(w, 9, 9, 1)),
         "an unwritten cell of the SECOND layer answered {world_cell(w, 9, 9, 1).h_material} "
       + "— the default filled a storey");
}

// ── `G5b` — STORAGE HOLDS ONLY WHAT DIFFERS ─────────────────────────────────

// ⚠ THE POINT OF THE WHOLE PLAN, AS ONE ROW: writing the ground onto ground stores
// nothing at all. Today this costs a chunk, 1024 records and a file entry.
fn test_writing_the_default_stores_nothing() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  assert(world_set_ground(w, grass(200)).cw_code == CW_OK, "the fixture's ground was refused");
  for q in 0..4 {
    for r in 0..4 {
      assert(world_set_column(w, Column { co_q: q, co_r: r, co_cells: [grass(200)] }).cw_code
             == CW_OK, "writing the ground was refused at ({q},{r})");
    }
  }
  assert(len(w.w_chunks) == 0,
         "{len(w.w_chunks)} chunks stored for 16 writes of the ground itself");
  // …and it still reads as the ground, which is what makes storing nothing correct
  // rather than merely cheap.
  assert(world_ground_cell(w, 2, 2).h_material == 4, "the ground stopped reading");
}

// …and a cell that DIFFERS is stored, or the row above passes on a store that
// silently drops everything.
fn test_a_cell_that_differs_is_still_stored() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  world_set_ground(w, grass(200));
  world_set_column(w, Column { co_q: 1, co_r: 1, co_cells: [grass(300)] });
  assert(len(w.w_chunks) == 1, "{len(w.w_chunks)} chunks for one differing cell");
  assert(world_ground_cell(w, 1, 1).h_height == 300, "the differing cell did not stick");
  assert(world_ground_cell(w, 2, 2).h_height == 200, "…and its neighbour is the ground");
}

// ⚠ A LAYER THAT COMES TO EQUAL THE DEFAULT EVERYWHERE IS DROPPED — the counterpart
// of `E1`, and the rule that keeps a world from accumulating chunks that say nothing.
fn test_a_layer_that_becomes_the_default_is_dropped() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  world_set_ground(w, grass(200));
  world_set_column(w, Column { co_q: 1, co_r: 1, co_cells: [grass(300)] });
  assert(len(w.w_chunks) == 1, "the fixture stored nothing");

  world_set_column(w, Column { co_q: 1, co_r: 1, co_cells: [grass(200)] });
  assert(len(w.w_chunks) == 0,
         "the cell was written back to the ground and {len(w.w_chunks)} chunks remain");
  assert(world_ground_cell(w, 1, 1).h_height == 200, "and it reads as the ground");
}

// ⚠ AND DROPPING THE GROUND LAYER MUST NOT PUNCH BACK THE HOLE `G5a.1` CLOSED. With a
// storey keeping the chunk alive, the ground layer can go while the chunk stays — and
// then there is no `LABEL_GROUND` layer to find. The ground is still there.
fn test_the_ground_survives_its_own_layer_being_dropped() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  world_set_ground(w, grass(200));
  world_set_column(w, Column { co_q: 2, co_r: 2, co_cells: [grass(200), grass(400)] });
  assert(len(w.w_chunks) == 1, "the storey did not keep the chunk alive");
  assert(world_ground_cell(w, 2, 2).h_material == 4,
         "the ground reads as {world_ground_cell(w, 2, 2).h_material} where its layer "
       + "was dropped — the hole is back");
  assert(world_ground_cell(w, 9, 9).h_height == 200, "…and at an untouched cell too");
}

// ⚠ AND WITH NO DEFAULT, ELISION IS EXACTLY WHAT IT WAS. `E1` is generalised, not
// replaced, and `tests/elision.loft` is the full statement of the old rule — this is
// the one row that says the generalisation did not move it.
fn test_with_no_default_elision_is_unchanged() {
  w = world_new(0.25, RESERVE, 8, 3).wn_world;
  world_set_column(w, Column { co_q: 3, co_r: 4, co_cells: [grass(200)] });
  assert(len(w.w_chunks) == 1, "the fixture wrote nothing");
  world_set_column(w, Column { co_q: 3, co_r: 4,
    co_cells: [Hex { h_height: 0 as u16? ?? 0, h_material: 0 as u8? ?? 0 }] });
  assert(len(w.w_chunks) == 0,
         "an emptied layer left {len(w.w_chunks)} chunks with no ground default set");
}
