// THE FIVE PRIMITIVES, AND THE TESTS THAT CAME WITH THEM — plan 22 `B1b.2c.2`.
//
// A hex surface, a box, a cylinder post and an item placeholder. They were
// `moros_render`'s and are `hex_proj`'s now — the projection leaf BOTH sides
// already depend on, because all five have consumers on each side of the split:
// Moros's map renderer draws markers and thick walls with them, and the editor's
// props mesher (on its way out of the server) calls every one.
//
// ⚠ THE TESTS MOVED WITH THE SUBJECT, WHICH IS THE HALF A DELETION USUALLY LOSES.
// Fourteen of `moros_render`'s tests were ABOUT these five; deleting the functions
// would have deleted their only guard, and a suite that goes green by losing its
// subject is exactly what `V3` measured. They are copied verbatim so a diff shows
// a move rather than a rewrite — only `use` and the qualified names differ.
//
// ⚠ AND THEY ARE THE GUARD NOW. While both copies existed, `EDITOR_PROBE=emitcmp`
// in the server compared them mesh-checksum by mesh-checksum; that probe is SPENT
// the moment the originals go, because there is nothing left to diverge from. What
// keeps the geometry honest from here is these fourteen rows.
use hex_proj;
use graphics;

fn test_emit_hex_surface_vertex_count() {
  m = mesh("test");
  emit_hex_surface(m, 0, 0, 0);
  assert(len(m.vertices) == 7, "7 verts (centre + 6 corners)");
  assert(len(m.triangles) == 6, "6 triangles (hex fan)");
}

fn test_emit_hex_surface_centre_position() {
  m = mesh("test");
  emit_hex_surface(m, 3, 2, 5);
  centre = m.vertices[0].pos;
  expected = hex_to_world(3, 2, 5);
  assert(centre.x == expected.x, "centre x");
  assert(centre.y == expected.y, "centre y");
  assert(centre.z == expected.z, "centre z");
}

fn test_emit_hex_surface_normal_up() {
  m = mesh("test");
  emit_hex_surface(m, 0, 0, 0);
  // All normals should point up (0, 1, 0)
  for gv in m.vertices {
    assert(gv.normal.y == 1.0, "normal up y={gv.normal.y}");
  }
}

fn test_emit_cylinder_post_vertex_count() {
  cp_mesh = mesh("cp_count");
  // 8-segment cylinder: 8 × 4 = 32 verts, 8 × 2 = 16 tris.
  emit_cylinder_post(cp_mesh, vec3(0.0, 0.0, 0.0), vec3(0.0, 2.0, 0.0), 0.5, 8);
  assert(len(cp_mesh.vertices) == 32, "expected 32 verts, got {len(cp_mesh.vertices)}");
  assert(len(cp_mesh.triangles) == 16, "expected 16 tris, got {len(cp_mesh.triangles)}");
}

fn test_emit_cylinder_post_radial_normals() {
  cp_mesh = mesh("cp_n");
  // 4 segments: normals should be at 0°, 90°, 180°, 270° + the same
  // again for each segment's end angle.  Check that every normal
  // has a horizontal direction (Y = 0) and unit length ~1.
  emit_cylinder_post(cp_mesh, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 1.0, 4);
  for cp_v in cp_mesh.vertices {
    assert(cp_v.normal.y == 0.0, "cyl normal Y = 0");
  }
}

fn test_emit_cylinder_post_too_few_segments() {
  cp_mesh = mesh("cp_few");
  emit_cylinder_post(cp_mesh, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 1.0, 2);
  assert(len(cp_mesh.vertices) == 0, "< 3 segs → no geometry");
}

fn test_emit_cylinder_post_zero_radius() {
  cp_mesh = mesh("cp_zr");
  emit_cylinder_post(cp_mesh, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), 0.0, 8);
  assert(len(cp_mesh.vertices) == 0, "zero radius → no geometry");
}

fn test_emit_box_vertex_and_triangle_count() {
  bx_mesh = mesh("box_count");
  emit_box(bx_mesh, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
  // 6 faces × 4 verts = 24 verts, × 2 tris = 12 tris.
  assert(len(bx_mesh.vertices) == 24, "24 verts, got {len(bx_mesh.vertices)}");
  assert(len(bx_mesh.triangles) == 12, "12 tris, got {len(bx_mesh.triangles)}");
}

fn test_emit_box_face_normals() {
  bx_mesh = mesh("box_n");
  emit_box(bx_mesh, vec3(0.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0));
  // The first 4 verts are the +X face — all should have normal.x = 1.
  assert(bx_mesh.vertices[0].normal.x == 1.0, "+X face normal");
  assert(bx_mesh.vertices[0].normal.y == 0.0, "+X face y");
  assert(bx_mesh.vertices[0].normal.z == 0.0, "+X face z");
  // Verts 4-7 are the -X face.
  assert(bx_mesh.vertices[4].normal.x == -1.0, "-X face normal");
  // Verts 8-11 are +Y (top).
  assert(bx_mesh.vertices[8].normal.y == 1.0, "+Y face normal");
}

fn test_emit_box_degenerate() {
  bx_mesh = mesh("box_deg");
  // max <= min on X → no geometry.
  emit_box(bx_mesh, vec3(1.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
  assert(len(bx_mesh.vertices) == 0, "degenerate X → no geometry");
  // max < min on Y.
  emit_box(bx_mesh, vec3(0.0, 5.0, 0.0), vec3(1.0, 1.0, 1.0));
  assert(len(bx_mesh.vertices) == 0, "degenerate Y → no geometry");
}

fn test_emit_item_placeholder_pillar_is_cylinder() {
  ip_mesh = mesh("ip_pillar");
  emit_item_placeholder(ip_mesh, "PILLAR", vec3(0.0, 0.0, 0.0), 1.0);
  // 8-segment cylinder = 32 verts + 16 tris.
  assert(len(ip_mesh.vertices) == 32, "pillar → 8-seg cylinder");
  assert(len(ip_mesh.triangles) == 16, "pillar tris");
}

fn test_emit_item_placeholder_tree_is_cylinder() {
  ip_mesh = mesh("ip_tree");
  emit_item_placeholder(ip_mesh, "TREE", vec3(5.0, 0.0, 5.0), 1.5);
  assert(len(ip_mesh.vertices) == 32, "tree → 8-seg cylinder");
}

fn test_emit_item_placeholder_container_is_box() {
  ip_mesh = mesh("ip_box");
  emit_item_placeholder(ip_mesh, "CONTAINER", vec3(0.0, 0.0, 0.0), 1.0);
  // Box = 24 verts + 12 tris.
  assert(len(ip_mesh.vertices) == 24, "container → box");
  assert(len(ip_mesh.triangles) == 12, "container tris");
}

fn test_emit_item_placeholder_zero_scale() {
  ip_mesh = mesh("ip_zero");
  emit_item_placeholder(ip_mesh, "PILLAR", vec3(0.0, 0.0, 0.0), 0.0);
  assert(len(ip_mesh.vertices) == 0, "zero scale → no geometry");
}
