// THE PROJECTION — a hex lattice position seen as a point in a 3-D world.
//
// Plan 19 `L3′`. This package holds exactly three facts, and none of them is the
// lattice:
//
//   1. how far one height unit is in world units  (`HEIGHT_SCALE`)
//   2. which axis is up                            (`+Y`, and hex_grid's plane `y`
//                                                   IS our world `z`)
//   3. which way the corner ring is numbered here  (`proj_corner_offset`)
//
// ⚠ **THE LATTICE IS NOT HERE AND MUST NEVER COME HERE.** `hex_grid` owns
// axial↔pixel, the parity of the odd-row shift, the neighbour table and the corner
// table, for the whole `hex_*` family. Everything below CALLS it. A second copy of
// any of that is the bug this family already paid for five times — `STATE.md`
// lesson `E`: right for non-negative coordinates, wrong below zero or on odd rows.
//
// ── ⚠ WHY THIS PACKAGE EXISTS AT ALL, WHICH IS A CORRECTION ──────────────────
//
// Plan 19's design called these *"three lattice calls"* and proposed replacing them
// with `hex_grid::px_to_hex` / `hex_to_px` / `hex_corner_px`. **Measured, that was
// wrong**, and wrong in the most expensive way this tree knows:
//
//   · `hex_to_world` ALREADY calls `hex_grid::hex_to_px`. What it adds is the
//     height axis, and nothing else.
//   · the corner ring here is numbered the OTHER WAY from `hex_grid`'s, so index
//     `i` is its `(6 - i) % 6` — and callers compensate for that a second time at
//     the call site.
//
// So a substitution would have **rotated every corner and dropped every height,
// with every count still agreeing**. The projection is a real thing that has to
// live somewhere; it is here.
use hex_grid;
use graphics;

// ── The height axis ──────────────────────────────────────────────────────────
//
// One height unit in world units. ⚠ THE ONE NUMBER THAT CANNOT BE DERIVED from
// `hex_grid`, which is entirely 2-D by design — and the reason a package is
// needed rather than a call. It had 83 uses in the editor alone when this was
// measured, so it is also the value least able to afford a second home.
pub HEIGHT_SCALE = 0.25;

// ── A hex, projected ─────────────────────────────────────────────────────────
//
// Hex `(q, r)` at integer `height`, as a world-space centre.
//
// ⚠ THE PARITY IS `hex_grid`'s, AND THAT IS LOAD-BEARING. This used to compute
// the odd-row shift with `(r % 2)`, which is `-1` for a negative odd `r` in loft
// where `(r & 1)` is `1` — so every negative odd row sat a full hex step (√3) west
// of where it belonged. `hex_grid` is correct for both signs; the test below pins
// us to it rather than re-checking the arithmetic.
pub fn hex_to_world(q: integer, r: integer, height: integer) -> Vec3 {
  (htw_x, htw_z) = hex_to_px(q, r);
  vec3(htw_x, height as float * HEIGHT_SCALE, htw_z)
}

// The 6 corner offsets of a POINTY-TOP unit hex, in THIS family's index order —
// a vertex at top and bottom, flat edges left and right:
//
//   corner 0: (0, +1)         top           corner 3: (0, -1)         bottom
//   corner 1: (+√3/2, +0.5)   top-right     corner 4: (-√3/2, -0.5)   bottom-left
//   corner 2: (+√3/2, -0.5)   bottom-right  corner 5: (-√3/2, +0.5)   top-left
//
// ⚠ `hex_grid` HOLDS THE SAME SIX CORNERS AND WALKS THE RING THE OTHER WAY, so
// this index `i` is its `(6 - i) % 6`. The values COME FROM `hex_grid` with that
// map applied — there is no second table — and applying it **here** is what keeps
// every caller's indices intact: wall emission reads corners 5→0, 0→1, 1→2 and
// still lands on the same three edges it always did.
//
// ⚠ IT IS `pub` BECAUSE `moros_render::emit_hex_surface` NEEDS IT. It was private
// while the code lived beside its only two callers; splitting the package makes
// one of them external, and a re-derived copy on the other side would be the
// second table this comment exists to prevent.
pub fn proj_corner_offset(i: integer) -> Vec2 {
  (pco_x, pco_y) = hex_corner_offset((6 - i) % 6);
  vec2(pco_x, pco_y)
}

// World-space position of hex corner `ci` (0–5) of hex `(q, r)` at `height`.
//
// ⚠ THE HEIGHT DOES NOT CHANGE ACROSS A HEX HERE — the corner sits at the
// centre's `y`. A sloped cell interpolates its own four corners and is the
// caller's geometry, not this package's; `hex_mesh::corner_heights` is where that
// lives. Doing it here would put a terrain rule inside a coordinate transform.
pub fn hex_corner_world(q: integer, r: integer, height: integer, ci: integer) -> Vec3 {
  hcw_centre = hex_to_world(q, r, height);
  hcw_off = proj_corner_offset(ci);
  vec3(hcw_centre.x + hcw_off.x, hcw_centre.y, hcw_centre.z + hcw_off.y)
}

// ── THE PRIMITIVES A DRAWING NEEDS — plan 22 `B1b.2c` ────────────────────────
//
// A hex surface, a box, a cylinder post and an item placeholder. They were
// `moros_render`'s, and they are here because BOTH sides of the split need them:
// Moros's map renderer draws markers and thick walls out of them, and lavition's
// props mesher — on its way out of the editor server so a page can draw the nine
// surfaces — calls all five.
//
// ⛔ AND THIS IS THE SECOND HOME THEY WERE GIVEN, WHICH IS THE FINDING. `B1b.2c.1`
// put them in `hex_mesh`, on the measurement that the editor was their only
// consumer — a grep that had EXCLUDED `moros_render`'s own source, so it could not
// see that all five have internal users there (`emit_marker`, `emit_to_material`,
// `emit_thick_flat_wall`, `emit_thick_curved_wall`, `emit_hex_item`). Deleting them
// was refused by the compiler, and the alternative — a copy on each side of the
// arrow — is the duplication this tree exists not to have.
//
// ⚠ SO THE HOME IS THE PACKAGE BOTH SIDES ALREADY DEPEND ON. `hex_proj` is the
// projection leaf: `hex_grid` and `graphics` and nothing else, which is exactly the
// cone these five need (`hex_to_world` and `proj_corner_offset` are its own,
// `HEX_LEN` is `hex_grid`'s, `vertex`/`Triangle` are `graphics`'). `moros_render`
// and `hex_mesh` both already declare it, so nothing gains a dependency and no
// arrow is pointed backwards.
//
// ⚠ `HEX_WIDTH` IS `HEX_LEN` AND IS NOT COPIED. `moros_render` declares
// `HEX_WIDTH = HEX_LEN` — a Moros name for a `hex_grid` constant — and carrying the
// alias would carry the reason plan 19 exists.

pub fn emit_hex_surface(m: Mesh, q: integer, r: integer, height: integer) -> integer {
  centre = hex_to_world(q, r, height);
  up = vec3(0.0, 1.0, 0.0);   // flat surface normal
  base = len(m.vertices);
  // Centre vertex
  m.vertices += [vertex(centre, up, vec2(0.5, 0.5))];
  // 6 corner vertices
  for ci in 0..6 {
    off = proj_corner_offset(ci);
    pos = vec3(centre.x + off.x, centre.y, centre.z + off.y);
    u = (off.x / HEX_LEN) + 0.5;
    v = (off.y / 1.0) * 0.5 + 0.5;
    m.vertices += [vertex(pos, up, vec2(u, v))];
  }
  // 6 triangles: fan from centre to each edge
  for ti in 0..6 {
    next = (ti + 1) % 6;
    tri = Triangle { a: base, b: base + 1 + ti, c: base + 1 + next };
    m.triangles += [tri];
  }
  base
}

// ── Hex neighbour helpers ─────────────────────────────────────────

// Neighbours come from `hex_grid`, which owns the lattice for the whole hex_*
// family.  The table that used to live here took only `dir` and so could not be
// parity-aware, while `hex_to_world` above staggers odd rows — the two disagreed.
// It cost one unreachable neighbour and one direction pointing two hexes out, in
// each parity; see tools/probes/neighbour_parity.py.  `hex_neighbor(q, r, dir)`
// takes `r` precisely because odd-r diagonals depend on it.

// ── Box primitive (Phase 6a.12 prereq) ────────────────────────────

// Emit a single face of a box: 4 outward vertices a → b → c → d
// (CCW from outside) with shared flat normal `n`.  4 verts + 2
// triangles.
// ⚠ PUBLIC, WHERE IT WAS PRIVATE. `moros_render`'s thick walls emit single faces
// and used to reach it as a package-local helper; across a package boundary that
// is a `pub` or a second implementation, and a second implementation of a quad is
// how two renderers come to disagree about a winding.
pub fn emit_box_face(m: Mesh, a: Vec3, b: Vec3, c: Vec3, d: Vec3, n: Vec3) {
  bf_base = len(m.vertices);
  m.vertices += [vertex(a, n, vec2(0.0, 0.0))];
  m.vertices += [vertex(b, n, vec2(1.0, 0.0))];
  m.vertices += [vertex(c, n, vec2(1.0, 1.0))];
  m.vertices += [vertex(d, n, vec2(0.0, 1.0))];
  m.triangles += [Triangle { a: bf_base, b: bf_base + 1, c: bf_base + 2 }];
  m.triangles += [Triangle { a: bf_base, b: bf_base + 2, c: bf_base + 3 }];
}

// Emit an axis-aligned rectangular box between `min_corner` and
// `max_corner`.  6 faces (flat-shaded, outward normals), 24 verts
// + 12 triangles total.  Degenerate inputs (any axis where max <=
// min) emit nothing.
pub fn emit_box(m: Mesh, min_corner: Vec3, max_corner: Vec3) {
  bx0 = min_corner.x; by0 = min_corner.y; bz0 = min_corner.z;
  bx1 = max_corner.x; by1 = max_corner.y; bz1 = max_corner.z;
  if bx1 <= bx0 || by1 <= by0 || bz1 <= bz0 { return; }
  // +X face
  emit_box_face(m,
    vec3(bx1, by0, bz1), vec3(bx1, by0, bz0),
    vec3(bx1, by1, bz0), vec3(bx1, by1, bz1),
    vec3(1.0, 0.0, 0.0));
  // -X face
  emit_box_face(m,
    vec3(bx0, by0, bz0), vec3(bx0, by0, bz1),
    vec3(bx0, by1, bz1), vec3(bx0, by1, bz0),
    vec3(-1.0, 0.0, 0.0));
  // +Y face (top)
  emit_box_face(m,
    vec3(bx0, by1, bz1), vec3(bx1, by1, bz1),
    vec3(bx1, by1, bz0), vec3(bx0, by1, bz0),
    vec3(0.0, 1.0, 0.0));
  // -Y face (bottom)
  emit_box_face(m,
    vec3(bx0, by0, bz0), vec3(bx1, by0, bz0),
    vec3(bx1, by0, bz1), vec3(bx0, by0, bz1),
    vec3(0.0, -1.0, 0.0));
  // +Z face (front)
  emit_box_face(m,
    vec3(bx0, by0, bz1), vec3(bx1, by0, bz1),
    vec3(bx1, by1, bz1), vec3(bx0, by1, bz1),
    vec3(0.0, 0.0, 1.0));
  // -Z face (back)
  emit_box_face(m,
    vec3(bx1, by0, bz0), vec3(bx0, by0, bz0),
    vec3(bx0, by1, bz0), vec3(bx1, by1, bz0),
    vec3(0.0, 0.0, -1.0));
}


// Emit a placeholder mesh for a map item at `pos` with nominal
// `scale` (typical: 1.0 = one hex width).  Dispatches on
// `kind_name` (values from ItemDef.id_kind): tall cylindrical
// shapes for PILLAR / TREE, box for everything else.  Geometry is
// cheap / illustrative — the real assets are baked by the artist
// pipeline.  Non-positive scale is a no-op.
pub fn emit_item_placeholder(m: Mesh, kind_name: text, pos: Vec3, scale: float) {
  if scale <= 0.0 { return; }
  if kind_name == "PILLAR" || kind_name == "TREE" {
    cyl_top = vec3(pos.x, pos.y + scale * 2.0, pos.z);
    emit_cylinder_post(m, pos, cyl_top, scale * 0.3, 8);
    return;
  }
  bp_half = scale / 2.0;
  bp_min = vec3(pos.x - bp_half, pos.y, pos.z - bp_half);
  bp_max = vec3(pos.x + bp_half, pos.y + scale, pos.z + bp_half);
  emit_box(m, bp_min, bp_max);
}

// ── Cylinder post (Phase 6a.8) ────────────────────────────────────

// Emit a cylindrical post between `base` and `top` with `radius`
// and `seg_count` angular segments around the Y-axis.  Assumes the
// axis is vertical (base.y < top.y).  Only the side surface is
// emitted — no top/bottom caps.  Vertex normals are the outward
// radial (smooth shading); per-segment quad winding puts the normal
// outward.  Each segment contributes 4 vertices + 2 triangles.
//
// Degenerate inputs (seg_count < 3 or radius <= 0) emit nothing.
pub fn emit_cylinder_post(
  m: Mesh, base: Vec3, top: Vec3, radius: float, seg_count: integer
) {
  if seg_count < 3 { return; }
  if radius <= 0.0 { return; }
  // THE RING IS PERPENDICULAR TO THE AXIS — whatever the axis is.
  //
  // This takes two endpoints, which promises an arbitrary axis, and for a long
  // time it built the ring in the XZ plane regardless. That is right for a
  // POST and for nothing else: the cart's wheel rides a Z axle, so it came out
  // as a flat ring lying on the ground (moros#14), and no test saw it because
  // every caller and every test passed a vertical axis.
  //
  // The basis below is chosen so a +Y axis gives back exactly `(cos, 0, sin)`,
  // which is what keeps every fence post and tree trunk vertex-for-vertex
  // unchanged while a wheel finally stands up.
  cp_dx = top.x - base.x;
  cp_dy = top.y - base.y;
  cp_dz = top.z - base.z;
  cp_dl = sqrt(cp_dx * cp_dx + cp_dy * cp_dy + cp_dz * cp_dz) ?? 0.0;
  if cp_dl <= 0.0 { return; }          // no axis, no cylinder — refuse, don't guess
  cp_ux = cp_dx / cp_dl ?? 0.0;
  cp_uy = cp_dy / cp_dl ?? 0.0;
  cp_uz = cp_dz / cp_dl ?? 0.0;
  // A reference the axis is never parallel to, so the cross product below
  // cannot collapse. +Z unless the axis is itself near ±Z.
  cp_rx = 0.0;
  cp_ry = 0.0;
  cp_rz = 1.0;
  if cp_uz < 0.0 - 0.9 || cp_uz > 0.9 { cp_rx = 1.0; cp_rz = 0.0; }
  // u = axis × ref, then v = u × axis: an orthonormal pair spanning the plane
  // the ring lives in.
  cp_px = cp_uy * cp_rz - cp_uz * cp_ry;
  cp_py = cp_uz * cp_rx - cp_ux * cp_rz;
  cp_pz = cp_ux * cp_ry - cp_uy * cp_rx;
  cp_pl = sqrt(cp_px * cp_px + cp_py * cp_py + cp_pz * cp_pz) ?? 0.0;
  if cp_pl <= 0.0 { return; }
  cp_px = cp_px / cp_pl ?? 0.0;
  cp_py = cp_py / cp_pl ?? 0.0;
  cp_pz = cp_pz / cp_pl ?? 0.0;
  cp_qx = cp_py * cp_uz - cp_pz * cp_uy;
  cp_qy = cp_pz * cp_ux - cp_px * cp_uz;
  cp_qz = cp_px * cp_uy - cp_py * cp_ux;
  // `seg_count < 3` returned above.
  cp_seg = (2.0 * PI / seg_count as float) ?? 0.0;
  for cp_i in 0..seg_count {
    i_cp = cp_i as float;
    a0 = i_cp * cp_seg;
    a1 = (i_cp + 1.0) * cp_seg;
    cos0 = cos(a0);
    sin0 = sin(a0);
    cos1 = cos(a1);
    sin1 = sin(a1);
    n0 = vec3(cp_px * cos0 + cp_qx * sin0,
              cp_py * cos0 + cp_qy * sin0,
              cp_pz * cos0 + cp_qz * sin0);
    n1 = vec3(cp_px * cos1 + cp_qx * sin1,
              cp_py * cos1 + cp_qy * sin1,
              cp_pz * cos1 + cp_qz * sin1);
    cp_bl = vec3(base.x + radius * n0.x, base.y + radius * n0.y, base.z + radius * n0.z);
    cp_br = vec3(base.x + radius * n1.x, base.y + radius * n1.y, base.z + radius * n1.z);
    cp_tr = vec3(top.x + radius * n1.x, top.y + radius * n1.y, top.z + radius * n1.z);
    cp_tl = vec3(top.x + radius * n0.x, top.y + radius * n0.y, top.z + radius * n0.z);
    cp_base = len(m.vertices);
    m.vertices += [vertex(cp_bl, n0, vec2(0.0, 0.0))];
    m.vertices += [vertex(cp_br, n1, vec2(1.0, 0.0))];
    m.vertices += [vertex(cp_tr, n1, vec2(1.0, 1.0))];
    m.vertices += [vertex(cp_tl, n0, vec2(0.0, 1.0))];
    m.triangles += [Triangle { a: cp_base, b: cp_base + 1, c: cp_base + 2 }];
    m.triangles += [Triangle { a: cp_base, b: cp_base + 2, c: cp_base + 3 }];
  }
}
