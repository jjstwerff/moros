//
// THE PLAN VIEW — what the STORE holds, drawn flat, in a format a person opens.
//
// Plan 26 `B0`. [BLUEPRINT.md](../../../doc/claude/BLUEPRINT.md) §0: *the blueprint
// is an INSTRUMENT before it is a feature* — a plan view is the cheapest place to
// see what the libraries actually do. Four defects were found in the session that
// wrote that design, every one of them by reading source or writing a one-off
// probe, and every one of them a PICTURE here: a wall drawn twice, a six-sided
// outline over an eight-sided one, a recovered line that misses the drawn one by
// 15°, a wall that does not meet its neighbour.
//
// ⚠ IT DRAWS TWO THINGS AND SAYS WHICH IS WHICH — plan 26 `B1`. The FIELD is the
// cells and the wall bytes; the DESCRIPTION is what `hex_shape::wall_read_run`
// says those bytes mean, recovered through `hex_editor::wall_recover`. They are
// drawn in one frame and never merged, because the whole value of the picture is
// the gap between them: a chain that wanders reads back as whatever straight run
// its two ends describe, with `ok = true`, and the only way to SEE that is to put
// the answer on top of the marks it came from.
//
// ⚠ AND THE DESCRIPTION IS RECOVERED, NEVER READ FROM A SESSION. The authored run
// is not in a saved world at all (EDITOR_DEFECTS 5: the save carries the cells;
// the run record is not saved), which is what `FORMAL_CORE` §2.4.3 requires anyway
// — the field is the authority and a description is recovered from it for editing.
//
// ⚠ NO GEOMETRY IS DERIVED HERE. The corners are `hex_grid`'s pairs through
// `hex_proj`'s projection, the layer is `hex_editor::edge_layer`, the byte is
// `hex_editor::wall_of`, the colour is `surfaces()`. What this file owns is the
// SVG around them — and the coordinates it writes are the library's own floats,
// untransformed, because a picture that rescales its numbers cannot be compared
// against the library that produced them.
use graphics;
use hex_grid;
use hex_proj;
use hex_voxel;
use hex_editor;
use self::surfaces;

// A hex edge in the page frame. The page frame IS the world's x/z plane — see
// `plan_svg`'s `viewBox` — so these are `hex_corner_world`'s own numbers.
pub struct PlanSeg {
  ps_x1: float,
  ps_z1: float,
  ps_x2: float,
  ps_z2: float,
}

// Pixels per world unit. A hex is 2.0 world units tall, so a 13x13 window is
// about 620 px across — a picture that fits on a screen without being a thumbnail.
pub const PLAN_PX = 24.0;

// The margin round the drawn window, in world units. A stroke centred on the
// boundary is half outside it, and a clipped wall reads as a missing one.
pub const PLAN_MARGIN = 0.6;

// The lattice direction of one of the three edge slots a hex owns.
//
// ⚠ THE TABLE IS `hex_editor`'s, WRITTEN AT ITS OWN CONSTANTS: *"`SLOT_NW` —
// h_wall_nw — corners 5-0, lattice dir 4"*. It is spelled out rather than read
// from a shared vector because `hex_mesh` and `hex_editor` each hold one already
// (`slot_dir` in `chunk_mesh_props` and in `edges_around`) and a fourth copy that
// disagreed would be silent — so the test asserts this against the mesher's own
// three-call spelling instead.
fn slot_dir_of(slot: integer) -> integer {
  if slot == hex_editor::SLOT_NW { return 4; }
  if slot == hex_editor::SLOT_NE { return 5; }
  0
}

// Where slot `slot` of hex `(q, r)` is, as a segment in the page frame.
//
// ⚠ THE `(6 - c) % 6` IS NOT AN ADJUSTMENT, IT IS THE JOIN. `hex_grid` walks the
// corner ring one way and `hex_proj` indexes it the other — `proj_corner_offset`
// says so at its own definition — so a pair of corner INDICES from one has to be
// mapped before it reaches the other. Drop it and every edge lands on a different
// side of its cell, which still draws a plausible picture.
pub fn plan_slot_seg(q: integer, r: integer, slot: integer) -> PlanSeg {
  (pss_a, pss_b) = hex_grid::hex_edge_corners(slot_dir_of(slot));
  pss_p = hex_proj::hex_corner_world(q, r, 0, (6 - pss_a) % 6);
  pss_q = hex_proj::hex_corner_world(q, r, 0, (6 - pss_b) % 6);
  PlanSeg { ps_x1: pss_p.x, ps_z1: pss_p.z, ps_x2: pss_q.x, ps_z2: pss_q.z }
}

// Four decimals, which is 0.1 mm at this lattice's scale. Rounded rather than
// printed whole so a person can read the file; the precision it drops is below
// anything a picture or a comparison can mean.
fn fx(v: float) -> text {
  "{round(v * 10000.0) / 10000.0 ?? 0.0}"
}

fn byte_of(v: float) -> integer {
  bo_n = (v * 255.0) as integer;
  if bo_n < 0 { return 0; }
  if bo_n > 255 { return 255; }
  bo_n
}

fn rgb_of(r: float, g: float, b: float) -> text {
  "rgb({byte_of(r)},{byte_of(g)},{byte_of(b)})"
}

// The fill for a cell's material — the MESHER's own colour, so the plan and the
// picture the editor draws cannot disagree about what grass is.
//
// ⚠ AND `surface_for_mat` IS THE ONLY JOIN THAT MAY BE USED HERE. A cell's
// material and a wall's material are different numberings — `1` is grass on one
// axis and a wall on the other, which `surfaces()` says in its own comment — so
// asking this about an edge byte would return a confident wrong colour.
fn cell_fill(mat: integer) -> text {
  cf_i = surface_for_mat(mat);
  if cf_i < 0 { return "none"; }
  cf_s = surface_at(cf_i);
  rgb_of(cf_s.sf_r, cf_s.sf_g, cf_s.sf_b)
}

// ⚠ AN UNKNOWN EDGE MATERIAL IS LOUD ON PURPOSE. The three the editor writes have
// colours; anything else is magenta, because the whole point of an instrument is
// that what it cannot explain looks different from what it can. A fallback to
// `wall` here would be the confident hexagon in another costume.
fn edge_colour(mat: integer) -> text {
  if mat == hex_editor::WALL_MAT  { return "rgb(20,22,30)"; }
  if mat == hex_editor::DOOR_MAT  { return "rgb(214,124,30)"; }
  if mat == hex_editor::FENCE_MAT { return "rgb(60,140,70)"; }
  "rgb(230,0,190)"
}

fn edge_width(mat: integer) -> float {
  if mat == hex_editor::FENCE_MAT { return 0.06; }
  0.13
}

// ── ONE LEVEL'S PANEL, IN THE WORLD'S OWN FRAME ─────────────────────────────
//
// The window `[q0, q1) x [r0, r1)` at reference height `ref` (world units, the same
// number the walker's feet carry): one `<polygon>` per cell — every cell, so an empty
// one is visible as empty rather than absent — one `<line class='edge'>` per non-zero
// wall byte those cells own, and one `<line class='run'>` for the description if the
// reader gives one. Nothing else, and nothing outside the window.
//
// ⚠ **THERE IS NO OFFSET IN HERE, AND THAT IS `B2`'s INVARIANT.** A panel is drawn in
// the world's own frame and PLACED by a transform on the group that holds it, so the
// numbers in the file stay `hex_corner_world`'s answers however many levels are shown
// beside each other. BLUEPRINT §3.4: *"the offset must never reach the field"* — the
// weaker half of that is that it must not reach the GEOMETRY either, or every
// coordinate in the picture is a page position wearing a world position's clothes.
pub struct PlanPanel {
  pp_body:  text,        // the elements, unoffset
  pp_cells: integer,
  pp_marks: integer,
  pp_say:   text,        // the description verdict: `d<n> p<n>`, `refused (n)`, `none`
  pp_minx:  float,
  pp_maxx:  float,
  pp_minz:  float,
  pp_maxz:  float,
}

pub fn plan_panel(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
              ref: float) -> PlanPanel {
  cells = "";
  edges = "";
  minx = 0.0;
  maxx = 0.0;
  minz = 0.0;
  maxz = 0.0;
  have = false;
  ncell = 0;
  nedge = 0;
  for r in r0..r1 {
    for q in q0..q1 {
      // ⚠ ONE LAYER FOR THE CELL AND ITS EDGES ALIKE. `edge_layer` is what every
      // gesture writes through, so a plan view that took the ground for the fill
      // and the surface for the walls would draw a deck's fence over the yard
      // below it — which is the exact defect that function's comment records.
      li = hex_editor::edge_layer(w, q, r, ref);
      c = if li >= 0 { hex_voxel::world_cell(w, q, r, li) } else { hex_voxel::Hex {} };
      pts = "";
      for ci in 0..6 {
        p = hex_proj::hex_corner_world(q, r, 0, ci);
        if !have { minx = p.x; maxx = p.x; minz = p.z; maxz = p.z; have = true; }
        if p.x < minx { minx = p.x; }
        if p.x > maxx { maxx = p.x; }
        if p.z < minz { minz = p.z; }
        if p.z > maxz { maxz = p.z; }
        pts += "{fx(p.x)},{fx(p.z)} ";
      }
      mat = c.h_material as integer ?? 0;
      // ⚠ **THE HEIGHT IS ON THE CELL BECAUSE A LEVEL PICTURE IS UNREADABLE WITHOUT
      // IT** — plan 26 `B2`. A panel at `ref 3` draws the deck AND the lawn around it,
      // because `world_surface` answers *what would someone at this height be standing
      // on* and outside the deck that is still the ground. That answer is right and it
      // looks like grass on the first floor; `data-h` is what tells the two apart, and
      // it is the store's own number rather than a rule invented here.
      cells += "<polygon class='cell' data-q='{q}' data-r='{r}' data-mat='{mat}'"
             + " data-h='{c.h_height}'"
             + " points='{pts}' fill='{cell_fill(mat)}'"
             + " stroke='rgb(180,184,192)' stroke-width='0.012'/>\n";
      ncell = ncell + 1;
      for slot in 0..3 {
        emat = hex_editor::wall_of(w, q, r, slot_dir_of(slot), ref);
        if emat == 0 { continue; }
        s = plan_slot_seg(q, r, slot);
        edges += "<line class='edge' data-q='{q}' data-r='{r}' data-slot='{slot}'"
               + " data-mat='{emat}' x1='{fx(s.ps_x1)}' y1='{fx(s.ps_z1)}'"
               + " x2='{fx(s.ps_x2)}' y2='{fx(s.ps_z2)}'"
               + " stroke='{edge_colour(emat)}' stroke-width='{edge_width(emat)}'"
               + " stroke-linecap='round'/>\n";
        nedge = nedge + 1;
      }
    }
  }
  // ── THE DESCRIPTION — plan 26 `B1` ────────────────────────────────────────
  //
  // ⚠ ONE RUN PER WINDOW, BECAUSE THAT IS WHAT THE READER ANSWERS. `wall_read_run`
  // takes a rectangle and asks *what run do these marks describe*; a window holding
  // a closed loop or two separate walls is not a run and it refuses. So a house
  // draws NO description, and that is a fact about the reader worth seeing rather
  // than a gap to paper over — the caption says which of the two silences it is.
  rr = hex_editor::wall_recover(w, q0, r0, q1 - q0, r1 - r0, ref);
  runs = "";
  say = "none";
  if rr.rr_ok {
    say = "d{rr.rr_d} p{rr.rr_p}";
    runs = "<line class='run' data-d='{rr.rr_d}' data-p='{rr.rr_p}'"
         + " x1='{fx(rr.rr_x0)}' y1='{fx(rr.rr_z0)}'"
         + " x2='{fx(rr.rr_x1)}' y2='{fx(rr.rr_z1)}'"
         + " stroke='rgb(30,90,220)' stroke-width='0.05' stroke-dasharray='0.32 0.18'"
         + " stroke-linecap='round'/>\n";
  } else if nedge > 0 {
    // ⚠ THE TWO SILENCES ARE DIFFERENT AND MUST NOT READ ALIKE. `probe/l1` lost a
    // run to exactly this: `ends = 0` is *a closed loop* and *nothing there* in one
    // number, and it was read as the second.
    say = "refused ({nedge} marks)";
  }
  // An empty window still has a frame, so a caller that asked for nothing gets a
  // picture of nothing rather than a panel with a null size in it.
  if !have { minx = 0.0; maxx = 1.0; minz = 0.0; maxz = 1.0; }
  PlanPanel { pp_body: cells + edges + runs, pp_cells: ncell, pp_marks: nedge,
              pp_say: say, pp_minx: minx, pp_maxx: maxx, pp_minz: minz, pp_maxz: maxz }
}

// ── THE AUTHOR ON THE PLAN — plan 26 `B3`, BLUEPRINT §3.1 ──────────────────
//
// *"A character location on the map is still the running way … but this editor
// doesn't restrict the character anywhere."* A plan with nobody on it is a map; the
// pose is what makes it the editor's own view of where you are standing.
//
// ⚠ **IT TAKES AN `Author`, WHICH IS THE LIBRARY'S OWN ANSWER TO *WHERE IS THE
// PERSON*.** Not a `Walker` — that is walk STATE, and a plan does not care how fast
// anybody is going — and not four loose floats, which would be a second spelling of
// a struct every gesture already takes. `plan_author` is the one place this package
// reads `au_*`, so the pose has one shape here and one conversion.
//
// ⚠ AND `au_yaw` IS RADIANS, 0 = +x, which `gesture.loft` says at its own
// declaration and the tick confirms by walking `(cos yaw, sin yaw)`. The page frame
// IS the world's x/z plane, so the facing needs no sign flip and must not be given
// one — a facing drawn backwards is the one error in this picture that looks
// deliberate.
pub struct PlanWho {
  pw_show: boolean,
  pw_x:    float,
  pw_z:    float,
  pw_y:    float,
  pw_yaw:  float,
}

pub fn plan_nobody() -> PlanWho {
  PlanWho { pw_show: false, pw_x: 0.0, pw_z: 0.0, pw_y: 0.0, pw_yaw: 0.0 }
}

pub fn plan_author(a: hex_editor::Author) -> PlanWho {
  PlanWho { pw_show: true, pw_x: a.au_x, pw_z: a.au_z, pw_y: a.au_y, pw_yaw: a.au_yaw }
}

// How long the facing tick is, in world units — just past the marker, so the two
// read as one arrow rather than as a dot and a line.
pub const PLAN_FACING = 0.85;

// ── LEVELS, SIDE BY SIDE — plan 26 `B2`, BLUEPRINT §3.4 ─────────────────────
//
// *"Multiple floors have a layout beside each other."* One panel per reference
// height, each in its own `<g>` with the level on it and the placement in **one**
// `transform`.
//
// ⚠ **A LEVEL IS NOT A HEIGHT AND THE PAGE IS NOT THE WORLD**, which are two
// different things this design has to keep apart at once. `FORMAL_CORE` §2.4.3:
// *"the level is a discrete sheet index and nothing else"* — so `data-level` is the
// index, `data-ref` is the height it was read at, and neither is the other. And the
// page position is `data-dx`, declared once per group: ⚠ *"if it reaches the field,
// two floors of one house become two buildings a hex-step apart, and the stair
// between them stops being a stair."*
//
// ⚠ THE INVERSE IS WHY IT IS DECLARED RATHER THAN BAKED IN. Authoring on a plan needs
// page → cell, and a translation that lives in the coordinates cannot be undone by a
// reader that does not already know it. `hex_place::Pose` is the library's map for
// that when the gestures arrive; today the picture states the number it would need.
pub const PLAN_GUTTER = 1.2;

pub fn plan_levels(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
               refs: vector<float>, who: PlanWho, title: text) -> text {
  // ⚠ AN EMPTY LIST IS ONE LEVEL AT ZERO, NOT AN EMPTY PICTURE. A caller that asked
  // for no levels has made a mistake, and a blank frame hides it; the caption says
  // which reference every panel was read at, so the wrong one is visible.
  rs = refs;
  if len(rs) < 1 { rs = [0.0]; }
  // ⚠ **WHICH PANEL THE AUTHOR IS ON IS THE STORE'S ANSWER, NOT A THRESHOLD.** They
  // belong on the level whose reference selects the same LAYER under their own cell
  // as their own feet do — `edge_layer` asked twice and compared. A rule of the shape
  // *within half a storey of the reference* would be a number invented here, and
  // `FORMAL_CORE` is explicit that a level is not a height.
  (aq, ar) = px_to_hex(who.pw_x, who.pw_z);
  alayer = 0 - 2;
  if who.pw_show { alayer = hex_editor::edge_layer(w, aq, ar, who.pw_y); }
  inwin = who.pw_show && aq >= q0 && aq < q1 && ar >= r0 && ar < r1;
  seen = false;
  bodies = "";
  minx = 0.0;
  maxx = 1.0;
  minz = 0.0;
  maxz = 1.0;
  pitch = 0.0;
  totcell = 0;
  totmark = 0;
  verdicts = "";
  for k in 0..len(rs) {
    kref = rs[k] ?? 0.0;
    pan = plan_panel(w, q0, r0, q1, r1, kref);
    if k == 0 {
      minx = pan.pp_minx; maxx = pan.pp_maxx;
      minz = pan.pp_minz; maxz = pan.pp_maxz;
      pitch = maxx - minx + PLAN_MARGIN * 2.0 + PLAN_GUTTER;
    }
    dx = (k as float) * pitch;
    px = minx - PLAN_MARGIN;
    pz = minz - PLAN_MARGIN;
    pw = maxx - minx + PLAN_MARGIN * 2.0;
    ph = maxz - minz + PLAN_MARGIN * 2.0;
    // ⚠ THE MARKER IS IN THE PANEL'S OWN FRAME, so it is placed by the same group
    // transform as everything else and its `cx`/`cy` stay the author's own floats.
    mine = "";
    onme = "";
    if inwin && hex_editor::edge_layer(w, aq, ar, kref) == alayer && !seen {
      seen = true;
      onme = "  you";
      mine = "<circle class='author' data-x='{fx(who.pw_x)}' data-z='{fx(who.pw_z)}'"
           + " data-yaw='{fx(who.pw_yaw)}' cx='{fx(who.pw_x)}' cy='{fx(who.pw_z)}'"
           + " r='0.3' fill='rgb(220,40,40)' stroke='rgb(250,250,248)'"
           + " stroke-width='0.06'/>\n"
           + "<line class='facing' x1='{fx(who.pw_x)}' y1='{fx(who.pw_z)}'"
           + " x2='{fx(who.pw_x + cos(who.pw_yaw) * PLAN_FACING)}'"
           + " y2='{fx(who.pw_z + sin(who.pw_yaw) * PLAN_FACING)}'"
           + " stroke='rgb(220,40,40)' stroke-width='0.1' stroke-linecap='round'/>\n";
    }
    captext = "L{k}  ref {kref}  q {q0}..{q1}  r {r0}..{r1}  cells {pan.pp_cells}"
            + "  marks {pan.pp_marks}  run {pan.pp_say}{onme}";
    // ⚠ SIZED TO FIT, because a caption that runs off its panel is a caption whose
    // LAST field is the one you cannot read — and the last field is the run verdict,
    // the one thing a reader cannot infer from the drawing.
    capfs = pw / ((captext.size() as float) * 0.62) ?? 0.45;
    if capfs > 0.45 { capfs = 0.45; }
    bodies += "<g class='level' data-level='{k}' data-ref='{kref}' data-dx='{fx(dx)}'"
            + " transform='translate({fx(dx)} 0)'>\n"
            + "<rect x='{fx(px)}' y='{fx(pz)}' width='{fx(pw)}' height='{fx(ph)}'"
            + " fill='rgb(250,250,248)'/>\n"
            + pan.pp_body
            + mine
            + "<text x='{fx(px + 0.3)}' y='{fx(pz + ph - 0.3)}' font-size='{fx(capfs)}'"
            + " font-family='monospace' fill='rgb(70,74,82)'>{captext}</text>\n"
            + "</g>\n";
    totcell = totcell + pan.pp_cells;
    totmark = totmark + pan.pp_marks;
    verdicts += " L{k}={pan.pp_say}";
  }
  vx = minx - PLAN_MARGIN;
  vz = minz - PLAN_MARGIN;
  vw = (len(rs) as float) * pitch - PLAN_GUTTER;
  vh = maxz - minz + PLAN_MARGIN * 2.0;
  head = "<svg xmlns='http://www.w3.org/2000/svg'"
       + " viewBox='{fx(vx)} {fx(vz)} {fx(vw)} {fx(vh)}'"
       + " width='{round(vw * PLAN_PX) ?? 0.0}' height='{round(vh * PLAN_PX) ?? 0.0}'>\n"
       + "<rect x='{fx(vx)}' y='{fx(vz)}' width='{fx(vw)}' height='{fx(vh)}'"
       + " fill='rgb(226,228,232)'/>\n";
  // ⚠ THE COUNTS ARE IN A COMMENT, NOT IN AN ELEMENT, and they are for a person
  // reading the file. A gate must count the elements it can see — `CLAUDE.md`:
  // measure what was emitted, never a number the producer re-derives.
  // ⚠ THREE STATES, AND THEY MUST NOT READ ALIKE — the same rule the run verdict
  // obeys. *Nobody was given*, *somebody was given and is on this plan*, and
  // *somebody was given and is on none of these levels* are three different facts,
  // and an absent marker says all three at once.
  whosay = "none";
  if who.pw_show {
    whosay = "({fx(who.pw_x)},{fx(who.pw_z)}) y {fx(who.pw_y)}";
    if !seen { whosay += " OFF-PLAN"; }
  }
  foot = "<!-- plan: {title} q {q0}..{q1} r {r0}..{r1} levels {len(rs)}"
       + " pitch {fx(pitch)} cells {totcell} edges {totmark} run{verdicts}"
       + " who {whosay} -->\n</svg>\n";
  head + bodies + foot
}

// One level, which is what most callers want and what `B0` shipped.
pub fn plan_svg(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
                ref: float, title: text) -> text {
  plan_levels(w, q0, r0, q1, r1, [ref], plan_nobody(), title)
}
