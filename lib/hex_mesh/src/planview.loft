// SPDX-License-Identifier: LGPL-3.0-or-later
//
// THE PLAN VIEW — what the STORE holds, drawn flat, in a format a person opens.
//
// Plan 26 `B0`. [BLUEPRINT.md](../../../doc/claude/BLUEPRINT.md) §0: *the blueprint
// is an INSTRUMENT before it is a feature* — a plan view is the cheapest place to
// see what the libraries actually do. Four defects were found in the session that
// wrote that design, every one of them by reading source or writing a one-off
// probe, and every one of them a PICTURE here: a wall drawn twice, a six-sided
// outline over an eight-sided one, a recovered line that misses the drawn one by
// 15°, a wall that does not meet its neighbour.
//
// ⚠ IT DRAWS TWO THINGS AND SAYS WHICH IS WHICH — plan 26 `B1`. The FIELD is the
// cells and the wall bytes; the DESCRIPTION is what `hex_shape::wall_read_run`
// says those bytes mean, recovered through `hex_editor::wall_recover`. They are
// drawn in one frame and never merged, because the whole value of the picture is
// the gap between them: a chain that wanders reads back as whatever straight run
// its two ends describe, with `ok = true`, and the only way to SEE that is to put
// the answer on top of the marks it came from.
//
// ⚠ AND THE DESCRIPTION IS RECOVERED, NEVER READ FROM A SESSION. The authored run
// is not in a saved world at all (EDITOR_DEFECTS 5: the save carries the cells;
// the run record is not saved), which is what `FORMAL_CORE` §2.4.3 requires anyway
// — the field is the authority and a description is recovered from it for editing.
//
// ⚠ NO GEOMETRY IS DERIVED HERE. The corners are `hex_grid`'s pairs through
// `hex_proj`'s projection, the layer is `hex_editor::edge_layer`, the byte is
// `hex_editor::wall_of`, the colour is `surfaces()`. What this file owns is the
// SVG around them — and the coordinates it writes are the library's own floats,
// untransformed, because a picture that rescales its numbers cannot be compared
// against the library that produced them.
use graphics;
use hex_grid;
use hex_proj;
use hex_voxel;
use hex_editor;
use hex_roof;
// `Box` — plan 26 `B4n`. The rectangle a house's floor recovers to is the shape
// family's own, and the picture places its corners through `hex_editor::box_px_*`
// rather than deriving any of them here.
use hex_shape;
use self::surfaces;

// A hex edge in the page frame. The page frame IS the world's x/z plane — see
// `plan_svg`'s `viewBox` — so these are `hex_corner_world`'s own numbers.
pub struct PlanSeg {
  ps_x1: float,
  ps_z1: float,
  ps_x2: float,
  ps_z2: float,
}

// Pixels per world unit. A hex is 2.0 world units tall, so a 13x13 window is
// about 620 px across — a picture that fits on a screen without being a thumbnail.
pub const PLAN_PX = 24.0;

// The margin round the drawn window, in world units. A stroke centred on the
// boundary is half outside it, and a clipped wall reads as a missing one.
pub const PLAN_MARGIN = 0.6;

// The lattice direction of one of the three edge slots a hex owns.
//
// ⚠ THE TABLE IS `hex_editor`'s, WRITTEN AT ITS OWN CONSTANTS: *"`SLOT_NW` —
// h_wall_nw — corners 5-0, lattice dir 4"*. It is spelled out rather than read
// from a shared vector because `hex_mesh` and `hex_editor` each hold one already
// (`slot_dir` in `chunk_mesh_props` and in `edges_around`) and a fourth copy that
// disagreed would be silent — so the test asserts this against the mesher's own
// three-call spelling instead.
fn slot_dir_of(slot: integer) -> integer {
  if slot == hex_editor::SLOT_NW { return 4; }
  if slot == hex_editor::SLOT_NE { return 5; }
  0
}

// Where slot `slot` of hex `(q, r)` is, as a segment in the page frame.
//
// ⚠ THE `(6 - c) % 6` IS NOT AN ADJUSTMENT, IT IS THE JOIN. `hex_grid` walks the
// corner ring one way and `hex_proj` indexes it the other — `proj_corner_offset`
// says so at its own definition — so a pair of corner INDICES from one has to be
// mapped before it reaches the other. Drop it and every edge lands on a different
// side of its cell, which still draws a plausible picture.
pub fn plan_slot_seg(q: integer, r: integer, slot: integer) -> PlanSeg {
  (pss_a, pss_b) = hex_grid::hex_edge_corners(slot_dir_of(slot));
  pss_p = hex_proj::hex_corner_world(q, r, 0, (6 - pss_a) % 6);
  pss_q = hex_proj::hex_corner_world(q, r, 0, (6 - pss_b) % 6);
  PlanSeg { ps_x1: pss_p.x, ps_z1: pss_p.z, ps_x2: pss_q.x, ps_z2: pss_q.z }
}

// Four decimals, which is 0.1 mm at this lattice's scale. Rounded rather than
// printed whole so a person can read the file; the precision it drops is below
// anything a picture or a comparison can mean.
fn fx(v: float) -> text {
  "{round(v * 10000.0) / 10000.0 ?? 0.0}"
}

fn byte_of(v: float) -> integer {
  bo_n = (v * 255.0) as integer;
  if bo_n < 0 { return 0; }
  if bo_n > 255 { return 255; }
  bo_n
}

fn rgb_of(r: float, g: float, b: float) -> text {
  "rgb({byte_of(r)},{byte_of(g)},{byte_of(b)})"
}

// The fill for a cell's material — the MESHER's own colour, so the plan and the
// picture the editor draws cannot disagree about what grass is.
//
// ⚠ AND `surface_for_mat` IS THE ONLY JOIN THAT MAY BE USED HERE. A cell's
// material and a wall's material are different numberings — `1` is grass on one
// axis and a wall on the other, which `surfaces()` says in its own comment — so
// asking this about an edge byte would return a confident wrong colour.
fn cell_fill(mat: integer) -> text {
  cf_i = surface_for_mat(mat);
  if cf_i < 0 { return "none"; }
  cf_s = surface_at(cf_i);
  rgb_of(cf_s.sf_r, cf_s.sf_g, cf_s.sf_b)
}

// ⚠ AN UNEXPLAINED EDGE MATERIAL IS LOUD ON PURPOSE. The three the editor writes have
// colours; anything else is magenta, because the whole point of an instrument is
// that what it cannot explain looks different from what it can. A fallback to
// `wall` here would be the confident hexagon in another costume.
//
// ⚠ **AND `declared` IS WHAT MOVED AT PLAN 26 `B4e`, WHICH IS NOT A LOOSENING.** An
// edge byte is a palette slot, so a world may declare slot 5 to be masonry and stamp
// it — `edge_is_wall` says so everywhere the store is *acted* on, and a picture that
// went on shouting at it would be shouting at the feature. What still gets the magenta
// is a byte **nothing explains**: stamped, and declared nowhere. The rule the § opened
// with is unchanged and its subject is sharper — *undeclared*, not *unnamed*.
fn edge_colour(mat: integer, declared: boolean) -> text {
  if mat == hex_editor::WALL_MAT  { return "rgb(20,22,30)"; }
  if mat == hex_editor::DOOR_MAT  { return "rgb(214,124,30)"; }
  if mat == hex_editor::FENCE_MAT { return "rgb(60,140,70)"; }
  if declared && hex_editor::edge_is_wall(mat) { return "rgb(20,22,30)"; }
  "rgb(230,0,190)"
}

fn edge_width(mat: integer) -> float {
  if mat == hex_editor::FENCE_MAT { return 0.06; }
  0.13
}

// ── ONE LEVEL'S PANEL, IN THE WORLD'S OWN FRAME ─────────────────────────────
//
// The window `[q0, q1) x [r0, r1)` at reference height `ref` (world units, the same
// number the walker's feet carry): one `<polygon>` per cell — every cell, so an empty
// one is visible as empty rather than absent — one `<line class='edge'>` per non-zero
// wall byte those cells own, and one `<line class='run'>` for the description if the
// reader gives one. Nothing else, and nothing outside the window.
//
// ⚠ **THERE IS NO OFFSET IN HERE, AND THAT IS `B2`'s INVARIANT.** A panel is drawn in
// the world's own frame and PLACED by a transform on the group that holds it, so the
// numbers in the file stay `hex_corner_world`'s answers however many levels are shown
// beside each other. BLUEPRINT §3.4: *"the offset must never reach the field"* — the
// weaker half of that is that it must not reach the GEOMETRY either, or every
// coordinate in the picture is a page position wearing a world position's clothes.
// ── THE PANEL'S OWN FRAME, WITHOUT DRAWING IT — plan 26 `B4a` ───────────────
//
// The window's bounds in world units, swept from the same corners the cells are drawn
// from. ⚠ **IT EXISTS SO THERE IS ONE DERIVATION OF THE FRAME AND NOT TWO.** The
// inverse map — page position back to a cell — needs the pitch and the origin the
// drawing used, and a second copy of that arithmetic would be wrong in exactly the way
// nobody notices: the picture and the pick would disagree by a margin, and every
// authored thing would land one cell out near an edge.
pub struct PlanBox {
  pb_minx: float,
  pb_maxx: float,
  pb_minz: float,
  pb_maxz: float,
}

pub fn plan_bounds(q0: integer, r0: integer, q1: integer, r1: integer) -> PlanBox {
  bminx = 0.0;
  bmaxx = 1.0;
  bminz = 0.0;
  bmaxz = 1.0;
  bhave = false;
  for r in r0..r1 {
    for q in q0..q1 {
      for ci in 0..6 {
        bp = hex_proj::hex_corner_world(q, r, 0, ci);
        if !bhave { bminx = bp.x; bmaxx = bp.x; bminz = bp.z; bmaxz = bp.z; bhave = true; }
        if bp.x < bminx { bminx = bp.x; }
        if bp.x > bmaxx { bmaxx = bp.x; }
        if bp.z < bminz { bminz = bp.z; }
        if bp.z > bmaxz { bmaxz = bp.z; }
      }
    }
  }
  PlanBox { pb_minx: bminx, pb_maxx: bmaxx, pb_minz: bminz, pb_maxz: bmaxz }
}

// The width of one panel's paper, and the step from one panel to the next.
pub fn plan_paper_w(b: PlanBox) -> float { b.pb_maxx - b.pb_minx + PLAN_MARGIN * 2.0 }
pub fn plan_paper_h(b: PlanBox) -> float { b.pb_maxz - b.pb_minz + PLAN_MARGIN * 2.0 }
pub fn plan_pitch(b: PlanBox) -> float { plan_paper_w(b) + PLAN_GUTTER }

pub struct PlanPanel {
  pp_body:  text,        // the elements, unoffset
  pp_cells: integer,
  pp_marks: integer,
  pp_say:   text,        // the description verdict: `d<n> p<n>`, `refused (n)`, `none`
  pp_bad:   integer,     // marks whose palette declares a type this reader refused
  pp_minx:  float,
  pp_maxx:  float,
  pp_minz:  float,
  pp_maxz:  float,
}

// A cell's outline as an SVG `points` list, in world units. ⚠ ONE DERIVATION, because
// `B4c` draws the SAME outline again to show which cell a pick landed on — and a
// highlight built from its own copy of the corner walk could sit a hair off the cell it
// claims to be highlighting, which is the one error in that feature nobody would see.
fn cell_points(q: integer, r: integer) -> text {
  cp_s = "";
  for ci in 0..6 {
    cp_p = hex_proj::hex_corner_world(q, r, 0, ci);
    cp_s += "{fx(cp_p.x)},{fx(cp_p.z)} ";
  }
  cp_s
}

// ── THE DESCRIPTION, AND WHICH READER GIVES IT — plan 26 `B1` … `B4p` ──────
//
// ⚠ **ONE RUN PER WINDOW, BECAUSE THAT IS WHAT THE READER ANSWERS.**
// `wall_read_run` takes a rectangle and asks *what run do these marks describe*; a
// window holding a closed loop or two separate walls is not a run and it refuses.
// So a house draws no run, and that is a fact about the reader worth seeing rather
// than a gap to paper over — the caption says which of the silences it is.
//
// ⚠ **THE ORDER IS NOT A PREFERENCE, IT IS WHAT KEEPS THE READERS APART** — plan 26
// `B4h`. `wall_read_run` refuses a closed loop by construction (*"`ends = 0` is a
// closed loop"*), so a rim can never be a run and a run can never be a disc. Asking
// a round reader only where the run reader gave up means no two of them can answer
// for one window, and it costs nothing on a window that already had an answer.
//
// ⚠ **AND WHICH ROUND READER? THE PALETTE SAYS** — plan 26 `B4m`, BLUEPRINT §2.5:
// *an octagon tower is never deduced; it is stored*. A shape read out of GEOMETRY
// gets `rebuild_construct`'s confident hexagon — `sides = 6`, nothing unexplained,
// no warning — so *which* reader is asked is a palette question and only *which
// centre and which shell* is a field question. A body this tree does not know, and a
// window whose marks disagree about the body, both fall through to the round reader,
// because the vocabulary is open and a picture is not where a palette is debugged.
//
// ⚠ **`skip` DECIDES WHOSE MARKS AND NOTHING ELSE — plan 26 `B4p`.** The same chain
// is asked of a whole window and of what one rectangle does not own, so `B4o`'s
// second asking stops being a hand-written excerpt of the first. That excerpt was
// the run reader alone, and it is why a tower standing beside a house was reported
// as `+ 54 unexplained`.
// ⚠ **AND IT CARRIES WHAT IT OWNS — plan 26 `B4s`.** A peel subtracts each description
// before asking the next question, and *what does this shape own* is the shape's own
// membership: a disc's boundary walk, an octagon's `poly_holds`, a rectangle's
// `house_owns`, and for a run `run_edges` — which `B4q` made askable and `B4r` made
// stable. So the parameters travel with the answer rather than being re-derived from
// the caption, which would be a second reading of a number this already has.
pub struct PlanDesc {
  pd_ok:   boolean,
  pd_kind: text,        // `run` · `disc` · `octagon` · `house`
  pd_args: text,        // …and its parameters, in the caption's own words
  pd_svg:  text,
  pd_stop: boolean,     // the palette NAMED the octagon reader, and it refused
  // ⚠ **THE READER'S OWN RESIDUAL, NOT A SECOND MEASUREMENT — plan 26 `B4v`.** *Were you
  // handed marks you do not want?* is what decides whether a set of shapes is worth
  // trying, and every reader already answers it: `rr_stray` for a run, `hs_other` for a
  // house, and **false by construction** for the round pair, whose fit is an equality
  // over the whole component. ⛔ Asking it by CLAIMING into a copy instead — the obvious
  // way — costs a window-sized copy per component per round, on the path every clean
  // picture takes.
  pd_short: boolean,
  pd_cq:    integer,    // a disc's or an octagon's centre, and a house's anchor
  pd_cr:    integer,
  pd_shell: integer,
  // ⚠ **A REGION'S CLAIM CANNOT BE REBUILT FROM PARAMETERS — plan 26 `B5`.** Every other
  // kind is a shape with a handful of numbers; an arbitrary form is a cell set, so the set
  // travels with the description and `plan_claim` claims from it.
  pd_cells: HexSet = hexset_chunk(0, 0, 1, 1),
  pd_wid:   integer,    // …a house's extent and orbit
  pd_dep:   integer,
  pd_rot:   integer,
  pd_x0:    float,      // …and a run's two ends
  pd_z0:    float,
  pd_x1:    float,
  pd_z1:    float,
}

// ⚠ **A REFUSAL CARRIES WHETHER THE PALETTE HAD ALREADY CHOSEN.** The readers below
// are ordered so that no two answer for one window; `pd_stop` is that same rule where
// the choosing was a DECLARATION rather than a shape. A world whose marks all say
// `THICK_OCT` has named its reader, so an octagon that refuses is the answer — asking
// the house reader afterwards would let a declaration be overruled by a search.
fn desc_no(stop: boolean) -> PlanDesc {
  PlanDesc { pd_ok: false, pd_kind: "", pd_args: "", pd_svg: "", pd_stop: stop,
             pd_short: false,
             pd_cq: 0, pd_cr: 0, pd_shell: 0, pd_wid: 0, pd_dep: 0, pd_rot: 0,
             pd_x0: 0.0, pd_z0: 0.0, pd_x1: 0.0, pd_z1: 0.0 }
}

// The caption's words for one description.
//
// ⛔ **A RUN SPELLS ITS NOUN WHEREVER IT STANDS — plan 26 `B4t`, AND IT DID NOT.** From
// `B1` to `B4s` the FIRST description dropped it, because `desc ` already implied the
// noun and a window held one run or none. Segmentation visits the components in the
// window's own scan order, so which kind comes first is now a fact about where things
// STAND — and a caption whose grammar depends on that cannot be read, or asserted,
// without knowing the layout. ⚠ The old form is what every `desc d0 p5` in this tree's
// tests was written against; they say `desc run d0 p5` now.
fn desc_phrase(kind: text, args: text) -> text { "{kind} {args}" }

// ⚠ **THE FOUR DESCRIPTIONS SHARE ONE STROKE, AND DELIBERATELY SO.** All of them
// are the DESCRIPTION drawn over the field it was recovered from; a second colour
// would say *this is a different kind of thing* when the only difference is which
// reader could explain the marks.
const DESC_INK = "rgb(30,90,220)";

// What this description accounts for, taken out of the field so the next question is
// about something else — plan 26 `B4s`. Returns how many claims were NEW.
//
// ⛔ **A READER THAT ANSWERS WITHOUT CLAIMING ANYTHING IS A LOOP**, and the peel checks
// that rather than trusting it: every shape here has a membership that must overlap the
// marks it was recovered from, so a zero means the chain has answered about a field it
// does not account for and the picture must stop rather than say it again.
fn plan_claim(d: PlanDesc, cl: Claims, q0: integer, r0: integer, q1: integer,
              r1: integer) -> integer {
  wq = q1 - q0;
  hr = r1 - r0;
  if d.pd_kind == "run" {
    return hex_editor::claim_run(cl, d.pd_x0, d.pd_z0, d.pd_x1, d.pd_z1,
                                 q0, r0, wq, hr);
  }
  if d.pd_kind == "disc" {
    return hex_editor::claim_disc(cl, d.pd_cq, d.pd_cr, d.pd_shell, q0, r0, wq, hr);
  }
  if d.pd_kind == "octagon" {
    return hex_editor::claim_oct(cl, d.pd_cq, d.pd_cr, d.pd_shell, q0, r0, wq, hr);
  }
  if d.pd_kind == "house" {
    return hex_editor::claim_house(cl, hex_shape::box_new(d.pd_cq, d.pd_cr, d.pd_wid,
                                                          d.pd_dep, d.pd_rot, false),
                                   q0, r0, wq, hr);
  }
  if d.pd_kind == "region" {
    return hex_editor::claim_region(cl, d.pd_cells, q0, r0, wq, hr);
  }
  0
}

// ── WHAT EACH ANSWER LOOKS LIKE, ONCE — plan 26 `B4v` ─────────────────────
//
// ⚠ **LIFTED OUT OF `plan_describe` UNCHANGED, BECAUSE THERE ARE TWO CHAINS NOW.** The
// strict chain and `B4v`'s relaxed one ask different questions of the same readers and
// must draw the same picture from the same answer; a second copy of these would be free
// to disagree about a caption or a `data-` attribute, which is the divergence
// `edges_mat_outside`'s own comment is written against.
fn desc_of_run(rr: hex_editor::RunRead) -> PlanDesc {
  rsay = "d{rr.rr_d} p{rr.rr_p}";
  if rr.rr_missing > 0 { rsay = rsay + " · {rr.rr_missing} missing"; }
  PlanDesc { pd_ok: true, pd_kind: "run",
    pd_args: rsay,
    pd_svg: "<line class='run' data-d='{rr.rr_d}' data-p='{rr.rr_p}'"
          + " data-marks='{rr.rr_marks}' data-stray='{rr.rr_stray}'"
          + " data-missing='{rr.rr_missing}'"
          + " x1='{fx(rr.rr_x0)}' y1='{fx(rr.rr_z0)}'"
          + " x2='{fx(rr.rr_x1)}' y2='{fx(rr.rr_z1)}'"
          + " stroke='{DESC_INK}' stroke-width='0.05'"
          + " stroke-dasharray='0.32 0.18' stroke-linecap='round'/>\n",
    pd_stop: false, pd_short: rr.rr_stray > 0,
    pd_cq: 0, pd_cr: 0, pd_shell: 0, pd_wid: 0, pd_dep: 0, pd_rot: 0,
    pd_x0: rr.rr_x0, pd_z0: rr.rr_z0, pd_x1: rr.rr_x1, pd_z1: rr.rr_z1 }
}

fn desc_of_oct(ot: hex_editor::OctRead) -> PlanDesc {
  // ⚠ **THE CORNERS ARE `hex_editor`'s** — `oct_px_x`/`oct_px_z` — because a picture
  // placing eight of its own would be a second definition of the shape, agreeing with
  // the gesture only by having no reason to differ.
  ox = hex_editor::oct_px_x(ot.ot_cq, ot.ot_cr, ot.ot_shell);
  oz = hex_editor::oct_px_z(ot.ot_cq, ot.ot_cr, ot.ot_shell);
  opts = "";
  for oi in 0..len(ox) { opts = opts + "{fx(ox[oi] ?? 0.0)},{fx(oz[oi] ?? 0.0)} "; }
  PlanDesc { pd_ok: true, pd_kind: "octagon",
    pd_args: "{ot.ot_cq},{ot.ot_cr} shell {ot.ot_shell}",
    pd_svg: "<polygon class='oct' data-cq='{ot.ot_cq}' data-cr='{ot.ot_cr}'"
          + " data-shell='{ot.ot_shell}' data-marks='{ot.ot_marks}'"
          + " points='{opts}' fill='none' stroke='{DESC_INK}'"
          + " stroke-width='0.05' stroke-dasharray='0.32 0.18'/>\n",
    pd_stop: false, pd_short: false,
    pd_cq: ot.ot_cq, pd_cr: ot.ot_cr, pd_shell: ot.ot_shell,
    pd_wid: 0, pd_dep: 0, pd_rot: 0,
    pd_x0: 0.0, pd_z0: 0.0, pd_x1: 0.0, pd_z1: 0.0 }
}

fn desc_of_disc(dc: hex_editor::DiscRead) -> PlanDesc {
  // ⚠ AND `r` IS `√N / 2` — the field's own distance, measured against `hex_to_px`'s
  // furthest cell centre at six shells, never a fitted radius.
  PlanDesc { pd_ok: true, pd_kind: "disc",
    pd_args: "{dc.dc_cq},{dc.dc_cr} shell {dc.dc_shell}",
    pd_svg: "<circle class='disc' data-cq='{dc.dc_cq}' data-cr='{dc.dc_cr}'"
          + " data-shell='{dc.dc_shell}' data-marks='{dc.dc_marks}'"
          + " cx='{fx(dc.dc_x)}' cy='{fx(dc.dc_z)}' r='{fx(dc.dc_rad)}'"
          + " fill='none' stroke='{DESC_INK}' stroke-width='0.05'"
          + " stroke-dasharray='0.32 0.18'/>\n",
    pd_stop: false, pd_short: false,
    pd_cq: dc.dc_cq, pd_cr: dc.dc_cr, pd_shell: dc.dc_shell,
    pd_wid: 0, pd_dep: 0, pd_rot: 0,
    pd_x0: 0.0, pd_z0: 0.0, pd_x1: 0.0, pd_z1: 0.0 }
}

// ── ⛔ AND A ROOM THE BOX READER CANNOT NAME — plan 26 `B5` ────────────────
//
// ⛔ **`house_recover` REFUSES EVERY ROOM WALKED AS FOUR WALL RUNS**, and it is right to:
// `@HB-X24` says there is no square sublattice, so a flood's region is not a rectangle.
// The FORM reader answers all of them — `hex_recover::rebuild_construct`, `@HB-X45`, hull
// then verify by re-drawing — at 5 or 6 sides, which is the shape the lattice has.
// [`probe/b5`](../../../probe/b5/README.md): 25 of 25 at `ρ = 0` for zero `run_edges`.
//
// ⚠ **THE OUTLINE IS THE FORM'S OWN POLYGON, PLACED** — not the region's boundary traced
// here. A description drawn from anything but the recovered model would be a second answer
// wearing the first one's caption.
fn desc_of_region(rg: hex_editor::RegionRead) -> PlanDesc {
  gsay = "{rg.rg_sides} sides, {rg.rg_cells} cells";
  if rg.rg_stray > 0 { gsay = gsay + " · {rg.rg_stray} stray"; }
  if rg.rg_missing > 0 { gsay = gsay + " · {rg.rg_missing} missing"; }
  gpts = "";
  for gi in 0..len(rg.rg_px) {
    gpts = gpts + "{fx(rg.rg_px[gi] ?? 0.0)},{fx(rg.rg_pz[gi] ?? 0.0)} ";
  }
  PlanDesc { pd_ok: true, pd_kind: "region", pd_args: gsay,
    pd_svg: "<polygon class='region' data-sides='{rg.rg_sides}'"
          + " data-cells='{rg.rg_cells}' data-rho='{rg.rg_rho}'"
          + " data-stray='{rg.rg_stray}' data-missing='{rg.rg_missing}'"
          + " data-other='{rg.rg_other}' points='{gpts}' fill='none'"
          + " stroke='{DESC_INK}' stroke-width='0.05'"
          + " stroke-dasharray='0.32 0.18'/>\n",
    pd_stop: false, pd_short: rg.rg_other > 0,
    pd_cq: 0, pd_cr: 0, pd_shell: 0, pd_cells: rg.rg_set,
    pd_wid: 0, pd_dep: 0, pd_rot: 0,
    pd_x0: 0.0, pd_z0: 0.0, pd_x1: 0.0, pd_z1: 0.0 }
}

fn desc_of_house(w: VoxelWorld, hh: hex_editor::HouseRead, q0: integer, r0: integer,
                 wq: integer, hr: integer) -> PlanDesc {
  hsay = "{hh.hs_cq},{hh.hs_cr} {hh.hs_wid}x{hh.hs_dep} rot {hh.hs_rot}";
  // ⚠ **THE AMBIGUITY IS REPORTED, NOT HIDDEN** — §6's R2 rule, and here the ambiguity
  // is the SIZE: raising one extent by a hex step can admit no new row of cell centres,
  // so several rectangles fill the same field. The answer is the smallest, and the
  // count says how many there were.
  if hh.hs_class > 1 { hsay = hsay + " ({hh.hs_class} fit)"; }
  // ⚠ **AND THE MARKS THE RECTANGLE DOES NOT EXPLAIN ARE THE POINT OF THE PAIRING** —
  // `B0` found four wall edges bounding none of the house's cells and could not say
  // whether they were authored. The rectangle can.
  if hh.hs_stray > 0 { hsay = hsay + " · {hh.hs_stray} stray"; }
  if hh.hs_missing > 0 { hsay = hsay + " · {hh.hs_missing} missing"; }
  hbox = hex_shape::box_new(hh.hs_cq, hh.hs_cr, hh.hs_wid, hh.hs_dep, hh.hs_rot, false);
  // ── ⛔ …AND WHAT IS ON TOP OF IT — plan 26 `B8` ────────────────────────────
  //
  // ⛔ **A HOUSE HAS NAMED ITS RECTANGLE SINCE `B4n` AND SAID NOTHING ABOUT ITS ROOF**, which
  // this tree could not read back at all: twelve `roof_*` functions draw one and none recovers
  // one. `hex_roof::roof_match` does, and `roof_read_box` builds the field it wants out of the
  // store's `ROOF_MAT` columns.
  //
  // ⚠ **THE TOLERANCE IS HALF THE STORE'S OWN QUANTUM, DERIVED RATHER THAN TUNED** — a height
  // is an integer times `w_unit`, so nothing finer is representable and a residual below that
  // is exact as far as this world can tell. ⚠ Measured, a placed house needs none of it: the
  // gable comes back at residual **0** ([`probe/b8`](../../../probe/b8/README.md)).
  //
  // ⚠ **AND `unknown` IS PRINTED RATHER THAN SUPPRESSED.** `roof_match` says so when the field
  // is none of the four it knows, and a caption that hid it would be the fallback-as-recovery
  // this tree fixed upstream in `hex_roof 0.1.2`.
  hrf = hex_editor::roof_read_box(w, hbox, q0, r0, wq, hr, w.w_unit * 0.5);
  if hrf.rr_ok {
    hsay = hsay + " · {hex_editor::roof_kind_name(hrf.rr_kind)} roof";
    if hrf.rr_kind == hex_roof::ROOF_RIDGE || hrf.rr_kind == hex_roof::ROOF_CONE {
      hsay = hsay + " pitch {fx(hrf.rr_slope)}";
    }
  }
  bx = hex_editor::box_px_x(hbox, w);
  bz = hex_editor::box_px_z(hbox, w);
  hpts = "";
  for hi in 0..len(bx) { hpts = hpts + "{fx(bx[hi] ?? 0.0)},{fx(bz[hi] ?? 0.0)} "; }
  PlanDesc { pd_ok: true, pd_kind: "house", pd_args: hsay,
    pd_svg: "<polygon class='house' data-cq='{hh.hs_cq}' data-cr='{hh.hs_cr}'"
          + " data-wid='{hh.hs_wid}' data-dep='{hh.hs_dep}' data-rot='{hh.hs_rot}'"
          + " data-class='{hh.hs_class}' data-stray='{hh.hs_stray}'"
          + " data-missing='{hh.hs_missing}' data-other='{hh.hs_other}'"
          + " points='{hpts}' fill='none'"
          + " stroke='{DESC_INK}' stroke-width='0.05'"
          + " stroke-dasharray='0.32 0.18'/>\n",
    pd_stop: false, pd_short: hh.hs_other > 0,
    pd_cq: hh.hs_cq, pd_cr: hh.hs_cr, pd_shell: 0,
    pd_wid: hh.hs_wid, pd_dep: hh.hs_dep, pd_rot: hh.hs_rot,
    pd_x0: 0.0, pd_z0: 0.0, pd_x1: 0.0, pd_z1: 0.0 }
}

fn plan_describe(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
                 ref: float, cl: Claims) -> PlanDesc {
  dwq = q1 - q0;
  dhr = r1 - r0;
  rr = hex_editor::wall_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if rr.rr_ok {
    // ── AND DOES IT REPRODUCE THE MARKS? — plan 26 `B4q` ────────────────────
    //
    // ⛔ **`rr_ok` HAS NEVER MEANT *THIS IS THE WALL*, AND THIS PICTURE IS WHERE THAT
    // STOPPED BEING INVISIBLE.** The reader finds the chain's two ENDS and asks which
    // `d24` step is parallel to the vector between them; it does not check the path in
    // between. `disc` and `octagon` below answer a stronger question — the shape is
    // GENERATED and compared edge for edge — and the run was the one description drawn
    // on a weaker one.
    //
    // ⛔ **AND ONLY `missing` REACHES THE CAPTION — plan 26 `B4s`, AND `B4q` HAD IT
    // WRONG.** `B4q` adopted the house's `· N stray · N missing` grammar for both
    // numbers, which was right in a window holding one structure and is wrong the moment
    // it holds two: `rr_stray` counts marks the reader was HANDED and did not want, and
    // in a village those are the other structures'. The first three-description picture
    // captioned the wall `· 54 stray` — the tower's whole rim, about a wall that is
    // perfectly good. ⚠ **That is `B4o`'s defect in a third reader**: a description
    // confidently naming somebody else's marks.
    //
    // ⚠ **`missing` IS THE DESCRIPTION'S OWN PROPERTY AND SURVIVES** — edges this run
    // GENERATES that the store does not hold, which no other structure can affect. And
    // what nothing explains is the window's own `+ N unexplained`, counted from the
    // claims after the peel, which is where a leftover belonged all along.
    return desc_of_run(rr);
  }
  body = hex_editor::marks_body_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if body == hex_editor::WALL_BODY_OCT {
    ot = hex_editor::oct_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
    if !ot.ot_ok { return desc_no(true); }
    return desc_of_oct(ot);
  }
  dc = hex_editor::disc_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if dc.dc_ok { return desc_of_disc(dc); }
  // ── AND IF IT IS NOT ANY OF THOSE, IS IT A HOUSE? — plan 26 `B4n` ──────────
  //
  // ⛔ **A HOUSE HAS DRAWN NO DESCRIPTION SINCE `B1`, AND IT IS WHAT A BLUEPRINT IS
  // FOR.** Its marks are four runs plus a loop, which no reader above can answer for —
  // so this one does not read the marks at all. `place_house` fills its footprint with
  // `box_fill`, so the FLOOR cells are the rectangle, and the marks become what the
  // recovered rectangle is measured against.
  //
  // ⚠ **IT IS LAST FOR THE REASON THE ROUND READERS ARE ORDERED AT ALL**: asked only
  // where every reader above gave up, so no two of them answer for one window.
  hh = hex_editor::house_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if hh.hs_ok { return desc_of_house(w, hh, q0, r0, dwq, dhr); }
  // ── ⛔ …AND IF IT IS NOT A RECTANGLE, IS IT A FORM AT ALL? — plan 26 `B5` ──
  //
  // ⛔ **THE BOX READER REFUSES EVERY ROOM WALKED AS FOUR WALL RUNS, AND THAT IS THE
  // LATTICE RATHER THAN A BUG** — `@HB-X24`. Asked here instead is `@HB-X45`'s
  // constructive recovery, which takes the region's convex hull, builds the form and
  // verifies it by re-drawing. ⚠ **It is asked LAST for the reason every reader here is
  // ordered**: a rectangle is the more specific answer and keeps its own caption.
  // ⚠ **AND IT IS NOT ASKED WHERE THE ANSWER IS ALREADY KNOWN.** `house_recover_claimed` has
  // just scanned this window for `FLOOR_MAT`; `hs_cells == 0` means there is no floor here, and
  // the region reader would spend the same scan to reach the same silence. ⛔ Measured: asking
  // it unconditionally cost **45s of a 145s test** — `probe/b5`'s wiring took `planview.loft`
  // from comfortably inside `loft test`'s 300-second file deadline to over it.
  if hh.hs_cells == 0 { return desc_no(false); }
  rg = hex_editor::region_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if !rg.rg_ok { return desc_no(false); }
  desc_of_region(rg)
}

// ── ⛔ THE SAME CHAIN, ASKED OF A COMPONENT NO ONE OF THEM EXPLAINS — `B4v` ─
//
// ⛔ **`B4u` LEFT STRUCTURES THAT SHARE A VERTEX IN ONE COMPONENT**, and its own record
// named the price: a wall MEETING a rim draws the wall and counts the rim's 52 marks;
// two rims that meet are refused with all 106 counted. No flood cuts those, because the
// marks genuinely are one chain.
//
// ✅ **SO THE COMPONENT IS PARTITIONED BY WHAT A CANDIDATE ACCOUNTS FOR.** Each reader is
// asked for a shape whose own boundary lies **within** the component's marks — `within`,
// which does not shrink as the pass claims — while the run and house readers keep reading
// the REMAINDER, because a chain reader handed the same marks twice answers the same run
// for ever.
//
// ⚠ **THE RUN IS ADMITTED ONLY AT `missing == 0`**, which is that same *within* test
// spelled in the number `RunRead` has carried since `B4q`: edges this run generates that
// the store does not hold. A run that wants an edge the field lacks is not part of any
// exact cover of it.
//
// ⛔ **AND NOTHING HERE IS SAFE ON ITS OWN.** A one-directional fit accepts a disc drawn
// inside any dense field, which is exactly what `B4t` refused to soften. What makes it
// sound is the caller's union test — the pass is accepted only when the shapes it found
// claim every mark of the component and no mark outside it — so this function must never
// be called except through that.
fn plan_describe_within(w: VoxelWorld, q0: integer, r0: integer, q1: integer,
                        r1: integer, ref: float, within: Claims,
                        cl: Claims) -> PlanDesc {
  dwq = q1 - q0;
  dhr = r1 - r0;
  rr = hex_editor::wall_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if rr.rr_ok && rr.rr_missing == 0 { return desc_of_run(rr); }
  body = hex_editor::marks_body_claimed(w, q0, r0, dwq, dhr, ref, within);
  if body == hex_editor::WALL_BODY_OCT {
    ot = hex_editor::oct_within(w, q0, r0, dwq, dhr, ref, within, cl);
    if !ot.ot_ok { return desc_no(true); }
    return desc_of_oct(ot);
  }
  dw = hex_editor::disc_within(w, q0, r0, dwq, dhr, ref, within, cl);
  if dw.dc_ok { return desc_of_disc(dw); }
  hh = hex_editor::house_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
  if hh.hs_ok { return desc_of_house(w, hh, q0, r0, dwq, dhr); }
  if hh.hs_cells > 0 {
    rgw = hex_editor::region_recover_claimed(w, q0, r0, dwq, dhr, ref, cl);
    if rgw.rg_ok { return desc_of_region(rgw); }
  }
  // ⛔ **AND LAST, A RUN FROM THE COMPONENT'S OWN ENDS AND JUNCTIONS — plan 26 `B4w`.**
  // `B4v` refused two walls that CROSS because the trial had no candidate generator for a
  // run: its endpoints are continuous world points rather than a grid. A wall can only
  // begin where the chain does, and that is a handful of exact corners.
  //
  // ⚠ **IT IS LAST BECAUSE IT IS THE WEAKEST QUESTION HERE.** A house's marks hold pool
  // corners too, and the house reader must reach its floor first; a rim's hold none, so
  // the round readers are unaffected either way.
  rw = hex_editor::run_within(w, q0, r0, dwq, dhr, ref, within, cl);
  if rw.rr_ok { return desc_of_run(rw); }
  // ── ⛔ AND A WALL THAT TURNS, WHERE THE POOL IS EMPTY — plan 26 `B4x` ──────
  //
  // ⛔ **A CORNER WHERE TWO RUNS MEET IS NEITHER AN END NOR A JUNCTION**, so `corner_pool`
  // has nothing to offer it. A closed room fuses at every corner and drew NOTHING at all,
  // losing all 50 of its marks; a zigzag of three walls lost 12 of its 18. This reader cuts
  // `hex_shape::wall_chain_walk`'s ordered chain into spans instead, and it is asked last
  // because it is the weakest question here — where a pool exists, the reader above is both
  // cheaper and stronger, and every scene that closed before still takes that branch.
  rc = hex_editor::run_chain_within(w, q0, r0, dwq, dhr, ref, within, cl);
  if rc.rr_ok { return desc_of_run(rc); }
  desc_no(false)
}
pub fn plan_panel(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
              ref: float) -> PlanPanel {
  cells = "";
  edges = "";
  box = plan_bounds(q0, r0, q1, r1);
  ncell = 0;
  nedge = 0;
  nbad = 0;
  for r in r0..r1 {
    for q in q0..q1 {
      // ⚠ ONE LAYER FOR THE CELL AND ITS EDGES ALIKE. `edge_layer` is what every
      // gesture writes through, so a plan view that took the ground for the fill
      // and the surface for the walls would draw a deck's fence over the yard
      // below it — which is the exact defect that function's comment records.
      li = hex_editor::edge_layer(w, q, r, ref);
      c = if li >= 0 { hex_voxel::world_cell(w, q, r, li) } else { hex_voxel::Hex {} };
      pts = cell_points(q, r);
      mat = c.h_material as integer ?? 0;
      // ⚠ **THE HEIGHT IS ON THE CELL BECAUSE A LEVEL PICTURE IS UNREADABLE WITHOUT
      // IT** — plan 26 `B2`. A panel at `ref 3` draws the deck AND the lawn around it,
      // because `world_surface` answers *what would someone at this height be standing
      // on* and outside the deck that is still the ground. That answer is right and it
      // looks like grass on the first floor; `data-h` is what tells the two apart, and
      // it is the store's own number rather than a rule invented here.
      cells += "<polygon class='cell' data-q='{q}' data-r='{r}' data-mat='{mat}'"
             + " data-h='{c.h_height}'"
             + " points='{pts}' fill='{cell_fill(mat)}'"
             + " stroke='rgb(180,184,192)' stroke-width='0.012'/>\n";
      ncell = ncell + 1;
      for slot in 0..3 {
        emat = hex_editor::wall_of(w, q, r, slot_dir_of(slot), ref);
        if emat == 0 { continue; }
        s = plan_slot_seg(q, r, slot);
        // ── THE WALL'S TYPE, OUT OF THE PALETTE — plan 26 `B4d` ─────────────
        //
        // ⚠ **THE THICKNESS IS THE PALETTE'S, AND THE EDGE BYTE IS ONLY AN ID.**
        // `@HB-X69`: a uniform wall's 38 edges carry ONE id, so thickness cannot be
        // per-edge — it is what the id RESOLVES to. A plan that measured a wall's
        // width off its cells would be inventing a number the store does not have.
        //
        // ⚠ **AND A DECLARED-BUT-MALFORMED TYPE IS LOUD, NOT DEFAULTED.** An edge
        // whose palette entry says `thick=fat` draws in the same magenta an unknown
        // material does, and the caption counts it: silently falling back to the
        // drawing's own width is how a picture comes to disagree with the world it
        // claims to be of.
        ergn = hex_voxel::world_region_at(w, q, r);
        wt = hex_editor::wall_type(w, ergn, emat);
        ewid = edge_width(emat);
        ecol = edge_colour(emat, wt.wt_ok);
        ebody = "";
        ethick = 0.0;
        if wt.wt_ok {
          ebody = wt.wt_body;
          ethick = wt.wt_thick;
          // ⚠ **THE WIDTH COMES BACK THROUGH `wall_half` — plan 26 `B4f`** — which is
          // the same number `wt_thick` is and deliberately not read as one. That
          // function is what the MESHER builds the wall at, so a picture deriving the
          // width a second time here would be free to agree with the store and
          // disagree with the world the store describes — which is the whole failure
          // `B4d`'s own note warns about, one site further along.
          // ⚠ **`data-thick` stays the DECLARATION, verbatim.** It is a store fact and
          // the resolved width is a drawing one; a reader comparing the picture against
          // the palette needs the first, and `B4d`'s *0 means states none* depends on it.
          if ethick > 0.0 { ewid = hex_editor::wall_half(w, ergn, emat) * 2.0; }
        } else if wt.wt_why != "" && wt.wt_name != "" {
          // Declared and wrong — `wt_name` is empty only when nothing is declared.
          ebody = "?";
          ecol = "rgb(230,0,190)";
          nbad = nbad + 1;
        }
        edges += "<line class='edge' data-q='{q}' data-r='{r}' data-slot='{slot}'"
               + " data-mat='{emat}' data-body='{ebody}' data-thick='{fx(ethick)}'"
               + " x1='{fx(s.ps_x1)}' y1='{fx(s.ps_z1)}'"
               + " x2='{fx(s.ps_x2)}' y2='{fx(s.ps_z2)}'"
               + " stroke='{ecol}' stroke-width='{fx(ewid)}'"
               + " stroke-linecap='round'/>\n";
        nedge = nedge + 1;
      }
    }
  }
  // ── THE DESCRIPTIONS — plan 26 `B1` … `B4s` ───────────────────────────────
  //
  // ⛔ **A WINDOW HELD TWO DESCRIPTIONS AND EVERY REAL SCENE HOLDS MORE.** `B4o` split a
  // house's marks from a wall's; `B4p` gave that leftover the whole chain. Both took out
  // exactly ONE structure, because the exclusion was a rectangle — so a window with three
  // things in it described two and dropped the third **in silence**, which the caption's
  // leftover count was the only sign of.
  //
  // ⚠ **THE LOOP IS THE WHOLE STEP, AND WHAT MADE IT POSSIBLE IS `run_edges`.** Every
  // other shape could always say what it owns — a disc's boundary walk, an octagon's
  // `poly_holds`, a rectangle's `house_owns`. The RUN could not be asked at all until
  // `B4q` extracted the stamper's rule, and its answer was not stable until `B4r` gave
  // the halfplane a tie-break that belongs to the line. A peel built before either would
  // have subtracted the wrong edges on five headings in ten.
  //
  // ⛔ **AND THE FIELD IS SPLIT BEFORE ANY READER IS ASKED — plan 26 `B4t`.** `B4s`
  // measured what the peel alone could not do: two houses describe **nothing**, because
  // the peel subtracts what has been DESCRIBED and neither had been. `box_fits` and
  // `disc_fits` compare over the whole field in both directions, which is what stops a
  // disc being accepted with a wall across it — so a field holding two of a kind is a
  // field no single candidate reproduces, and that is `FORMAL_CORE` §6's R1 refusing
  // correctly rather than a defect to soften.
  //
  // ⚠ **THE READERS DO NOT CHANGE AT ALL.** A component is asked about by CLAIMING
  // everything else, so R1 keeps comparing over a field that is entirely one structure's
  // and every `_claimed` door works unchanged. ⚠ **And the order is the label scan's**,
  // which is the window read row by row — so the caption reads down the picture rather
  // than in the chain's order. Deterministic either way; a reader comparing two captions
  // needs it to be.
  runs = "";
  say = "none";
  nd = 0;
  capped = false;
  cl = hex_editor::claims_new(q0, r0, q1 - q0, r1 - r0);
  part = false;
  for _round in 0..PLAN_DESC_MAX {
    sg = hex_editor::segments_of(w, q0, r0, q1 - q0, r1 - r0, ref, cl);
    if hex_editor::segment_count(sg) == 0 { break; }
    told = nd;
    for cid in 0..hex_editor::segment_count(sg) {
      if nd >= PLAN_DESC_MAX { capped = true; break; }
      only = hex_editor::segment_claims(cl, w, q0, r0, q1 - q0, r1 - r0, ref, sg, cid);
      // ⚠ **THE TWO NUMBERS THE TRIAL IS JUDGED BY, READ BEFORE ANYTHING IS CLAIMED.**
      before = hex_editor::marks_unclaimed(w, q0, r0, q1 - q0, r1 - r0, ref, cl);
      mine = hex_editor::marks_unclaimed(w, q0, r0, q1 - q0, r1 - r0, ref, only);
      dsc = plan_describe(w, q0, r0, q1, r1, ref, only);
      // ⛔ **AND IF ONE READER CANNOT EXPLAIN THE COMPONENT, A SET OF THEM MAY — plan 26
      // `B4v`.** `B4u` left structures that share a VERTEX in one component: a wall
      // meeting a rim drew the wall and counted the rim's 52 marks, two rims that meet
      // were refused with all 106. The trial is asked here and taken only when it closes,
      // which is what keeps `FORMAL_CORE` §6's R1 exact — over the union rather than over
      // one shape.
      //
      // ⚠ **IT IS ASKED IN TWO PLACES AND NEITHER IS OPTIONAL**: where the strict chain
      // refused outright, and where it answered about a field it does not account for.
      // The second is the wall-meets-rim case, and skipping it would leave the honest
      // single description standing where a whole explanation exists.
      if !dsc.pd_ok || dsc.pd_short {
        tr = plan_trial(w, q0, r0, q1, r1, ref, cl, sg, cid, before, mine,
                        PLAN_DESC_MAX - nd);
        if tr.tr_ok {
          if nd == 0 { say = tr.tr_say; } else { say = say + " + " + tr.tr_say; }
          runs = runs + tr.tr_svg;
          nd = nd + tr.tr_n;
          cl = tr.tr_cl;
          continue;
        }
      }
      if !dsc.pd_ok { continue; }
      if nd == 0 { say = desc_phrase(dsc.pd_kind, dsc.pd_args); }
      else { say = say + " + " + desc_phrase(dsc.pd_kind, dsc.pd_args); }
      runs = runs + dsc.pd_svg;
      nd = nd + 1;
      // ⚠ **AND IF IT ACCOUNTED FOR NOTHING, STOP.** Every shape's membership must
      // overlap the marks it was recovered from, so a zero here means the chain has
      // answered about a field it does not explain — and asking again would give the
      // same answer for ever.
      if plan_claim(dsc, cl, q0, r0, q1, r1) == 0 { break; }
      // ⛔ **AND IF IT ACCOUNTED FOR ONLY PART OF ITS COMPONENT, DO NOT RE-SPLIT — plan
      // 26 `B4u`.** The rounds exist because peeling a structure can split what remains,
      // which is right when a whole structure came out and wrong when half of one did:
      // measured, a wall meeting a tower's rim at a vertex is described, breaks the rim
      // into two arcs, and each arc is then described as a further run. The description
      // stands — `B1`'s picture is a description drawn over marks it MISSES — and what
      // it could not explain is counted rather than re-read. ⚠ **`B4v` reaches this only
      // when the trial above could not close**, which is the honest half of that case.
      if hex_editor::segment_marks_left(w, q0, r0, q1 - q0, r1 - r0, ref, cl, sg, cid) > 0 {
        part = true;
      }
    }
    // ⚠ **A ROUND THAT DESCRIBED NOTHING ENDS IT**, whatever is left: peeling one
    // structure can SPLIT what remains, which is why the labels are rebuilt each round —
    // but a round with no answer will not produce one next time either.
    if nd == told || part { break; }
  }
  // ⚠ **WHAT IS LEFT IS COUNTED FROM THE CLAIMS, NOT FROM A READER'S OWN TALLY.**
  // `CLAUDE.md`: measure what was actually emitted. A count each description reported
  // about itself could agree with the picture and disagree with the store.
  left = hex_editor::marks_unclaimed(w, q0, r0, q1 - q0, r1 - r0, ref, cl);
  if nd == 0 {
    // ⚠ THE TWO SILENCES ARE DIFFERENT AND MUST NOT READ ALIKE. `probe/l1` lost a run to
    // exactly this: `ends = 0` is *a closed loop* and *nothing there* in one number.
    if nedge > 0 { say = "refused ({nedge} marks)"; }
  } else if left > 0 {
    say = say + " + {left} unexplained";
  }
  // ⚠ **A CAP THAT TRUNCATED IN SILENCE WOULD READ AS *I DESCRIBED EVERYTHING*** —
  // `CLAUDE.md`'s own rule about bounded coverage. It says so instead.
  if capped && left > 0 { say = say + " (capped at {PLAN_DESC_MAX})"; }
  // ⚠ AN EMPTY WINDOW STILL HAS A FRAME — `plan_bounds` answers `0..1` for one, so a
  // caller that asked for nothing gets a picture of nothing rather than a panel with a
  // null size in it.
  PlanPanel { pp_body: cells + edges + runs, pp_cells: ncell, pp_marks: nedge,
              pp_say: say, pp_bad: nbad, pp_minx: box.pb_minx, pp_maxx: box.pb_maxx,
              pp_minz: box.pb_minz, pp_maxz: box.pb_maxz }
}

// ── THE TRIAL, AND THE ONE NUMBER THAT ACCEPTS IT — plan 26 `B4v` ─────────
//
// ⛔ **A ONE-DIRECTIONAL FIT WOULD ANSWER FOR ANYTHING, AND THIS IS WHAT STOPS IT.**
// `plan_describe_within` accepts a shape whose boundary lies within the component's
// marks; on its own that is exactly the softening `B4t` refused. R1 is restored here,
// one level up: the SET the trial found is accepted only when it claims **every** mark
// of the component and **no mark outside it**.
//
// ⚠ **AND THAT IS ONE INTEGER, MEASURED IN BOTH DIRECTIONS AT ONCE.** `before` is what
// the window had unclaimed, `mine` is this component's share of it; the trial is right
// exactly when what is left afterwards is `before - mine`. Too few claims and the
// number is high — the component is not explained; too many and it is low — the trial
// reached into a neighbour, which is `B4o`'s defect and which a count of the component
// alone cannot see.
//
// ⚠ **THE TRIAL RUNS ON A COPY**, so a rejected one leaves nothing behind: its claims
// would otherwise silence the very marks the refusal is there to count.
struct PlanTrial {
  tr_ok:  boolean,
  tr_cl:  Claims,          // …the claims to adopt, on success
  tr_svg: text,
  tr_say: text,
  tr_n:   integer,         // how many descriptions it took
}

fn plan_trial(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
              ref: float, base: Claims, sg: Segments, cid: integer, before: integer,
              mine: integer, room: integer) -> PlanTrial {
  wq = q1 - q0;
  hr = r1 - r0;
  sc = hex_editor::claims_copy(base, q0, r0, wq, hr);
  within = hex_editor::segment_claims(base, w, q0, r0, wq, hr, ref, sg, cid);
  svg = "";
  say = "";
  n = 0;
  for _t in 0..room {
    d = plan_describe_within(w, q0, r0, q1, r1, ref, within,
          hex_editor::segment_claims(sc, w, q0, r0, wq, hr, ref, sg, cid));
    if !d.pd_ok { break; }
    // ⚠ **A DESCRIPTION THAT CLAIMS NOTHING NEW ENDS IT** — the peel's own guard, and
    // here it is the whole termination argument: a shape already claimed still lies
    // within the marks and would be returned for ever.
    if plan_claim(d, sc, q0, r0, q1, r1) == 0 { break; }
    if n > 0 { say = say + " + "; }
    say = say + desc_phrase(d.pd_kind, d.pd_args);
    svg = svg + d.pd_svg;
    n = n + 1;
  }
  after = hex_editor::marks_unclaimed(w, q0, r0, wq, hr, ref, sc);
  PlanTrial { tr_ok: n > 0 && after == before - mine, tr_cl: sc, tr_svg: svg,
              tr_say: say, tr_n: n }
}

// ── THE AUTHOR ON THE PLAN — plan 26 `B3`, BLUEPRINT §3.1 ──────────────────
//
// *"A character location on the map is still the running way … but this editor
// doesn't restrict the character anywhere."* A plan with nobody on it is a map; the
// pose is what makes it the editor's own view of where you are standing.
//
// ⚠ **IT TAKES AN `Author`, WHICH IS THE LIBRARY'S OWN ANSWER TO *WHERE IS THE
// PERSON*.** Not a `Walker` — that is walk STATE, and a plan does not care how fast
// anybody is going — and not four loose floats, which would be a second spelling of
// a struct every gesture already takes. `plan_author` is the one place this package
// reads `au_*`, so the pose has one shape here and one conversion.
//
// ⚠ AND `au_yaw` IS RADIANS, 0 = +x, which `gesture.loft` says at its own
// declaration and the tick confirms by walking `(cos yaw, sin yaw)`. The page frame
// IS the world's x/z plane, so the facing needs no sign flip and must not be given
// one — a facing drawn backwards is the one error in this picture that looks
// deliberate.
pub struct PlanWho {
  pw_show: boolean,
  pw_x:    float,
  pw_z:    float,
  pw_y:    float,
  pw_yaw:  float,
}

pub fn plan_nobody() -> PlanWho {
  PlanWho { pw_show: false, pw_x: 0.0, pw_z: 0.0, pw_y: 0.0, pw_yaw: 0.0 }
}

pub fn plan_author(a: hex_editor::Author) -> PlanWho {
  PlanWho { pw_show: true, pw_x: a.au_x, pw_z: a.au_z, pw_y: a.au_y, pw_yaw: a.au_yaw }
}

// How long the facing tick is, in world units — just past the marker, so the two
// read as one arrow rather than as a dot and a line.
pub const PLAN_FACING = 0.85;

// ── WHAT IS DRAWN OVER THE WORLD — plan 26 `B3` and `B4c` ──────────────────
//
// The author, and the spot they are pointing at. Both are TRANSIENT — neither is in
// the store, neither survives the picture — which is why they are one parameter and
// not two more: a plan draws a world, and then it draws what is happening to it.
//
// ⚠ `plan_bare()` IS THE DEFAULT AND IT IS NOT AN EMPTY STRUCT WITH A NICE NAME. A
// picture with nobody on it and nothing picked is what every non-interactive caller
// wants, and spelling that as `plan_over(plan_nobody(), plan_nopick())` at fifteen call
// sites is how a wrong one gets written.
pub struct PlanOver {
  po_who:  PlanWho,
  po_pick: PlanPick,
}

pub fn plan_nopick() -> PlanPick { pick_no("") }
pub fn plan_bare() -> PlanOver {
  PlanOver { po_who: plan_nobody(), po_pick: plan_nopick() }
}
pub fn plan_over_who(who: PlanWho) -> PlanOver {
  PlanOver { po_who: who, po_pick: plan_nopick() }
}
pub fn plan_over_pick(pick: PlanPick) -> PlanOver {
  PlanOver { po_who: plan_nobody(), po_pick: pick }
}
pub fn plan_over(who: PlanWho, pick: PlanPick) -> PlanOver {
  PlanOver { po_who: who, po_pick: pick }
}

// ── LEVELS, SIDE BY SIDE — plan 26 `B2`, BLUEPRINT §3.4 ─────────────────────
//
// *"Multiple floors have a layout beside each other."* One panel per reference
// height, each in its own `<g>` with the level on it and the placement in **one**
// `transform`.
//
// ⚠ **A LEVEL IS NOT A HEIGHT AND THE PAGE IS NOT THE WORLD**, which are two
// different things this design has to keep apart at once. `FORMAL_CORE` §2.4.3:
// *"the level is a discrete sheet index and nothing else"* — so `data-level` is the
// index, `data-ref` is the height it was read at, and neither is the other. And the
// page position is `data-dx`, declared once per group: ⚠ *"if it reaches the field,
// two floors of one house become two buildings a hex-step apart, and the stair
// between them stops being a stair."*
//
// ⚠ THE INVERSE IS WHY IT IS DECLARED RATHER THAN BAKED IN. Authoring on a plan needs
// page → cell, and a translation that lives in the coordinates cannot be undone by a
// reader that does not already know it. `hex_place::Pose` is the library's map for
// that when the gestures arrive; today the picture states the number it would need.
// How many structures one window will describe — plan 26 `B4s`.
//
// ⚠ **IT IS A BOUND ON THE LOOP, NOT A JUDGEMENT ABOUT SCENES.** The peel ends on its
// own when nothing more can be described or nothing is left; this is what stops a reader
// that answers without accounting for anything from running for ever, and the caption
// says when it bit rather than truncating in silence.
pub const PLAN_DESC_MAX = 8;

pub const PLAN_GUTTER = 1.2;

pub fn plan_levels(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
               refs: vector<float>, over: PlanOver, title: text) -> text {
  who = over.po_who;
  pick = over.po_pick;
  // ⚠ AN EMPTY LIST IS ONE LEVEL AT ZERO, NOT AN EMPTY PICTURE. A caller that asked
  // for no levels has made a mistake, and a blank frame hides it; the caption says
  // which reference every panel was read at, so the wrong one is visible.
  rs = refs;
  if len(rs) < 1 { rs = [0.0]; }
  // ⚠ **WHICH PANEL THE AUTHOR IS ON IS THE STORE'S ANSWER, NOT A THRESHOLD.** They
  // belong on the level whose reference selects the same LAYER under their own cell
  // as their own feet do — `edge_layer` asked twice and compared. A rule of the shape
  // *within half a storey of the reference* would be a number invented here, and
  // `FORMAL_CORE` is explicit that a level is not a height.
  (aq, ar) = px_to_hex(who.pw_x, who.pw_z);
  alayer = 0 - 2;
  if who.pw_show { alayer = hex_editor::edge_layer(w, aq, ar, who.pw_y); }
  inwin = who.pw_show && aq >= q0 && aq < q1 && ar >= r0 && ar < r1;
  seen = false;
  bodies = "";
  minx = 0.0;
  maxx = 1.0;
  minz = 0.0;
  maxz = 1.0;
  pitch = 0.0;
  totcell = 0;
  totmark = 0;
  verdicts = "";
  for k in 0..len(rs) {
    kref = rs[k] ?? 0.0;
    pan = plan_panel(w, q0, r0, q1, r1, kref);
    if k == 0 {
      minx = pan.pp_minx; maxx = pan.pp_maxx;
      minz = pan.pp_minz; maxz = pan.pp_maxz;
      pitch = plan_pitch(PlanBox { pb_minx: minx, pb_maxx: maxx,
                                   pb_minz: minz, pb_maxz: maxz });
    }
    dx = (k as float) * pitch;
    px = minx - PLAN_MARGIN;
    pz = minz - PLAN_MARGIN;
    pw = maxx - minx + PLAN_MARGIN * 2.0;
    ph = maxz - minz + PLAN_MARGIN * 2.0;
    // ⚠ THE MARKER IS IN THE PANEL'S OWN FRAME, so it is placed by the same group
    // transform as everything else and its `cx`/`cy` stay the author's own floats.
    mine = "";
    onme = "";
    // ⚠ **THE PICK NAMES ITS OWN PANEL, so there is no rule here to get wrong.** The
    // author needs a layer comparison because a pose is a height; a pick already
    // carries the level it resolved on.
    if pick.pk_ok && pick.pk_level == k {
      onme += "  aim";
      // ⚠ TWO MARKS, BECAUSE A PICK IS TWO FACTS. The outline is the CELL it resolved
      // to and the cross is the POINT that was asked for; drawing only the first hides
      // the snap, and hiding the snap is how an author blames the store for a gesture
      // that landed where they actually pointed.
      mine += "<polygon class='aimcell' data-q='{pick.pk_q}' data-r='{pick.pk_r}'"
            + " points='{cell_points(pick.pk_q, pick.pk_r)}'"
            + " fill='rgb(140,60,200)' fill-opacity='0.28'"
            + " stroke='rgb(140,60,200)' stroke-width='0.09'/>\n"
            + "<line class='aim' data-x='{fx(pick.pk_x)}' data-z='{fx(pick.pk_z)}'"
            + " x1='{fx(pick.pk_x - 0.22)}' y1='{fx(pick.pk_z)}'"
            + " x2='{fx(pick.pk_x + 0.22)}' y2='{fx(pick.pk_z)}'"
            + " stroke='rgb(140,60,200)' stroke-width='0.07'/>\n"
            + "<line class='aim' data-x='{fx(pick.pk_x)}' data-z='{fx(pick.pk_z)}'"
            + " x1='{fx(pick.pk_x)}' y1='{fx(pick.pk_z - 0.22)}'"
            + " x2='{fx(pick.pk_x)}' y2='{fx(pick.pk_z + 0.22)}'"
            + " stroke='rgb(140,60,200)' stroke-width='0.07'/>\n";
    }
    if inwin && hex_editor::edge_layer(w, aq, ar, kref) == alayer && !seen {
      seen = true;
      // ⚠ **`+=`, NOT `=`, AND THAT WAS A LIVE DEFECT FOR ONE COMMIT.** The aim block
      // above writes into the same two strings; an assignment here wiped the highlight
      // whenever the author happened to be standing on the panel they were aiming at —
      // which is *every* aim taken by a person at their own plan. `probe/plan` row G
      // caught it on the first run, because it asks whether the picture carries the
      // mark rather than whether the caption says it does.
      onme += "  you";
      mine += "<circle class='author' data-x='{fx(who.pw_x)}' data-z='{fx(who.pw_z)}'"
           + " data-yaw='{fx(who.pw_yaw)}' cx='{fx(who.pw_x)}' cy='{fx(who.pw_z)}'"
           + " r='0.3' fill='rgb(220,40,40)' stroke='rgb(250,250,248)'"
           + " stroke-width='0.06'/>\n"
           + "<line class='facing' x1='{fx(who.pw_x)}' y1='{fx(who.pw_z)}'"
           + " x2='{fx(who.pw_x + cos(who.pw_yaw) * PLAN_FACING)}'"
           + " y2='{fx(who.pw_z + sin(who.pw_yaw) * PLAN_FACING)}'"
           + " stroke='rgb(220,40,40)' stroke-width='0.1' stroke-linecap='round'/>\n";
    }
    badsay = "";
    if pan.pp_bad > 0 { badsay = "  BAD TYPE {pan.pp_bad}"; }
    captext = "L{k}  ref {kref}  q {q0}..{q1}  r {r0}..{r1}  cells {pan.pp_cells}"
            // ⚠ **`desc`, NOT `run` — plan 26 `B4h`.** This field carries whatever
            // reader could explain the marks, and since a rim recovers as a DISC the
            // old label would have read `run disc 0,0 shell 156`: a caption asserting
            // the one thing the picture disproves.
            + "  marks {pan.pp_marks}  desc {pan.pp_say}{badsay}{onme}";
    // ⚠ SIZED TO FIT, because a caption that runs off its panel is a caption whose
    // LAST field is the one you cannot read — and the last field is the run verdict,
    // the one thing a reader cannot infer from the drawing.
    capfs = pw / ((captext.size() as float) * 0.62) ?? 0.45;
    if capfs > 0.45 { capfs = 0.45; }
    bodies += "<g class='level' data-level='{k}' data-ref='{kref}' data-dx='{fx(dx)}'"
            + " transform='translate({fx(dx)} 0)'>\n"
            + "<rect x='{fx(px)}' y='{fx(pz)}' width='{fx(pw)}' height='{fx(ph)}'"
            + " fill='rgb(250,250,248)'/>\n"
            + pan.pp_body
            + mine
            + "<text x='{fx(px + 0.3)}' y='{fx(pz + ph - 0.3)}' font-size='{fx(capfs)}'"
            + " font-family='monospace' fill='rgb(70,74,82)'>{captext}</text>\n"
            + "</g>\n";
    totcell = totcell + pan.pp_cells;
    totmark = totmark + pan.pp_marks;
    verdicts += " L{k}={pan.pp_say}";
  }
  vx = minx - PLAN_MARGIN;
  vz = minz - PLAN_MARGIN;
  vw = (len(rs) as float) * pitch - PLAN_GUTTER;
  vh = maxz - minz + PLAN_MARGIN * 2.0;
  head = "<svg xmlns='http://www.w3.org/2000/svg'"
       + " viewBox='{fx(vx)} {fx(vz)} {fx(vw)} {fx(vh)}'"
       + " width='{round(vw * PLAN_PX) ?? 0.0}' height='{round(vh * PLAN_PX) ?? 0.0}'>\n"
       + "<rect x='{fx(vx)}' y='{fx(vz)}' width='{fx(vw)}' height='{fx(vh)}'"
       + " fill='rgb(226,228,232)'/>\n";
  // ⚠ THE COUNTS ARE IN A COMMENT, NOT IN AN ELEMENT, and they are for a person
  // reading the file. A gate must count the elements it can see — `CLAUDE.md`:
  // measure what was emitted, never a number the producer re-derives.
  // ⚠ THREE STATES, AND THEY MUST NOT READ ALIKE — the same rule the run verdict
  // obeys. *Nobody was given*, *somebody was given and is on this plan*, and
  // *somebody was given and is on none of these levels* are three different facts,
  // and an absent marker says all three at once.
  whosay = "none";
  if who.pw_show {
    whosay = "({fx(who.pw_x)},{fx(who.pw_z)}) y {fx(who.pw_y)}";
    if !seen { whosay += " OFF-PLAN"; }
  }
  // ⚠ THREE STATES AGAIN, AND FOR THE THIRD TIME IN THIS FILE: *nothing was picked*,
  // *this was picked*, and *something was picked and named no cell*. An absent
  // highlight says all three.
  aimsay = "none";
  if pick.pk_ok {
    aimsay = "L{pick.pk_level} ({pick.pk_q},{pick.pk_r})";
  } else if pick.pk_why != "" {
    aimsay = "refused ({pick.pk_why})";
  }
  foot = "<!-- plan: {title} q {q0}..{q1} r {r0}..{r1} levels {len(rs)}"
       + " pitch {fx(pitch)} cells {totcell} edges {totmark} run{verdicts}"
       + " who {whosay} aim {aimsay} -->\n</svg>\n";
  head + bodies + foot
}

// ── PAGE → CELL: THE INVERSE OF THE PLACEMENT — plan 26 `B4a` ──────────────
//
// BLUEPRINT §3.4 declares the offset *"presentation only"* and names `hex_place::Pose`
// as the map between the page frame and each level's own. This is that map for the
// only transform the plan actually applies: a translation of `k * pitch`, declared on
// each group as `data-dx`.
//
// ⚠ **IT SHARES THE FRAME WITH THE DRAWING RATHER THAN RE-DERIVING IT.** `plan_bounds`
// and `plan_pitch` answer for both, so the picture and the pick cannot disagree — a
// second copy of that arithmetic would be wrong by a margin, and everything authored
// near an edge would land one cell out.
//
// ⚠ **AND A REFUSAL NAMES ITS RESTRICTION.** A page point in the gutter, in a panel's
// margin, or off the page is not *the nearest cell*: it is **no cell**, and answering
// with the nearest one is how a click beside the picture authors inside it.
pub struct PlanPick {
  pk_ok:    boolean,
  pk_level: integer,        // which panel, and −1 when none
  pk_ref:   float,          // that panel's reference height
  pk_q:     integer,
  pk_r:     integer,
  pk_x:     float,          // the WORLD point inside that panel — an `Author`'s x
  pk_z:     float,
  pk_why:   text,
}

fn pick_no(why: text) -> PlanPick {
  PlanPick { pk_ok: false, pk_level: 0 - 1, pk_ref: 0.0, pk_q: 0, pk_r: 0,
             pk_x: 0.0, pk_z: 0.0, pk_why: why }
}

pub fn plan_pick(q0: integer, r0: integer, q1: integer, r1: integer,
             refs: vector<float>, px: float, py: float) -> PlanPick {
  rs = refs;
  if len(rs) < 1 { rs = [0.0]; }
  box = plan_bounds(q0, r0, q1, r1);
  pitch = plan_pitch(box);
  ox = box.pb_minx - PLAN_MARGIN;
  oz = box.pb_minz - PLAN_MARGIN;
  // ⚠ **LEFT OF THE PAGE IS REFUSED BEFORE THE DIVISION, AND THAT ORDER IS THE BUG
  // THIS AVOIDS.** loft's `/` truncates toward zero, so a negative offset divides to
  // panel **0** — a click a metre left of the picture would author in its first panel.
  // The same shape as `mesh_tile_of`, which this tree has already paid for once.
  if px < ox { return pick_no("left of the page"); }
  if py < oz { return pick_no("above the page"); }
  if py > oz + plan_paper_h(box) { return pick_no("below the page"); }
  k = ((px - ox) / pitch ?? 0.0) as integer;
  if k >= len(rs) { return pick_no("past the last level"); }
  lx = px - (k as float) * pitch;
  if lx > ox + plan_paper_w(box) { return pick_no("in the gutter between levels"); }
  (pq, pr) = px_to_hex(lx, py);
  if pq < q0 || pq >= q1 || pr < r0 || pr >= r1 {
    return pick_no("in the margin, outside the window");
  }
  PlanPick { pk_ok: true, pk_level: k, pk_ref: rs[k] ?? 0.0, pk_q: pq, pk_r: pr,
             pk_x: lx, pk_z: py, pk_why: "" }
}

// One level, which is what most callers want and what `B0` shipped.
pub fn plan_svg(w: VoxelWorld, q0: integer, r0: integer, q1: integer, r1: integer,
                ref: float, title: text) -> text {
  plan_levels(w, q0, r0, q1, r1, [ref], plan_bare(), title)
}

// ── WHAT ACTUALLY REACHED THE FILE — plan 26 `B4m` ─────────────────────────
//
// ⛔ **THE DRIVER COUNTED THE PICTURE'S ELEMENTS AND GOT IT WRONG TWICE AT ONE SITE.**
// `B4h` added the disc and `src/plan_view.loft` reported *description refused* for a
// tower whose description was three lines above it, because its tally matched
// `<line class='run'` alone. `B4m` added the octagon and it happened again — and this
// time it took the CELL count with it, because an octagon is drawn as a `<polygon>`
// and the cell tally claimed that element by name: **325 cells and `description
// refused`** for a picture captioned *cells 324 … desc octagon 0,0 shell 468*.
//
// ⚠ **SO THE TALLY LIVES HERE, WHERE IT CAN BE TESTED, AND MATCHES THE CLASS RATHER
// THAN THE ELEMENT.** A tag name is not an identity: the next description to arrive
// will reuse some element too, and a counter keyed on `<polygon ` is wrong the day it
// does. ⚠ It reads the emitted TEXT and nothing else — `CLAUDE.md`: *measure what was
// actually emitted, never a number the producer re-derives* — which is why it takes
// the SVG rather than a `PlanPanel`.
pub struct PlanTally {
  pt_cells:  integer,
  pt_marks:  integer,
  pt_descs:  integer,      // runs, discs and octagons together — a description is one
  pt_levels: integer,
}

fn starts(ln: text, head: text) -> boolean {
  if ln.size() < head.size() { return false; }
  ln[0..(head.size() as i32)] == head
}

pub fn plan_tally(svg: text) -> PlanTally {
  cells = 0;
  marks = 0;
  descs = 0;
  levels = 0;
  for ln in svg.split('\n') {
    if starts(ln, "<polygon class='cell'") { cells = cells + 1; }
    if starts(ln, "<line class='edge'") { marks = marks + 1; }
    if starts(ln, "<line class='run'") { descs = descs + 1; }
    if starts(ln, "<circle class='disc'") { descs = descs + 1; }
    if starts(ln, "<polygon class='oct'") { descs = descs + 1; }
    if starts(ln, "<polygon class='house'") { descs = descs + 1; }
    if starts(ln, "<polygon class='region'") { descs = descs + 1; }
    if starts(ln, "<g class='level' ") { levels = levels + 1; }
  }
  PlanTally { pt_cells: cells, pt_marks: marks, pt_descs: descs, pt_levels: levels }
}
