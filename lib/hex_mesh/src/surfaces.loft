// THE SURFACES THE MESHER CAN EMIT — one list, and everything else derived.
//
// Plan 18 `B3.1`. CATALOGUE §C3 asks that the material catalogue be *derived
// from the mesher, not a second list*, and this is where that starts: the names,
// the colours and the count all come from `surfaces()`.
//
// ⚠ IT IS NOT A HYPOTHETICAL DRIFT. `editor_server.loft`'s own comment records
// the stride going 4 → 5 → 7 → 9 as surfaces were added, and says nine gate
// files carry the number beside a "keep this equal to" note. A catalogue kept
// beside that would be the tenth copy.
//
// ⚠ THE ORDER IS THE ID-SPACE ORDER. A chunk's meshes sit on consecutive ids at
// `chunk * SURFACES + MESH_FIGURE_MAX + (index + 1)`, so re-ordering this list
// renumbers every mesh on the wire. Add at the END.

use hex_editor;

pub struct Surface {
  sf_name:  text,        // author-facing, and what the catalogue lists
  sf_r:     float,
  sf_g:     float,
  sf_b:     float,
  // Surfaces that read as ONE thing in a picture share a bucket name. Two pale
  // warm greys are not a classifier failure, they are a fact about the palette —
  // see `test_surfaces_are_separable_or_declared_alike`.
  sf_bucket: text,
  // ⚠ THE CELL MATERIAL THIS SURFACE DRAWS, or 0 for one that no cell can hold.
  //
  // A surface is what the MESHER can draw; a terrain is what a CELL can be, and the
  // second is a proper subset of the first — four short. `tree` is an ITEM
  // (`h_item`), `wall` is an EDGE material in its own numbering (where `1` means
  // wall while `1` on this axis means grass), and `frame` and `soffit` are derived
  // and stored nowhere.
  //
  // ⚠ AND THE OVERLAP IS SCRAMBLED, WHICH IS WHY IT IS WRITTEN DOWN. Materials
  // 1,2,3,4,5 land on surfaces 0,1,2,**6**,**4** — not an offset, not order-
  // preserving. Every site that needed it used to re-derive it; `hex_editor::ground_kinds()`
  // owns the material axis and this is the one place the two are joined.
  sf_mat: integer = 0,
}

pub fn surfaces() -> vector<Surface> {
  [
    Surface { sf_name: "grass",  sf_r: 0.42, sf_g: 0.50, sf_b: 0.30, sf_bucket: "grass" , sf_mat: hex_editor::SURFACE_MAT },
    // ⚠ A DIRT ROAD, AND THE COLOUR IS A MEASUREMENT NOT A TASTE. It was
    // `0.28,0.26,0.24` — a neutral dark grey — which sits **0.00009** from the
    // wall in chromaticity, an order of magnitude INSIDE the 0.0009 the picture
    // gates classify with. Both were neutral, and chromaticity divides brightness
    // out, so nothing could tell a road from a wall.
    //
    // A neutral can never separate from another neutral, so it had to gain a
    // tint. Cool collides with the SKY and plain brown collides with the FIGURE's
    // skin (0.00014 away), which is what pushed it to a red earth — and an earth
    // track is what these roads are: `freeze_grade` CUTS one into a hill rather
    // than painting a stripe on it. Nearest neighbour is now the floor at 0.0032.
    Surface { sf_name: "road",   sf_r: 0.30, sf_g: 0.18, sf_b: 0.15, sf_bucket: "road" , sf_mat: hex_editor::ROAD_MAT },
    Surface { sf_name: "field",  sf_r: 0.55, sf_g: 0.62, sf_b: 0.24, sf_bucket: "field" , sf_mat: hex_editor::FIELD_MAT },
    Surface { sf_name: "tree",   sf_r: 0.16, sf_g: 0.34, sf_b: 0.14, sf_bucket: "tree" },
    Surface { sf_name: "roof",   sf_r: 0.45, sf_g: 0.20, sf_b: 0.17, sf_bucket: "roof" , sf_mat: hex_editor::ROOF_MAT },
    // ⚠ wall and frame are ONE bucket on purpose: a frame is a jamb and a soffit,
    // and it reads as a wall with its reveals in the picture as well as in the
    // histogram. Pretending them apart is what a classifier cannot do honestly.
    Surface { sf_name: "wall",   sf_r: 0.55, sf_g: 0.52, sf_b: 0.46, sf_bucket: "masonry" },
    // ⚠ THE FLOOR IS TIMBER, AND THAT IS LOAD-BEARING. It used to be
    // `0.62,0.57,0.48` — 0.0003 from the wall in chromaticity against a 0.0009
    // tolerance — so an interior frame reported ONE bucket of 77% that was a wall
    // AND the floor it stands on, and no threshold over it could mean what it
    // said. It was separated in the RENDERER rather than in the classifier, which
    // is why the fix survives.
    Surface { sf_name: "floor",  sf_r: 0.65, sf_g: 0.40, sf_b: 0.25, sf_bucket: "floor" , sf_mat: hex_editor::FLOOR_MAT },
    // ⚠ DRESSED STONE, AND IT IS THE POINT OF THE MESH. `F-READ`'s second cue is
    // *a frame that is a different VALUE from the wall* — the eye finds an opening
    // by the band of lighter stone around it before it resolves the hole at all.
    // Geometry alone cannot say this: a surround flush in colour with its wall is
    // invisible however proud it stands, because a plane parallel to the wall
    // shades identically.
    Surface { sf_name: "frame",  sf_r: 0.78, sf_g: 0.74, sf_b: 0.65, sf_bucket: "masonry" },
    // ⚠ THE CEILING IS COOL AND THE ROOM UNDER IT IS WARM, and that is what gives a
    // room a corner. It is also the only way the frame gate can SEE it: the
    // classifier reads chromaticity, so a soffit in the roof's own colour IS the
    // roof to it, and "is the overhead surface the ceiling or the outside of the
    // roof" becomes a question no pixel can answer. Measured against every other
    // entry in the palette its nearest neighbour is 4.2× the classifier's tolerance
    // — the pale warm greys are crowded, so a ceiling that reads as shadow is the
    // one that also separates.
    Surface { sf_name: "soffit", sf_r: 0.34, sf_g: 0.30, sf_b: 0.36, sf_bucket: "soffit" },
    // ⚠ THE ONE SURFACE NO CELL CAN HOLD *AND* NO REGISTRY LISTS — plan 20 `A5`.
    // A rock face is DERIVED: `hex_editor::face_at` reads it off two heights and a
    // threshold, so `sf_mat` is 0 not because rock is unimplemented but because
    // storing it would be a second answer that can disagree with the first.
    //
    // ⚠ AND IT SHARES THE MASONRY BUCKET ON PURPOSE, which is the honest reading of
    // what chromaticity can do. Every hue this palette leaves free is a SATURATED
    // one — the crowded region is exactly the near-neutrals — so a rock that
    // separates in chroma from dressed stone is a rock that is visibly green or
    // blue. Measured over `classified()`: a neutral sits 2.0x the tolerance from
    // the wall where the palette's own tightest pair is 3.5x, and every grey that
    // clears the wall lands inside 2.5x of the sky or the soffit instead.
    //
    // So it is declared alike rather than faked apart — the wall/frame rule one
    // surface over — and the separation that IS real is carried by VALUE.
    //
    // ⚠ AND IT IS LIGHT, WHICH IS THE OPPOSITE OF THE FIRST ANSWER AND THE PICTURE
    // IS WHY. `0.34/0.32/0.29` was chosen to sit *below* the wall's `0.55/0.52/0.46`
    // — a weathered outcrop beside dressed stone — and it photographed as a BLACK
    // HOLE in the hillside. A face is vertical by construction, so its normal is
    // horizontal, so `max(dot(N, L), 0.0)` is **zero** on every face turned away
    // from the light and the whole of it is the 0.45 ambient: `0.34 x 0.45` is
    // `0.153`, which is not a dark rock, it is a hole. `A5`'s own invariant is *a
    // face is a surface, not an absence*, and the first colour failed it in the one
    // instrument that can see it.
    //
    // Light stone reads as stone at ambient — `0.68 x 0.45` is `0.306` — and it is
    // also the truer picture: an outdoor cliff in daylight is brighter than a wall
    // in shade, not darker. ⚠ A gate still cannot ask a histogram whether a face
    // appeared; it counts the mesh's triangles, which is exact.
    Surface { sf_name: "rock",   sf_r: 0.68, sf_g: 0.65, sf_b: 0.59, sf_bucket: "masonry" },
  ]
}

// The id-space stride. ⚠ DERIVED, so it cannot drift from the list it counts —
// which is the whole of `B3.1`. It was a hand-kept `const SURFACES = 9`.
pub fn surface_count() -> integer { len(surfaces()) }

// ⚠ WHAT THE PICTURE GATES CLASSIFY, WHICH IS MORE THAN THE MESHER EMITS. The
// character and the clear colour are in every frame and in every histogram, so a
// new surface has to be separable from THEM too — and "brown" is exactly where a
// road wanted to go and the figure already was. Kept apart from `surfaces()`
// because the stride counts MESHES, and these are not meshes.
pub fn classified() -> vector<Surface> {
  out = surfaces();
  out += [Surface { sf_name: "figure", sf_r: 0.80, sf_g: 0.60, sf_b: 0.45, sf_bucket: "figure" }];
  out += [Surface { sf_name: "sky",    sf_r: 0.48, sf_g: 0.55, sf_b: 0.64, sf_bucket: "sky" }];
  out
}

pub fn surface_at(i: integer) -> Surface {
  surfaces()[i] ?? Surface { sf_name: "?", sf_r: 0.0, sf_g: 0.0, sf_b: 0.0, sf_bucket: "?" }
}

// The index a NAME sits at, or −1. ⚠ Plan 17 `A8.8` (§P9.13): a part's `WALL`
// section names its surface in words — `surface=floor` — because a stored INDEX
// would be a second copy of this list's order, and the header three lines up says
// re-ordering renumbers every mesh on the wire. A name survives a re-order; an
// index silently becomes a different colour.
//
// ⚠ −1 RATHER THAN A FALLBACK. A misspelt surface must reach its author as a
// refusal with the six spellings in it; falling back to `wall` is how a document
// comes to say something the picture does not.
// The surface that draws a cell material, or −1 for a material nothing draws.
//
// ⚠ THE JOIN GOES THIS WAY ROUND BECAUSE THE PACKAGES DO. `hex_mesh` depends on
// `hex_editor`, so the drawn list may point at the material axis and never the
// reverse — which is also why `hex_editor::slope_limit` cannot read a colour and
// does not need to.
pub fn surface_for_mat(mat: integer) -> integer {
  if mat == 0 { return 0 - 1; }
  ss = surfaces();
  for i in 0..len(ss) {
    if surface_at(i).sf_mat == mat { return i; }
  }
  0 - 1
}

pub fn surface_index(name: text) -> integer {
  ss = surfaces();
  for i in 0..len(ss) {
    if surface_at(i).sf_name == name { return i; }
  }
  0 - 1
}

// Chromaticity — the colour with the brightness divided out, which is what the
// picture gates classify on so a lit surface and a shadowed one land together.
pub struct Chroma { ch_r: float, ch_g: float, ch_b: float }

pub fn surface_chroma(s: Surface) -> Chroma {
  t = s.sf_r + s.sf_g + s.sf_b;
  if t <= 0.0 { return Chroma { ch_r: 0.0, ch_g: 0.0, ch_b: 0.0 }; }
  cr = (s.sf_r / t) ?? 0.0;
  cg = (s.sf_g / t) ?? 0.0;
  cb = (s.sf_b / t) ?? 0.0;
  Chroma { ch_r: cr, ch_g: cg, ch_b: cb }
}

// The squared distance the picture gates compare against their 0.0009 tolerance.
pub fn chroma_gap(a: Surface, b: Surface) -> float {
  ca = surface_chroma(a);
  cb = surface_chroma(b);
  dr = ca.ch_r - cb.ch_r;
  dg = ca.ch_g - cb.ch_g;
  db = ca.ch_b - cb.ch_b;
  dr * dr + dg * dg + db * db
}
