// The surface set — plan 18 `B3.1`.
//
// ⚠ THE COUNT IS THE LIST, and that is the claim. `editor_server.loft` carried
// `const SURFACES = 9` by hand, and its own comment records the number going
// 4 → 5 → 7 → 9 with nine gate files holding a copy beside a "keep this equal
// to" note. A catalogue derived from the list cannot disagree with it; a
// catalogue written beside it is the tenth copy waiting to drift.
use hex_mesh;

fn test_the_stride_is_the_list_length() {
  assert(surface_count() == len(surfaces()),
         "the stride is {surface_count()} and the list holds {len(surfaces())}");
  // The number the wire is currently built on. ⚠ If a surface is added this
  // fails, and it SHOULD: the id space renumbers and every decoder moves.
  // ⚠ 10 → 11 FOR WATER (plan 20 `A10`), and this row is what made the sweep
  // complete rather than remembered: **thirteen** files carry the stride and every
  // one of them reads the id space by modulo. Water is APPENDED, so nothing already
  // numbered moved — but the stride itself is in each of those thirteen, and this
  // assertion is the only thing that would have said so.
  assert(surface_count() == 11, "surfaces: {surface_count()}, want 11");
}

fn test_every_surface_is_named_once() {
  ss = surfaces();
  for i in 0..len(ss) {
    a = surface_at(i);
    assert(a.sf_name != "", "surface {i} has no name");
    for j in 0..len(ss) {
      if i == j { continue; }
      assert(a.sf_name != surface_at(j).sf_name,
             "surfaces {i} and {j} are both called '{a.sf_name}'");
    }
  }
}

fn test_no_surface_is_black() {
  // A surface with no colour is one the eye cannot find and the classifier
  // buckets as `black` — which every gate reads as "nothing drew".
  for i in 0..len(surfaces()) {
    s = surface_at(i);
    assert(s.sf_r + s.sf_g + s.sf_b > 0.06,
           "'{s.sf_name}' is too dark to classify: {s.sf_r},{s.sf_g},{s.sf_b}");
  }
}

// ⚠ THE ONE THAT WOULD HAVE CAUGHT THE FLOOR. Two surfaces must be separable in
// CHROMATICITY — which is what the picture gates classify on — or must say they
// are alike by sharing a bucket. The floor used to sit 0.0003 from the wall
// against a 0.0009 tolerance, so an interior frame reported ONE bucket of 77%
// that was a wall AND the floor it stands on, and no threshold over it could
// mean what it said.
//
// It is stated over the RENDERER's colours, not over the classifier's table,
// because that is where the fix has to live: separating them in a classifier
// leaves the picture just as ambiguous to a person looking at it.
fn test_surfaces_are_separable_or_declared_alike() {
  ss = classified();
  for i in 0..len(ss) {
    for j in 0..len(ss) {
      if j <= i { continue; }
      a = ss[i] ?? surface_at(0);
      b = ss[j] ?? surface_at(0);
      gap = chroma_gap(a, b);
      if a.sf_bucket == b.sf_bucket { continue; }        // declared alike, on purpose
      assert(gap > 0.0009,
             "'{a.sf_name}' and '{b.sf_name}' are {gap} apart in chromaticity — "
             + "under 0.0009 they classify as one surface. Separate them in the "
             + "RENDERER, or give them one bucket and mean it.");
    }
  }
}

// And the control: the pair that IS declared alike must genuinely be too close
// to tell apart, or the exemption is hiding a real distinction.
fn test_the_declared_pair_really_is_indistinguishable() {
  ss = classified();
  pairs = 0;
  for i in 0..len(ss) {
    for j in 0..len(ss) {
      if j <= i { continue; }
      a = ss[i] ?? surface_at(0);
      b = ss[j] ?? surface_at(0);
      if a.sf_bucket != b.sf_bucket { continue; }
      pairs += 1;
      assert(chroma_gap(a, b) <= 0.0009,
             "'{a.sf_name}' and '{b.sf_name}' share a bucket but are {chroma_gap(a, b)} "
             + "apart — they are distinguishable, so the bucket is throwing that away");
    }
  }
  assert(pairs > 0, "no bucket is shared — this control measured nothing");
}

// ── `surface_index` — plan 17 `A8.8`, §P9.13 ────────────────────────────────

fn test_every_surface_finds_its_own_index() {
  // The round trip, over the whole list rather than a sample: a name taken OUT
  // of the list must come back to the slot it was taken from.
  for i in 0..len(surfaces()) {
    got = surface_index(surface_at(i).sf_name);
    assert(got == i, "'{surface_at(i).sf_name}' is at {i} and looked up as {got}");
  }
}

fn test_an_unknown_name_is_minus_one_and_not_a_fallback() {
  // ⚠ THE NEGATIVE CONTROL IS THE POINT. A lookup that fell back to 0 would put
  // a misspelt surface in `grass` and draw it, and the author would be told
  // nothing — the failure §P9.13 refuses by name.
  assert(surface_index("dressed-stone") == 0 - 1, "a misspelling resolved");
  assert(surface_index("") == 0 - 1, "the empty name resolved");
  assert(surface_index("Wall") == 0 - 1, "the lookup is case-insensitive");
}

fn test_the_six_a_panel_can_be_routed_into_all_resolve() {
  // §P9.13: `chunk_mesh_props` is handed these six meshes and no others, so a
  // part's `WALL` surface must be one of them. If a rename ever breaks one of
  // these spellings, the part format's refusal list is wrong and this says so
  // here rather than in a picture.
  for n in ["veg", "roof", "wall", "floor", "frame", "soffit"] {
    if n == "veg" { continue; }   // the vegetation slot is `tree` in the list
    assert(surface_index(n) >= 0, "'{n}' is not a surface any more");
  }
  assert(surface_index("tree") >= 0, "the vegetation surface is not called 'tree'");
}

// ── THE RAMP SLOT — plan 22 `B1b.2c.4b` ─────────────────────────────────────
//
// ⛔ THIS EXISTS BECAUSE THE ANSWER WAS STATED IN THREE PLACES AND ONE OF THEM WAS
// WRONG. `editor_server.loft` asked `surface_ramp` on the dirty-flush path and wrote
// a literal `0` on the chunk-stream path, under a comment claiming the two were the
// same loop — so **water drew flat when a tile came into view and depth-ramped the
// moment anything near it was edited**. One world, two pictures, decided by which
// path delivered the tile. There is one send loop now, and the rule is here.

fn test_every_surface_has_a_ramp_and_it_is_one_of_three() {
  // ⚠ TOTAL OVER THE LIST, which is the half a spot-check cannot cover. A ramp is
  // a MODE the client switches on — `> 1.5` is the depth branch — so a fourth value
  // is not a new look, it is a surface that falls through every branch and draws
  // flat while its author believes otherwise.
  for i in 0..len(surfaces()) {
    r = surface_ramp(surface_at(i).sf_name);
    assert(r == 0 || r == 1 || r == 2,
           "'{surface_at(i).sf_name}' ramps {r}, which is no mode at all");
  }
}

fn test_exactly_one_surface_ramps_by_height_and_one_by_depth() {
  // ⚠ COUNTED, NOT SPOT-CHECKED. `surface_ramp` keys on a NAME, so a rename in
  // `surfaces()` silently turns its answer into the default — and the default is
  // the flat one, which looks like a surface nobody has got round to rather than a
  // surface that lost its ramp. A count over the whole list is what sees that: it
  // goes red on the rename, where an assertion about "grass" would keep passing
  // against a name no surface has.
  by_height = 0;
  by_depth = 0;
  for i in 0..len(surfaces()) {
    r = surface_ramp(surface_at(i).sf_name);
    if r == 1 { by_height = by_height + 1; }
    if r == 2 { by_depth = by_depth + 1; }
  }
  assert(by_height == 1, "{by_height} surfaces ramp by height, want exactly the ground");
  assert(by_depth == 1, "{by_depth} surfaces ramp by depth, want exactly the water");
  // …and WHICH, because "one of each" is satisfied by the wrong pair.
  assert(surface_ramp("grass") == 1, "the ground does not ramp by height");
  assert(surface_ramp("water") == 2, "the water does not ramp by depth");
}

fn test_a_surface_that_is_not_in_the_list_ramps_flat() {
  // The default is reachable and is FLAT, which is what makes the count above the
  // instrument rather than the spelling. ⚠ It is deliberately not a refusal: unlike
  // `surface_index`, this answers a drawing site that already holds a real surface,
  // and there is no picture in which "no ramp" is the wrong thing to do.
  assert(surface_ramp("dressed-stone") == 0, "an unknown surface claimed a ramp");
  assert(surface_ramp("") == 0, "the empty name claimed a ramp");
}

// ── THE SLOT — one surface out of `chunk_meshes_all`'s vector ────────────────

fn test_a_slot_past_the_end_is_an_empty_mesh_and_not_a_crash() {
  // ⚠ AND ITS CONSUMERS READ EMPTY AS A CLEAR. A surface that had geometry and now
  // has none is a mesh to DROP: skipping it leaves the old buffer bound and the
  // picture keeps a fence that was removed — `editor_client.loft`'s `add_mesh`
  // finding, which cost two silently broken mechanisms before anyone photographed
  // it. So an out-of-range slot must be empty rather than absent.
  ms: vector<Mesh> = [mesh("a")];
  assert(len(chunk_mesh_slot(ms, 5).vertices) == 0, "a slot past the end had geometry");
  assert(len(chunk_mesh_slot(ms, 0 - 1).vertices) == 0, "a negative slot had geometry");
}
