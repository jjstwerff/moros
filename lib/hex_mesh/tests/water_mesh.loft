// DEEPER WATER IS DARKER — plan 20 `A10`, and the channel it rides in.
//
// The shade is a pure function of the depth and the pipeline carries it in the
// NORMAL'S LENGTH: the fragment shader normalizes the normal at both its uses and the
// vertex shader's model matrix is rigid, so the magnitude survives unread. Water needs
// one number per vertex and the alternative was a seventh float on a format thirteen
// decoders index by six.
//
// ⚠ SO THE CHANNEL HAS TO BE MEASURED WHERE IT IS EMITTED, not argued from the source.
// A number written into a vertex nothing reads back is the shape this tree keeps
// finding — a rule built, green, and reaching nobody.
use hex_mesh;
use hex_editor;
use hex_voxel;
use graphics;

const U = 0.25;
const G = 200;

fn pond(deeper: integer) -> VoxelWorld {
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 20)..21 {
    for r in (0 - 20)..21 { ground_set(w, q, r, G, SURFACE_MAT); }
  }
  why = "";
  // ⚠ THE FIXTURE STATES THE DEPTH IT WANTS. It used to cut a channel first and let
  // `water_set` keep it — but the depth is the RUN'S alone now, so a pre-cut channel
  // does not survive the water going into it, and a fixture that smuggled its depth
  // through the terrain would come back uniform and test nothing.
  for q3 in 0..8 {
    for r3 in 0..3 {
      d = hex_editor::WATER_DEPTH;
      if r3 == 1 { d = d + deeper; }
      hex_editor::water_set_deep(w, q3, r3, G - 4, 0, d, why);
    }
  }
  w
}

// ── the shade itself ────────────────────────────────────────────────────────

fn test_the_shallowest_water_is_not_shaded_at_all() {
  assert(water_shade(hex_editor::WATER_DEPTH) == 0.0,
         "water at its minimum depth is already shaded {water_shade(hex_editor::WATER_DEPTH)}");
  assert(water_shade(hex_editor::WATER_DEPTH - 4) == 0.0,
         "a depth under the minimum shaded anyway");
}

fn test_it_reaches_full_dark_and_stops() {
  assert(water_shade(WATER_DEEP) == 1.0, "the deep end is {water_shade(WATER_DEEP)}");
  assert(water_shade(WATER_DEEP * 4) == 1.0,
         "past the deep end it kept getting darker: {water_shade(WATER_DEEP * 4)}");
}

fn test_it_only_ever_gets_darker() {
  prev = 0.0 - 1.0;
  for d in 0..(WATER_DEEP + 8) {
    v = water_shade(d);
    assert(v >= prev, "the shade fell from {prev} to {v} at depth {d}");
    prev = v;
  }
}

// ⚠ THE ONE THAT KEEPS EVERY PICTURE GATE WORKING. Each gate reads shares by
// CHROMATICITY, which divides value out by construction — it is why `wall` and `frame`
// are one bucket. A ramp in brightness is therefore invisible to the classifier, and a
// ramp in hue would have made the water bucket unmeasurable the day it landed.
fn test_the_deep_colour_is_the_shallow_one_at_the_same_chromaticity() {
  i = surface_for_mat(hex_editor::WATER_MAT);
  assert(i >= 0, "water has no surface");
  sf = surface_at(i);
  s0 = sf.sf_r + sf.sf_g + sf.sf_b;
  dr = sf.sf_r * WATER_DARK;
  dg = sf.sf_g * WATER_DARK;
  db = sf.sf_b * WATER_DARK;
  s1 = dr + dg + db;
  assert(s1 < s0, "the deep end is not darker at all");
  // exact, because the deep colour is a SCALAR multiple: r/s is unchanged
  for pair in [[sf.sf_r, dr], [sf.sf_g, dg], [sf.sf_b, db]] {
    a = (pair[0] ?? 0.0) / s0 ?? 0.0;
    b = (pair[1] ?? 0.0) / s1 ?? 0.0;
    d = a - b;
    if d < 0.0 { d = 0.0 - d; }
    assert(d < 0.0001,
           "the deep colour moved in chromaticity by {d} — every gate that reads "
           + "shares by hue would move with it");
  }
}

// ── and the channel, measured where it is emitted ───────────────────────────

// The longest and shortest normal in a mesh, as a pair — the channel, read back off
// the vertices rather than taken from the emitter's word.
fn normal_span(m: Mesh, lo: &float, hi: &float) {
  lo = 1000.0;
  hi = 0.0;
  for v in m.vertices {
    n = v.normal;
    l = sqrt(n.x * n.x + n.y * n.y + n.z * n.z) ?? 0.0;
    if l < lo { lo = l; }
    if l > hi { hi = l; }
  }
}

fn test_a_water_mesh_carries_its_depth_and_a_ground_mesh_does_not() {
  w = pond(24);
  wm = chunk_mesh_mat(0, 0, w, hex_editor::WATER_MAT);
  assert(len(wm.vertices) > 0, "no water was meshed at all");
  wlo = 0.0;
  whi = 0.0;
  normal_span(wm, wlo, whi);
  assert(whi > 1.0 + 0.05,
         "no water vertex carries a depth: the longest normal is {whi}");
  assert(wlo >= 1.0 - 0.0001,
         "a water normal came out SHORTER than one ({wlo}), so the channel is signed "
         + "where the shader clamps it at zero");
  assert(whi - wlo > 0.05,
         "every water vertex carries the same depth ({wlo}..{whi}) — the channel is "
         + "there and the fixture has no channel to show");

  // ⚠ AND THE CONTROL IS THE GROUND, in the same world and the same chunk. The shader
  // reads `length(vNrm) - 1.0`, so every other surface must be exactly one or it would
  // be quietly ramped too.
  gm = chunk_mesh_mat(0, 0, w, SURFACE_MAT);
  assert(len(gm.vertices) > 0, "no ground was meshed, so the control is empty");
  glo = 0.0;
  ghi = 0.0;
  normal_span(gm, glo, ghi);
  d = ghi - 1.0;
  if d < 0.0 { d = 0.0 - d; }
  assert(d < 0.0001,
         "a ground normal is {ghi} long, so the ground would take the depth ramp too");
}

// ── A SPRING IS A TRICKLE, NOT A FULL HEX ───────────────────────────────────

fn test_the_inset_narrows_a_spring_and_lets_a_full_channel_alone() {
  assert(water_inset(hex_editor::WATER_DEPTH) == WATER_TRICKLE,
         "a spring is drawn {water_inset(hex_editor::WATER_DEPTH)} of its cell wide");
  full = hex_editor::WATER_DEPTH + hex_editor::WATER_STEP;
  assert(water_inset(full) == 1.0,
         "a channel one widening deep is {water_inset(full)} of its cell");
  assert(water_inset(full * 4) == 1.0, "a deep channel narrowed again");
  prev = 0.0;
  for d in hex_editor::WATER_DEPTH..(full + 2) {
    assert(water_inset(d) >= prev, "the width fell at depth {d}");
    prev = water_inset(d);
  }
}

// ⚠ MEASURED IN THE EMITTED MESH, and ACROSS THE FLOW rather than in the round. The
// inset keeps the along-flow component of every corner exactly — insetting both ways
// would leave a river of consecutive cells as a line of islands rather than a thread —
// so a bounding box in the round cannot see it and a spread along `z` can.
fn test_a_spring_is_drawn_narrower_than_the_cell_it_is_in() {
  w = pond(24);
  wm = chunk_mesh_mat(0, 0, w, hex_editor::WATER_MAT);
  assert(len(wm.vertices) > 0, "no water was meshed");
  // the river in `pond` runs EAST, so across the flow is `z`
  lo = 1000.0;
  hi = 0.0 - 1000.0;
  for v in wm.vertices {
    if v.pos.z < lo { lo = v.pos.z; }
    if v.pos.z > hi { hi = v.pos.z; }
  }
  span = hi - lo;
  // ⚠ DERIVED FROM THE DIAL, NOT CALIBRATED TO IT. This was `< 4.0`, measured at
  // `WATER_TRICKLE` 0.34 — and turning the dial to 0.6 took the span to 4.2 and the row
  // red, reporting *every cell drawn full width* about a river that was not. A bound
  // that has to be re-measured whenever the number it bounds moves is not a test of the
  // rule, it is a snapshot of one setting.
  //
  // Three rows 1.5 apart put the outer centres 3.0 apart, and a pointy-top hex reaches
  // 1.0 in `z` either way — so full width is 5.0 and the inset ones give
  // `3.0 + 2 x WATER_TRICKLE`. The middle row is deep, hence full width, and does not
  // reach past them.
  want = 3.0 + 2.0 * WATER_TRICKLE;
  off = span - want;
  if off < 0.0 { off = 0.0 - off; }
  assert(off < 0.2,
         "the water spans {span} across the flow against the {want} that "
         + "WATER_TRICKLE {WATER_TRICKLE} predicts");
  assert(span < 4.9, "the water spans {span} — every cell is drawn full width");
  // ⚠ AND ALONG THE FLOW IT IS UNTOUCHED. The fixture's cells run `q = 0..7`, so their
  // centres span `7 x √3 = 12.12` and a full-width hex adds half a width at each end:
  // **13.85**.
  //
  // ⚠ THIS ROW IS NOT KNOWN TO DISCRIMINATE, AND THAT IS SAID RATHER THAN ASSUMED. The
  // sabotage it was written for — insetting in the round, which would leave a river of
  // consecutive cells as a line of ISLANDS — passes it, and two attempts at a fixture
  // that would separate them did not. So what is gated below is the across-flow inset
  // (the row above, which the sabotage does fail); this bound is a sanity check on the
  // along-flow extent and is worth keeping for that alone. A test whose header claims
  // coverage it does not have is worse than no test.
  // ⚠ AN ALL-SHALLOW FIXTURE, because `pond(24)` has a deep middle row drawn at FULL
  // width — and that row alone sets the along-flow extent, so the round-inset sabotage
  // passed this row until the fixture stopped hiding it.
  w0 = pond(0);
  wm0 = chunk_mesh_mat(0, 0, w0, hex_editor::WATER_MAT);
  xlo = 1000.0;
  xhi = 0.0 - 1000.0;
  for v2 in wm0.vertices {
    if v2.pos.x < xlo { xlo = v2.pos.x; }
    if v2.pos.x > xhi { xhi = v2.pos.x; }
  }
  assert(xhi - xlo > 13.2,
         "the water spans {xhi - xlo} ALONG the flow against 13.85 at full width — the "
         + "inset is being applied in the round, so the river is stepping stones");
}
