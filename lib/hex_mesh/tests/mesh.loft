//
// THE TERRAIN MESH, WITHOUT A SERVER.
//
// It moved out of `editor_server.loft` so that plan 16's S3 can have the CLIENT run
// it over its own voxel cache — and the whole S3 claim is *the server's own function,
// unmodified*, which is only checkable while there is one function. These are the
// claims that hold whoever calls it.
use hex_mesh;
use hex_world;
use hex_editor;

fn world() -> World {
  w = world_new(0.25, 0, 10, 4).wn_world;
  for q in 0 - 4..13 {
    for r in 0 - 4..13 { hex_editor::ground_set(w, q, r, 40 + q, hex_editor::SURFACE_MAT); }
  }
  w
}

fn test_the_mesh_tile_is_not_the_store_tile() {
  // ⚠ THE ONE THAT WOULD BE SILENT AND SEVERE. The store tiles at `CHUNK_W` for
  // windowing and elision; the renderer tiles at `MESH_CHUNK` because that is what a
  // rebuild costs. A reader who assumed they were the same would ask for chunk (2,3)
  // and be handed the cells of another — with no error anywhere.
  assert(hex_mesh::MESH_CHUNK != hex_world::CHUNK_W,
         "the two tiles are different questions: {hex_mesh::MESH_CHUNK} vs {hex_world::CHUNK_W}");
  assert(hex_world::CHUNK_W % hex_mesh::MESH_CHUNK == 0,
         "and the store's tile is a whole number of the renderer's");
}

fn test_a_chunk_of_ground_becomes_triangles() {
  w = world();
  m = hex_mesh::chunk_mesh_mat(0, 0, w, hex_editor::SURFACE_MAT);
  // Seven vertices a cell — a shared centre and six corners — over the tile.
  want = hex_mesh::MESH_CHUNK * hex_mesh::MESH_CHUNK * 7;
  assert(len(m.vertices) == want,
         "{hex_mesh::MESH_CHUNK}^2 cells at 7 vertices = {want}, got {len(m.vertices)}");
  assert(len(m.triangles) == hex_mesh::MESH_CHUNK * hex_mesh::MESH_CHUNK * 6,
         "and six triangles a cell, got {len(m.triangles)}");
}

fn test_it_meshes_only_the_material_it_was_asked_for() {
  // ⚠ THE CONTROL, and without it every count above passes on a mesher that ignores
  // its argument. One mesh per material per chunk is why the argument exists.
  w = world();
  ground = hex_mesh::chunk_mesh_mat(0, 0, w, hex_editor::SURFACE_MAT);
  road = hex_mesh::chunk_mesh_mat(0, 0, w, hex_editor::ROAD_MAT);
  assert(len(ground.vertices) > 0, "the ground is there");
  assert(len(road.vertices) == 0, "and no cell carries road, so that mesh is empty");
}

fn test_the_ground_follows_its_own_heights() {
  // The fan is the SMOOTHED field, so a slope drawn over rising ground has to rise —
  // a mesher that dropped `wld` and drew a plane would pass every count above.
  w = world();
  m = hex_mesh::chunk_mesh_mat(0, 0, w, hex_editor::SURFACE_MAT);
  lo = 1000000.0;
  hi = 0.0 - 1000000.0;
  for v in m.vertices {
    if v.pos.y < lo { lo = v.pos.y; }
    if v.pos.y > hi { hi = v.pos.y; }
  }
  assert(hi > lo, "the drawn ground rises across the tile: {lo} .. {hi}");
}

fn test_the_oracle_says_no_before_the_neighbourhood_arrives() {
  // ⚠ THE GUARD IS THE WHOLE OF S3's CORRECTNESS. `probe/s3/s3_stream_order.loft`
  // measured 81 of 81 tiles matching the server when their margin was cached, and 32
  // of 40 failing when it was not — so "may I mesh this yet" is the only question
  // between a client that agrees and one that does not.
  full = world();
  assert(hex_mesh::tile_ready(full, 0, 0), "a complete world can answer for a tile");

  // A world holding ONE chunk cannot answer for a tile on that chunk's edge, because
  // the mesher reads two cells past it.
  one = world_new(0.25, 0, 10, 4).wn_world;
  for q in 0..hex_world::CHUNK_W {
    for r in 0..hex_world::CHUNK_W {
      hex_editor::ground_set(one, q, r, 40, hex_editor::SURFACE_MAT);
    }
  }
  assert(hex_mesh::tile_ready(one, 1, 1),
         "a tile well inside the one chunk it holds is answerable");
  assert(!hex_mesh::tile_ready(one, 0, 0),
         "but the tile at its corner is not — the margin reaches the chunk before it");
  edge = hex_world::CHUNK_W / hex_mesh::MESH_CHUNK - 1 ?? 0;
  assert(!hex_mesh::tile_ready(one, edge, edge),
         "nor the tile at the far corner, for the same reason one axis over");
}

fn test_the_margin_is_the_grid_the_mesher_actually_builds() {
  // A guard that asked about the TILE rather than its margin would pass everything and
  // protect nothing — this pins it to the grid `chunk_mesh_mat` really constructs.
  assert(hex_mesh::MESH_MARGIN == 2,
         "the height grid is MESH_CHUNK + 4, offset -2");
  assert(hex_mesh::MESH_CHUNK + 2 * hex_mesh::MESH_MARGIN
         <= hex_world::CHUNK_W,
         "and a tile's footprint spans at most two store chunks per axis, "
       + "which is what makes the four-corner test complete");
}

// ── A WORLD THAT ENDS (plan 18 `B5.2`) ───────────────────────────────────────
//
// `chunk_mesh_mat` treats an unwritten cell as GROUND, which is what makes an
// unauthored world a plane rather than a hole. A PART is a world to the store and
// is not one to the mesher: it is bounded, so its unwritten cells are outside it.

// A part-shaped world: one small clump of written cells, and nothing else.
fn clump() -> World {
  w = world_new(0.25, 0, 10, 4).wn_world;
  for q in 3..6 {
    for r in 3..6 { hex_editor::ground_set(w, q, r, 40, hex_editor::SURFACE_MAT); }
  }
  w
}

fn ground_verts(w: World, bounded: boolean) -> integer {
  m = if bounded {
        hex_mesh::chunk_mesh_mat_bounded(0, 0, w, hex_editor::SURFACE_MAT)
      } else {
        hex_mesh::chunk_mesh_mat(0, 0, w, hex_editor::SURFACE_MAT)
      };
  len(m.vertices)
}

fn test_a_bounded_world_draws_only_what_was_written() {
  w = clump();
  loose = ground_verts(w, false);
  tight = ground_verts(w, true);
  // ⚠ THE NUMBER, NOT JUST THE INEQUALITY. Nine cells at seven vertices a fan is
  // 63; a whole 8x8 mesh tile is 448. "Fewer" would pass on a mesher that dropped
  // one cell, and this is a claim about dropping sixty-three of seventy-two.
  assert(tight == 63, "nine written cells is nine fans of seven: got {tight}");
  assert(loose == 448, "and the unbounded pass fills the tile: got {loose}");
}

// ⚠ THE CONTROL, AND IT IS THE HALF THAT SAYS THE FLAG IS NARROW. A `bounded`
// that simply emitted less would pass the test above perfectly. On a world with
// every cell written the two must be IDENTICAL — there is no absence to differ
// over — so this is what stops the flag quietly becoming a second mesher.
fn test_a_full_world_meshes_the_same_either_way() {
  w = world();
  assert(ground_verts(w, true) == ground_verts(w, false),
         "a fully written tile meshes to {ground_verts(w, true)} bounded "
       + "and {ground_verts(w, false)} unbounded");
  assert(ground_verts(w, true) > 0, "and it is not vacuously zero on both sides");
}

// ⚠ AND ONLY THE GROUND CAN DIFFER, which falls out of the substitution rather
// than being a case in the loop: an unwritten cell is turned into `SURFACE_MAT`,
// so it can only ever join the surface pass. A road, a field or a floor asked for
// over the same clump must be the same triangles either way — stated here so that
// a future `bounded` reaching further has something to break.
fn test_bounding_touches_no_surface_but_the_ground() {
  w = clump();
  // ⚠ THE OTHER MATERIALS ARE WRITTEN FIRST, and the first draft of this test did
  // not: over a clump of plain ground every one of them meshes to nothing, so it
  // compared 0 with 0 three times and would have passed against ANY `bounded`,
  // including one that emptied every pass. A control has to have something to lose.
  hex_editor::ground_set(w, 3, 3, 40, hex_editor::ROAD_MAT);
  hex_editor::ground_set(w, 4, 3, 40, hex_editor::FIELD_MAT);
  hex_editor::ground_set(w, 5, 3, 40, hex_editor::FLOOR_MAT);
  for mat in [hex_editor::ROAD_MAT, hex_editor::FIELD_MAT, hex_editor::FLOOR_MAT] {
    a = len(hex_mesh::chunk_mesh_mat(0, 0, w, mat).vertices);
    b = len(hex_mesh::chunk_mesh_mat_bounded(0, 0, w, mat).vertices);
    assert(a > 0, "material {mat} meshed nothing — the claim is vacuous");
    assert(a == b, "material {mat} meshed {a} unbounded and {b} bounded");
  }
}
