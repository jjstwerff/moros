// THE PLAN VIEW DRAWS WHAT THE STORE HOLDS — plan 26 `B0`.
//
// ⚠ EVERY ASSERTION BELOW READS THE EMITTED TEXT. Not a count the emitter
// returned, not a field it filled in: `CLAUDE.md` — *measure what was actually
// emitted, never a number the producer re-derives*. `plan_svg` returns text and
// nothing else for exactly this reason, and the parser here is the test's own.
//
// ⚠ AND THE PARSER IS CHECKED AGAINST SOMETHING IT SHOULD FIND BEFORE IT IS
// TRUSTED TO REPORT AN ABSENCE. A grep over a picture has the same default answer
// as a grep over a log — *absent* — so the first test below counts a world with
// walls in it, and only then a world without.
//
// ⚠ THE ORACLE FOR EVERY POSITION IS THE MESHER'S OWN THREE CALLS, written out
// here rather than taken from `plan_slot_seg`: `hex_edge_corners`, the `(6 - c) % 6`
// join, `hex_corner_world`. A test that asked the helper what the helper says
// could not be surprised by any of the four faults this file exists to catch.
use hex_mesh;
use hex_voxel;
use hex_editor;
use hex_grid;
use hex_proj;
use hex_way;

const U = 0.25;
// ⚠ **A WALL BYTE NOTHING EXPLAINS — and at plan 26 `B4e` the reason changed.** It
// used to be *a byte the editor has no name for*; an edge byte is a palette slot now,
// so `7` is a perfectly good wall type — what makes it loud is that **no world here
// declares it**. The distinction is the whole of `edge_colour`'s second argument.
const UNKNOWN_MAT = 7;

fn about(a: float, b: float) -> boolean { a - b < 0.0001 && b - a < 0.0001 }

fn flat_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  for q in 0 - 10..14 {
    for r in 0 - 10..14 { hex_editor::ground_set(w, q, r, 8, hex_editor::SURFACE_MAT); }
  }
  w
}

// ── The test's own reader ───────────────────────────────────────────────────

fn attr(ln: text, name: text) -> text {
  at = ln.find("{name}='");
  if at == null { return ""; }
  rest = ln[(((at ?? 0) + name.size() + 2) as i32)..];
  cut = rest.find("'");
  if cut == null { return ""; }
  rest[0..(cut ?? 0)]
}

// ⚠ THE PICTURE NOW HOLDS TWO KINDS OF LINE — plan 26 `B1` — so every count has to
// name which. `<line class='edge'>` is a stored wall byte (the FIELD) and
// `<line class='run'>` is what the reader made of them (the DESCRIPTION). A count of
// `<line` alone read 2 for one wall the moment the description arrived, which is what
// these tests caught on the step that added it.
const FIELD = "<line class='edge'";
const DESCR = "<line class='run'";

fn tag_count(svg: text, head: text) -> integer {
  n = 0;
  for ln in svg.split('\n') {
    if ln.size() < head.size() { continue; }
    if ln[0..(head.size() as i32)] == head { n = n + 1; }
  }
  n
}

// The emitted `<line>` for one slot of one cell, or "" when the picture does not
// draw it. ⚠ THE ABSENCE IS THE ANSWER IN TWO TESTS BELOW, which is why the
// count above is checked first.
fn edge_line(svg: text, q: integer, r: integer, slot: integer) -> text {
  for ln in svg.split('\n') {
    if ln.size() < (FIELD.size() as i32) { continue; }
    if ln[0..(FIELD.size() as i32)] != FIELD { continue; }
    if attr(ln, "data-q") == "{q}" && attr(ln, "data-r") == "{r}"
       && attr(ln, "data-slot") == "{slot}" { return ln; }
  }
  ""
}

fn cell_poly(svg: text, q: integer, r: integer) -> text {
  for ln in svg.split('\n') {
    if ln.size() < 9 { continue; }
    if ln[0..9] != "<polygon " { continue; }
    if attr(ln, "data-q") == "{q}" && attr(ln, "data-r") == "{r}" { return ln; }
  }
  ""
}

// ── The oracle: the three calls the mesher makes, spelled out ───────────────

fn slot_dir(slot: integer) -> integer {
  if slot == 0 { return 4; }        // SLOT_NW
  if slot == 1 { return 5; }        // SLOT_NE
  0                                 // SLOT_E
}

fn corner_a(q: integer, r: integer, slot: integer) -> Vec3 {
  (ca, _) = hex_grid::hex_edge_corners(slot_dir(slot));
  hex_proj::hex_corner_world(q, r, 0, (6 - ca) % 6)
}

fn corner_b(q: integer, r: integer, slot: integer) -> Vec3 {
  (_, cb) = hex_grid::hex_edge_corners(slot_dir(slot));
  hex_proj::hex_corner_world(q, r, 0, (6 - cb) % 6)
}

// ── 1. The reader finds a wall, and only then is its silence worth anything ──

fn test_the_reader_counts_a_wall_before_it_is_trusted_to_count_none() {
  w = flat_world();
  hex_editor::wall_set(w, 2, 1, 0, hex_editor::WALL_MAT, 8, 2.0);
  with_wall = plan_svg(w, 0, 0, 5, 5, 2.0, "one");
  assert(tag_count(with_wall, FIELD) == 1,
         "the reader found {tag_count(with_wall, FIELD)} edges where one wall "
         + "was written — if this is 0 every absence below is the reader's, not the picture's");

  bare = plan_svg(flat_world(), 0, 0, 5, 5, 2.0, "none");
  assert(tag_count(bare, FIELD) == 0,
         "a world with no wall drew {tag_count(bare, FIELD)} edges");
  assert(tag_count(bare, "<polygon ") == 25,
         "a 5x5 window drew {tag_count(bare, \"<polygon \")} cells, not 25 — every "
         + "cell of the window is drawn, so an empty one reads as empty and not as absent");
}

// ── 2. One mark per stored byte, against a walk of the store ────────────────

fn test_the_marks_are_the_stores_own_bytes_counted_a_second_way() {
  w = flat_world();
  // Five edges over four cells and all three slots, in three materials plus one
  // the editor has no name for.
  hex_editor::wall_set(w, 1, 1, 4, hex_editor::WALL_MAT,  8, 2.0);   // SLOT_NW
  hex_editor::wall_set(w, 1, 1, 5, hex_editor::DOOR_MAT,  8, 2.0);   // SLOT_NE
  hex_editor::wall_set(w, 1, 1, 0, hex_editor::WALL_MAT,  8, 2.0);   // SLOT_E
  hex_editor::wall_set(w, 3, 2, 0, hex_editor::FENCE_MAT, 8, 2.0);
  hex_editor::wall_set(w, 2, 3, 4, UNKNOWN_MAT,           8, 2.0);
  svg = plan_svg(w, 0, 0, 6, 6, 2.0, "five");

  // ⚠ THE SECOND COUNT READS THE CELL'S FIELDS, never `wall_of` — the emitter
  // uses `wall_of`, so a count through it would be the same path twice and could
  // not see a reader that named the wrong slot.
  held = 0;
  for r in 0..6 {
    for q in 0..6 {
      li = hex_editor::edge_layer(w, q, r, 2.0);
      if li < 0 { continue; }
      c = hex_voxel::world_cell(w, q, r, li);
      if (c.h_wall_nw as integer ?? 0) != 0 { held = held + 1; }
      if (c.h_wall_ne as integer ?? 0) != 0 { held = held + 1; }
      if (c.h_wall_e  as integer ?? 0) != 0 { held = held + 1; }
    }
  }
  assert(held == 5, "the fixture wrote {held} bytes, not the 5 it asked for");
  assert(tag_count(svg, FIELD) == held,
         "the picture drew {tag_count(svg, FIELD)} edges and the store holds {held}");

  // …and each one is the material it was written with, not a default.
  assert(attr(edge_line(svg, 1, 1, hex_editor::SLOT_NE), "data-mat") == "{hex_editor::DOOR_MAT}",
         "the door drew as material {attr(edge_line(svg, 1, 1, hex_editor::SLOT_NE), \"data-mat\")}");
  assert(attr(edge_line(svg, 3, 2, hex_editor::SLOT_E), "data-mat") == "{hex_editor::FENCE_MAT}",
         "the fence drew as material {attr(edge_line(svg, 3, 2, hex_editor::SLOT_E), \"data-mat\")}");
}

// ── 3. `plan_slot_seg` IS the mesher's three calls, over a range ─────────────

fn test_the_segment_agrees_with_the_meshers_own_spelling() {
  for r in 0 - 3..4 {
    for q in 0 - 3..4 {
      for slot in 0..3 {
        s = plan_slot_seg(q, r, slot);
        a = corner_a(q, r, slot);
        b = corner_b(q, r, slot);
        assert(about(s.ps_x1, a.x) && about(s.ps_z1, a.z)
               && about(s.ps_x2, b.x) && about(s.ps_z2, b.z),
               "slot {slot} of ({q},{r}) is ({s.ps_x1},{s.ps_z1})-({s.ps_x2},{s.ps_z2}); "
               + "the mesher's own three calls give ({a.x},{a.z})-({b.x},{b.z})");
      }
    }
  }
}

// ── 4. And the NUMBERS IN THE FILE are those numbers ─────────────────────────

fn test_the_picture_carries_the_librarys_own_coordinates() {
  w = flat_world();
  // ⚠ (3,0) SLOT E IS THE PLAN'S OWN PRE-REGISTERED CASE, not a cell chosen after
  // the fact — `plans/26-blueprint/README.md` § Invariant gate names this exact
  // `wall_set` and these exact two corners.
  hex_editor::wall_set(w, 3, 0, 0, hex_editor::WALL_MAT, 8, 2.0);
  svg = plan_svg(w, 0, 0, 5, 5, 2.0, "one");
  ln = edge_line(svg, 3, 0, hex_editor::SLOT_E);
  assert(ln != "", "the wall on slot E of (3,0) is not in the picture at all");

  a = corner_a(3, 0, hex_editor::SLOT_E);
  b = corner_b(3, 0, hex_editor::SLOT_E);
  x1 = attr(ln, "x1") as float ?? 0.0 - 999.0;
  y1 = attr(ln, "y1") as float ?? 0.0 - 999.0;
  x2 = attr(ln, "x2") as float ?? 0.0 - 999.0;
  y2 = attr(ln, "y2") as float ?? 0.0 - 999.0;
  assert(about(x1, a.x) && about(y1, a.z),
         "the mark starts at ({x1},{y1}); the corner is at ({a.x},{a.z})");
  assert(about(x2, b.x) && about(y2, b.z),
         "the mark ends at ({x2},{y2}); the corner is at ({b.x},{b.z})");
  // ⚠ THE VIEWBOX IS IN THE SAME UNITS, which is what makes the two lines above a
  // comparison at all: a picture that scaled its geometry would need the test to
  // know the scale, and a wrong scale would then agree with itself.
  assert(svg.contains("viewBox='"), "no viewBox — the numbers above are in no frame");
}

// ── 5. The window is half-open, and nothing outside it is drawn ─────────────

fn test_a_cell_outside_the_window_is_not_in_the_picture() {
  w = flat_world();
  hex_editor::wall_set(w, 4, 1, 0, hex_editor::WALL_MAT, 8, 2.0);   // inside [0,5)
  hex_editor::wall_set(w, 5, 1, 0, hex_editor::WALL_MAT, 8, 2.0);   // the first cell outside
  svg = plan_svg(w, 0, 0, 5, 5, 2.0, "bound");

  assert(edge_line(svg, 4, 1, hex_editor::SLOT_E) != "",
         "the wall at q=4 is inside a window of [0,5) and is not drawn");
  assert(edge_line(svg, 5, 1, hex_editor::SLOT_E) == "",
         "the wall at q=5 is outside a window of [0,5) and was drawn anyway — "
         + "the bound is inclusive, so every window overreaches by one row and one column");
  assert(cell_poly(svg, 5, 1) == "", "cell (5,1) is outside the window and was drawn");
  assert(tag_count(svg, FIELD) == 1, "{tag_count(svg, FIELD)} edges drawn, not 1");
}

// ── 6. A cell carries its own material, and an unknown edge is not a wall ────

fn test_a_cell_draws_its_material_and_an_unknown_edge_is_loud() {
  w = flat_world();
  hex_editor::ground_set(w, 1, 1, 8, hex_editor::ROAD_MAT);
  hex_editor::wall_set(w, 2, 2, 0, hex_editor::WALL_MAT, 8, 2.0);
  hex_editor::wall_set(w, 3, 3, 0, UNKNOWN_MAT,          8, 2.0);
  svg = plan_svg(w, 0, 0, 5, 5, 2.0, "mats");

  assert(attr(cell_poly(svg, 1, 1), "data-mat") == "{hex_editor::ROAD_MAT}",
         "the road cell drew as material {attr(cell_poly(svg, 1, 1), \"data-mat\")}");
  assert(attr(cell_poly(svg, 0, 0), "data-mat") == "{hex_editor::SURFACE_MAT}",
         "the grass cell drew as material {attr(cell_poly(svg, 0, 0), \"data-mat\")}");
  assert(attr(cell_poly(svg, 1, 1), "fill") != attr(cell_poly(svg, 0, 0), "fill"),
         "a road and a field drew the same fill — the plan cannot show what it is made of");

  known = attr(edge_line(svg, 2, 2, hex_editor::SLOT_E), "stroke");
  odd   = attr(edge_line(svg, 3, 3, hex_editor::SLOT_E), "stroke");
  assert(known != "" && odd != "", "one of the two edges is missing from the picture");
  assert(known != odd,
         "a byte NOTHING DECLARES drew exactly like a wall ({odd}) — an instrument that "
         + "explains what it cannot explain is the confident hexagon again");
}

// ── `B1` — THE DESCRIPTION, DRAWN OVER THE FIELD IT CAME FROM ────────────────
//
// ⚠ THE TWO TESTS BELOW ARE A PAIR AND NEITHER IS WORTH ANYTHING ALONE. The first
// says the instrument draws a true description when there is one; the second says it
// draws a FALSE one when the library returns a false one — which is the whole reason
// the picture exists, because `wall_read_run` reads a chain's two ends and is blind
// to the path between them (`probe/l1` `P4`, refuted).

fn desc_line(svg: text) -> text {
  for ln in svg.split('\n') {
    if ln.size() < (DESCR.size() as i32) { continue; }
    if ln[0..(DESCR.size() as i32)] == DESCR { return ln; }
  }
  ""
}

fn fnum(ln: text, name: text) -> float {
  attr(ln, name) as float ?? 0.0 - 999.0
}

// How far the FIELD's marks stray from the DESCRIPTION's line — the picture's own
// question, measured off the emitted text with the family's own distance primitive.
// −1.0 when no description was drawn, which is not a small stray and must not read
// as one.
fn max_stray(svg: text) -> float {
  dl = desc_line(svg);
  if dl == "" { return 0.0 - 1.0; }
  t = hex_way::track_new();
  hex_way::track_straight(t, fnum(dl, "x1"), fnum(dl, "y1"),
                             fnum(dl, "x2"), fnum(dl, "y2"));
  worst = 0.0;
  for ln in svg.split('\n') {
    if ln.size() < (FIELD.size() as i32) { continue; }
    if ln[0..(FIELD.size() as i32)] != FIELD { continue; }
    mx = (fnum(ln, "x1") + fnum(ln, "x2")) / 2.0 ?? 0.0;
    my = (fnum(ln, "y1") + fnum(ln, "y2")) / 2.0 ?? 0.0;
    d = hex_way::seg_distance(t, 0, mx, my);
    if d > worst { worst = d; }
  }
  worst
}

fn ends_match(ln: text, ax: float, az: float, bx: float, bz: float) -> boolean {
  fwd = about(fnum(ln, "x1"), ax) && about(fnum(ln, "y1"), az)
     && about(fnum(ln, "x2"), bx) && about(fnum(ln, "y2"), bz);
  rev = about(fnum(ln, "x1"), bx) && about(fnum(ln, "y1"), bz)
     && about(fnum(ln, "x2"), ax) && about(fnum(ln, "y2"), az);
  fwd || rev
}

fn test_the_description_is_the_run_the_editor_authored() {
  w = flat_world();
  d = hex_editor::run_between(0.0, 0.0, 6.0, 0.0, hex_editor::WALL_MAT);
  assert(d.rd_ok, "the editor's own `H1a` path refused to draft a run: {d.rd_why}");
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
  svg = plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, "run");

  assert(tag_count(svg, FIELD) == m / 2,
         "{tag_count(svg, FIELD)} marks drawn against {m} the stamp counted — "
         + "`wall_stamp` writes every edge from both of its cells, so `marked` is "
         + "double what the store holds (`probe/l1`)");
  ln = desc_line(svg);
  assert(ln != "", "no description was drawn for a run the editor itself laid");
  assert(ends_match(ln, d.rd_run.wr_x0, d.rd_run.wr_z0,
                        d.rd_run.wr_x1, d.rd_run.wr_z1),
         "the drawn description ({fnum(ln, \"x1\")},{fnum(ln, \"y1\")})-"
         + "({fnum(ln, \"x2\")},{fnum(ln, \"y2\")}) is not the authored run "
         + "({d.rd_run.wr_x0},{d.rd_run.wr_z0})-({d.rd_run.wr_x1},{d.rd_run.wr_z1}) "
         + "— compared in either order, because the field stores no orientation");

  // ⚠ AND THE TWO ARE IN ONE FRAME, WHICH THIS IS THE ONLY CHECK OF. The marks come
  // from `hex_proj::hex_corner_world`; the line comes from `hex_shape::tri_x/tri_y`
  // through `wall_recover`. Nothing else in this tree compares those two frames, and
  // a mirror or a swapped axis between them would draw a plausible picture in which
  // the description simply misses its own wall.
  st = max_stray(svg);
  assert(st >= 0.0, "no description to measure against");
  assert(st < 0.6,
         "the description strays {st} world units from the marks it was recovered "
         + "FROM — a hex is 1.0 across, so anything near that means the field and "
         + "the description are not being drawn in one frame");
}

fn test_a_wandering_chain_draws_a_description_that_misses_its_own_wall() {
  w = flat_world();
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  // The gesture's own geometry before `H1a`: an anchor wherever the author stood, a
  // length wherever they stopped, an angle off the lattice. 15 degrees — the case
  // `probe/l1` measured reading back as 30.
  // ⚠ **THE ANCHOR IS OFF A CELL CENTRE ON PURPOSE — plan 26 `B4r`.** It used to be
  // `(0, 0)`, which IS a cell centre, so the line ran exactly through one; with the
  // halfplane's tie-break settled that chain leaves 7 marks that are not a path and is
  // refused. `B1`'s claim is about the ANGLE, and nothing authors an anchor like it.
  ang = 15.0 / 57.29577951308232;
  hex_editor::wall_stamp(w, hex_editor::WallRun { wr_base: 0, wr_up: 0,
                              wr_x0: 0.4, wr_z0: 0.3,
                              wr_x1: 0.4 + cos(ang) * 6.0, wr_z1: 0.3 + sin(ang) * 6.0,
                              wr_mat: hex_editor::WALL_MAT, wr_step: 1 },
                         hex_editor::WALL_MAT, 8, rs, m);
  svg = plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, "wander");

  assert(tag_count(svg, FIELD) > 0, "the wandering stamp marked nothing to draw");
  ln = desc_line(svg);
  assert(ln != "",
         "the reader REFUSED this chain. That would be better behaviour and it is not "
         + "what `probe/l1` measured — if the library has gained a path check, this "
         + "test is the news");
  // ⚠ **AND `B4q` MAKES THAT AN INTEGER RATHER THAN A DISTANCE.** The row below reads
  // the miss off the picture in world units; the residual counts the edges exactly, and
  // a description that reproduced its own field would report zero of both.
  assert((attr(ln, "data-stray") as integer ?? 0) > 0
         || (attr(ln, "data-missing") as integer ?? 0) > 0,
         "a chain 15 degrees off the lattice reproduces its own field exactly — "
       + "stray {attr(ln, "data-stray")}, missing {attr(ln, "data-missing")}");
  assert(!ends_match(ln, 0.4, 0.3, 0.4 + cos(ang) * 6.0, 0.3 + sin(ang) * 6.0),
         "the description is the authored line after all, so this fixture is not "
         + "wandering and the pair above proves nothing");

  st = max_stray(svg);
  assert(st > 0.6,
         "the false description strays only {st} from its marks, where the true one "
         + "stays under 0.6 — the picture cannot show a difference it does not have");
}

// ⚠ THE CAPTION IS A CLAIM THE PICTURE MAKES ABOUT ITSELF, so it is checked like
// one. `B0`'s lesson was that two silences must not read alike — *no marks at all*
// and *marks the reader refused* are different facts — and the caption is the only
// place a reader can tell them apart.
fn caption(svg: text) -> text {
  for ln in svg.split('\n') {
    if ln.size() < 6 { continue; }
    if ln[0..6] == "<text " { return ln; }
  }
  ""
}

// ⚠ **A FIELD NO READER EXPLAINS — AND FINDING ONE MOVED WITH `B4x`.** Seven hexagonal
// cell outlines in a row: 36 marks, no chain end for the pool, no disc that reproduces
// them, no floor for the house reader, and no cut of the chain that covers them. Measured
// — `desc refused (36 marks)`.
fn row_world() -> VoxelWorld {
  w = flat_world();
  for k in 0..7 {
    for d in 0..6 {
      hex_editor::wall_set(w, k - 3, 0, d, hex_editor::WALL_MAT, 8, 2.0);
    }
  }
  w
}

fn test_the_caption_says_what_the_picture_shows() {
  w = flat_world();
  d = hex_editor::run_between(0.0, 0.0, 6.0, 0.0, hex_editor::WALL_MAT);
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
  drawn = plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, "run");
  cap = caption(drawn);
  assert(cap != "", "the picture carries no caption at all");
  assert(cap.contains("run d"),
         "a run WAS drawn and the caption does not say so: {cap}");

  // …and a window with marks the reader refuses must say `refused`, not `none`.
  //
  // ⛔ **THE FIXTURE WAS A DOMINO'S OUTLINE AND `B4x` MOVED THAT BOUNDARY ON PURPOSE.**
  // A closed loop used to defeat every reader — no chain end for the pool — and
  // `run_chain_within` now cuts one into spans, so the domino describes
  // `run d2 p3 + run d8 p1 + run d0 p2` with nothing over. That is the acceptance
  // `FORMAL_CORE` §6 states, and `hex_editor/tests/peel.loft`'s
  // `test_a_closed_outline_no_round_reader_explains_is_cut_into_runs` says so in the
  // package that changed. ⚠ **This row is not about that**: it wants a field where every
  // reader gives up, and it needs one that still does — measured, `row_world` does.
  two = plan_svg(row_world(), 0 - 8, 0 - 8, 9, 9, 2.0, "two");
  assert(desc_line(two) == "", "a field no reader explains drew a description");
  assert(caption(two).contains("refused"),
         "two marks the reader refused are reported as {caption(two)} — an empty "
         + "window says `none` and this is not one, which is exactly the pair "
         + "`probe/l1` collapsed into a single number");

  bare = plan_svg(flat_world(), 0 - 8, 0 - 8, 9, 9, 2.0, "bare");
  assert(caption(bare).contains("desc none"),
         "a window with no marks at all says {caption(bare)}");
}

// ── `B2` — LEVELS SIDE BY SIDE, AND THE OFFSET THAT MUST NOT REACH ANYTHING ──
//
// BLUEPRINT §3.4 states the invariant twice over: *"the level is a discrete sheet
// index and nothing else"*, and *"the offset must never reach the field — if it does,
// two floors of one house become two buildings a hex-step apart, and the stair between
// them stops being a stair."* The weaker half is the one a picture can break on its
// own: the offset must not reach the GEOMETRY either, or every coordinate in the file
// is a page position wearing a world position's clothes.

fn group_line(svg: text, level: integer) -> text {
  for ln in svg.split('\n') {
    if ln.size() < 17 { continue; }
    if ln[0..17] != "<g class='level' " { continue; }
    if attr(ln, "data-level") == "{level}" { return ln; }
  }
  ""
}

// The `<polygon>` for cell (q,r) inside panel `level` — found by walking the file in
// order, which is the only way a reader can tell one panel's elements from another's.
fn cell_in(svg: text, level: integer, q: integer, r: integer) -> text {
  at = 0 - 1;
  for ln in svg.split('\n') {
    if ln.size() > 17 {
      if ln[0..17] == "<g class='level' " { at = attr(ln, "data-level") as integer ?? 0 - 1; }
    }
    if ln.size() < 9 { continue; }
    if ln[0..9] != "<polygon " { continue; }
    if at != level { continue; }
    if attr(ln, "data-q") == "{q}" && attr(ln, "data-r") == "{r}" { return ln; }
  }
  ""
}

// The paper rectangle a panel is drawn on — the first `<rect>` inside its group.
fn panel_rect(svg: text, level: integer) -> text {
  at = 0 - 1;
  for ln in svg.split('\n') {
    if ln.size() > 17 {
      if ln[0..17] == "<g class='level' " { at = attr(ln, "data-level") as integer ?? 0 - 1; }
    }
    if ln.size() < 6 { continue; }
    if ln[0..6] != "<rect " { continue; }
    if at == level { return ln; }
  }
  ""
}

fn two_storey_world() -> VoxelWorld {
  w = flat_world();
  why = "";
  n = hex_editor::storey_add(w, 0, 0, 1, hex_editor::STOREY_R, why);
  assert(n > 0, "the fixture has no upper storey ({n}: {why}), so every level "
              + "comparison below would be a world against itself");
  w
}

// The ground of `flat_world` is height 8, and a storey is `STOREY_H` above it. Both in
// WORLD units, which is what `edge_layer` takes.
fn ground_ref() -> float { 8.0 * 0.25 }
fn deck_ref() -> float { (8.0 + (hex_editor::STOREY_H as float)) * 0.25 }

fn test_drawing_levels_does_not_touch_the_world() {
  w = two_storey_world();
  before = hex_voxel::world_key(w);
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref(), deck_ref()], plan_bare(), "levels");
  assert(svg.contains("data-level='1'"),
         "the second level was not drawn at all, so the comparison below is about a "
         + "world nothing was asked of");
  assert(hex_voxel::world_key(w) == before,
         "the world changed while it was being DRAWN — a view is a read");

  // ⚠ AND THE KEY MOVES WHEN THE WORLD DOES, checked here so the line above is a
  // measurement rather than a constant. `world_key` over an unchanged world is the
  // same silence as `world_key` over a key that never changes.
  hex_editor::ground_set(w, 0, 0, 9, hex_editor::SURFACE_MAT);
  assert(hex_voxel::world_key(w) != before,
         "the key did not move when a cell did — it cannot see an offset reaching the "
         + "field either, and the assertion above means nothing");
}

fn test_the_page_offset_is_declared_once_and_never_in_the_coordinates() {
  w = two_storey_world();
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref(), deck_ref()], plan_bare(), "levels");

  a = cell_in(svg, 0, 3, 1);
  b = cell_in(svg, 1, 3, 1);
  assert(a != "" && b != "", "cell (3,1) is missing from one of the two panels");
  assert(attr(a, "points") == attr(b, "points"),
         "the same cell has different coordinates in two panels — the page offset has "
         + "been baked into the geometry, and every number in this picture is now a "
         + "page position wearing a world position's clothes");

  g0 = group_line(svg, 0);
  g1 = group_line(svg, 1);
  assert(g0 != "" && g1 != "", "a level group is missing");
  assert(attr(g0, "data-dx") == "0", "the first panel is offset by {attr(g0, \"data-dx\")}");
  dx = attr(g1, "data-dx") as float ?? 0.0;
  assert(dx > 0.0, "the second panel sits at {dx} — it is drawn on top of the first");

  // ⚠ ONE NUMBER, TWO PLACES, AND THEY ARE CHECKED AGAINST EACH OTHER. `data-dx` is
  // what a reader maps back through; the `transform` is what the browser draws by. A
  // picture whose two statements of its own offset disagreed would be unmappable and
  // would look perfectly right.
  assert(g1.contains("transform='translate({attr(g1, \"data-dx\")} 0)'"),
         "the group says data-dx {attr(g1, \"data-dx\")} and its transform says "
         + "something else: {g1}");
}

fn test_the_panels_do_not_overlap() {
  w = two_storey_world();
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref(), deck_ref()], plan_bare(), "levels");
  dx = attr(group_line(svg, 1), "data-dx") as float ?? 0.0;
  wide = attr(panel_rect(svg, 0), "width") as float ?? 0.0;
  assert(wide > 0.0, "the first panel has no paper under it to measure");
  assert(dx >= wide,
         "the second panel starts at {dx} and the first is {wide} wide — they overlap, "
         + "and a plan of two floors that draws them through each other is the one "
         + "picture worse than not drawing the second at all");
}

fn test_the_two_levels_are_not_the_same_picture() {
  w = two_storey_world();
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref(), deck_ref()], plan_bare(), "levels");
  low  = attr(cell_in(svg, 0, 0, 0), "data-mat");
  high = attr(cell_in(svg, 1, 0, 0), "data-mat");
  assert(low != "" && high != "", "cell (0,0) is missing from one of the panels");
  assert(low != high,
         "level 0 and level 1 both draw material {low} at (0,0) over a world with a "
         + "storey on it — if `ref` were being ignored, this is the only test here "
         + "that would say so");
  assert(high == "{hex_editor::FLOOR_MAT}",
         "the upper level draws material {high} where the storey laid "
         + "{hex_editor::FLOOR_MAT}");
}

// ⚠ AND THE PANEL AT `ref 3` DRAWS THE LAWN TOO, which is the store's own answer and
// looks like grass on the first floor. `data-h` is what separates them, so it is
// asserted rather than assumed — a picture whose two levels are distinguishable only
// by a colour a reader has to know is a picture that will be read wrong.
fn test_a_cell_carries_the_height_the_level_read_it_at() {
  w = two_storey_world();
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref(), deck_ref()], plan_bare(), "levels");
  deck = cell_in(svg, 1, 0, 0);
  lawn = cell_in(svg, 1, 6, 6);
  ground = cell_in(svg, 0, 0, 0);
  assert(deck != "" && lawn != "" && ground != "", "a cell is missing from a panel");

  dh = attr(deck, "data-h") as integer ?? 0 - 1;
  lh = attr(lawn, "data-h") as integer ?? 0 - 1;
  gh = attr(ground, "data-h") as integer ?? 0 - 1;
  assert(dh == 8 + hex_editor::STOREY_H,
         "the deck reads height {dh}, and a storey above a ground of 8 is "
         + "{8 + hex_editor::STOREY_H}");
  assert(lh == gh,
         "the lawn drawn on the upper panel reads height {lh} and the ground reads "
         + "{gh} — they are the same cells of the same layer, seen from a higher "
         + "reference");
  assert(dh != lh,
         "the deck and the lawn beside it report the same height, so nothing in this "
         + "picture says which of them is on the level it is drawn under");
}

// ── `B3` — THE AUTHOR ON THE PLAN ────────────────────────────────────────────
//
// BLUEPRINT §3.1: *"a character location on the map is still the running way"*. The
// pose is `hex_editor::Author` — the same four numbers every gesture takes — and the
// only arithmetic here is `cos`/`sin` of a yaw the library documents as radians, 0 = +x.

fn author_mark(svg: text, level: integer) -> text {
  at = 0 - 1;
  for ln in svg.split('\n') {
    if ln.size() > 17 {
      if ln[0..17] == "<g class='level' " { at = attr(ln, "data-level") as integer ?? 0 - 1; }
    }
    if ln.size() < 8 { continue; }
    if ln[0..8] != "<circle " { continue; }
    if at == level { return ln; }
  }
  ""
}

fn facing_mark(svg: text, level: integer) -> text {
  at = 0 - 1;
  for ln in svg.split('\n') {
    if ln.size() > 17 {
      if ln[0..17] == "<g class='level' " { at = attr(ln, "data-level") as integer ?? 0 - 1; }
    }
    if ln.size() < 20 { continue; }
    if ln[0..20] != "<line class='facing'" { continue; }
    if at == level { return ln; }
  }
  ""
}

fn foot(svg: text) -> text {
  for ln in svg.split('\n') {
    if ln.size() < 11 { continue; }
    if ln[0..11] == "<!-- plan: " { return ln; }
  }
  ""
}

fn test_the_marker_is_the_authors_own_two_floats() {
  w = two_storey_world();
  a = hex_editor::author_at(1.234, 2.5, 0.0, ground_ref());
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref()], plan_over_who(plan_author(a)), "who");
  m = author_mark(svg, 0);
  assert(m != "", "the author was not drawn on the only panel there is");
  assert(about(attr(m, "cx") as float ?? 0.0 - 99.0, a.au_x)
         && about(attr(m, "cy") as float ?? 0.0 - 99.0, a.au_z),
         "the marker is at ({attr(m, \"cx\")},{attr(m, \"cy\")}) and the author is at "
         + "({a.au_x},{a.au_z}) — the pose is the walker's own number or it is a "
         + "picture of somewhere else");
}

fn test_the_facing_points_where_the_walk_would_go() {
  w = two_storey_world();
  // yaw 0 is +x, which `gesture.loft` states and the tick confirms by stepping
  // `(cos yaw, sin yaw)`. A page that flipped z would draw this arrow backwards and
  // look entirely deliberate.
  east = hex_editor::author_at(0.0, 0.0, 0.0, ground_ref());
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref()], plan_over_who(plan_author(east)), "east");
  f = facing_mark(svg, 0);
  assert(f != "", "no facing was drawn");
  x1 = attr(f, "x1") as float ?? 0.0 - 99.0;
  x2 = attr(f, "x2") as float ?? 0.0 - 99.0;
  y1 = attr(f, "y1") as float ?? 0.0 - 99.0;
  y2 = attr(f, "y2") as float ?? 0.0 - 99.0;
  assert(x2 > x1 && about(y2, y1),
         "facing 0 radians draws ({x1},{y1})->({x2},{y2}); 0 is +x and the page's y "
         + "IS world z, so this arrow should run east and level");

  // …and a quarter turn puts it on the other axis, in the direction the tick walks.
  south = hex_editor::author_at(0.0, 0.0, PI / 2.0 ?? 0.0, ground_ref());
  sv = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref()], plan_over_who(plan_author(south)), "south");
  g = facing_mark(sv, 0);
  assert((attr(g, "y2") as float ?? 0.0) > (attr(g, "y1") as float ?? 0.0)
         && about(attr(g, "x2") as float ?? 0.0, attr(g, "x1") as float ?? 0.0),
         "a quarter turn from +x draws {g} — `sin` of it is positive, and so is the "
         + "step the tick takes in z");
}

fn test_the_author_stands_on_one_level_and_it_is_the_one_they_are_on() {
  w = two_storey_world();
  onground = hex_editor::author_at(0.0, 0.0, 0.0, ground_ref());
  ondeck   = hex_editor::author_at(0.0, 0.0, 0.0, deck_ref());
  refs: vector<float> = [ground_ref(), deck_ref()];

  lo = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over_who(plan_author(onground)), "lo");
  assert(author_mark(lo, 0) != "", "standing on the ground, the author is not on L0");
  assert(author_mark(lo, 1) == "",
         "the author is drawn on BOTH levels — a plan that puts one person on every "
         + "floor is telling you nothing about which floor they are on");

  hi = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over_who(plan_author(ondeck)), "hi");
  assert(author_mark(hi, 1) != "", "standing on the deck, the author is not on L1");
  assert(author_mark(hi, 0) == "", "standing on the deck, the author is also on L0");
}

fn test_the_three_states_of_the_author_do_not_read_alike() {
  w = two_storey_world();
  none = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref()], plan_bare(), "none");
  assert(author_mark(none, 0) == "", "nobody was given and somebody was drawn");
  assert(foot(none).contains("who none"), "the footer says {foot(none)}");

  here = hex_editor::author_at(1.0, 1.0, 0.0, ground_ref());
  on = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref()], plan_over_who(plan_author(here)), "on");
  assert(foot(on).contains("who (1,1)"), "the footer says {foot(on)}");
  assert(!foot(on).contains("OFF-PLAN"), "an author on the plan is reported off it");

  // ⚠ THE ONE THAT MATTERS: a pose that lands on no panel must SAY so. An absent
  // marker means *nobody was given* and *somebody is elsewhere* at once, which is
  // the collapse `probe/l1` lost a run to.
  far = hex_editor::author_at(60.0, 60.0, 0.0, ground_ref());
  off = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [ground_ref()], plan_over_who(plan_author(far)), "off");
  assert(author_mark(off, 0) == "", "an author 60 units away was drawn on the plan");
  assert(foot(off).contains("OFF-PLAN"),
         "the author is outside the window and the picture does not say so: {foot(off)}");
}

// ── `B4a` — PAGE → CELL, AND THE THREE PLACES THAT ARE NO CELL ──────────────
//
// The inverse of the placement `B2` declared. ⚠ It is checked as a ROUND TRIP over
// every cell of a two-level window, because a transform that is wrong by a margin
// still picks the right cell in the middle of a panel and the wrong one at its edge —
// and the middle is where every hand-written fixture would happen to click.

fn test_every_cell_of_every_level_picks_itself() {
  refs: vector<float> = [ground_ref(), deck_ref()];
  box = plan_bounds(0 - 6, 0 - 6, 7, 7);
  pitch = plan_pitch(box);
  n = 0;
  for k in 0..2 {
    for r in 0 - 6..7 {
      for q in 0 - 6..7 {
        c = hex_proj::hex_to_world(q, r, 0);
        p = plan_pick(0 - 6, 0 - 6, 7, 7, refs,
                      c.x + (k as float) * pitch, c.z);
        assert(p.pk_ok, "({q},{r}) on L{k} was refused: {p.pk_why}");
        assert(p.pk_level == k, "({q},{r}) picked L{p.pk_level}, not L{k}");
        assert(p.pk_q == q && p.pk_r == r,
               "the page point of ({q},{r}) on L{k} picked ({p.pk_q},{p.pk_r})");
        n = n + 1;
      }
    }
  }
  assert(n == 338, "{n} cells round-tripped, not 338 — the loop, not the map");
}

fn test_the_level_a_pick_lands_on_carries_its_own_reference() {
  refs: vector<float> = [ground_ref(), deck_ref()];
  box = plan_bounds(0 - 6, 0 - 6, 7, 7);
  c = hex_proj::hex_to_world(0, 0, 0);
  lo = plan_pick(0 - 6, 0 - 6, 7, 7, refs, c.x, c.z);
  hi = plan_pick(0 - 6, 0 - 6, 7, 7, refs, c.x + plan_pitch(box), c.z);
  assert(lo.pk_ok && hi.pk_ok, "one of the two panels refused its own centre");
  assert(about(lo.pk_ref, ground_ref()) && about(hi.pk_ref, deck_ref()),
         "the panels report references {lo.pk_ref} and {hi.pk_ref} for "
         + "{ground_ref()} and {deck_ref()} — a pick that named the wrong level would "
         + "author on the wrong floor");
}

fn test_three_places_that_are_no_cell_are_refused_and_say_why() {
  refs: vector<float> = [ground_ref(), deck_ref()];
  box = plan_bounds(0 - 6, 0 - 6, 7, 7);
  pitch = plan_pitch(box);
  ox = box.pb_minx - PLAN_MARGIN;
  mid = (box.pb_minz + box.pb_maxz) / 2.0 ?? 0.0;

  // ⚠ THE INSTRUMENT FIRST: a point that SHOULD be accepted, so the refusals below
  // are about the points and not about a map that refuses everything.
  ctr = hex_proj::hex_to_world(0, 0, 0);
  assert(plan_pick(0 - 6, 0 - 6, 7, 7, refs, ctr.x, ctr.z).pk_ok,
         "the centre of the window was refused, so every refusal below is free");

  gut = plan_pick(0 - 6, 0 - 6, 7, 7, refs, ox + plan_paper_w(box) + PLAN_GUTTER / 2.0 ?? 0.0, mid);
  assert(!gut.pk_ok, "a point in the gutter between two panels picked a cell");
  assert(gut.pk_why.contains("gutter"), "the gutter refusal says: {gut.pk_why}");

  // The margin: inside the paper, outside the window's own hexes.
  mar = plan_pick(0 - 6, 0 - 6, 7, 7, refs, ox + 0.05, mid);
  assert(!mar.pk_ok, "a point in a panel's margin picked cell ({mar.pk_q},{mar.pk_r})");
  assert(mar.pk_why.contains("margin"), "the margin refusal says: {mar.pk_why}");

  // ⚠ AND THE ONE TRUNCATION WOULD GET WRONG: left of the page divides to panel 0.
  off = plan_pick(0 - 6, 0 - 6, 7, 7, refs, ox - 1.0, mid);
  assert(!off.pk_ok,
         "a point a metre LEFT of the page picked L{off.pk_level} ({off.pk_q},{off.pk_r}) "
         + "— `/` truncates toward zero, so a negative offset answers panel 0 unless the "
         + "bound is tested first");
  assert(off.pk_why.contains("left"), "the off-page refusal says: {off.pk_why}");

  past = plan_pick(0 - 6, 0 - 6, 7, 7, refs, ox + pitch * 2.0 + 0.5, mid);
  assert(!past.pk_ok, "a point past the last panel picked L{past.pk_level}");
  assert(past.pk_why.contains("past"), "the past-the-end refusal says: {past.pk_why}");
}

// ⚠ THE PICK AND THE PICTURE SHARE ONE FRAME, and this is what says so: the pitch the
// drawing declares on its own group is the pitch the map divides by. Two derivations
// of it would be wrong by a margin and agree everywhere a hand-written fixture clicks.
fn test_the_pick_divides_by_the_pitch_the_picture_declares() {
  w = two_storey_world();
  refs: vector<float> = [ground_ref(), deck_ref()];
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_bare(), "frame");
  drawn = attr(group_line(svg, 1), "data-dx") as float ?? 0.0;
  mapped = plan_pitch(plan_bounds(0 - 6, 0 - 6, 7, 7));
  assert(about(drawn, mapped),
         "the picture places L1 at {drawn} and the pick divides by {mapped}");
}

// ── `B4c` — THE PICKED SPOT, DRAWN BACK ─────────────────────────────────────
//
// A pick is TWO facts — the point that was asked for and the cell it resolved to — and
// the picture draws both. ⚠ Drawing only the cell hides the SNAP, and hiding the snap
// is how an author blames the store for a gesture that landed exactly where they
// pointed.

const AIMCELL = "<polygon class='aimcell'";

fn aim_cell(svg: text, level: integer) -> text {
  at = 0 - 1;
  for ln in svg.split('\n') {
    if ln.size() > 17 {
      if ln[0..17] == "<g class='level' " { at = attr(ln, "data-level") as integer ?? 0 - 1; }
    }
    if ln.size() < (AIMCELL.size() as i32) { continue; }
    if ln[0..(AIMCELL.size() as i32)] != AIMCELL { continue; }
    if at == level { return ln; }
  }
  ""
}

fn aim_cross(svg: text, level: integer) -> integer {
  at = 0 - 1;
  n = 0;
  for ln in svg.split('\n') {
    if ln.size() > 17 {
      if ln[0..17] == "<g class='level' " { at = attr(ln, "data-level") as integer ?? 0 - 1; }
    }
    if ln.size() < 17 { continue; }
    if ln[0..17] != "<line class='aim'" { continue; }
    if at == level { n = n + 1; }
  }
  n
}

fn off_centre_pick() -> PlanPick {
  refs: vector<float> = [ground_ref(), deck_ref()];
  c = hex_proj::hex_to_world(2, 1, 0);
  // Deliberately off the cell's centre and on the SECOND panel, so both the snap and
  // the level are visible in what comes back.
  plan_pick(0 - 6, 0 - 6, 7, 7, refs,
            c.x + plan_pitch(plan_bounds(0 - 6, 0 - 6, 7, 7)) + 0.31, c.z - 0.19)
}

fn test_the_highlight_is_the_cell_the_pick_named() {
  w = two_storey_world();
  refs: vector<float> = [ground_ref(), deck_ref()];
  pk = off_centre_pick();
  assert(pk.pk_ok && pk.pk_q == 2 && pk.pk_r == 1,
         "the fixture point picked ({pk.pk_q},{pk.pk_r}) on L{pk.pk_level}: {pk.pk_why}");
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over_pick(pk), "aim");

  hl = aim_cell(svg, 1);
  assert(hl != "", "the pick was not drawn on the panel it named");
  assert(attr(hl, "data-q") == "2" && attr(hl, "data-r") == "1",
         "the highlight says ({attr(hl, \"data-q\")},{attr(hl, \"data-r\")})");
  // ⚠ THE OUTLINE IS THE CELL'S OWN, BYTE FOR BYTE. A highlight built from its own copy
  // of the corner walk could sit a hair off the cell it claims, which is invisible.
  assert(attr(hl, "points") == attr(cell_in(svg, 1, 2, 1), "points"),
         "the highlight's outline is not the cell's:\n  aim  {attr(hl, \"points\")}\n"
         + "  cell {attr(cell_in(svg, 1, 2, 1), \"points\")}");
  assert(aim_cell(svg, 0) == "",
         "the pick is drawn on L0 as well — it resolved on L1 and names its own panel, "
         + "so there is no rule here that could put it on two");
}

fn test_the_cross_is_the_point_that_was_asked_for_and_not_the_snap() {
  w = two_storey_world();
  refs: vector<float> = [ground_ref(), deck_ref()];
  pk = off_centre_pick();
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over_pick(pk), "aim");

  assert(aim_cross(svg, 1) == 2, "{aim_cross(svg, 1)} cross strokes, not 2");
  cr = "";
  for ln in svg.split('\n') {
    if ln.size() < 17 { continue; }
    if ln[0..17] == "<line class='aim'" { cr = ln; }
  }
  assert(about(attr(cr, "data-x") as float ?? 0.0 - 99.0, pk.pk_x)
         && about(attr(cr, "data-z") as float ?? 0.0 - 99.0, pk.pk_z),
         "the cross is at ({attr(cr, \"data-x\")},{attr(cr, \"data-z\")}) and the pick "
         + "was ({pk.pk_x},{pk.pk_z})");

  // ⚠ AND IT IS NOT THE CELL CENTRE, which is the whole reason both marks are drawn.
  ctr = hex_proj::hex_to_world(2, 1, 0);
  assert(!about(pk.pk_x, ctr.x) || !about(pk.pk_z, ctr.z),
         "the fixture point IS the cell centre, so this picture cannot show a snap and "
         + "the test above would pass for a cross drawn at either");
}

fn test_the_three_states_of_a_pick_do_not_read_alike() {
  w = two_storey_world();
  refs: vector<float> = [ground_ref(), deck_ref()];

  none = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_bare(), "none");
  assert(aim_cell(none, 0) == "" && aim_cell(none, 1) == "", "nothing was picked and something was drawn");
  assert(foot(none).contains("aim none"), "the footer says {foot(none)}");

  on = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over_pick(off_centre_pick()), "on");
  assert(foot(on).contains("aim L1 (2,1)"), "the footer says {foot(on)}");

  // ⚠ A PICK THAT NAMED NO CELL MUST SAY SO. `probe/l1` lost a run to exactly this
  // collapse, and this is the third place in one plan that has had to separate it.
  box = plan_bounds(0 - 6, 0 - 6, 7, 7);
  bad = plan_pick(0 - 6, 0 - 6, 7, 7, refs, box.pb_minx - PLAN_MARGIN - 1.0,
                  (box.pb_minz + box.pb_maxz) / 2.0 ?? 0.0);
  assert(!bad.pk_ok, "the fixture point was accepted, so there is no refusal to report");
  off = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over_pick(bad), "off");
  assert(aim_cell(off, 0) == "" && aim_cell(off, 1) == "", "a refused pick was drawn");
  assert(foot(off).contains("aim refused (left of the page)"),
         "a refused pick reads as {foot(off)} — an absent highlight means *nothing was "
         + "picked* and *that named no cell* at once");
}

// ⚠ THE CASE THAT WAS BROKEN FOR ONE COMMIT, AND THE SUITE COULD NOT SEE IT. The author
// and the aim are drawn into one panel's overlay, and an ASSIGNMENT in the second block
// wiped the first — so an aim taken by a person standing on the plan they were aiming
// at drew no highlight, while the caption cheerfully named the cell. Every test above
// passes one overlay or the other and never both.
fn test_the_author_and_the_aim_are_both_drawn_on_one_panel() {
  w = two_storey_world();
  refs: vector<float> = [ground_ref(), deck_ref()];
  pk = off_centre_pick();                       // resolves on L1
  ondeck = hex_editor::author_at(0.0, 0.0, 0.0, deck_ref());   // stands on L1 too
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, refs, plan_over(plan_author(ondeck), pk), "both");

  assert(author_mark(svg, 1) != "", "the author is missing from the panel they stand on");
  assert(aim_cell(svg, 1) != "",
         "the highlight is missing from the panel the pick named, with the author on "
         + "the same one — one overlay has overwritten the other");
  assert(aim_cross(svg, 1) == 2, "{aim_cross(svg, 1)} cross strokes beside the author");
  cap = "";
  for ln in svg.split('\n') {
    if ln.size() < 6 { continue; }
    if ln[0..6] == "<text " { cap = ln; }
  }
  assert(cap.contains("you") && cap.contains("aim"),
         "the caption of the shared panel says {cap} — both marks are on it");
}

// ── `B4d` — A WALL'S TYPE, PAINTED AT ITS OWN THICKNESS ─────────────────────
//
// BLUEPRINT §3.3: *"it should paint the exact thickness of walls"*. ⚠ The thickness is
// the PALETTE's — `@HB-X69`, a uniform wall's 38 edges carry one id — so the picture
// resolves the id and paints what it resolves to. A plan that measured a width off the
// cells would be inventing a number the store does not have.

fn typed_world(items: vector<hex_voxel::PalEntry>) -> VoxelWorld {
  w = flat_world();
  code = hex_voxel::world_set_palette(w, hex_voxel::PAL_EDGE, 0, items);
  assert(code == hex_voxel::PAL_OK, "the fixture's palette was refused: code {code}");
  w
}

fn test_two_wall_types_are_painted_at_two_thicknesses() {
  w = typed_world([hex_voxel::PalEntry { pl_slot: 1, pl_name: "brick body=SOLID thick=0.2" },
                   hex_voxel::PalEntry { pl_slot: 2, pl_name: "curtain body=THICK_CURVED thick=0.7" }]);
  hex_editor::wall_set(w, 1, 1, 0, 1, 8, 2.0);
  hex_editor::wall_set(w, 3, 1, 0, 2, 8, 2.0);
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "types");

  thin = edge_line(svg, 1, 1, hex_editor::SLOT_E);
  fat  = edge_line(svg, 3, 1, hex_editor::SLOT_E);
  assert(thin != "" && fat != "", "one of the two typed walls is not in the picture");
  assert(attr(thin, "data-body") == "SOLID" && attr(fat, "data-body") == "THICK_CURVED",
         "the bodies read {attr(thin, \"data-body\")} and {attr(fat, \"data-body\")}");
  tw = attr(thin, "stroke-width") as float ?? 0.0;
  fw = attr(fat, "stroke-width") as float ?? 0.0;
  assert(about(tw, 0.2) && about(fw, 0.7),
         "the walls are painted {tw} and {fw} against the 0.2 and 0.7 their types "
         + "declare — the picture is not resolving the id through the palette");

  // ⚠ AND THE TWO DIFFER FROM THE DRAWING'S OWN DEFAULT, or this test would pass on a
  // picture that ignored the palette and painted everything the same.
  bare = flat_world();
  hex_editor::wall_set(bare, 1, 1, 0, 1, 8, 2.0);
  plain = edge_line(plan_levels(bare, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "plain"),
                    1, 1, hex_editor::SLOT_E);
  dw = attr(plain, "stroke-width") as float ?? 0.0;
  assert(!about(dw, tw) && !about(dw, fw),
         "an untyped wall is painted {dw}, which is one of the two typed widths — the "
         + "fixture cannot show that the palette decided anything");
}

fn test_an_untyped_wall_keeps_the_drawings_own_width_and_says_it_has_no_type() {
  w = flat_world();
  hex_editor::wall_set(w, 1, 1, 0, hex_editor::WALL_MAT, 8, 2.0);
  ln = edge_line(plan_levels(w, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "none"),
                 1, 1, hex_editor::SLOT_E);
  assert(ln != "", "the wall is not in the picture");
  assert(attr(ln, "data-body") == "", "an undeclared wall reports body {attr(ln, \"data-body\")}");
  assert(attr(ln, "data-thick") == "0",
         "an undeclared wall reports thickness {attr(ln, \"data-thick\")} — 0 is *states "
         + "none*, and there is no other number that could mean it");
}

// ⚠ A DECLARED-BUT-MALFORMED TYPE IS LOUD. Falling back to the drawing's own width is
// how a picture comes to disagree with the world it claims to be of — and it is the
// same failure `house_type` refuses a type on, one axis over.
fn test_a_wall_whose_type_is_damaged_is_drawn_loudly_and_counted() {
  w = typed_world([hex_voxel::PalEntry { pl_slot: 1, pl_name: "odd body=SOLID thick=fat" }]);
  hex_editor::wall_set(w, 1, 1, 0, 1, 8, 2.0);
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "bad");
  ln = edge_line(svg, 1, 1, hex_editor::SLOT_E);
  assert(attr(ln, "data-body") == "?",
         "a damaged type reports body {attr(ln, \"data-body\")}");
  assert(attr(ln, "stroke") == "rgb(230,0,190)",
         "a damaged type is painted {attr(ln, \"stroke\")} — the same magenta an "
         + "unexplained material gets, because it is the same kind of fact");

  cap = "";
  for cln in svg.split('\n') {
    if cln.size() < 6 { continue; }
    if cln[0..6] == "<text " { cap = cln; }
  }
  assert(cap.contains("BAD TYPE 1"), "the caption does not count it: {cap}");

  // …and a picture with nothing wrong does not say it, so the count is a measurement.
  good = typed_world([hex_voxel::PalEntry { pl_slot: 1, pl_name: "brick thick=0.2" }]);
  hex_editor::wall_set(good, 1, 1, 0, 1, 8, 2.0);
  gsvg = plan_levels(good, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "good");
  assert(!gsvg.contains("BAD TYPE"), "a sound palette is reported as damaged");
}

// ── `B4e` — A DECLARED TYPE IS DRAWN AS THE WALL IT IS ──────────────────────
//
// `B4d` resolved a wall's thickness through the palette and left its COLOUR at the
// numeric vocabulary, so a world that declared its masonry at slot 5 and stamped it
// drew a magenta *I cannot explain this* over a wall the palette explains in full.
// ⚠ **THE FIX IS NOT A FALLBACK TO `wall`** — that is the confident hexagon this file
// was written against. What moved is the SUBJECT of the loudness: *undeclared*, not
// *unnamed*, and the pair below is what says the two are still told apart.

fn test_a_declared_wall_type_is_drawn_as_a_wall_at_its_own_width() {
  w = typed_world([hex_voxel::PalEntry { pl_slot: 5, pl_name: "brick body=SOLID thick=0.2" },
                   hex_voxel::PalEntry { pl_slot: 6, pl_name: "curtain body=THICK_CURVED thick=0.7" }]);
  hex_editor::wall_set(w, 1, 1, 0, 5, 8, 2.0);
  hex_editor::wall_set(w, 3, 1, 0, 6, 8, 2.0);
  hex_editor::wall_set(w, 5, 1, 0, hex_editor::WALL_MAT, 8, 2.0);
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "b4e");

  thin  = edge_line(svg, 1, 1, hex_editor::SLOT_E);
  fat   = edge_line(svg, 3, 1, hex_editor::SLOT_E);
  plain = edge_line(svg, 5, 1, hex_editor::SLOT_E);
  assert(thin != "" && fat != "" && plain != "", "one of the three walls is missing");

  tw = attr(thin, "stroke-width") as float ?? 0.0;
  fw = attr(fat,  "stroke-width") as float ?? 0.0;
  assert(about(tw, 0.2) && about(fw, 0.7),
         "the two declared types are painted {tw} and {fw} against the 0.2 and 0.7 "
       + "they declare");

  // ⚠ **AND BOTH ARE THE WALL'S OWN COLOUR**, which is what `B4d` could not do for a
  // slot outside the vocabulary: the palette explains these bytes in full, so a
  // picture that went on shouting at them would be shouting at the feature.
  wallc = attr(plain, "stroke");
  assert(attr(thin, "stroke") == wallc && attr(fat, "stroke") == wallc,
         "the declared types drew {attr(thin, "stroke")} and {attr(fat, "stroke")} "
       + "against the plain wall's {wallc}");
  assert(!svg.contains("BAD TYPE"), "a sound palette is reported as damaged");
}

// …and the half that keeps the instrument honest. ⚠ THE SAME BYTE, THE SAME GESTURE,
// ONE DECLARATION APART: if this drew as a wall too, the row above would be true of a
// picture that had simply stopped looking at the palette.
fn test_a_stamped_slot_nobody_declared_is_still_loud() {
  w = flat_world();
  hex_editor::wall_set(w, 1, 1, 0, 5, 8, 2.0);
  hex_editor::wall_set(w, 5, 1, 0, hex_editor::WALL_MAT, 8, 2.0);
  svg = plan_levels(w, 0 - 6, 0 - 6, 7, 7, [2.0], plan_bare(), "undeclared");
  odd   = edge_line(svg, 1, 1, hex_editor::SLOT_E);
  plain = edge_line(svg, 5, 1, hex_editor::SLOT_E);
  assert(odd != "" && plain != "", "one of the two walls is missing");
  assert(attr(odd, "stroke") == "rgb(230,0,190)",
         "an undeclared byte drew {attr(odd, "stroke")} — a slot a world stamped and "
       + "declared nowhere is exactly what this picture exists to show");
  assert(attr(odd, "stroke") != attr(plain, "stroke"), "it drew like a plain wall");
  assert(attr(odd, "data-thick") == "0",
         "an undeclared byte reports thickness {attr(odd, "data-thick")}");
}

// ── `B4m` — AND WHICH ROUND READER? THE PALETTE SAYS ───────────────────────
//
// ⛔ **§2.5: *an octagon tower is never deduced; it is stored*, and the reason is
// measured rather than argued.** A disk and an octagon are the SAME FIELD at four
// sizes — `disc 156 == octagon 192` among them — so no reader looking only at cells
// can tell them apart there. `hex_editor::marks_body` is what picks the model, and
// `oct_recover` only offers shells the gesture can actually build.

fn oct_typed_world(shell: integer, body: text) -> VoxelWorld {
  w = flat_world();
  code = hex_voxel::world_set_palette(w, hex_voxel::PAL_EDGE, 0,
           [hex_voxel::PalEntry { pl_slot: 5, pl_name: "tower body={body}" }]);
  assert(code == hex_voxel::PAL_OK, "the fixture's palette was refused: code {code}");
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0, 0.0, 0.0);
  assert(hex_editor::session_select_wall(s, 5).ak_ok, "slot 5 refused");
  assert(hex_editor::session_select_shell(s, shell).ak_ok, "shell {shell} refused");
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
         "the tower was refused");
  w
}

fn test_an_octagon_is_drawn_as_an_octagon() {
  w = oct_typed_world(156, hex_editor::WALL_BODY_OCT);
  svg = plan_svg(w, 0 - 10, 0 - 10, 21, 21, 8.0, "oct");

  cap = caption(svg);
  assert(cap.contains("octagon 0,0 shell 156"),
         "the caption does not name the octagon it drew: {cap}");
  assert(tag_count(svg, "<polygon class='oct'") == 1,
         "{tag_count(svg, \"<polygon class='oct'\")} octagon outlines drawn, not one");
  // ⚠ **THE OUTLINE IS EIGHT POINTS, READ OUT OF THE PICTURE** — a `<polygon>` with
  // seven would draw a septagon that measures as a description all the same.
  pts = "";
  for ln in svg.split('\n') {
    if ln.contains("<polygon class='oct'") { pts = ln; }
  }
  assert(pts != "", "the octagon line did not come back out of the picture");
  // ⚠ **THE POINTS ATTRIBUTE, NOT THE LINE** — the line also carries `rgb(30,90,220)`,
  // whose two commas made the first version of this row report ten points for eight.
  pa = pts.find("points='");
  assert(pa != null, "the outline carries no points at all: {pts}");
  prest = pts[(((pa ?? 0) + 8) as i32)..];
  pe = prest.find("'");
  assert(pe != null, "the points attribute is not closed: {pts}");
  plist = prest[0..(pe ?? 0)];
  npt = 0;
  for pc in plist.split(',') { npt = npt + 1; }
  assert(npt == 9,
         "the outline carries {npt - 1} points, not eight: {plist}");
}

// ⛔ **THE SAME FIELD, A DIFFERENT PALETTE, A DIFFERENT PICTURE.** This is the row
// that says the shape came from the declaration and not from the cells.
fn test_the_palette_decides_which_description_is_drawn() {
  ow = oct_typed_world(156, hex_editor::WALL_BODY_OCT);
  cw = oct_typed_world(156, "THICK_CURVED");

  osvg = plan_svg(ow, 0 - 10, 0 - 10, 21, 21, 8.0, "o");
  csvg = plan_svg(cw, 0 - 10, 0 - 10, 21, 21, 8.0, "c");
  assert(caption(osvg).contains("octagon"), "the octagon world drew no octagon");
  assert(caption(csvg).contains("disc"), "the round world drew no disc");
  // …and it is the OUTLINE that changed, not only the sentence.
  assert(tag_count(osvg, "<polygon class='oct'") == 1
         && tag_count(osvg, "<circle class='disc'") == 0,
         "the octagon world drew a circle or no polygon");
  assert(tag_count(csvg, "<circle class='disc'") == 1
         && tag_count(csvg, "<polygon class='oct'") == 0,
         "the round world drew a polygon or no circle");

  // ⛔ **AND THE OBVIOUS CONTROL HERE IS BLIND, WHICH IS PLAN 26 `B4l`'s OWN FINDING
  // BITING A SECOND TIME.** *"…and the two FIELDS differ, so this is not one field
  // described two ways"* was written as a mark COUNT and went red: at shell 156 the
  // octagon is 51 cells with a **54**-edge rim and the disk is 55 cells with a
  // **54**-edge rim. `hex_editor/tests/octagon.loft` is where that claim belongs and
  // where it is made byte for byte over the field — a picture cannot add to it, and a
  // count here could only mislead.
  assert(tag_count(osvg, FIELD) == tag_count(csvg, FIELD),
         "the two rims are {tag_count(osvg, FIELD)} and {tag_count(csvg, FIELD)} marks "
       + "— they no longer coincide at shell 156, so the note above is stale and wants "
       + "re-measuring rather than deleting");
}

// ⚠ **A BODY THIS TREE DOES NOT KNOW FALLS THROUGH TO THE ROUND READER**, which is
// the open vocabulary again: `@HB-X69`'s extension point must not be a list the
// picture closes.
fn test_an_unknown_body_still_draws_the_round_description() {
  w = oct_typed_world(156, "THICK_MYSTERY");
  cap = caption(plan_svg(w, 0 - 10, 0 - 10, 21, 21, 8.0, "u"));
  assert(cap.contains("disc 0,0 shell 156"),
         "an unknown body did not fall through to the disc reader: {cap}");
}

// ── `B4m` — THE TALLY THE DRIVER PRINTS ────────────────────────────────────
//
// ⛔ **THIS COUNTER HAS BEEN WRONG THREE TIMES, EACH TIME IN A DRIVER WITH NO TEST.**
// `B1`: 11 edges for 10 marks and one run. `B4h`: *description refused* for a disc
// whose description was three lines above. `B4m`: **325 cells and refused** for a
// picture captioned *cells 324 … desc octagon 0,0 shell 468*. All three are one shape
// — a tally matched on the ELEMENT name, in a program the suite could not see. These
// rows are the instrument that landing needed.

fn tally_world_run() -> VoxelWorld {
  w = flat_world();
  d = hex_editor::run_between(0.0, 0.0, 6.0, 0.0, hex_editor::WALL_MAT);
  assert(d.rd_ok, "the run was refused: {d.rd_why}");
  rs = hex_editor::WallRuns { items: [] };
  tm = 0;
  hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, tm);
  w
}

fn test_a_description_is_counted_once_whichever_shape_it_is() {
  // a run, a disc and an octagon: three different elements, one description each
  rt = plan_tally(plan_svg(tally_world_run(), 0 - 8, 0 - 8, 9, 9, 2.0, "run"));
  assert(rt.pt_descs == 1, "a run tallied {rt.pt_descs} descriptions");

  ct = plan_tally(plan_svg(oct_typed_world(156, "THICK_CURVED"),
                           0 - 10, 0 - 10, 21, 21, 8.0, "c"));
  assert(ct.pt_descs == 1, "a disc tallied {ct.pt_descs} descriptions");

  ot = plan_tally(plan_svg(oct_typed_world(156, hex_editor::WALL_BODY_OCT),
                           0 - 10, 0 - 10, 21, 21, 8.0, "o"));
  assert(ot.pt_descs == 1, "an octagon tallied {ot.pt_descs} descriptions");

  // …and a picture with no marks has no description, or the rows above would pass for
  // a counter that answers 1 to everything.
  bt = plan_tally(plan_svg(flat_world(), 0 - 8, 0 - 8, 9, 9, 2.0, "bare"));
  assert(bt.pt_descs == 0 && bt.pt_marks == 0,
         "a bare window tallied {bt.pt_descs} descriptions and {bt.pt_marks} marks");
}

// ⛔ **THE ROW THAT WOULD HAVE CAUGHT `B4m`'s OWN DEFECT.** An octagon is drawn as a
// `<polygon>`, which is also what a CELL is drawn as — so a tally keyed on the element
// counts the description as a cell and reports one more cell than the window holds.
fn test_a_description_never_lands_in_the_cell_count() {
  bare = plan_tally(plan_svg(flat_world(), 0 - 10, 0 - 10, 21, 21, 8.0, "bare"));
  ot = plan_tally(plan_svg(oct_typed_world(156, hex_editor::WALL_BODY_OCT),
                           0 - 10, 0 - 10, 21, 21, 8.0, "o"));
  assert(ot.pt_descs == 1, "the fixture drew no octagon to be miscounted");
  assert(ot.pt_cells == bare.pt_cells,
         "a window with an octagon in it tallies {ot.pt_cells} cells against the same "
       + "window's {bare.pt_cells} — the description landed in the cell count");
  // …and the same for the disc, which is a `<circle>` and could equally be claimed by
  // some future counter.
  ct = plan_tally(plan_svg(oct_typed_world(156, "THICK_CURVED"),
                           0 - 10, 0 - 10, 21, 21, 8.0, "c"));
  assert(ct.pt_cells == bare.pt_cells,
         "a window with a disc in it tallies {ct.pt_cells} cells against {bare.pt_cells}");
}

// ⚠ **THE MARKS ARE THE FIELD'S AND NOT THE DESCRIPTION'S**, which is `B1`'s own
// eleven-for-ten: a run is a `<line>` too.
fn test_the_mark_count_is_the_field_alone() {
  w = tally_world_run();
  t = plan_tally(plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, "run"));
  assert(t.pt_descs == 1, "the fixture drew no run");
  assert(t.pt_marks == tag_count(plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, "run"), FIELD),
         "the tally counts {t.pt_marks} marks against the picture's own "
       + "{tag_count(plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, \"run\"), FIELD)} — the "
       + "description is being counted as field");
}

fn test_the_level_count_is_what_reached_the_file() {
  one = plan_tally(plan_levels(flat_world(), 0, 0, 5, 5, [2.0], plan_bare(), "one"));
  two = plan_tally(plan_levels(flat_world(), 0, 0, 5, 5, [2.0, 5.0], plan_bare(), "two"));
  assert(one.pt_levels == 1 && two.pt_levels == 2,
         "the tally reports {one.pt_levels} and {two.pt_levels} levels, not 1 and 2");
}

// ── `B4n` — A HOUSE, AT LAST ───────────────────────────────────────────────
//
// ⛔ **A HOUSE HAS DRAWN NO DESCRIPTION SINCE `B1`, AND IT IS WHAT A BLUEPRINT IS
// FOR.** The reader does not look at the marks at all: `place_house` fills its
// footprint with `box_fill`, so the FLOOR is the rectangle, and the marks are what the
// recovered rectangle is then measured against.

const HOUSE_YAW = 1.5707963267948966;   // 90° — the only orbit `place_house` accepts

fn housed_world() -> VoxelWorld {
  w = flat_world();
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0, 0.0, HOUSE_YAW);
  ak = hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_PLACE, "");
  assert(ak.ak_ok, "the house was refused: {ak.ak_why}");
  w
}

fn test_a_house_is_drawn_as_a_rectangle() {
  svg = plan_svg(housed_world(), 0 - 10, 0 - 10, 21, 21, 2.0, "house");
  cap = caption(svg);
  assert(cap.contains("house "),
         "a placed house still draws no description: {cap}");
  assert(tag_count(svg, "<polygon class='house'") == 1,
         "{tag_count(svg, \"<polygon class='house'\")} rectangles drawn, not one");
  // ⚠ **FOUR POINTS, READ OUT OF THE PICTURE** — a rectangle with three would draw a
  // triangle that measures as a description all the same.
  ln = "";
  for l in svg.split('\n') { if l.contains("<polygon class='house'") { ln = l; } }
  assert(ln != "", "the rectangle did not come back out of the picture");
  pa = ln.find("points='");
  assert(pa != null, "the rectangle carries no points: {ln}");
  rest = ln[(((pa ?? 0) + 8) as i32)..];
  pe = rest.find("'");
  assert(pe != null, "the points attribute is not closed");
  npt = 0;
  for pc in rest[0..(pe ?? 0)].split(',') { npt = npt + 1; }
  assert(npt == 5, "the rectangle carries {npt - 1} points, not four");
}

// ⛔ **THE CAPTION CARRIES `B0`'s ANSWER.** Four wall marks lie outside the rectangle —
// one per corner — and the picture says so rather than leaving a reader to count black
// stubs. ⚠ It also says how many rectangles fit, because the SIZE is quantised and a
// single number would be a claim the field does not support.
fn test_the_caption_reports_the_marks_the_rectangle_does_not_explain() {
  cap = caption(plan_svg(housed_world(), 0 - 10, 0 - 10, 21, 21, 2.0, "house"));
  assert(cap.contains("stray"),
         "the caption hides the marks the rectangle leaves over: {cap}");
  assert(cap.contains("fit"),
         "the caption hides how many rectangles the field admits: {cap}");
}

// ⚠ **THE READER IS ASKED LAST**, so no two descriptions can answer for one window: a
// straight run still reads as a run even though its window holds no floor at all.
fn test_a_run_is_still_a_run() {
  cap = caption(plan_svg(tally_world_run(), 0 - 8, 0 - 8, 9, 9, 2.0, "run"));
  assert(cap.contains("run d"),
         "the house reader took a window the run reader had answered: {cap}");
}

fn test_a_house_is_one_description_in_the_tally() {
  t = plan_tally(plan_svg(housed_world(), 0 - 10, 0 - 10, 21, 21, 2.0, "house"));
  assert(t.pt_descs == 1, "a house tallied {t.pt_descs} descriptions");
  // …and the rectangle does not land in the cell count, which is the defect `B4m`
  // recorded and this is the third element to test it against.
  bare = plan_tally(plan_svg(flat_world(), 0 - 10, 0 - 10, 21, 21, 2.0, "bare"));
  assert(t.pt_cells == bare.pt_cells,
         "a window with a house tallies {t.pt_cells} cells against {bare.pt_cells}");
}

// ── `B4o` — TWO DESCRIPTIONS IN ONE WINDOW ─────────────────────────────────
//
// ⛔ **A WINDOW HAS HELD ONE DESCRIPTION SINCE `B1`, AND EVERY REAL SCENE HOLDS MORE
// THAN ONE THING.** `B1` measured the cost from the other side: a house eight hexes away
// cost an unrelated wall its description, because one of the house's mitre stubs met the
// wall's chain at a vertex. Saying which structure each mark belongs to is what lets both
// be described.

fn housed_and_walled_world() -> VoxelWorld {
  w = housed_world();
  d = hex_editor::run_between(0.0 - 12.0, 0.0 - 12.0, 0.0 - 2.0, 0.0 - 12.0,
                              hex_editor::WALL_MAT);
  assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
  assert(m > 0, "the fixture's wall stamped nothing");
  w
}

// ⚠ **ONE WORLD AND ONE PICTURE PER ROW, AND THE DEADLINE IS WHY.** The first version
// of these three rows built five worlds and rendered five pictures between them, each
// running the whole reader chain; `planview.loft` went past `loft test`'s 300-second
// budget under load. The claims are unchanged — the mitre count is **pinned to 4 on
// both** worlds, which is stronger than asserting the two are equal.
fn test_a_house_and_a_wall_are_both_described() {
  svg = plan_svg(housed_and_walled_world(), 0 - 16, 0 - 16, 33, 33, 2.0, "both");
  cap = caption(svg);
  assert(cap.contains("house "), "the house lost its description: {cap}");
  assert(cap.contains("run d"),
         "the wall beside the house is still undescribed: {cap}");
  assert(tag_count(svg, "<polygon class='house'") == 1
         && tag_count(svg, "<line class='run'") == 1,
         "the picture draws {tag_count(svg, \"<polygon class='house'\")} rectangles and "
       + "{tag_count(svg, \"<line class='run'\")} runs, not one of each");
  // ⛔ **AND THE CAPTION MUST NOT CALL THE WALL THE HOUSE'S OVER-RUN** — `B4n` counted
  // every mark the rectangle did not want, anywhere in the window, which with a wall
  // present is the wall.
  assert(cap.contains("4 stray"),
         "with a wall in the window the mitre count is not 4: {cap}");
  // …and the tally sees two descriptions, or the driver's line would understate what it
  // drew, which is the defect `B4m` recorded one shape earlier.
  assert(plan_tally(svg).pt_descs == 2,
         "two descriptions tallied as {plan_tally(svg).pt_descs}");
}

// The control for every row above: the same house ALONE reports the same mitre count and
// exactly one description.
fn test_a_house_alone_is_unmoved_by_any_of_it() {
  svg = plan_svg(housed_world(), 0 - 16, 0 - 16, 33, 33, 2.0, "one");
  cap = caption(svg);
  assert(cap.contains("4 stray"),
         "a house standing alone no longer reports its four mitre marks: {cap}");
  assert(!cap.contains("+ run"),
         "a house standing alone was given a second description: {cap}");
  assert(plan_tally(svg).pt_descs == 1,
         "a house alone tallied {plan_tally(svg).pt_descs} descriptions");
}


// ── `B4p` — THE LEFTOVER RUNS THE WHOLE CHAIN ──────────────────────────────
//
// ⛔ **`B4o` DREW ONE DESCRIPTION BESIDE A HOUSE AND IT WAS ALWAYS A RUN.** Its own note
// said so — *"the leftover reader is the run reader alone"* — so a house with a TOWER
// beside it captioned `+ 54 unexplained` about a rim this editor had stamped itself. The
// chain is one function now, asked of the window and then of what one rectangle does not
// own, so the second asking cannot be a smaller version of the first.

// ⚠ **A WIDER GROUND, BECAUSE THE TOWER STANDS OFF THE END OF `flat_world`'s.** That
// fixture reaches `r = -10` and a shell-156 rim about `(0, -8)` marks down to `r = -13`;
// a gesture with no ground under it writes nothing, and the picture of it is a picture
// of an empty window rather than a failing row.
fn wide_world() -> VoxelWorld {
  w = world_new(U, 0, 10, 4).wn_world;
  for q in 0 - 20..21 {
    for r in 0 - 20..21 { hex_editor::ground_set(w, q, r, 8, hex_editor::SURFACE_MAT); }
  }
  w
}

// A house at the origin and a tower six clear cells south of it — the distance
// `house_box.loft` measures rather than assumes.
fn housed_and_towered_world(body: text) -> VoxelWorld {
  w = wide_world();
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0, 0.0, HOUSE_YAW);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_PLACE, "").ak_ok,
         "the fixture's house was refused");
  if body != "" {
    code = hex_voxel::world_set_palette(w, hex_voxel::PAL_EDGE, 0,
             [hex_voxel::PalEntry { pl_slot: 5, pl_name: "tower body={body}" }]);
    assert(code == hex_voxel::PAL_OK, "the fixture's palette was refused: code {code}");
  }
  hex_editor::session_at(s, w, 0.0, 0.0 - 12.0, 0.0);
  if body != "" {
    assert(hex_editor::session_select_wall(s, 5).ak_ok, "slot 5 refused");
  }
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
         "the fixture's tower was refused");
  w
}

// ⛔ **THE PICTURE `B4o` COULD NOT DRAW.** Two descriptions, and the second is round.
fn test_a_house_and_a_tower_are_both_described() {
  svg = plan_svg(housed_and_towered_world(""), 0 - 7, 0 - 15, 8, 9, 2.0, "tower");
  cap = caption(svg);
  assert(cap.contains("house "), "the house lost its description: {cap}");
  assert(cap.contains("disc 0,-8 shell 156"),
         "the tower beside the house is still undescribed: {cap}");
  // …and it is the OUTLINE that arrived, not only the sentence.
  assert(tag_count(svg, "<polygon class='house'") == 1
         && tag_count(svg, "<circle class='disc'") == 1,
         "the picture draws {tag_count(svg, \"<polygon class='house'\")} rectangles and "
       + "{tag_count(svg, \"<circle class='disc'\")} circles, not one of each");
  // ⛔ **AND THE HOUSE MUST NOT CLAIM THE RIM** — `B4n`'s defect, at a round neighbour.
  assert(cap.contains("4 stray"),
         "with a tower in the window the mitre count is not 4: {cap}");
  assert(plan_tally(svg).pt_descs == 2,
         "two descriptions tallied as {plan_tally(svg).pt_descs}");
}

// ⛔ **AND WHICH ROUND READER THE LEFTOVER GETS IS THE LEFTOVER'S OWN PALETTE.** The
// WINDOW's marks disagree about the body here — a house of `WALL_MAT` and a tower of
// slot 5 — so a chain asking `marks_body` of the window would reach the disc reader,
// which refuses an octagon correctly, having been asked the wrong question.
fn test_an_octagonal_tower_beside_a_house_is_drawn_as_an_octagon() {
  svg = plan_svg(housed_and_towered_world(hex_editor::WALL_BODY_OCT),
                 0 - 7, 0 - 15, 8, 9, 2.0, "oct");
  cap = caption(svg);
  assert(cap.contains("house "), "the house lost its description: {cap}");
  assert(cap.contains("octagon 0,-8 shell 156"),
         "the octagonal tower beside the house is not named as one: {cap}");
  assert(tag_count(svg, "<polygon class='oct'") == 1
         && tag_count(svg, "<circle class='disc'") == 0,
         "the picture drew {tag_count(svg, \"<polygon class='oct'\")} octagons and "
       + "{tag_count(svg, \"<circle class='disc'\")} circles");
  assert(plan_tally(svg).pt_descs == 2,
         "two descriptions tallied as {plan_tally(svg).pt_descs}");
}

// ── ✅ AND TWO OF A KIND ARE DESCRIBED NOW — plan 26 `B4t` ────────────────
//
// ⛔ **`B4s` PINNED THIS SCENE AS THE LIMITATION**: a house and two towers described the
// house and left 108 marks over. The peel subtracts what has been DESCRIBED, and neither
// rim had been — `disc_fits` compares over the whole field in both directions, which is
// what stops a disc being accepted with a wall across it, so a field holding two rims is
// a field no single disc reproduces.
//
// ✅ **THE FIELD IS SPLIT BEFORE ANY READER IS ASKED NOW**, so each rim is a field of its
// own and R1 is untouched. ⚠ The readers did not change at all.
fn test_a_house_and_two_towers_are_all_three_described() {
  w = housed_and_towered_world("");
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0 - 14.0, 0.0, 0.0);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
         "the second tower was refused");
  svg = plan_svg(w, 0 - 15, 0 - 15, 8, 9, 2.0, "two");
  cap = caption(svg);
  assert(cap.contains("house "), "the house lost its description: {cap}");
  assert(tag_count(svg, "<circle class='disc'") == 2,
         "{tag_count(svg, \"<circle class='disc'\")} circles drawn, not two");
  assert(plan_tally(svg).pt_descs == 3,
         "three descriptions tallied as {plan_tally(svg).pt_descs}");
  assert(!cap.contains("unexplained"),
         "two towers and a house leave marks nothing explains: {cap}");
}

// The `n`th element of a class, read out of the picture — so two pictures can be
// compared as TEXT rather than by a count.
fn nth_tag(svg: text, head: text, n: integer) -> text {
  i = 0;
  for ln in svg.split('\n') {
    if ln.size() < head.size() { continue; }
    if ln[0..(head.size() as i32)] != head { continue; }
    if i == n { return ln; }
    i = i + 1;
  }
  ""
}

fn walled_world(x0: float, z0: float, x1: float, z1: float) -> VoxelWorld {
  w = flat_world();
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  hex_editor::wall_stamp(w, hex_editor::wall_run_new(x0, z0, x1, z1,
                              hex_editor::WALL_MAT),
                         hex_editor::WALL_MAT, 8, rs, m);
  assert(m > 0, "the fixture stamped nothing");
  w
}

// ⚠ **THE CLEAN CASE FIRST, SO THE LOUD ONE MEANS SOMETHING.** A caption that said
// `stray` about every wall would be as useless as one that never did.
fn test_a_wall_that_reproduces_its_field_says_nothing_extra() {
  d = hex_editor::run_between(0.0, 0.0, 9.0, 0.0, hex_editor::WALL_MAT);
  assert(d.rd_ok, "the fixture's run was refused");
  svg = plan_svg(walled_world(d.rd_run.wr_x0, d.rd_run.wr_z0,
                              d.rd_run.wr_x1, d.rd_run.wr_z1),
                 0 - 10, 0 - 10, 11, 11, 2.0, "clean");
  cap = caption(svg);
  assert(cap.contains("run d0 p"), "the wall lost its description: {cap}");
  assert(!cap.contains("stray") && !cap.contains("missing"),
         "a wall that reproduces its own field is reported as broken: {cap}");
  ln = desc_line(svg);
  assert(attr(ln, "data-stray") == "0" && attr(ln, "data-missing") == "0",
         "the picture carries stray {attr(ln, "data-stray")} missing "
       + "{attr(ln, "data-missing")} for a clean wall");
  assert(attr(ln, "data-marks") != "" && attr(ln, "data-marks") != "0",
         "the description carries no mark count at all");
}

// ── ✅ AND THE SAME RUN WALKED THE OTHER WAY IS ONE PICTURE — plan 26 `B4r` ─
//
// ⛔ **IT WAS TWO.** `B4q` drew this pair as the defect: both walls recovered a `d6`
// description, the marks zigzagged to opposite sides of it, and the captions read
// `desc d6 p8` against `desc d6 p9 · 9 stray · 9 missing`. `run_normal` settles the
// halfplane's tie-break on the LINE rather than on the direction of travel — a canonical
// normal and an offset anchored at the midpoint — and the two pictures are now one.
fn test_a_wall_walked_either_way_draws_one_clean_description() {
  d = hex_editor::run_between(0.0, 0.0, 0.0, 9.0, hex_editor::WALL_MAT);
  assert(d.rd_ok, "the fixture's run was refused");
  f = d.rd_run;
  fwd = plan_svg(walled_world(f.wr_x0, f.wr_z0, f.wr_x1, f.wr_z1),
                 0 - 10, 0 - 10, 11, 11, 2.0, "fwd");
  back = plan_svg(walled_world(f.wr_x1, f.wr_z1, f.wr_x0, f.wr_z0),
                  0 - 10, 0 - 10, 11, 11, 2.0, "back");
  fcap = caption(fwd);
  bcap = caption(back);
  assert(fcap.contains("run d6 p") && bcap.contains("run d6 p"),
         "the two directions do not recover one description: {fcap} / {bcap}");
  assert(!fcap.contains("stray") && !bcap.contains("stray")
         && !fcap.contains("missing") && !bcap.contains("missing"),
         "a wall still fails to reproduce its own field from one of the two "
       + "directions: {fcap} / {bcap}");
  // ⚠ **AND THE FIELDS ARE THE SAME FIELD, NOT TWO THAT DESCRIBE ALIKE.** The mark
  // COUNT is not enough — `B4q` measured two fields of 12 sharing 3 — so the whole
  // picture is compared, which for one wall in one window is the field itself.
  assert(tag_count(fwd, FIELD) == tag_count(back, FIELD),
         "the two walls hold {tag_count(fwd, FIELD)} and {tag_count(back, FIELD)} marks");
  for i in 0..tag_count(fwd, FIELD) {
    assert(nth_tag(fwd, FIELD, i) == nth_tag(back, FIELD, i),
           "mark {i} differs between the two directions:\n  {nth_tag(fwd, FIELD, i)}\n"
         + "  {nth_tag(back, FIELD, i)}");
  }
}

// ⚠ **AND THE CAPTION IS STILL ABLE TO BE LOUD**, which is what keeps the row above
// from passing on a residual that has stopped being computed at all. The wandering
// chain is the case that is genuinely not the wall its description names — its own
// row asserts the counts; this one asserts a person can SEE it.
fn test_a_description_that_does_not_reproduce_its_field_still_says_so() {
  w = flat_world();
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  ang = 15.0 / 57.29577951308232;
  hex_editor::wall_stamp(w, hex_editor::WallRun { wr_base: 0, wr_up: 0,
                              wr_x0: 0.4, wr_z0: 0.3,
                              wr_x1: 0.4 + cos(ang) * 6.0, wr_z1: 0.3 + sin(ang) * 6.0,
                              wr_mat: hex_editor::WALL_MAT, wr_step: 1 },
                         hex_editor::WALL_MAT, 8, rs, m);
  cap = caption(plan_svg(w, 0 - 8, 0 - 8, 9, 9, 2.0, "wander"));
  // ⛔ **THIS ROW USED TO ASSERT `missing` HERE, AND `B4x` MADE THE CHAIN EXACT.** A wall
  // at 15° is not a lattice direction at all (`@HB-X31`), so its stamped chain wanders —
  // and the chain cut now covers it as `run d0 p3 + run d4 p1`, reproducing the field
  // edge for edge. An exact cover with `missing 0` is the right answer to *what is in
  // this window*, whatever the author was aiming at, so what the caption must carry here
  // is a DESCRIPTION rather than a shortfall.
  assert(cap.contains("run d"),
         "a wandering chain is covered by runs now, and the caption says nothing: {cap}");

  // ⚠ **AND THE `missing` CLAIM MOVES RATHER THAN GOING AWAY — *move before you
  // remove*.** `stray` counts marks the reader was HANDED and did not want, which in a
  // window holding more than one structure are somebody else's; `missing` is the
  // description's own. A house with one wall byte cleared still reports it, which is
  // `@HB-X70` in the caption: an opening is never absence, and a cleared edge is a
  // BROKEN wall the description notices.
  hb = housed_world();
  hb_n = 0;
  for hb_r in 0 - 10..11 {
    for hb_q in 0 - 10..11 {
      for hb_d in [4, 5, 0] {
        if hb_n < 2 && hex_editor::edge_is_wall(hex_editor::wall_of(hb, hb_q, hb_r, hb_d, 0.0)) {
          hex_editor::wall_set(hb, hb_q, hb_r, hb_d, 0, 8, 2.0);
          hb_n = hb_n + 1;
        }
      }
    }
  }
  hb_cap = caption(plan_svg(hb, 0 - 10, 0 - 10, 21, 21, 2.0, "bitten"));
  assert(hb_cap.contains("missing"),
         "a house with a cleared wall byte draws a description that does not "
       + "reproduce its field and does not say so: {hb_cap}");
}

// ── `B4s` — EVERY STRUCTURE IN THE WINDOW ─────────────────────────────────
//
// ⛔ **`B4o` ASKED FOR THIS PICTURE AND SAID THE CORPUS DID NOT HAVE IT** — *"a window
// with three structures describes the house and one of the other two. What decides
// whether that matters is a picture of a village."* `B4p` measured the cost precisely: a
// closed rim contributes no chain ends, so the run reader answers for the wall and the
// tower's 54 marks go unmentioned. The peel takes each description's own marks out
// before asking the next question, so the rim is alone by the time it is asked about.

fn village_world() -> VoxelWorld {
  w = wide_world();
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0, 0.0, HOUSE_YAW);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_PLACE, "").ak_ok,
         "the village's house was refused");
  hex_editor::session_at(s, w, 0.0, 0.0 - 12.0, 0.0);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
         "the village's tower was refused");
  d = hex_editor::run_between(0.0 - 9.0, 0.0 - 3.0, 0.0 - 9.0, 6.0,
                              hex_editor::WALL_MAT);
  assert(d.rd_ok, "the village's wall was refused: {d.rd_why}");
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
  assert(m > 0, "the village's wall stamped nothing");
  w
}

fn test_a_house_a_tower_and_a_wall_are_all_three_drawn() {
  svg = plan_svg(village_world(), 0 - 12, 0 - 16, 13, 10, 2.0, "village");
  cap = caption(svg);
  assert(cap.contains("house "), "the house lost its description: {cap}");
  assert(cap.contains("run d"), "the wall is undescribed: {cap}");
  assert(cap.contains("disc "), "the tower is undescribed: {cap}");
  // …and each is its own element, not three mentions of one
  assert(tag_count(svg, "<polygon class='house'") == 1
         && tag_count(svg, "<line class='run'") == 1
         && tag_count(svg, "<circle class='disc'") == 1,
         "the picture drew {tag_count(svg, \"<polygon class='house'\")} rectangles, "
       + "{tag_count(svg, \"<line class='run'\")} runs and "
       + "{tag_count(svg, \"<circle class='disc'\")} circles, not one of each");
  assert(plan_tally(svg).pt_descs == 3,
         "three descriptions tallied as {plan_tally(svg).pt_descs}");
  // ⛔ **AND NOTHING IS LEFT OVER**, which is what says the three account for the field
  // rather than merely being three answers. `B4p` reported `+ 54 unexplained` here.
  assert(!cap.contains("unexplained"),
         "the village leaves marks no description explains: {cap}");
}

// ⚠ **AND THE ONE-STRUCTURE PICTURES ARE UNMOVED**, which is the control every row
// above rests on: a loop that ran twice where it should run once would say so here.
fn test_one_structure_is_still_one_description() {
  d = hex_editor::run_between(0.0, 0.0, 9.0, 0.0, hex_editor::WALL_MAT);
  one = plan_svg(walled_world(d.rd_run.wr_x0, d.rd_run.wr_z0,
                              d.rd_run.wr_x1, d.rd_run.wr_z1),
                 0 - 10, 0 - 10, 11, 11, 2.0, "one");
  assert(plan_tally(one).pt_descs == 1,
         "a lone wall tallied {plan_tally(one).pt_descs} descriptions");
  assert(!caption(one).contains(" + "),
         "a lone wall was given a second description: {caption(one)}");
  hs = plan_svg(housed_world(), 0 - 10, 0 - 10, 21, 21, 2.0, "house");
  assert(plan_tally(hs).pt_descs == 1,
         "a lone house tallied {plan_tally(hs).pt_descs} descriptions");
  assert(!caption(hs).contains(" + "),
         "a lone house was given a second description: {caption(hs)}");
}

// ── ✅ AND STRUCTURES THAT TOUCH ARE DRAWN APART — plan 26 `B4u` ──────────
//
// ⛔ **`B4t` SPLIT THE FIELD BY THE CELLS ITS MARKS TOUCH, SO ANYTHING A CELL APART WAS
// ONE STRUCTURE.** Its own record named that as what it deliberately did not do; the
// pictures are what it cost. ⚠ **Every fixture here stands at the coordinates
// `hex_editor/tests/peel.loft` uses, and THAT file asserts the cell flood makes each of
// them ONE** — a pair that drifted apart would draw two descriptions here while testing
// nothing at all.

fn two_wall_world(ax: float, bx: float) -> VoxelWorld {
  w = wide_world();
  for i in 0..2 {
    x = if i == 0 { ax } else { bx };
    d = hex_editor::run_between(x, 0.0 - 3.0, x, 6.0, hex_editor::WALL_MAT);
    assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
    rs = hex_editor::WallRuns { items: [] };
    m = 0;
    hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
    assert(m > 0, "the fixture's wall stamped nothing");
  }
  w
}

fn test_two_walls_two_cells_apart_are_drawn_as_two_runs() {
  svg = plan_svg(two_wall_world(0.0 - 2.0, 0.0), 0 - 14, 0 - 8, 12, 10, 2.0, "pair");
  cap = caption(svg);
  assert(tag_count(svg, "<line class='run'") == 2,
         "{tag_count(svg, \"<line class='run'\")} runs drawn for two walls two cells "
       + "apart, not two: {cap}");
  assert(plan_tally(svg).pt_descs == 2,
         "two walls tallied as {plan_tally(svg).pt_descs} descriptions");
  assert(!cap.contains("unexplained"),
         "two walls a cell apart leave marks nothing explains: {cap}");
  assert(!cap.contains("refused"), "the pair was refused outright: {cap}");
}

// ⛔ **AND THIS PAIR DREW A WALL THAT IS NOT THERE.** With the two in one field the house
// was described first, its own claim opened the tower's rim, and the opened rim read back
// as a `run` — so the picture carried a line over a circle nobody built. The row asserts
// the ABSENCE of that line, which is the half a description count cannot see.
fn house_and_tower_world(gap: float) -> VoxelWorld {
  w = wide_world();
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0, 0.0, HOUSE_YAW);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_PLACE, "").ak_ok,
         "the fixture's house was refused");
  hex_editor::session_at(s, w, 0.0, 0.0 - gap, 0.0);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
         "the fixture's tower was refused");
  w
}

fn test_a_house_a_cell_from_a_tower_draws_no_wall() {
  svg = plan_svg(house_and_tower_world(7.0), 0 - 14, 0 - 16, 16, 14, 2.0, "close");
  cap = caption(svg);
  assert(cap.contains("house ") && cap.contains("disc "),
         "the close pair is not drawn as a house and a disc: {cap}");
  assert(tag_count(svg, "<line class='run'") == 0,
         "the picture drew {tag_count(svg, \"<line class='run'\")} runs over a rim "
       + "nobody built: {cap}");
  assert(plan_tally(svg).pt_descs == 2,
         "the close pair tallied {plan_tally(svg).pt_descs} descriptions");
  assert(!cap.contains("unexplained"),
         "the close pair leaves marks nothing explains: {cap}");
  // ⛔ **AND THE HOUSE'S RESIDUAL IS ITS OWN.** `house_owns` reaches one cell past the
  // box — `B4o`'s bound, measured with the other structure EIGHT hexes away — so at one
  // cell the rim is inside it and the caption read `11 stray` about a mitre of four.
  // Compared against the same house standing alone, never against a constant.
  lone = caption(plan_svg(housed_world(), 0 - 10, 0 - 10, 21, 21, 2.0, "lone"));
  assert(lone.contains(" stray"), "the lone house reports no residual at all: {lone}");
  at = lone.find(" stray") ?? 0;
  n = lone[(at - 1) as i32..at as i32];
  assert(cap.contains("{n} stray"),
         "beside a tower the house reports a different residual from the {n} it reports "
       + "alone — the rim is being counted as its corner over-run: {cap}");
}

// ✅ **AND SHARING A VERTEX IS DESCRIBED NOW — plan 26 `B4v`.** A wall that MEETS a rim
// shares corners with it, so no flood separates the two; `B4u` drew the wall and counted
// the rim's 52 marks. The component is partitioned by what a candidate ACCOUNTS FOR
// instead, and the set is accepted only when it claims every mark of the component and
// none outside it — so the picture draws both.
fn tower_and_wall_world(x: float) -> VoxelWorld {
  w = wide_world();
  s = hex_editor::EditSession {};
  hex_editor::session_at(s, w, 0.0, 0.0, 0.0);
  assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
         "the fixture's tower was refused");
  d = hex_editor::run_between(x, 0.0 - 6.0, x, 6.0, hex_editor::WALL_MAT);
  assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
  rs = hex_editor::WallRuns { items: [] };
  m = 0;
  hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
  assert(m > 0, "the fixture's wall stamped nothing");
  w
}

fn test_a_wall_meeting_a_rim_is_described_as_both() {
  svg = plan_svg(tower_and_wall_world(8.0), 0 - 14, 0 - 14, 20, 16, 2.0, "met");
  cap = caption(svg);
  assert(cap.contains("run d") && cap.contains("disc "),
         "an interlocked pair is not drawn as a run and a disc: {cap}");
  assert(plan_tally(svg).pt_descs == 2,
         "an interlocked pair drew {plan_tally(svg).pt_descs} descriptions, not two: {cap}");
  assert(!cap.contains("unexplained"),
         "the interlocked pair leaves marks nothing explains — `B4u` counted 52: {cap}");

  // …and the control, one cell further out: no shared corner, and the STRICT chain alone
  // still draws both, so the row above is about the trial rather than about the readers
  cl = plan_svg(tower_and_wall_world(10.0), 0 - 14, 0 - 14, 20, 16, 2.0, "clear");
  ccap = caption(cl);
  assert(plan_tally(cl).pt_descs == 2,
         "the same pair clear of each other drew {plan_tally(cl).pt_descs}: {ccap}");
  assert(!ccap.contains("unexplained"),
         "the clear pair leaves marks nothing explains: {ccap}");
}

// ✅ **AND A CROSSING IS DRAWN AS TWO RUNS — plan 26 `B4w`.** `B4v` refused it, because
// the trial had no candidate generator for a run: a run's endpoints are continuous world
// points rather than a grid. A wall can only begin where the chain does — a free END or a
// JUNCTION — and those are a handful of exact corners.
fn crossed_walls_world() -> VoxelWorld {
  w = wide_world();
  for i in 0..2 {
    d = if i == 0 { hex_editor::run_between(0.0 - 6.0, 0.0, 6.0, 0.0,
                                            hex_editor::WALL_MAT) }
        else { hex_editor::run_between(0.0, 0.0 - 6.0, 0.0, 6.0, hex_editor::WALL_MAT) };
    assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
    rs = hex_editor::WallRuns { items: [] };
    m = 0;
    hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
    assert(m > 0, "the fixture's wall stamped nothing");
  }
  w
}

fn test_two_walls_that_cross_are_drawn_as_two_runs() {
  svg = plan_svg(crossed_walls_world(), 0 - 12, 0 - 12, 13, 13, 2.0, "cross");
  cap = caption(svg);
  assert(tag_count(svg, "<line class='run'") == 2,
         "{tag_count(svg, \"<line class='run'\")} runs drawn for a crossing, not two: {cap}");
  assert(plan_tally(svg).pt_descs == 2,
         "a crossing tallied {plan_tally(svg).pt_descs} descriptions: {cap}");
  assert(!cap.contains("unexplained"),
         "a crossing leaves marks nothing explains: {cap}");
  assert(!cap.contains("refused"), "a crossing was refused: {cap}");
}

// ⛔ **AND TWO RIMS THAT MEET ARE TWO CIRCLES**, which `B4u` refused with 106 marks
// counted: neither rim is the whole component's boundary, so the both-ways fit each
// round reader makes could not accept either.
fn two_towers_world(gap: float) -> VoxelWorld {
  w = wide_world();
  s = hex_editor::EditSession {};
  for i in 0..2 {
    hex_editor::session_at(s, w, if i == 0 { 0.0 } else { gap }, 0.0, 0.0);
    assert(hex_editor::press_verb(s, w, s.es_author, hex_editor::VB_TOWER, "").ak_ok,
           "the fixture's tower was refused");
  }
  w
}

fn test_two_rims_that_meet_are_two_circles() {
  svg = plan_svg(two_towers_world(13.0), 0 - 14, 0 - 14, 30, 16, 2.0, "rims");
  cap = caption(svg);
  assert(tag_count(svg, "<circle class='disc'") == 2,
         "{tag_count(svg, \"<circle class='disc'\")} circles drawn for two rims that "
       + "meet, not two: {cap}");
  assert(plan_tally(svg).pt_descs == 2,
         "two rims that meet tallied {plan_tally(svg).pt_descs}: {cap}");
  assert(!cap.contains("unexplained"),
         "two rims that meet leave marks nothing explains: {cap}");
}

// ⛔ **AND A SET THAT EXPLAINS PART OF ITS COMPONENT IS NOT DRAWN.** A tower whose rim a
// **T** of two walls meets is one component; the trial finds the rim and what is left is
// three chain ends no reader answers for. ⚠ **THE SWEEP IS WHAT ASKED FOR THIS ROW.**
// Dropping the union test, and letting the trial write into the real claims instead of a
// copy, both went **green** across the picture — because every fixture above is one the
// trial either closes or never starts on. A refusal the trial *reaches into* is a third
// state, and until this row nothing here could see it.
// ⚠ **A `T` WHOSE STEM MEETS THE CROSSBAR AT NO CORNER — plan 26 `B4w` MEASURED WHICH.**
// Of eight stem positions along one crossbar, two close and six do not: the stem's far
// endpoint is a continuous point on the crossbar's centreline, and it is recoverable
// exactly when the field's own corners happen to carry it. This is one that does not, so
// the trial FINDS the crossbar and still cannot close.
fn tee_world() -> VoxelWorld {
  w = wide_world();
  for i in 0..2 {
    d = if i == 0 { hex_editor::run_between(0.0 - 6.0, 0.0, 6.0, 0.0,
                                            hex_editor::WALL_MAT) }
        else { hex_editor::run_between(0.0, 0.0, 0.0, 8.0, hex_editor::WALL_MAT) };
    assert(d.rd_ok, "the fixture's wall was refused: {d.rd_why}");
    rs = hex_editor::WallRuns { items: [] };
    m = 0;
    hex_editor::wall_stamp(w, d.rd_run, hex_editor::WALL_MAT, 8, rs, m);
    assert(m > 0, "the fixture's wall stamped nothing");
  }
  w
}

// ⛔ **THE FIXTURE WAS A `T` AND `B4x` CLOSED IT.** `B4w` measured that a T's stem closes
// at some positions and not others; the chain cut closes this one, so it is no longer a
// component the trial explains only part of. The guard is unchanged and needs a field that
// still defeats every reader — `row_world`, measured at `desc refused (36 marks)`.
fn test_a_set_that_explains_only_part_is_not_drawn() {
  svg = plan_svg(row_world(), 0 - 16, 0 - 16, 20, 20, 2.0, "tee");
  cap = caption(svg);
  assert(plan_tally(svg).pt_descs == 0,
         "a component the trial explains only part of drew "
       + "{plan_tally(svg).pt_descs} descriptions: {cap}");
  assert(cap.contains("refused"),
         "it was not refused, so a set that does not account for its component was "
       + "accepted: {cap}");
  // ⛔ **AND THE REFUSAL COUNTS EVERY MARK.** A trial that wrote into the real claims
  // would silence the ones it managed to explain, and the caption would then under-report
  // the field it just gave up on.
  assert(plan_tally(svg).pt_marks > 0, "the picture reports no marks at all: {cap}");
  bare = plan_svg(row_world(), 0 - 16, 0 - 16, 20, 20, 2.0, "tee2");
  assert(plan_tally(svg).pt_marks == plan_tally(bare).pt_marks,
         "the mark count moved between two emits of one world");
  assert(cap.contains("({plan_tally(svg).pt_marks} marks)"),
         "the refusal does not count every mark in the field: {cap}");
}
