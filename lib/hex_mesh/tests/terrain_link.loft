// A SURFACE IS WHAT THE MESHER DRAWS; A TERRAIN IS WHAT A CELL CAN BE.
//
// The second is a proper SUBSET of the first, four entries short — `tree` is an
// ITEM (`h_item`), `wall` is an EDGE material in its own numbering (where `1` means
// wall while `1` on the cell axis means grass), and `frame` and `soffit` are derived
// and stored nowhere.
//
// ⚠ AND THE OVERLAP IS SCRAMBLED. Materials 1,2,3,4,5 land on surfaces
// 0,1,2,**6**,**4** — not an offset and not order-preserving. It used to be
// re-derived at every site that needed it and written down at none; `sf_mat` is the
// one place the two lists are joined, and this file is what keeps the join total.
//
// ⚠ THE JOIN GOES ONE WAY BECAUSE THE PACKAGES DO: `hex_mesh` depends on
// `hex_editor`, so the drawn list may point at the material axis and never the
// reverse. That is also why the slope limit lives on the TERRAIN and not on the
// surface — `hex_editor`'s gestures cannot see a colour.
use hex_mesh;
use hex_editor;

// ⚠ THE JOIN IS MANY-TO-ONE NOW, AND IT IS STATED RATHER THAN LOOSENED — plan 20
// `A10`. Water carries its flow DIRECTION as its material, which is seven terrains and
// one picture: a river flowing east and one flowing west are drawn identically. A
// surface each would put six always-empty meshes in every chunk and six entries on a
// stride thirteen files carry. So a terrain may name the surface that draws it
// (`tr_drawn`) when that is not its own name, and what stays exact is that EVERY
// terrain has exactly one.
fn drawn_name(t: hex_editor::GroundKind) -> text {
  if t.tr_drawn == "" { return t.tr_name; }
  t.tr_drawn
}

fn test_every_terrain_is_drawn_by_exactly_one_surface() {
  for t in hex_editor::ground_kinds() {
    i = surface_for_mat(t.tr_mat);
    assert(i >= 0, "material {t.tr_mat} ('{t.tr_name}') is drawn by no surface");
    hits = 0;
    for j in 0..len(surfaces()) {
      if surface_at(j).sf_name == drawn_name(t) { hits = hits + 1; }
    }
    assert(hits == 1,
           "material {t.tr_mat} ('{t.tr_name}') is drawn by {hits} surfaces named "
         + "'{drawn_name(t)}', not 1");
  }
}

// ⚠ AND THE FAMILY IS EXACTLY THE ONE THAT ASKED FOR IT. A `tr_drawn` on any other row
// would be a second name for one thing, which is the drift this file exists to stop.
fn test_only_water_shares_a_surface() {
  for t in hex_editor::ground_kinds() {
    if t.tr_drawn == "" { continue; }
    assert(hex_editor::is_water(t.tr_mat),
           "'{t.tr_name}' is drawn as '{t.tr_drawn}' and is not water");
    assert(t.tr_drawn == "water",
           "'{t.tr_name}' is drawn as '{t.tr_drawn}', which is not the water surface");
  }
}

fn test_the_join_round_trips_both_ways() {
  for t in hex_editor::ground_kinds() {
    i = surface_for_mat(t.tr_mat);
    assert(i >= 0, "'{t.tr_name}' ({t.tr_mat}) has no surface");
    if t.tr_drawn == "" {
      assert(surface_at(i).sf_mat == t.tr_mat,
             "material {t.tr_mat} -> surface {i} -> material {surface_at(i).sf_mat}");
    }
  }
}

fn test_one_concept_has_one_name() {
  // ⚠ TWO LISTS WITH TWO NAMES FOR ONE THING IS THE DRIFT THIS FILE EXISTS TO STOP.
  // The material axis called it `ground` for one commit while the drawn list called
  // it `grass`; a reader of either would have been sure they were separate things.
  for t in hex_editor::ground_kinds() {
    i = surface_for_mat(t.tr_mat);
    assert(surface_at(i).sf_name == drawn_name(t),
           "material {t.tr_mat} is '{drawn_name(t)}' on one axis and "
         + "'{surface_at(i).sf_name}' on the other");
  }
}

fn test_the_surfaces_no_cell_can_hold_are_named_and_expected() {
  // ⚠ THE NEGATIVE CONTROL, and it is the half that makes the rest mean anything: a
  // join that mapped EVERY surface to some material would pass all three tests above
  // and would be inventing terrains that no cell can store. These five are expected
  // to have none, and if that list ever changes it must change on purpose.
  //
  // ⚠ `rock` IS THE FIFTH AND ITS REASON IS NOT THE OTHERS'. `tree` is an item,
  // `wall` is an edge material in its own numbering, `frame` and `soffit` are
  // derived from a roof — but a rock FACE is derived from the ground's own heights
  // (`hex_editor::face_at`), so plan 20 `A5` gives it no material on purpose: the
  // store already answers where it is, and a byte for it would be a second answer.
  free: vector<text> = [];
  for i in 0..len(surfaces()) {
    if surface_at(i).sf_mat == 0 { free += [surface_at(i).sf_name]; }
  }
  assert(len(free) == 5, "{len(free)} surfaces map to no material, not 5: {free}");
  for want in ["tree", "wall", "frame", "soffit", "rock"] {
    found = false;
    for f in free { if f == want { found = true; } }
    assert(found, "'{want}' should be drawable but not storable in a cell");
  }
}

fn test_the_scramble_is_real_and_is_the_reason_for_the_link() {
  // ⚠ PINNED, because "the material is the surface index plus one" is the guess a
  // reader makes and it is wrong twice. If a future re-order ever makes it true,
  // this test failing is the notice that the link could be simplified — not a bug.
  assert(surface_for_mat(hex_editor::SURFACE_MAT) == 0, "grass");
  assert(surface_for_mat(hex_editor::ROAD_MAT) == 1, "road");
  assert(surface_for_mat(hex_editor::FIELD_MAT) == 2, "field");
  assert(surface_for_mat(hex_editor::FLOOR_MAT) == 6,
         "floor is at {surface_for_mat(hex_editor::FLOOR_MAT)} — the scramble moved");
  assert(surface_for_mat(hex_editor::ROOF_MAT) == 4,
         "roof is at {surface_for_mat(hex_editor::ROOF_MAT)} — the scramble moved");
}

fn test_an_unknown_material_is_refused_rather_than_guessed() {
  assert(surface_for_mat(0) == 0 - 1, "material 0 is ABSENCE and draws nothing");
  assert(surface_for_mat(99) == 0 - 1, "a material nothing declares resolved anyway");
}
