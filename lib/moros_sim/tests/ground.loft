// A6 — `A-GROUND` and `A-FIT`.
//
// The terrain arrives as a function, so every clause is a pure function of its
// arguments and the answers are known in closed form.
use moros_sim;

const HALF = 0.55;
const RADIUS = 0.4;
const EPS = 1.0 / 4503599627370496.0;
const BOUND = EPS * 4096.0;

fn fabs(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

// ── the terrains, each with an answer that can be written down ──────────────
fn flat_ground(x: float, z: float) -> float { 0.0 }
// yaw 0 puts the axle along +z, so a terrain varying in z tilts it
fn slope_15(x: float, z: float) -> float { 0.15 * z }
fn slope_84(x: float, z: float) -> float { 0.084 * z }
fn slope_60(x: float, z: float) -> float { 0.60 * z }
// steeper than 45 degrees: the old fixed point REFUSED this one on round zero
fn slope_350(x: float, z: float) -> float { 3.5 * z }
// nonlinear, so the fixed point has something to iterate ON
fn ridge(x: float, z: float) -> float { 0.9 - 0.9 / (1.0 + z * z) ?? 0.0 }
fn bumpy(x: float, z: float) -> float { 0.25 * sin(z * 1.7) + 0.1 * cos(x * 2.1) }
// a cliff across the axle: the drop exceeds the axle, so no bank can rest on it
fn cliff(x: float, z: float) -> float { if z > 0.0 { 3.0 } else { 0.0 } }

// ── A-GROUND: every contact's gap is zero ───────────────────────────────────

fn test_flat_ground_is_the_trivial_answer() {
  g = ground_axle(flat_ground, 3.0, 0.0, 0.0, HALF, RADIUS);
  assert(g.rt_ok, "flat ground is admissible");
  assert(fabs(g.rt_bank) < BOUND, "no bank");
  assert(fabs(g.rt_frame.fm_y - RADIUS) < BOUND, "the hubs sit one radius up");
  assert(ground_worst_gap(g, HALF, RADIUS, flat_ground) < BOUND, "and both wheels touch");
}

// On a linear slope the fixed point has a closed form: `sin β = −s·cos β`, so
// `β = −atan(s)` exactly, and the height is the terrain under the centre plus R.
fn test_a_plane_matches_the_closed_form() {
  g = ground_axle(slope_15, 3.0, 0.0, 0.0, HALF, RADIUS, 30);
  want = 0.0 - atan(0.15);
  assert(fabs(g.rt_bank - want) < BOUND, "beta is -atan(s), exactly");
  assert(fabs(g.rt_frame.fm_y - RADIUS) < BOUND, "and y is g(centre) + R");
  assert(ground_worst_gap(g, HALF, RADIUS, slope_15) < BOUND, "both wheels touch");
}

fn test_curved_ground_still_lands_both_wheels() {
  for k in 0..7 {
    cz = 0.0 - 1.5 + 0.5 * (k as float);
    r = ground_axle(ridge, 0.0, cz, 0.0, HALF, RADIUS, 30);
    assert(r.rt_ok, "the ridge is rideable");
    assert(ground_worst_gap(r, HALF, RADIUS, ridge) < BOUND, "both wheels on a ridge");
    b = ground_axle(bumpy, 1.0 + (k as float), cz, 0.4, HALF, RADIUS, 30);
    assert(b.rt_ok, "and bumpy ground");
    assert(ground_worst_gap(b, HALF, RADIUS, bumpy) < BOUND, "both wheels on bumps");
  }
}

// ── the control the design names: pin the frame and the gap opens ────────────
//
// *"pin the frame to a constant → gap clause red (already demonstrated,
// 0.204 wu)"*. A cart at a fixed height with no bank hovers or digs in by the
// terrain's own relief, and the clause has to see it.
fn test_a_pinned_frame_opens_the_gap() {
  pinned = ground_frame(3.0, RADIUS, 0.0, 0.0, 0.0);
  worst = 0.0;
  for k in 0..2 {
    side = 1.0;
    if k == 0 { side = 0.0 - 1.0; }
    e = fabs(ground_gap(pinned, HALF, RADIUS, side, slope_15));
    if e > worst { worst = e; }
  }
  // the hub sits half a cos-span out along the axle, so the relief there is
  // 0.15 * 0.55 either side
  assert(fabs(worst - 0.15 * HALF) < BOUND, "the pinned gap IS the terrain relief");
  assert(worst > 0.08, "which is two orders above the solved bound");
  solved = ground_axle(slope_15, 3.0, 0.0, 0.0, HALF, RADIUS, 30);
  assert(ground_worst_gap(solved, HALF, RADIUS, slope_15) < BOUND,
         "while solving it closes the gap entirely");
}

// ── ⚠ the defect this step found, as a permanent clause ─────────────────────
//
// The editor banked its cart through mesh3d's `mat4_rotate_x`, which turns about
// **−x**. So the bank the solve produced was applied inverted: one wheel floated
// `2·w·sin β` and the other sank the same, while both reported gaps read zero
// because the report re-derived `y ± w·sin(bank)` instead of reading the pose.
//
// Here the gap comes out of the frame, so the inverted bank is caught by
// `A-GROUND` itself rather than needing a separate clause.
fn test_an_inverted_bank_is_caught_by_the_gap() {
  g = ground_axle(slope_15, 3.0, 0.0, 0.0, HALF, RADIUS, 30);
  wrong = ground_frame(3.0, g.rt_frame.fm_y, 0.0, 0.0, 0.0 - g.rt_bank);
  l = ground_gap(wrong, HALF, RADIUS, 0.0 - 1.0, slope_15);
  r = ground_gap(wrong, HALF, RADIUS, 1.0, slope_15);
  assert(fabs(l) > 0.05 && fabs(r) > 0.05, "one wheel floats and one sinks");
  assert(l * r < 0.0, "in opposite directions — the axle is tilted the wrong way");
  // and the size is exactly the doubled lift, which is how it was recognised
  assert(fabs(fabs(l) - 2.0 * HALF * fabs(sin(g.rt_bank))) < 0.01,
         "by 2*w*sin(bank), which on the editor's 4.8 degree slope was 0.0914 wu");
}

// ── convergence: the answer does not depend on the slope ────────────────────
//
// ⚠ THREE CLAUSES HERE USED TO DESCRIBE A CONVERGENCE RATE, and the rate was the
// defect. The solve was a fixed point on `β` with `Φ′(β*) ≈ s²` in the terrain
// slope: quadratic near level, useless by `s = 0.6`, and DIVERGENT past `s = 1`
// — where it did not merely converge slowly but refused outright, because the
// `A-FIT` doorstep was asked at the seed, which is the widest span the axle ever
// has. What replaced them is not a faster rate but a different guarantee: the
// solve brackets a chord length on `[0, w]`, so it cannot fail at any slope.
//
// The old clauses are gone rather than loosened because they were TRUE of an
// algorithm that no longer exists — and one of them would have gone on passing:
// `test_the_step_shrinks_by_s_squared_each_round` guarded its ratio with
// `if prev > 0.0`, so against a solve that settles in one round it compares
// nothing at all and reports green.

fn test_the_rest_is_exact_at_every_slope_a_cart_can_meet() {
  // ⚠ THE CLAUSE THE WHOLE REWRITE IS FOR. Every one of these is a plane, so the
  // answer is `−atan(s)` in closed form and there is nothing to argue about. The
  // old solve got the first two slowly, the third badly, and REFUSED the last
  // three outright — `ok false`, bank 0, wheels up to 1.9 wu off the ground.
  slopes: vector<float> = [0.2, 0.6, 0.9, 1.1, 2.0, 3.5];
  for k in 0..len(slopes) {
    s = slopes[k] ?? 0.0;
    // ⚠ THE TYPED FORM IS REQUIRED AT AN ASSIGNMENT — there is no expected type
    // at this site, only at a call. The capture of `s` is what makes one clause
    // cover six planes.
    tilt = fn(px: float, pz: float) -> float { s * pz };
    g = ground_axle(tilt, 3.0, 0.0, 0.0, HALF, RADIUS, 12);
    assert(g.rt_ok, "a plane of slope {s} is rideable — a cart tilts to meet it");
    assert(fabs(g.rt_bank + atan(s)) < BOUND,
           "and rests at -atan({s}): got {g.rt_bank}, want {0.0 - atan(s)}");
  }
}

fn test_a_plane_needs_one_round_however_steep_it_is() {
  // ⚠ THE REASON THE VARIABLE IS `u = t²`. `H = 4(1+s²)·u − 4w²` is LINEAR in u
  // on any plane, so one false-position step is not fast — it is exact. This is
  // the clause that would notice the variable being changed back to `t` or `β`
  // for tidiness.
  slopes: vector<float> = [0.2, 0.9, 2.0, 3.5];
  for k in 0..len(slopes) {
    s = slopes[k] ?? 0.0;
    tilt = fn(px: float, pz: float) -> float { s * pz };
    one = ground_axle(tilt, 3.0, 0.0, 0.0, HALF, RADIUS, 1);
    assert(one.rt_rounds == 1, "one round was taken at slope {s}");
    assert(fabs(one.rt_bank + atan(s)) < BOUND,
           "and it is already the exact answer at slope {s}: {one.rt_bank}");
  }
}

fn test_curved_ground_settles_inside_the_cap() {
  // A plane is exact in one step, so the cap is only ever spent on CURVATURE.
  // These are the two nonlinear terrains above, and the claim is that the default
  // cap is not a number anyone has to think about.
  for k in 0..5 {
    cz = 0.0 - 1.0 + (k as float) * 0.5;
    r = ground_axle(ridge, 0.0, cz, 0.0, HALF, RADIUS);
    assert(r.rt_ok, "the ridge is rideable at z={cz}");
    assert(ground_worst_gap(r, HALF, RADIUS, ridge) < BOUND,
           "both wheels down on the ridge at z={cz}, in {r.rt_rounds} rounds");
    b = ground_axle(bumpy, 1.0 + (k as float), cz, 0.4, HALF, RADIUS);
    assert(b.rt_ok, "the bumps are rideable at z={cz}");
    assert(ground_worst_gap(b, HALF, RADIUS, bumpy) < BOUND,
           "both wheels down on the bumps at z={cz}, in {b.rt_rounds} rounds");
  }
}

fn test_the_bracket_is_what_makes_the_guarantee() {
  // `H(0) = −(2w)²` and `H(w) = d(w)² ≥ 0`, so a root exists on `[0, w]` for any
  // continuous terrain — that is the whole argument, and it is checked here on
  // the steepest plane above rather than left in a comment. At full span the
  // chord already exceeds the axle; at zero span it is zero.
  full_l = slope_350(0.0, 0.0 - HALF);
  full_r = slope_350(0.0, HALF);
  chord_full = 4.0 * HALF * HALF + (full_l - full_r) * (full_l - full_r);
  assert(chord_full > 4.0 * HALF * HALF,
         "at full span the chord is longer than the axle, so H(w) > 0");
  // and the solve lands strictly inside, where the chord IS the axle
  g = ground_axle(slope_350, 0.0, 0.0, 0.0, HALF, RADIUS, 12);
  t = HALF * cos(g.rt_bank);
  assert(t > 0.0 && t < HALF,
         "the contacts pull in to {t}, inside the axle's own half-length {HALF}");
}

// ── A-FIT: the steep case refuses with a reason, an offer and a residual ────

fn test_a_cliff_is_refused_not_clamped() {
  g = ground_axle(cliff, 0.0, 0.0, 0.0, HALF, RADIUS, 3);
  assert(!g.rt_ok, "no bank rests on a drop longer than the axle");
  assert(g.rt_reason != "", "and the refusal is NAMED");
  assert(g.rt_reason.contains("across an axle"), "saying what could not be done");
  assert(fabs(g.rt_offer) == 2.0 * HALF, "with the nearest admissible drop offered");
  assert(g.rt_over > 0.0, "and the residual it overshot by");
  assert(g.rt_over > 1.8, "a 3 wu step against a 1.1 wu axle overshoots by 1.9");
  // ⚠ and it holds the last admissible bank rather than emitting a NaN: the
  // GROUND is what has to give here, not the cart
  assert(g.rt_bank == g.rt_bank, "the bank it keeps is a number, not NaN");
}

fn test_the_doorstep_and_the_solver_fail_together() {
  // just inside: a drop the axle can straddle
  ok = ground_axle(slope_60, 3.0, 0.0, 0.0, HALF, RADIUS, 40);
  assert(ok.rt_ok, "a 31 degree slope is rideable");
  assert(ok.rt_reason == "", "with nothing to report");
  // and the refusal arrives before the solve starts producing nonsense, which is
  // the design's point: solver and doorstep degrade together rather than one
  // failing quietly inside the region the other claims to handle
  bad = ground_axle(cliff, 0.0, 0.0, 0.0, HALF, RADIUS, 40);
  assert(!bad.rt_ok, "and the cliff is refused however many rounds are allowed");
}

// ── the frame is the pose, and the gap reads it ──────────────────────────────

fn test_the_gap_reads_the_frame_and_nothing_else() {
  g = ground_axle(slope_15, 3.0, 0.0, 0.0, HALF, RADIUS, 30);
  // move the frame up by a millimetre and BOTH gaps must move by a millimetre
  lifted = ground_frame(3.0, g.rt_frame.fm_y + 0.001, 0.0, 0.0, g.rt_bank);
  l = ground_gap(lifted, HALF, RADIUS, 0.0 - 1.0, slope_15);
  r = ground_gap(lifted, HALF, RADIUS, 1.0, slope_15);
  assert(fabs(l - 0.001) < BOUND && fabs(r - 0.001) < BOUND,
         "a millimetre of hover reads as a millimetre in both gaps");
}
