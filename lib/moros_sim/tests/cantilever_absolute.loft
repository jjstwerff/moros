//
// `A9c`'s open claim, closed: the cantilever against `wL⁴/8EI` in ABSOLUTE terms.
//
// `A9c` deliberately made no absolute accuracy claim — four attempts kept measuring
// the fixture's indexing rather than the rule, so it asserted self-convergence only
// and put the reconciliation in `Open`. This file is that reconciliation.
//
// `P6` derived the two schemes by hand and confirmed them with its own instrument:
//
//     root hinge ℓ = h/2   →   tip/δ = 1 + 1/N²      SECOND order   (1.0 % at N=10)
//     root hinge ℓ = h     →   tip/δ = (1 + 1/N)²    FIRST order   (21.0 % at N=10)
//
// Those are EXACT predictions, not fitted curves, so the library must land on them
// to the precision the linear regime allows — which is what makes this a
// reconciliation and not a second opinion.
//
// ⚠ THE LOAD MUST BE TINY. `wL⁴/8EI` is the small-deflection solution while the
// chain walks its nodes with real `sin`, so comparing them at a wing's real load
// measures the geometric nonlinearity and calls it discretisation error. `P6` was
// misled by exactly that and reported a scheme converging to 0.789. At a tip
// deflection of 1e-6 of the span the closed form is the truth to 1e-12.
use moros_sim;

const EI = 1.0;
const LEN = 1.0;
const W = 0.000008;             // tip deflection 1e-6 of the span
const EXACT = 0.000001;         // wL⁴/8EI with the constants above

fn fabs(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

// tip/δ for `nb` bones, with the root hinge at half a span (the correct scheme).
fn ratio(nb: integer, root_full: boolean) -> float {
  seg = LEN / (nb as float) ?? 0.0;
  a = moros_sim::asm_cantilever(nb + 1, seg);     // nb bones ⇒ nb+1 stations
  b = moros_sim::wing_bend(a, moros_sim::frame_id(), W, EI, 400, root_full);
  b.bn_tip / EXACT ?? 0.0
}

fn test_cantilever_matches_the_closed_form() {
  // ⚠ The claim is the PREDICTION, not merely "close to 1". A scheme that is
  // second order but converging to the wrong constant would pass a bare
  // closeness test at large N and be wrong everywhere it is used.
  for nb in [5, 10, 20, 40] {
    nf = nb as float;
    want = 1.0 + 1.0 / (nf * nf) ?? 0.0;          // P6: 1 + 1/N²
    got = ratio(nb, false);
    // ⚠ THE TOLERANCE IS THE PHYSICS, NOT A FITTED SLACK. At a tip deflection of
    // 1e-6 of the span the geometric nonlinearity contributes ~1e-12 relative and
    // 400 rounds of float noise ~1e-13, so 1e-9 is generous by three orders and
    // still pins the CONSTANT rather than merely the order. Measured agreement is
    // better than 1e-10 — the library reproduces `P6`'s hand-derived prediction to
    // machine precision, which is what makes this a reconciliation and not a fit.
    assert(fabs(got - want) < 0.000000001,
           "N={nb}: tip/δ is {got}, P6's exact prediction is {want}");
  }
}

fn test_the_full_root_is_first_order_exactly_as_predicted() {
  // The deliberate defect, and its prediction is equally exact. This is what
  // makes the half-root rule worth having rather than a matter of taste.
  for nb in [5, 10, 20] {
    nf = nb as float;
    q = 1.0 + 1.0 / nf ?? 0.0;
    want = q * q;                                  // P6: (1 + 1/N)²
    got = ratio(nb, true);
    assert(fabs(got - want) < 0.01,
           "N={nb}: full-root tip/δ is {got}, P6's exact prediction is {want}");
  }
}

fn test_the_half_root_converges_a_whole_order_faster() {
  // `P6`'s headline, as a claim the library itself makes: at N=10 the corrected
  // root is a 1 % wing and the obvious scheme is a 21 % one.
  e_half = fabs(ratio(10, false) - 1.0);
  e_full = fabs(ratio(10, true) - 1.0);
  assert(e_half < 0.02, "half-root error at N=10 is {e_half}, expected ~1 %");
  assert(e_full > 0.15, "full-root error at N=10 is {e_full}, expected ~21 %");
  assert(e_full > e_half * 10.0,
         "the orders differ: {e_full} against {e_half}");
}
