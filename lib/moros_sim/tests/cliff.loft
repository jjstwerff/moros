// Cliffs, tested where they live: no world, no socket, no clock — just a height
// function and the edges it produces.
use moros_sim;
use hex_field;
use hex_edge;

// A step of `n` height units at q = 0: everything east of it is high.
fn ledge(n: integer) -> fn(integer, integer) -> integer {
  fn(q: integer, r: integer) -> integer { if q >= 1 { n } else { 0 } }
}
fn flat() -> fn(integer, integer) -> integer {
  fn(q: integer, r: integer) -> integer { 0 }
}

fn set() -> hex_field::EdgeSet { hex_field::edgeset_new(0 - 3, 0 - 3, 7, 7) }

// A staircase climbing east, BUILT BY THE RULE rather than by multiplying: each
// cell is one application of `stair_height` above the one west of it. That is
// what makes the test measure the rule instead of re-deriving it — a staircase
// written as `q * step` would pass even if `stair_height` returned something
// else entirely.
fn stair(step: integer) -> fn(integer, integer) -> integer {
  fn(q: integer, r: integer) -> integer {
    sh = 0;
    for si in 0..q { sh = moros_sim::stair_height(sh, 1, step); }
    sh
  }
}

fn test_flat_ground_has_no_cliffs() {
  e = set();
  n = moros_sim::cliff_edges(e, flat(), 0 - 2, 0 - 2, 5, 5);
  assert(n == 0, "flat ground blocks nothing, got {n}");
}

fn test_a_small_step_is_walkable_and_a_big_one_is_not() {
  // The threshold is the whole rule, so it is asserted from BOTH sides at the
  // boundary rather than only well away from it.
  small = set();
  assert(moros_sim::cliff_edges(small, ledge(6), 0 - 2, 0 - 2, 5, 5, 6) == 0,
         "a step exactly at the limit is still walkable");
  big = set();
  assert(moros_sim::cliff_edges(big, ledge(7), 0 - 2, 0 - 2, 5, 5, 6) > 0,
         "one unit past the limit is a cliff");
}

fn test_the_cliff_lands_on_the_edges_that_span_the_step() {
  e = set();
  moros_sim::cliff_edges(e, ledge(20), 0 - 2, 0 - 2, 5, 5, 6);
  // (0,0) is low and (1,0) is high, so that edge must be blocked …
  assert(!hex_edge::passable(e, 0, 0, 1, 0), "the edge across the step is blocked");
  // … while two cells on the SAME side of it are not.
  assert(hex_edge::passable(e, 1, 0, 2, 0), "two high cells stay open");
  assert(hex_edge::passable(e, 0 - 1, 0, 0, 0), "two low cells stay open");
}

fn test_a_cliff_blocks_both_ways_and_that_is_the_deferral() {
  // ⚠ `hex_edge` blocks the CANONICAL edge, so this is symmetric by construction.
  // It is asserted rather than assumed, because the day a fall exists this test
  // is what will fail and say so.
  e = set();
  moros_sim::cliff_edges(e, ledge(20), 0 - 2, 0 - 2, 5, 5, 6);
  assert(!hex_edge::passable(e, 0, 0, 1, 0), "blocked climbing up");
  assert(!hex_edge::passable(e, 1, 0, 0, 0), "and blocked stepping down — symmetric");
}

fn test_it_does_not_overwrite_a_wall_already_on_the_edge() {
  // A wall carries the SURFACE the walker slides along; a cliff has none. So a
  // cliff must leave an existing block alone rather than replace its geometry.
  e = set();
  hex_edge::edge_block_surf(e, 0, 0, 1, 0, 42);
  before = hex_edge::edge_surf(e, 0, 0, 1, 0);
  n = moros_sim::cliff_edges(e, ledge(20), 0 - 2, 0 - 2, 5, 5, 6);
  after = hex_edge::edge_surf(e, 0, 0, 1, 0);
  assert(before == 42 && after == 42, "the wall's surface survives, {before} → {after}");
  assert(n > 0, "and other edges of the step are still blocked");
}

fn test_the_step_test_is_the_same_question_the_sweep_will_ask() {
  assert(moros_sim::cliff_step_ok(0, 6, 6), "exactly the limit is ok");
  assert(!moros_sim::cliff_step_ok(0, 7, 6), "one past is not");
  assert(!moros_sim::cliff_step_ok(7, 0, 6), "and it does not care which is higher");
}

// ── THE STAIR ───────────────────────────────────────────────────────────────

fn test_a_step_this_creature_builds_is_a_step_it_can_climb() {
  // The design's whole claim, asserted over every stride and every standing
  // height rather than at one convenient pair. It is an equality ON the
  // threshold, so a single off-by-one anywhere in either function shows here.
  for sh_step in 3..9 {
    for sh_here in 0..40 {
      up = moros_sim::stair_height(sh_here, 1, sh_step);
      down = moros_sim::stair_height(sh_here, 0 - 1, sh_step);
      assert(up == sh_here + sh_step, "a step up is one stride: {up} from {sh_here}");
      assert(down == sh_here - sh_step, "a step down is one stride: {down}");
      assert(moros_sim::cliff_step_ok(sh_here, up, sh_step),
             "and the climb onto it is admitted ({sh_here} → {up}, stride {sh_step})");
      assert(moros_sim::cliff_step_ok(sh_here, down, sh_step),
             "and so is the descent onto it");
    }
  }
}

fn test_a_staircase_of_its_own_steps_blocks_no_edge() {
  // One step is arithmetic; a flight of them is the claim that matters, because
  // it is `cliff_edges` — the function the walker actually meets — that has to
  // let every one of them through.
  e = set();
  n = moros_sim::cliff_edges(e, stair(4), 0 - 2, 0 - 2, 5, 5, 4);
  assert(n == 0, "a staircase of its own steps is walkable end to end, {n} blocked");
  assert(hex_edge::passable(e, 0, 0, 1, 0), "including the edge onto the first step");
  assert(hex_edge::passable(e, 1, 0, 2, 0), "and the edge between two steps");
}

fn test_a_stair_belongs_to_the_creature_that_built_it() {
  // ⚠ THE NEGATIVE IS THE POINT. `stair_height` promises a step its BUILDER can
  // climb and nothing more — six units is a stride to a horse and a cliff to a
  // child. A version that clamped to some universal "walkable" number would pass
  // the test above and fail this one.
  tall = set();
  assert(moros_sim::cliff_edges(tall, stair(6), 0 - 2, 0 - 2, 5, 5, 6) == 0,
         "the creature that built it walks up it");
  short = set();
  n = moros_sim::cliff_edges(short, stair(6), 0 - 2, 0 - 2, 5, 5, 4);
  assert(n > 0, "a shorter one is refused by the same stair, {n} edges blocked");
}
