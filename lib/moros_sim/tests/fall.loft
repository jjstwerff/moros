//
// The fall, tested against the closed form rather than against itself. Free fall
// has an exact answer — y = y₀ − ½gt² — so the integrator can be checked for what
// it IS rather than for merely decreasing.
use moros_sim;

// the package's ONE gravity, not a second copy of it
const G = 12.0;
fn fabs(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

fn test_standing_on_the_ground_does_not_move() {
  f = moros_sim::fall_step(4.0, 0.0, 4.0, 0.016, G);
  assert(f.fl_y == 4.0, "the feet stay put");
  assert(f.fl_vy == 0.0, "and gather no speed");
  assert(!f.fl_airborne, "standing is not airborne");
  assert(!f.fl_landed, "and standing still is not a landing");
}

fn test_the_ground_rising_past_the_feet_is_the_climb() {
  // Walking up a ramp: the surface came up past the feet. The same clause that
  // stops a fall resolves it, which is why there is no separate climb branch.
  f = moros_sim::fall_step(4.0, 0.0, 4.6, 0.016, G);
  assert(f.fl_y == 4.6, "the feet are put on the ground, not left inside it");
  assert(!f.fl_airborne, "and that is not a fall");
}

fn test_the_feet_are_never_below_the_ground() {
  // The invariant, swept rather than sampled: from well under to well over.
  for k in 0..40 {
    y = 3.0 + (k as float) * 0.1;
    f = moros_sim::fall_step(y, 0.0 - 2.0, 5.0, 0.016, G);
    assert(f.fl_y >= 5.0 - 0.000000001,
           "at y={y} the feet ended at {f.fl_y}, under a ground of 5.0");
    assert(moros_sim::fall_clearance(f.fl_y, 5.0) >= 0.0, "clearance is never negative");
  }
}

fn test_free_fall_matches_one_half_g_t_squared() {
  // ⚠ THE REFERENCE IS THE CLOSED FORM, not a previous run of this code. Semi-
  // implicit Euler is exact in velocity and carries a known O(dt) offset in
  // position — Σ(k·g·dt²) against ∫ — so the bound is stated in terms of dt and
  // the step count rather than fitted: the discrepancy is ½·g·dt·t.
  dt = 0.001;
  n = 500;
  y = 100.0;
  vy = 0.0;
  for k in 0..n {
    f = moros_sim::fall_step(y, vy, 0.0, dt, G);
    y = f.fl_y;
    vy = f.fl_vy;
  }
  t = (n as float) * dt;
  exact = 100.0 - 0.5 * G * t * t;
  bound = 0.5 * G * dt * t + 0.000001;
  assert(fabs(y - exact) < bound,
         "after {t}s the feet are {y}, the closed form says {exact}, bound {bound}");
  // and the velocity is exact for this integrator, to float noise
  assert(fabs(vy - (0.0 - G * t)) < 0.000001, "velocity is exact: {vy}");
}

fn test_landing_clamps_to_the_ground_and_says_so() {
  // A step that would cross the surface lands ON it — no overshoot, no bounce.
  f = moros_sim::fall_step(0.05, 0.0 - 9.0, 0.0, 0.05, G);
  assert(f.fl_y == 0.0, "landed exactly on the ground, not through it: {f.fl_y}");
  assert(f.fl_vy == 0.0, "and stopped");
  assert(f.fl_landed, "and the landing is REPORTED, so a caller can react to it");
  assert(!f.fl_airborne, "no longer airborne");
}

fn test_a_landing_is_reported_once_not_every_tick() {
  // The tick after touching down must not claim to have landed again — otherwise a
  // caller making a sound plays it for as long as the walker stands there.
  f1 = moros_sim::fall_step(0.05, 0.0 - 9.0, 0.0, 0.05, G);
  assert(f1.fl_landed, "the touching-down step reports it");
  f2 = moros_sim::fall_step(f1.fl_y, f1.fl_vy, 0.0, 0.05, G);
  assert(!f2.fl_landed, "the next one does not");
}

fn test_terminal_velocity_is_the_shared_clamp_not_a_new_one() {
  // `player_step` clamps at TERMINAL_VELOCITY; so does this. Asserted here because
  // two falls in one package that disagree is exactly the defect this file's header
  // records having nearly shipped.
  y = 10000.0;
  vy = 0.0;
  for k in 0..4000 {
    f = moros_sim::fall_step(y, vy, 0.0, 0.01, G);
    y = f.fl_y; vy = f.fl_vy;
  }
  assert(vy >= 0.0 - 60.0 - 0.000001, "clamped at terminal velocity, got {vy}");
  assert(vy <= 0.0 - 59.9, "and actually reached it, got {vy}");
}

// ⚠ At file scope: loft forbids a `fn` inside a function, and the first version of
// this test nested it.
fn drop_seconds(h: float) -> float {
  y = h;
  vy = 0.0;
  steps = 0;
  while steps < 100000 {
    f = moros_sim::fall_step(y, vy, 0.0, 0.001, G);
    y = f.fl_y;
    vy = f.fl_vy;
    steps = steps + 1;
    if !f.fl_airborne { return (steps as float) * 0.001; }
  }
  0.0
}

fn test_a_deeper_drop_takes_longer_and_arrives_faster() {
  // Two drops, and the ordering is the physics rather than a magic number.
  t_low = drop_seconds(1.0);
  t_high = drop_seconds(9.0);
  assert(t_high > t_low, "nine units takes longer than one: {t_high} vs {t_low}");
  // t = √(2h/g), so tripling the height should take about √3 ≈ 1.732 times as long
  r = t_high / t_low ?? 0.0;
  assert(fabs(r - 3.0) < 0.05, "and by the square-root law: ratio {r}, expected 3");
}
