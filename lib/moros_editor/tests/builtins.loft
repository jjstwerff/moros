// The built-in stencils, on the library mechanism (moros#5).
use moros_map;
use moros_editor;
use hex_field;

fn test_flat_is_one_cell() {
  st = builtin_flat();
  assert(hexset_count(st.sn_cells) == 1, "flat has {hexset_count(st.sn_cells)} cells, want 1");
  m = map_empty();
  stencil_into_map_mode(m, st, 5, 5, 0, STAMP_REPLACE);
  c = map_get_hex(m, 5, 5, 0);
  assert(c.h_material == 3, "flat stamped material {c.h_material}, want 3");
  assert(c.h_height == 5, "flat stamped height {c.h_height}, want 5");
}

// The ring is SIX cells all genuinely adjacent to the centre.  The old
// StencilDef version used an axial neighbour table over odd-r offset
// coordinates, which is not a ring on either parity.
fn test_house_ring_is_actually_a_ring() {
  st = builtin_house_small();
  assert(hexset_count(st.sn_cells) == 7, "house has {hexset_count(st.sn_cells)} cells, want 7");
  for d in 0..6 {
    rq = nb_q(0, 0, d);
    rr = nb_r(0, 0, d);
    assert(hexset_get(st.sn_cells, rq, rr), "direction {d} ({rq},{rr}) is not in the ring");
  }
  // and every ring cell is one step from the centre, measured not assumed
  for d in 0..6 {
    assert(hex_dist(0, 0, nb_q(0, 0, d), nb_r(0, 0, d)) == 1,
           "ring cell {d} is not adjacent to the centre");
  }
}

// The old table, applied at an ODD anchor row, does not describe the neighbours.
fn test_the_old_axial_ring_was_wrong() {
  axial: vector<integer> = [1, 0, 0, 1, -1, 1, -1, 0, 0, -1, 1, -1];
  wrong = 0;
  for i in 0..6 {
    dq = axial[i * 2] ?? 0;
    dr = axial[i * 2 + 1] ?? 0;
    if hex_dist(3, 3, 3 + dq, 3 + dr) != 1 { wrong = wrong + 1; }
  }
  assert(wrong > 0, "the axial table happened to be a ring here — pick another anchor");
}

fn test_house_walls_ring_the_outside() {
  st = builtin_house_small();
  assert(edgeset_count(st.sn_edges) > 0, "the house has no walls");
  m = map_empty();
  stencil_into_map_mode(m, st, 4, 3, 0, STAMP_REPLACE);   // ODD anchor row
  filled = 0;
  for q in 0..10 {
    for r in 0..10 {
      if map_get_hex(m, q, r, 0).h_material != 0 { filled = filled + 1; }
    }
  }
  assert(filled == 7, "stamped {filled} cells, want 7");
}

// Twelve: six rotations, and the other six by flipping.  Counted with
// edgeset_count_all, not edgeset_count — the latter walks only in-chunk cells, so
// it moves when the extent does and cannot tell "the wall left" from "the wall is
// now owned by a halo cell".  Nothing may be lost, so the measure has to cover
// everything.
fn test_builtins_rotate_through_twelve_orientations() {
  st = builtin_house_small();
  n0 = hexset_count(st.sn_cells);
  e0 = edgeset_count_all(st.sn_edges);
  flipped = stencil_mirror(st);
  for n in 0..6 {
    a = stencil_rotate(st, n);
    b = stencil_rotate(flipped, n);
    assert(hexset_count(a.sn_cells) == n0, "orientation {n}: {hexset_count(a.sn_cells)} cells, want {n0}");
    assert(edgeset_count_all(a.sn_edges) == e0, "orientation {n}: {edgeset_count_all(a.sn_edges)} walls, want {e0}");
    assert(hexset_count(b.sn_cells) == n0, "flipped {n}: cells lost");
    assert(edgeset_count_all(b.sn_edges) == e0, "flipped {n}: walls lost");
  }
}

// The count above says nothing LEFT.  It cannot say nothing MOVED: any permutation
// that swaps two walls keeps the count exactly right.  So gate the orientations a
// second way — rotate by n, rotate back by 6−n, and demand the edge layer come back
// identical slot for slot.  `edgeset_equal` compares the halo as well, which is
// where hex_field's own negative control once failed to fail.
//
// The two checks are complementary, not redundant: the round trip is blind to an
// error that is its own inverse (a wrong-but-symmetric permutation composes back to
// the identity), and the count is blind to movement.  Neither alone gates "a stencil
// loses nothing".
fn test_rotation_is_exactly_invertible() {
  st = builtin_house_small();
  for n in 0..6 {
    back = stencil_rotate(stencil_rotate(st, n), 6 - n);
    assert(edgeset_equal(st.sn_edges, back.sn_edges),
           "rotate {n} then {6 - n} did not restore the edge layer");
    assert(hexset_count(back.sn_cells) == hexset_count(st.sn_cells),
           "rotate {n} then {6 - n} did not restore the cells");
  }
}

// The flip is its own inverse, so it needs no partner rotation to be checked exactly.
fn test_mirror_is_its_own_inverse() {
  st = builtin_house_small();
  back = stencil_mirror(stencil_mirror(st));
  assert(edgeset_equal(st.sn_edges, back.sn_edges), "mirroring twice changed the edge layer");
  assert(hexset_count(back.sn_cells) == hexset_count(st.sn_cells), "mirroring twice changed the cells");
}

fn test_spiral_stair_carries_its_item() {
  st = builtin_spiral_stair();
  m = map_empty();
  stencil_into_map_mode(m, st, 2, 1, 0, STAMP_REPLACE);
  c = map_get_hex(m, 2, 1, 0);
  assert(c.h_material == 4, "stair material {c.h_material}, want 4");
  assert(c.h_item == 12, "stair item {c.h_item}, want 12");
}

// ── The door house (moros#5) ─────────────────────────────────────

// A door is a GAP — crawler's convention, and the same one the towers/doors work
// in their plan #11 P5 uses. So the door house is house_small minus exactly one
// wall, and the missing one is the east cell's outward east edge.
fn test_the_door_is_exactly_one_missing_wall() {
  solid = edgeset_count_all(builtin_house_small().sn_edges);
  holed = edgeset_count_all(builtin_house_door().sn_edges);
  assert(holed == solid - 1, "the door house has {holed} walls, want {solid - 1}");
}

fn test_the_door_faces_three_oclock() {
  st = builtin_house_door();
  dq = nb_q(0, 0, DIR_E);
  dr = nb_r(0, 0, DIR_E);
  assert(edge_mat(st.sn_edges, dq, dr, nb_q(dq, dr, DIR_E), nb_r(dq, dr, DIR_E)) == 0,
         "the east cell's outward east edge is walled — that is where the door goes");
  // every other ring cell's radial edge is still solid
  for d in 0..6 {
    if d != DIR_E {
      rq = nb_q(0, 0, d);
      rr = nb_r(0, 0, d);
      assert(edge_mat(st.sn_edges, rq, rr, nb_q(rq, rr, d), nb_r(rq, rr, d)) != 0,
             "direction {d} ({dir_hour(d)} o'clock) has a second doorway");
    }
  }
}

// It keeps the floor plan: a door removes a wall, not a room.
fn test_the_door_house_still_has_seven_cells() {
  assert(hexset_count(builtin_house_door().sn_cells) == 7,
         "the door house lost cells");
}

// Turning it must not close the door or open another.
fn test_the_door_survives_every_placement() {
  st = builtin_house_door();
  n0 = edgeset_count_all(st.sn_edges);
  for f in 0..12 {
    p = stencil_placed(st, f);
    assert(edgeset_count_all(p.sn_edges) == n0,
           "{facing_text(f)}: {edgeset_count_all(p.sn_edges)} walls, want {n0}");
    assert(hexset_count(p.sn_cells) == 7, "{facing_text(f)}: lost cells");
  }
}
