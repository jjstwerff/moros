// moros_map — shared data model for the Moros hex scene system.
// Re-exports all types and public functions.

use self::types;
use self::palette;
use self::spawn;
use hex_field;
use hex_grid;    // the lattice — rounding and distance are ITS parity to get right

// Top-level map container. Holds chunks and palette definitions.
pub struct Map {
  m_name:             text,
  m_chunks:           vector<Chunk>,
  m_material_palette: vector<MaterialDef>,
  m_wall_palette:     vector<WallDef>,
  m_item_palette:     vector<ItemDef>,
  m_spawn_points:     vector<SpawnPoint>,
  m_npc_routines:     vector<NpcRoutine>,
}

// ── Constructors ────────────────────────────────────────────────────

// Create a new empty map.  Each palette starts holding exactly ONE entry — the
// absence entry at slot 0 — never zero.  See `palette.loft`: a defaulted `Hex` is
// all zeroes and must read as empty, so slot 0 is spoken for before any caller
// gets a say.  Seeding it here is what makes that true of every map rather than
// of the maps whose author remembered.
pub fn map_empty() -> Map {
  Map {
    m_name: "untitled",
    m_chunks: [],
    m_material_palette: [absent_material()],
    m_wall_palette:     [absent_wall()],
    m_item_palette:     [absent_item()],
    m_spawn_points: [],
    m_npc_routines: [],
  }
}

// ── The palette: resolving a cell's u8 into its definition ──────────
//
// Append and hand back THE INDEX A CELL SHOULD STORE, so the caller never
// computes one.  Returns -1 when the table is full: past 256 there is no index
// that would mean "the thing you just added", and appending anyway would produce
// a definition no cell could ever name.
pub fn map_add_material(m: Map, d: MaterialDef) -> integer {
  if len(m.m_material_palette) >= PALETTE_MAX { return -1; }
  m.m_material_palette += [d];
  len(m.m_material_palette) - 1
}

pub fn map_add_wall_def(m: Map, d: WallDef) -> integer {
  if len(m.m_wall_palette) >= PALETTE_MAX { return -1; }
  m.m_wall_palette += [d];
  len(m.m_wall_palette) - 1
}

pub fn map_add_item_def(m: Map, d: ItemDef) -> integer {
  if len(m.m_item_palette) >= PALETTE_MAX { return -1; }
  m.m_item_palette += [d];
  len(m.m_item_palette) - 1
}

// An out-of-range index yields the ABSENCE entry rather than null, so nothing on
// a render or collision hot path has to null-check and nothing can crash on a
// world naming a definition this palette lacks.
//
// ⚠ That fallback is a SAFETY NET, NOT AN ANSWER.  An index past the table means
// the world and its palette disagree, and drawing it as empty space silently
// DELETES content.  The net keeps the frame drawing; `map_palette_gap` is how you
// find out, and a loader should ask before it draws anything.
// The out-of-range answer is the absence VALUE, not `table[0]` — a map whose
// palette is empty is malformed (`map_empty` always seeds one) but reading its
// slot 0 would be exactly the out-of-bounds the fallback exists to prevent.
pub fn map_material(m: Map, i: u8) -> MaterialDef {
  if i < 0 || i >= len(m.m_material_palette) { return absent_material(); }
  m.m_material_palette[i]
}

pub fn map_wall_def(m: Map, i: u8) -> WallDef {
  if i < 0 || i >= len(m.m_wall_palette) { return absent_wall(); }
  m.m_wall_palette[i]
}

pub fn map_item_def(m: Map, i: u8) -> ItemDef {
  if i < 0 || i >= len(m.m_item_palette) { return absent_item(); }
  m.m_item_palette[i]
}

// Does an index name a REAL definition — neither absence nor off the end?  The
// question the accessors deliberately cannot answer, kept separate so that asking
// is a decision a caller makes rather than a null it trips over.
pub fn map_has_material(m: Map, i: u8) -> boolean { i > 0 && i < len(m.m_material_palette) }
pub fn map_has_wall_def(m: Map, i: u8) -> boolean { i > 0 && i < len(m.m_wall_palette) }
pub fn map_has_item_def(m: Map, i: u8) -> boolean { i > 0 && i < len(m.m_item_palette) }

// Walk every stored cell and report the first index that its palette cannot
// resolve — the check a loader runs BEFORE it trusts a world.  Returns "" when
// every index resolves.
//
// This exists because the accessors above cannot fail loudly and must not: the
// alternative to a silent fallback is not a null on the hot path, it is asking
// the question ONCE, here, where there is somewhere to report it to.
pub fn map_palette_gap(m: Map) -> text {
  for ck in m.m_chunks {
    for h in ck.ck_hexes {
      if h.h_material >= len(m.m_material_palette) {
        return "material {h.h_material} but only {len(m.m_material_palette)} defined";
      }
      if h.h_item >= len(m.m_item_palette) {
        return "item {h.h_item} but only {len(m.m_item_palette)} defined";
      }
      if h.h_wall_nw >= len(m.m_wall_palette) || h.h_wall_ne >= len(m.m_wall_palette)
         || h.h_wall_e >= len(m.m_wall_palette) {
        return "wall index past the {len(m.m_wall_palette)} defined";
      }
    }
  }
  ""
}

// ── MO.2: Serialization ────────────────────────────────────────────

// Serialise the entire map to a JSON string.
pub fn map_to_json(m: Map) -> text {
  "{m:j}"
}

// Deserialise a JSON string back to a Map.
// Returns a default empty Map on parse failure.
pub fn map_from_json(json: text) -> Map {
  if json == "" { return map_empty(); }
  result = Map.parse(json);
  if json_errors() != "" { return map_empty(); }
  result
}

// ── MO.2: Hex-address helpers ───────────────────────────────────────

// Euclidean-division helpers for chunk / intra-chunk indexing on a
// 32-wide chunk grid.  C-style `q / 32` and `q % 32` produce negative
// quotients and remainders for negative axial coordinates, which
// silently maps (-1, 1) etc. to a wrong cell.  These helpers always
// return `chunk_idx_32 = floor(v / 32)` and `hex_idx_32 ∈ [0, 31]`
// so adjacent hexes across the origin behave consistently.
fn chunk_idx_32(v: integer) -> integer {
  vr = v % 32;
  if vr < 0 { (v - vr - 32) / 32 } else { (v - vr) / 32 }
}
fn hex_idx_32(v: integer) -> integer {
  vr = v % 32;
  if vr < 0 { vr + 32 } else { vr }
}

// Check whether a chunk exists at the given global coordinates.
pub fn map_has_chunk(m: Map, q: integer, r: integer, cy: integer) -> boolean {
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  for hc_c in m.m_chunks {
    if hc_c.ck_cx == cx && hc_c.ck_cy == cy && hc_c.ck_cz == cz {
      return true;
    }
  }
  false
}

// ── MO.3: Hex edit operations ───────────────────────────────────────

// Build a 32x32 chunk of default hexes at the given chunk coordinates.
fn build_chunk(cx: integer, cy: integer, cz: integer) -> Chunk {
  hexes: vector<Hex> = [];
  for _ in 0..1024 {
    hexes += [Hex {}];
  }
  Chunk { ck_cx: cx, ck_cy: cy, ck_cz: cz, ck_hexes: hexes }
}

// Ensure a chunk exists at the given global coordinates.
// Creates a 32x32 chunk filled with default hexes if absent.
pub fn map_ensure_chunk(m: Map, q: integer, r: integer, cy: integer) {
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  for ec_c in m.m_chunks {
    if ec_c.ck_cx == cx && ec_c.ck_cy == cy && ec_c.ck_cz == cz {
      return;
    }
  }
  m.m_chunks += [build_chunk(cx, cy, cz)];
}

// Write a Hex at global coordinates. Creates the chunk if needed.
pub fn map_set_hex(m: Map, q: integer, r: integer, cy: integer, h: Hex) {
  map_ensure_chunk(m, q, r, cy);
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  hx = hex_idx_32(q);
  hz = hex_idx_32(r);
  idx = hx * 32 + hz;
  for sh_c in m.m_chunks {
    if sh_c.ck_cx == cx && sh_c.ck_cy == cy && sh_c.ck_cz == cz {
      sh_c.ck_hexes[idx] = h;
      return;
    }
  }
}

// ── MO.2: Hex-address read helpers ──────────────────────────────────

// Resolve global (q, r, cy) to the Hex at that address.
// Returns a default Hex (all zeros) if chunk is missing or index out of bounds.
pub fn map_get_hex(m: Map, q: integer, r: integer, cy: integer) -> Hex {
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  hx = hex_idx_32(q);
  hz = hex_idx_32(r);
  idx = hx * 32 + hz;
  for gh_c in m.m_chunks {
    if gh_c.ck_cx == cx && gh_c.ck_cy == cy && gh_c.ck_cz == cz {
      if idx >= 0 && idx < len(gh_c.ck_hexes) {
        return gh_c.ck_hexes[idx];
      }
    }
  }
  Hex {}
}

// Convenience editors.

// Paint a hex's material at (q, r, cy).
pub fn map_paint_material(m: Map, q: integer, r: integer, cy: integer, material: u8) {
  cur = map_get_hex(m, q, r, cy);
  cur.h_material = material;
  map_set_hex(m, q, r, cy, cur);
}

// Set a hex's height at (q, r, cy).
pub fn map_set_height(m: Map, q: integer, r: integer, cy: integer, height: u16) {
  cur = map_get_hex(m, q, r, cy);
  cur.h_height = height;
  map_set_hex(m, q, r, cy, cur);
}

// Place an item on a hex (item index + rotation, preserves spawn/waypoint flags).
pub fn map_place_item(m: Map, q: integer, r: integer, cy: integer, item: u8, rotation: u8) {
  cur = map_get_hex(m, q, r, cy);
  cur.h_item = item;
  flags = cur.h_item_rotation & ~31;  // preserve bits 5+ (spawn, waypoint)
  cur.h_item_rotation = ((rotation & 31) | flags) as u8? ?? 0;
  map_set_hex(m, q, r, cy, cur);
}

// Set a wall on a hex edge.  edge: 0=N, 1=NE, 2=SE.
pub fn map_set_wall(m: Map, q: integer, r: integer, cy: integer, edge: integer, wall: u8) {
  cur = map_get_hex(m, q, r, cy);
  if edge == 0 { cur.h_wall_nw = wall; }
  if edge == 1 { cur.h_wall_ne = wall; }
  if edge == 2 { cur.h_wall_e = wall; }
  map_set_hex(m, q, r, cy, cur);
}

// ── Spawn point CRUD (Phase 4.10) ─────────────────────────────────

// Add a spawn point to the map.  The spawn's hex flag (bit 5 of
// h_item_rotation) is set as a side-effect so renderers can show a
// spawn marker without scanning the whole spawn list.
pub fn spawn_add(m: Map, sp: SpawnPoint) {
  m.m_spawn_points += [sp];
  // Flag the hex: bit 5 = spawn, preserve other bits.
  cur = map_get_hex(m, sp.sp_hex.ha_q, sp.sp_hex.ha_r, sp.sp_hex.ha_cy);
  cur.h_item_rotation = (cur.h_item_rotation | 32) as u8? ?? 0;
  map_set_hex(m, sp.sp_hex.ha_q, sp.sp_hex.ha_r, sp.sp_hex.ha_cy, cur);
}

// Count spawns on the map.
pub fn spawn_count(m: Map) -> integer { len(m.m_spawn_points) }

// Find all spawns at a given hex address.
pub fn spawn_at(m: Map, q: integer, r: integer, cy: integer) -> vector<SpawnPoint> {
  result: vector<SpawnPoint> = [];
  for sa_sp in m.m_spawn_points {
    if sa_sp.sp_hex.ha_q == q && sa_sp.sp_hex.ha_r == r && sa_sp.sp_hex.ha_cy == cy {
      result += [sa_sp];
    }
  }
  result
}

// Remove the spawn matching (q, r, cy, npc_id).  Returns true if one was
// removed.  Clears the hex flag if no spawns remain on that hex.
pub fn spawn_remove(m: Map, q: integer, r: integer, cy: integer, npc_id: integer) -> boolean {
  keepers: vector<SpawnPoint> = [];
  removed = false;
  remaining_on_hex = 0;
  for sr_sp in m.m_spawn_points {
    if sr_sp.sp_hex.ha_q == q && sr_sp.sp_hex.ha_r == r && sr_sp.sp_hex.ha_cy == cy && sr_sp.sp_npc_id == npc_id && !removed {
      removed = true;
    } else {
      keepers += [sr_sp];
      if sr_sp.sp_hex.ha_q == q && sr_sp.sp_hex.ha_r == r && sr_sp.sp_hex.ha_cy == cy {
        remaining_on_hex = remaining_on_hex + 1;
      }
    }
  }
  m.m_spawn_points = keepers;
  if removed && remaining_on_hex == 0 {
    cur = map_get_hex(m, q, r, cy);
    cur.h_item_rotation = cur.h_item_rotation & ~32;
    map_set_hex(m, q, r, cy, cur);
  }
  removed
}

// ── NPC routine CRUD (Phase 4.11) ─────────────────────────────────

// Add a fresh NPC routine (no waypoints yet).
pub fn routine_add(m: Map, npc_id: integer, name: text, creature: integer) {
  m.m_npc_routines += [NpcRoutine {
    nr_npc_id:    npc_id,
    nr_name:      name,
    nr_creature:  creature,
    nr_waypoints: [],
  }];
}

// Count routines.
pub fn routine_count(m: Map) -> integer { len(m.m_npc_routines) }

// Look up a routine's index by npc_id.  Returns -1 if absent.
pub fn routine_index(m: Map, npc_id: integer) -> integer {
  for ri_r in m.m_npc_routines {
    if ri_r.nr_npc_id == npc_id { break ri_r#index; }
  }
  -1
}

// Remove a routine by npc_id.  Returns true if one was removed.
pub fn routine_remove(m: Map, npc_id: integer) -> boolean {
  keepers: vector<NpcRoutine> = [];
  removed = false;
  for rr_r in m.m_npc_routines {
    if rr_r.nr_npc_id == npc_id && !removed {
      removed = true;
    } else {
      keepers += [rr_r];
    }
  }
  m.m_npc_routines = keepers;
  removed
}

// ── Waypoint CRUD (Phase 4.11) ────────────────────────────────────

// Add a waypoint to a routine identified by npc_id.  Flags the target
// hex with the waypoint bit (bit 6).  Returns true if the routine was
// found.
pub fn waypoint_add(m: Map, npc_id: integer, wp: NpcWaypoint) -> boolean {
  found = false;
  for wa_r in m.m_npc_routines {
    if wa_r.nr_npc_id == npc_id {
      wa_r.nr_waypoints += [wp];
      found = true;
    }
  }
  if found {
    cur = map_get_hex(m, wp.wp_hex.ha_q, wp.wp_hex.ha_r, wp.wp_hex.ha_cy);
    cur.h_item_rotation = (cur.h_item_rotation | 64) as u8? ?? 0;  // bit 6
    map_set_hex(m, wp.wp_hex.ha_q, wp.wp_hex.ha_r, wp.wp_hex.ha_cy, cur);
  }
  found
}

// Count a routine's waypoints.  Returns 0 if the routine is absent.
pub fn waypoint_count(m: Map, npc_id: integer) -> integer {
  for wc_r in m.m_npc_routines {
    if wc_r.nr_npc_id == npc_id { return len(wc_r.nr_waypoints); }
  }
  0
}

// ── Wall direction resolution (Phase 4.4) ─────────────────────────

// Set a wall in any of the 6 directions (0=N, 1=NE, 2=SE, 3=S, 4=SW,
// 5=NW).  Directions 0–2 are stored on the target hex; directions 3–5
// are stored as the opposite edge on the appropriate neighbour hex.
// Uses axial-coordinate neighbour offsets.
pub fn map_set_wall_dir(m: Map, q: integer, r: integer, cy: integer, dir: integer, wall: u8) {
  if dir == 0 { map_set_wall(m, q, r, cy, 0, wall); }
  if dir == 1 { map_set_wall(m, q, r, cy, 1, wall); }
  if dir == 2 { map_set_wall(m, q, r, cy, 2, wall); }
  if dir == 3 { map_set_wall(m, q, r + 1, cy, 0, wall); }   // S = neighbour (q, r+1)'s N
  if dir == 4 { map_set_wall(m, q - 1, r + 1, cy, 1, wall); } // SW = neighbour (q-1, r+1)'s NE
  if dir == 5 { map_set_wall(m, q - 1, r, cy, 2, wall); }   // NW = neighbour (q-1, r)'s SE
}

// ── Hex-grid geometry (Phase 4.8) ─────────────────────────────────

// ⚠ `hex_distance` USED TO LIVE HERE, and it was the AXIAL cube distance —
// `max(|dq|, |dr|, |dq+dr|)` — applied to coordinates that are odd-r OFFSET
// (`SCENE_MAP.md`, decision 2). It called `(0,0)` and its SW neighbour `(-1,-1)`
// two steps apart, and every caller inherited that: the editor's road width,
// scatter reach, storey footprint and house outline were all sheared blobs rather
// than discs until rung W2 measured one (moros#10).
//
// It is not fixed here, it is GONE: `hex_grid` owns the lattice and already
// exports the right one, so `use hex_grid` above puts the correct `hex_distance`
// in scope under the same name and every call site becomes right without moving.
// Two implementations of one lattice rule is the defect; a corrected second copy
// would still be a second copy.

// Integer linear interpolation: a + (b - a) * i / n.
//
// ⚠ For a HEIGHT, a count, anything scalar. NOT for a coordinate pair — see
// `hex_line_at`, which is what a lattice line needs and what this was doing.
pub fn lerp_int(a: integer, b: integer, i: integer, n: integer) -> integer {
  if n == 0 { return a; }
  // `n == 0` returned above, so the fallback is unreachable.
  a + ((b - a) * i / n ?? 0)
}

// ── A LINE ON THE LATTICE ───────────────────────────────────────────────────
//
// The `i`-th of `n` steps from (q1,r1) to (q2,r2), in odd-r offset coordinates.
//
// **Lerping q and r independently does not draw a line.** It was what `slope_path`
// did, and measured (`probe/slopeline.loft`) a diagonal run came out with THREE
// disconnected steps — consecutive cells that are not neighbours — so the "slope"
// it drew was a dotted line with holes in it. Along the axes it was exact, which
// is why four axis-aligned tests never noticed.
//
// The line is interpolated in AXIAL space and rounded by `hex_grid::hex_round`, so
// the parity-sensitive part is the library's and not a fourth copy of it here. The
// epsilon nudge is the standard one: a point landing exactly on a cell boundary
// rounds arbitrarily, and an arbitrary choice is where a path loses its
// connectedness.
pub fn hex_line_at(q1: integer, r1: integer, q2: integer, r2: integer,
                   i: integer, n: integer) -> (integer, integer) {
  if n == 0 { return (q1, r1); }
  aq1 = q1 - ((r1 - (r1 & 1)) / 2 ?? 0);
  aq2 = q2 - ((r2 - (r2 & 1)) / 2 ?? 0);
  t = (i as float) / (n as float) ?? 0.0;
  qf = (aq1 as float) + ((aq2 - aq1) as float) * t + 0.000001;
  rf = (r1 as float) + ((r2 - r1) as float) * t + 0.000002;
  (raq, rar) = hex_grid::hex_round(qf, rf);
  (raq + ((rar - (rar & 1)) / 2 ?? 0), rar)
}

// ── Slope operations (Phase 4.8–4.9) ──────────────────────────────

// Linearly interpolate heights from h_start at (q1,r1) to h_end at
// (q2,r2) along a straight hex-grid line.  All hexes on the path
// (inclusive of both endpoints) have their height set.
pub fn slope_path(m: Map, q1: integer, r1: integer, q2: integer, r2: integer, cy: integer, h_start: u16, h_end: u16) {
  dist = hex_distance(q1, r1, q2, r2);
  if dist == 0 {
    map_set_height(m, q1, r1, cy, h_start);
    return;
  }
  for i in 0..=dist {
    (q, r) = hex_line_at(q1, r1, q2, r2, i, dist);
    h = lerp_int(h_start, h_end, i, dist) as u16? ?? 0;
    map_set_height(m, q, r, cy, h);
  }
}

// Slope a band of hexes: for each step along the (q1,r1)→(q2,r2)
// line, also set the `width` hexes perpendicular to the path
// direction (centred on the path).  Only uniform height across the
// band; no cross-section interpolation.
pub fn slope_band(m: Map, q1: integer, r1: integer, q2: integer, r2: integer, cy: integer, h_start: u16, h_end: u16, width: integer) {
  dist = hex_distance(q1, r1, q2, r2);
  if dist == 0 {
    map_set_height(m, q1, r1, cy, h_start);
    return;
  }
  half = width / 2;
  for i in 0..=dist {
    (q, r) = hex_line_at(q1, r1, q2, r2, i, dist);
    h = lerp_int(h_start, h_end, i, dist) as u16? ?? 0;
    // ⚠ The band's own offset is `q + offset`, which is perpendicular to the path
    // only when the path runs north-south. That crudeness is older than this fix
    // and is left named rather than quietly widened: a real perpendicular needs
    // the path's direction, which is a different change.
    for w in 0..width {
      offset = w - half;
      map_set_height(m, q + offset, r, cy, h);
    }
  }
}

// ── The shared document format (moros#4) ─────────────────────────────────
//
// Moros's dense 8-byte cell and hex_field's parallel arrays are ONE model —
// moros#1 probed it — with the cell as a storage concern over the field.  This
// is that seam: a Map layer converts to a field, writes through hex_field's
// format, and comes back.
//
// What crosses today: occupancy, height, material.  Items, item rotation and the
// three wall bytes do NOT — this writer calls the cells/heights/labels form of
// doc_write and never builds an EdgeSet.
//
// That is now OUR gap, not the format's.  hex_field grew an edge section on
// 2026-07-22 and we already read one (test_moros_reads_the_walled_fixture), so
// walls could cross today.  Note that test_items_and_walls_do_not_survive_yet
// does NOT catch this: it was written to fail "the day a section appears", but it
// watches our round trip, and our round trip drops the walls before the format
// ever sees them — so the section appeared and the test stayed green.  Carrying
// the walls is what makes it fail, and then it wants deleting rather than fixing.

// A label the voxel cannot hold. Named rather than numbered so a caller can say
// WHY it refused, which is `K-FIT`'s rule: never a blank no.
pub const ML_LABEL_TOO_WIDE = 64;

pub struct MapLoad {
  ml_code: integer,
  ml_map:  Map,
}

// Convert one cy layer of `m` over the extent (q0,r0,w,h) and write it.
pub fn map_write_field(
  m: Map, cy: integer, q0: integer, r0: integer, w: integer, h: integer, path: text
) {
  fs = hexset_chunk(q0, r0, w, h);
  fz = heights_new(q0, r0, w, h);
  fl = labels_new(q0, r0, w, h);
  for q in 0..w {
    for r in 0..h {
      cell = map_get_hex(m, q0 + q, r0 + r, cy);
      if cell.h_material != 0 {
        hexset_set(fs, q0 + q, r0 + r, true);
        height_set(fz, q0 + q, r0 + r, cell.h_height as float);
        label_set(fl, q0 + q, r0 + r, cell.h_material);
      }
    }
  }
  doc_write(path, fs, fz, fl, true, true);
}

// Read a field back into a Map at layer `cy`.  On refusal the code is non-zero
// and the map is empty — never half-populated.
pub fn map_read_field(path: text, cy: integer) -> MapLoad {
  d = doc_read(path);
  out = map_empty();
  if d.doc_code != 0 {
    return MapLoad { ml_code: d.doc_code, ml_map: out };
  }
  q0 = hexset_q0(d.doc_cells);
  r0 = hexset_r0(d.doc_cells);
  w  = hexset_w(d.doc_cells);
  h  = hexset_h(d.doc_cells);
  for q in 0..w {
    for r in 0..h {
      if hexset_get(d.doc_cells, q0 + q, r0 + r) {
        // ⚠ THE SEAM WHERE THE WIDER FORMAT MEETS THE NARROWER VOXEL.
        //
        // `hex_field` keeps labels as i32 and heights as f64 ON PURPOSE, so a
        // consumer can hold its own unit; `L13` then says the NARROWER one binds,
        // and moros's is the narrower. The compact voxel makes that a real limit
        // rather than a documented one: a label past 255 has nowhere to go.
        //
        // It is REFUSED, not quietly substituted. Voiding the cell would lose it
        // silently and clamping to 255 would make it a DIFFERENT material — the
        // exact "silent wrong data" this stack refuses everywhere else. The
        // shared fixture carries a 301 precisely to exercise this.
        raw_mat = if d.doc_has_l { label_get(d.doc_labels, q0 + q, r0 + r) } else { 1 };
        if raw_mat < 0 || raw_mat > 255 {
          return MapLoad { ml_code: ML_LABEL_TOO_WIDE, ml_map: map_empty() };
        }
        mat = raw_mat as u8? ?? 0;
        map_paint_material(out, q0 + q, r0 + r, cy, mat);
        if d.doc_has_h {
          // Our height unit is an integer; a fractional height from another
          // consumer truncates HERE, visibly, rather than somewhere downstream.
          map_set_height(out, q0 + q, r0 + r, cy, height_get(d.doc_heights, q0 + q, r0 + r) as u16? ?? 0);
        }
      }
    }
  }
  MapLoad { ml_code: 0, ml_map: out }
}

// ── Stencils, via the library mechanism (moros#5) ────────────────────────
//
// A Moros stencil is a hex_field Stencil: cells, heights, an unnamed label layer
// for the material, named layers for the item and its rotation, and an EdgeSet
// for the walls.  Rotation, the 12 orientations and stamping all come from the
// library — this file only translates between our packed cell and those layers.
//
// The wall mapping is exact and not a coincidence.  Our cell stores three edges
// and hex_field stores one slot per edge from a canonical direction set; ours
// are NW, NE and E, and the canonical set is {3, 2, 0} — the same three.  So each
// stored wall maps to a canonical slot with no re-keying.
//
// The field names still say n/ne/se; only `wall_ne` is accurate (moros#3).
pub const DIR_E  = 0;      // h_wall_e
pub const DIR_NE = 2;      // h_wall_ne
pub const DIR_NW = 3;      // h_wall_nw

// ── Facing: TWELVE placements, named as hours on the clock (moros#5) ─────
//
// A pointy-top hex puts corner 0 straight up — `hex_grid::hex_corner_offset`
// returns (0, 1) — so the clock face names real directions on this lattice.
//
// There are TWELVE facings, not six, and the second six come from the FLIP.
// Six 60° turns give six placements two hours apart; mirroring gives six more
// that land BETWEEN them and never coincide with a turn.  This was measured, on
// a stencil with a marker cell two steps East and one North-East: the six rotated
// markers and the six mirrored markers were twelve distinct cells on one ring,
// with zero collisions, alternating round the dial.
//
// > The measurement matters because the obvious test gets the WRONG answer. Put
// > the marker on a RADIAL edge — a door in the middle of a wall — and it sits
// > exactly on a mirror axis, so its mirror orbit IS its rotation orbit and the
// > twelve collapse to six.  That degenerate case is easy to build by accident
// > and reads as proof that only six facings exist.  It is not: it is proof that
// > the feature you measured was symmetric.
//
// So a facing is an index 0..11 over the dial:
//
//   EVEN index  → a turn:  rotation n,        at hour 3 + 2n   (3 5 7 9 11 1)
//   ODD  index  → a flip:  mirror + rotate n, at hour 4 + 2n   (4 6 8 10 12 2)
//
// Turns keep the hours their own geometry produces — base facing is 3 o'clock
// (East) and `cell_rot` turns clockwise — and the flips fill the hours between.
// All twelve hours are reachable, which is why the dial can offer twelve.
//
// tests/clock.loft derives this from `cell_rot` on every run rather than
// restating it, so if the lattice convention moves the table fails rather than
// drifts.
pub const FACING_BASE_HOUR = 3;
pub const FACING_COUNT     = 12;

// The clock hour a neighbour direction points at.  Edge directions are the odd
// hours; the even hours are the corner directions between them.
pub fn dir_hour(d: integer) -> integer {
  if d == DIR_E  { return 3; }
  if d == 1      { return 9; }     // W
  if d == DIR_NE { return 1; }
  if d == DIR_NW { return 11; }
  if d == 4      { return 5; }     // SE
  7                                // SW
}

// Normalise any integer onto the twelve-position dial.  The parentheses are
// load-bearing: `x ?? 0 + FACING_COUNT` binds as `x ?? (0 + FACING_COUNT)`, which
// silently skips the wrap and leaves a negative facing negative.
pub fn facing_norm(f: integer) -> integer {
  m = (f % FACING_COUNT) ?? 0;
  ((m + FACING_COUNT) % FACING_COUNT) ?? 0
}

// Is this facing a mirrored placement rather than a plain turn?
pub fn facing_flipped(f: integer) -> boolean { (facing_norm(f) % 2 ?? 0) == 1 }

// How many 60° turns this facing applies (after the flip, if any).
pub fn facing_turns(f: integer) -> integer { (facing_norm(f) / 2) ?? 0 }

// The hour this facing sits at on the dial.
pub fn facing_hour(f: integer) -> integer {
  n = facing_turns(f);
  base = FACING_BASE_HOUR;
  if facing_flipped(f) { base = FACING_BASE_HOUR + 1; }
  h = (base + 2 * n) % 12 ?? 0;
  if h == 0 { return 12; }
  h
}

// The facing that sits at hour `h`, or -1 if `h` is not an hour.  Every hour
// 1..12 is reachable now — the odd ones by turning, the even ones by flipping.
pub fn hour_facing(h: integer) -> integer {
  out = -1;
  for f in 0..FACING_COUNT { if facing_hour(f) == h { out = f; } }
  out
}

pub fn hour_text(h: integer) -> text { "{h} o'clock" }

// How a facing reads in the UI: the hour, and whether it is mirrored.
pub fn facing_text(f: integer) -> text {
  if facing_flipped(f) { return "{hour_text(facing_hour(f))} mirrored"; }
  hour_text(facing_hour(f))
}

// Turn a stencil to a dial position.  THE one place that knows a facing is a
// mirror-then-rotate: every caller goes through here, so none of them can get the
// order wrong or forget the flip on the odd hours.  Mirroring first and rotating
// second is what makes the twelve alternate — the other order gives the same
// twelve placements but walks the dial backwards.
pub fn stencil_placed(st: Stencil, f: integer) -> Stencil {
  if facing_flipped(f) { return stencil_rotate(stencil_mirror(st), facing_turns(f)); }
  stencil_rotate(st, facing_turns(f))
}

pub const LAYER_ITEM = "item";
pub const LAYER_ROT  = "rotation";

// Capture a region of a map as a stencil.
pub fn map_to_stencil(m: Map, cy: integer, q0: integer, r0: integer, w: integer, h: integer) -> Stencil {
  cells = hexset_chunk(q0, r0, w, h);
  hz    = heights_new(q0, r0, w, h);
  lb    = labels_new(q0, r0, w, h);
  eg    = edgeset_new(q0, r0, w, h);
  // Populate the field BEFORE constructing the stencil — it takes them by value.
  for iq in 0..w {
    for ir in 0..h {
      cq = q0 + iq;
      cr = r0 + ir;
      cell = map_get_hex(m, cq, cr, cy);
      if cell.h_material != 0 {
        hexset_set(cells, cq, cr, true);
        height_set(hz, cq, cr, cell.h_height as float);
        label_set(lb, cq, cr, cell.h_material);
      }
      // Walls come from EVERY cell, occupied or not.  An edge is stored against
      // one of its two cells, and for three of the six directions that owner is
      // the neighbour — so the wall ringing a room is often held by the empty cell
      // outside it.  Reading walls only from material-bearing cells drops those,
      // silently and asymmetrically.
      if cell.h_wall_nw != 0  { edge_set_mat(eg, cq, cr, nb_q(cq, cr, DIR_NW), nb_r(cq, cr, DIR_NW), cell.h_wall_nw); }
      if cell.h_wall_ne != 0 { edge_set_mat(eg, cq, cr, nb_q(cq, cr, DIR_NE), nb_r(cq, cr, DIR_NE), cell.h_wall_ne); }
      if cell.h_wall_e != 0 { edge_set_mat(eg, cq, cr, nb_q(cq, cr, DIR_E),  nb_r(cq, cr, DIR_E),  cell.h_wall_e); }
    }
  }
  st = stencil_with_edges(cells, hz, lb, eg, true, true);
  layer_add(st.sn_layers, LAYER_ITEM);
  layer_add(st.sn_layers, LAYER_ROT);
  for iq in 0..w {
    for ir in 0..h {
      cq = q0 + iq;
      cr = r0 + ir;
      cell = map_get_hex(m, cq, cr, cy);
      if cell.h_material != 0 {
        layer_set(st.sn_layers, LAYER_ITEM, cq, cr, cell.h_item);
        layer_set(st.sn_layers, LAYER_ROT,  cq, cr, cell.h_item_rotation);
      }
    }
  }
  st
}

// Stamp a stencil into a map so its (0,0) lands on (aq, ar).  The translation and
// the wall re-keying are the LIBRARY's — this stamps into scratch field layers and
// then reads them into the Map, rather than re-implementing the lattice arithmetic
// a second time.
pub fn stencil_into_map(m: Map, st: Stencil, aq: integer, ar: integer, cy: integer) {
  sw = hexset_w(st.sn_cells);
  sh = hexset_h(st.sn_cells);
  // scratch, padded so a rotated or offset stamp still lands inside it
  pq = aq - sw - 1;
  pr = ar - sh - 1;
  pw = sw * 3 + 2;
  ph = sh * 3 + 2;
  sc = hexset_chunk(pq, pr, pw, ph);
  sz = heights_new(pq, pr, pw, ph);
  sl = labels_new(pq, pr, pw, ph);
  sy = layers_new(pq, pr, pw, ph);
  se = edgeset_new(pq, pr, pw, ph);
  stencil_stamp_all(sc, sz, sl, sy, se, st, aq, ar);
  for iq in 0..pw {
    for ir in 0..ph {
      cq = pq + iq;
      cr = pr + ir;
      if hexset_get(sc, cq, cr) {
        map_paint_material(m, cq, cr, cy, label_get(sl, cq, cr) as u8? ?? 0);
        map_set_height(m, cq, cr, cy, height_get(sz, cq, cr) as u16? ?? 0);
        map_place_item(m, cq, cr, cy, layer_get(sy, LAYER_ITEM, cq, cr) as u8? ?? 0,
                       layer_get(sy, LAYER_ROT, cq, cr) as u8? ?? 0);
      }
      // Walls go to EVERY cell in the window, not only the occupied ones — the
      // wall around a room is owned by the empty cell outside it for three of the
      // six directions.  Gating this on occupancy dropped 9 of the door house's 17
      // walls, and did it symmetrically enough that no count ever noticed.
      write_stamped_walls(m, se, cq, cr, cy);
    }
  }
}

// Copy the three canonically-owned edges of one cell out of a stamped EdgeSet.
// Shared by both stamp paths so they cannot drift apart on which edges they carry.
fn write_stamped_walls(m: Map, se: EdgeSet, cq: integer, cr: integer, cy: integer) {
  wn = edge_mat(se, cq, cr, nb_q(cq, cr, DIR_NW), nb_r(cq, cr, DIR_NW));
  we = edge_mat(se, cq, cr, nb_q(cq, cr, DIR_NE), nb_r(cq, cr, DIR_NE));
  ws = edge_mat(se, cq, cr, nb_q(cq, cr, DIR_E),  nb_r(cq, cr, DIR_E));
  if wn != 0 { map_set_wall(m, cq, cr, cy, 0, wn as u8? ?? 0); }
  if we != 0 { map_set_wall(m, cq, cr, cy, 1, we as u8? ?? 0); }
  if ws != 0 { map_set_wall(m, cq, cr, cy, 2, ws as u8? ?? 0); }
}

// ── Merge modes — Moros POLICY over the library's stamp ──────────────────
//
// The library stamps a field: occupied cells win, everything else is untouched.
// WHICH of our six cell fields a stamp writes is a Moros decision, so it lives
// here rather than in hex_field — another consumer wants different modes, or
// none.
//
// REPLACE works over the stencil's whole EXTENT, not just its occupied cells,
// because "replace" has to be able to clear.  The old implementation could do
// that by recording a hex with material 0; the field model has no such hex — an
// unoccupied cell is *not part of the stencil* rather than *explicitly empty* —
// so the extent is what defines the footprint being replaced.
pub const STAMP_REPLACE   = 0;
pub const STAMP_OVERLAY   = 1;
pub const STAMP_HEIGHTS   = 2;
pub const STAMP_STRUCTURE = 3;

pub fn stencil_into_map_mode(m: Map, st: Stencil, aq: integer, ar: integer, cy: integer, mode: integer) {
  sw = hexset_w(st.sn_cells);
  sh = hexset_h(st.sn_cells);
  pq = aq - sw - 1;
  pr = ar - sh - 1;
  pw = sw * 3 + 2;
  ph = sh * 3 + 2;
  sc = hexset_chunk(pq, pr, pw, ph);
  sz = heights_new(pq, pr, pw, ph);
  sl = labels_new(pq, pr, pw, ph);
  sy = layers_new(pq, pr, pw, ph);
  se = edgeset_new(pq, pr, pw, ph);
  stencil_stamp_all(sc, sz, sl, sy, se, st, aq, ar);

  // REPLACE also clears the footprint's unoccupied cells, so mark which target
  // cells the extent covers at all.
  cov = hexset_chunk(pq, pr, pw, ph);
  dk = lattice_k(aq, ar);
  dm = lattice_m(aq, ar);
  sq0 = hexset_q0(st.sn_cells);
  sr0 = hexset_r0(st.sn_cells);
  for iq in 0..sw {
    for ir in 0..sh {
      (cq, cr) = lattice_to_cell(lattice_k(sq0 + iq, sr0 + ir) + dk,
                                 lattice_m(sq0 + iq, sr0 + ir) + dm);
      hexset_set(cov, cq, cr, true);
    }
  }

  for iq in 0..pw {
    for ir in 0..ph {
      cq = pq + iq;
      cr = pr + ir;
      here = hexset_get(sc, cq, cr);
      if hexset_get(cov, cq, cr) {
        cur = map_get_hex(m, cq, cr, cy);
        // THE NARROWING HAPPENS ONCE, HERE — and it is CHECKED. `as u8?` yields
        // null when the value does not fit and `?? 0` names the fallback, so an
        // out-of-range index becomes void rather than wrapping into a different
        // palette entry. loft refuses the unchecked form outright, which is what
        // turned "the documented widths are enforced nowhere" into a compile
        // error at all 31 sites that had been storing unbounded integers.
        //
        // where hex_field's wider model meets
        // the voxel. `Heights` is float and `Labels` is i32 by design (the format
        // keeps the wider slot so a consumer can keep its own unit), and the
        // voxel is the narrower one, so `L13`'s "the narrower one binds" is a
        // real conversion at a real boundary rather than a silent store.
        smat = (if here { label_get(sl, cq, cr) } else { 0 }) as u8? ?? 0;
        shgt = (if here { height_get(sz, cq, cr) as integer } else { 0 }) as u16? ?? 0;
        sitm = (if here { layer_get(sy, LAYER_ITEM, cq, cr) } else { 0 }) as u8? ?? 0;
        srot = (if here { layer_get(sy, LAYER_ROT, cq, cr) } else { 0 }) as u8? ?? 0;
        // Walls are NOT gated on occupancy: three of the six directions store the
        // edge against the neighbour, so a room's wall is owned by the empty cell
        // outside it.  Material and height stay gated — those really are per-cell.
        swn = edge_mat(se, cq, cr, nb_q(cq, cr, DIR_NW), nb_r(cq, cr, DIR_NW)) as u8? ?? 0;
        swe = edge_mat(se, cq, cr, nb_q(cq, cr, DIR_NE), nb_r(cq, cr, DIR_NE)) as u8? ?? 0;
        sws = edge_mat(se, cq, cr, nb_q(cq, cr, DIR_E),  nb_r(cq, cr, DIR_E)) as u8? ?? 0;

        if mode == STAMP_REPLACE {
          cur.h_height = shgt; cur.h_material = smat;
          cur.h_item = sitm; cur.h_item_rotation = srot;
          cur.h_wall_nw = swn; cur.h_wall_ne = swe; cur.h_wall_e = sws;
        }
        if mode == STAMP_OVERLAY {
          if shgt != 0 { cur.h_height = shgt; }
          if smat != 0 { cur.h_material = smat; }
          if sitm != 0 { cur.h_item = sitm; }
          if srot != 0 { cur.h_item_rotation = srot; }
          if swn != 0 { cur.h_wall_nw = swn; }
          if swe != 0 { cur.h_wall_ne = swe; }
          if sws != 0 { cur.h_wall_e = sws; }
        }
        if mode == STAMP_HEIGHTS { cur.h_height = shgt; }
        if mode == STAMP_STRUCTURE {
          cur.h_material = smat; cur.h_item = sitm; cur.h_item_rotation = srot;
          cur.h_wall_nw = swn; cur.h_wall_ne = swe; cur.h_wall_e = sws;
        }
        map_set_hex(m, cq, cr, cy, cur);
      }
    }
  }

  // The rim.  A wall on the boundary of the stencil can be owned by a cell just
  // OUTSIDE the stamped footprint, which the loop above never visits — `cov` is
  // the extent, and the owner is one step beyond it.  Those walls are added, never
  // cleared: we are outside the footprint, so REPLACE has no business erasing
  // anything here.
  for iq in 0..pw {
    for ir in 0..ph {
      cq = pq + iq;
      cr = pr + ir;
      if !hexset_get(cov, cq, cr) { write_stamped_walls(m, se, cq, cr, cy); }
    }
  }
}
