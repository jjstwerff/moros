// Tests for hex geometry, wall direction resolution, and slope operations.
use moros_map;
use hex_grid;

// ── Hex distance ─────────────────────────────────────────────────
//
// ⚠ THESE TESTS USED TO ASSERT THE BUG. `hex_distance` was moros_map's own AXIAL
// cube distance applied to ODD-R OFFSET coordinates, and two assertions here
// stated its answers as if they were the lattice's: that `(1,-1)` is adjacent to
// the origin (it is two steps away) and that `(5,5)` is ten steps off (it is
// eight). The wrong function and the wrong test agreed, which is what let it
// survive — and it sheared every disc in the editor until rung W2 measured one
// (moros#10). The function is gone; `hex_grid` owns the lattice.

fn test_hex_distance_same() {
  assert(hex_distance(5, 7, 5, 7) == 0, "same hex → 0");
}

fn test_hex_distance_adjacent() {
  // The six neighbours of an EVEN row, which is where offset and axial agree
  // least: odd rows are shifted half a hex right, so the diagonals differ by
  // parity and there is no single (dq, dr) pair that names a neighbour.
  assert(hex_distance(0, 0, 1, 0) == 1, "E");
  assert(hex_distance(0, 0, 0, 1) == 1, "NE of an even row");
  assert(hex_distance(0, 0, -1, 1) == 1, "NW of an even row");
  assert(hex_distance(0, 0, 0, -1) == 1, "SE of an even row");
  assert(hex_distance(0, 0, -1, -1) == 1, "SW of an even row");
  assert(hex_distance(0, 0, -1, 0) == 1, "W");
  // and the same for an ODD row, where the diagonals move
  assert(hex_distance(0, 1, 1, 2) == 1, "NE of an odd row");
  assert(hex_distance(0, 1, 0, 2) == 1, "NW of an odd row");
}

// THE CONTROL. `(1,-1)` is what the axial reading called adjacent, and it is the
// single assertion that separates the two conventions at distance one. Without a
// cell that the wrong answer gets wrong, every test above passes under both.
fn test_hex_distance_the_axial_reading_is_not_this_lattice() {
  assert(hex_distance(0, 0, 1, -1) == 2, "(1,-1) is TWO steps, not one");
  assert(hex_distance(0, 0, 5, 5) == 8, "(5,5) is eight steps, not ten");
  assert(hex_distance(0, 0, 3, 0) == 3, "straight line q");
  assert(hex_distance(0, 0, 0, 4) == 4, "straight line r");
}

// ── The line ─────────────────────────────────────────────────────
//
// A path is a LINE only if consecutive cells are neighbours. Lerping q and r
// independently is exact along the axes and disconnected everywhere else — three
// broken steps on a (0,0)→(5,5) run — so the four slope tests below, all
// axis-aligned, could not see it. This one is diagonal on purpose.

fn test_hex_line_is_connected_in_every_direction() {
  ends_q: vector<integer> = [5, 5, -3, -1, 0, 7];
  ends_r: vector<integer> = [5, 6, 2, -6, -7, -3];
  starts_q: vector<integer> = [0, 0, -3, -4, 2, -2];
  starts_r: vector<integer> = [0, 1, -3, -1, 3, 4];
  for k in 0..len(ends_q) {
    q1 = starts_q[k]; r1 = starts_r[k]; q2 = ends_q[k]; r2 = ends_r[k];
    d = hex_distance(q1, r1, q2, r2);
    pq = q1; pr = r1;
    for i in 0..=d {
      (q, r) = hex_line_at(q1, r1, q2, r2, i, d);
      if i > 0 {
        step = hex_distance(pq, pr, q, r);
        assert(step == 1, "({q1},{r1})->({q2},{r2}) step {i} jumps {step} cells");
      }
      pq = q; pr = r;
    }
    assert(pq == q2 && pr == r2, "({q1},{r1})->({q2},{r2}) ends at ({pq},{pr})");
  }
}

// ── Wall direction resolution ────────────────────────────────────

fn test_wall_dir_local() {
  m = map_empty();
  map_set_wall_dir(m, 3, 3, 0, 0, 10);   // N — local
  map_set_wall_dir(m, 3, 3, 0, 1, 11);   // NE — local
  map_set_wall_dir(m, 3, 3, 0, 2, 12);   // SE — local
  h = map_get_hex(m, 3, 3, 0);
  assert(h.h_wall_nw == 10, "N wall");
  assert(h.h_wall_ne == 11, "NE wall");
  assert(h.h_wall_e == 12, "SE wall");
}

fn test_wall_dir_neighbour() {
  m = map_empty();
  // S wall (dir 3) → stored on (q, r+1) as wall_n
  map_set_wall_dir(m, 3, 3, 0, 3, 20);
  h_s = map_get_hex(m, 3, 4, 0);
  assert(h_s.h_wall_nw == 20, "S wall on southern neighbour's N");

  // SW wall (dir 4) → stored on (q-1, r+1) as wall_ne
  map_set_wall_dir(m, 3, 3, 0, 4, 21);
  h_sw = map_get_hex(m, 2, 4, 0);
  assert(h_sw.h_wall_ne == 21, "SW wall on SW neighbour's NE");

  // NW wall (dir 5) → stored on (q-1, r) as wall_se
  map_set_wall_dir(m, 3, 3, 0, 5, 22);
  h_nw = map_get_hex(m, 2, 3, 0);
  assert(h_nw.h_wall_e == 22, "NW wall on NW neighbour's SE");
}

// ── Slope path ───────────────────────────────────────────────────

fn test_slope_path_single_hex() {
  m = map_empty();
  slope_path(m, 5, 5, 5, 5, 0, 100, 100);
  assert(map_get_hex(m, 5, 5, 0).h_height == 100, "single hex height");
}

fn test_slope_path_straight_line() {
  m = map_empty();
  // Slope from (0,0) height 0 to (4,0) height 8 — 5 hexes, step = 2.
  slope_path(m, 0, 0, 4, 0, 0, 0, 8);
  assert(map_get_hex(m, 0, 0, 0).h_height == 0, "start=0");
  assert(map_get_hex(m, 1, 0, 0).h_height == 2, "step1=2");
  assert(map_get_hex(m, 2, 0, 0).h_height == 4, "step2=4");
  assert(map_get_hex(m, 3, 0, 0).h_height == 6, "step3=6");
  assert(map_get_hex(m, 4, 0, 0).h_height == 8, "end=8");
}

fn test_slope_path_along_r() {
  m = map_empty();
  // Straight slope along the r axis.
  slope_path(m, 5, 0, 5, 3, 0, 0, 9);
  assert(map_get_hex(m, 5, 0, 0).h_height == 0, "r-start=0");
  assert(map_get_hex(m, 5, 1, 0).h_height == 3, "r-step1=3");
  assert(map_get_hex(m, 5, 2, 0).h_height == 6, "r-step2=6");
  assert(map_get_hex(m, 5, 3, 0).h_height == 9, "r-end=9");
}

fn test_slope_path_descending() {
  m = map_empty();
  slope_path(m, 0, 0, 3, 0, 0, 9, 0);
  assert(map_get_hex(m, 0, 0, 0).h_height == 9, "desc start=9");
  assert(map_get_hex(m, 1, 0, 0).h_height == 6, "desc step1=6");
  assert(map_get_hex(m, 2, 0, 0).h_height == 3, "desc step2=3");
  assert(map_get_hex(m, 3, 0, 0).h_height == 0, "desc end=0");
}

// ── Slope band ───────────────────────────────────────────────────

fn test_slope_band_width_3() {
  m = map_empty();
  // Band along r axis: (5,0)→(5,2) with width 3, height 0→4.
  // Width offsets in q: -1, 0, +1.
  // At step 0 (r=0): hexes (4,0), (5,0), (6,0) all get h=0.
  // At step 1 (r=1): hexes (4,1), (5,1), (6,1) all get h=2.
  // At step 2 (r=2): hexes (4,2), (5,2), (6,2) all get h=4.
  slope_band(m, 5, 0, 5, 2, 0, 0, 4, 3);
  assert(map_get_hex(m, 5, 0, 0).h_height == 0, "centre r=0 h=0");
  assert(map_get_hex(m, 5, 1, 0).h_height == 2, "centre r=1 h=2 got {map_get_hex(m, 5, 1, 0).h_height}");
  assert(map_get_hex(m, 5, 2, 0).h_height == 4, "centre r=2 h=4");
  // Side column at offset -1
  assert(map_get_hex(m, 4, 1, 0).h_height == 2, "left r=1 h=2");
  // Side column at offset +1
  assert(map_get_hex(m, 6, 1, 0).h_height == 2, "right r=1 h=2");
}
