// Moros's side of the shared document format (moros#4).  The format itself is
// gated in hex_field; this gates OUR conversion into and out of it.
use moros_map;
use hex_field;

fn authored() -> Map {
  m = map_empty();
  for q in 0..5 {
    for r in 0..4 {
      if (q + r) % 4 != 0 {
        map_paint_material(m, q, r, 0, (1 + (q % 3)) as u8? ?? 0);
        map_set_height(m, q, r, 0, (10 + q * 2 + r) as u16? ?? 0);
      }
    }
  }
  m
}

fn test_layer_round_trips_through_the_format() {
  m = authored();
  p = "moros_field_rt.bin";
  map_write_field(m, 0, 0, 0, 5, 4, p);
  ld = map_read_field(p, 0);
  assert(ld.ml_code == 0, "load refused with {ld.ml_code}");
  for q in 0..5 {
    for r in 0..4 {
      a = map_get_hex(m, q, r, 0);
      b = map_get_hex(ld.ml_map, q, r, 0);
      assert(a.h_material == b.h_material, "material differs at {q},{r}: {a.h_material} vs {b.h_material}");
      assert(a.h_height == b.h_height, "height differs at {q},{r}: {a.h_height} vs {b.h_height}");
    }
  }
  delete(p);
}

// Honest about the seam: three of our six cell fields have no section yet.
// When hex_field grows EdgeSet/Features this test FAILS, which is the point —
// it is a reminder to carry them, not a claim that dropping them is correct.
fn test_items_and_walls_do_not_survive_yet() {
  m = map_empty();
  map_paint_material(m, 1, 1, 0, 2);
  map_place_item(m, 1, 1, 0, 7, 9);
  map_set_wall(m, 1, 1, 0, 0, 4);
  p = "moros_field_gap.bin";
  map_write_field(m, 0, 0, 0, 3, 3, p);
  ld = map_read_field(p, 0);
  assert(ld.ml_code == 0, "load refused {ld.ml_code}");
  back = map_get_hex(ld.ml_map, 1, 1, 0);
  assert(back.h_material == 2, "material should survive");
  assert(back.h_item == 0, "item survived unexpectedly — hex_field grew a section, carry it");
  assert(back.h_wall_nw == 0, "wall survived unexpectedly — hex_field grew a section, carry it");
  delete(p);
}

// A fractional height from another consumer truncates at OUR boundary, not
// silently somewhere downstream.  Pinned so the choice is visible.
fn test_fractional_height_truncates_at_our_boundary() {
  s = hexset_chunk(0, 0, 2, 2);
  hz = heights_new(0, 0, 2, 2);
  lb = labels_new(0, 0, 2, 2);
  hexset_set(s, 0, 0, true);
  height_set(hz, 0, 0, 12.5);
  label_set(lb, 0, 0, 3);
  p = "moros_field_frac.bin";
  doc_write(p, s, hz, lb, true, true);
  ld = map_read_field(p, 0);
  assert(ld.ml_code == 0, "load refused {ld.ml_code}");
  assert(map_get_hex(ld.ml_map, 0, 0, 0).h_height == 12, "12.5 should land on 12 here");
  delete(p);
}

// Refusals must reach us as refusals, with an EMPTY map — never half-loaded.
fn test_refusal_yields_an_empty_map() {
  p = "moros_field_bad.bin";
  { f = file(p); f#format = LittleEndian; f += (12345 as i32); f += (1 as i32); }
  ld = map_read_field(p, 0);
  assert(ld.ml_code != 0, "bad magic was accepted");
  assert(len(ld.ml_map.m_chunks) == 0, "a refused load still produced chunks");
  delete(p);
}

// ── the interface gate ───────────────────────────────────────────────────
//
// ONE committed file, read by both consumers.  hex_field's own suite reads it
// too (tests/03-fixture.loft); if either side's reader or writer drifts, the
// other stops agreeing with a file neither can quietly regenerate.
//
// The path reaches into the sibling library checkout, which is the same
// assumption our loft.toml path dependency already makes.  Relative paths
// resolve from the TEST FILE's directory under `loft test`.
//
// ⚠ IT REACHES THERE THROUGH `source_dir()`, and that is not decoration.  A
// RELATIVE path containing `..` is refused, and refused SILENTLY:
// `file("../x")#size` is null, which every reader in this stack — ours included
// — cannot tell from a missing or empty file.  These two tests spent a while
// red with `HXF_TRUNCATED` for exactly that reason and nothing else; the
// fixtures were fine all along.  An ABSOLUTE path normalises properly and is
// served, `..` segments and all, so `{source_dir()}/..` is the portable way up:
// same file, same relationship, no checked-in symlink.  That relative and
// absolute disagree is the bug — filed as loft#712.
fn fixture_dir() -> text { "{source_dir()}/../../../../loft-libs-world/hex_field/tests/fixtures" }

// ⚠ THIS TEST CHANGED MEANING when the compact voxel landed (2026-07-25), and
// the change is the point rather than a repair.
//
// It used to assert that the fixture's label of **301** "arrives intact as our
// material index" — which was only ever true because the cell field was an
// unbounded `integer`. `SCENE_MAP.md` has always specified `material: u8`, so
// that assertion was pinning the IMPLEMENTATION's accident, not the design.
//
// `hex_field` keeps labels as i32 and heights as f64 deliberately, so another
// consumer can hold its own unit. `L13` says the narrower binds, and moros's is
// the narrower — so a 301 is now REFUSED at the seam with a named code, never
// voided (losing the cell) and never clamped to 255 (a different material).
// The fixture carries the 301 exactly to force this decision to be made.
fn test_moros_reads_the_shared_fixture() {
  ld = map_read_field("{fixture_dir()}/canonical.hxf", 0);
  assert(ld.ml_code == ML_LABEL_TOO_WIDE,
         "a label past the voxel's width must be REFUSED with a named reason, "
         + "got code {ld.ml_code}");
  // A refusal returns an EMPTY map, never a half-populated one — the same
  // never-half-loaded rule map_read_field already states for a bad document.
  assert(map_get_hex(ld.ml_map, 1, -1, 0).h_material == 0,
         "a refused load must leave the map empty");
}

// ⚠ THE FIXTURE CARRIES A SECOND VALUE THE VOXEL CANNOT HOLD, and it is worth
// naming even though the test above never reaches it: a height of **-3.5**.
// `h_height` is `u16` — UNSIGNED — because SCENE_MAP.md's world floor is 0 and
// a valley is made by raising everything around it. So a negative height is not
// a truncation, it is unrepresentable, exactly like the 301.
//
// Both are the same seam question and neither is moros's to answer alone: the
// shared format deliberately keeps the wider slot so other consumers hold their
// own units, and the fixture exists to make a narrow consumer decide out loud.
// Recorded here rather than asserted, because the label refuses first and this
// path is unreachable until that changes.

// The wall fixture, read from OUR side.  Walls do not reach a Moros Map yet —
// our cell has wall_n/ne/se and the reader has no home for them until the
// edge-to-cell mapping is settled (#5) — so this asserts what DOES arrive and
// pins the gap explicitly rather than leaving it unstated.  Same reach as the
// fixture above, and `fixture_dir` says why it is spelled through
// `source_dir()` rather than as a plain `../..` path.
fn test_moros_reads_the_walled_fixture() {
  ld = map_read_field("{fixture_dir()}/walled.hxf", 0);
  assert(ld.ml_code == 0, "the wall fixture did not load: {ld.ml_code}");
  filled = 0;
  for q in 0..3 {
    for r in 0..3 {
      if map_get_hex(ld.ml_map, -1 + q, -1 + r, 0).h_material != 0 { filled = filled + 1; }
    }
  }
  assert(filled == 9, "expected 9 cells from the wall fixture, got {filled}");
  assert(map_get_hex(ld.ml_map, 0, 1, 0).h_material == 4, "material lost");
  // THE GAP: the file carries a wall; our Map does not receive it yet.  When the
  // reader learns to place edges on cells this assertion flips and says so.
  assert(map_get_hex(ld.ml_map, 0, 1, 0).h_wall_e == 0,
         "a wall reached the Map — the edge-to-cell mapping landed, carry it properly");
}
