//
// DOES `hex_way` HOLD ITS OWN INVARIANTS OVER A SPREAD OF ARCS?
//
// ⚠ **THE SIX WORKED EXAMPLES ARE EACH ONE FIXTURE**, and every arc in them is authored
// with `a0 < a1` and both inside `[0, 2pi)`. `track_arc` takes plain floats, so the
// authored range is whatever a caller passes — and `seg_distance`'s arc branch
// normalises the point's angle **in one direction only**:
//
//     while aa < lo { aa = aa + 2pi; }        // …and never `while aa > hi { aa -= 2pi }`
//
// which is the shape [CLAUDE.md](../../CLAUDE.md) names — *a guard that works in ONE
// DIRECTION reads exactly like a guard*. This sweeps the claim that cannot be argued:
// **a point taken FROM a segment is zero distance from it.**
//
// ⚠ Each row is generated by `seg_point`, so the subject and the fixture are two
// different functions of the same track — a probe that re-derived the point from the
// same expression `seg_distance` uses could not be surprised.
use hex_way;
use hex_edge;
use hex_field;

const TAU = 6.283185307179586;

fn fabs(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

// Every point on this one-segment track must read distance 0 from it.
fn on_the_line(name: text, t: Track, bad: &integer) {
  l = track_len(t);
  worst = 0.0;
  at = 0.0;
  for k in 0..21 {
    s = l * (k as float) / 20.0 ?? 0.0;
    (px, py) = seg_point(t, 0, s);
    d = fabs(seg_distance(t, 0, px, py));
    if d > worst { worst = d; at = s; }
  }
  if worst > 0.000001 {
    println("way: ⛔ {name} — a point ON the segment reads {worst} away (at s={at})");
    bad = bad + 1;
  } else {
    println("way: ok {name} — every sampled point reads 0 away");
  }
}

// …and the milepost of that point must be the arc length it was taken at.
fn param_agrees(name: text, t: Track, bad: &integer) {
  l = track_len(t);
  worst = 0.0;
  at = 0.0;
  for k in 0..21 {
    s = l * (k as float) / 20.0 ?? 0.0;
    (px, py) = seg_point(t, 0, s);
    e = fabs(way_param(t, px, py) - s);
    if e > worst { worst = e; at = s; }
  }
  if worst > 0.0001 {
    println("way: ⛔ {name} — way_param is off by {worst} at s={at}");
    bad = bad + 1;
  } else {
    println("way: ok {name} — way_param returns the arc length it was sampled at");
  }
}

fn arc_of(cx: float, cy: float, r: float, a0: float, a1: float) -> Track {
  t = track_new();
  track_arc(t, cx, cy, r, a0, a1);
  t
}

fn main() {
  bad = 0;

  println("--- A. the authored angle range, one quarter turn each way ---");
  // ⚠ THE CONTROL COMES FIRST AND MUST PASS. A sweep whose every row fails says the
  // probe is wrong, not the subject.
  on_the_line("a0=0 a1=+pi/2   (the worked examples' own range)", arc_of(0.0, 0.0, 2.0, 0.0, TAU / 4.0), bad);
  on_the_line("a0=0 a1=-pi/2   (the same arc, swept the other way)", arc_of(0.0, 0.0, 2.0, 0.0, 0.0 - TAU / 4.0), bad);
  on_the_line("a0=+3pi/4 a1=+5pi/4  (crossing the atan2 cut at pi)", arc_of(0.0, 0.0, 2.0, 2.356194490192345, 3.9269908169872414), bad);

  println("--- B. the SAME arcs, authored one turn lower ---");
  // ⚠ These are the identical curves in the plane. An angle is a direction, not a
  // quantity, so a library that answers differently for `a0 - 2pi` is answering about
  // its own bookkeeping rather than about the geometry.
  on_the_line("a0=-2pi a1=-2pi+pi/2", arc_of(0.0, 0.0, 2.0, 0.0 - TAU, 0.0 - TAU + TAU / 4.0), bad);
  on_the_line("a0=-7.0 a1=-6.0", arc_of(0.0, 0.0, 2.0, 0.0 - 7.0, 0.0 - 6.0), bad);
  on_the_line("a0=+7.0 a1=+8.0", arc_of(0.0, 0.0, 2.0, 7.0, 8.0), bad);

  println("--- C. the milepost on the same spread ---");
  param_agrees("a0=0 a1=+pi/2", arc_of(0.0, 0.0, 2.0, 0.0, TAU / 4.0), bad);
  param_agrees("a0=-7.0 a1=-6.0", arc_of(0.0, 0.0, 2.0, 0.0 - 7.0, 0.0 - 6.0), bad);
  param_agrees("a0=+7.0 a1=+8.0", arc_of(0.0, 0.0, 2.0, 7.0, 8.0), bad);

  println("--- D. an offset is exactly |d| from the centreline, both signs ---");
  base = track_new();
  track_straight(base, 0.0 - 4.0, 0.0, 0.0, 0.0);
  track_arc(base, 0.0, 2.0, 2.0, 0.0 - TAU / 4.0, 0.0);
  for step in 0..2 {
    d = 0.5;
    if step == 1 { d = 0.0 - 0.5; }
    o = track_offset(base, d);
    worst = 0.0;
    for i in 0..o.tk_n {
      ol = seg_len(o, i);
      for k in 0..11 {
        s = ol * (k as float) / 10.0 ?? 0.0;
        (px, py) = seg_point(o, i, s);
        e = fabs(track_distance(base, px, py) - fabs(d));
        if e > worst { worst = e; }
      }
    }
    if worst > 0.000001 {
      println("way: ⛔ offset d={d} is off the centreline by {worst} somewhere");
      bad = bad + 1;
    } else {
      println("way: ok offset d={d} is exactly {fabs(d)} from the centreline");
    }
  }

  println("--- F. does the offset still JOIN where the centreline joins? ---");
  // ⛔ **ROW D PASSED AGAINST A KNOWN-BROKEN COPY, AND THAT IS THE POINT.**
  // Equidistance does not pick a side: put every arc on the far side of the way from
  // its straights and each one is still exactly |d| from the centreline. The library's
  // own comment says so — *"the number that sees it is the gap at a joint, not the
  // distance to the line"* — and my row D is that blind gate, rebuilt by hand before I
  // had read the sentence warning about it.
  jb = track_new();
  track_straight(jb, 0.0 - 4.0, 0.0, 0.0, 0.0);
  track_arc(jb, 0.0, 2.0, 2.0, 0.0 - TAU / 4.0, 0.0);
  for step in 0..2 {
    d = 0.5;
    if step == 1 { d = 0.0 - 0.5; }
    o = track_offset(jb, d);
    (ex, ey) = seg_point(o, 0, seg_len(o, 0));
    (sx, sy) = seg_point(o, 1, 0.0);
    gap = sqrt((ex - sx) * (ex - sx) + (ey - sy) * (ey - sy)) ?? 0.0;
    if gap > 0.000001 {
      println("way: ⛔ offset d={d} — the straight ends at ({ex},{ey}) and the arc "
              + "starts at ({sx},{sy}): a gap of {gap}, so the way is in two pieces");
      bad = bad + 1;
    } else {
      println("way: ok offset d={d} joins — gap {gap}");
    }
  }

  println("--- E. what it costs a consumer ---");
  cost();

  if bad == 0 { println("way: ALL ROWS HOLD"); }
  else { println("way: ⛔ {bad} row(s) failed"); }
}

// ── WHAT IT COSTS A CONSUMER ─────────────────────────────────────────────────
//
// ⚠ `seg_distance` is not a leaf: `track_distance`, `nearest_seg`, `way_mark`,
// `way_stamp`, `cut_arb` and `way_param`'s own segment choice all route through it. So
// the question a library user actually has is not *is the distance wrong* but **does
// the same curve rasterise to the same cells**.
fn marked_cells(t: Track) -> integer {
  s = hexset_new(12);
  way_mark(t, 0.9, s);
  n = 0;
  for r in 0 - 12..13 {
    for q in 0 - 12..13 {
      if hexset_get(s, q, r) { n = n + 1; }
    }
  }
  n
}

fn cost() {
  const TAU2 = 6.283185307179586;
  hi = arc_of(0.0, 0.0, 4.0, 0.0, TAU2 / 4.0);
  lo = arc_of(0.0, 0.0, 4.0, 0.0 - TAU2, 0.0 - TAU2 + TAU2 / 4.0);
  a = marked_cells(hi);
  b = marked_cells(lo);
  println("way: the SAME quarter arc marks {a} cells authored at [0, pi/2] "
          + "and {b} authored at [-2pi, -2pi+pi/2]");
  if a != b {
    println("way: ⛔ ONE CURVE, TWO FOOTPRINTS — the way is rasterised somewhere else "
            + "entirely, and nothing about the shape changed");
  } else {
    println("way: the footprints agree");
  }
}
