# K1 — THE SECOND SPELLING. The same six gestures, said as VERBS.
#
# Line for line the twin of `keyed.keys`, with one difference that is the whole
# point: the opening keys carried a profile and the verb does not, so where the
# original pressed `O` and `P` this one CHOOSES and then cuts.
#
# ⚠ THE EXTRA LINE IS NOT NOISE. `verb_of` maps six keys to one `opening`, so a
# script converted without `select` would build a byte-identical world with the
# wrong head on every door — `probe/k1/run.sh` control `C` measures exactly that.

echo --- flat ground to build on
at 0 0 0
verb raise
wait rebuilt

echo --- a house, on one of the six facings the lattice can mitre
at -6 -6 30
verb place

echo --- a ROUND-headed door and a POINTED window in its near wall
at -3 2 30
select 1
verb opening
at -1 3 30
select 2
verb opening

echo --- a fence ring, and a wall ring, well clear of the house
at 14 14 0
verb fence
at -16 10 0
verb wall

# The twin of `keyed.keys`'s last line, under its own name — see there for why the
# wire half needs a world beside the sentences.
save k1w-verbed
