# K1 — THE SIX GESTURES, AND THE SIDE `C` TREATS AS CORRECT.
#
# ⛔ **THIS WAS ONE OF A PAIR AND ITS TWIN IS GONE — plan 22 `K3b`.** `keyed.keys`
# said the same six things as KEY PRESSES, and the two were run side by side so a
# conversion could be compared exactly before `K2` touched a real script. The key
# spelling is deleted from both readers now, so what is left of this file is the
# CORRECT half of `wrong.keys`: they differ in one chosen kind and nothing else.
#
# ⚠ THE `select` LINES ARE NOT NOISE. Six keys named one `opening`, so a script
# converted without them would build a byte-identical world with the wrong head on
# every door — `run.sh` check `C` measures exactly that, and it is the only
# instrument in this tree that can.

echo --- flat ground to build on
at 0 0 0
verb raise
wait rebuilt

echo --- a house, on one of the six facings the lattice can mitre
at -6 -6 30
verb place

echo --- a ROUND-headed door and a POINTED window in its near wall
at -3 2 30
select opening 1
verb opening
at -1 3 30
select opening 2
verb opening

echo --- a fence ring, and a wall ring, well clear of the house
at 14 14 0
verb fence
at -16 10 0
verb wall
