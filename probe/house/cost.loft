// WHAT DOES THE FABRIC SCAN COST A STROKE? — `LEVEL` calls `brush` every footfall,
// so a per-cell predicate that asks six edge questions is a real bill, not a rounding.
use hex_editor;
use hex_world;
const U = 0.25;
const G = 40;
fn main() {
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 40)..41 {
    for r in (0 - 40)..41 { ground_set(w, q, r, G, SURFACE_MAT); }
  }
  n = 200;
  t0 = ticks();
  for i in 0..n {
    cl = 0;
    rs = 0;
    brush(w, (i % 9) - 4, (i % 7) - 3, if (i % 2) == 0 { 1 } else { 0 - 1 }, 7, cl, rs);
  }
  t1 = ticks();
  println("open ground: {n} strokes in {(t1 - t0) / 1000 ?? 0} ms "
        + "= {((t1 - t0) / n ?? 0) / 1000 ?? 0} ms a stroke");
  // and with a fence in the disc, so the flood actually runs
  for q in (0 - 4)..5 {
    for r in (0 - 4)..5 {
      if hex_distance(q, r, 0, 0) == 4 {
        for slot in 0..3 { wall_set(w, q, r, slot, FENCE_MAT, G, (G as float) * U); }
      }
    }
  }
  t2 = ticks();
  for j in 0..n {
    cl2 = 0;
    rs2 = 0;
    brush(w, (j % 9) - 4, (j % 7) - 3, if (j % 2) == 0 { 1 } else { 0 - 1 }, 7, cl2, rs2);
  }
  t3 = ticks();
  println("with a yard: {n} strokes in {(t3 - t2) / 1000 ?? 0} ms "
        + "= {((t3 - t2) / n ?? 0) / 1000 ?? 0} ms a stroke");
}
