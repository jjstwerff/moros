// WHAT WOULD IT COST TO SETTLE A ROAD ON EVERY STROKE? — plan 20 `A7`'s missing
// consumer, measured before it is wired.
//
// `slope_settle` walks the WHOLE connected run of one material and relaxes it, up
// to `SLOPE_PASSES` times. A road grows as the author walks, so settling on every
// footfall is a walk over everything laid so far — the shape that turns a linear
// gesture quadratic. This is the number that decides where the call goes.
//
// ⚠ TWO CLOCKS, AND THEY ANSWER DIFFERENT QUESTIONS. `w_tau` is the world's own
// edit clock — one bump per write that CHANGED something — so it is exact, the same
// on any box, and it says how much earth actually moved. `now()` is milliseconds and
// says what the author waits. A settle that writes nothing can still walk 4000 cells.
use hex_editor;
use hex_world;
const U = 0.25;
const G = 400;

// A road walked up a ramp of `fall` per hex, laid one stroke at a time, settling
// after each stroke if `settle` is set. Returns nothing; reports as it goes.
fn road_cost(n: integer, fall: integer, settle: boolean, tau: &integer, ms: &integer) {
  rl_grades = Grades { gr_by: [] };
  rl_c = 0;
  rl_r = 0;
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 4)..(n + 8) {
    for r in (0 - 8)..9 { ground_set(w, q, r, G - q * fall, SURFACE_MAT); }
  }
  // ⚠ THE GRADES ARE FROZEN BEFORE ANY ROAD IS LAID, which is `roadwalk`'s trap:
  // reading the ground as we walk reads the road just laid and drags the starting
  // grade along the whole run.
  hs: vector<integer> = [];
  for s in 0..n { hs += [ground_h(w, s, 0)]; }
  t0 = now();
  before = w.w_tau;
  for i in 0..n {
    h = hs[i] ?? G;
    road_lay(w, i, 0, h, ROAD_HALF, (h as float) * U, 0.0, 0.0, rl_c, rl_r, rl_grades);
    if settle {
      cl = 0;
      rs = 0;
      slope_settle(w, i, 0, cl, rs);
    }
  }
  tau = w.w_tau - before;
  ms = now() - t0;
}

// The EDITOR's own road: `road_h` is frozen ONCE when road mode is switched on and
// every stroke is laid at that same grade, so the strip is FLAT however far it runs
// and can never break its own limit. This is the case a wired settle actually meets.
fn flat_road_cost(n: integer, settle: boolean, tau: &integer, ms: &integer) {
  rl_grades = Grades { gr_by: [] };
  rl_c = 0;
  rl_r = 0;
  w = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 4)..(n + 8) {
    for r in (0 - 8)..9 { ground_set(w, q, r, G - q * 3, SURFACE_MAT); }
  }
  grade = ground_h(w, 0, 0);       // frozen once, exactly as the server does it
  t0 = now();
  before = w.w_tau;
  for i in 0..n {
    road_lay(w, i, 0, grade, ROAD_HALF, (grade as float) * U, 0.0, 0.0, rl_c, rl_r, rl_grades);
    if settle {
      cl = 0;
      rs = 0;
      slope_settle(w, i, 0, cl, rs);
    }
  }
  tau = w.w_tau - before;
  ms = now() - t0;
}

fn main() {
  rl_grades = Grades { gr_by: [] };
  rl_c = 0;
  rl_r = 0;
  println("⚠ `road_lay` NOW SETTLES ITSELF, so the `plain` column is the WIRED gesture");
  println("and `settled` is it plus a redundant second settle — the guard's promise is");
  println("that they are equal on a flat road and that neither writes anything extra.");
  println("");
  println("THE EDITOR'S OWN ROAD — one frozen grade, so the strip is flat:");
  println("  cells    tau plain   tau settled     ms plain   ms settled   ratio");
  for nf in [10, 20, 40, 80] {
    f1 = 0;
    g1 = 0;
    flat_road_cost(nf, false, f1, g1);
    f2 = 0;
    g2 = 0;
    flat_road_cost(nf, true, f2, g2);
    fr = 0.0;
    if g1 > 0 { fr = (g2 as float) / (g1 as float) ?? 0.0; }
    println("  {nf:>5}   {f1:>10}   {f2:>11}   {g1:>10}   {g2:>10}   {fr:>5.1}x");
  }
  println("");
  println("a road walked one stroke at a time, down a 3-per-hex ramp.");
  println("");
  println("  cells    tau plain   tau settled     ms plain   ms settled   ratio");
  for n in [10, 20, 40, 80] {
    t1 = 0;
    m1 = 0;
    road_cost(n, 3, false, t1, m1);
    t2 = 0;
    m2 = 0;
    road_cost(n, 3, true, t2, m2);
    rat = 0.0;
    if m1 > 0 { rat = (m2 as float) / (m1 as float) ?? 0.0; }
    println("  {n:>5}   {t1:>10}   {t2:>11}   {m1:>10}   {m2:>10}   {rat:>5.1}x");
  }
  println("");
  // ⚠ AND THE ONE THAT MATTERS FOR THE DECISION: settling ONCE at the end of the
  // run against settling on every stroke. If the two agree about the ground, the
  // per-stroke call is pure cost.
  n2 = 40;
  wa = world_new(U, 0, 8, 3).wn_world;
  wb = world_new(U, 0, 8, 3).wn_world;
  for q in (0 - 4)..(n2 + 8) {
    for r in (0 - 8)..9 {
      ground_set(wa, q, r, G - q * 3, SURFACE_MAT);
      ground_set(wb, q, r, G - q * 3, SURFACE_MAT);
    }
  }
  hs2: vector<integer> = [];
  for s2 in 0..n2 { hs2 += [ground_h(wa, s2, 0)]; }
  for i2 in 0..n2 {
    h2 = hs2[i2] ?? G;
    road_lay(wa, i2, 0, h2, ROAD_HALF, (h2 as float) * U, 0.0, 0.0, rl_c, rl_r, rl_grades);
    ca = 0;
    ra = 0;
    slope_settle(wa, i2, 0, ca, ra);
    road_lay(wb, i2, 0, h2, ROAD_HALF, (h2 as float) * U, 0.0, 0.0, rl_c, rl_r, rl_grades);
  }
  cb = 0;
  rb = 0;
  slope_settle(wb, 0, 0, cb, rb);
  diff = 0;
  worst = 0;
  for q3 in 0..n2 {
    d = ground_h(wa, q3, 0) - ground_h(wb, q3, 0);
    if d < 0 { d = 0 - d; }
    if d != 0 { diff = diff + 1; }
    if d > worst { worst = d; }
  }
  println("settling every stroke against settling once at the end:");
  println("  {diff} of {n2} cells differ, worst by {worst}");
  pa = "";
  pb = "";
  for q4 in 0..16 {
    pa += "{ground_h(wa, q4, 0) - G} ";
    pb += "{ground_h(wb, q4, 0) - G} ";
  }
  println("  every stroke : {pa}");
  println("  once at end  : {pb}");
  println("  owed, every stroke {slope_owed(wa, 0, 0)}   once at end {slope_owed(wb, 0, 0)}");
}
