// Reproduce the client's path with no wire and no browser: copy every layer into a
// second world exactly as `world_put_layer` does, then mesh the same tiles from both.
use hex_voxel;
use hex_editor;
use hex_mesh;

// ⚠ THE COPY GOES THROUGH A `&VoxelWorld` PARAMETER. Done inline on a local in `main`,
// `world_put_layer(b, …)` left `b` EMPTY — and an empty world meshes happily at
// `base + 0`, so every vertex came back with the right x and z and the wrong y. That
// is what "the base does not survive the copy" looked like, and it was the probe.
fn copy_chunk(a: VoxelWorld, b: &VoxelWorld, scx: integer, scz: integer) {
  q0 = scx * hex_voxel::CHUNK_W;
  r0 = scz * hex_voxel::CHUNK_W;
  for li in 0..len(world_column(a, q0, r0).co_ids) {
    if hex_voxel::world_layer_kind(a, q0, r0, li) == hex_voxel::KIND_TERRAIN {
      hex_voxel::world_put_layer(b, scx, scz, hex_voxel::world_chunk_base(a, scx, scz),
        hex_voxel::world_layer_id(a, q0, r0, li), hex_voxel::KIND_TERRAIN,
        hex_voxel::world_layer_version(a, q0, r0, li),
        hex_voxel::world_layer_bytes(a, q0, r0, li));
    }
  }
}

fn main() {
  a = world_new(0.25, 0, 10, 4).wn_world;
  for q in 0 - 120..121 {
    for r in 0 - 120..121 { hex_editor::ground_set(a, q, r, 40 + q - r, hex_editor::SURFACE_MAT); }
  }
  // the copy, chunk by chunk, the way the client fills its cache
  b = world_new(0.25, 0, 10, 4).wn_world;
  for scx in 0 - 3..4 { for scz in 0 - 3..4 { copy_chunk(a, b, scx, scz); } }

  agree = 0;
  bad = 0;
  first = "";
  for cx in 0 - 4..5 {
    for cz in 0 - 4..5 {
      ma = hex_mesh::chunk_mesh_mat(cx, cz, a, hex_editor::SURFACE_MAT);
      mb = hex_mesh::chunk_mesh_mat(cx, cz, b, hex_editor::SURFACE_MAT);
      if hex_mesh::mesh_crc(ma) == hex_mesh::mesh_crc(mb) { agree = agree + 1; }
      else {
        bad = bad + 1;
        if first == "" {
          first = "{cx},{cz}";
          // name the first differing vertex, which names its cell
          n = len(ma.vertices);
          if len(mb.vertices) < n { n = len(mb.vertices); }
          for i in 0..n {
            va = ma.vertices[i];
            vb = mb.vertices[i];
            if va.pos.x != vb.pos.x || va.pos.y != vb.pos.y || va.pos.z != vb.pos.z {
              println("  first differing vertex {i} of {len(ma.vertices)}/{len(mb.vertices)}: "
                    + "a=({va.pos.x},{va.pos.y},{va.pos.z}) b=({vb.pos.x},{vb.pos.y},{vb.pos.z})");
              break;
            }
          }
        }
      }
    }
  }
  println("copy-then-mesh: agree {agree} bad {bad}, first bad tile {first}");
  // ⚠ THE VERDICT IS THE PROBE'S TO STATE, not its reader's. This one read
  // `agree 3 bad 78` for a whole session while the mesher was correct — the probe
  // copied into a LOCAL instead of through a `&VoxelWorld` (loft-lang/loft#735) — so a
  // reader deciding by eye what "good" looks like is exactly the failure mode.
  if bad == 0 && agree > 0 {
    println("PROBE PASS s3_copy_mesh — a copied world meshes identically, {agree} tiles");
  } else {
    println("PROBE FAIL s3_copy_mesh — {bad} tiles differ, first at {first}");
  }
}
