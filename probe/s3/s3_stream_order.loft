// STREAMING ORDER — does an INCOMPLETE cache explain S3's surviving failures?
//
// Every other hypothesis is excluded against a green reference: the copy, the mesher,
// the coordinates, the client's struct-field mutation. The one difference left between
// the green probe and the live client is that the probe copies a FULLY AUTHORED world
// while the client meshes against whatever the server has streamed so far.
//
// So: copy a bounded set of chunks, mesh a WIDER set of tiles, and for every tile
// report both the verdict AND whether its halo lies inside the copied set. If the two
// columns agree everywhere, streaming order is the whole answer and the fix is a
// precondition rather than an arithmetic change.
use hex_world;
use hex_editor;
use hex_mesh;

fn copy_chunk(a: World, b: &World, scx: integer, scz: integer) {
  q0 = scx * hex_world::CHUNK_W;
  r0 = scz * hex_world::CHUNK_W;
  for li in 0..len(world_column(a, q0, r0).co_ids) {
    if hex_world::world_layer_kind(a, q0, r0, li) == hex_world::KIND_TERRAIN {
      hex_world::world_put_layer(b, scx, scz, hex_world::world_chunk_base(a, scx, scz),
        hex_world::world_layer_id(a, q0, r0, li), hex_world::KIND_TERRAIN,
        hex_world::world_layer_version(a, q0, r0, li),
        hex_world::world_layer_bytes(a, q0, r0, li));
    }
  }
}

// The mesher reads a TWO-cell margin for heights (`MESH_CHUNK + 4`, offset -2), so a
// tile's true footprint is its cells plus two on every side.
// ⚠ THIS PREDICATE IS NOW `hex_mesh::tile_ready`, and the probe asks the ORACLE
// rather than re-deriving the rule. A probe carrying its own copy of the thing under
// test agrees with itself and proves nothing.

fn main() {
  a = world_new(0.25, 0, 10, 4).wn_world;
  for q in 0 - 80..81 {
    for r in 0 - 80..81 { hex_editor::ground_set(a, q, r, 40 + q - r, hex_editor::SURFACE_MAT); }
  }
  // The cache holds chunks -1..1 — a bounded slice, as a client mid-stream does.
  lo = 0 - 1;
  hi = 1;
  b = world_new(0.25, 0, 10, 4).wn_world;
  for scx in lo..hi + 1 { for scz in lo..hi + 1 { copy_chunk(a, b, scx, scz); } }

  agree_in = 0; agree_out = 0; bad_in = 0; bad_out = 0;
  for cx in 0 - 5..6 {
    for cz in 0 - 5..6 {
      same = hex_mesh::mesh_crc(hex_mesh::chunk_mesh_mat(cx, cz, a, hex_editor::SURFACE_MAT))
          == hex_mesh::mesh_crc(hex_mesh::chunk_mesh_mat(cx, cz, b, hex_editor::SURFACE_MAT));
      inside = hex_mesh::tile_ready(b, cx, cz);
      if same && inside { agree_in = agree_in + 1; }
      if same && !inside { agree_out = agree_out + 1; }
      if !same && inside { bad_in = bad_in + 1; }
      if !same && !inside { bad_out = bad_out + 1; }
      if !same && inside { println("  ⚠ MISMATCH with its halo fully cached: tile ({cx},{cz})"); }
    }
  }
  println("oracle says READY  : agree {agree_in}  bad {bad_in}   <- must be bad 0");
  println("oracle says NOT YET: agree {agree_out}  bad {bad_out}");
  // ⚠ THE PROBE STATES ITS OWN VERDICT so a runner needs no knowledge of it.
  ok = bad_in == 0 && agree_in > 0 && bad_out > 0;
  if ok { println("PROBE PASS s3_stream_order — the oracle predicts the mesh exactly"); }
  else { println("PROBE FAIL s3_stream_order — ready-but-wrong {bad_in}, "
               + "and the negative control found {bad_out} (must be > 0)"); }
}
