//
// PLAN 24 `H1` — ADOPT `D`. THE TABLE IS THE LIBRARY'S, NOT OURS.
//
//   loft --interpret --lib lib/ probe/h1/h1.loft      (or `make probe-h1`)
//
// ⚠ THIS TREE HAS GUESSED THE 24 DIRECTIONS TWICE. `hex_editor::WALL_SNAP = 2*pi/24`
// with an `atan2` asks for directions that do not exist (`X31`: no odd multiple of
// 15 degrees is reachable). Then `probe/headings` enumerated *"which directions can
// a run of n edges point in"*, got a clean 24 at 3 edges, and that was not `D`
// either. **`hex_shape::hexwall` holds the real one**, and this prints it rather
// than deriving anything.
//
// ⚠ AND THE THIRD SECTION IS THE ONE THAT MATTERS. Plan 24 `L1` is written as an
// upstream gap — *"`rebuild` returns the turtle form alone, so embedded linework
// would be silently dropped"*. That is true of `rebuild`. It is not true of
// `hex_shape`, which has `wall_read_run`: a run read back OUT of an `EdgeSet`. If
// the round trip below closes, `L1` is a call, not a library change.
use hex_field;
use hex_grid;
use hex_form;
use hex_shape;

const Q0 = 0 - 20;
const R0 = 0 - 20;
const WQ = 41;
const HQ = 41;

fn fabsf(v: float) -> float { if v < 0.0 { 0.0 - v } else { v } }

fn main() {
  println("H1 — plan 24: the 24 linework directions, as the library defines them");
  println("");

  // ── §1  `D`, PRINTED FROM THE LIBRARY ─────────────────────────────────────
  println("── §1  `hex_shape::D24` = {D24}, and what each direction actually is ──");
  println("   d24  step(dk,dm)  exact?  nominal    actual     bias");
  n_exact = 0;
  worst_bias = 0.0;
  spread_lo = 999.0;
  spread_hi = 0.0;
  for d in 0..D24 {
    sk = wall_step_k(d);
    sm = wall_step_m(d);
    ex = wall_is_exact(d);
    nom = wall_angle_nominal(d);
    act = wall_angle_actual(d);
    bias = fabsf(act - nom);
    if bias > 180.0 { bias = 360.0 - bias; }
    if ex { n_exact = n_exact + 1; }
    else {
      if bias > spread_hi { spread_hi = bias; }
      if bias < spread_lo { spread_lo = bias; }
    }
    if bias > worst_bias { worst_bias = bias; }
    println("   {d:>3}  ({sk:>3},{sm:>3})     {ex}   {nom:>7}  {act:>9}  {bias}");
  }
  println("");
  println("   {n_exact} of {D24} exact · in-between bias from {spread_lo} to {spread_hi}");
  if n_exact == 12 && spread_hi - spread_lo < 0.000001 {
    println("   ✅ 12 exact and 12 at a UNIFORM bias — `X29`'s claim, measured here");
  } else {
    println("   ⛔ that is not `X29`'s shape (12 exact, 12 uniformly biased)");
  }

  // ── §2  THE PARALLEL RUN — what OUR snap stores against what `D` stores ───
  //
  // ⚠ THE COMPARISON IS ON THE STORED ANSWER, not on the angle. Plan 24 asks to
  // *"keep the 2*pi/24 answer beside `D`'s and compare what each STORES"* — a
  // heading index is what a run records, so an index that differs is a wall that
  // would be laid somewhere else.
  println("");
  println("── §2  our `snap_heading` (2*pi/24) against the library's `D` ───────");
  println("   ⚠ ours quantises an ANGLE onto a grid that has no lattice behind it;");
  println("     the library's asks which admissible direction a run actually takes.");
  // ⚠ THE ANCHOR IS A HEX CORNER, NOT THE ORIGIN. `(0,0)` is a hex CENTRE —
  // `tri_class` 0 — and `wall_min_p`/`snap_run_d24` refuse a non-vertex start with
  // `-1`. The first run of this probe passed `(0,0)` and got `-1` on all 24, which
  // is the library declining input it does not accept, exactly as it should.
  va = hex_corner_tri_a(0, 0, 0);
  vb = hex_corner_tri_b(0, 0, 0);
  println("   anchor: hex (0,0) corner 0 → triangle ({va},{vb}) · vertex? "
          + "{tri_is_vertex(va, vb)}");
  agree = 0;
  tried = 0;
  for t in 0..24 {
    ang = (t as float) * 15.0 / 57.29577951308232;
    // ⚠ A TARGET POINT, NOT A DIRECTION — `snap_run_d24` computes
    // `target - tri_xy(a0,b0)` itself. Handing it a unit vector aimed the answers
    // ~300 degrees away, because the anchor is not at the world origin. Read the
    // function, do not infer it from the parameter names: that is the third time
    // in this plan that a library was fed something it did not mean.
    tx = tri_x(va, vb) + 6.0 * cos(ang);
    ty = tri_y(va, vb) + 6.0 * sin(ang);
    // The library's answer, from a triangle-lattice vertex at the origin.
    dl = snap_run_d24(va, vb, tx, ty);
    // What our own snap would record for the same direction.
    st = 0;
    res = 0.0;
    hex_editor_snap(tx, ty, st, res);
    tried = tried + 1;
    if dl == st { agree = agree + 1; }
    if t < 8 || dl != st {
      mark = "  ";
      if dl != st { mark = "≠ "; }
      println("   {mark}{t:>2}: nominal {t * 15}deg · ours {st:>2} · library {dl:>2} "
              + "(actual {wall_angle_actual(dl)}deg)");
    }
  }
  println("   {agree} of {tried} agree");

  // ── §3  THE ROUND TRIP — is `L1` a call rather than a library change? ─────
  //
  // Write a run into an `EdgeSet` with the library's own `wall_write`, then read
  // it back with `wall_read_run`. ⚠ COMPARE THE ENDPOINTS, NOT `d`: the library
  // says so itself — *"A-to-B and B-to-A mark the identical edges … `read.d == d`
  // is the wrong round-trip assertion"*. That is `A0p`'s `P3` (an axis, not a
  // direction) stated by the thing that owns it.
  println("");
  println("── §3  write a run, read it back — this is `L1`'s question ──────────");
  rt_ok = 0;
  rt_all = 0;
  rt_fail = "";
  ta0 = hex_corner_tri_a(0, 0, 0);
  tb0 = hex_corner_tri_b(0, 0, 0);
  for d3 in 0..24 {
    p = wall_min_p(d3, ta0, tb0);
    if p <= 0 { continue; }
    ea = wall_end_a(d3, ta0, p);
    eb = wall_end_b(d3, tb0, p);
    edges = edgeset_new(Q0, R0, WQ, HQ);
    w = wall_from_run(d3, ta0, tb0, p, 1);
    marked = wall_write(w, edges, Q0, R0, WQ, HQ);
    (rd, ra, rb, rp, ok) = wall_read_run(edges, Q0, R0, WQ, HQ);
    rt_all = rt_all + 1;
    if ok {
      // the recovered run's own two ends, whichever way round it came back
      ga = wall_end_a(rd, ra, rp);
      gb = wall_end_b(rd, rb, rp);
      same = (ra == ta0 && rb == tb0 && ga == ea && gb == eb)
          || (ga == ta0 && gb == tb0 && ra == ea && rb == eb);
      if same { rt_ok = rt_ok + 1; }
      else { rt_fail += " d{d3}(({ra},{rb})-({ga},{gb}) vs ({ta0},{tb0})-({ea},{eb}))"; }
    } else {
      rt_fail += " d{d3}(read refused, {marked} edges marked)";
    }
    if d3 < 4 {
      println("   d24 {d3}: p={p} · {marked} edges · read d={rd} p={rp} "
              + "from ({ra},{rb}) · ok={ok}");
    }
  }
  println("");
  if rt_ok == rt_all && rt_all > 0 {
    println("   ✅ {rt_ok} of {rt_all} runs round-tripped through the FIELD —");
    println("      `L1` is a CALL, not a library change");
  } else {
    println("   ⛔ {rt_ok} of {rt_all} round-tripped.{rt_fail}");
  }
}

// Our own snap, inlined here rather than imported, so this probe does not drag
// `hex_editor` into a comparison that is about `hex_shape`. ⚠ It is `WALL_SNAP`'s
// arithmetic verbatim — the thing `H1` deletes.
fn hex_editor_snap(dx: float, dz: float, step: &integer, residual: &float) -> float {
  wall_snap = 0.26179938779914946;
  a = atan2(dz, dx);
  k = a / wall_snap ?? 0.0;
  ki = 0;
  if k >= 0.0 { ki = (k + 0.5) as integer; } else { ki = (k - 0.5) as integer; }
  snapped = (ki as float) * wall_snap;
  d = a - snapped;
  if d < 0.0 { d = 0.0 - d; }
  residual = d * 180.0 / 3.141592653589793 ?? 0.0;
  step = ((ki % 24 ?? 0) + 24) % 24 ?? 0;
  snapped
}
