# EARLY vs LATE at the SAME station — is the missing leaf a timing miss?
#
# `limbwhere.mjs` proves the leaf reaches the wire as id 8, colour 0.55,0.62,0.24,
# 36 vertices at x -0.03..1.99 — emitted, green, and in the doorway. If it is not
# in the picture, either the client never draws it or the picture was taken before
# it arrived. The same station twice, seconds apart, separates those.
send 44:
at 0 0 0
key ArrowUp
wait rebuilt

send 44:door/hung
wait part 'door/hung' opened
send 40:0
wait mode

echo --- EARLY: the station A8.3 shoots first, at A8.3's own timing
at 0.0 -5.5 70
snap probe2-s-early

echo --- two more stations, which is time passing
at -4.9 -1.3 15
snap probe2-w
at -3.0 -4.0 40
snap probe2-sw

echo --- LATE: the SAME station as the first
at 0.0 -5.5 70
snap probe2-s-late
send 44:
