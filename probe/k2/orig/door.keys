# S8 — DOES IT READ AS A DOOR?
#
# `F-READ`, and it is the only test this step has: a leaf flush in its opening is a
# panel over a hole, and a person calls it a patch. At 35 degrees it casts a line,
# and the line is what says "door" before anything else does.

echo --- flat ground
at 0 0 0
key ArrowUp
wait rebuilt

echo --- one wall to hang a door in
at -6 0 0
key R
at 6 0 0
key R

echo --- a door, hung ajar
at 0 -0.9 90
key O

echo --- and a window beside it, for the contrast
at 3 -0.9 90
key P

echo --- stand where a person would: in front of the door, looking at it
at 0 -7 90
snap s8-door
