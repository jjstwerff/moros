target
.idea
.claude/
data/pages.zip
node_modules
package-lock.json
coverage

# Auto-archived prior versions of generated card art (kept locally
# by tools/generate_card_art.py archive_existing()).
html/icons/**/*_v[0-9][0-9].png
images/*_v[0-9][0-9].png

# Python bytecode caches from tooling.
tools/__pycache__/
__pycache__/


# loft build artifacts inside the lib/ packages: `native-auto/` holds the
# auto-compiled native cdylib (14 MB and machine-specific), `.loft/` the
# resolver cache.  The committed `.loft/api/*.api` stubs are the exception —
# they are the readable public surface of a locked dependency.
lib/**/native-auto/
lib/**/.loft/
!lib/**/.loft/api/

# Probe OUTPUTS. A probe commits its sources and its README -- the finding --
# and never its pictures: every PNG under probe/ is regenerated by that probe's
# own run.sh, and a committed one is a stale claim that no longer measures
# anything. probe/b1's white control is BUILT by run.sh for the same reason.
probe/**/.loft/
probe/**/*.png
# …and the same for a probe's scratch: logs, transcripts and captured server
# output are what its run.sh produces on the spot, and a committed one is a claim
# about a run nobody made. `probe/k1/out/` is the first.
probe/**/out/

# `loft update` writes the same stubs at the ROOT, for the script-level
# loft.lock that `src/` runs against. Its resolver cache is noise; the api/
# stubs are committed for the same reason as the ones above.
/.loft/cache/

# The same artefacts beside the PROGRAMS in src/ — the rule above only covered
# lib/. `src/.loft/editor_client.html` is `make client`'s output: a ~950 KB page
# that is rebuilt from source and changed on every single build, so committing it
# put a megabyte of generated bytes into history per edit. It was tracked by
# accident, and the server serves it FROM DISK — nothing needs it in git.
src/.loft/

# The moros_render CLI examples write their .glb cwd-relative by design.
*.glb
# ⚠ EXCEPT THE PART LIBRARY'S OWN MESHES, and the exception is plan 17 `A6.2`.
# `data/parts/` is content rather than a scratch directory: a committed `.hxw` may
# NAME a mesh (§P5's second body), and a part naming a file no clone has is a part
# that cannot draw. ⚠ The rule above nearly took `A6.1`'s test fixture silently —
# `git status` showed nothing, it passed locally and would have been missing on
# every other checkout — so run `git check-ignore -v <path>` before adding any
# binary here. `src/prop_build.loft` regenerates these byte-identically, which is
# what makes committing them sane; `make parts` asserts it.
!data/parts/**/*.glb

# runtime log from `make editor`
.editor.log

# the pid `make play-fast` / `make editor-bg` write so `make stop-editor` can find
# the server again. Runtime state, and it names a pid that means nothing in
# another checkout.
.editor.pid

# test artefacts — loft tests run with cwd inside the package, so a file-writing
# test drops its scratch here. Never tracked: a colliding name would let a test
# DELETE a real file (loft recorded exactly that happening across repos).
lib/*/tests/*.bin
lib/*/probe/*.bin
shots/
recordings/
probe/*.png

# Per-gate server logs from the parallel gate runner — one per gate, overwritten
# every run, kept only so a failure can be read after the fact.
.gate-*.log

# Raw `loft test` output, kept before the warning filter so a crash reporter's
# diagnostic survives the pipeline that would otherwise eat it (loft#717).
.test-logs/

# Per-gate stderr from the parallel runner, beside its .log twin.
.gate-*.err

# The pids of every server the gate runner started this run. ⚠ NOT `.gate-*.log`'s
# sibling by accident — it deliberately SURVIVES a crashed run, because the next run
# reads it to reclaim the servers that run leaked. Machine state, never committed.
.gate-pids

# The two transcripts `make headless-same` compares.
.headless.txt
.served.txt

# loft build artefacts beside a probe
**/.loft/

# `probe/p6` drives headless chromium and needs a FRESH profile per run, because
# `localStorage` is the thing it measures. The profile is repo-local rather than
# under `/tmp` — the chromium here is a snap and has its own private `/tmp`, where
# a `--user-data-dir` leaves the browser with no devtools port at all.
probe/**/.chrome-*
# P6's world, written beside `store.loft` because loft resolves a relative path
# against the program's SOURCE directory rather than the process's cwd.
probe/p6/*.hxw

# `probe/b1a` captures a transcript per run and builds throwaway clients beside
# itself — the PRE-CHANGE source it compares against, and the sabotages. What is
# committed is `baseline.said` / `baseline.md5`, which are the comparison.
probe/b1a/.out/
probe/b1a/.baseline.loft
probe/b1a/.sab-*.loft

# The gate suite copies the compiled server here — a loft binary roots its file I/O
# at its own directory's parent, so it has to sit one level under the repository or
# every snapshot and save lands in src/.loft/. Rebuilt every run; never committed.
.gatebin/
