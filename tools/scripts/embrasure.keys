# A CASTLE'S WINDOW SEAT — and the datum is the only reason it can be built.
#
# A deep niche cut from the wall's front face, and a window cut from the NICHE's
# BACK. Two openings, two datums, one hole for light; neither of them goes through
# the wall on its own.
#
# ⚠ THREE VIEWS, because no one of them can tell you it worked:
#   the seat side   — a recess with a small bright window at the back of it
#   the outside     — one small window, and no sign of the niche at all
#   both together   — which is what says the two voids MEET rather than overlap
#                     or leave a pane of stone between them.

echo --- flat ground
at 0 0 0
key ArrowUp
wait rebuilt

echo --- one straight run
at -8 0 0
key R
at 8 0 0
key R

echo --- a plain doorway to compare against, then the window seat
at -4 -0.9 90
key O
at 2 -0.9 90
key N
at 2 -0.9 90
key M

# ⚠ THE SEAT SIDE IS +z. A wall run's front face is the side its normal points at,
# which is not the side the author stood on to cut the niche — worth stating,
# because the first version of this script named the two views the wrong way round
# and the picture still looked plausible from both.
echo --- the seat side: a recess, with daylight at the back of it
at 2 9 270
snap s5-embrasure-in

echo --- the outside: one small window, and no sign of the niche
at 2 -9 90
snap s5-embrasure-out
