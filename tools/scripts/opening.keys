# S5 — A WALL WITH A HOLE YOU CAN SEE THROUGH.
#
# One straight wall, then a door cut where the author stands against it. The plan
# view proves the edge is still there (the band is unbroken in plan); the ELEVATION
# is where the hole shows, because a door is a sub-interval of the wall's height.

echo --- flat ground
at 0 0 0
key ArrowUp
wait rebuilt

echo --- one wall, west to east
at -6 0 0
verb run
at 6 0 0
verb run
wait wall

echo --- stand against it and cut a door
at 0 -0.9 90
select 1
verb opening

echo --- and a window, two hexes along
at 3 -0.9 90
select 2
verb opening

echo --- look along the wall
at -4 -7 60
snap s5-opening
