# THE CLOCK MUST NOT CHANGE THE RESULT.
#
# The same edits, the same number of ticks, and a saved world at the end. Run this
# at rate 1 and at rate 0 and the two world files must be byte-identical: that is
# what "reproducible even with clocks that change speed" means, and it is the
# property every golden image rests on.

echo --- shape the ground
at 0 0 0
key ArrowUp
step 20
at 3.46 0 0
key ArrowUp
step 20

echo --- cut a stair, which exercises the walk's surface rule
at 0 0 0
key E
step 10
at 1.73 0 0
key E
step 10

# ⚠ THE WALK IS WHAT MAKES THIS TEST DISCRIMINATE. Every edit above is
# instantaneous, so `dt` never touches them and the comparison would pass even with
# a clock-dependent integrator. Motion is the only thing a variable step changes,
# so the walk has to be in the script or the whole check is vacuous.
echo --- walk for an exact number of ticks
at 0 0 0
keys 1
step 90
keys 0
step 5

echo --- a wall run
at -3 -3 0
verb run
at 3 -3 0
verb run
step 40

save clockcheck
