# THE PROFILE FAMILY, IN ONE WALL.
#
# Four holes in one straight run, so the shapes are compared side by side rather
# than one at a time: a round head, a pointed arch, a segmental head and an oculus.
# The elevation is where they are judged — that is the view an arch is drawn in.

echo --- flat ground
at 0 0 0
verb raise
wait rebuilt

echo --- one long wall to cut them into
at -12 0 0
verb run
at 12 0 0
verb run

echo --- round, pointed, segmental, oculus
at -7 -0.9 90
select 1
verb opening
at -2 -0.9 90
select 2
verb opening
at 3 -0.9 90
select 3
verb opening
at 8 -0.9 90
select 4
verb opening

echo --- look along the elevation
at 0 -14 90
snap s5-profiles
