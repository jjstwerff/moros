// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Plan 17 `A6.2` — A PROP PART IN THE SAME LIBRARY, IN THE SAME SOCKETS.
//
// `part_build.loft` puts a house in `data/parts/`. This puts a **statue on a
// plinth** in the same place, by the same machinery, and the whole point of the
// step is that there is no second machinery: the statue is a `PART` with a `FITS`,
// the plinth is a `PART` with a `SOCK`, and `part_expand` composes them exactly as
// it composes a door-frame into a house.
//
//     make parts
//
// ⚠ IT WRITES A `.glb` RATHER THAN COMMITTING ONE, which is this tree's rule about
// images applied to geometry (`CATALOGUE.md`: every image is *rendered*, never
// loaded). A committed binary is a thing nobody can diff, nobody can regenerate,
// and — here specifically — a thing `.gitignore:47` was silently swallowing.
// ⚠ The `.glb` IS committed, under an explicit `!data/parts/**/*.glb` negation: a
// part that names a mesh no clone has is a part that cannot draw. What makes that
// safe is that this program rebuilds it byte-identically, which is asserted below.
//
// ⚠ AND IT VERIFIES BY EXPANDING, not by re-reading. Saving three files proves
// nothing about whether a statue ends up on the plinth — so the gate at the bottom
// runs the same `part_expand` a renderer will, into a seeded world, and reads the
// placement's height and heading back out of it.
//
// ── `A6.3` — AND THE SECOND STATUE, WHICH IS THE SWAP ────────────────────────
//
// *A different statue on the same plinth, no other change.* The library gains a
// seated figure that declares the same `FITS`, and the gate expands the shrine
// twice — once bound to each — asserting that the placement differs in `ma_mesh`
// and in nothing else, and that `part_diff` finds no cell moved anywhere.
//
// ⚠ THE VARIANT IS EXPANDED FIRST AND THE COMMITTED STATE IS WRITTEN LAST, before
// a single comparison is asserted. `data/parts/` is committed and this tree is
// worked by more than one agent, so an assertion that fires must not leave the
// shrine holding the variant.
use hex_world;
use hex_part;
use hex_editor;   // the MATERIAL names — see below, a literal 3 is a GREEN plinth
use glb;
use glb_read;   // load_glb — to read back what was WRITTEN, not what was in memory
use mesh3d;

// The editor's own world constants — `part_build.loft`'s note applies here too: a
// part cut or built at a different epsilon is a different shape wearing the same
// numbers.
const W_EPS   = 8;
const W_THETA = 3;
const W_UNIT  = 0.25;

// How tall the plinth stands, in the height units a `Hex` carries.
const PLINTH_H = 6;

// ⚠ THE SOCKET LOOKS AT 18, AND 18 IS NOT ONE OF THE SIX. A cell part could never
// be put in a socket aimed here — `A4.4` measured that only the six multiples of
// 60° map the lattice onto itself, and 18 is 270° — so this number is what makes
// the file a demonstration rather than a decoration. A prop can take it because a
// mesh is not on the lattice; the statue's own `ANCH` facing is subtracted from
// it, which is what `part_expand` asserts below.
const LOOK = 18;

fn out_root() -> text {
  po = env_variable("PROP_OUT");
  if po != "" { return po; }
  "{source_dir()}/../data/parts"
}

// ── The statue, modelled rather than imported ────────────────────────────────
//
// ⚠ IT IS ASYMMETRIC ON PURPOSE, and that is STATE.md lesson 9 rather than art
// direction: *a symmetric test subject cannot detect a symmetric bug*. A figure
// that is the same from every side photographs identically at every one of the 24
// headings, so a renderer that ignored `ma_facing` entirely would look correct.
// The raised arm along +X is what makes *which way is it facing* a thing a person
// can see in a picture.
//
// ⚠ AND THE CONVENTION IS WRITTEN INTO THE PART, NOT ASSUMED OF THE FILE. `+Y` is
// up (glTF's own) and the figure faces `+X`, which is heading 0 — so `ANCH`'s
// facing is 0, and it is *recorded* rather than left to whoever opens the file to
// infer. That is the whole argument for `part_anchor` having a consumer at all:
// re-model this statue facing sideways, say so in `ANCH`, and every socket in the
// library still points its nose the right way.

fn quad(m: Mesh, a: Vec3, b: Vec3, c: Vec3, d: Vec3, n: Vec3) {
  i = len(m.vertices);
  m.vertices += [vertex(a, n, vec2(0.0, 0.0))];
  m.vertices += [vertex(b, n, vec2(1.0, 0.0))];
  m.vertices += [vertex(c, n, vec2(1.0, 1.0))];
  m.vertices += [vertex(d, n, vec2(0.0, 1.0))];
  m.triangles += [Triangle { a: i, b: i + 1, c: i + 2 }];
  m.triangles += [Triangle { a: i, b: i + 2, c: i + 3 }];
}

// A box with six flat faces. ⚠ FOUR VERTICES PER FACE RATHER THAN EIGHT SHARED,
// because a shared corner can carry only one normal and a cube lit from one normal
// per corner is a rounded blob — `glb_read` follows the NORMAL accessor, so a wrong
// normal here would survive every round trip and only show up in a picture.
fn box(m: Mesh, x0: float, y0: float, z0: float, x1: float, y1: float, z1: float) {
  quad(m, vec3(x0, y0, z1), vec3(x1, y0, z1), vec3(x1, y1, z1), vec3(x0, y1, z1),
       vec3(0.0, 0.0, 1.0));
  quad(m, vec3(x1, y0, z0), vec3(x0, y0, z0), vec3(x0, y1, z0), vec3(x1, y1, z0),
       vec3(0.0, 0.0, 0.0 - 1.0));
  quad(m, vec3(x1, y0, z1), vec3(x1, y0, z0), vec3(x1, y1, z0), vec3(x1, y1, z1),
       vec3(1.0, 0.0, 0.0));
  quad(m, vec3(x0, y0, z0), vec3(x0, y0, z1), vec3(x0, y1, z1), vec3(x0, y1, z0),
       vec3(0.0 - 1.0, 0.0, 0.0));
  quad(m, vec3(x0, y1, z1), vec3(x1, y1, z1), vec3(x1, y1, z0), vec3(x0, y1, z0),
       vec3(0.0, 1.0, 0.0));
  quad(m, vec3(x0, y0, z0), vec3(x1, y0, z0), vec3(x1, y0, z1), vec3(x0, y0, z1),
       vec3(0.0, 0.0 - 1.0, 0.0));
}

fn statue_mesh() -> Mesh {
  m = mesh("statue");
  box(m, 0.0 - 0.22, 0.00, 0.0 - 0.18, 0.22, 1.05, 0.18);   // body
  box(m, 0.0 - 0.13, 1.05, 0.0 - 0.13, 0.13, 1.36, 0.13);   // head
  box(m, 0.18, 0.72, 0.0 - 0.07, 0.62, 0.86, 0.07);          // the arm, along +X
  m
}

// The OTHER statue — plan 17 `A6.3`, and it is a different figure rather than a
// recolour. ⚠ A SWAP HAS TO BE VISIBLE IN THE SILHOUETTE, because both statues are
// drawn in one surface (`prop_surface`): two figures that differ only in colour are
// the same thumbnail to a picture and the same bucket to every chromaticity gate,
// so *the swap took* would be a claim only a string comparison could make.
//
// ⚠ AND IT MUST DIFFER IN **PROPORTION**, NOT IN SIZE. The first seated figure was
// simply a shorter standing one — 1.14 tall against 1.36 — and its catalogue
// thumbnail was near enough the standing one's to be the same picture. The reason is
// in `part_thumb_view`: it solves the camera to fill the frame **per part**, so a
// cottage and a doorknob are both legible and *how big is it* is exactly the thing a
// thumbnail cannot say. Only shape survives that fit. So this one is squat — knees
// well forward, low back — and the two aspects differ by 1.7×, which `main` asserts.
//
// ⚠ AND THE INSTRUMENT THAT SETTLED IT WAS THE PICTURE, NOT THE COUNT. Ink pixels
// per row read 218 against 221 before the reshape and 196 against 213 after — a
// count over a fixed row window saturates on the window, so it barely moved while
// the two silhouettes went from indistinguishable to obviously different. STATE.md
// lesson G, and the durable gate is the one below on the MESH: a proportion is a
// fact about the content and survives whatever the renderer does to frame it.
fn seated_mesh() -> Mesh {
  m = mesh("seated");
  box(m, 0.0 - 0.28, 0.00, 0.0 - 0.26, 0.70, 0.30, 0.26);   // lap and knees, along +X
  box(m, 0.0 - 0.28, 0.30, 0.0 - 0.20, 0.10, 0.66, 0.20);   // torso, sat back
  box(m, 0.0 - 0.24, 0.66, 0.0 - 0.13, 0.0 - 0.02, 0.90, 0.13);   // head
  m
}

// How tall a mesh stands, read off its vertices. ⚠ The one number that separates
// two figures a file size cannot — see the control in `main`.
fn top_y(m: Mesh) -> float {
  ty = 0.0;
  for v in m.vertices { if v.pos.y > ty { ty = v.pos.y; } }
  ty
}

// How wide it is against how tall — the ONE measure of a figure that a thumbnail
// camera cannot normalise away, because it fits each part to the frame.
fn aspect(m: Mesh) -> float {
  lo = 0.0;
  hi = 0.0;
  for v in m.vertices {
    if v.pos.x < lo { lo = v.pos.x; }
    if v.pos.x > hi { hi = v.pos.x; }
  }
  t = top_y(m);
  if t <= 0.0 { return 0.0; }
  (hi - lo) / t ?? 0.0
}

// ── The parts ────────────────────────────────────────────────────────────────

// ⚠ ONE WRITER FOR BOTH STATUES, and that is `A6.3` in one line: the two differ in
// a name, a mesh and a description, and in nothing a socket can see. A second
// writer would be a second place for them to drift apart — and *they fit the same
// plinth* would then be a coincidence of two functions rather than a fact.
fn write_statue(root: text, name: text, desc: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  // ⚠ NO CELLS AT ALL, which is exactly the shape `part_expand` could not carry
  // before `A6.2`: `part_stamp` answers `PS_EMPTY` for a world with no columns and
  // every stamp failure used to be `EX_FIT`. A statue you cannot walk into is the
  // ordinary case for a prop, and §P5's *both bodies* pillar is the other one.
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_PROP, pm_name: name, pm_desc: desc
  }) == PM_OK, "{name}'s meta was refused");
  assert(part_set_mesh(w, "prop/{name}").pw_code == PR_OK, "{name}'s mesh was refused");
  assert(part_set_fits(w, PartFits { pf_kind: "statue", pf_size: "plinth-2" }).sw_code == SK_OK,
         "{name}'s fit was refused");
  assert(part_set_anchor(w, PartAnchor {
    pa_q: 0, pa_r: 0, pa_h: 0, pa_facing: 0
  }) == PM_OK, "{name}'s anchor was refused");
  assert(world_save(w, "{root}/prop/{name}.hxw", []) == WS_OK, "{name} was not saved");
}

fn write_shrine(root: text, holds: text) { write_shrine_named(root, "shrine", holds); }

// ── A STATUE WITH NO MESH IN IT — plan 17 `A8.5`, §P9.3 ─────────────────────
//
// ⚠ NOT A CONVERSION. `prop/statue` and `prop/seated` stay exactly as they are:
// §P9.3's rule is *nothing NEEDS a custom mesh*, never *nothing may be one*. What
// this proves is that the socket does not care — a body of cells and a body of
// `.glb` go in the same plinth, and the shrine that holds one holds the other with
// one field changed.
//
// ⚠ IT IS AUTHORED AT A QUARTER OF THE UNIT, and that is `A8.2b` earning its keep
// rather than a flourish. A cell is a hex wide, so a statue built at the world's
// own unit is 1.73 world units across — a boulder, not a figure. At `W_UNIT / 4`
// the placement derives a scale of 0.25 from the two files and the same cells draw
// 0.43 across, which is the mesh statue's shoulders.
//
// ⚠ AND IT IS A BLOCKOUT, WHICH IS THE POINT AND NOT AN APOLOGY (§P9.7): *a red
// blob at the right size beats a good mesh at the wrong one*. A stack of plates
// with a wider course for the arms is what cells can say; what matters is that it
// is the right SIZE, in the right socket, swappable for art that has not been made
// yet.
//
// ⚠ AND THE SILHOUETTE HAS TO DIFFER FROM THE MESH ONE, which is `A6.3`'s rule for
// the two statues restated: a swap nobody can see is a swap no picture can check.
// A cross — column, arms, head — against the mesh figure's box and single arm.
fn write_cell_statue(root: text) {
  w = world_new(W_UNIT / 4.0 ?? W_UNIT, 0, W_EPS, W_THETA).wn_world;
  // The column: two courses `W_EPS` apart, which is the closest this world's own
  // minimum layer separation allows.
  for ci in 0..2 {
    assert(world_set_cell(w, 0, 0, ci,
      Hex { h_height: (1 + ci * W_EPS) as u16? ?? 0,
            h_material: hex_editor::FLOOR_MAT as u8? ?? 0 }).cw_code == CW_OK,
      "the carved statue's column cell {ci} was refused");
  }
  // The arms: one course, three hexes wide, at shoulder height.
  for aq in (0 - 1)..2 {
    assert(world_set_cell(w, aq, 0, if aq == 0 { 2 } else { 0 },
      Hex { h_height: (1 + 2 * W_EPS) as u16? ?? 0,
            h_material: hex_editor::FLOOR_MAT as u8? ?? 0 }).cw_code == CW_OK,
      "the carved statue's arm at {aq} was refused");
  }
  // And the head, one course above the shoulders.
  assert(world_set_cell(w, 0, 0, 3,
    Hex { h_height: (1 + 3 * W_EPS) as u16? ?? 0,
          h_material: hex_editor::FLOOR_MAT as u8? ?? 0 }).cw_code == CW_OK,
    "the carved statue's head was refused");
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_PROP, pm_name: "carved",
    pm_desc: "a statue built from cells — the same plinth, and no mesh anywhere"
  }) == PM_OK, "the carved statue's meta was refused");
  // ⚠ THE SAME `FITS`, BYTE FOR BYTE, AS THE MESH STATUES. That is the whole claim:
  // the socket is a contract about a CLASS, and a body is not part of it.
  assert(part_set_fits(w, PartFits { pf_kind: "statue", pf_size: "plinth-2" }).sw_code == SK_OK,
         "the carved statue's fit was refused");
  assert(part_set_anchor(w, PartAnchor {
    pa_q: 0, pa_r: 0, pa_h: 0, pa_facing: 0
  }) == PM_OK, "the carved statue's anchor was refused");
  assert(world_save(w, "{root}/prop/carved.hxw", []) == WS_OK,
         "the carved statue was not saved");
}

fn write_plinth(root: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  // A single built column. ⚠ ITS TOP AND THE SOCKET'S HEIGHT ARE ONE NUMBER — a
  // socket that said 5 while the stone reached 6 would stand the statue inside the
  // plinth and nothing in the format would object.
  //
  // ⚠ THE MATERIAL IS A NAME BECAUSE A LITERAL WAS WRONG AND LOOKED FINE. This was
  // `3`, chosen as *"some stone-ish index"*; `3` is `FIELD_MAT`, so the catalogue
  // listed a bright green plinth and every number in every gate agreed with it.
  // ⚠ And a cell has no *stone*: `wall` is an EDGE material, so the five a cell can
  // take are grass, road, field, floor and roof. `FLOOR_MAT` — a built surface — is
  // the honest one for masonry, and it is what the house's own floor uses.
  for h in 1..(PLINTH_H + 1) {
    assert(world_set_column(w, Column { co_q: 0, co_r: 0,
      co_cells: [Hex { h_height: h as u16? ?? 0,
                       h_material: hex_editor::FLOOR_MAT as u8? ?? 0 }] }).cw_code == CW_OK,
      "the plinth's column was refused");
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_PROP, pm_name: "plinth",
    pm_desc: "a stone column with a statue socket on top, looking at heading {LOOK}"
  }) == PM_OK, "the plinth's meta was refused");
  assert(part_set_sockets(w, [Socket {
    sk_q: 0, sk_r: 0, sk_h: PLINTH_H, sk_mount: SM_HEAD, sk_at: LOOK,
    sk_kind: "statue", sk_size: "plinth-2", sk_name: "top"
  }]).sw_code == SK_OK, "the plinth's socket was refused");
  assert(world_save(w, "{root}/prop/plinth.hxw", []) == WS_OK, "the plinth was not saved");
}

// The composition: a plinth standing at an offset, with the statue bound into it.
//
// ⚠ THE SHRINE STORES NO COORDINATE FOR THE STATUE, and that absence is §P3's
// whole mechanism (`bind.loft`). Move the plinth and the statue follows, because
// there is no second position that could be forgotten.
fn write_shrine_named(root: text, name: text, holds: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  // A paved base. ⚠ NOT DECORATION — a part with no cells of its own has no
  // thumbnail, because the editor meshes a part's own chunks and does not expand
  // what it holds. A shrine that is *a plinth and nothing else* lists in the
  // catalogue as a blank row, which is a picture of nothing. It also reads better:
  // three levels — paving, plinth, figure — is what makes it a shrine rather than a
  // column standing in a field. ⚠ The composition-ONLY shape is not lost; it is
  // `hex_part`'s `test_a_part_whose_only_body_is_what_it_holds_expands`, which is
  // where a shape with no picture belongs.
  for pq in 0..3 {
    for pr in 0..3 {
      if pq == 2 && pr == 1 { continue; }        // the plinth's own column
      // Paving, and a DIFFERENT material from the plinth on purpose: two bodies in
      // one flat colour photograph as one body, which is `A3.2`'s fixture rule
      // (*the material is the marker*) applied to a picture rather than to a count.
      assert(world_set_column(w, Column { co_q: pq, co_r: pr,
        co_cells: [Hex { h_height: 0 as u16? ?? 0,
                         h_material: hex_editor::ROAD_MAT as u8? ?? 0 }] }).cw_code == CW_OK,
        "the shrine's paving at ({pq},{pr}) was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_HOUSE, pm_name: "shrine",
    pm_desc: "a plinth with a statue on it — plan 17 A6.2's demonstration"
  }) == PM_OK, "the shrine's meta was refused");
  // ⚠ (2,1) IS AN ODD ROW ON PURPOSE. On an even row the doubled-lattice
  // composition agrees with a naive `(cq+dq, cr+dr)`, so a shrine at (0,0) would
  // verify against arithmetic that is wrong everywhere else — five bugs in this
  // codebase have been exactly that (STATE.md lesson E).
  assert(part_set_instances(w, [PartInst {
    pi_q: 2, pi_r: 1, pi_h: 0, pi_facing: 0, pi_part: "prop/plinth"
  }]) == PI_OK, "the shrine's instance was refused");
  // ⚠ THE ONLY FIELD `A6.3` TOUCHES. Everything else about this document — the
  // paving, the instance, the socket name — is written identically whichever statue
  // it holds, which is what makes *no other change* a thing this file can assert
  // rather than a thing it hopes.
  assert(part_set_bindings(w, [Binding {
    bd_inst: 0, bd_open: 0.0, bd_socket: "top", bd_part: holds
  }]).bw_code == BD_OK, "the shrine's binding was refused");
  assert(world_save(w, "{root}/prop/{name}.hxw", []) == WS_OK, "the shrine was not saved");
}

// ── The gate ─────────────────────────────────────────────────────────────────

// A patch of ground to stand the shrine on. ⚠ A part stamped into a chunk with no
// terrain becomes that chunk's GROUND layer and takes `LABEL_GROUND` instead of the
// label it minted, so this is a placement rule rather than fixture decoration.
// ⚠ AND THE SHRINE STANDS **ON** IT, at `GROUND`, rather than at height 0. Placed
// at 0 its paving band is `0 .. 0` in a column whose terrain is at 2, which makes
// two layers 2 apart where the world's `eps` requires 8 — *"layer 1 is 2 above
// layer 0, needs 8"*, a real refusal from the store and not a fixture detail. A
// building is put on a landscape; the anchor is how.
const GROUND = 2;

// ── A DOOR — plan 17 `A5.2`, and the first content with a HINGE ─────────────
//
// ⚠ THE LIBRARY HAD NO HINGED PART AT ALL, which is why `A5.2`'s renderer half
// could not be SEEN however finished it was: `swing_fit` had been fencing an angle
// since `A5.2`'s state half and nothing in `data/parts/` declared a hinge for it to
// fence. A door leaf is the smallest content that makes the field visible, and its
// acceptance is a person's eye — *does that look like a door, and is it ajar*.
//
// ⚠ THE HINGE IS DOWN ONE EDGE, NOT THROUGH THE CENTRE. A leaf hinged at its own
// origin turns about its middle, which is a revolving door — and it is exactly the
// picture a wrong composition produces, so the content has to be able to tell the
// two apart.
// ⚠ WORLD UNITS, LIKE THE STATUE'S. `HEIGHT_SCALE` belongs to `moros_render` and
// this program does not depend on it; the other meshes here are literal too, so a
// second unit system would be one more thing to keep in step for no gain.
const LEAF_W = 0.9;      // a touch under a hex across, so it swings clear
const LEAF_H = 2.0;      // about a person and a half — a door, not a hatch
const LEAF_T = 0.08;

fn leaf_mesh() -> Mesh {
  m = mesh("leaf");
  // A slab, its hinge edge on x = 0 so the `Hinge` point below is a corner and not
  // a guess. Two rails and a panel would read better still; a slab is enough to
  // answer *is it ajar*, which is the question this content exists for.
  box(m, 0.0, 0.0, 0.0 - LEAF_T / 2.0, LEAF_W, LEAF_H, LEAF_T / 2.0);
  m
}

fn write_leaf(root: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: "oak",
    pm_desc: "a door leaf, hinged on its left edge, swinging a quarter turn"
  }) == PM_OK, "the leaf's meta was refused");
  assert(part_set_mesh(w, "door/oak").pw_code == PR_OK, "the leaf's mesh was refused");
  assert(part_set_fits(w, PartFits { pf_kind: "door", pf_size: "1x2" }).sw_code == SK_OK,
         "the leaf's FITS was refused");
  // ⚠ THE AXIS IS VERTICAL AND THE POINT IS THE HINGE CORNER. `A5.1` stores the
  // axis as given, so `(0,1,0)` is written rather than normalised; `mesh_swing`
  // normalises where it needs to.
  assert(part_set_hinge(w, Hinge {
    hg_ox: 0.0, hg_oy: 0.0, hg_oz: 0.0,
    hg_ax: 0.0, hg_ay: 1.0, hg_az: 0.0,
    hg_lo: 0.0, hg_hi: 0.25
  }).hw_code == HG_OK, "the leaf's hinge was refused");
  assert(world_save(w, "{root}/door/oak.hxw", []) == WS_OK, "the leaf was not saved");
}

// ── THE ONE-HEX DOORWAY — plan 17 `A8.3`, §P9.2 ─────────────────────────────
//
// A wall with a hole in it, and the hole is where the leaf hangs. Until `A8.3` this
// part was a single threshold cell and a socket: the leaf hung in mid-air over a
// paving slab, which is why every picture of it read as *a lump on the pavement*
// rather than as a door.
//
// ⚠ A CELL IS A HORIZONTAL PLATE AND A WALL BYTE IS A VERTICAL PANEL, which is the
// measurement the whole step turns on (`probe/a83/shapes.loft`). Two cells stacked
// in one column draw as two floating slabs — never a jamb, never a leaf — while a
// cell's `h_wall_*` byte draws a panel `WALL_UP` tall through `emit_wall_panel`,
// and `part_body_meshes` takes exactly that fallback because a part carries no wall
// RUNS. So every vertical surface in a part is an edge byte, and the wall below is
// the part's own comment on §P9.2's first row: *the opening is the wall*.
//
// ⚠ AND A WALL ALONG A ROW IS THE TWO NORTH EDGES, NOT THE EAST ONE. `SLOT_E` is
// the edge a row's cells share with each other, so a row carrying it draws parallel
// FINS — photographed, four posts with a door hanging beside them. `SLOT_NW` and
// `SLOT_NE` meet end to end and zigzag at 60°, which is what a hex wall is.
//
// ⚠ THE OPENING IS `DOOR_MAT`, NOT AN ABSENT BYTE. `wall_up(DOOR_MAT)` is 0, so it
// draws no panel — the same hole either way — but the document then SAYS there is a
// door there, which is what an opening profile will need when a part can carry one.
// ⚠ What it cannot yet say is a HEAD: the per-edge fallback has two heights, `WALL_UP`
// and `FENCE_UP`, so the opening runs the full height of the wall and there is no
// lintel over it. That wants either an `Opening` in the part format or a per-part
// wall height, and neither exists — written down rather than approximated.
fn write_frame(root: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for fq in (0 - 2)..3 {
    // The middle cell's NE edge is the doorway; every other north edge is wall.
    assert(world_set_cell(w, fq, 0, 0,
      Hex { h_height: 1 as u16? ?? 0,
            h_material: hex_editor::FLOOR_MAT as u8? ?? 0,
            h_wall_n:  hex_editor::WALL_MAT as u8? ?? 0,
            h_wall_ne: (if fq == 0 { hex_editor::DOOR_MAT }
                        else { hex_editor::WALL_MAT }) as u8? ?? 0
          }).cw_code == CW_OK, "the frame's cell ({fq},0) was refused");
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: "frame",
    pm_desc: "a wall with a one-hex doorway in it, and a socket for a 1x2 leaf"
  }) == PM_OK, "the frame's meta was refused");
  // ⚠ THE HEADING IS THE OPENING'S EDGE. `slot_dir` maps SLOT_NE to direction 5 and
  // a socket's heading is `dir * (FACINGS / EDGES)` = 4 per step, so 20 — and a leaf
  // authored on its own EAST edge (heading 0, the canonical one) is turned onto this
  // one. Measured: shut, the leaf's panel lands on x 0.00..0.87, z 0.50..1.00, which
  // is the doorway edge to the corner.
  assert(part_set_sockets(w, [Socket {
    sk_q: 0, sk_r: 0, sk_h: 0, sk_mount: SM_HEAD, sk_at: 20,
    sk_kind: "door", sk_size: "1x2", sk_name: "leaf"
  }]).sw_code == SK_OK, "the frame's socket was refused");
  assert(world_save(w, "{root}/door/frame.hxw", []) == WS_OK, "the frame was not saved");
}

// ── THE LEAF, AND IT IS ONE PANEL — plan 17 `A8.3` ──────────────────────────
//
// A cell whose EAST edge carries a wall byte: its whole body is a single vertical
// panel, which is what a door is. `door/plank` is the same claim made with plates
// and it draws a lump; this is the shape that reads.
//
// ⚠ THE EAST EDGE IS THE CANONICAL ORIENTATION, and getting that wrong is the trap
// this comment exists for. A socket's heading TURNS the leaf, so a leaf authored on
// the edge it will finally occupy is turned OFF it — measured, the panel landed a
// sixth of a turn away from the doorway with every number in the document agreeing.
// Heading 0 is direction 0 is `SLOT_E`, so the leaf is authored there and the socket
// says where it really goes.
//
// ⚠ AND THE HINGE IS AN END OF THAT EDGE, not the part's origin. `door/plank`'s
// hinge is its origin, so it spins about its own middle like a turnstile; a door
// turns about its jamb. The east edge of hex (0,0) runs between the corners
// (√3/2, +0.5) and (√3/2, −0.5), and the hinge is the first of them.
fn write_cell_leaf(root: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  assert(world_set_cell(w, 0, 0, 0,
    Hex { h_height: 1 as u16? ?? 0,
          h_material: hex_editor::FLOOR_MAT as u8? ?? 0,
          h_wall_se: hex_editor::WALL_MAT as u8? ?? 0 }).cw_code == CW_OK,
    "the leaf's cell was refused");
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: "leaf",
    pm_desc: "a door leaf that is one wall panel — cells, and no mesh anywhere"
  }) == PM_OK, "the leaf's meta was refused");
  assert(part_set_fits(w, PartFits { pf_kind: "door", pf_size: "1x2" }).sw_code == SK_OK,
         "the leaf's FITS was refused");
  // ⚠ THE WHOLE OF `A8.8`, AND IT IS ONE LINE — §P9.13. Without it this leaf is
  // drawn in the `wall` surface at one `WALL_UP`: measured, colour
  // `0.55,0.52,0.46` spanning `y 0.00..3.25`, which is the colour AND the height
  // of the wall it hangs in (`probe/a83/leaf_visible/`). A door is joinery, so it
  // is timber — the same `floor` surface `door/plank`'s cells already take, and
  // `hex_mesh`'s own note says the floor was separated from the wall in the
  // RENDERER precisely so the two can be told apart in a picture.
  //
  // ⚠ AND `up` IS DELIBERATELY UNSTATED. A leaf shorter than its opening would be
  // right if the opening had a HEAD, and it has none — §P9.13 says so — so a
  // short leaf here buys a hole above the door rather than a lintel. `up` waits
  // for the opening profile; the surface is what `A8.3` was actually short of.
  assert(part_set_wall(w, PartWall { wa_surface: "floor" }) == WA_OK,
         "the leaf's wall profile was refused");
  assert(part_set_hinge(w, Hinge {
    hg_ox: 0.8660254037844386, hg_oy: 0.0, hg_oz: 0.5,
    hg_ax: 0.0, hg_ay: 1.0, hg_az: 0.0,
    hg_lo: 0.0 - 0.25, hg_hi: 0.25
  }).hw_code == HG_OK, "the leaf's hinge was refused");
  assert(world_save(w, "{root}/door/leaf.hxw", []) == WS_OK, "the leaf was not saved");
}

// The doorway a person is shown: the wall, the leaf hung in its hole, ajar.
//
// ⚠ THE PAVING IS WIDER THAN THE WALL so the picture has a floor under both jambs —
// the wall is five cells and the old 3×3 slab left its ends hanging over grass.
fn write_hung(root: text, open: float) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for pq in (0 - 2)..5 {
    for pr in (0 - 2)..3 {
      assert(world_set_cell(w, pq, pr, 0,
        Hex { h_height: 1 as u16? ?? 0,
              h_material: hex_editor::ROAD_MAT as u8? ?? 0 }).cw_code == CW_OK,
        "the hung doorway's paving was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_HOUSE, pm_name: "hung",
    pm_desc: "a wall with a door in it, ajar — every part of it cells"
  }) == PM_OK, "the hung doorway's meta was refused");
  assert(part_set_instances(w, [PartInst {
    pi_q: 1, pi_r: 0, pi_h: 0, pi_facing: 0, pi_part: "door/frame" }]) == PI_OK,
    "the hung doorway's instance was refused");
  assert(part_set_bindings(w, [Binding {
    bd_inst: 0, bd_open: open, bd_socket: "leaf", bd_part: "door/leaf"
  }]).bw_code == BD_OK, "the hung doorway's binding was refused");
  assert(world_save(w, "{root}/door/hung.hxw", []) == WS_OK,
         "the hung doorway was not saved");
}

// A doorway: the frame standing on paving, with the leaf hung in it and AJAR.
//
// ⚠ THE SWING IS IN THE DOCUMENT, so what a person sees is the format's own value
// and not a number the renderer invented. 0.125 of a turn is 45°, which is what
// `A5.2`'s state half already round-trips.
fn write_doorway(root: text, open: float) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for pq in 0..3 {
    for pr in 0..3 {
      assert(world_set_column(w, Column { co_q: pq, co_r: pr,
        co_cells: [Hex { h_height: 1 as u16? ?? 0,
                         h_material: hex_editor::ROAD_MAT as u8? ?? 0 }] }).cw_code == CW_OK,
        "the doorway's paving was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_HOUSE, pm_name: "doorway",
    pm_desc: "a frame on paving with an oak leaf hung in it, ajar"
  }) == PM_OK, "the doorway's meta was refused");
  assert(part_set_instances(w, [PartInst {
    pi_q: 1, pi_r: 1, pi_h: 0, pi_facing: 0, pi_part: "door/frame" }]) == PI_OK,
    "the doorway's instance was refused");
  assert(part_set_bindings(w, [Binding {
    bd_inst: 0, bd_open: open, bd_socket: "leaf", bd_part: "door/oak"
  }]).bw_code == BD_OK, "the doorway's binding was refused");
  assert(world_save(w, "{root}/door/doorway.hxw", []) == WS_OK, "the doorway was not saved");
}

// ── A LEAF MADE OF CELLS — plan 17 `A8.2` ───────────────────────────────────
//
// The same door, the other body. `door/oak` is a `.glb` and this is a column of
// wall cells, and §P9.3's point is that NEITHER is required: both carry the same
// `FITS` (`door/1x2`) and the same hinge, so the binding does not know which it
// got and a doorway can swap one for the other without moving.
//
// ⚠ IT IS WHAT MAKES `A8.2` TESTABLE AT ALL. The display path can now mesh a
// limb's own cells, and until something in the library HAS cells for a body that
// code has no consumer — which is this tree's own trap, and the reason the step
// ships content beside the mechanism rather than after it.
//
// ⚠ THE HINGE IS THE SAME CORNER AS `door/oak`'s, deliberately. If the two leaves
// hung on different points, a swap would move the door and the difference would
// read as the cell path being wrong.
fn write_plank(root: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  // Two cells tall at the hinge cell — a leaf, not a hatch, and the same 1x2 the
  // class is named for. `W_EPS` apart or the store merges them into one layer.
  //
  // ⚠ `FLOOR_MAT` AND NOT `WALL_MAT`. A cell's material is a small named set and
  // `wall` is not in it — walls are an EDGE material, so a leaf asking for one
  // would be asking for something a cell cannot hold. The five a cell may take are
  // SURFACE, ROAD, FIELD, FLOOR and ROOF; a door is joinery, so FLOOR.
  for lh in 0..2 {
    assert(world_set_cell(w, 0, 0, lh,
      Hex { h_height: (1 + lh * W_EPS) as u16? ?? 0,
            h_material: hex_editor::FLOOR_MAT as u8? ?? 0 }).cw_code == CW_OK,
      "the plank's cell {lh} was refused");
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: "plank",
    pm_desc: "a door leaf built from cells — the same 1x2 class as door/oak"
  }) == PM_OK, "the plank's meta was refused");
  assert(part_set_fits(w, PartFits { pf_kind: "door", pf_size: "1x2" }).sw_code == SK_OK,
         "the plank's FITS was refused");
  assert(part_set_hinge(w, Hinge {
    hg_ox: 0.0, hg_oy: 0.0, hg_oz: 0.0,
    hg_ax: 0.0, hg_ay: 1.0, hg_az: 0.0,
    hg_lo: 0.0, hg_hi: 0.25
  }).hw_code == HG_OK, "the plank's hinge was refused");
  assert(world_save(w, "{root}/door/plank.hxw", []) == WS_OK, "the plank was not saved");
}

// The same doorway, hung with the cell leaf. Two files that differ in ONE field.
fn write_planked(root: text, open: float) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for pq in 0..3 {
    for pr in 0..3 {
      assert(world_set_cell(w, pq, pr, 0,
        Hex { h_height: 1 as u16? ?? 0,
              h_material: hex_editor::ROAD_MAT as u8? ?? 0 }).cw_code == CW_OK,
        "the planked doorway's paving was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_HOUSE, pm_name: "planked",
    pm_desc: "a frame on paving with a CELL leaf hung in it, ajar"
  }) == PM_OK, "the planked doorway's meta was refused");
  assert(part_set_instances(w, [PartInst {
    pi_q: 1, pi_r: 1, pi_h: 0, pi_facing: 0, pi_part: "door/frame" }]) == PI_OK,
    "the planked doorway's instance was refused");
  assert(part_set_bindings(w, [Binding {
    bd_inst: 0, bd_open: open, bd_socket: "leaf", bd_part: "door/plank"
  }]).bw_code == BD_OK, "the planked doorway's binding was refused");
  assert(world_save(w, "{root}/door/planked.hxw", []) == WS_OK, "the planked doorway was not saved");
}

// ── A LEAF ON A FINER LATTICE — plan 17 `A8.2b`, §P9.1 ──────────────────────
//
// The same opening, the same class, the same hinge — and a leaf authored at HALF
// the frame's unit, so it has three courses and two staves where `door/plank` has
// two courses and one column. A door at the parent's hex size is one column wide
// with no room for detail; this is the answer, and the shrink is derived from the
// two files rather than authored anywhere.
//
// ⚠ NOTHING HERE SAYS 0.5. `w_unit` is the only field that differs from the plank
// beyond the cells themselves, and `expand` divides the two — so re-authoring this
// leaf at the frame's unit changes its size on screen and no other file at all.
//
// ⚠ AND IT IS ONLY LEGAL BECAUSE IT HANGS ON A JOINT. The same file placed by
// `INST` is refused (`EX_UNIT`): a cell cannot be written into a world that states
// another unit, and this leaf's cells are never written anywhere.
//
// ⚠ THE COURSES ARE `W_EPS` APART IN THIS WORLD'S OWN STEPS. ε is a count of
// steps, not a length, so at half the unit the same 8 is half the separation —
// which is exactly what makes three courses fit where two did.
fn write_slat(root: text) {
  w = world_new(W_UNIT / 2.0 ?? W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for sq in 0..2 {
    for sh in 0..3 {
      assert(world_set_cell(w, sq, 0, sh,
        Hex { h_height: (2 + sh * W_EPS) as u16? ?? 0,
              h_material: hex_editor::FLOOR_MAT as u8? ?? 0 }).cw_code == CW_OK,
        "the slat's cell ({sq},{sh}) was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: "slat",
    pm_desc: "a door leaf on a finer lattice — three courses, shrunk to the same 1x2"
  }) == PM_OK, "the slat's meta was refused");
  assert(part_set_fits(w, PartFits { pf_kind: "door", pf_size: "1x2" }).sw_code == SK_OK,
         "the slat's FITS was refused");
  // The hinge corner is `door/oak`'s and `door/plank`'s — in the leaf's OWN frame,
  // so it shrinks with the leaf and the three doors still hang on one point.
  assert(part_set_hinge(w, Hinge {
    hg_ox: 0.0, hg_oy: 0.0, hg_oz: 0.0,
    hg_ax: 0.0, hg_ay: 1.0, hg_az: 0.0,
    hg_lo: 0.0, hg_hi: 0.25
  }).hw_code == HG_OK, "the slat's hinge was refused");
  assert(world_save(w, "{root}/door/slat.hxw", []) == WS_OK, "the slat was not saved");
}

// The same doorway again, hung with the fine leaf. Three files that differ in ONE
// field — `planked` is `doorway` with the leaf swapped, and this is `planked` with
// it swapped once more.
fn write_slatted(root: text, open: float) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for pq in 0..3 {
    for pr in 0..3 {
      assert(world_set_cell(w, pq, pr, 0,
        Hex { h_height: 1 as u16? ?? 0,
              h_material: hex_editor::ROAD_MAT as u8? ?? 0 }).cw_code == CW_OK,
        "the slatted doorway's paving was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_HOUSE, pm_name: "slatted",
    pm_desc: "a frame on paving with a leaf authored at half the unit, ajar"
  }) == PM_OK, "the slatted doorway's meta was refused");
  assert(part_set_instances(w, [PartInst {
    pi_q: 1, pi_r: 1, pi_h: 0, pi_facing: 0, pi_part: "door/frame" }]) == PI_OK,
    "the slatted doorway's instance was refused");
  assert(part_set_bindings(w, [Binding {
    bd_inst: 0, bd_open: open, bd_socket: "leaf", bd_part: "door/slat"
  }]).bw_code == BD_OK, "the slatted doorway's binding was refused");
  assert(world_save(w, "{root}/door/slatted.hxw", []) == WS_OK,
         "the slatted doorway was not saved");
}

// ── THE THREE-HEX GATEWAY — plan 17 `A8.4`, §P9 ─────────────────────────────
//
// A wide opening with TWO limbs, one joint each, and a class that refuses a narrow
// leaf by spelling.
//
// ⚠ THE OPENING IS THE ZIGZAG'S OWN PEAK, and that is what makes two leaves the
// natural number rather than an arbitrary one. A wall along a row is a chain of
// alternating NW and NE edges (`A8.3`), so leaving BOTH edges of one cell bare
// opens a `Λ` two edges wide whose ends are the jambs and whose apex is where the
// leaves meet. Hinge each leaf at its own outer end and shut they close on the
// apex; a single leaf spanning both edges could not exist, because a leaf is a
// panel and the two edges are 60° apart.
//
// ⚠ THE CLASS IS NOMINAL AND SAYS `3x3`, WHICH IS THE POINT OF `A4.2`. The opening
// is two hex edges across a three-cell frontage; the class carries no size at all
// and never could (§A8.7), so what it buys is that `door/leaf` — a `door/1x2` —
// is refused here BY SPELLING rather than by anything geometric. That refusal is
// asserted below against the real library.
fn write_gate_leaf(root: text, name: text, hinge_z: float, desc: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  assert(world_set_cell(w, 0, 0, 0,
    Hex { h_height: 1 as u16? ?? 0,
          h_material: hex_editor::FLOOR_MAT as u8? ?? 0,
          h_wall_se: hex_editor::WALL_MAT as u8? ?? 0 }).cw_code == CW_OK,
    "the gate leaf's cell was refused");
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: name, pm_desc: desc
  }) == PM_OK, "the gate leaf's meta was refused");
  assert(part_set_fits(w, PartFits { pf_kind: "door", pf_size: "3x3" }).sw_code == SK_OK,
         "the gate leaf's FITS was refused");
  // ⚠ THE TWO LEAVES DIFFER IN ONE NUMBER, AND IT IS THE HINGE END. Both are
  // authored on their own EAST edge — the canonical heading-0 orientation `A8.3`
  // settled — and that edge runs between the corners (√3/2, ±0.5). Taking one end
  // for the left leaf and the other for the right is what mirrors them, and it is
  // the whole difference between the two files.
  assert(part_set_hinge(w, Hinge {
    hg_ox: 0.8660254037844386, hg_oy: 0.0, hg_oz: hinge_z,
    hg_ax: 0.0, hg_ay: 1.0, hg_az: 0.0,
    hg_lo: 0.0 - 0.25, hg_hi: 0.25
  }).hw_code == HG_OK, "the gate leaf's hinge was refused");
  assert(world_save(w, "{root}/{name}.hxw", []) == WS_OK, "{name} was not saved");
}

fn write_gateway(root: text) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for gq in (0 - 2)..3 {
    // Both north edges of the middle cell are the gateway; everything else is wall.
    open_here = gq == 0;
    assert(world_set_cell(w, gq, 0, 0,
      Hex { h_height: 1 as u16? ?? 0,
            h_material: hex_editor::FLOOR_MAT as u8? ?? 0,
            h_wall_n:  (if open_here { hex_editor::DOOR_MAT }
                        else { hex_editor::WALL_MAT }) as u8? ?? 0,
            h_wall_ne: (if open_here { hex_editor::DOOR_MAT }
                        else { hex_editor::WALL_MAT }) as u8? ?? 0
          }).cw_code == CW_OK, "the gateway's cell ({gq},0) was refused");
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_FITTING, pm_name: "gateway",
    pm_desc: "a wall with a two-edge gateway in it, and a socket for each leaf"
  }) == PM_OK, "the gateway's meta was refused");
  // ⚠ ONE SOCKET PER LEAF, AND THE HEADINGS ARE THE TWO EDGES. `slot_dir` maps
  // SLOT_NW to direction 4 and SLOT_NE to 5, and a heading is `dir * 4` — so 16
  // and 20. Each leaf is turned onto its own edge by its own socket, which is why
  // two sockets rather than one wide one: a socket is a place, not a span.
  assert(part_set_sockets(w, [
    Socket { sk_q: 0, sk_r: 0, sk_h: 0, sk_mount: SM_HEAD, sk_at: 16,
             sk_kind: "door", sk_size: "3x3", sk_name: "leaf-l" },
    Socket { sk_q: 0, sk_r: 0, sk_h: 0, sk_mount: SM_HEAD, sk_at: 20,
             sk_kind: "door", sk_size: "3x3", sk_name: "leaf-r" }
  ]).sw_code == SK_OK, "the gateway's sockets were refused");
  assert(world_save(w, "{root}/door/gateway.hxw", []) == WS_OK,
         "the gateway was not saved");
}

// The gateway standing on paving with both leaves hung, swung apart.
//
// ⚠ THE TWO SWINGS ARE OPPOSITE, which is what makes a double gate read as one
// gesture rather than two doors that happen to be adjacent. Each leaf turns about
// its own jamb, so the same sign would send one out and one in.
fn write_gated(root: text, open: float) {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for pq in (0 - 2)..5 {
    for pr in (0 - 2)..3 {
      assert(world_set_cell(w, pq, pr, 0,
        Hex { h_height: 1 as u16? ?? 0,
              h_material: hex_editor::ROAD_MAT as u8? ?? 0 }).cw_code == CW_OK,
        "the gated wall's paving was refused");
    }
  }
  assert(part_set_meta(w, PartMeta {
    pm_kind: PK_HOUSE, pm_name: "gated",
    pm_desc: "a gateway with both leaves hung and swung apart — all of it cells"
  }) == PM_OK, "the gated wall's meta was refused");
  assert(part_set_instances(w, [PartInst {
    pi_q: 1, pi_r: 0, pi_h: 0, pi_facing: 0, pi_part: "door/gateway" }]) == PI_OK,
    "the gated wall's instance was refused");
  assert(part_set_bindings(w, [
    Binding { bd_inst: 0, bd_open: 0.0 - open, bd_socket: "leaf-l",
              bd_part: "door/gate-l" },
    Binding { bd_inst: 0, bd_open: open, bd_socket: "leaf-r",
              bd_part: "door/gate-r" }
  ]).bw_code == BD_OK, "the gated wall's bindings were refused");
  assert(world_save(w, "{root}/door/gated.hxw", []) == WS_OK,
         "the gated wall was not saved");
}

fn ground() -> World {
  w = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  for q in (0 - 2)..12 {
    for r in (0 - 2)..12 {
      assert(world_set_column(w, Column { co_q: q, co_r: r,
        co_cells: [Hex { h_height: GROUND as u16? ?? 0,
                         h_material: 1 as u8? ?? 0 }] }).cw_code == CW_OK,
        "the ground at ({q},{r}) was refused");
    }
  }
  w
}

fn main() {
  root = out_root();
  assert(mkdir_all("{root}/prop").ok(), "could not make {root}/prop");
  assert(mkdir_all("{root}/door").ok(), "could not make {root}/door");

  // ── the door, and the library's first hinge — plan 17 `A5.2` ──────────────
  //
  // ⚠ WRITTEN BEFORE THE PROPS so a failure here names itself rather than showing
  // up as a statue that will not build. Same byte-identity rule as the statue's:
  // the `.glb` is committed, so the build has to repeat.
  leafp = "{root}/door/oak.glb";
  lbefore = 0;
  if exists(leafp) {
    lwas = file(leafp);
    lbefore = lwas#size;
  }
  save_glb(leaf_mesh(), leafp);
  lonf = file(leafp);
  lafter = lonf#size;
  assert(lafter > 0, "save_glb wrote nothing to {leafp}");
  if lbefore > 0 {
    assert(lbefore == lafter,
           "the leaf's glb was {lbefore} bytes and is now {lafter} — a build that "
         + "does not repeat cannot be committed");
  }
  write_leaf(root);
  write_frame(root);
  write_doorway(root, 0.125);
  // ── the doorway that is cells all the way down — `A8.3` ────────────────────
  write_cell_leaf(root);
  write_hung(root, 0.125);
  // ⚠ THE LEAF MUST LAND ON THE OPENING, and that is a claim about the pair rather
  // than about either file. The socket turns a leaf authored on its own EAST edge
  // onto the doorway's NE one — get the canonical orientation wrong and the panel
  // sits a sixth of a turn away with every number in both documents agreeing.
  hw = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  hex_ = part_expand(hw, root, PartInst { pi_q: 0, pi_r: 0, pi_h: 0, pi_facing: 0,
                                          pi_part: "door/hung" }, 0);
  assert(hex_.ex_code == EX_OK, "the hung doorway does not expand: {hex_.ex_why}");
  assert(len(hex_.ex_meshes) == 1,
         "{len(hex_.ex_meshes)} placements came out of the hung doorway, not 1");
  hm = hex_.ex_meshes[0] ?? MeshAt {};
  assert(hm.ma_part == "door/leaf" && hm.ma_mesh == "",
         "the hung leaf is '{hm.ma_part}' / mesh '{hm.ma_mesh}' — it must be cells "
       + "and no mesh at all, which is the whole of A8.3");
  assert(hm.ma_facing == 20,
         "the leaf is turned {hm.ma_facing}, and the doorway's edge is heading 20");
  assert(hm.ma_swing == 0.125 && hm.ma_ay != 0.0,
         "the leaf is drawn at {hm.ma_swing} about ({hm.ma_ax},{hm.ma_ay},{hm.ma_az})");
  println("  hung:   leaf '{hm.ma_part}' at ({hm.ma_q},{hm.ma_r},{hm.ma_h}) turned "
        + "{hm.ma_facing} onto the doorway edge, ajar {hm.ma_swing} — no mesh anywhere");

  // ── the gateway: two limbs, one joint each — `A8.4` ────────────────────────
  write_gate_leaf(root, "door/gate-l",
    0.5, "the left leaf of a gateway — cells, hinged at its own jamb");
  write_gate_leaf(root, "door/gate-r",
    0.0 - 0.5, "the right leaf of a gateway — the same panel, the other hinge");
  write_gateway(root);
  write_gated(root, 0.125);

  gw = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  gex = part_expand(gw, root, PartInst { pi_q: 0, pi_r: 0, pi_h: 0, pi_facing: 0,
                                         pi_part: "door/gated" }, 0);
  assert(gex.ex_code == EX_OK, "the gateway does not expand: {gex.ex_why}");
  // ⚠ TWO PLACEMENTS, AND THAT IS THE STEP. One binding is one limb (`A8.2`), so a
  // gateway that came back as one placement would be a leaf missing with every
  // other number agreeing — `bindings_of` returning only the first is exactly the
  // shape this catches.
  assert(len(gex.ex_meshes) == 2,
         "{len(gex.ex_meshes)} placements came out of the gateway, not 2");
  gl = gex.ex_meshes[0] ?? MeshAt {};
  gr = gex.ex_meshes[1] ?? MeshAt {};
  assert(gl.ma_part == "door/gate-l" && gr.ma_part == "door/gate-r",
         "the gateway hung '{gl.ma_part}' and '{gr.ma_part}'");
  // ⚠ EACH LEAF IS TURNED ONTO ITS OWN EDGE, and the pair of headings is what says
  // the two sockets were read separately rather than the first one twice.
  assert(gl.ma_facing == 16 && gr.ma_facing == 20,
         "the leaves are turned {gl.ma_facing} and {gr.ma_facing}, and the gateway's "
       + "two edges are headings 16 and 20");
  // ⚠ AND THEIR HINGES DIFFER, which is the mirroring. Same panel, same class, same
  // cell — one number apart in the file and opposite ends in the world.
  assert(gl.ma_oz != gr.ma_oz,
         "both leaves hinge at z={gl.ma_oz}, so they are not mirrored at all");
  assert(gl.ma_swing == 0.0 - gr.ma_swing && gr.ma_swing != 0.0,
         "the leaves swing {gl.ma_swing} and {gr.ma_swing} — a double gate opens "
       + "outward on both sides or it is two doors in one hole");

  // ⚠ THE CLASS REFUSES A NARROW LEAF BY SPELLING — `A4.2`'s nominal fit, on the
  // real library rather than on a fixture. `door/leaf` is a `door/1x2` and the
  // gateway's sockets are `door/3x3`: nothing about the geometry is consulted, and
  // nothing about it could be, since a class carries no size (§A8.7).
  gnarrow = socket_for_binding(root, "door/gateway",
    Binding { bd_inst: 0, bd_open: 0.0, bd_socket: "leaf-l", bd_part: "door/leaf" });
  assert(gnarrow.sa_code == SA_NOFIT,
         "a 1x2 leaf was accepted into a 3x3 gateway: ({gnarrow.sa_code}) {gnarrow.sa_why}");
  assert(gnarrow.sa_why.find("1x2") >= 0 && gnarrow.sa_why.find("3x3") >= 0,
         "the refusal names neither class: {gnarrow.sa_why}");
  // The control: the gate leaf the socket IS for goes in.
  gwide = socket_for_binding(root, "door/gateway",
    Binding { bd_inst: 0, bd_open: 0.0, bd_socket: "leaf-l", bd_part: "door/gate-l" });
  assert(gwide.sa_code == SA_OK, "the gate's own leaf was refused: {gwide.sa_why}");
  println("  gated:  '{gl.ma_part}' turned {gl.ma_facing} swung {gl.ma_swing} and "
        + "'{gr.ma_part}' turned {gr.ma_facing} swung {gr.ma_swing}; a 1x2 leaf is "
        + "refused by class ({gnarrow.sa_code})");
  // ── the cell-bodied leaf, and the same doorway hung with it — `A8.2` ────────
  write_plank(root);
  write_planked(root, 0.125);
  // ── and the same leaf on a finer lattice, shrunk to fit — `A8.2b` ───────────
  write_slat(root);
  write_slatted(root, 0.125);
  // ⚠ THE RATIO IS CHECKED HERE, WHERE THE TWO FILES ARE IN HAND. A slat that
  // reached the display path at scale 1.0 is a door twice the size of its own
  // opening, and the only instrument that would see it is a picture.
  sw = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  sex = part_expand(sw, root, PartInst { pi_q: 0, pi_r: 0, pi_h: 0, pi_facing: 0,
                                         pi_part: "door/slatted" }, 0);
  assert(sex.ex_code == EX_OK, "the slatted doorway does not expand: {sex.ex_why}");
  sm = sex.ex_meshes[0] ?? MeshAt {};
  assert(sm.ma_scale == 0.5,
         "the slat is authored at half the doorway's unit and came back at scale "
       + "{sm.ma_scale}");
  // And the composition the same file is refused for, so the pair ships together.
  sinst = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  sbad = part_expand(sinst, root, PartInst { pi_q: 0, pi_r: 0, pi_h: 0, pi_facing: 0,
                                             pi_part: "door/slat" }, 0);
  assert(sbad.ex_code == EX_UNIT,
         "a fine part was composed into a coarse world: ({sbad.ex_code}) {sbad.ex_why}");
  println("  slatted: leaf '{sm.ma_part}' at scale {sm.ma_scale}, and the same part "
        + "by INST is refused — ({sbad.ex_code})");
  // ⚠ THE EXPANSION IS THE GATE, not three files that load. A doorway whose leaf
  // is not bound, or is bound and not swung, writes and reads back perfectly.
  dw = world_new(W_UNIT, 0, W_EPS, W_THETA).wn_world;
  dex = part_expand(dw, root, PartInst { pi_q: 0, pi_r: 0, pi_h: 0, pi_facing: 0,
                                         pi_part: "door/doorway" }, 0);
  assert(dex.ex_code == EX_OK, "the doorway does not expand: {dex.ex_why}");
  assert(len(dex.ex_meshes) == 1,
         "{len(dex.ex_meshes)} mesh placements came out of the doorway, not 1");
  dm = dex.ex_meshes[0] ?? MeshAt {};
  assert(dm.ma_swing == 0.125,
         "the leaf is drawn at {dm.ma_swing} and the document says 0.125");
  assert(dm.ma_ay != 0.0,
         "the leaf's hinge axis did not reach its placement, so it can only be shut");
  println("  doorway: leaf '{dm.ma_mesh}' at ({dm.ma_q},{dm.ma_r},{dm.ma_h}) "
        + "aim {dm.ma_facing}, swung {dm.ma_swing} of a turn about "
        + "({dm.ma_ax},{dm.ma_ay},{dm.ma_az})");

  // ── the mesh, and the proof that writing it is repeatable ──────────────────
  //
  // ⚠ THE BYTE-IDENTITY CHECK IS WHAT MAKES COMMITTING IT SANE, and it is the same
  // argument `data/parts/house/cottage.hxw` already carries: a generated file that
  // changed each run would put its whole size into every commit that touched it.
  // Measured here rather than assumed of `save_glb`.
  path = "{root}/prop/statue.glb";
  // ⚠ `#size` READS OFF A VARIABLE, NOT OFF A CALL — `file(path)#size` is a parse
  // error, which `part_build.loft` had already worked out.
  before = 0;
  if exists(path) {
    was = file(path);
    before = was#size;
  }
  save_glb(statue_mesh(), path);
  onf = file(path);
  after = onf#size;
  assert(after > 0, "save_glb wrote nothing to {path}");
  if before > 0 {
    assert(before == after,
           "the statue's glb was {before} bytes and is now {after} — a build that "
         + "does not repeat cannot be committed");
  }
  seat = "{root}/prop/seated.glb";
  save_glb(seated_mesh(), seat);
  seatf = file(seat);
  assert(seatf#size > 0, "save_glb wrote nothing to {seat}");
  // ⚠ AND THE TWO MESHES ARE DIFFERENT SHAPES, which is the control on a swap that
  // has two names and one asset: a placement carries the NAME and never the
  // geometry, so two `save_glb` calls that both wrote the standing figure would
  // satisfy every assertion below.
  //
  // ⚠ THE SIZE CANNOT SAY IT, AND THIS CHECK ASSERTED THE SIZE FIRST AND FAILED.
  // Both figures are three boxes — 72 vertices, 36 triangles — so both files are
  // **3616 bytes** and differ only in the float values. STATE.md's lesson G, met on
  // a file rather than on a picture: a count is not a shape. The height is, and it
  // is the same fact a person reads off the two thumbnails.
  ga = load_glb(path);
  gb = load_glb(seat);
  assert(ga.gr_code == GR_OK && gb.gr_code == GR_OK,
         "a statue mesh did not read back ({ga.gr_code}, {gb.gr_code})");
  assert(len(ga.gr_mesh.vertices) > 0 && len(gb.gr_mesh.vertices) > 0,
         "a statue mesh read back with no vertices");
  assert(top_y(ga.gr_mesh) != top_y(gb.gr_mesh),
         "both statues stand {top_y(ga.gr_mesh)} tall — the second mesh is probably "
       + "the first");
  // ⚠ AND HEIGHT ALONE IS STILL NOT ENOUGH, which the CATALOGUE PICTURE said and no
  // number here did. `part_thumb_view` fits the camera to each part, so a shorter
  // figure of the same proportions fills the frame identically and the two rows read
  // as one statue drawn twice. Only the PROPORTION survives a per-part fit, so that
  // is what is fenced — and it is fenced on the mesh, where it is a fact about the
  // content rather than about how something chose to frame it.
  aa = aspect(ga.gr_mesh);
  ab = aspect(gb.gr_mesh);
  wide = aa;
  narrow = ab;
  if ab > aa { wide = ab; narrow = aa; }
  assert(narrow > 0.0 && (wide / narrow ?? 0.0) >= 1.5,
         "the two statues are {aa} and {ab} wide for their height — under 1.5x apart "
       + "they are one silhouette after the thumbnail camera fits each to the frame, "
       + "and *a different statue* is then a claim only a string can make");

  write_statue(root, "statue",
               "a standing figure, arm raised along +X — modelled facing heading 0");
  write_statue(root, "seated",
               "a seated figure, knees forward along +X — modelled facing heading 0");
  write_plinth(root);

  // ── A6.3 — THE SWAP, MEASURED BEFORE THE COMMITTED STATE IS WRITTEN ────────
  //
  // ⚠ THE VARIANT GOES FIRST AND THE COMMITTED ONE LAST, and the order is the whole
  // safety of doing this on a real committed file in a tree two agents share: the
  // shrine is left holding `prop/statue` by the LAST write, before a single
  // comparison is asserted. An assertion that fires cannot leave `data/parts/`
  // holding the variant.
  // ── A8.5 — THE SAME SOCKET, A BODY OF CELLS ────────────────────────────────
  //
  // ⚠ THE VARIANT ORDER IS `A6.3`'s AND FOR ITS REASON: every shrine that is not
  // the committed one is expanded BEFORE `prop/statue` is written back, so an
  // assertion that fires cannot leave `data/parts/` holding a variant.
  write_cell_statue(root);
  write_shrine(root, "prop/carved");
  cst_world = ground();
  cst = part_expand(cst_world, root, PartInst {
    pi_q: 5, pi_r: 5, pi_h: GROUND, pi_facing: 0, pi_part: "prop/shrine"
  }, 0);

  write_shrine(root, "prop/seated");
  alt_world = ground();
  alt = part_expand(alt_world, root, PartInst {
    pi_q: 5, pi_r: 5, pi_h: GROUND, pi_facing: 0, pi_part: "prop/shrine"
  }, 0);

  write_shrine(root, "prop/statue");

  // ── and now the part of this that is the gate ──────────────────────────────
  //
  // ⚠ IT EXPANDS RATHER THAN RE-READING. Three files that load are not a statue on
  // a plinth; the claim is about the COMPOSITION, so the check is the same call a
  // renderer makes.
  w = ground();
  ex = part_expand(w, root, PartInst {
    pi_q: 5, pi_r: 5, pi_h: GROUND, pi_facing: 0, pi_part: "prop/shrine"
  }, 0);
  assert(ex.ex_code == EX_OK, "the shrine did not expand ({ex.ex_code}): {ex.ex_why}");
  assert(ex.ex_parts == 3, "{ex.ex_parts} parts derived, not 3 (shrine, plinth, statue)");
  assert(len(ex.ex_meshes) == 1, "{len(ex.ex_meshes)} mesh placements, not 1");
  m = ex.ex_meshes[0] ?? MeshAt {};
  assert(m.ma_mesh == "prop/statue", "the placement names '{m.ma_mesh}'");

  // ON THE PLINTH — the socket's cell, composed through the doubled lattice.
  (pq, pr) = un_origin(5, 5, 2, 1);
  assert(m.ma_q == pq && m.ma_r == pr,
         "the statue is at ({m.ma_q},{m.ma_r}); the plinth's socket is at ({pq},{pr})");
  assert(pq != 5 + 2 || pr != 5 + 1,
         "the naive sum agrees at this offset, so the check proves nothing");

  // AT THE PLINTH'S HEIGHT — and the number is READ OUT OF THE FILE rather than
  // taken from `PLINTH_H`, so a plinth whose stone and socket disagreed would fail
  // here instead of agreeing with the constant that built both.
  ld = world_load("{root}/prop/plinth.hxw");
  assert(ld.wl_code == WL_OK, "the plinth did not load: {ld.wl_detail}");
  stone = 0;
  for c in column_cells(world_column(ld.wl_world, 0, 0)) {
    ch = c.h_height as integer ?? 0;
    if ch > stone { stone = ch; }
  }
  sk = part_sockets(ld.wl_world);
  assert(sk.sr_code == MR_OK, "the plinth's socket did not come back: {sk.sr_why}");
  top = (sk.sr_items[0] ?? Socket {}).sk_h;
  assert(top == stone,
         "the socket sits at {top} and the stone reaches {stone} — the statue would "
       + "stand inside the plinth or float above it");
  // ⚠ THE GROUND IS IN THE SUM, and leaving it out would have been the easier
  // assertion and the wrong claim: the statue is at *the plinth's top*, and the
  // plinth's top is where the shrine stands plus how tall the stone is. A part's
  // heights are its own until something lifts them (`stamp.loft`).
  assert(m.ma_h == GROUND + top,
         "the statue stands at {m.ma_h}; the shrine is on ground {GROUND} and the "
       + "plinth's top is {top}, so {GROUND + top} was expected");

  // FACING OUT — the socket's aim, less the statue's own modelled facing.
  a = part_anchor((world_load("{root}/prop/statue.hxw")).wl_world);
  assert(a.ar_code == MR_OK, "the statue's anchor did not come back: {a.ar_why}");
  assert(m.ma_facing == LOOK - a.ar_anchor.pa_facing,
         "the statue is turned {m.ma_facing}; the socket looks at {LOOK} and the "
       + "figure is modelled facing {a.ar_anchor.pa_facing}");
  assert(m.ma_facing % 4 != 0,
         "the socket's aim is one of the six headings a CELL part could take, so "
       + "this library does not demonstrate what a prop can do that a house cannot");

  // ⚠ AND THE MESH IT NAMES ACTUALLY LOADS, WITH VERTICES IN IT. `part_expand`
  // deliberately never opens the file (it runs per edit), so without this the
  // library could ship a part pointing at a mesh that is absent or empty and every
  // number above would still agree. `mc_verts` is a read-back and not a tally.
  st = world_load("{root}/prop/statue.hxw");
  assert(st.wl_code == WL_OK, "the statue did not load: {st.wl_detail}");
  ck = part_mesh_loads(root, st.wl_world);
  assert(ck.mc_code == MC_OK, "the statue's mesh did not load ({ck.mc_code}): {ck.mc_why}");
  assert(ck.mc_verts > 0, "the mesh loaded with {ck.mc_verts} vertices — it draws nothing");

  sd = world_load("{root}/prop/seated.hxw");
  assert(sd.wl_code == WL_OK, "the seated figure did not load: {sd.wl_detail}");
  sck = part_mesh_loads(root, sd.wl_world);
  assert(sck.mc_code == MC_OK, "the seated mesh did not load ({sck.mc_code}): {sck.mc_why}");
  assert(sck.mc_verts > 0, "the seated mesh has {sck.mc_verts} vertices");

  // ── A6.3 — a different statue on the same plinth, no other change ──────────
  //
  // The variant was expanded above, before the committed shrine was written back.
  assert(alt.ex_code == EX_OK, "the swapped shrine did not expand: {alt.ex_why}");
  assert(len(alt.ex_meshes) == 1, "{len(alt.ex_meshes)} placements after the swap, not 1");
  am = alt.ex_meshes[0] ?? MeshAt {};

  // ⚠ THE FIELD THAT MUST CHANGE, FIRST. Without it every check below is satisfied
  // by a swap that never happened, which is the strongest possible wrong reason for
  // a green build.
  assert(am.ma_mesh == "prop/seated" && m.ma_mesh == "prop/statue",
         "the swap did not take: '{m.ma_mesh}' and '{am.ma_mesh}'");
  // …and the four that must not. Position and height are the SOCKET's and were
  // never stored on the leaf — the absence `bind.loft` is built around.
  assert(am.ma_q == m.ma_q && am.ma_r == m.ma_r,
         "the seated figure landed at ({am.ma_q},{am.ma_r}), the standing one at "
       + "({m.ma_q},{m.ma_r}) — the same socket gave two positions");
  assert(am.ma_h == m.ma_h, "heights {am.ma_h} and {m.ma_h}");
  assert(am.ma_facing == m.ma_facing, "turns {am.ma_facing} and {m.ma_facing}");

  // ⚠ AND NO CELL ANYWHERE MOVED. The placement's own fields cannot see the plinth
  // or the paving; this can. A swap that rebuilt the frame — or lost it — passes
  // every assertion above and fails here.
  df = part_diff(w, alt_world, 12);
  assert(df.pd_same, "swapping the statue changed the world's cells: {df.pd_why}");

  // ── A8.5 — NEITHER BODY IS REQUIRED ────────────────────────────────────────
  //
  // ⚠ THE PAIR IS THE CLAIM, not either half. A cell statue that fits proves
  // nothing on its own — `A6.2` already put a MESH in this socket — and what §P9.3
  // says is that the socket does not CARE: same class, same position, same heading,
  // and the only difference is what the thing is made of.
  assert(cst.ex_code == EX_OK, "the carved shrine did not expand: {cst.ex_why}");
  assert(len(cst.ex_meshes) == 1, "{len(cst.ex_meshes)} placements, not 1");
  cm = cst.ex_meshes[0] ?? MeshAt {};
  // ⚠ NO MESH AT ALL, AND THAT IS THE FIELD THAT MUST CHANGE. `ma_part` names the
  // part whose CELLS are the body; a statue that arrived here with `ma_mesh` set
  // would be `A6.2`'s path wearing a new name.
  assert(cm.ma_mesh == "" && cm.ma_part == "prop/carved",
         "the carved statue came back as mesh '{cm.ma_mesh}' / part '{cm.ma_part}'");
  // …and the three that must not, exactly as the `.glb` swap asserts them.
  assert(cm.ma_q == m.ma_q && cm.ma_r == m.ma_r && cm.ma_h == m.ma_h,
         "the carved statue landed at ({cm.ma_q},{cm.ma_r},{cm.ma_h}) and the mesh one "
       + "at ({m.ma_q},{m.ma_r},{m.ma_h}) — one socket, two positions");
  assert(cm.ma_facing == m.ma_facing,
         "turns {cm.ma_facing} and {m.ma_facing} — a cell BODY may take all 24 "
       + "because a limb is meshed, never stamped (A8.1)");
  // ⚠ AND THE SCALE IS DERIVED, WHICH IS WHY IT IS A FIGURE AND NOT A BOULDER. The
  // carved statue is authored at a quarter of the world's unit, so `A8.2b` shrinks
  // it at the placement — 1.73 world units across becomes 0.43.
  assert(cm.ma_scale == 0.25,
         "the carved statue came back at scale {cm.ma_scale}, not the 0.25 its own "
       + "file states against the shrine's");
  cdf = part_diff(w, cst_world, 12);
  assert(cdf.pd_same, "the carved statue changed the world's cells: {cdf.pd_why}");
  // ⚠ AND THE SOCKET TAKES BOTH, ASKED DIRECTLY. The expansions above each used one
  // body; this is the one question §P9.3 actually poses, put to `socket_fit`.
  for cst_holds in ["prop/statue", "prop/carved"] {
    cst_fit = socket_for_binding(root, "prop/plinth",
      Binding { bd_inst: 0, bd_open: 0.0, bd_socket: "top", bd_part: cst_holds });
    assert(cst_fit.sa_code == SA_OK,
           "'{cst_holds}' does not fit the plinth: {cst_fit.sa_why}");
  }

  println("  statue: {ck.mc_verts} vertices, {after} bytes -> {path}");
  println("  seated: {sck.mc_verts} vertices, {seatf#size} bytes -> {seat}");
  // ⚠ THIS LINE READ *"a heading no cell part can take"* AND `A8.1` MADE IT FALSE.
  // A cell part BOUND into this socket takes 18 exactly, because a limb is meshed
  // and never written to a lattice; what still cannot take it is a cell part
  // INSTANCED, whose cells go into the parent's grid (`A4.4`). The distinction is
  // the edge, not the body — §P9.
  println("  shrine: statue on prop/plinth at ({m.ma_q},{m.ma_r}), height {m.ma_h}, "
        + "turned {m.ma_facing} of 24 — a heading no INSTANCED part can take");
  println("  swap:   prop/seated lands at ({am.ma_q},{am.ma_r}) height {am.ma_h} "
        + "turned {am.ma_facing} — one field of the document, one field of the result");
  // ⚠ AND BOTH PATHS ARE IN THE LIBRARY, not just in this program's assertions.
  // `prop/shrine` holds the mesh statue and `prop/shrine-cell` holds the carved
  // one — two committed files differing in a single field, which is what makes the
  // catalogue, a thumbnail and a picture able to show the claim at all.
  write_shrine_named(root, "shrine-cell", "prop/carved");
  println("  carved: a body of CELLS in the same socket at ({cm.ma_q},{cm.ma_r}) "
        + "height {cm.ma_h} turned {cm.ma_facing}, scale {cm.ma_scale} — no mesh "
        + "anywhere, and the plinth takes both bodies");
}
