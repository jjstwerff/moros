//
// S7 — THE SCRIPT DRIVES THE GESTURES, WITH NO SERVER AT ALL.
//
// `SCRIPTED_EDITOR.md` §2's third line, and it is short because the first two
// happened: every gesture is a FUNCTION in `hex_editor`, so a scene is a loop over
// a text file rather than a socket, a tick and a browser.
//
//     lib/hex_editor/      gesture(world, author, args) -> Ack
//     src/editor_server    socket  → gesture(...)
//     src/editor_run       script  → gesture(...)          ← this file
//
// ⚠ IT IS THE SAME SCRIPT THE SERVER TAKES. `tools/scripts/*.keys` was written for
// `tools/script.mjs`, which drives the editor over a socket; the same file drives
// this. That is the claim worth having — one format for authoring, replay and bug
// reports — and it is testable: build a scene both ways and the worlds must match.
//
// What it deliberately does NOT do is walk. `at` teleports and every gesture reads
// the author's position, so nothing here needs a tick; the walk is the server's,
// and a script that wanted one would be asking for a game rather than a scene.
//
//   SCRIPT=tools/scripts/house.keys loft --lib lib/ src/editor_run.loft
//
// ⚠ THE SCRIPT COMES FROM THE ENVIRONMENT, as the server's port does. loft has no
// `fn main(argv)` today and `arguments` parses a vector somebody has to supply, so
// an env var is the honest way in rather than a wrapper pretending to be a CLI.
use hex_editor;
use hex_voxel;
use hex_grid;

// ⚠ `HOUSE_W` / `HOUSE_D` WERE HERE AND ARE NOW `hex_editor`'s — plan 22 `W4`.
// This file and `src/editor_server.loft` each carried a copy; they agreed at 5×4
// and nothing made them. A parameter of what a key MEANS belongs beside the key.

// ⚠ THE SAME WORLD THE SERVER MAKES — AND FOR MONTHS THIS SAID SO WHILE BUILDING A
// DIFFERENT ONE. The sentence was right: *a scene built at a different epsilon is a
// different world however identical the script*. The two constants under it were
// `8` and `3` where the server used `10` and `4`. Measured 2026-08-13: the house
// scene at each differs in exactly two bytes, offsets 21 and 25 — `w_eps` and
// `w_theta` in the header, every cell equal — because nothing in `house.keys`
// stacks layers between 8 and 10 apart, so `F1` never fired differently.
//
// They are `hex_editor::WORLD_EPS` / `WORLD_THETA` now, for the reason `W_RESERVE`
// already was: what world this editor makes is a property of the gestures that
// write it, not of the program that happens to drive them.

fn seed_ground(w: VoxelWorld, half: integer) {
  for q in 0 - half..half + 1 {
    for r in 0 - half..half + 1 {
      hex_editor::ground_set(w, q, r, 0, hex_editor::SURFACE_MAT);
    }
  }
}

// What a gesture did, in a driver's words — shared by `key` and `verb` so the two
// spellings cannot come to report differently — plan 22 `K1`.
//
// ⚠ NOT EVERY GESTURE HAS A SENTENCE. `raise_ahead` succeeds with an empty
// `ak_why`, and printing that verbatim made the press SILENT — which in a script's
// transcript reads as "the key did nothing", the one thing a driver must never say
// when something happened. A gesture without words gets what was ASKED and its
// count instead, which is why `what` is the caller's word rather than a key: a
// converted line says `place: 27` where the original said `H: 27`.
fn said_ack(ack: Ack, what: text, said: &text) -> boolean {
  if ack.ak_why == hex_editor::PR_NONE {
    said = "no gesture for {what}";
    return false;
  }
  if !ack.ak_ok { said = "refused: {ack.ak_why}"; return true; }
  said = ack.ak_why;
  if said == "" { said = "{what}: {ack.ak_n}"; }
  true
}

// ── THE SESSION, READ BACK — plan 22 `K1`, and it lives in `hex_editor` now ──
//
// ⚠ **THE WORLD IS BLIND TO EVERYTHING `K1` WAS ABOUT, AND THAT IS MEASURED
// RATHER THAN FEARED.** `open_ahead` writes `DOOR_MAT` whatever the profile, so a
// round-headed door and a pointed one leave worlds that are equal **byte for
// byte** (`V1`, and `probe/k1/run.sh` control `C`). The head lives in the
// session's `Opening`, and none of the session is in the world format (`S1`). So a
// script converted from `key P` to `select 1` + `verb opening` would build a
// provably identical world with the wrong arch in it, and every instrument this
// runner had would have said the conversion was lossless. The read-back is what
// makes converting a script an assertion instead of a hope.
//
// ⏭ **AND AT `B1b.1b` IT ACQUIRED A SECOND CONSUMER, SO IT MOVED.**
// `hex_editor::session_digest` is the same text, printed by this runner and by the
// page in local mode — because the thing being compared is two SESSIONS, and two
// programs each composing their own sentence would be comparing their agreement
// about a format. The reasons it prints the geometry rather than the kind, and the
// standing selection on its own line, are at the function.

// ── WHAT A `send` CARRIES — plan 22 `K3c` ────────────────────────────────────
//
// Which wire ids change nothing this runner builds, so that skipping one really does
// let a script serve both drivers. ⚠ **A WHITELIST, AND THE DEFAULT IS DENY** — the
// reasoning is at the `send` branch in `run_line`, and the short version is that a
// classifier which answers *harmless* to an id it has never seen is not a classifier.
//
// ⚠ **ENUMERATED, NOT DERIVED FROM THE CLASS LETTER.** `9` LOAD is filed **R** and
// replaces the store; `7` PLACE is filed **X** and moves the author. Neither is here.
fn send_quiet(id: integer) -> boolean {
  // **V** — the eye. Aspect, look, the rest report, the mode, and the placed eye.
  // Nothing here is read by a gesture; the runner has no renderer to point anyway.
  if id == 2 || id == 3 || id == 28 || id == 40 || id == 48 { return true; }
  // **R** — questions. A column, its walls, its dressing, one cell, the layer
  // labels, a part's sockets. The server answers them; nobody answers them here,
  // and an unanswered question writes nothing.
  if id == 15 || id == 16 || id == 20 || id == 26 || id == 29 || id == 45 {
    return true;
  }
  // **S**/**K** — the connection's own bookkeeping: the opening burst, the trace
  // switch, and the client saying it draws its own ground.
  if id == 1 || id == 27 || id == 43 { return true; }
  false
}

// Why a refused id is refused, in the words a person fixing a script needs. ⚠ **The
// four named first are the ones the live corpus actually sends**; the rest of the
// protocol falls to the last line, which is the honest answer for an id nobody here
// has thought about.
fn send_why(id: integer) -> text {
  if id == 6 {
    return "`6:` LEVEL freezes a floor that only a WALK then lays, and this runner does not walk";
  }
  if id == 10 {
    return "`10:` ROAD freezes a grade that only a WALK then lays, and this runner does not walk";
  }
  if id == 47 {
    return "`47:` WATER lays a stream along a WALK, and this runner does not walk";
  }
  if id == 44 {
    return "`44:` PART swaps which store is edited, and this runner holds one world — so every gesture after it would land in the wrong one";
  }
  if id == 4 { return "`4:` KEYS moves the character; this runner teleports, with `at <x> <z> [yaw]`"; }
  if id == 7 { return "`7:` PLACE moves the character; say `at <x> <z> [yaw]` instead"; }
  if id == 9 { return "`9:` LOAD replaces the store, and this runner builds the world it is given"; }
  "it writes, or nothing here has classified it; `send_quiet` is the list of ids known to change nothing"
}

// The plane every unwritten cell stands on — `E1γ` — and the one authoring message
// this runner performs rather than refuses.
//
// ⚠ **A REFUSAL RETURNS `true`, AS `said_ack` DOES.** The two answers this driver
// gives are not *good* and *bad*: they are *I did what the line asked* and *I could
// not read the line*. A ground below the reserve is the world declining a legal
// request, which is a result and belongs in the transcript — the same distinction
// `said_ack` draws between `PR_NONE` and a gesture that refused.
fn set_plane(w: VoxelWorld, clear: boolean, gh: integer, gm: integer, said: &text) -> boolean {
  cell = hex_voxel::Hex {};
  if !clear {
    cell = hex_voxel::Hex { h_height: gh as u16? ?? 0, h_material: gm as u8? ?? 0 };
  }
  gset = world_set_ground(w, cell);
  if gset.cw_code != CW_OK {
    said = "ground refused — {gset.cw_detail}";
    return true;
  }
  // ⚠ THE SERVER'S OWN SENTENCE, WORD FOR WORD (`MSG_PLANE`), and it is asked of the
  // WORLD rather than of the argument: `world_has_ground_default` is what knows
  // whether a ground is standing, so a cleared plane cannot report itself as set.
  if world_has_ground_default(w) { said = "ground {gh} material {gm}"; }
  else { said = "ground cleared"; }
  true
}

// `ground <height> <material>`, and `ground off` — the friendly spelling of `50:`.
//
// ⚠ **IT IS AN AUTHORING MESSAGE AND IT IS PERFORMED RATHER THAN REFUSED**, which
// makes it the only one of its class here. `world_set_ground` is a call and not a
// tick, so this runner can do it exactly as the server does — and `E1γ` says what is
// at stake: the ground decides what every cell nobody wrote MEANS, so skipping it
// builds the whole scene on a different floor. Before `K3c` it was skipped, and
// `tools/scripts/plane.keys` — a script whose entire subject is the ground — keyed a
// world **byte-identical to one that does nothing but raise a hill**.
fn run_ground(w: VoxelWorld, rest: text, said: &text) -> boolean {
  // `ground off` and a bare `ground` clear it, which is `script.mjs`'s bare `50:`.
  if rest == "" || rest == "off" { return set_plane(w, true, 0, 0, said); }
  gsp = rest.find(" ");
  if gsp == null {
    said = "ground refused — say <height> <material>, or `off` to clear";
    return true;
  }
  set_plane(w, false, rest[..gsp] as integer ?? 0,
            rest[gsp + 1..].trim() as integer ?? 0, said)
}

// ── `send` IS WHATEVER IT CARRIES — plan 22 `K3c` ────────────────────────────
//
// ⛔ **`send` USED TO SIT ON THE SKIP LIST AND IT NEVER BELONGED THERE.** Those words
// are one thing each; `send <id>:<payload>` is a raw wire frame and is as many things
// as there are message ids. [WIRE_PROTOCOL.md](../doc/claude/WIRE_PROTOCOL.md) sorts
// every id into **A** (authoring — *survives as a store write*), **V** (view), **S**
// (session), **R** (read-back), **X** (dynamic state) and **D**/**K**; the skip list's
// words are V or S by construction and this is not.
//
// ⛔ **AND THE DROP WAS VISIBLE AS A COLLISION.** Measured over the live corpus on the
// commit before this: `doorparts`, `doorway`, `cache`, `slab` and the two `a83` probes
// all keyed **`32952:3318286153` at τ 3813** — six scripts, one world, because
// everything that made them different was inside a `44:` that never opened.
//
// ⚠ **THE CLASS LETTER IS A HINT AND NOT THE RULE, WHICH IS WHY `send_quiet` LISTS IDS
// AND NOT LETTERS.** The doc answers *what becomes of this message*; a driver asks
// *can this change what I build*, and two ids cross the two questions in opposite
// directions — `9` LOAD is filed **R** and replaces the whole store, `7` PLACE is filed
// **X**, explicitly *a character pose, not world*, and moves the datum every gesture
// reads. Whitelisting a letter waves both through.
//
// ⚠ **SO THE DEFAULT IS DENY.** Everything `send_quiet` does not name — including an id
// nobody has classified, including one this tree has not invented — **fails the run**.
// A classifier whose default answer is *harmless* is `CLAUDE.md`'s grep whose default
// answer is *absent*: it reports a clean result for every case it has never seen.
fn run_send(w: VoxelWorld, rest: text, said: &text) -> boolean {
  ci = rest.find(":");
  if ci == null { said = "send needs `<id>:<payload>`"; return false; }
  sid = rest[..ci].trim() as integer ?? 0 - 1;
  pay = rest[ci + 1..].trim();
  // ⚠ THE SAME PARSE THE SERVER'S `MSG_PLANE` BRANCH MAKES, deliberately — a comma,
  // and an empty payload meaning *clear*. A script may say either spelling of this one
  // message and must get the same floor; `probe/k3c` row D is what holds them together.
  if sid == 50 {
    if pay == "" { return set_plane(w, true, 0, 0, said); }
    pi = pay.find(",");
    if pi == null {
      said = "ground refused — say <height>,<material> or nothing to clear";
      return true;
    }
    return set_plane(w, false, pay[..pi] as integer ?? 0,
                     pay[pi + 1..].trim() as integer ?? 0, said);
  }
  if send_quiet(sid) { return true; }
  said = "send {sid}: is not something this runner can do — {send_why(sid)}. "
       + "Run this script through a server, or take the line out.";
  false
}

// One line of a script. Returns false only when the line asks for something this
// runner cannot do, which it says out loud rather than skipping.
fn run_line(w: VoxelWorld, a: &Author, sess: EditSession, line: text, said: &text) -> boolean {
  t = line.trim();
  if t == "" || t[..1] == "#" { return true; }
  sp = t.find(" ");
  cmd = t;
  rest = "";
  if sp != null { cmd = t[..sp]; rest = t[sp + 1..].trim(); }

  if cmd == "echo" { said = rest; return true; }

  if cmd == "at" {
    // `at <x> <z> [yawdeg]` — the workhorse, and the reason no tick is needed.
    p1 = rest.find(" ");
    if p1 == null { said = "at needs an x and a z"; return false; }
    xs = rest[..p1];
    tail = rest[p1 + 1..].trim();
    p2 = tail.find(" ");
    zs = tail;
    yaw = 0.0;
    if p2 != null {
      zs = tail[..p2];
      yaw = (tail[p2 + 1..].trim() as float ?? 0.0) * PI / 180.0 ?? 0.0;
    }
    a = hex_editor::author_on(w, xs as float ?? 0.0, zs as float ?? 0.0, yaw);
    said = "placed {a.au_x},{a.au_z}";
    return true;
  }

  // ── THE ONLY SPELLING — plan 22 `K1` opened it, `K3b` closed it ─────────────
  //
  // ⚠ **A KEY IS A KEYBOARD'S BUSINESS AND A VERB IS WHAT TRAVELS.** A script is a
  // document, not a keyboard: it outlives the layout it was written on, and it is
  // read by a person deciding what a scene does. `verb place` says that; `key H`
  // said which finger moved.
  //
  // ⛔ **AND `key <K>` IS GONE FROM THIS READER — plan 22 `K3b`.** It resolved through
  // `keymap_default()` for its last three steps and was the driver's whole reason to
  // know a keyboard existed. What it leaves behind is worth stating, because a
  // deletion's value is in what it makes impossible:
  //
  //   · `verb_in(keymap_default(), …)` had ONE production caller and it was this
  //     branch, so the default layout is no longer consulted by anything headless.
  //     The map is the client's now, where a person can rebind it (`M3`).
  //   · the eight keys `S3` collapsed — `P I U N M T K V` — stop being expressible
  //     at all rather than resolving to nothing. `probe/k2`'s grep that kept live
  //     scripts off them retires with the spelling it was policing.
  //   · a stale `key H` is an unknown word now, and `K3a` makes an unknown word
  //     **fail the run**. That guard is the floor this deletion stands on: without
  //     it the same line would be a silent no-op in a run reporting success.
  //
  // ⚠ **AND THE CONVERSION WAS NOT A SPELLING CHANGE FOR THE OPENING FAMILY.**
  // The definition is deliberately not injective: six keys named one `opening`, so a
  // script that says `opening` and never says `select` cuts whatever was chosen
  // last. That is why `select` landed in the same step as `K1` — a script converted
  // without it would still build a world, silently, with the wrong head on every
  // door. `lib/hex_editor/tests/opening.loft` holds the half of that rule the gates
  // used to: a gesture does not move the standing selection.
  if cmd == "verb" {
    // ⚠ THE LIBRARY ROOT IS THIS RUNNER'S OWN — plan 22 `B2e`. It reads the same
    // `data/parts/` the server does, so a script that chooses a part and places it
    // builds what the editor would. ⚠ Resolved through `source_dir()` for loft#712's
    // reason, exactly as the SCRIPT path above is.
    return said_ack(hex_editor::press_verb(sess, w, a, rest,
                                           "{source_dir()}/../data/parts"), rest, said);
  }

  if cmd == "part" {
    // ⚠ THE SAME CHOOSING THE PAGE MAKES — plan 22 `B2e`. `select` picks an opening
    // profile; this picks a PART, and `verb place` then puts that in the world
    // instead of the procedural house. A bare `part` with no name clears it, which
    // is how a script goes back to building houses.
    sel = hex_editor::session_select_part(sess, rest);
    if !sel.ak_ok { said = "part refused — {sel.ak_why}"; return true; }
    said = sel.ak_why;
    return true;
  }

  if cmd == "select" {
    // ⚠ CHOOSING IS A GESTURE AND IT REFUSES LIKE ONE. `5` is not *nearly* an
    // oculus, so `session_select_open` says no without an offer and leaves the
    // standing choice alone — which is the server's `49:` behaviour, because it is
    // the same call.
    //
    // ⚠ `select seat <kind>` NAMES ITS SUBJECT AND THE BARE FORM DOES NOT — plan 22
    // `K3`. The bare one stays the opening because `K2a` converted eight scripts to
    // write it that way, and giving the word a new meaning would move all of them for
    // a spelling. ⏭ It is the form to migrate when a fourth selection lands: it is the
    // only one whose subject is implied.
    if rest.starts_with("seat ") {
      ssel = hex_editor::session_select_seat(sess, rest[5..].trim() as integer ?? 0 - 1);
      if !ssel.ak_ok { said = "selection refused — {ssel.ak_why}"; return true; }
      said = "seat {ssel.ak_n} selected";
      return true;
    }
    if rest.starts_with("annex ") {
      asel = hex_editor::session_select_annex(sess, rest[6..].trim() as integer ?? 0 - 1);
      if !asel.ak_ok { said = "selection refused — {asel.ak_why}"; return true; }
      said = "annex {asel.ak_n} selected";
      return true;
    }
    sel = hex_editor::session_select_open(sess, rest as integer ?? 0 - 1);
    if !sel.ak_ok { said = "selection refused — {sel.ak_why}"; return true; }
    said = "opening {sel.ak_n} selected";
    return true;
  }

  // `wait`, `snap`, `hold`, `rate`, `step` are the SERVER's vocabulary: they wait
  // for an acknowledgement, photograph a renderer, or drive a tick, and none of
  // those exists here. Skipped rather than refused, so one script serves both.
  // ⚠ `eye` IS HERE FOR THE SAME REASON `snap` IS: it photographs, and there is no
  // renderer in this program. A camera placed where nobody is looking is not a
  // refusal, it is a verb this driver has no use for — so one script still serves
  // both, which is the whole reason this skip list exists.
  //
  // ⛔ **THIS LIST WAS STALE AND THE STALENESS WAS INVISIBLE — plan 22 `K3a`.** It
  // named nine words and MISSED nine more that real scripts use, and a missed word
  // is reported in exactly the same sentence a typo is: `unknown command '<x>'`,
  // printed, survived, **exit 0**. Measured over the whole corpus before this line
  // moved — **25 of 55 scripts** printed at least one, `send` in 22 of them. So the
  // driver could not tell *not my vocabulary* from *not a word*, and neither answer
  // reached the exit code. That is what made plan 22 `K3` unsafe as written: delete
  // the `key` branch above with this line as it was, and a stale `key H` becomes a
  // silent no-op in a run that still says it succeeded.
  //
  // ⚠ **THE SIX BELOW ARE PICTURE AND TIMING, AND THAT IS WHY THEY ARE SAFE TO
  // SKIP.** `mesh`/`meshr` count what a renderer built, `frame` judges the last
  // `snap`, `cam` and `feet` read where the eye and the walker are, `last` reads a
  // running tally off the wire and `until` waits for one. Not one of them writes a
  // cell, so a script serves both drivers across them exactly as the design claims.
  //
  // ⛔ **AND `hold` / `keys` / `turn` ARE NOT AMONG THOSE SIX — plan 22 `K3c`, and
  // this is the same defect `send` had, one word over.** They write no cell either,
  // and that was never the question: they MOVE THE CHARACTER, and the character is
  // the datum every gesture reads. `tools/script.mjs` compiles `hold W 3` and
  // `keys 1` to `4:<bits>` and the server walks; this runner skips them and the next
  // gesture lands wherever the last `at` put the author. Measured over the whole live
  // corpus, **one script is hit today** — `tools/scripts/deck.keys` walks 90 units
  // under `send 6:1` and then says `verb storey` with no `at` between, so the deck
  // this runner builds is at the origin on unlevelled ground. Left skipped in this
  // step **on purpose**: the fence belongs at the GESTURE rather than at the
  // movement, because a `hold` with an `at` after it is provably harmless and
  // refusing it would red every walking script for nothing. Plan 22 `K3e`.
  if cmd == "wait" || cmd == "snap" || cmd == "hold" || cmd == "rate"
     || cmd == "step" || cmd == "turn" || cmd == "keys" || cmd == "save"
     || cmd == "eye" || cmd == "mesh" || cmd == "meshr" || cmd == "frame"
     || cmd == "cam" || cmd == "feet" || cmd == "last" || cmd == "until" {
    return true;
  }

  // ── `send` AND `ground` ARE CLASSIFIED — plan 22 `K3c` ──────────────────────
  // Both are one line here and a function below, because the reasoning is long and
  // `run_line` is already at the complexity the compiler nudges at.
  if cmd == "ground" { return run_ground(w, rest, said); }
  if cmd == "send"   { return run_send(w, rest, said); }

  said = "unknown command '{cmd}'";
  false
}

fn main() {
  // ⚠ RESOLVED THROUGH `source_dir()`, and that is loft#712 rather than taste. A
  // RELATIVE path with `..` in it is refused and reported as a null size, and a
  // relative path without one resolves against THIS FILE's directory — so a plain
  // `tools/scripts/house.keys` is looked for in `src/` and comes back missing. An
  // absolute path built from `source_dir()` is the one spelling that works.
  script = env_variable("SCRIPT");
  if script == "" { script = "tools/scripts/house.keys"; }
  if script[..1] != "/" { script = "{source_dir()}/../{script}"; }
  name = env_variable("WORLD");
  if name == "" { name = "headless"; }

  src = file(script);
  if src#size < 1 {
    println("editor_run: cannot read {script}");
    return;
  }
  text = src.content();

  w = world_new(0.25, hex_editor::W_RESERVE,
                hex_editor::WORLD_EPS, hex_editor::WORLD_THETA).wn_world;
  // ⚠ THE GROUND THIS RUNNER LAYS IS THE RUNNER'S, NOT THE EDITOR'S — plan 22
  // `B1b.1b`. `new_world()` in the server seeds nothing, because an unwritten cell
  // reads as absent and absence IS the floor (`E1γ`); this patch of `SURFACE_MAT`
  // exists so a scripted scene has something with a material in it to photograph.
  // That makes it a difference between two drivers of the same gestures, and the
  // page in local mode is the third — so it is a knob rather than a constant.
  //
  // ⚠ `GROUND=0` IS THE COMPARISON, and it is not a test hook: it is *start where
  // the editor starts*. Measured — the same six verbs at the same pose leave
  // τ 4079 seeded and τ 358 not, and the world keys differ, so a comparison run
  // against the default would report a divergence that is entirely this line.
  gh = env_variable("GROUND");
  half = if gh == "" { 30 } else { gh as integer ?? 30 };
  if half > 0 { seed_ground(w, half); }
  a = hex_editor::author_on(w, 0.0, 0.0, 0.0);
  // ⚠ AN `EditSession`, NOT A BARE `WallRuns` — plan 22 `W4`. A key press is a
  // gesture applied to a SESSION, and the server has held one since the headless
  // thread landed. A runner holding only the wall runs could never call `press`
  // for any gesture that touches another registry.
  sess = hex_editor::EditSession {};

  n = 0;
  // ⛔ **A LINE THIS RUNNER DID NOT UNDERSTAND USED TO PRINT AND SURVIVE — plan 22
  // `K3a`.** `run_line` has said `false` since it was written and main threw the
  // answer away: the complaint went to stdout, the loop carried on, and the process
  // exited **0**. So a script could lose a gesture and still report success, which
  // is the shape `CLAUDE.md` calls a grep whose default answer is *absent*. It is
  // counted now, and the count is a premise rather than a diagnostic.
  bad = 0;
  for line in text.split('\n') {
    said = "";
    ok = run_line(w, a, sess, line, said);
    if said != "" { println("  {said}"); }
    if !ok { println("editor_run: {line}"); bad = bad + 1; }
    n = n + 1;
  }

  println(session_digest(sess));

  // The world as one comparable string — plan 22 `B1b.1b`. It is `hex_voxel`'s
  // function rather than this file's, because the other side of the comparison is
  // a page in a browser: two programs each spelling their own digest is `W1`'s
  // two-encoders finding one layer out, and this one exists precisely so that a
  // difference between them means a difference in what they BUILT.
  println("editor_run: world {world_key(w)}");

  path = "{source_dir()}/../worlds/{name}.hxw";
  code = world_save(w, path, []);
  println("editor_run: {n} lines, {len(w.w_chunks)} chunks, τ {w.w_tau} -> {name}.hxw (code {code})");

  // ⚠ **AFTER THE SAVE AND AFTER EVERY DIAGNOSTIC, DELIBERATELY — plan 22 `K3a`.**
  // Failing earlier would leave `worlds/{name}.hxw` holding *the previous run's*
  // world, which is the worse artifact: it has no relationship to this run at all,
  // and it reads as fresh. Saving first means the file, the digest and the world key
  // above all describe the same run — the one that lost some lines — and the exit
  // code is what says so. A caller that checks rc gets the truth; a caller that does
  // not at least gets a file that matches the log it just read.
  //
  // ⚠ **AND IT REPORTS THE COUNT RATHER THAN THE FIRST OFFENDER.** Every bad line
  // was already printed above with `editor_run: <line>`, so a person fixing a script
  // sees all of them in one run instead of one per run — the loop is the diagnostic,
  // this is only the verdict.
  assert(bad == 0, "{bad} of {n} lines were not understood — each is printed above after `editor_run:`. A word this runner skips on purpose is on the skip list in `run_line`; anything else is a typo or a command only the server has.");
}
