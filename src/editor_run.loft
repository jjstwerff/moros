//
// S7 — THE SCRIPT DRIVES THE GESTURES, WITH NO SERVER AT ALL.
//
// `SCRIPTED_EDITOR.md` §2's third line, and it is short because the first two
// happened: every gesture is a FUNCTION in `hex_editor`, so a scene is a loop over
// a text file rather than a socket, a tick and a browser.
//
//     lib/hex_editor/      gesture(world, author, args) -> Ack
//     src/editor_server    socket  → gesture(...)
//     src/editor_run       script  → gesture(...)          ← this file
//
// ⚠ IT IS THE SAME SCRIPT THE SERVER TAKES. `tools/scripts/*.keys` was written for
// `tools/script.mjs`, which drives the editor over a socket; the same file drives
// this. That is the claim worth having — one format for authoring, replay and bug
// reports — and it is testable: build a scene both ways and the worlds must match.
//
// What it deliberately does NOT do is walk. `at` teleports and every gesture reads
// the author's position, so nothing here needs a tick; the walk is the server's,
// and a script that wanted one would be asking for a game rather than a scene.
//
//   SCRIPT=tools/scripts/house.keys loft --lib lib/ src/editor_run.loft
//
// ⚠ THE SCRIPT COMES FROM THE ENVIRONMENT, as the server's port does. loft has no
// `fn main(argv)` today and `arguments` parses a vector somebody has to supply, so
// an env var is the honest way in rather than a wrapper pretending to be a CLI.
use hex_editor;
use hex_voxel;
use hex_grid;

// ⚠ `HOUSE_W` / `HOUSE_D` WERE HERE AND ARE NOW `hex_editor`'s — plan 22 `W4`.
// This file and `src/editor_server.loft` each carried a copy; they agreed at 5×4
// and nothing made them. A parameter of what a key MEANS belongs beside the key.

// ⚠ THE SAME WORLD THE SERVER MAKES — AND FOR MONTHS THIS SAID SO WHILE BUILDING A
// DIFFERENT ONE. The sentence was right: *a scene built at a different epsilon is a
// different world however identical the script*. The two constants under it were
// `8` and `3` where the server used `10` and `4`. Measured 2026-08-13: the house
// scene at each differs in exactly two bytes, offsets 21 and 25 — `w_eps` and
// `w_theta` in the header, every cell equal — because nothing in `house.keys`
// stacks layers between 8 and 10 apart, so `F1` never fired differently.
//
// They are `hex_editor::WORLD_EPS` / `WORLD_THETA` now, for the reason `W_RESERVE`
// already was: what world this editor makes is a property of the gestures that
// write it, not of the program that happens to drive them.

fn seed_ground(w: VoxelWorld, half: integer) {
  for q in 0 - half..half + 1 {
    for r in 0 - half..half + 1 {
      hex_editor::ground_set(w, q, r, 0, hex_editor::SURFACE_MAT);
    }
  }
}

// What a gesture did, in a driver's words — shared by `key` and `verb` so the two
// spellings cannot come to report differently — plan 22 `K1`.
//
// ⚠ NOT EVERY GESTURE HAS A SENTENCE. `raise_ahead` succeeds with an empty
// `ak_why`, and printing that verbatim made the press SILENT — which in a script's
// transcript reads as "the key did nothing", the one thing a driver must never say
// when something happened. A gesture without words gets what was ASKED and its
// count instead, which is why `what` is the caller's word rather than a key: a
// converted line says `place: 27` where the original said `H: 27`.
fn said_ack(ack: Ack, what: text, said: &text) -> boolean {
  if ack.ak_why == hex_editor::PR_NONE {
    said = "no gesture for {what}";
    return false;
  }
  if !ack.ak_ok { said = "refused: {ack.ak_why}"; return true; }
  said = ack.ak_why;
  if said == "" { said = "{what}: {ack.ak_n}"; }
  true
}

// ── THE SESSION, READ BACK — plan 22 `K1`, and it lives in `hex_editor` now ──
//
// ⚠ **THE WORLD IS BLIND TO EVERYTHING `K1` WAS ABOUT, AND THAT IS MEASURED
// RATHER THAN FEARED.** `open_ahead` writes `DOOR_MAT` whatever the profile, so a
// round-headed door and a pointed one leave worlds that are equal **byte for
// byte** (`V1`, and `probe/k1/run.sh` control `C`). The head lives in the
// session's `Opening`, and none of the session is in the world format (`S1`). So a
// script converted from `key P` to `select 1` + `verb opening` would build a
// provably identical world with the wrong arch in it, and every instrument this
// runner had would have said the conversion was lossless. The read-back is what
// makes converting a script an assertion instead of a hope.
//
// ⏭ **AND AT `B1b.1b` IT ACQUIRED A SECOND CONSUMER, SO IT MOVED.**
// `hex_editor::session_digest` is the same text, printed by this runner and by the
// page in local mode — because the thing being compared is two SESSIONS, and two
// programs each composing their own sentence would be comparing their agreement
// about a format. The reasons it prints the geometry rather than the kind, and the
// standing selection on its own line, are at the function.

// One line of a script. Returns false only when the line asks for something this
// runner cannot do, which it says out loud rather than skipping.
fn run_line(w: VoxelWorld, a: &Author, sess: EditSession, line: text, said: &text) -> boolean {
  t = line.trim();
  if t == "" || t[..1] == "#" { return true; }
  sp = t.find(" ");
  cmd = t;
  rest = "";
  if sp != null { cmd = t[..sp]; rest = t[sp + 1..].trim(); }

  if cmd == "echo" { said = rest; return true; }

  if cmd == "at" {
    // `at <x> <z> [yawdeg]` — the workhorse, and the reason no tick is needed.
    p1 = rest.find(" ");
    if p1 == null { said = "at needs an x and a z"; return false; }
    xs = rest[..p1];
    tail = rest[p1 + 1..].trim();
    p2 = tail.find(" ");
    zs = tail;
    yaw = 0.0;
    if p2 != null {
      zs = tail[..p2];
      yaw = (tail[p2 + 1..].trim() as float ?? 0.0) * PI / 180.0 ?? 0.0;
    }
    a = hex_editor::author_on(w, xs as float ?? 0.0, zs as float ?? 0.0, yaw);
    said = "placed {a.au_x},{a.au_z}";
    return true;
  }

  if cmd == "key" {
    // ⚠ THIS WAS A SIX-KEY TABLE AND IT IS GONE — plan 22 `W4`. It was one of FOUR
    // places that decided what a key means, and it disagreed with the server about
    // `H`: it took the grade from `ground_h(w, 0, 0)` — the **origin** — where the
    // server takes it under the author's feet. Every fixture stood at the origin,
    // so the two agreed everywhere anyone looked, and `SCRIPTED_EDITOR.md`'s claim
    // that *"one script serves both"* was false the moment a script walked.
    //
    // ⚠ **TWO LEVELS NOW, NOT ONE — plan 22 `V2b`, and this was the LAST caller of
    // `press(key)` in the tree.** A key names a VERB and the verb names what
    // happens; resolving in that order is what stops a driver from being a fourth
    // place that decides what a keystroke means.
    //
    // ⚠ **AND IT IS NOT A RENAME: `verb_of` IS NOT INJECTIVE.** `O P I U N M` all
    // answer `opening`, so a key press cuts **what is chosen** rather than what the
    // key used to spell — `key O` after `select 2` cuts a pointed one. That is the
    // collapse finishing, and it is why `K1`/`K2` taught the scripts to say `select`
    // first: every script that pressed an opening key was converted before this line
    // moved, because no world instrument could have seen the difference (the store
    // takes `DOOR_MAT` whatever the profile, and the outline lives in the session).
    // `probe/k1/run.sh` check `G` is the claim, and it was seen red on the old line.
    //
    // ⏭ **`tools/script.mjs` HAS NOT MOVED**, deliberately — `V2` takes one caller at
    // a time, and its `key O` still sends `36:1`. The divergence is real, bounded and
    // temporary, and `K2a` removed every script that could show it.
    //
    // What is left here is a driver's business: saying what happened. A key nobody
    // bound answers `VB_NONE`, which `press_verb` reports as `PR_NONE` — the same
    // answer `press` gave, so the sentence below did not have to change.
    //
    // ⚠ **AND IT ASKS A MAP RATHER THAN A FUNCTION — plan 22 `M1`.** `verb_of` is an
    // `if` chain compiled into the library; `keymap_default()` is the same definition
    // as DATA, which is what makes it a person's to change. This is the first
    // production caller, and the two bodies are compared over the whole key universe
    // in `lib/hex_editor/tests/keymap.loft` — a table checked against itself could
    // not be surprised, so they stay independent until `verb_of` is deleted.
    //
    // ⚠ **THE MAP IS BUILT PER LINE AND THAT IS DELIBERATE FOR NOW.** A script has no
    // way to rebind, so a per-line default is the same map every time; the moment a
    // `bind` command exists it becomes session state and this line reads it from
    // there instead. Building it here rather than threading it through is what keeps
    // this step to one caller.
    //
    // ⚠ **AND EIGHT KEYS STOP RESOLVING: `P I U N M T K V`.** They were `S3`'s
    // collapse leaving the old keys in place — each does exactly what its primary
    // does — and no live script presses one (`K3` converted them all; `probe/k2`
    // keeps the grep). A definition with six `opening` rows would draw six identical
    // slots in a bar and six identical rows in a rebinding list.
    return said_ack(hex_editor::press_verb(sess, w, a,
                      hex_editor::verb_in(hex_editor::keymap_default(), rest),
                      "{source_dir()}/../data/parts"),
                    rest, said);
  }

  // ── THE SECOND SPELLING — plan 22 `K1` ──────────────────────────────────────
  //
  // ⚠ **A KEY IS A KEYBOARD'S BUSINESS AND A VERB IS WHAT TRAVELS.** A script is a
  // document, not a keyboard: it outlives the layout it was written on, and it is
  // read by a person deciding what a scene does. `verb place` says that; `key H`
  // says which finger moved. The two run side by side until `K3`, which is the
  // upper bound of a safe step — the old path and the new one both running and
  // compared exactly (`probe/k1/run.sh`).
  //
  // ⚠ **AND THE CONVERSION IS NOT A SPELLING CHANGE FOR THE OPENING FAMILY.**
  // `verb_of` is deliberately not injective: six keys answer one `opening`, so a
  // script that says `opening` and never says `select` cuts whatever was chosen
  // last. That is why `select` lands in the same step — a script converted without
  // it would still build a world, silently, with the wrong head on every door.
  if cmd == "verb" {
    // ⚠ THE LIBRARY ROOT IS THIS RUNNER'S OWN — plan 22 `B2e`. It reads the same
    // `data/parts/` the server does, so a script that chooses a part and places it
    // builds what the editor would. ⚠ Resolved through `source_dir()` for loft#712's
    // reason, exactly as the SCRIPT path above is.
    return said_ack(hex_editor::press_verb(sess, w, a, rest,
                                           "{source_dir()}/../data/parts"), rest, said);
  }

  if cmd == "part" {
    // ⚠ THE SAME CHOOSING THE PAGE MAKES — plan 22 `B2e`. `select` picks an opening
    // profile; this picks a PART, and `verb place` then puts that in the world
    // instead of the procedural house. A bare `part` with no name clears it, which
    // is how a script goes back to building houses.
    sel = hex_editor::session_select_part(sess, rest);
    if !sel.ak_ok { said = "part refused — {sel.ak_why}"; return true; }
    said = sel.ak_why;
    return true;
  }

  if cmd == "select" {
    // ⚠ CHOOSING IS A GESTURE AND IT REFUSES LIKE ONE. `5` is not *nearly* an
    // oculus, so `session_select_open` says no without an offer and leaves the
    // standing choice alone — which is the server's `49:` behaviour, because it is
    // the same call.
    //
    // ⚠ `select seat <kind>` NAMES ITS SUBJECT AND THE BARE FORM DOES NOT — plan 22
    // `K3`. The bare one stays the opening because `K2a` converted eight scripts to
    // write it that way, and giving the word a new meaning would move all of them for
    // a spelling. ⏭ It is the form to migrate when a fourth selection lands: it is the
    // only one whose subject is implied.
    if rest.starts_with("seat ") {
      ssel = hex_editor::session_select_seat(sess, rest[5..].trim() as integer ?? 0 - 1);
      if !ssel.ak_ok { said = "selection refused — {ssel.ak_why}"; return true; }
      said = "seat {ssel.ak_n} selected";
      return true;
    }
    if rest.starts_with("annex ") {
      asel = hex_editor::session_select_annex(sess, rest[6..].trim() as integer ?? 0 - 1);
      if !asel.ak_ok { said = "selection refused — {asel.ak_why}"; return true; }
      said = "annex {asel.ak_n} selected";
      return true;
    }
    sel = hex_editor::session_select_open(sess, rest as integer ?? 0 - 1);
    if !sel.ak_ok { said = "selection refused — {sel.ak_why}"; return true; }
    said = "opening {sel.ak_n} selected";
    return true;
  }

  // `wait`, `snap`, `hold`, `rate`, `step` are the SERVER's vocabulary: they wait
  // for an acknowledgement, photograph a renderer, or drive a tick, and none of
  // those exists here. Skipped rather than refused, so one script serves both.
  // ⚠ `eye` IS HERE FOR THE SAME REASON `snap` IS: it photographs, and there is no
  // renderer in this program. A camera placed where nobody is looking is not a
  // refusal, it is a verb this driver has no use for — so one script still serves
  // both, which is the whole reason this skip list exists.
  if cmd == "wait" || cmd == "snap" || cmd == "hold" || cmd == "rate"
     || cmd == "step" || cmd == "turn" || cmd == "keys" || cmd == "save"
     || cmd == "eye" {
    return true;
  }
  said = "unknown command '{cmd}'";
  false
}

fn main() {
  // ⚠ RESOLVED THROUGH `source_dir()`, and that is loft#712 rather than taste. A
  // RELATIVE path with `..` in it is refused and reported as a null size, and a
  // relative path without one resolves against THIS FILE's directory — so a plain
  // `tools/scripts/house.keys` is looked for in `src/` and comes back missing. An
  // absolute path built from `source_dir()` is the one spelling that works.
  script = env_variable("SCRIPT");
  if script == "" { script = "tools/scripts/house.keys"; }
  if script[..1] != "/" { script = "{source_dir()}/../{script}"; }
  name = env_variable("WORLD");
  if name == "" { name = "headless"; }

  src = file(script);
  if src#size < 1 {
    println("editor_run: cannot read {script}");
    return;
  }
  text = src.content();

  w = world_new(0.25, hex_editor::W_RESERVE,
                hex_editor::WORLD_EPS, hex_editor::WORLD_THETA).wn_world;
  // ⚠ THE GROUND THIS RUNNER LAYS IS THE RUNNER'S, NOT THE EDITOR'S — plan 22
  // `B1b.1b`. `new_world()` in the server seeds nothing, because an unwritten cell
  // reads as absent and absence IS the floor (`E1γ`); this patch of `SURFACE_MAT`
  // exists so a scripted scene has something with a material in it to photograph.
  // That makes it a difference between two drivers of the same gestures, and the
  // page in local mode is the third — so it is a knob rather than a constant.
  //
  // ⚠ `GROUND=0` IS THE COMPARISON, and it is not a test hook: it is *start where
  // the editor starts*. Measured — the same six verbs at the same pose leave
  // τ 4079 seeded and τ 358 not, and the world keys differ, so a comparison run
  // against the default would report a divergence that is entirely this line.
  gh = env_variable("GROUND");
  half = if gh == "" { 30 } else { gh as integer ?? 30 };
  if half > 0 { seed_ground(w, half); }
  a = hex_editor::author_on(w, 0.0, 0.0, 0.0);
  // ⚠ AN `EditSession`, NOT A BARE `WallRuns` — plan 22 `W4`. A key press is a
  // gesture applied to a SESSION, and the server has held one since the headless
  // thread landed. A runner holding only the wall runs could never call `press`
  // for any gesture that touches another registry.
  sess = hex_editor::EditSession {};

  n = 0;
  for line in text.split('\n') {
    said = "";
    ok = run_line(w, a, sess, line, said);
    if said != "" { println("  {said}"); }
    if !ok { println("editor_run: {line}"); }
    n = n + 1;
  }

  println(session_digest(sess));

  // The world as one comparable string — plan 22 `B1b.1b`. It is `hex_voxel`'s
  // function rather than this file's, because the other side of the comparison is
  // a page in a browser: two programs each spelling their own digest is `W1`'s
  // two-encoders finding one layer out, and this one exists precisely so that a
  // difference between them means a difference in what they BUILT.
  println("editor_run: world {world_key(w)}");

  path = "{source_dir()}/../worlds/{name}.hxw";
  code = world_save(w, path, []);
  println("editor_run: {n} lines, {len(w.w_chunks)} chunks, τ {w.w_tau} -> {name}.hxw (code {code})");
}
